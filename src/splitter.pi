// node-mavlink's MavLinkPacketSplitter: whole frames out of a byte stream, checked against their
// CRC-extra. A frame of a known message with a bad CRC drops one byte (its start byte was a false
// match); a frame of an unknown message is skipped whole.
import { MSG_ID_MAGIC_NUMBER } from "./dialects/magic-numbers"
import { readUint } from "./bytes"
import { x25crc } from "./crc"
import { CHECKSUM_LENGTH, MavLinkProtocolV1, MavLinkProtocolV2, SIGNATURE_LENGTH } from "./protocol"

/// A frame the splitter found, with its tlog timestamp (ms since 1970) if it came from a tlog.
export struct RawPacket {
  buffer: Uint8Array
  timestamp: int?
}

export struct SplitterOptions {
  /// CRC-extra by message id: the messages this stream may carry (default: every generated dialect).
  magicNumbers?: Map<int, int>
  /// The most bytes kept while waiting for the rest of a frame (default 64 KiB). Past it, the
  /// oldest bytes are dropped (and counted as invalid).
  maxBuffer?: int
  /// Called with each frame whose CRC is wrong (for diagnostics).
  onCrcError?: (frame: Uint8Array) => void
}

export class MavLinkPacketSplitter {
  readonly magicNumbers: Map<int, int>
  readonly maxBuffer: int
  readonly onCrcError: ((frame: Uint8Array) => void)?
  /// tlog: each frame is preceded by an 8-byte big-endian timestamp in µs.
  readonly tlog: bool
  buffer: Uint8Array = new Uint8Array(4096)
  /// The bytes waiting are buffer[start, end).
  start: int = 0
  end: int = 0
  /// Where the search for the next start byte goes on from (start <= scan <= end).
  scan: int = 0
  valid: int = 0
  invalid: int = 0
  unknown: int = 0

  constructor(options: SplitterOptions = {}, tlog: bool = false) {
    this.magicNumbers = options.magicNumbers ?? MSG_ID_MAGIC_NUMBER
    this.maxBuffer = options.maxBuffer ?? 65536
    this.onCrcError = options.onCrcError
    this.tlog = tlog
  }

  /// Frames whose CRC matched.
  public get validPackets(): int {
    valid
  }

  /// Frames of known messages whose CRC didn't match, and bytes dropped from an overfull buffer.
  public get invalidPackets(): int {
    invalid
  }

  /// Frames of messages missing from `magicNumbers`.
  public get unknownPackets(): int {
    unknown
  }

  /// Bytes waiting for the rest of a frame.
  public get buffered(): int {
    end - start
  }

  public resetCounters(): void {
    valid = 0
    invalid = 0
    unknown = 0
  }

  /// The frames `chunk` completes.
  public push(chunk: Uint8Array): RawPacket[] {
    append(chunk)
    const out: RawPacket[] = []
    while (true) {
      const f = findStart()
      if (f < 0) {
        // Nothing more to find. In a tlog keep the last 8 bytes: they may be the next frame's
        // timestamp.
        start = if (tlog && end - start > 8) end - 8 else if (tlog) start else end
        scan = end
        break
      }
      const v2 = buffer[f] == MavLinkProtocolV2.START_BYTE
      const offset = if (v2) MavLinkProtocolV2.PAYLOAD_OFFSET else MavLinkProtocolV1.PAYLOAD_OFFSET
      const signed = end - f > 2 && v2 && (buffer[f + 2] & MavLinkProtocolV2.IFLAG_SIGNED) != 0
      const length = if (end - f < 2) -1 else offset + buffer[f + 1] + CHECKSUM_LENGTH + (if (signed) SIGNATURE_LENGTH else 0)
      if (end - f < offset + CHECKSUM_LENGTH || end - f < length) {
        // Wait for the rest. A tlog frame keeps its timestamp: dropping it lost frames that a
        // chunk boundary cut (node-mavlink 2.3.0 does lose them).
        start = if (tlog) f - 8 else f
        scan = f
        break
      }
      const timestamp = if (tlog) readTimestamp(f) else null
      const msgid = if (v2) readUint(buffer, f + 7, 3) else buffer[f + 5]
      const magic = magicNumbers.get(msgid)
      if (magic == null) {
        unknown += 1
        start = f + length
        scan = start
        continue
      }
      const crcAt = f + offset + buffer[f + 1]
      if (readUint(buffer, crcAt, 2) == x25crc(buffer, f + 1, crcAt, magic!)) {
        valid += 1
        out.push({ buffer: buffer.slice(f, f + length), timestamp })
        start = f + length
        scan = start
      } else {
        // A false start byte: look again from the next byte (a tlog frame there still needs the
        // 8 bytes before it, so what's consumed stays).
        invalid += 1
        const report = onCrcError
        if (report != null) {
          report!(buffer.slice(f, f + length))
        }
        scan = f + 1
        if (!tlog) {
          start = scan
        }
      }
    }
    bound()
    out
  }

  /// The first start byte from `scan` on (in a tlog, with 8 bytes before it), or -1.
  findStart(): int {
    const lead = if (tlog) start + 8 else start
    for (let i = if (scan > lead) scan else lead; i < end; i++) {
      const b = buffer[i]
      if (b == MavLinkProtocolV1.START_BYTE || b == MavLinkProtocolV2.START_BYTE) {
        return i
      }
    }
    -1
  }

  readTimestamp(at: int): int {
    let us = 0
    for (let i = at - 8; i < at; i++) {
      us = (us << 8) | buffer[i]
    }
    us / 1000
  }

  append(chunk: Uint8Array): void {
    const waiting = end - start
    if (waiting + chunk.length > buffer.length || end + chunk.length > buffer.length) {
      // Move what's waiting to the front, growing the buffer if it must.
      let size = buffer.length
      while (waiting + chunk.length > size) {
        size *= 2
      }
      const next = new Uint8Array(size)
      next.setAll(buffer.slice(start, end), 0)
      buffer = next
      scan -= start
      start = 0
      end = waiting
    }
    buffer.setAll(chunk, end)
    end += chunk.length
  }

  /// What's left waiting is bounded: the oldest bytes go (noise that looks like the start of a
  /// long frame must not grow the buffer forever). Frames are taken out first, so a large chunk
  /// loses nothing.
  bound(): void {
    if (end - start > maxBuffer) {
      invalid += 1
      start = end - maxBuffer
      if (scan < start) {
        scan = start
      }
    }
  }
}

/// node-mavlink's MavLinkTLogPacketSplitter: frames from a tlog, each with its timestamp.
export class MavLinkTLogPacketSplitter extends MavLinkPacketSplitter {
  constructor(options: SplitterOptions = {}) {
    super(options, true)
  }
}
