// The directory listing of the FTP client (ListDirectory): the entries of a listing, and the client against the simulated vehicle's
// file system, in pages, with a lossy link, and against a vehicle that answers badly.
import { describe, it, expect } from "std/test"
import { MavLinkConnection } from "./connection"
import { MemoryStream } from "./stream"
import { Target } from "./operations"
import { SimulatedAutopilot } from "./simulator"
import { FTP_MAX_ENTRIES, FtpClient, FtpError, FtpOptions, parseListing } from "./ftp"

const VEHICLE: Target = { system: 1, component: 1 }
const FAST: FtpOptions = { timeoutMs: 150, retries: 2, session: 7 }

class Rig {
  public readonly gcs: MavLinkConnection
  public readonly sim: SimulatedAutopilot

  constructor(gcs: MavLinkConnection, sim: SimulatedAutopilot) {
    this.gcs = gcs
    this.sim = sim
  }
}

function rig(): Rig {
  const ends = MemoryStream.pair()
  const gcs = new MavLinkConnection(ends[0])
  const sim = new SimulatedAutopilot(ends[1])
  gcs.run()
  sim.conn.run()
  new Rig(gcs, sim)
}

/// The bytes of a listing written as the vehicle writes it: each entry ends with a NUL byte.
function listing(entries: string[]): Uint8Array {
  const bytes: int[] = []
  for (const entry of entries) {
    const enc = new TextEncoder().encode(entry)
    for (let i = 0; i < enc.length; i++) {
      bytes.push(enc[i] as int)
    }
    bytes.push(0)
  }
  const out = new Uint8Array(bytes.length)
  for (let i = 0; i < bytes.length; i++) {
    out.set(i, bytes[i])
  }
  out
}

/// A file of `size` bytes, to list (what is in it does not matter).
function file(size: int): Uint8Array {
  new Uint8Array(size)
}

/// A vehicle with logs in "/APM/LOGS", a file in "/APM" and an empty "/APM/EMPTY".
function withLogs(): Rig {
  const r = rig()
  r.sim.fsFiles.set("/APM/LOGS/00000001.BIN", file(1200))
  r.sim.fsFiles.set("/APM/LOGS/00000002.BIN", file(48))
  r.sim.fsFiles.set("/APM/LOGS/LASTLOG.TXT", file(2))
  r.sim.fsFiles.set("/APM/notes.txt", file(5))
  r.sim.fsDirs.push("/APM/EMPTY")
  r
}

function parsesFilesAndDirectories(): void throws FtpError {
  const l = parseListing(listing(["Fa.BIN\t1200", "Dsub", "Fb.BIN\t0"]))
  expect(l.count).toBe(3)
  expect(l.entries.map((e) => `${e.name}:${e.directory}:${e.size}`).join(",")).toBe("a.BIN:false:1200,sub:true:0,b.BIN:false:0")
  expect(l.entries[0].time == null).toBe(true)
}

function parsesATimeInAListingWithTime(): void throws FtpError {
  const l = parseListing(listing(["Fa.BIN\t1200\t1783000000", "Fb.BIN\t5\t0", "Dsub\t0\t1783000001", "S"]), true)
  expect(l.count).toBe(4)
  expect(l.entries.length).toBe(3)
  expect(l.entries[0].time!).toBe(1783000000)
  // A time of 0 is no time (the vehicle has none), not 1970.
  expect(l.entries[1].time == null).toBe(true)
  expect(l.entries[2].directory).toBe(true)
  expect(l.entries[2].time!).toBe(1783000001)
}

function refusesATimeInAPlainListing(): void {
  // In a plain listing a name with a tab in it arrives as it is: `a<TAB>5` of 100 bytes is `Fa\t5\t100`. It must not be read as the
  // file `a` of 5 bytes made at time 100.
  const bad = [["Fa\t5\t100"], ["Dsub\t0\t5"]]
  for (const entries of bad) {
    try {
      parseListing(listing(entries), false)
      expect(entries[0]).toBe("believed")
    } catch (e: FtpError) {
      expect(e.code).toBe("FTP_PROTOCOL")
    }
  }
}

function refusesAnEntryWithoutATimeInAListingWithTime(): void {
  const bad = [["Fa\t5"], ["Dsub"], ["Fa\t5\tsoon"], ["Fa\t5\t1\t2"]]
  for (const entries of bad) {
    try {
      parseListing(listing(entries), true)
      expect(entries[0]).toBe("believed")
    } catch (e: FtpError) {
      expect(e.code).toBe("FTP_PROTOCOL")
    }
  }
}

function refusesNamesThatAreNotUtf8(): void {
  // Two different names that a decoder turns into the same text would be taken for one name twice.
  const bad: int[][] = [[0x46, 0xFF, 0x09, 0x31, 0], [0x46, 0xC3, 0x09, 0x31, 0], [0x46, 0xC0, 0x80, 0x09, 0x31, 0], [0x46, 0xED, 0xA0, 0x80, 0x09, 0x31, 0], [0x46, 0xF4, 0x90, 0x80, 0x80, 0x09, 0x31, 0]]
  for (const bytes of bad) {
    const b = new Uint8Array(bytes.length)
    for (let i = 0; i < bytes.length; i++) {
      b.set(i, bytes[i])
    }
    try {
      parseListing(b)
      expect(bytes.join(",")).toBe("refused")
    } catch (e: FtpError) {
      expect(e.code).toBe("FTP_PROTOCOL")
    }
  }
}

function acceptsNamesInUtf8(): void throws FtpError {
  const l = parseListing(listing(["Fżółć.BIN\t5", "Fdata_日本.BIN\t7", "Fsmile_😀\t1"]))
  expect(l.entries.map((e) => e.name).join(",")).toBe("żółć.BIN,data_日本.BIN,smile_😀")
}

function skipsSkipEntriesButCountsThem(): void throws FtpError {
  const l = parseListing(listing(["S", "Fa\t1"]))
  expect(l.count).toBe(2)
  expect(l.entries.length).toBe(1)
}

function leavesOutDotAndDotDot(): void throws FtpError {
  // A real vehicle (ArduPilot SITL) lists them: they count for the offset and are not returned.
  const l = parseListing(listing(["D.", "D..", "Feeprom.bin\t16384", "D@ROMFS"]))
  expect(l.count).toBe(4)
  expect(l.entries.map((e) => e.name).join(",")).toBe("eeprom.bin,@ROMFS")
}

function refusesEntriesThatAreNotEntries(): void {
  const bad = [
    ["Fa.BIN\t12x"],
    ["Fa.BIN"],
    ["Fa.BIN\t"],
    ["F\t12"],
    ["D"],
    ["Xwhat"],
    ["Fa\t1\t2\t3"],
    ["Fa\t1\tsoon"],
    ["Fa\t99999999999"],
  ]
  for (const entries of bad) {
    try {
      parseListing(listing(entries))
      expect(entries[0]).toBe("refused")
    } catch (e: FtpError) {
      expect(e.code).toBe("FTP_PROTOCOL")
    }
  }
}

function refusesAnEntryThatIsCutOff(): void {
  const whole = listing(["Fa.BIN\t12"])
  const cut = whole.slice(0, whole.length - 1)
  try {
    parseListing(cut)
    expect("parsed").toBe("refused")
  } catch (e: FtpError) {
    expect(e.code).toBe("FTP_PROTOCOL")
  }
}

async function listsALogDirectory(): Promise<void> throws Error {
  const r = withLogs()
  const entries = await new FtpClient(r.gcs, VEHICLE, FAST).listDirectory("/APM/LOGS")
  r.gcs.close()
  expect(entries.map((e) => `${e.name}:${e.size}`).join(",")).toBe("00000001.BIN:1200,00000002.BIN:48,LASTLOG.TXT:2")
  expect(entries[0].directory).toBe(false)
  // The vehicle gave no time, so there is none: it is not made up.
  expect(entries[0].time == null).toBe(true)
  // ListDirectoryWithTime (16) is asked first; the listing is ended with a terminate of session 0.
  // A listing begins with a reset of the sessions; then ListDirectoryWithTime (16) is asked.
  expect(r.sim.ftpLog[0].startsWith("2 ")).toBe(true)
  expect(r.sim.ftpLog[1].startsWith("16 s0 o0")).toBe(true)
  expect(r.sim.ftpLog[r.sim.ftpLog.length - 1].startsWith("1 s0")).toBe(true)
}

async function listsDirectoriesAndFilesAndTheRoot(): Promise<void> throws Error {
  const r = withLogs()
  const client = new FtpClient(r.gcs, VEHICLE, FAST)
  const apm = await client.listDirectory("/APM")
  const root = await client.listDirectory("/")
  const slash = await client.listDirectory("/APM/LOGS/")
  r.gcs.close()
  expect(apm.map((e) => `${e.name}:${e.directory}`).join(",")).toBe("notes.txt:false,LOGS:true,EMPTY:true")
  expect(root.map((e) => `${e.name}:${e.directory}`).join(",")).toBe("APM:true")
  expect(slash.length).toBe(3)
}

async function givesTheTimeWhenTheVehicleDoes(): Promise<void> throws Error {
  const r = withLogs()
  r.sim.fsTimes.set("/APM/LOGS/00000001.BIN", 1783000000)
  const entries = await new FtpClient(r.gcs, VEHICLE, FAST).listDirectory("/APM/LOGS")
  r.gcs.close()
  expect(entries[0].time!).toBe(1783000000)
  expect(entries[1].time == null).toBe(true)
}

async function fallsBackToThePlainListingAndRemembersIt(): Promise<void> throws Error {
  const r = withLogs()
  r.sim.fsTimes.set("/APM/LOGS/00000001.BIN", 1783000000)
  r.sim.ftpMode = "oldlist"
  const client = new FtpClient(r.gcs, VEHICLE, FAST)
  const first = await client.listDirectory("/APM/LOGS")
  const second = await client.listDirectory("/APM/LOGS")
  r.gcs.close()
  // The old firmware gives no time, and the client does not make one up.
  expect(first.map((e) => `${e.name}:${e.size}`).join(",")).toBe("00000001.BIN:1200,00000002.BIN:48,LASTLOG.TXT:2")
  expect(first[0].time == null).toBe(true)
  expect(second.length).toBe(3)
  // 16 once (refused), then only the plain one: a page and the end of the listing, for each of the two listings.
  const opcodes = r.sim.ftpLog.filter((line) => line.startsWith("16 ") || line.startsWith("3 ")).map((line) => line.split(" ")[0])
  expect(opcodes.join(",")).toBe("16,3,3,3,3")
}

async function fallsBackToThePlainListingWhenTheTimeOpcodeIsAnsweredWithFail(): Promise<void> throws Error {
  const r = withLogs()
  // Copter-4.7.2 answers an opcode it has no code for with Fail, not UNKNOWN_COMMAND.
  r.sim.ftpMode = "failwithtime"
  const client = new FtpClient(r.gcs, VEHICLE, FAST)
  const entries = await client.listDirectory("/APM/LOGS")
  const again = await client.listDirectory("/APM/LOGS")
  r.gcs.close()
  expect(entries.map((e) => e.name).join(",")).toBe("00000001.BIN,00000002.BIN,LASTLOG.TXT")
  expect(again.length).toBe(3)
  expect(client.listMode).toBe(2)
  // 16 once (Fail), then only the plain one.
  const opcodes = r.sim.ftpLog.filter((line) => line.startsWith("16 ") || line.startsWith("3 ")).map((line) => line.split(" ")[0])
  expect(opcodes.join(",")).toBe("16,3,3,3,3")
}

async function asksAPlainListingAgainOnFailAfterAReset(): Promise<void> throws Error {
  const r = withLogs()
  r.sim.ftpMode = "oldlist"
  r.sim.ftpFailLists = 1
  const entries = await new FtpClient(r.gcs, VEHICLE, FAST).listDirectory("/APM/LOGS")
  r.gcs.close()
  expect(entries.length).toBe(3)
  // The reset before the listing, the listing refused, the reset again, the listing.
  const resets = r.sim.ftpLog.filter((line) => line.startsWith("2 ")).length
  expect(resets >= 3).toBe(true)
}

async function failsWhenThePlainListingStaysRefusedAndNamesTheOpcode(): Promise<void> throws Error {
  const r = withLogs()
  r.sim.ftpMode = "oldlist"
  r.sim.ftpFailLists = 10
  try {
    await new FtpClient(r.gcs, VEHICLE, FAST).listDirectory("/APM/LOGS")
    expect("listed").toBe("refused")
  } catch (e: FtpError) {
    expect(e.code).toBe("FTP_FAILED")
    expect(e.message.includes("with ListDirectory:")).toBe(true)
  }
  r.gcs.close()
  // Asked twice (the second after the reset), not again and again; and the session is ended.
  expect(r.sim.ftpLog.filter((line) => line.startsWith("3 ")).length).toBe(2)
  expect(r.sim.ftpLog[r.sim.ftpLog.length - 1].startsWith("1 s0")).toBe(true)
}

async function namesTheTimeOpcodeInAnError(): Promise<void> throws Error {
  const r = withLogs()
  try {
    await new FtpClient(r.gcs, VEHICLE, FAST).listDirectory("/APM/NOPE")
    expect("listed").toBe("refused")
  } catch (e: FtpError) {
    expect(e.code).toBe("FTP_ERRNO")
    expect(e.message.includes("with ListDirectoryWithTime")).toBe(true)
  }
  r.gcs.close()
}

async function skipsANameWithATabInAListingWithTime(): Promise<void> throws Error {
  const r = withLogs()
  r.sim.fsFiles.set("/APM/LOGS/a\t5", file(100))
  const entries = await new FtpClient(r.gcs, VEHICLE, FAST).listDirectory("/APM/LOGS")
  r.gcs.close()
  // The vehicle writes `S` for it: it is left out, and the rest is listed.
  expect(entries.map((e) => e.name).join(",")).toBe("00000001.BIN,00000002.BIN,LASTLOG.TXT")
}

async function refusesANameWithATabInAPlainListing(): Promise<void> throws Error {
  const r = withLogs()
  r.sim.fsFiles.set("/APM/LOGS/a\t5", file(100))
  r.sim.ftpMode = "oldlist"
  try {
    await new FtpClient(r.gcs, VEHICLE, FAST).listDirectory("/APM/LOGS")
    expect("listed").toBe("refused")
  } catch (e: FtpError) {
    // Not the file `a` of 5 bytes made at time 100.
    expect(e.code).toBe("FTP_PROTOCOL")
  }
  r.gcs.close()
}

async function endsTheListingAlsoAfterAFailure(): Promise<void> throws Error {
  const r = withLogs()
  try {
    await new FtpClient(r.gcs, VEHICLE, FAST).listDirectory("/APM/NOPE")
    expect("listed").toBe("refused")
  } catch (e: FtpError) {
    expect(e.code).toBe("FTP_ERRNO")
  }
  r.gcs.close()
  expect(r.sim.ftpLog[r.sim.ftpLog.length - 1].startsWith("1 s0")).toBe(true)
}

async function listsAnEmptyDirectoryAsEmpty(): Promise<void> throws Error {
  const r = withLogs()
  const entries = await new FtpClient(r.gcs, VEHICLE, FAST).listDirectory("/APM/EMPTY")
  r.gcs.close()
  expect(entries.length).toBe(0)
}

async function failsForADirectoryThatIsNotThere(): Promise<void> throws Error {
  const r = withLogs()
  try {
    await new FtpClient(r.gcs, VEHICLE, FAST).listDirectory("/APM/NOPE")
    expect("listed").toBe("refused")
  } catch (e: FtpError) {
    expect(`${e.code} ${e.errno}`).toBe("FTP_ERRNO 2")
  }
  r.gcs.close()
}

async function takesManyPagesAndSkipsWhatItHas(): Promise<void> throws Error {
  const r = rig()
  for (let i = 0; i < 70; i++) {
    r.sim.fsFiles.set(`/APM/LOGS/${10000000 + i}.BIN`, file(100 + i))
  }
  const entries = await new FtpClient(r.gcs, VEHICLE, FAST).listDirectory("/APM/LOGS")
  r.gcs.close()
  expect(entries.length).toBe(70)
  expect(entries[0].name).toBe("10000000.BIN")
  expect(entries[69].name).toBe("10000069.BIN")
  expect(entries[69].size).toBe(169)
  // More than one request, each skipping the entries already read.
  const asks = r.sim.ftpLog.filter((line) => line.startsWith("16 "))
  expect(asks.length > 2).toBe(true)
  expect(asks[0].includes("o0")).toBe(true)
  expect(asks[1].includes("o0")).toBe(false)
}

async function takesPagesOfAGivenSize(): Promise<void> throws Error {
  const r = withLogs()
  r.sim.ftpListPage = 1
  const entries = await new FtpClient(r.gcs, VEHICLE, FAST).listDirectory("/APM/LOGS")
  r.gcs.close()
  expect(entries.length).toBe(3)
  const asks = r.sim.ftpLog.filter((line) => line.startsWith("16 "))
  expect(asks.map((line) => line.split(" ")[2]).join(",")).toBe("o0,o1,o2,o3")
}

async function listsOnALossyLink(): Promise<void> throws Error {
  const r = rig()
  for (let i = 0; i < 40; i++) {
    r.sim.fsFiles.set(`/APM/LOGS/${20000000 + i}.BIN`, file(i))
  }
  r.sim.ftpLoss = 20
  const entries = await new FtpClient(r.gcs, VEHICLE, { timeoutMs: 100, retries: 20, session: 7 }).listDirectory("/APM/LOGS")
  r.gcs.close()
  expect(entries.length).toBe(40)
  expect(entries[39].name).toBe("20000039.BIN")
}

async function refusesAListingThatRepeatsItsFirstPage(): Promise<void> throws Error {
  const r = withLogs()
  r.sim.ftpListPage = 2
  r.sim.ftpMode = "relist"
  try {
    await new FtpClient(r.gcs, VEHICLE, FAST).listDirectory("/APM/LOGS")
    expect("listed").toBe("refused")
  } catch (e: FtpError) {
    expect(e.code).toBe("FTP_PROTOCOL")
  }
  r.gcs.close()
}

async function refusesAnAckWithNothingInIt(): Promise<void> throws Error {
  const r = withLogs()
  r.sim.ftpMode = "emptylist"
  try {
    await new FtpClient(r.gcs, VEHICLE, FAST).listDirectory("/APM/LOGS")
    expect("listed").toBe("refused")
  } catch (e: FtpError) {
    expect(e.code).toBe("FTP_PROTOCOL")
  }
  r.gcs.close()
}

async function stopsAtTheMostEntries(): Promise<void> throws Error {
  const r = rig()
  for (let i = 0; i < FTP_MAX_ENTRIES + 50; i++) {
    r.sim.fsFiles.set(`/L/${i}`, file(1))
  }
  try {
    await new FtpClient(r.gcs, VEHICLE, { timeoutMs: 2000, retries: 1, session: 7 }).listDirectory("/L")
    expect("listed").toBe("refused")
  } catch (e: FtpError) {
    expect(e.code).toBe("FTP_PROTOCOL")
  }
  r.gcs.close()
}

async function refusesAPathThatIsTooLong(): Promise<void> throws Error {
  const r = withLogs()
  try {
    await new FtpClient(r.gcs, VEHICLE, FAST).listDirectory(`/${"a".repeat(300)}`)
    expect("listed").toBe("refused")
  } catch (e: FtpError) {
    expect(e.code).toBe("FTP_PROTOCOL")
  }
  r.gcs.close()
  expect(r.sim.ftpLog.length).toBe(0)
}

async function timesOutWhenNothingAnswers(): Promise<void> throws Error {
  const r = withLogs()
  r.sim.ftpMode = "silent"
  try {
    await new FtpClient(r.gcs, VEHICLE, { timeoutMs: 50, retries: 1, session: 7 }).listDirectory("/APM/LOGS")
    expect("listed").toBe("refused")
  } catch (e: FtpError) {
    expect(e.code).toBe("FTP_TIMEOUT")
  }
  r.gcs.close()
}

async function isCancelled(): Promise<void> throws Error {
  const r = withLogs()
  const stop = new AbortController()
  stop.abort()
  try {
    await new FtpClient(r.gcs, VEHICLE, { timeoutMs: 100, retries: 1, session: 7, signal: stop.signal }).listDirectory("/APM/LOGS")
    expect("listed").toBe("refused")
  } catch (e: FtpError) {
    expect(e.code).toBe("FTP_ABORTED")
  }
  r.gcs.close()
}

describe("the directory listing of the FTP client", () => {
  it("parses files (name and size) and directories", parsesFilesAndDirectories)
  it("parses a time in a listing with time (0 is none), also for a directory", parsesATimeInAListingWithTime)
  it("refuses a third field in a plain listing: a name with a tab in it is not a size and a time", refusesATimeInAPlainListing)
  it("refuses an entry without a time, or with too many fields, in a listing with time", refusesAnEntryWithoutATimeInAListingWithTime)
  it("refuses names that are not UTF-8, so that none is taken for another", refusesNamesThatAreNotUtf8)
  it("accepts names in UTF-8", acceptsNamesInUtf8)
  it("counts a skip entry and does not return it", skipsSkipEntriesButCountsThem)
  it("leaves out \".\" and \"..\", and counts them", leavesOutDotAndDotDot)
  it("refuses entries that are not entries: a size that is not a number, none, no name, an unknown kind, more fields", refusesEntriesThatAreNotEntries)
  it("refuses an entry that is cut off (no NUL)", refusesAnEntryThatIsCutOff)
  it("lists the logs of a directory: names and sizes, no time unless the vehicle gives one", listsALogDirectory)
  it("lists directories and files, the root, and a path with a slash at its end", listsDirectoriesAndFilesAndTheRoot)
  it("gives the time of a file when the vehicle does", givesTheTimeWhenTheVehicleDoes)
  it("falls back to the plain listing for firmware without ListDirectoryWithTime, and remembers it", fallsBackToThePlainListingAndRemembersIt)
  it("falls back to the plain listing when the time opcode is answered with Fail (Copter-4.7.2), and remembers it", fallsBackToThePlainListingWhenTheTimeOpcodeIsAnsweredWithFail)
  it("asks a plain listing again once when it is answered with Fail, after a reset of the sessions", asksAPlainListingAgainOnFailAfterAReset)
  it("fails, naming the opcode, when the plain listing stays refused", failsWhenThePlainListingStaysRefusedAndNamesTheOpcode)
  it("names the opcode used in an error", namesTheTimeOpcodeInAnError)
  it("leaves out a name with a tab in a listing with time (the vehicle writes S)", skipsANameWithATabInAListingWithTime)
  it("refuses a name with a tab in a plain listing instead of reading it as a size and a time", refusesANameWithATabInAPlainListing)
  it("ends the listing with a terminate also after a failure", endsTheListingAlsoAfterAFailure)
  it("lists an empty directory as empty", listsAnEmptyDirectoryAsEmpty)
  it("fails as the vehicle says for a directory that is not there", failsForADirectoryThatIsNotThere)
  it("takes a long listing in pages, each skipping the entries already read", takesManyPagesAndSkipsWhatItHas)
  it("takes pages of one entry", takesPagesOfAGivenSize)
  it("lists on a link that loses packets", listsOnALossyLink)
  it("refuses a listing that repeats its first page", refusesAListingThatRepeatsItsFirstPage)
  it("refuses an Ack with nothing in it and no end of listing", refusesAnAckWithNothingInIt)
  it("refuses a listing of more entries than the most (a vehicle that never ends one cannot fill the memory)", stopsAtTheMostEntries)
  it("refuses a path that does not fit a packet, and sends nothing", refusesAPathThatIsTooLong)
  it("times out when nothing answers", timesOutWhenNothingAnswers)
  it("is cancelled with the signal", isCancelled)
})
