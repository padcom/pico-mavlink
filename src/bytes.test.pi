import { describe, it, expect } from "std/test"
import { readChars, readF32, readF64, readI16, readI32, readI64, readI8, readU16, readU32, readU64,
  writeChars, writeF32, writeF64, writeU64, writeUint } from "./bytes"

function roundTrips(): void {
  const b = new Uint8Array(32)
  writeUint(b, 0, 2, -2)
  expect(readI16(b, 0) as int).toBe(-2)
  expect(readU16(b, 0) as int).toBe(0xFFFE)
  writeUint(b, 2, 4, -123456)
  expect(readI32(b, 2) as int).toBe(-123456)
  writeUint(b, 6, 1, 0x80)
  expect(readI8(b, 6) as int).toBe(-128)
  const big: u64 = 18_364_758_544_493_064_720
  writeU64(b, 8, big)
  expect(readU64(b, 8) == big).toBe(true)
  expect(readI64(b, 8) < 0).toBe(true)
  writeF32(b, 16, 1.5 as f32)
  expect(readF32(b, 16) as f64).toBe(1.5)
  writeF64(b, 20, -0.1)
  expect(readF64(b, 20)).toBe(-0.1)
  writeUint(b, 28, 4, 0xDEADBEEF)
  expect(readU32(b, 28) as int).toBe(0xDEADBEEF)
}

function zerosPastTheEnd(): void {
  const b = new Uint8Array(2)
  b.set(0, 0x34)
  b.set(1, 0x12)
  expect(readU32(b, 0) as int).toBe(0x1234)
  expect(readF64(b, 8)).toBe(0.0)
}

function chars(): void {
  const b = new Uint8Array(8)
  writeChars(b, 0, 8, "ARMING_CHECK")
  expect(readChars(b, 0, 8)).toBe("ARMING_C")
  const c = new Uint8Array(8)
  writeChars(c, 0, 8, "abc")
  expect(readChars(c, 0, 8)).toBe("abc")
  // Not UTF-8: U+FFFD for the bad byte, as node-mavlink decodes it.
  const d = new Uint8Array(4)
  d.set(0, 0x41)
  d.set(1, 0xE9)
  expect(readChars(d, 0, 4)).toBe("A\u{fffd}")
}

describe("bytes", () => {
  it("reads back what it writes, signed and unsigned, 8 to 64 bits, floats", roundTrips)
  it("reads zeros past the end of a short payload", zerosPastTheEnd)
  it("writes char[n] cut and NUL-padded, reads up to the NUL", chars)
})
