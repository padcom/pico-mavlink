// RC_CHANNELS_OVERRIDE, as a ground station sends it to fly a vehicle with a stick (ArduPilot: libraries/GCS_MAVLink/GCS_Common.cpp
// `handle_rc_channels_override`, libraries/RC_Channel/RC_Channel.cpp `set_override`; the simulator, simrc.pi, does the same):
//  - THE DANGER (read before changing anything here): an override IS the radio. While frames come the vehicle obeys them as sticks and
//    switches (a mode switch channel changes the mode; a throttle under the failsafe value is a radio failsafe), the pre-arm "RC not
//    found" check passes, and the vehicle's own radio failsafe is live. What keeps a ground station that dies from holding the sticks is
//    the vehicle's RC_OVERRIDE_TIME (3 s by default; 0 turns overrides off; a NEGATIVE time never expires, and the caller must refuse to
//    send to a vehicle that has one). This helper adds its own, much shorter limit: it sends only while `set` is called often enough
//    (`silenceMs`, 300 ms by default) and, when it is not, sends ONE release frame and stops. It never sends what it was not given
//    lately, and never sends more often than 50 times a second, whatever it is asked.
//  - a frame carries channels 1 to 16 (the vehicle reads 16; the MAVLink 2 extension channels 17 and 18 are sent as "ignore"). Channels 1
//    to 8: 65535 leaves the channel to the radio, 0 RELEASES it. Channels 9 to 16: 65535 or 0 leave it, 65534 RELEASES it. A pulse is
//    800 to 2200 µs; anything else is an `INVALID_VALUE` MavLinkError and nothing is sent. `NO_OVERRIDE` in `set` is "not mine": the
//    channel is sent as "ignore".
//  - the SENDER's system id must be inside the vehicle's MAV_GCS_SYSID .. MAV_GCS_SYSID_HI (255 by default): from another id the vehicle
//    takes no override, silently. The id is the connection's protocol's, and the caller has to know it.
//  - the release frame (`release`) sets all 16 channels to release values, once. The vehicle gives the channels back to the radio at once
//    (a vehicle with no receiver reads its channels at their minimum again).
import { MavLinkConnection } from "./connection"
import { RcChannelsOverride } from "./dialects/common"
import { Target } from "./operations"
import { MavLinkError } from "./protocol"
import { MAX_PULSE, MIN_PULSE } from "./rcchannels"

/// How many channels a frame sets.
export const OVERRIDE_CHANNELS: int = 16

/// In `set`: this channel is the radio's, not the override's (sent as "ignore").
export const NO_OVERRIDE: int = -1

/// How often frames are sent (Hz): the default, and what a rate asked for is held to.
export const DEFAULT_RATE_HZ: int = 25
export const MIN_RATE_HZ: int = 10
export const MAX_RATE_HZ: int = 50

/// How long `set` may not be called (ms) before the sender releases and stops: the default, and what a time asked for is held to.
export const DEFAULT_SILENCE_MS: int = 300
export const MIN_SILENCE_MS: int = 100
export const MAX_SILENCE_MS: int = 1000

/// What a frame says for "leave it to the radio", and for "release" (channels 1 to 8 are released with 0, 9 to 16 with 65534).
const IGNORE: int = 65535
const RELEASE_LOW: int = 0
const RELEASE_HIGH: int = 65534

/// What the sender is told to do.
export struct RcOptions {
  /// Frames a second (held to `MIN_RATE_HZ` .. `MAX_RATE_HZ`).
  rateHz?: int
  /// How long without `set` before it releases and stops (held to `MIN_SILENCE_MS` .. `MAX_SILENCE_MS`).
  silenceMs?: int
}

function held(value: int, least: int, most: int): int {
  if (value < least) least else if (value > most) most else value
}

/// The sender of the override of one vehicle. `conn.run()` need not be running (it only sends).
export class RcOverride {
  readonly conn: MavLinkConnection
  readonly target: Target
  /// The frames a second it sends, the time between them, and how long it may go without `set`.
  public readonly rateHz: int
  public readonly periodMs: int
  public readonly silenceMs: int
  /// What the next frames carry: a pulse, or `NO_OVERRIDE`, for each of the 16 channels.
  readonly values: int[] = []
  /// Whether frames are being sent now.
  public running: bool = false
  /// Why it stopped the last time: `""` while it runs or has not run, `released` (by the caller), `silent` (no `set` in `silenceMs`).
  public why: string = ""
  /// How many frames of pulses, and how many release frames, it has sent.
  public sent: int = 0
  public released: int = 0
  /// Whether a frame of pulses went out since the last release (a release is sent only then).
  active: bool = false
  lastSetAt: int = 0
  timer: int = -1

  constructor(conn: MavLinkConnection, target: Target, options: RcOptions = {}) {
    this.conn = conn
    this.target = target
    this.rateHz = held(options.rateHz ?? DEFAULT_RATE_HZ, MIN_RATE_HZ, MAX_RATE_HZ)
    this.periodMs = 1000 / this.rateHz
    this.silenceMs = held(options.silenceMs ?? DEFAULT_SILENCE_MS, MIN_SILENCE_MS, MAX_SILENCE_MS)
    for (let i = 0; i < OVERRIDE_CHANNELS; i++) {
      this.values.push(NO_OVERRIDE)
    }
  }

  /// What the next frames carry: `pulses[i]` is the pulse (µs) of channel i + 1, or `NO_OVERRIDE`; channels past the end are the
  /// radio's. More than 16, or a pulse outside 800 to 2200 µs, is an `INVALID_VALUE` MavLinkError, and nothing changes. Calling it
  /// is what keeps the sender sending: it releases and stops when it is not called for `silenceMs`.
  public set(pulses: int[]): void throws Error {
    if (pulses.length > OVERRIDE_CHANNELS) {
      throw new MavLinkError("INVALID_VALUE", `${pulses.length} channels are more than the ${OVERRIDE_CHANNELS} an override has`)
    }
    for (let i = 0; i < pulses.length; i++) {
      const p = pulses[i]
      if (p != NO_OVERRIDE && (p < MIN_PULSE || p > MAX_PULSE)) {
        throw new MavLinkError("INVALID_VALUE", `channel ${i + 1} is ${p} µs, not ${MIN_PULSE} to ${MAX_PULSE}`)
      }
    }
    for (let i = 0; i < OVERRIDE_CHANNELS; i++) {
      values[i] = if (i < pulses.length) pulses[i] else NO_OVERRIDE
    }
    lastSetAt = Date.now() as int
  }

  /// Starts sending, every `periodMs`, what `set` has given. Not at once: the first frame is the first tick, and a sender that was never
  /// given a `set` sends only "ignore" frames (nothing is overridden). A second `start` while it runs does nothing.
  public start(): void {
    if (running) {
      return
    }
    running = true
    why = ""
    lastSetAt = Date.now() as int
    timer = setInterval(() => this.tick(), periodMs)
  }

  /// One round: the sender releases when `set` was not called in time, else it sends the frame.
  tick(): void {
    if (!running) {
      return
    }
    if ((Date.now() as int) - lastSetAt > silenceMs) {
      end("silent")
      return
    }
    conn.send(frame(false))
    sent += 1
    active = true
  }

  /// Stops sending and sends ONE release frame (when a frame of pulses went out since the last release). Safe to call again.
  public release(): void {
    end("released")
  }

  /// Stops the timer, sends the release frame when there is something to release, and records why.
  end(reason: string): void {
    if (timer >= 0) {
      clearInterval(timer)
      timer = -1
    }
    const was = running
    running = false
    if (was) {
      why = reason
    }
    if (active) {
      active = false
      conn.send(frame(true))
      released += 1
    }
  }

  /// RC_CHANNELS_OVERRIDE for the vehicle: the pulses given, or the release values.
  frame(letGo: bool): RcChannelsOverride {
    const m = new RcChannelsOverride()
    m.targetSystem = target.system as u8
    m.targetComponent = target.component as u8
    const v = (i: int) => (if (letGo) (if (i < 8) RELEASE_LOW else RELEASE_HIGH) else (if (values[i] == NO_OVERRIDE) IGNORE else values[i])) as u16
    m.chan1Raw = v(0)
    m.chan2Raw = v(1)
    m.chan3Raw = v(2)
    m.chan4Raw = v(3)
    m.chan5Raw = v(4)
    m.chan6Raw = v(5)
    m.chan7Raw = v(6)
    m.chan8Raw = v(7)
    m.chan9Raw = v(8)
    m.chan10Raw = v(9)
    m.chan11Raw = v(10)
    m.chan12Raw = v(11)
    m.chan13Raw = v(12)
    m.chan14Raw = v(13)
    m.chan15Raw = v(14)
    m.chan16Raw = v(15)
    m.chan17Raw = IGNORE as u16
    m.chan18Raw = IGNORE as u16
    return m
  }
}
