import { describe, it, expect } from "std/test"
import {
  PARAM_PACK_MAGIC,
  PARAM_PACK_MAGIC_WITH_DEFAULTS,
  PackedParam,
  ParamPackError,
  decodeParamPack,
  encodeParamPack,
} from "./parampack"
import { MavParamType } from "./dialects/common"
import { TypedParamValue, showParam } from "./params"

function param(name: string, value: TypedParamValue): PackedParam {
  const p: PackedParam = { name, value }
  p
}

function int8(name: string, v: int): PackedParam {
  param(name, TypedParamValue.Int(v, MavParamType.INT8))
}

function int16(name: string, v: int): PackedParam {
  param(name, TypedParamValue.Int(v, MavParamType.INT16))
}

function int32(name: string, v: int): PackedParam {
  param(name, TypedParamValue.Int(v, MavParamType.INT32))
}

function float(name: string, v: f64): PackedParam {
  param(name, TypedParamValue.Real(v, MavParamType.REAL32))
}

/// What a parameter shows as: name, type and value.
function shown(p: PackedParam): string {
  `${p.name}:${showParam(p.value)}:${typeOf(p.value)}`
}

function typeOf(v: TypedParamValue): int {
  match (v) {
    Int { type } => type,
    Real { type } => type,
  }
}

function sameAll(a: PackedParam[], b: PackedParam[]): bool {
  if (a.length != b.length) {
    return false
  }
  for (let i = 0; i < a.length; i++) {
    if (shown(a[i]) != shown(b[i])) {
      return false
    }
  }
  true
}

/// The code of the error decoding `b` gives, or "ok".
function codeOf(b: Uint8Array): string {
  try {
    decodeParamPack(b)
    "ok"
  } catch (e: ParamPackError) {
    e.code
  }
}

/// The code of the error encoding gives, or "ok".
function encodeCode(params: PackedParam[], withDefaults: bool): string {
  try {
    encodeParamPack(params, params.length, withDefaults)
    "ok"
  } catch (e: ParamPackError) {
    e.code
  }
}

function bytesOf(list: int[]): Uint8Array {
  const b = new Uint8Array(list.length)
  for (let i = 0; i < list.length; i++) {
    b.set(i, list[i])
  }
  b
}

/// A small pseudo-random sequence, the same on every run.
class Lcg {
  state: int = 12345

  public next(n: int): int {
    state = (state * 1103515245 + 12345) & 0x7FFFFFFF
    (state >> 8) % n
  }
}

const LETTERS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"

/// `count` names in the order the vehicle lists them: groups of a shared prefix, as ArduPilot's are ("ATC_RAT_RLL_P").
function names(count: int): string[] {
  const rng = new Lcg()
  const out: string[] = []
  const seen = new Set<string>()
  while (out.length < count) {
    const prefix = rng.next(40) + 1
    const group = rng.next(6) + 1
    for (let g = 0; g < group && out.length < count; g++) {
      let name = `P${prefix}_`
      const extra = rng.next(12) + 1
      for (let i = 0; i < extra && name.length < 16; i++) {
        name += LETTERS[rng.next(LETTERS.length)]
      }
      if (!seen.has(name)) {
        seen.add(name)
        out.push(name)
      }
    }
  }
  out
}

function generated(count: int): PackedParam[] {
  const rng = new Lcg()
  const list: PackedParam[] = []
  for (const name of names(count)) {
    const kind = rng.next(4)
    if (kind == 0) {
      list.push(int8(name, rng.next(256) - 128))
    } else if (kind == 1) {
      list.push(int16(name, rng.next(65536) - 32768))
    } else if (kind == 2) {
      list.push(int32(name, (rng.next(65536) << 16) - 2147483648 + rng.next(65536)))
    } else {
      list.push(float(name, (rng.next(2000000) - 1000000) as f64 / 64.0))
    }
  }
  list
}

function roundTripsThousands(): void throws ParamPackError {
  const params = generated(3000)
  const file = encodeParamPack(params, 3000)
  const pack = decodeParamPack(file)
  expect(pack.total).toBe(3000)
  expect(pack.withDefaults).toBe(false)
  expect(pack.params.length).toBe(3000)
  expect(sameAll(pack.params, params)).toBe(true)
}

function sharesPrefixes(): void throws ParamPackError {
  // The second name rests on the first: its entry holds 1 + 1 + (name without the shared part) + value bytes.
  const short = encodeParamPack([int8("ATC_RAT_RLL_P", 1), int8("ATC_RAT_RLL_I", 2)], 2)
  const alone = encodeParamPack([int8("ATC_RAT_RLL_P", 1), int8("XTC_RAT_RLL_I", 2)], 2)
  expect(alone.length - short.length).toBe(12)
  expect(decodeParamPack(short).params[1].name).toBe("ATC_RAT_RLL_I")
}

function namesOfEveryLength(): void throws ParamPackError {
  const params: PackedParam[] = []
  let name = ""
  for (let n = 1; n <= 16; n++) {
    name = `${LETTERS[n]}${name}`
    params.push(int8(name, n))
  }
  const pack = decodeParamPack(encodeParamPack(params, 16))
  expect(sameAll(pack.params, params)).toBe(true)
  // A name of one character, and one of the full sixteen, are both fine; a name that rests wholly on the one before is not made.
  expect(pack.params[0].name.length).toBe(1)
  expect(pack.params[15].name.length).toBe(16)
}

function aNameThatIsAPrefixOfThePreviousOne(): void throws ParamPackError {
  const params = [int8("ABCDEFGH", 1), int8("ABCD", 2), int8("AB", 3), int8("A", 4)]
  expect(sameAll(decodeParamPack(encodeParamPack(params, 4)).params, params)).toBe(true)
}

function allTypesAtTheirExtremes(): void throws ParamPackError {
  const params = [
    int8("A_MIN", -128),
    int8("A_MAX", 127),
    int16("B_MIN", -32768),
    int16("B_MAX", 32767),
    int32("C_MIN", -2147483648),
    int32("C_MAX", 2147483647),
    int32("C_BIG", 16777217),
    float("D_ZERO", 0.0),
    float("D_NEG", -1.5),
    float("D_SMALL", 1.0e-30),
  ]
  const pack = decodeParamPack(encodeParamPack(params, 10))
  expect(sameAll(pack.params, params)).toBe(true)
  // An INT32 keeps all its bits, which a float field could not.
  expect(showParam(pack.params[6].value)).toBe("16777217")
}

function padsBeforeValuesAtEveryOffset(): void throws ParamPackError {
  // Whatever the read size, no multi-byte value crosses the edge of a read packet, and the decoder skips the padding.
  for (const readSize of [8, 9, 16, 31, 64, 239]) {
    const params = generated(400)
    const file = encodeParamPack(params, 400, false, readSize)
    expect(sameAll(decodeParamPack(file).params, params)).toBe(true)
    // Every value of the file starts and ends inside one read packet: walk the file as the decoder does.
    expect(valuesCross(file, readSize)).toBe(false)
  }
}

/// Whether any value in the file (found by decoding the entries again, here by the layout) crosses a multiple of `readSize`.
function valuesCross(b: Uint8Array, readSize: int): bool {
  let at = 6
  const count = (b[2] as int) | ((b[3] as int) << 8)
  let seen = 0
  while (seen < count) {
    while (b[at] == 0) {
      at += 1
    }
    const type = (b[at] as int) & 0xF
    const common = (b[at + 1] as int) & 0xF
    const length = ((b[at + 1] as int) >> 4) + 1
    const size = if (type == 1) 1 else if (type == 2) 2 else 4
    const from = at + 2 + (length - common)
    if (size > 1 && from / readSize != (from + size - 1) / readSize) {
      return true
    }
    at = from + size
    seen += 1
  }
  false
}

function withDefaults(): void throws ParamPackError {
  const a: PackedParam = { name: "A_ONE", value: TypedParamValue.Int(5, MavParamType.INT16), firmwareDefault: TypedParamValue.Int(-3, MavParamType.INT16) }
  const b: PackedParam = float("A_TWO", 2.5)
  const c: PackedParam = { name: "B_THREE", value: TypedParamValue.Real(1.5, MavParamType.REAL32), firmwareDefault: TypedParamValue.Real(0.25, MavParamType.REAL32) }
  const file = encodeParamPack([a, b, c], 3, true)
  const pack = decodeParamPack(file)
  expect(pack.withDefaults).toBe(true)
  expect(pack.params[0].firmwareDefault != null).toBe(true)
  expect(showParam(pack.params[0].firmwareDefault!)).toBe("-3")
  expect(pack.params[1].firmwareDefault == null).toBe(true)
  expect(showParam(pack.params[2].firmwareDefault!)).toBe("0.25")
  expect(sameAll(pack.params, [a, b, c])).toBe(true)
}

function aSliceHasItsOwnCount(): void throws ParamPackError {
  // A slice of a vehicle that has 1370 parameters: the header says how many are in the file and how many there are.
  const file = encodeParamPack([int8("A_ONE", 1), int8("A_TWO", 2)], 1370)
  const pack = decodeParamPack(file)
  expect(pack.total).toBe(1370)
  expect(pack.params.length).toBe(2)
}

function emptyFile(): void throws ParamPackError {
  const pack = decodeParamPack(encodeParamPack([], 0))
  expect(pack.params.length).toBe(0)
}

function refusesWhatItCannotRead(): void throws ParamPackError {
  const good = encodeParamPack([int8("A_ONE", 1), int16("A_TWO", 2)], 2)
  // A short header, a wrong magic.
  expect(codeOf(bytesOf([0x1b, 0x67, 0]))).toBe("TRUNCATED")
  expect(codeOf(bytesOf([0x00, 0x00, 0, 0, 0, 0]))).toBe("BAD_MAGIC")
  expect(codeOf(bytesOf([0x1b, 0x67, 1, 0, 1, 0]))).toBe("COUNT_MISMATCH")
  // A type that is not one of the four, and flags that are not 0 or 1.
  expect(codeOf(bytesOf([0x1b, 0x67, 1, 0, 1, 0, 0x05, 0x00, 0x41, 0x00]))).toBe("BAD_ENTRY")
  expect(codeOf(bytesOf([0x1b, 0x67, 1, 0, 1, 0, 0x21, 0x00, 0x41, 0x00]))).toBe("BAD_ENTRY")
  // An entry cut off inside its value, and inside its first two bytes.
  expect(codeOf(bytesOf([0x1b, 0x67, 1, 0, 1, 0, 0x03, 0x00, 0x41, 0x00]))).toBe("TRUNCATED")
  expect(codeOf(bytesOf([0x1b, 0x67, 1, 0, 1, 0, 0x01]))).toBe("TRUNCATED")
  // Sharing more of the previous name than there is.
  expect(codeOf(bytesOf([0x1b, 0x67, 1, 0, 1, 0, 0x01, 0x31, 0x41, 0x00]))).toBe("BAD_ENTRY")
  // A file that ends before the entries the header counts, and one with entries the header does not.
  expect(codeOf(good.slice(0, good.length - 2))).toBe("TRUNCATED")
  expect(codeOf(bytesOf([0x1b, 0x67, 2, 0, 2, 0, 0x01, 0x00, 0x41, 0x01]))).toBe("COUNT_MISMATCH")
  expect(codeOf(bytesOf([0x1b, 0x67, 0, 0, 1, 0, 0x01, 0x00, 0x41, 0x01]))).toBe("COUNT_MISMATCH")
  expect(codeOf(good)).toBe("ok")
}

function trailingPaddingIsFine(): void throws ParamPackError {
  const good = encodeParamPack([int8("A_ONE", 1)], 1)
  const longer = new Uint8Array(good.length + 5)
  for (let i = 0; i < good.length; i++) {
    longer.set(i, good[i])
  }
  expect(codeOf(longer)).toBe("ok")
}

function refusesWhatItCannotWrite(): void {
  expect(encodeCode([int8("", 1)], false)).toBe("BAD_NAME")
  expect(encodeCode([int8("ABCDEFGHIJKLMNOPQ", 1)], false)).toBe("BAD_NAME")
  expect(encodeCode([{ name: "A", value: TypedParamValue.Int(1, MavParamType.INT64) }], false)).toBe("UNSUPPORTED_TYPE")
  expect(encodeCode([{ name: "A", value: TypedParamValue.Int(1, MavParamType.UINT8) }], false)).toBe("UNSUPPORTED_TYPE")
  expect(encodeCode([{ name: "A", value: TypedParamValue.Real(1.0, MavParamType.REAL64) }], false)).toBe("UNSUPPORTED_TYPE")
  const withDefault: PackedParam = { name: "A", value: TypedParamValue.Int(1, MavParamType.INT8), firmwareDefault: TypedParamValue.Int(2, MavParamType.INT8) }
  expect(encodeCode([withDefault], false)).toBe("UNSUPPORTED_TYPE")
  expect(encodeCode([withDefault], true)).toBe("ok")
}

function namesArePrintableAscii(): void {
  // A space, a control byte and a byte above 0x7E in a name are refused, and so is a name written with them.
  expect(codeOf(bytesOf([0x1b, 0x67, 1, 0, 1, 0, 0x01, 0x00, 0x20, 0x01]))).toBe("BAD_ENTRY")
  expect(codeOf(bytesOf([0x1b, 0x67, 1, 0, 1, 0, 0x01, 0x00, 0x07, 0x01]))).toBe("BAD_ENTRY")
  expect(codeOf(bytesOf([0x1b, 0x67, 1, 0, 1, 0, 0x01, 0x00, 0xE9, 0x01]))).toBe("BAD_ENTRY")
  expect(codeOf(bytesOf([0x1b, 0x67, 1, 0, 1, 0, 0x01, 0x00, 0x7E, 0x01]))).toBe("ok")
  expect(encodeCode([int8("A B", 1)], false)).toBe("BAD_NAME")
  expect(encodeCode([int8("Ä", 1)], false)).toBe("BAD_NAME")
}

function aDefaultNeedsTheMagicOfDefaults(): void {
  // Flags 1 under the magic of a file without defaults: refused (a vehicle only sets it when asked for defaults).
  expect(codeOf(bytesOf([0x1b, 0x67, 1, 0, 1, 0, 0x11, 0x00, 0x41, 0x01, 0x02]))).toBe("BAD_ENTRY")
  expect(codeOf(bytesOf([0x1c, 0x67, 1, 0, 1, 0, 0x11, 0x00, 0x41, 0x01, 0x02]))).toBe("ok")
}

function aReadSizeThatCannotWork(): void {
  for (const size of [0, 1, 3, -5, 7]) {
    try {
      encodeParamPack([int32("A", 1)], 1, false, size)
      expect(`read size ${size} was accepted`).toBe("refused")
    } catch (e: ParamPackError) {
      expect(e.code).toBe("BAD_READ_SIZE")
    }
  }
  expect(encodeCode8()).toBe("ok")
}

function encodeCode8(): string {
  try {
    encodeParamPack([int32("A", 1)], 1, false, 8)
    "ok"
  } catch (e: ParamPackError) {
    e.code
  }
}

/// What decoding `b` comes to: "pack" or the code of the error. Anything else would panic the test.
function outcomeOf(b: Uint8Array): string {
  try {
    decodeParamPack(b)
    "pack"
  } catch (e: ParamPackError) {
    e.code
  }
}

const CODES = ["pack", "BAD_MAGIC", "TRUNCATED", "BAD_ENTRY", "COUNT_MISMATCH"]

function onlyKnownOutcomes(): void {
  const rng = new Lcg()
  // Random bytes under a valid magic, of every length from 0 to a few hundred.
  for (let round = 0; round < 3000; round++) {
    const length = rng.next(300)
    const b = new Uint8Array(length)
    for (let i = 0; i < length; i++) {
      b.set(i, rng.next(256))
    }
    if (length >= 6 && rng.next(4) != 0) {
      b.set(0, if (rng.next(2) == 0) 0x1b else 0x1c)
      b.set(1, 0x67)
    }
    expect(CODES.includes(outcomeOf(b))).toBe(true)
  }
}

function damagedValidFiles(): void throws ParamPackError {
  const rng = new Lcg()
  const good = encodeParamPack(generated(120), 120)
  const goodWithDefaults = encodeParamPack(generated(60), 60, true)
  for (const original of [good, goodWithDefaults]) {
    for (let round = 0; round < 1500; round++) {
      const kind = rng.next(3)
      const copy = if (kind == 1) new Uint8Array(rng.next(original.length + 1)) else new Uint8Array(original.length + rng.next(40))
      for (let i = 0; i < copy.length; i++) {
        copy.set(i, if (i < original.length) original[i] else rng.next(256))
      }
      if (kind == 0) {
        // Flipped bytes.
        for (let k = 0; k < 1 + rng.next(4); k++) {
          copy.set(rng.next(copy.length), rng.next(256))
        }
      }
      // Cut (kind 1) and extended (kind 2) files are as they were made above.
      expect(CODES.includes(outcomeOf(copy))).toBe(true)
    }
  }
  // The undamaged files still decode.
  expect(decodeParamPack(good).params.length).toBe(120)
}

function headerHasTheMagics(): void throws ParamPackError {
  const plain = encodeParamPack([int8("A", 1)], 1)
  const defaults = encodeParamPack([int8("A", 1)], 1, true)
  expect((plain[0] as int) | ((plain[1] as int) << 8)).toBe(PARAM_PACK_MAGIC)
  expect((defaults[0] as int) | ((defaults[1] as int) << 8)).toBe(PARAM_PACK_MAGIC_WITH_DEFAULTS)
}

describe("the packed parameter file", () => {
  it("round-trips thousands of generated names, in all four types", roundTripsThousands)
  it("stores the part of a name it shares with the one before once", sharesPrefixes)
  it("holds names of every length from 1 to 16 characters", namesOfEveryLength)
  it("holds a name that is the start of the one before it", aNameThatIsAPrefixOfThePreviousOne)
  it("carries every type at its extremes, an INT32 with all its bits", allTypesAtTheirExtremes)
  it("pads so that no value crosses a read packet, for several read sizes, and decodes through the padding", padsBeforeValuesAtEveryOffset)
  it("carries a firmware default where there is one", withDefaults)
  it("says how many parameters the vehicle has, also for a slice", aSliceHasItsOwnCount)
  it("holds no parameters", emptyFile)
  it("has the right magic in its header", headerHasTheMagics)
  it("ignores padding after the last entry", trailingPaddingIsFine)
  it("holds only printable ASCII in a name, reading and writing", namesArePrintableAscii)
  it("takes a default only under the magic of a file with defaults", aDefaultNeedsTheMagicOfDefaults)
  it("refuses a read size under 8 (which would never end, or divide by zero)", aReadSizeThatCannotWork)
  it("comes to a pack or a known error for random bytes under a valid magic", onlyKnownOutcomes)
  it("comes to a pack or a known error for valid files that are flipped, cut or extended", damagedValidFiles)
  it("refuses a bad magic, a bad type or flags, a cut-off entry and a count that does not match", refusesWhatItCannotRead)
  it("refuses to write a name or a type the file cannot hold", refusesWhatItCannotWrite)
})
