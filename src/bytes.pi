// Little-endian reads and writes at an offset, as MAVLink lays out payloads, on the standard
// library's DataView. Reads past the end give 0: MAVLink 2 senders drop the payload's trailing zero
// bytes (and v1 senders may not know about extension fields), so a short payload means zeros, not an
// error. Writes must fit.

/// The byte at `at`, or 0 past the end.
export function byteAt(b: Uint8Array, at: int): int {
  if (at < b.length) b[at] as int else 0
}

/// Where a value cut short by the end of a payload is put together (zeros after the end): one
/// buffer, so that the many short MAVLink 2 payloads allocate nothing.
const SCRATCH = new Uint8Array(8)
const SCRATCH_VIEW = new DataView(SCRATCH)

/// `n` bytes at `at`, zero-extended past the end of `b`: `b` itself when they're all there, else
/// the scratch buffer (valid until the next short read).
function span(b: Uint8Array, at: int, n: int): DataView {
  if (at + n <= b.length) {
    return new DataView(b.buffer, b.byteOffset + at, n)
  }
  for (let i = 0; i < n; i++) {
    SCRATCH.set(i, byteAt(b, at + i))
  }
  return SCRATCH_VIEW
}

/// An unsigned little-endian integer of `n` bytes (at most 7) at `at`.
export function readUint(b: Uint8Array, at: int, n: int): int {
  let v = 0
  for (let i = n - 1; i >= 0; i--) {
    v = (v << 8) | byteAt(b, at + i)
  }
  return v
}

export function readU8(b: Uint8Array, at: int): u8 {
  return byteAt(b, at) as u8
}

export function readI8(b: Uint8Array, at: int): i8 {
  return span(b, at, 1).getInt8(0) as i8
}

export function readU16(b: Uint8Array, at: int): u16 {
  return span(b, at, 2).getUint16(0, true) as u16
}

export function readI16(b: Uint8Array, at: int): i16 {
  return span(b, at, 2).getInt16(0, true) as i16
}

export function readU32(b: Uint8Array, at: int): u32 {
  return span(b, at, 4).getUint32(0, true) as u32
}

export function readI32(b: Uint8Array, at: int): i32 {
  return span(b, at, 4).getInt32(0, true) as i32
}

export function readU64(b: Uint8Array, at: int): u64 {
  return span(b, at, 8).getBigUint64(0, true)
}

export function readI64(b: Uint8Array, at: int): i64 {
  return span(b, at, 8).getBigInt64(0, true)
}

export function readF32(b: Uint8Array, at: int): f32 {
  return span(b, at, 4).getFloat32(0, true)
}

export function readF64(b: Uint8Array, at: int): f64 {
  return span(b, at, 8).getFloat64(0, true)
}

/// Text up to the first NUL (or `n` bytes), as `char[n]` fields hold it; invalid UTF-8 becomes
/// U+FFFD, as node-mavlink's Buffer.toString("utf8") does.
export function readChars(b: Uint8Array, at: int, n: int): string {
  const start = if (at < b.length) at else b.length
  const end = if (at + n < b.length) at + n else b.length
  return string.fromCBytes(b.subarray(start, end))
}

/// Writes the low `n` bytes of `v`, little-endian.
export function writeUint(b: Uint8Array, at: int, n: int, v: int): void {
  let x = v
  for (let i = 0; i < n; i++) {
    b.set(at + i, x & 0xFF)
    x = x >> 8
  }
}

export function writeU64(b: Uint8Array, at: int, v: u64): void {
  new DataView(b).setBigUint64(at, v, true)
}

export function writeF32(b: Uint8Array, at: int, v: f32): void {
  new DataView(b).setFloat32(at, v, true)
}

export function writeF64(b: Uint8Array, at: int, v: f64): void {
  new DataView(b).setFloat64(at, v, true)
}

/// `s` as UTF-8 in `n` bytes, cut at `n` and NUL-padded (the rest of the field stays 0).
export function writeChars(b: Uint8Array, at: int, n: int, s: string): void {
  const bytes = new TextEncoder().encode(s)
  const len = if (bytes.length < n) bytes.length else n
  b.setAll(bytes.subarray(0, len), at)
}
