  const signer = new MavLinkProtocolV2(184, 76, MavLinkProtocolV2.IFLAG_SIGNED)
  expect(hex(signer.sign(signer.serialize(m, 10), 7, KEY, 1700000000000))).toBe("fd1401000ab84c0e0100c926cf4369397cfb779fd6c9922031bc4103017511ed0700e06f9e75190e3294588b4d")
