  m.xacc = -19639
  m.yacc = -14103
  m.zacc = -13803
  m.xgyro = 23957
  m.ygyro = -3345
  m.zgyro = 793
  m.xmag = 25752
  m.ymag = -1773
  m.zmag = 3959
  m.temperature = 31733
  expect(hex(new MavLinkProtocolV2(139, 43).serialize(m, 101))).toBe("fd180000658b2b810000f51f166849b3e9c815ca955deff21903986413f9770ff57b5edd")
  const signer = new MavLinkProtocolV2(139, 43, MavLinkProtocolV2.IFLAG_SIGNED)
  expect(hex(signer.sign(signer.serialize(m, 101), 7, KEY, 1700000000000))).toBe("fd180100658b2b810000f51f166849b3e9c815ca955deff21903986413f9770ff57b3d9d0700e06f9e7519ff3312eb8533")
  // v1: node-mavlink's frame without the extension fields (docs/design.md §3.4)
  expect(hex(new MavLinkProtocolV1(139, 43).serialize(m, 101))).toBe("fe16658b2b81f51f166849b3e9c815ca955deff21903986413f9770f84b7")
  const d = ScaledImu3.decode(new MavLinkPacketParser().parse(unhex("fd180000658b2b810000f51f166849b3e9c815ca955deff21903986413f9770ff57b5edd")).payload)
  expect(`timeBootMs ${d.timeBootMs == 1746280437}`).toBe("timeBootMs true")
  expect(`xacc ${d.xacc == -19639}`).toBe("xacc true")
  expect(`yacc ${d.yacc == -14103}`).toBe("yacc true")
  expect(`zacc ${d.zacc == -13803}`).toBe("zacc true")
  expect(`xgyro ${d.xgyro == 23957}`).toBe("xgyro true")
  expect(`ygyro ${d.ygyro == -3345}`).toBe("ygyro true")
  expect(`zgyro ${d.zgyro == 793}`).toBe("zgyro true")
  expect(`xmag ${d.xmag == 25752}`).toBe("xmag true")
  expect(`ymag ${d.ymag == -1773}`).toBe("ymag true")
  expect(`zmag ${d.zmag == 3959}`).toBe("zmag true")
  expect(`temperature ${d.temperature == 31733}`).toBe("temperature true")
}

