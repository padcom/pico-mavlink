/// OPEN_DRONE_ID_ARM_STATUS (common, id 12918)
function case220(): void throws Error {
  const m = new OpenDroneIdArmStatus()
  m.status = 83
  m.error = "_7stkdJZ8LUo5Kzhl1K9WEVQZD07O6wlzrYFY4VuU5Kcm5J2Op"
  expect(hex(new MavLinkProtocolV2(225, 206).serialize(m, 109))).toBe("fd3300006de1ce763200535f3773746b644a5a384c556f354b7a686c314b39574556515a4430374f36776c7a7259465934567555354b636d354a324f70edac")
  const signer = new MavLinkProtocolV2(225, 206, MavLinkProtocolV2.IFLAG_SIGNED)
  expect(hex(signer.sign(signer.serialize(m, 109), 7, KEY, 1700000000000))).toBe("fd3301006de1ce763200535f3773746b644a5a384c556f354b7a686c314b39574556515a4430374f36776c7a7259465934567555354b636d354a324f70d9b70700e06f9e75197a2a423268b9")
  // v1: an id above 255 doesn't fit (refused)
  const d = OpenDroneIdArmStatus.decode(new MavLinkPacketParser().parse(unhex("fd3300006de1ce763200535f3773746b644a5a384c556f354b7a686c314b39574556515a4430374f36776c7a7259465934567555354b636d354a324f70edac")).payload)
  expect(`status ${d.status == 83}`).toBe("status true")
  expect(d.error).toBe("_7stkdJZ8LUo5Kzhl1K9WEVQZD07O6wlzrYFY4VuU5Kcm5J2Op")
}

