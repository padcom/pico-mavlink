/// REMOTE_LOG_BLOCK_STATUS (ardupilotmega, id 185)
function case256(): void throws Error {
  const m = new RemoteLogBlockStatus()
  m.seqno = 4235378406
  m.targetSystem = 176
  m.targetComponent = 52
  m.status = 73
  expect(hex(new MavLinkProtocolV2(97, 204).serialize(m, 129))).toBe("fd0700008161ccb90000e6be72fcb034496a8b")
  const signer = new MavLinkProtocolV2(97, 204, MavLinkProtocolV2.IFLAG_SIGNED)
  expect(hex(signer.sign(signer.serialize(m, 129), 7, KEY, 1700000000000))).toBe("fd0701008161ccb90000e6be72fcb034497a050700e06f9e751951008db1daab")
  expect(hex(new MavLinkProtocolV1(97, 204).serialize(m, 129))).toBe("fe078161ccb9e6be72fcb03449b054")
  const d = RemoteLogBlockStatus.decode(new MavLinkPacketParser().parse(unhex("fd0700008161ccb90000e6be72fcb034496a8b")).payload)
  expect(`seqno ${d.seqno == 4235378406}`).toBe("seqno true")
  expect(`targetSystem ${d.targetSystem == 176}`).toBe("targetSystem true")
  expect(`targetComponent ${d.targetComponent == 52}`).toBe("targetComponent true")
  expect(`status ${d.status == 73}`).toBe("status true")
}

