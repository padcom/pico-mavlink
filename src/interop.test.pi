/// TIMESYNC (common, id 111)
function case80(): void throws Error {
  const m = new TimeSync()
  m.tc1 = 59118759762474
  m.ts1 = 541495013151807
  m.targetSystem = 45
  m.targetComponent = 155
  expect(hex(new MavLinkProtocolV2(185, 117).serialize(m, 74))).toBe("fd1200004ab9756f00002adaaca8c43500003f14e8a17cec01002d9b2394")
  const signer = new MavLinkProtocolV2(185, 117, MavLinkProtocolV2.IFLAG_SIGNED)
  expect(hex(signer.sign(signer.serialize(m, 74), 7, KEY, 1700000000000))).toBe("fd1201004ab9756f00002adaaca8c43500003f14e8a17cec01002d9b6bc60700e06f9e75199dd95f8ec436")
  // v1: node-mavlink's frame without the extension fields (docs/design.md §3.4)
  expect(hex(new MavLinkProtocolV1(185, 117).serialize(m, 74))).toBe("fe104ab9756f2adaaca8c43500003f14e8a17cec01001cfe")
  const d = TimeSync.decode(new MavLinkPacketParser().parse(unhex("fd1200004ab9756f00002adaaca8c43500003f14e8a17cec01002d9b2394")).payload)
  expect(`tc1 ${d.tc1 == 59118759762474}`).toBe("tc1 true")
  expect(`ts1 ${d.ts1 == 541495013151807}`).toBe("ts1 true")
  expect(`targetSystem ${d.targetSystem == 45}`).toBe("targetSystem true")
  expect(`targetComponent ${d.targetComponent == 155}`).toBe("targetComponent true")
}

/// CAMERA_TRIGGER (common, id 112)
function case81(): void throws Error {
  const m = new CameraTrigger()
  m.timeUsec = 688797224147260
  m.seq = 2025195086
  expect(hex(new MavLinkProtocolV2(127, 126).serialize(m, 45))).toBe("fd0c00002d7f7e7000003c19de19757202004e06b678e557")
  const signer = new MavLinkProtocolV2(127, 126, MavLinkProtocolV2.IFLAG_SIGNED)
  expect(hex(signer.sign(signer.serialize(m, 45), 7, KEY, 1700000000000))).toBe("fd0c01002d7f7e7000003c19de19757202004e06b67889600700e06f9e75195b629c4f5a11")
  expect(hex(new MavLinkProtocolV1(127, 126).serialize(m, 45))).toBe("fe0c2d7f7e703c19de19757202004e06b6785770")
  const d = CameraTrigger.decode(new MavLinkPacketParser().parse(unhex("fd0c00002d7f7e7000003c19de19757202004e06b678e557")).payload)
  expect(`timeUsec ${d.timeUsec == 688797224147260}`).toBe("timeUsec true")
  expect(`seq ${d.seq == 2025195086}`).toBe("seq true")
}

/// HIL_GPS (common, id 113)
function case82(): void throws Error {
  const m = new HilGps()
  m.timeUsec = 127818605910872
  m.lat = -1852180161
  m.lon = -566175061
  m.alt = 1189282168
  m.eph = 39221
  m.epv = 36765
  m.vel = 51475
  m.vn = 3113
  m.ve = -7893
  m.vd = -32433
  m.cog = 35629
  m.fixType = 123
  m.satellitesVisible = 123
  m.id = 54
  m.yaw = 9183
  expect(hex(new MavLinkProtocolV2(123, 17).serialize(m, 107))).toBe("fd2700006b7b1171000058db9916407400003ff99991abda40de7801e34635999d8f13c9290c2be14f812d8b7b7b36df23aaf7")
  const signer = new MavLinkProtocolV2(123, 17, MavLinkProtocolV2.IFLAG_SIGNED)
  expect(hex(signer.sign(signer.serialize(m, 107), 7, KEY, 1700000000000))).toBe("fd2701006b7b1171000058db9916407400003ff99991abda40de7801e34635999d8f13c9290c2be14f812d8b7b7b36df23d0ba0700e06f9e75197fdf757ad27d")
  // v1: node-mavlink's frame without the extension fields (docs/design.md §3.4)
  expect(hex(new MavLinkProtocolV1(123, 17).serialize(m, 107))).toBe("fe246b7b117158db9916407400003ff99991abda40de7801e34635999d8f13c9290c2be14f812d8b7b7b3290")
  const d = HilGps.decode(new MavLinkPacketParser().parse(unhex("fd2700006b7b1171000058db9916407400003ff99991abda40de7801e34635999d8f13c9290c2be14f812d8b7b7b36df23aaf7")).payload)
  expect(`timeUsec ${d.timeUsec == 127818605910872}`).toBe("timeUsec true")
  expect(`lat ${d.lat == -1852180161}`).toBe("lat true")
  expect(`lon ${d.lon == -566175061}`).toBe("lon true")
  expect(`alt ${d.alt == 1189282168}`).toBe("alt true")
  expect(`eph ${d.eph == 39221}`).toBe("eph true")
  expect(`epv ${d.epv == 36765}`).toBe("epv true")
  expect(`vel ${d.vel == 51475}`).toBe("vel true")
  expect(`vn ${d.vn == 3113}`).toBe("vn true")
  expect(`ve ${d.ve == -7893}`).toBe("ve true")
  expect(`vd ${d.vd == -32433}`).toBe("vd true")
  expect(`cog ${d.cog == 35629}`).toBe("cog true")
  expect(`fixType ${d.fixType == 123}`).toBe("fixType true")
  expect(`satellitesVisible ${d.satellitesVisible == 123}`).toBe("satellitesVisible true")
  expect(`id ${d.id == 54}`).toBe("id true")
  expect(`yaw ${d.yaw == 9183}`).toBe("yaw true")
}

/// HIL_OPTICAL_FLOW (common, id 114)
function case83(): void throws Error {
  const m = new HilOpticalFlow()
  m.timeUsec = 355557207767892
  m.integrationTimeUs = 590526496
  m.integratedX = (864.3980102539062) as f32
  m.integratedY = (145.79200744628906) as f32
  m.integratedXgyro = (-612.551025390625) as f32
