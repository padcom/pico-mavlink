/// SCALED_PRESSURE3 (common, id 143)
function case112(): void throws Error {
  const m = new ScaledPressure3()
  m.timeBootMs = 1649022673
  m.pressAbs = (-354.9859924316406) as f32
  m.pressDiff = (814.125) as f32
  m.temperature = -11713
  m.temperaturePressDiff = -31633
  expect(hex(new MavLinkProtocolV2(158, 175).serialize(m, 103))).toBe("fd100000679eaf8f0000d1164a62357eb1c300884b443fd26f8449a4")
  const signer = new MavLinkProtocolV2(158, 175, MavLinkProtocolV2.IFLAG_SIGNED)
  expect(hex(signer.sign(signer.serialize(m, 103), 7, KEY, 1700000000000))).toBe("fd100100679eaf8f0000d1164a62357eb1c300884b443fd26f8432a00700e06f9e7519a31a5912055a")
  // v1: node-mavlink's frame without the extension fields (docs/design.md §3.4)
  expect(hex(new MavLinkProtocolV1(158, 175).serialize(m, 103))).toBe("fe0e679eaf8fd1164a62357eb1c300884b443fd2bbed")
  const d = ScaledPressure3.decode(new MavLinkPacketParser().parse(unhex("fd100000679eaf8f0000d1164a62357eb1c300884b443fd26f8449a4")).payload)
  expect(`timeBootMs ${d.timeBootMs == 1649022673}`).toBe("timeBootMs true")
  expect(`pressAbs ${d.pressAbs == (-354.9859924316406) as f32}`).toBe("pressAbs true")
  expect(`pressDiff ${d.pressDiff == (814.125) as f32}`).toBe("pressDiff true")
  expect(`temperature ${d.temperature == -11713}`).toBe("temperature true")
  expect(`temperaturePressDiff ${d.temperaturePressDiff == -31633}`).toBe("temperaturePressDiff true")
}

