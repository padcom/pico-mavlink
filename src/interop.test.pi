/// LOGGING_ACK (common, id 268)
function case152(): void throws Error {
  const m = new LoggingAck()
  m.sequence = 38226
  m.targetSystem = 16
  m.targetComponent = 49
  expect(hex(new MavLinkProtocolV2(121, 240).serialize(m, 169))).toBe("fd040000a979f00c01005295103159f8")
  const signer = new MavLinkProtocolV2(121, 240, MavLinkProtocolV2.IFLAG_SIGNED)
  expect(hex(signer.sign(signer.serialize(m, 169), 7, KEY, 1700000000000))).toBe("fd040100a979f00c010052951031f4fd0700e06f9e75198f7e22a00b73")
  // v1: an id above 255 doesn't fit (refused)
  const d = LoggingAck.decode(new MavLinkPacketParser().parse(unhex("fd040000a979f00c01005295103159f8")).payload)
  expect(`sequence ${d.sequence == 38226}`).toBe("sequence true")
  expect(`targetSystem ${d.targetSystem == 16}`).toBe("targetSystem true")
  expect(`targetComponent ${d.targetComponent == 49}`).toBe("targetComponent true")
}

/// VIDEO_STREAM_INFORMATION (common, id 269)
function case153(): void throws Error {
  const m = new VideoStreamInformation()
  m.framerate = (-43.999000549316406) as f32
  m.bitrate = 529507817
  m.flags = 60327
  m.resolutionH = 56113
  m.resolutionV = 35142
  m.rotation = 35586
  m.hfov = 53305
  m.streamId = 199
  m.count = 230
  m.type = 242
  m.name = "NuCyOzSPA9SWKaYzrHZg9bqZlWkOrIYs"
  m.uri = "bRxjgpGxO5UD45vsjOFy2F2mc6ZvEkUnLzWX6UnMP9wzj88rhGeZmCDtbF1w"
  m.encoding = 134
  m.cameraDeviceId = 62
  expect(hex(new MavLinkProtocolV2(120, 142).serialize(m, 47))).toBe("")
  const signer = new MavLinkProtocolV2(120, 142, MavLinkProtocolV2.IFLAG_SIGNED)
  expect(hex(signer.sign(signer.serialize(m, 47), 7, KEY, 1700000000000))).toBe("")
  // v1: an id above 255 doesn't fit (refused)
  const d = VideoStreamInformation.decode(new MavLinkPacketParser().parse(unhex("")).payload)
  expect(`framerate ${d.framerate == (-43.999000549316406) as f32}`).toBe("framerate true")
  expect(`bitrate ${d.bitrate == 529507817}`).toBe("bitrate true")
  expect(`flags ${d.flags == 60327}`).toBe("flags true")
  expect(`resolutionH ${d.resolutionH == 56113}`).toBe("resolutionH true")
  expect(`resolutionV ${d.resolutionV == 35142}`).toBe("resolutionV true")
  expect(`rotation ${d.rotation == 35586}`).toBe("rotation true")
  expect(`hfov ${d.hfov == 53305}`).toBe("hfov true")
  expect(`streamId ${d.streamId == 199}`).toBe("streamId true")
  expect(`count ${d.count == 230}`).toBe("count true")
  expect(`type ${d.type == 242}`).toBe("type true")
  expect(d.name).toBe("NuCyOzSPA9SWKaYzrHZg9bqZlWkOrIYs")
  expect(d.uri).toBe("bRxjgpGxO5UD45vsjOFy2F2mc6ZvEkUnLzWX6UnMP9wzj88rhGeZmCDtbF1w")
  expect(`encoding ${d.encoding == 134}`).toBe("encoding true")
  expect(`cameraDeviceId ${d.cameraDeviceId == 62}`).toBe("cameraDeviceId true")
}

/// VIDEO_STREAM_STATUS (common, id 270)
function case154(): void throws Error {
  const m = new VideoStreamStatus()
  m.framerate = (414.3030090332031) as f32
  m.bitrate = 4219222377
