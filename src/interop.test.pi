  expect(`totalcurrent[2] ${d.totalcurrent[2] == 42133}`).toBe("totalcurrent[2] true")
  expect(`totalcurrent[3] ${d.totalcurrent[3] == 34527}`).toBe("totalcurrent[3] true")
  expect(`rpm[0] ${d.rpm[0] == 60498}`).toBe("rpm[0] true")
  expect(`rpm[1] ${d.rpm[1] == 55402}`).toBe("rpm[1] true")
  expect(`rpm[2] ${d.rpm[2] == 21398}`).toBe("rpm[2] true")
  expect(`rpm[3] ${d.rpm[3] == 17303}`).toBe("rpm[3] true")
  expect(`count[0] ${d.count[0] == 12786}`).toBe("count[0] true")
  expect(`count[1] ${d.count[1] == 47074}`).toBe("count[1] true")
  expect(`count[2] ${d.count[2] == 36827}`).toBe("count[2] true")
  expect(`count[3] ${d.count[3] == 42369}`).toBe("count[3] true")
  expect(`temperature[0] ${d.temperature[0] == 65}`).toBe("temperature[0] true")
  expect(`temperature[1] ${d.temperature[1] == 250}`).toBe("temperature[1] true")
  expect(`temperature[2] ${d.temperature[2] == 224}`).toBe("temperature[2] true")
  expect(`temperature[3] ${d.temperature[3] == 243}`).toBe("temperature[3] true")
}

/// NAMED_VALUE_STRING (ardupilotmega, id 11060)
function case295(): void throws Error {
  const m = new NamedValueString()
  m.timeBootMs = 4116766954
  m.name = "P3GM9zTLtW"
  m.value = "RkKAKjJLOc5hd"
  expect(hex(new MavLinkProtocolV2(27, 65).serialize(m, 218))).toBe("fd1b0000da1b41342b00eae060f55033474d397a544c7457526b4b414b6a4a4c4f63356864158c")
  const signer = new MavLinkProtocolV2(27, 65, MavLinkProtocolV2.IFLAG_SIGNED)
  expect(hex(signer.sign(signer.serialize(m, 218), 7, KEY, 1700000000000))).toBe("fd1b0100da1b41342b00eae060f55033474d397a544c7457526b4b414b6a4a4c4f633568645a200700e06f9e751909d8640c3b35")
  // v1: an id above 255 doesn't fit (refused)
  const d = NamedValueString.decode(new MavLinkPacketParser().parse(unhex("fd1b0000da1b41342b00eae060f55033474d397a544c7457526b4b414b6a4a4c4f63356864158c")).payload)
  expect(`timeBootMs ${d.timeBootMs == 4116766954}`).toBe("timeBootMs true")
  expect(d.name).toBe("P3GM9zTLtW")
  expect(d.value).toBe("RkKAKjJLOc5hd")
}

