/// DISTANCE_SENSOR (common, id 132)
function case101(): void throws Error {
  const m = new DistanceSensor()
  m.timeBootMs = 713238466
  m.minDistance = 47017
  m.maxDistance = 25798
  m.currentDistance = 8375
  m.type = 73
  m.id = 40
  m.orientation = 71
  m.covariance = 123
  m.horizontalFov = (623.5) as f32
  m.verticalFov = (491.6600036621094) as f32
  m.quaternion = [(-45.04600143432617) as f32, (873.697998046875) as f32, (-868.7559814453125) as f32, (757.9400024414062) as f32]
  m.signalQuality = 214
  expect(hex(new MavLinkProtocolV2(24, 222).serialize(m, 131))).toBe("fd2700008318de840000c227832aa9b7c664b7204928477b00e01b447bd4f5431b2f34c2ac6c5a44623059c4297c3d44d61532")
  const signer = new MavLinkProtocolV2(24, 222, MavLinkProtocolV2.IFLAG_SIGNED)
  expect(hex(signer.sign(signer.serialize(m, 131), 7, KEY, 1700000000000))).toBe("fd2701008318de840000c227832aa9b7c664b7204928477b00e01b447bd4f5431b2f34c2ac6c5a44623059c4297c3d44d66f7f0700e06f9e75196ad9bc42c833")
  // v1: node-mavlink's frame without the extension fields (docs/design.md §3.4)
  expect(hex(new MavLinkProtocolV1(24, 222).serialize(m, 131))).toBe("fe0e8318de84c227832aa9b7c664b7204928477ba873")
  const d = DistanceSensor.decode(new MavLinkPacketParser().parse(unhex("fd2700008318de840000c227832aa9b7c664b7204928477b00e01b447bd4f5431b2f34c2ac6c5a44623059c4297c3d44d61532")).payload)
  expect(`timeBootMs ${d.timeBootMs == 713238466}`).toBe("timeBootMs true")
  expect(`minDistance ${d.minDistance == 47017}`).toBe("minDistance true")
  expect(`maxDistance ${d.maxDistance == 25798}`).toBe("maxDistance true")
  expect(`currentDistance ${d.currentDistance == 8375}`).toBe("currentDistance true")
  expect(`type ${d.type == 73}`).toBe("type true")
  expect(`id ${d.id == 40}`).toBe("id true")
  expect(`orientation ${d.orientation == 71}`).toBe("orientation true")
  expect(`covariance ${d.covariance == 123}`).toBe("covariance true")
  expect(`horizontalFov ${d.horizontalFov == (623.5) as f32}`).toBe("horizontalFov true")
  expect(`verticalFov ${d.verticalFov == (491.6600036621094) as f32}`).toBe("verticalFov true")
  expect(`quaternion[0] ${d.quaternion[0] == (-45.04600143432617) as f32}`).toBe("quaternion[0] true")
  expect(`quaternion[1] ${d.quaternion[1] == (873.697998046875) as f32}`).toBe("quaternion[1] true")
  expect(`quaternion[2] ${d.quaternion[2] == (-868.7559814453125) as f32}`).toBe("quaternion[2] true")
  expect(`quaternion[3] ${d.quaternion[3] == (757.9400024414062) as f32}`).toBe("quaternion[3] true")
  expect(`signalQuality ${d.signalQuality == 214}`).toBe("signalQuality true")
}

