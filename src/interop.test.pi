/// DEVICE_OP_WRITE_REPLY (ardupilotmega, id 11003)
function case274(): void throws Error {
  const m = new DeviceOpWriteReply()
  m.requestId = 1884573597
  m.result = 180
  expect(hex(new MavLinkProtocolV2(68, 229).serialize(m, 171))).toBe("fd050000ab44e5fb2a009d4f5470b48c09")
  const signer = new MavLinkProtocolV2(68, 229, MavLinkProtocolV2.IFLAG_SIGNED)
  expect(hex(signer.sign(signer.serialize(m, 171), 7, KEY, 1700000000000))).toBe("fd050100ab44e5fb2a009d4f5470b466770700e06f9e751936dc853c4dad")
  // v1: an id above 255 doesn't fit (refused)
  const d = DeviceOpWriteReply.decode(new MavLinkPacketParser().parse(unhex("fd050000ab44e5fb2a009d4f5470b48c09")).payload)
  expect(`requestId ${d.requestId == 1884573597}`).toBe("requestId true")
  expect(`result ${d.result == 180}`).toBe("result true")
}

