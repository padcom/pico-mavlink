// A simulated autopilot: a vehicle on the far end of a byte stream, for trying an application (or
// testing it) without hardware or SITL. It's ArduPilot Copter-like: system 1, component 1,
// C-cast parameters, HEARTBEAT, SYS_STATUS and ATTITUDE once a second (or as fast as asked), and it
// answers PARAM_REQUEST_LIST, PARAM_REQUEST_READ and PARAM_SET. Its data is deterministic, except the time
// since boot in ATTITUDE, which is real time.
//
// SYS_STATUS and ATTITUDE come at each tick unless MAV_CMD_SET_MESSAGE_INTERVAL (or REQUEST_DATA_STREAM for
// their streams, EXTENDED_STATUS and EXTRA1) gave them a rate of their own, which it then keeps until it
// reboots (`reboot()` forgets every rate, restarts the clock and can go quiet for a while).
import { delay } from "std/timers"
import { MavLinkConnection, Received } from "./connection"
import { Target } from "./operations"
import { MavLinkProtocolV2 } from "./protocol"
import { ParamEncoding, TypedParamValue, decodeParam, encodeParam } from "./params"
import { PackedParam, ParamPackError, encodeParamPack } from "./parampack"
import { FTP_MAX_DATA, FtpError, FtpNack, FtpOpcode, FtpPacket, ftpMessage, ftpPacketOf } from "./ftp"
import { ByteStream } from "./stream"
import { Heartbeat, MavAutopilot, MavModeFlag, MavState, MavType } from "./dialects/minimal"
import { Attitude, CommandAck, CommandLong, FileTransferProtocol, MavCmd, MavDataStream, MavParamType, MavResult, ParamRequestList, ParamRequestRead, ParamSet, ParamValue, RequestDataStream, SysStatus, SystemTime } from "./dialects/common"
import { AutopilotVersion, MavProtocolCapability } from "./dialects/standard"

/// An FTP request and who sent it.
class FtpAsk {
  public readonly req: FtpPacket
  public readonly to: Target

  constructor(req: FtpPacket, to: Target) {
    this.req = req
    this.to = to
  }
}

/// The last reply sent to one sender on one session, and the sequence number of the request it answered. A repeated request (the
/// same sender, session and sequence number: the reply was lost) is answered with this packet again, without being handled again,
/// as the vehicle does.
class FtpCached {
  public readonly seq: int
  public readonly message: FileTransferProtocol

  constructor(seq: int, message: FileTransferProtocol) {
    this.seq = seq
    this.message = message
  }
}

/// The `n` bytes of `file` from `at` (fewer at its end).
function slice(file: Uint8Array, at: int, n: int): Uint8Array {
  const have = if (at + n > file.length) file.length - at else n
  const out = new Uint8Array(if (have < 0) 0 else have)
  for (let i = 0; i < out.length; i++) {
    out.set(i, file[at + i])
  }
  out
}

/// How many parameters a packed parameter file says it holds (its header's `num_params`).
function readCount(file: Uint8Array): int {
  if (file.length < 4) 0 else (file[2] as int) | ((file[3] as int) << 8)
}

/// The number in `text` (digits only; 0 for anything else).
function parseNumber(text: string): int {
  let n = 0
  for (const ch of text.split("")) {
    const digit = "0123456789".indexOf(ch)
    if (digit < 0) {
      return 0
    }
    n = n * 10 + digit
  }
  n
}

/// One parameter of the simulated vehicle.
export struct SimParam {
  id: string
  value: TypedParamValue
  /// The firmware's default, when it differs from the value (served in the packed parameter file when asked for defaults).
  firmwareDefault?: TypedParamValue
}

/// One open FTP session of the simulated vehicle: the file as it was made when it was opened.
class FtpSession {
  public readonly id: int
  public readonly file: Uint8Array
  /// The size every read of this file must ask for: fixed by the first read (the packed parameter file computes its padding from
  /// it, and answers EINVAL to any other). 0 until the first read.
  public readSize: int = 0
  public lastAt: int = 0

  constructor(id: int, file: Uint8Array) {
    this.id = id
    this.file = file
    this.lastAt = Date.now() as int
  }
}

/// ArduPilot Copter-like parameters (the Drone Configurator's fixtures use the same).
export function defaultSimParams(): SimParam[] {
  const i32 = MavParamType.INT32
  const r32 = MavParamType.REAL32
  [
    { id: "ARMING_CHECK", value: TypedParamValue.Int(1, i32) },
    { id: "BATT_CAPACITY", value: TypedParamValue.Int(5200, i32) },
    { id: "BATT_LOW_VOLT", value: TypedParamValue.Real(10.5, r32) },
    { id: "FENCE_ENABLE", value: TypedParamValue.Int(0, MavParamType.INT8) },
    { id: "FENCE_RADIUS", value: TypedParamValue.Real(150.0, r32) },
    { id: "FS_THR_ENABLE", value: TypedParamValue.Int(1, MavParamType.INT8) },
    { id: "LOIT_SPEED", value: TypedParamValue.Real(1250.0, r32) },
    { id: "PILOT_SPEED_UP", value: TypedParamValue.Int(250, MavParamType.INT16) },
    { id: "RTL_ALT", value: TypedParamValue.Int(1500, i32) },
    { id: "SERIAL0_BAUD", value: TypedParamValue.Int(115, i32) },
    { id: "SYSID_THISMAV", value: TypedParamValue.Int(1, MavParamType.INT16) },
    { id: "WPNAV_SPEED", value: TypedParamValue.Real(1000.0, r32) },
  ]
}

export class SimulatedAutopilot {
  public readonly conn: MavLinkConnection
  public readonly params: SimParam[]
  /// Its system and component id (1 and 1 by default). Like an autopilot it ignores a request addressed
  /// to another system or component (0 means everyone).
  public readonly sysid: int
  public readonly compid: int
  /// Telemetry ticks so far (the battery drains and the vehicle sways with them).
  public ticks: int = 0
  /// Parameter writes it rounds to whole numbers (an autopilot that changes what it's given).
  public rounding: string[] = []
  /// Whether it answers requests for AUTOPILOT_VERSION (an old autopilot may not).
  public answersVersion: bool = true
  /// Whether it answers SET_MESSAGE_INTERVAL with UNSUPPORTED (a vehicle that only has data streams).
  public rejectIntervals: bool = false
  /// Whether SYS_STATUS and ATTITUDE come at each tick when nothing was asked for them (the default). Set it to
  /// false for an ArduPilot on a new link, which sends only heartbeats until it is asked, and forgets what it was
  /// asked when it reboots.
  public streaming: bool = true
  /// How many times SYSTEM_TIME was asked for with MAV_CMD_REQUEST_MESSAGE.
  public systemTimeRequests: int = 0
  /// The intervals it was asked for, by message id: milliseconds between messages, -1 for off. A message
  /// with none comes at each tick.
  public readonly intervals: Map<int, int> = new Map<int, int>()
  /// The stream rates it was asked for (Hz), by MAV_DATA_STREAM id; 0 for a stream that was stopped.
  public readonly streams: Map<int, int> = new Map<int, int>()
  /// How many times it has rebooted.
  public reboots: int = 0
  timer: int = -1
  /// The timer that ends a reboot's quiet time.
  downTimer: int = -1
  /// One timer per message that has an interval of its own.
  readonly timers: Map<int, int> = new Map<int, int>()
  bootedAt: int = 0
  /// Whether it is quiet (after a reboot, or set by hand): it sends nothing and hears nothing.
  public down: bool = false
  /// Whether it has MAVLink FTP (the capability bit in AUTOPILOT_VERSION, and the server for "@PARAM/param.pck"). A vehicle
  /// without it (a small board, `BRD_OPTIONS` bit 1) ignores FILE_TRANSFER_PROTOCOL.
  public ftp: bool = true
  /// How the FTP server misbehaves, for tests: `ok`; `unsupported` (every open fails with ENOENT, though the capability is set);
  /// `silent` (it never answers an FTP request); `corrupt` (the file has a wrong magic); `incomplete` (the file says the vehicle
  /// has more parameters than it holds).
  public ftpMode: string = "ok"
  /// The share of FTP packets it drops on their way out, in percent (a lossy link), from a seeded sequence.
  public ftpLoss: int = 0
  /// A burst stops after this many packets, with no end (a link that did not drain: the client must ask again). 0: never.
  public ftpStallAfter: int = 0
  /// What the FTP server was asked, one line each: "<opcode> s<session> o<offset> n<size>".
  public readonly ftpLog: string[] = []
  /// How many bursts it started.
  public ftpBursts: int = 0
  readonly ftpSessions: Map<int, FtpSession> = new Map<int, FtpSession>()
  ftpSeed: int = 4242
  readonly ftpCache: Map<string, FtpCached> = new Map<string, FtpCached>()

  constructor(stream: ByteStream, params: SimParam[] = defaultSimParams(), sysid: int = 1, compid: int = 1) {
    this.sysid = sysid
    this.compid = compid
    this.bootedAt = Date.now() as int
    this.conn = new MavLinkConnection(stream, { protocol: new MavLinkProtocolV2(sysid, compid) })
    this.params = params
    conn.on((r: Received) => this.handle(r))
  }

  /// Whether a request with this target is for this vehicle.
  forMe(system: int, component: int): bool {
    (system == 0 || system == sysid) && (component == 0 || component == compid)
  }

  /// Starts answering and sending telemetry every `intervalMs`.
  public start(intervalMs: int = 1000): void {
    conn.run()
    tick()
    timer = setInterval(() => tick(), intervalMs)
  }

  /// Changes a parameter as something else would (another ground station, the autopilot itself),
  /// and broadcasts its PARAM_VALUE, as autopilots do.
  public change(id: string, value: TypedParamValue): void {
    const i = indexOf(id)
    if (i >= 0) {
      params[i] = { id: id, value: value }
      send(i)
    }
  }

  public stop(): void {
    clearInterval(timer)
    clearTimeout(downTimer)
    stopTimers()
    conn.close()
  }

  /// Reboots: every rate it was asked for is forgotten, the clock starts again and, for `downMs`, it says and
  /// hears nothing (a link that is down while the autopilot starts).
  public reboot(downMs: int = 0): void {
    stopTimers()
    intervals.delete(SysStatus.MSG_ID)
    intervals.delete(Attitude.MSG_ID)
    streams.delete(MavDataStream.EXTENDED_STATUS)
    streams.delete(MavDataStream.EXTRA1)
    ticks = 0
    bootedAt = Date.now() as int
    reboots += 1
    clearTimeout(downTimer)
    if (downMs > 0) {
      down = true
      downTimer = setTimeout(() => {
        this.down = false
      }, downMs)
    }
  }

  stopTimers(): void {
    const ids: int[] = []
    for (const [id, _] of timers) {
      ids.push(id)
    }
    for (const id of ids) {
      clearInterval(timers.get(id)!)
      timers.delete(id)
    }
  }

  /// Gives a message its own interval: `ms` between messages, -1 for off, 0 for the tick again.
  applyInterval(id: int, ms: int): void {
    const old = timers.get(id)
    if (old != null) {
      clearInterval(old!)
      timers.delete(id)
    }
    if (ms == 0) {
      intervals.delete(id)
      return
    }
    intervals.set(id, ms)
    if (ms > 0) {
      timers.set(id, setInterval(() => this.sendOwn(id), ms))
    }
  }

  sendOwn(id: int): void {
    if (down) {
      return
    }
    if (id == SysStatus.MSG_ID) {
      sendStatus()
    } else if (id == Attitude.MSG_ID) {
      sendAttitude()
    }
  }

  sendStatus(): void {
    const s = new SysStatus()
    s.voltageBattery = (12600 - ticks * 10) as u16
    s.batteryRemaining = (if (ticks > 100) 0 else 100 - ticks) as i8
    conn.send(s)
  }

  sendAttitude(): void {
    const a = new Attitude()
    a.timeBootMs = ((Date.now() as int) - bootedAt) as u32
    a.roll = (Math.sin(ticks as f64 / 5.0) * 0.0524) as f32
    a.pitch = (Math.cos(ticks as f64 / 7.0) * 0.0349) as f32
    a.yaw = (((ticks * 3) % 360) as f64 * Math.PI / 180.0) as f32
    conn.send(a)
  }

  tick(): void {
    if (down) {
      return
    }
    const armed = ticks >= 3
    const h = new Heartbeat()
    h.type = MavType.QUADROTOR as u8
    h.autopilot = MavAutopilot.ARDUPILOTMEGA as u8
    h.baseMode = (MavModeFlag.CUSTOM_MODE_ENABLED | (if (armed) MavModeFlag.SAFETY_ARMED else 0)) as u8
    h.customMode = if (armed) 5 else 0   // ArduCopter: LOITER, STABILIZE
    h.systemStatus = (if (armed) MavState.ACTIVE else MavState.STANDBY) as u8
    h.mavlinkVersion = 3
    conn.send(h)
    if (streaming && !intervals.has(SysStatus.MSG_ID)) {
      sendStatus()
    }
    if (streaming && !intervals.has(Attitude.MSG_ID)) {
      sendAttitude()
    }
    ticks += 1
  }

  sendSystemTime(): void {
    const t = new SystemTime()
    t.timeUnixUsec = (Date.now() as int * 1000) as u64
    t.timeBootMs = ((Date.now() as int) - bootedAt) as u32
    conn.send(t)
  }

  handle(r: Received): void {
    if (down) {
      return
    }
    const m = r.message
    if (m instanceof CommandLong) {
      if (!forMe(m.targetSystem as int, m.targetComponent as int)) {
        return
      }
      const wants = (m.command as int == MavCmd.REQUEST_MESSAGE && m._param1 as int == AutopilotVersion.MSG_ID)
        || m.command as int == MavCmd.REQUEST_AUTOPILOT_CAPABILITIES
      if (m.command as int == MavCmd.REQUEST_MESSAGE && m._param1 as int == SystemTime.MSG_ID) {
        systemTimeRequests += 1
        const ack = new CommandAck()
        ack.command = m.command
        ack.result = MavResult.ACCEPTED as u8
        conn.send(ack)
        sendSystemTime()
        return
      }
      if (m.command as int == MavCmd.SET_MESSAGE_INTERVAL) {
        // Honoured for the two messages it sends on its own, unless it is set to refuse.
        const id = m._param1 as int
        const microseconds = m._param2 as int
        const accepted = !rejectIntervals && (id == SysStatus.MSG_ID || id == Attitude.MSG_ID)
        if (accepted) {
          const ms = if (microseconds < 0) -1 else if (microseconds == 0) 0 else if (microseconds < 1000) 1 else microseconds / 1000
          applyInterval(id, ms)
        }
        const ack = new CommandAck()
        ack.command = m.command
        ack.result = (if (accepted) MavResult.ACCEPTED else MavResult.UNSUPPORTED) as u8
        conn.send(ack)
        return
      }
      if (wants && answersVersion) {
        const ack = new CommandAck()
        ack.command = m.command
        ack.result = MavResult.ACCEPTED as u8
        conn.send(ack)
        const v = new AutopilotVersion()
        v.capabilities = (MavProtocolCapability.PARAM_ENCODE_C_CAST | MavProtocolCapability.MAVLINK2
            | MavProtocolCapability.MISSION_INT | MavProtocolCapability.COMMAND_INT
            | (if (ftp) MavProtocolCapability.FTP else 0)) as u64
        v.flightSwVersion = 0x04050700   // 4.5.7 official
        conn.send(v)
      }
      return
    } else if (m instanceof RequestDataStream) {
      if (forMe(m.targetSystem as int, m.targetComponent as int)) {
        // No acknowledgement, as in the protocol. A stream's rate goes to the messages it holds here.
        const stream = m.reqStreamId as int
        const hz = m.reqMessageRate as int
        const start = m.startStop as int != 0
        const ms = if (!start) -1 else if (hz <= 0) 0 else if (hz >= 1000) 1 else 1000 / hz
        if (stream == MavDataStream.EXTENDED_STATUS || stream == MavDataStream.ALL) {
          streams.set(MavDataStream.EXTENDED_STATUS, if (start) hz else 0)
          applyInterval(SysStatus.MSG_ID, ms)
        }
        if (stream == MavDataStream.EXTRA1 || stream == MavDataStream.ALL) {
          streams.set(MavDataStream.EXTRA1, if (start) hz else 0)
          applyInterval(Attitude.MSG_ID, ms)
        }
      }
    } else if (m instanceof ParamRequestList) {
      if (forMe(m.targetSystem as int, m.targetComponent as int)) {
        for (let i = 0; i < params.length; i++) {
          send(i)
        }
      }
    } else if (m instanceof ParamRequestRead) {
      const i = if (m.paramIndex >= 0) m.paramIndex as int else indexOf(m.paramId)
      if (forMe(m.targetSystem as int, m.targetComponent as int) && i >= 0 && i < params.length) {
        send(i)
      }
    } else if (m instanceof FileTransferProtocol) {
      if (ftp && forMe(m.targetSystem as int, m.targetComponent as int)) {
        // Answers go to whoever asked: its system and component are in the header of the request.
        const from: Target = { system: r.packet.header.sysid, component: r.packet.header.compid }
        ftpHandle(m, from)
      }
    } else if (m instanceof ParamSet) {
      const i = indexOf(m.paramId)
      if (forMe(m.targetSystem as int, m.targetComponent as int) && i >= 0) {
        const v = decodeParam(m.paramValue, m.paramType as int, ParamEncoding.CCast)
        params[i] = { id: params[i].id, value: rounded(params[i].id, v) }
        send(i)
      }
    }
  }

  // --- MAVLink FTP: the packed parameter file, "@PARAM/param.pck", as ArduPilot serves it ---

  /// How many FTP sessions are open.
  public openFtpSessions(): int {
    ftpSessions.size
  }

  /// The next number of a seeded sequence (the same loss on every run).
  ftpRandom(n: int): int {
    ftpSeed = (ftpSeed * 1103515245 + 12345) & 0x7FFFFFFF
    (ftpSeed >> 8) % n
  }

  /// Whether the next FTP packet is lost on its way out.
  ftpLost(): bool {
    ftpLoss > 0 && ftpRandom(100) < ftpLoss
  }

  ftpCacheKey(to: Target, session: int): string {
    `${to.system}:${to.component}:${session}`
  }

  /// Sends a reply to the FTP request `ask`: Ack or Nack, with `data`, to whoever asked (its system and component). The reply
  /// is kept to answer a repeat of the request with (`remember`), also when it is lost on its way out.
  ftpReply(ask: FtpAsk, opcode: int, data: Uint8Array, seq: int, offset: int, burstComplete: bool, remember: bool = true): void {
    const p = new FtpPacket()
    p.seq = seq & 0xFFFF
    p.session = ask.req.session
    p.opcode = opcode
    p.reqOpcode = ask.req.opcode
    p.size = data.length
    p.data = data
    p.offset = offset
    p.burstComplete = burstComplete
    try {
      const message = ftpMessage(ask.to, p)
      if (remember) {
        ftpCache.set(ftpCacheKey(ask.to, ask.req.session), new FtpCached(ask.req.seq, message))
      }
      if (!ftpLost()) {
        conn.send(message)
      }
      return
    } catch (e: FtpError) {
    }
  }

  ftpNack(ask: FtpAsk, error: int, errno: int = 0): void {
    const data = if (error == FtpNack.FAIL_ERRNO) new Uint8Array(2) else new Uint8Array(1)
    data.set(0, error)
    if (error == FtpNack.FAIL_ERRNO) {
      data.set(1, errno)
    }
    // "No session free" is not kept: the same request asked again may well find one.
    ftpReply(ask, FtpOpcode.NACK, data, ask.req.seq + 1, ask.req.offset, false, error != FtpNack.NO_SESSIONS_AVAILABLE)
  }

  ftpHandle(m: FileTransferProtocol, from: Target): void {
    let packet: FtpPacket
    try {
      packet = ftpPacketOf(m)
    } catch (e: FtpError) {
      return
    }
    const ask = new FtpAsk(packet, from)
    const req = packet
    ftpLog.push(`${req.opcode} s${req.session} o${req.offset} n${req.size}`)
    if (ftpMode == "silent") {
      return
    }
    const key = ftpCacheKey(from, req.session)
    const cached = ftpCache.get(key)
    if (req.opcode == FtpOpcode.BURST_READ_FILE) {
      // A burst starts a new one every time, and is never resent from the cache.
      const gone = ftpCache.delete(key)
    } else if (cached != null && cached!.seq == req.seq) {
      if (!ftpLost()) {
        conn.send(cached!.message)
      }
      return
    }
    if (req.opcode == FtpOpcode.RESET_SESSIONS) {
      ftpSessions.clear()
      ftpReply(ask, FtpOpcode.ACK, new Uint8Array(0), req.seq + 1, 0, false)
    } else if (req.opcode == FtpOpcode.OPEN_FILE_RO) {
      ftpOpen(ask)
    } else if (req.opcode == FtpOpcode.READ_FILE) {
      ftpRead(ask)
    } else if (req.opcode == FtpOpcode.BURST_READ_FILE) {
      ftpBurst(ask)
    } else if (req.opcode == FtpOpcode.TERMINATE_SESSION) {
      // Always an Ack, whether or not the session was open (as the vehicle's is).
      ftpSessions.delete(req.session)
      ftpReply(ask, FtpOpcode.ACK, new Uint8Array(0), req.seq + 1, 0, false)
    } else {
      ftpNack(ask, FtpNack.UNKNOWN_COMMAND)
    }
  }

  /// OpenFileRO of "@PARAM/param.pck" (with the query `?start=N&count=C&withdefaults=1`, all optional): the Ack carries the
  /// file's size, which is an estimate (12 bytes a parameter), as the vehicle's is. A path that is not that file is ENOENT
  /// (FailErrno), a session that has a file open and was used in the last 3 s is `Fail` (one file per session).
  ftpOpen(ask: FtpAsk): void {
    const req = ask.req
    if (ftpMode == "unsupported") {
      ftpNack(ask, FtpNack.FAIL_ERRNO, 2)
      return
    }
    const now = Date.now() as int
    const mine = ftpSessions.get(req.session)
    if (mine != null && now - mine!.lastAt <= 3000) {
      ftpNack(ask, FtpNack.FAIL)
      return
    }
    // A session nobody has used for 3 s may be taken over; a full vehicle has no session free.
    if (ftpSessions.size >= 5 && !ftpSessions.has(req.session)) {
      const idle: int[] = []
      for (const [id, s] of ftpSessions) {
        if (now - s.lastAt > 3000) {
          idle.push(id)
        }
      }
      if (idle.length == 0) {
        ftpNack(ask, FtpNack.NO_SESSIONS_AVAILABLE)
        return
      }
      ftpSessions.delete(idle[0])
    }
    let name = ""
    try {
      name = new TextDecoder().decode(req.data)
    } catch (e: TypeError) {
    }
    const parts = name.split("?")
    if (parts[0] != "@PARAM/param.pck") {
      // ENOENT, as the vehicle's filesystem says it.
      ftpNack(ask, FtpNack.FAIL_ERRNO, 2)
      return
    }
    let file: Uint8Array
    try {
      file = packedFile(if (parts.length > 1) parts[1] else "")
    } catch (e: ParamPackError) {
      ftpNack(ask, FtpNack.FAIL_ERRNO, 5)
      return
    }
    ftpSessions.set(req.session, new FtpSession(req.session, file))
    const size = new Uint8Array(4)
    const estimate = readCount(file) * 12
    size.set(0, estimate & 0xFF)
    size.set(1, (estimate >> 8) & 0xFF)
    size.set(2, (estimate >> 16) & 0xFF)
    size.set(3, (estimate >> 24) & 0xFF)
    ftpReply(ask, FtpOpcode.ACK, size, req.seq + 1, 0, false)
  }

  /// The session of a read, or null after a Nack: a session that is not open is `FileNotFound` (as on the vehicle), and a size
  /// that is not the one the file was first read with is EINVAL. A size of 0 reads nothing and fixes nothing.
  ftpSessionForRead(ask: FtpAsk, size: int): FtpSession? {
    const s = ftpSessions.get(ask.req.session)
    if (s == null) {
      ftpNack(ask, FtpNack.FILE_NOT_FOUND)
      return null
    }
    s!.lastAt = Date.now() as int
    // The file's padding is computed from the first read's size: any other size is refused (EINVAL), so that a client that
    // changes it shows at once. (A read of 0 bytes does not count as the first.)
    if (size == 0) {
      return s
    }
    if (s!.readSize == 0) {
      s!.readSize = size
    } else if (s!.readSize != size) {
      ftpNack(ask, FtpNack.FAIL_ERRNO, 22)
      return null
    }
    s
  }

  /// ReadFile: `size` bytes at `offset`. A size of 0 is a Nack EndOfFile (the vehicle reads nothing and says the file ended).
  ftpRead(ask: FtpAsk): void {
    const req = ask.req
    const s = ftpSessionForRead(ask, req.size)
    if (s == null) {
      return
    }
    const file = s!.file
    if (req.size == 0 || req.offset >= file.length) {
      ftpNack(ask, FtpNack.EOF)
      return
    }
    ftpReply(ask, FtpOpcode.ACK, slice(file, req.offset, req.size), req.seq + 1, req.offset, false)
  }

  /// BurstReadFile: Acks of `size` bytes (0: 239) from `offset`, up to 2000 packets, the last with burst_complete, and a Nack
  /// EndOfFile where the file ends. A stalled burst (`ftpStallAfter`) stops with no end.
  ftpBurst(ask: FtpAsk): void {
    const size = if (ask.req.size == 0) FTP_MAX_DATA else ask.req.size
    const s = ftpSessionForRead(ask, size)
    if (s == null) {
      return
    }
    ftpBursts += 1
    this.burst(ask, s!, size)
  }

  async burst(ask: FtpAsk, s: FtpSession, size: int): Promise<void> throws AbortError {
    const req = ask.req
    const file = s.file
    let offset = req.offset
    let seq = req.seq + 1
    let sent = 0
    while (sent < 2000) {
      if (down || !ftp) {
        return
      }
      if (ftpStallAfter > 0 && sent >= ftpStallAfter) {
        return
      }
      if (offset >= file.length) {
        const eof = new Uint8Array(1)
        eof.set(0, FtpNack.EOF)
        ftpReply(ask, FtpOpcode.NACK, eof, seq, offset, true, false)
        return
      }
      const chunk = slice(file, offset, size)
      sent += 1
      const last = sent == 2000
      ftpReply(ask, FtpOpcode.ACK, chunk, seq, offset, last, false)
      offset += chunk.length
      seq += 1
      // Let the rest of the link breathe: a long burst is not one tick of the event loop.
      if (sent % 50 == 0) {
        await delay(0)
      }
    }
  }

  /// The packed parameter file for a query.
  packedFile(query: string): Uint8Array throws ParamPackError {
    let start = 0
    let count = params.length
    let withDefaults = false
    for (const pair of query.split("&")) {
      const kv = pair.split("=")
      if (kv.length == 2 && kv[0] == "start") {
        start = parseNumber(kv[1])
      } else if (kv.length == 2 && kv[0] == "count") {
        count = parseNumber(kv[1])
      } else if (kv.length == 2 && kv[0] == "withdefaults") {
        withDefaults = kv[1] == "1"
      }
    }
    const from = if (start > params.length) params.length else start
    const to = if (from + count > params.length) params.length else from + count
    const slice: PackedParam[] = []
    for (let i = from; i < to; i++) {
      const p = params[i]
      const packed: PackedParam = { name: p.id, value: p.value, firmwareDefault: if (withDefaults) p.firmwareDefault else null }
      slice.push(packed)
    }
    const total = if (ftpMode == "incomplete") params.length + 3 else params.length
    const file = encodeParamPack(slice, total, withDefaults)
    if (ftpMode == "corrupt") {
      file.set(0, 0x00)
    }
    file
  }

  rounded(id: string, v: TypedParamValue): TypedParamValue {
    match (v) {
      Real { value, type } => if (rounding.includes(id)) TypedParamValue.Real(Math.round(value), type) else v,
      Int { } => v,
    }
  }

  indexOf(id: string): int {
    for (let i = 0; i < params.length; i++) {
      if (params[i].id == id) {
        return i
      }
    }
    -1
  }

  send(i: int): void {
    const p = new ParamValue()
    p.paramId = params[i].id
    p.paramCount = params.length as u16
    p.paramIndex = i as u16
    const v = params[i].value
    p.paramType = match (v) {
      Int { type } => type as u8,
      Real { type } => type as u8,
    }
    try {
      p.paramValue = encodeParam(v, ParamEncoding.CCast)
    } catch (e: Error) {
      return
    }
    conn.send(p)
  }
}
