import { describe, it, expect } from "std/test"
import { delay } from "std/timers"
import { MavLinkConnection, Received } from "./connection"
import { MemoryStream } from "./stream"
import { ParamEncoding, TypedParamValue, showParam } from "./params"
import { AutopilotVersionRequest, ParamList, ParamWrite, VehicleDiscovery } from "./operations"
import { ParamEncoding as Enc, encodingOf } from "./params"
import { SimulatedAutopilot } from "./simulator"
import { MavType } from "./dialects/minimal"
import { Attitude, MavParamType, SysStatus } from "./dialects/common"

async function looksLikeAVehicle(): Promise<void> throws Error {
  const ends = MemoryStream.pair()
  const sim = new SimulatedAutopilot(ends[1])
  const gcs = new MavLinkConnection(ends[0])
  const seen = new VehicleDiscovery(gcs)
  let status = 0
  let attitude = 0
  gcs.on((r: Received) => {
    const m = r.message
    if (m instanceof SysStatus) {
      status += 1
    } else if (m instanceof Attitude) {
      attitude += 1
    }
  })
  gcs.run()
  sim.start(10)
  await delay(35)
  const list = await new ParamList(gcs, { system: 1, component: 1 }, ParamEncoding.CCast, { quietMs: 30 }).run()
  const version = await new AutopilotVersionRequest(gcs, { system: 1, component: 1 }, { timeoutMs: 100 }).run()
  expect(version != null && encodingOf(version!.capabilities) == Enc.CCast).toBe(true)
  sim.answersVersion = false
  expect((await new AutopilotVersionRequest(gcs, { system: 1, component: 1 }, { timeoutMs: 20, retries: 1 }).run()) == null).toBe(true)
  sim.rounding = ["LOIT_SPEED"]
  const w = await new ParamWrite(gcs, { system: 1, component: 1 }, ParamEncoding.CCast).run("LOIT_SPEED", TypedParamValue.Real(1000.6, MavParamType.REAL32))
  sim.stop()
  const v = seen.vehicles()
  expect(v.map((x) => `${x.sysid}/${x.compid} ${MavType.nameOf(x.type) ?? "?"}`).join(",")).toBe("1/1 QUADROTOR")
  expect(status >= 3 && attitude >= 3).toBe(true)
  expect(`${list.count} ${list.complete}`).toBe("12 true")
  expect(`${showParam(w.param.value)} ${w.verified}`).toBe("1001 false")
}

describe("the simulated autopilot", () => {
  it("sends heartbeats and telemetry and answers parameter requests", looksLikeAVehicle)
})
