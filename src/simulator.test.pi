import { describe, it, expect } from "std/test"
import { delay } from "std/timers"
import { MavLinkConnection, Received } from "./connection"
import { MemoryStream } from "./stream"
import { ParamEncoding, TypedParamValue, showParam } from "./params"
import { AutopilotVersionRead, CommandCall, ParamList, ParamWrite, VehicleDiscovery } from "./operations"
import { ParamEncoding as Enc, encodingOf } from "./params"
import { SimParam, SimulatedAutopilot } from "./simulator"
import { MavType } from "./dialects/minimal"
import { Attitude, CommandLong, MavCmd, MavParamType, ParamValue, SysStatus, TimeSync } from "./dialects/common"
import { MavLinkError, MavLinkProtocolV2 } from "./protocol"

async function looksLikeAVehicle(): Promise<void> throws Error {
  const ends = MemoryStream.pair()
  const sim = new SimulatedAutopilot(ends[1])
  const gcs = new MavLinkConnection(ends[0])
  const seen = new VehicleDiscovery(gcs)
  let status = 0
  let attitude = 0
  gcs.on((r: Received) => {
    const m = r.message
    if (m instanceof SysStatus) {
      status += 1
    } else if (m instanceof Attitude) {
      attitude += 1
    }
  })
  gcs.run()
  sim.start(10)
  await delay(35)
  const list = await new ParamList(gcs, { system: 1, component: 1 }, ParamEncoding.CCast, { quietMs: 30 }).run()
  const version = await new AutopilotVersionRead(gcs, { system: 1, component: 1 }, { timeoutMs: 100 }).run()
  expect(version != null && encodingOf(version!.capabilities) == Enc.CCast).toBe(true)
  const calls = new CommandCall(gcs, { system: 1, component: 1 }, { timeoutMs: 100 })
  expect(await calls.setMessageInterval(Attitude.MSG_ID, 250_000)).toBe(0)
  let code = "acked"
  try {
    await new CommandCall(gcs, { system: 1, component: 1 }, { timeoutMs: 20, retries: 1 }).run(MavCmd.DO_DIGICAM_CONTROL, [1.0])
  } catch (e: MavLinkError) {
    code = e.code
  }
  expect(code).toBe("TIMEOUT")
  sim.answersVersion = false
  expect((await new AutopilotVersionRead(gcs, { system: 1, component: 1 }, { timeoutMs: 20, retries: 1 }).run()) == null).toBe(true)
  let announced = ""
  gcs.on((r: Received) => {
    const m = r.message
    if (m instanceof ParamValue && m.paramId == "RTL_ALT") {
      announced = `${m.paramId}=${m.paramValue}`
    }
  })
  sim.change("RTL_ALT", TypedParamValue.Int(2500, MavParamType.INT32))
  await delay(10)
  expect(announced).toBe("RTL_ALT=2500")
  sim.rounding = ["LOIT_SPEED"]
  const w = await new ParamWrite(gcs, { system: 1, component: 1 }, ParamEncoding.CCast).run("LOIT_SPEED", TypedParamValue.Real(1000.6, MavParamType.REAL32))
  sim.stop()
  const v = seen.vehicles()
  expect(v.map((x) => `${x.sysid}/${x.compid} ${MavType.nameOf(x.type) ?? "?"}`).join(",")).toBe("1/1 QUADROTOR")
  expect(status >= 3 && attitude >= 3).toBe(true)
  expect(`${list.count} ${list.complete}`).toBe("12 true")
  expect(`${showParam(w.param.value)} ${w.verified}`).toBe("1001 false")
}

async function aThousandParameters(): Promise<void> throws Error {
  // About as many as ArduPilot Copter has.
  const params: SimParam[] = []
  for (let i = 0; i < 1200; i++) {
    params.push({ id: `PARAM_${i}`, value: TypedParamValue.Int(i, MavParamType.INT32) })
  }
  const ends = MemoryStream.pair()
  const sim = new SimulatedAutopilot(ends[1], params)
  const gcs = new MavLinkConnection(ends[0])
  gcs.run()
  sim.start(1000)
  const started = Date.now() as int
  const list = await new ParamList(gcs, { system: 1, component: 1 }, ParamEncoding.CCast, { quietMs: 200 }).run()
  const took = (Date.now() as int) - started
  sim.stop()
  expect(`${list.count} ${list.complete} ${list.params[1199].id}`).toBe("1200 true PARAM_1199")
  expect(took < 3000).toBe(true)
}

/// A TIMESYNC request (`tc1` 0) is answered with `ts1` mirrored and the target the one who asked; an answer, or a request for another
/// system, is not.
async function answersTimeSync(): Promise<void> throws Error {
  const ends = MemoryStream.pair()
  const sim = new SimulatedAutopilot(ends[1])
  const gcs = new MavLinkConnection(ends[0], { protocol: new MavLinkProtocolV2(255, 191) })
  const answers: TimeSync[] = []
  gcs.on((r: Received) => {
    const m = r.message
    if (m instanceof TimeSync) {
      answers.push(m)
    }
  })
  gcs.run()
  sim.start(1000)
  const ask = new TimeSync()
  ask.ts1 = 123456789 as i64
  ask.targetSystem = 1
  ask.targetComponent = 1
  await gcs.send(ask)
  const elsewhere = new TimeSync()
  elsewhere.ts1 = 5 as i64
  elsewhere.targetSystem = 7
  await gcs.send(elsewhere)
  const answer = new TimeSync()
  answer.tc1 = 9 as i64
  answer.ts1 = 6 as i64
  await gcs.send(answer)
  await delay(50)
  sim.stop()
  expect(`${answers.length} ${sim.timeSyncs}`).toBe("1 1")
  const a = answers[0]
  expect(`${a.ts1} ${a.tc1 > (0 as i64)} ${a.targetSystem}/${a.targetComponent}`).toBe("123456789 true 255/191")
}

/// A write keeps the parameter's firmware default (its first value, when it had none of its own), and the default is dropped once
/// the value is back at it: the packed parameter file carries a default only where it differs.
async function keepsTheDefaultsAcrossWrites(): Promise<void> throws Error {
  const ends = MemoryStream.pair()
  const params: SimParam[] = [
    { id: "PLAIN", value: TypedParamValue.Int(5, MavParamType.INT32) },
    { id: "MOVED", value: TypedParamValue.Int(7, MavParamType.INT32), firmwareDefault: TypedParamValue.Int(3, MavParamType.INT32) },
  ]
  const sim = new SimulatedAutopilot(ends[1], params)
  const gcs = new MavLinkConnection(ends[0])
  gcs.run()
  sim.start(1000)
  const write = (id: string, v: int) => new ParamWrite(gcs, { system: 1, component: 1 }, ParamEncoding.CCast)
    .run(id, TypedParamValue.Int(v, MavParamType.INT32))
  await write("PLAIN", 9)
  await write("MOVED", 8)
  const shown = (i: int) => sim.params[i].firmwareDefault == null ? "none" : showParam(sim.params[i].firmwareDefault!)
  expect(`${shown(0)} ${shown(1)}`).toBe("5 3")
  await write("PLAIN", 5)
  await write("MOVED", 3)
  expect(`${shown(0)} ${shown(1)}`).toBe("none none")
  sim.change("PLAIN", TypedParamValue.Int(6, MavParamType.INT32))
  expect(shown(0)).toBe("5")
  sim.stop()
  gcs.close()
}

/// After `stop()` nothing it still reads starts a timer: a SET_MESSAGE_INTERVAL read before the stop and handled after it left an
/// interval running, and the program that stopped it never ended.
async function startsNoTimerOnceStopped(): Promise<void> throws Error {
  const ends = MemoryStream.pair()
  const sim = new SimulatedAutopilot(ends[1])
  const gcs = new MavLinkConnection(ends[0])
  gcs.run()
  sim.start(1000)
  const ask = new CommandLong()
  ask.targetSystem = 1
  ask.targetComponent = 1
  ask.command = MavCmd.SET_MESSAGE_INTERVAL as u16
  ask._param1 = SysStatus.MSG_ID as f32
  ask._param2 = 500000.0 as f32
  gcs.send(ask)
  sim.stop()
  await delay(50)

  expect(sim.stopped).toBe(true)
  expect(sim.intervals.has(SysStatus.MSG_ID)).toBe(false)
  gcs.close()
}

describe("the simulated autopilot", () => {
  it("keeps a parameter's firmware default across writes, and drops it once the value is back at it", keepsTheDefaultsAcrossWrites)
  it("starts no timer once it is stopped", startsNoTimerOnceStopped)
  it("serves a list of 1200 parameters, downloaded complete in well under 3 s", aThousandParameters)
  it("sends heartbeats and telemetry and answers parameter requests", looksLikeAVehicle)
  it("answers a TIMESYNC request with its time, the request's mirrored, to the one who asked", answersTimeSync)
})
