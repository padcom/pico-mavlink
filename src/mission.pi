// The mission protocol, as a ground station speaks it (ArduPilot: GCS_MAVLink/MissionItemProtocol*.cpp; the MAVLink "Mission Protocol"
// service): missions, geofences and rally points, told apart by their MAV_MISSION_TYPE.
//  - UPLOAD: MISSION_COUNT, then the vehicle asks for each item (ArduPilot with the OLD MISSION_REQUEST(seq), whatever the ground station
//    sent; the new MISSION_REQUEST_INT is taken too) and is answered with MISSION_ITEM_INT(seq); after the last one the vehicle ends it
//    with MISSION_ACK (ACCEPTED, or the reason it was not). The ground station sends only the INT messages (the vehicle warns about the
//    old float ones). A request is answered BY ITS SEQ, whatever the order and however often it comes; ArduPilot answers an item that is
//    not the one it asked for (a second answer to a repeated request) with an ACK of INVALID_SEQUENCE and goes on, which is not an end.
//  - DOWNLOAD: MISSION_REQUEST_LIST, MISSION_COUNT, MISSION_REQUEST_INT(seq) for each item, MISSION_ITEM_INT, and the ground station ends
//    it with MISSION_ACK (ACCEPTED).
//  - CLEAR: MISSION_CLEAR_ALL (with the type), answered with MISSION_ACK. One type at a time: ArduPilot has no answer for the type 255 (ALL;
//    GCS_Common.cpp: UNSUPPORTED), so each type is cleared by its own call. A clear goes through AP_Mission::clear(), which REFUSES (ERROR)
//    while the vehicle is armed and its mission is running.
//  - AN UPLOAD IS NOT A CLEAR, AND IT HAS NO ROLLBACK. The vehicle takes the count, TRUNCATES its mission to it AT ONCE (AP_Mission::truncate:
//    no guard, also while armed and the mission is running) and writes each item as it arrives. So an upload to a vehicle that is flying its
//    mission overwrites the LIVE mission from the first message on, and one that fails half way (a refusal, a timeout, a lost link) leaves a
//    MIXTURE of the old and the new items, with the new count. After any failed upload the caller must read the mission back, or clear it,
//    or upload it again, before anything flies it. For the same reason `upload` refuses an EMPTY list (a count of 0 is a truncation to
//    nothing that no guard stops, where a clear is refused for a running mission): use `clear`.
//  - THE HOME POSITION: for the MISSION type ArduPilot's item 0 is HOME and the count includes it. Nothing here adds or strips it: the items
//    are what is on the wire, the caller decides (fence and rally have no home).
//  - WHAT IS SENT AGAIN, and what is not. An upload that goes quiet is waited for `retries` more times; before the vehicle's first
//    request the count is sent again each time (the vehicle takes a repeated count as a restart and answers by seq). After the first
//    request the client only waits: the vehicle asks again by itself for an item that did not reach it, and what it was not asked for is
//    not sent. A CLEAR is sent ONCE and never again: a lost ack leaves it unknown whether the vehicle cleared, and the answer is a
//    `TIMEOUT` that says so (read the mission to know). Nothing is sent after a cancel.
//  - ONE TRANSFER AT A TIME per type (a second one throws BUSY before it sends anything: the vehicle answers a transfer started during
//    another with DENIED, and a library that sent it could break the first).
//  - Nothing is decided from the vehicle's state: the vehicle accepts an upload also when it is armed. The CALLER decides whether it may.
import { delay } from "std/timers"
import { MavLinkConnection, Received } from "./connection"
import { MavLinkError } from "./protocol"
import { MavLinkData } from "./data"
import {
  MavCmd,
  MavMissionResult,
  MavMissionType,
  MissionAck,
  MissionClearAll,
  MissionCount,
  MissionCurrent,
  MissionItemInt,
  MissionItemReached,
  MissionRequest,
  MissionRequestInt,
  MissionRequestList,
  MissionSetCurrent,
} from "./dialects/common"
import { CommandCall, Target } from "./operations"

/// The most items one transfer carries (MISSION_COUNT's count is a uint16).
export const MISSION_MAX_COUNT: int = 65535

/// The most items a download accepts unless `MissionOptions.maxItems` says otherwise (what a vehicle says it has is only believed up to here).
export const MISSION_DEFAULT_MAX_ITEMS: int = 2000

/// One item as it is on the wire (MISSION_ITEM_INT). Its place in the list is its seq.
export class MissionEntry {
  /// MAV_CMD.
  public command: int
  /// MAV_FRAME.
  public frame: int
  public param1: f32 = 0.0
  public param2: f32 = 0.0
  public param3: f32 = 0.0
  public param4: f32 = 0.0
  /// Latitude in degrees times 1e7 (or what the command takes).
  public x: int
  /// Longitude in degrees times 1e7.
  public y: int
  /// Altitude in metres (in the frame).
  public z: f32
  /// 1 when the vehicle goes on to the next item by itself (the usual).
  public autocontinue: int = 1
  /// 1 for the item the vehicle is on (what a download says; it is not a part of what an item IS, `sameItem` leaves it out).
  public current: int = 0

  constructor(command: int, frame: int, x: int, y: int, z: f32) {
    this.command = command
    this.frame = frame
    this.x = x
    this.y = y
    this.z = z
  }
}

/// Whether two items are the same on the wire: every field but `current` (the vehicle sets that one itself). Parameters are compared
/// as the floats that travel, and a NaN is the same as a NaN.
export function sameItem(a: MissionEntry, b: MissionEntry): bool {
  return a.command == b.command && a.frame == b.frame && a.x == b.x && a.y == b.y && a.autocontinue == b.autocontinue
    && sameFloat(a.param1, b.param1) && sameFloat(a.param2, b.param2) && sameFloat(a.param3, b.param3) && sameFloat(a.param4, b.param4)
    && sameFloat(a.z, b.z)
}

function sameFloat(a: f32, b: f32): bool {
  return a == b || (a != a && b != b)
}

/// The index of the first item of `a` that differs from the one of `b` at the same place (or that one list lacks); -1 when they are the same.
export function firstDifference(a: MissionEntry[], b: MissionEntry[]): int {
  const n = if (a.length < b.length) a.length else b.length
  for (let i = 0; i < n; i++) {
    if (!sameItem(a[i], b[i])) {
      return i
    }
  }
  return if (a.length == b.length) -1 else n
}

/// A mission transfer that did not go. `code`: `TIMEOUT`, `ABORTED`, `BUSY` (a transfer of this type is on), `INVALID_VALUE` (an item that
/// cannot be sent: nothing was), `PROTOCOL` (the vehicle did something the protocol does not do), `TOO_MANY` (a count above `maxItems`),
/// or the name of the MAV_MISSION_RESULT the vehicle answered with (`NO_SPACE`, `DENIED`, `ERROR`, `INVALID_SEQUENCE` ...), then `result`
/// is its number; otherwise -1.
export class MissionError extends MavLinkError {
  public readonly result: int

  constructor(code: string, message: string, result: int = -1) {
    super(code, message)
    this.result = result
  }
}

export struct MissionOptions {
  /// How long to wait for the vehicle's next message before the last one is sent again (default 1500 ms).
  timeoutMs?: int
  /// How many times the last message is sent again, in a row (default 3).
  retries?: int
  /// How long a whole transfer may take (default 120000 ms).
  overallMs?: int
  /// The most items a download takes (default `MISSION_DEFAULT_MAX_ITEMS`).
  maxItems?: int
  /// Cancels what is going on: it fails with an `ABORTED` MissionError.
  signal?: AbortSignal
}

/// The name of a MAV_MISSION_RESULT.
export function missionResultName(result: int): string {
  return MavMissionResult.nameOf(result) ?? `RESULT_${result}`
}

function from(r: Received, t: Target): bool {
  return r.packet.header.sysid == t.system && (t.component == 0 || r.packet.header.compid == t.component)
}

/// What a transfer of one type listens to: the vehicle's requests, items, counts and acks of that type, in the order they came.
class Inbox {
  readonly conn: MavLinkConnection
  readonly target: Target
  readonly type: int
  readonly listener: int
  readonly queue: Received[] = []
  head: int = 0

  constructor(conn: MavLinkConnection, target: Target, type: int) {
    this.conn = conn
    this.target = target
    this.type = type
    this.listener = conn.on((r: Received) => this.take(r))
  }

  take(r: Received): void {
    if (!from(r, target)) {
      return
    }
    const m = r.message
    const mine = if (m instanceof MissionRequestInt) {
      m.missionType as int == type
    } else if (m instanceof MissionRequest) {
      m.missionType as int == type
    } else if (m instanceof MissionItemInt) {
      m.missionType as int == type
    } else if (m instanceof MissionCount) {
      m.missionType as int == type
    } else if (m instanceof MissionAck) {
      m.missionType as int == type
    } else {
      false
    }
    if (mine) {
      queue.push(r)
    }
  }

  /// The next message, or null after `timeoutMs` of none (or as soon as `signal` aborts).
  public async next(timeoutMs: int, signal: AbortSignal?): Promise<Received?> throws Error {
    const until = (Date.now() as int) + timeoutMs
    while (head >= queue.length) {
      if ((Date.now() as int) >= until || (signal != null && signal!.aborted)) {
        return null
      }
      await delay(2)
    }
    const r = queue[head]
    head += 1
    return r
  }

  public close(): void {
    conn.off(listener)
  }
}

/// The mission protocol of one vehicle. `conn.run()` must be running.
export class MissionClient {
  readonly conn: MavLinkConnection
  readonly target: Target
  readonly timeoutMs: int
  readonly retries: int
  readonly overallMs: int
  readonly maxItems: int
  readonly signal: AbortSignal?
  readonly working: Map<int, bool> = new Map<int, bool>()
  /// Called with how many items went over (up) or arrived (down) and how many there are, every time one more does (set it before the
  /// call). A callback that throws ends the transfer with that error.
  public progress: (done: int, total: int) => void throws Error = (_done: int, _total: int) => {}

  constructor(conn: MavLinkConnection, target: Target, options: MissionOptions = {}) {
    this.conn = conn
    this.target = target
    this.timeoutMs = options.timeoutMs ?? 1500
    this.retries = options.retries ?? 3
    this.overallMs = options.overallMs ?? 120000
    this.maxItems = options.maxItems ?? MISSION_DEFAULT_MAX_ITEMS
    this.signal = options.signal
  }

  /// Sends `items` as the whole of the `type` (0 mission, 1 fence, 2 rally). Done when the vehicle acknowledged it as ACCEPTED; otherwise
  /// a `MissionError` (see there). **The vehicle truncates its mission to the count at once and overwrites it item by item, with no
  /// rollback, also while it flies it: after a failure, a `TIMEOUT` included, what it holds is a MIXTURE (see the top of the file): read it
  /// back, clear it or send it again before it flies.** An empty list is an `INVALID_VALUE` error (nothing is sent): use `clear`.
  public async upload(items: MissionEntry[], type: int = MavMissionType.MISSION): Promise<void> throws Error {
    checkType(type)
    checkItems(items)
    reserve(type)
    const inbox = new Inbox(conn, target, type)
    try {
      await sendItems(inbox, items, type)
    } catch (e: Error) {
      inbox.close()
      release(type)
      throw e
    }
    inbox.close()
    release(type)
  }

  /// The whole of the `type` as the vehicle has it, in the order of its seq, `current` set on the one it is on; ended with the ack the
  /// vehicle waits for. A count above `maxItems` is a `TOO_MANY` error (nothing is asked for).
  public async download(type: int = MavMissionType.MISSION): Promise<MissionEntry[]> throws Error {
    checkType(type)
    reserve(type)
    const inbox = new Inbox(conn, target, type)
    let items: MissionEntry[] = []
    try {
      items = await receiveItems(inbox, type)
    } catch (e: Error) {
      inbox.close()
      release(type)
      throw e
    }
    inbox.close()
    release(type)
    return items
  }

  /// Clears the `type` (0, 1 or 2; one at a time: ArduPilot does not know 255): MISSION_CLEAR_ALL SENT ONCE. Done on ACCEPTED, a
  /// `MissionError` of the vehicle's answer otherwise (ArduPilot refuses with ERROR when the vehicle is armed and its mission is
  /// running). Without an answer: a `TIMEOUT` that says that it is NOT KNOWN whether the vehicle cleared.
  public async clear(type: int = MavMissionType.MISSION): Promise<void> throws Error {
    checkType(type)
    reserve(type)
    const inbox = new Inbox(conn, target, type)
    try {
      await clearOnce(inbox, type)
    } catch (e: Error) {
      inbox.close()
      release(type)
      throw e
    }
    inbox.close()
    release(type)
  }

  /// MAV_RESULT of MAV_CMD_DO_SET_MISSION_CURRENT: the vehicle goes on from item `seq` (`reset` also sets the mission's state back, so a
  /// finished one runs again). It is the command that has an answer; for a vehicle that does not know it (UNSUPPORTED) there is
  /// `setCurrentMessage`. SENT ONCE, never again, like everything that moves a vehicle: a vehicle in AUTO flies to that item, so a command
  /// sent again after a lost ack would send it back (and with `reset` start a finished mission over). Without an answer it is a `TIMEOUT`
  /// MavLinkError: it is NOT KNOWN what the vehicle is flying to (MISSION_CURRENT says).
  public async setCurrent(seq: int, reset: bool = false): Promise<int> throws Error {
    if (seq < 0 || seq > MISSION_MAX_COUNT) {
      throw new MissionError("INVALID_VALUE", `item ${seq} is not 0 to ${MISSION_MAX_COUNT}`)
    }
    const call = new CommandCall(conn, target, { timeoutMs: timeoutMs, retries: 0, signal: signal })
    try {
      return await call.run(MavCmd.DO_SET_MISSION_CURRENT, [seq as f64, if (reset) 1.0 else 0.0])
    } catch (e: MavLinkError) {
      if (e.code == "TIMEOUT") {
        throw new MissionError("TIMEOUT", `no answer to setting item ${seq} as the current one: it is not known what the vehicle flies to`)
      }
      throw e
    }
  }

  /// MISSION_SET_CURRENT (the message the vehicle announces as deprecated), SENT ONCE (see `setCurrent`): done when the vehicle says that
  /// item is the current one (MISSION_CURRENT) within the timeout; otherwise a `TIMEOUT` (it is not known what the vehicle flies to).
  public async setCurrentMessage(seq: int): Promise<void> throws Error {
    if (seq < 0 || seq > MISSION_MAX_COUNT) {
      throw new MissionError("INVALID_VALUE", `item ${seq} is not 0 to ${MISSION_MAX_COUNT}`)
    }
    checkAborted(signal, "setting the current item")
    const reply = conn.waitFor((r: Received) => isCurrent(r, target, seq), timeoutMs, signal)
    const m = new MissionSetCurrent()
    m.targetSystem = target.system as u8
    m.targetComponent = target.component as u8
    m.seq = seq as u16
    await conn.send(m)
    if ((await reply) != null) {
      return
    }
    checkAborted(signal, "setting the current item")
    throw new MissionError("TIMEOUT", `the vehicle did not say that item ${seq} is the current one: it is not known what it flies to`)
  }

  reserve(type: int): void throws Error {
    if (working.get(type) ?? false) {
      throw new MissionError("BUSY", `a ${MavMissionType.nameOf(type) ?? "mission"} transfer is already going on`)
    }
    working.set(type, true)
  }

  release(type: int): void {
    working.set(type, false)
  }

  async sendItems(inbox: Inbox, items: MissionEntry[], type: int): Promise<void> throws Error {
    const n = items.length
    const deadline = (Date.now() as int) + overallMs
    // The seq of the last item sent (-1: none yet), and whether the vehicle has asked for the last one.
    let lastSent = -1
    let done = 0
    let reachedEnd = n == 0
    let silent = 0
    await conn.send(countOf(n, type))
    while (true) {
      checkAborted(signal, "the upload")
      checkDeadline(deadline, "the upload")
      const r = await inbox.next(timeoutMs, signal)
      if (r == null) {
        checkAborted(signal, "the upload")
        silent += 1
        if (silent > retries) {
          throw new MissionError("TIMEOUT", `the vehicle went quiet after ${lastSent + 1} of ${n} items: it is not known what it has`)
        }
        // Only the count is sent again, and only before the vehicle asked for anything (then it knows nothing of the transfer). Once it
        // has asked, nothing is sent that it did not ask for: it asks again by itself when an item is lost (ArduPilot: about every second),
        // and an item it did not ask for could be taken for a mistake and end the transfer.
        if (lastSent < 0) {
          await conn.send(countOf(n, type))
        }
        continue
      }
      silent = 0
      const m = r!.message
      const asked = requestedSeq(m)
      if (asked >= 0) {
        const seq = asked
        if (seq >= n) {
          throw new MissionError("PROTOCOL", `the vehicle asked for item ${seq} of ${n}`)
        }
        await conn.send(itemOf(items[seq], seq, type))
        lastSent = seq
        if (seq + 1 > done) {
          done = seq + 1
          const report = this.progress
          report(done, n)
        }
        if (seq == n - 1) {
          reachedEnd = true
        }
      } else if (m instanceof MissionAck) {
        const result = m.type as int
        if (result == MavMissionResult.ACCEPTED) {
          if (reachedEnd) {
            return
          }
          throw new MissionError("PROTOCOL", `the vehicle accepted the mission after ${done} of ${n} items`)
        }
        // ArduPilot answers an item that is not the one it asked for (a second answer to a request it repeated) with INVALID_SEQUENCE and
        // goes on with the transfer, asking again: that is not the end of it. A transfer that really ended goes quiet and times out.
        if (result == MavMissionResult.INVALID_SEQUENCE) {
          continue
        }
        throw new MissionError(missionResultName(result), `the vehicle did not accept the ${typeName(type)}: ${missionResultName(result)}`, result)
      }
    }
  }

  async receiveItems(inbox: Inbox, type: int): Promise<MissionEntry[]> throws Error {
    const deadline = (Date.now() as int) + overallMs
    const count = await askCount(inbox, type, deadline)
    const items: MissionEntry[] = []
    for (let seq = 0; seq < count; seq++) {
      items.push(await askItem(inbox, type, seq, deadline))
      const report = this.progress
      report(seq + 1, count)
    }
    await conn.send(ackOf(MavMissionResult.ACCEPTED, type))
    return items
  }

  /// The count: MISSION_REQUEST_LIST, asked again when it is not answered.
  async askCount(inbox: Inbox, type: int, deadline: int): Promise<int> throws Error {
    let silent = 0
    await conn.send(listOf(type))
    while (true) {
      checkAborted(signal, "the download")
      checkDeadline(deadline, "the download")
      const r = await inbox.next(timeoutMs, signal)
      if (r == null) {
        checkAborted(signal, "the download")
        silent += 1
        if (silent > retries) {
          throw new MissionError("TIMEOUT", `the vehicle did not say how many items the ${typeName(type)} has`)
        }
        await conn.send(listOf(type))
        continue
      }
      const m = r!.message
      if (m instanceof MissionCount) {
        const count = m.count as int
        if (count > maxItems) {
          throw new MissionError("TOO_MANY", `the vehicle says the ${typeName(type)} has ${count} items (at most ${maxItems} are taken)`)
        }
        return count
      }
      if (m instanceof MissionAck) {
        const result = m.type as int
        if (result != MavMissionResult.ACCEPTED) {
          throw new MissionError(missionResultName(result), `the vehicle refused the ${typeName(type)}: ${missionResultName(result)}`, result)
        }
      }
    }
  }

  /// Item `seq`: MISSION_REQUEST_INT, asked again when it does not come. Items that are not it (a late one) are let go.
  async askItem(inbox: Inbox, type: int, seq: int, deadline: int): Promise<MissionEntry> throws Error {
    let silent = 0
    await conn.send(requestOf(seq, type))
    while (true) {
      checkAborted(signal, "the download")
      checkDeadline(deadline, "the download")
      const r = await inbox.next(timeoutMs, signal)
      if (r == null) {
        checkAborted(signal, "the download")
        silent += 1
        if (silent > retries) {
          throw new MissionError("TIMEOUT", `the vehicle did not send item ${seq}`)
        }
        await conn.send(requestOf(seq, type))
        continue
      }
      const m = r!.message
      if (m instanceof MissionItemInt) {
        if (m.seq as int == seq) {
          return itemFrom(m)
        }
      } else if (m instanceof MissionAck) {
        const result = m.type as int
        if (result != MavMissionResult.ACCEPTED) {
          throw new MissionError(missionResultName(result), `the vehicle stopped the download: ${missionResultName(result)}`, result)
        }
      }
    }
  }

  async clearOnce(inbox: Inbox, type: int): Promise<void> throws Error {
    checkAborted(signal, "the clear")
    const m = new MissionClearAll()
    m.targetSystem = target.system as u8
    m.targetComponent = target.component as u8
    m.missionType = type as u8
    await conn.send(m)
    const until = (Date.now() as int) + timeoutMs
    while (true) {
      checkAborted(signal, "the clear")
      const left = until - (Date.now() as int)
      const r = await inbox.next(if (left > 0) left else 0, signal)
      if (r == null) {
        checkAborted(signal, "the clear")
        throw new MissionError("TIMEOUT", `no answer to clearing the ${typeName(type)}: it is not known whether the vehicle cleared it, read it to see`)
      }
      const m2 = r!.message
      if (m2 instanceof MissionAck) {
        const result = m2.type as int
        if (result == MavMissionResult.ACCEPTED) {
          return
        }
        throw new MissionError(missionResultName(result), `the vehicle did not clear the ${typeName(type)}: ${missionResultName(result)}`, result)
      }
    }
  }

  countOf(n: int, type: int): MissionCount {
    const m = new MissionCount()
    m.targetSystem = target.system as u8
    m.targetComponent = target.component as u8
    m.count = n as u16
    m.missionType = type as u8
    return m
  }

  listOf(type: int): MissionRequestList {
    const m = new MissionRequestList()
    m.targetSystem = target.system as u8
    m.targetComponent = target.component as u8
    m.missionType = type as u8
    return m
  }

  requestOf(seq: int, type: int): MissionRequestInt {
    const m = new MissionRequestInt()
    m.targetSystem = target.system as u8
    m.targetComponent = target.component as u8
    m.seq = seq as u16
    m.missionType = type as u8
    return m
  }

  ackOf(result: int, type: int): MissionAck {
    const m = new MissionAck()
    m.targetSystem = target.system as u8
    m.targetComponent = target.component as u8
    m.type = result as u8
    m.missionType = type as u8
    return m
  }

  itemOf(item: MissionEntry, seq: int, type: int): MissionItemInt {
    const m = new MissionItemInt()
    m.targetSystem = target.system as u8
    m.targetComponent = target.component as u8
    m.seq = seq as u16
    m.frame = item.frame as u8
    m.command = item.command as u16
    m.current = item.current as u8
    m.autocontinue = item.autocontinue as u8
    m.param1 = item.param1
    m.param2 = item.param2
    m.param3 = item.param3
    m.param4 = item.param4
    m.x = item.x as i32
    m.y = item.y as i32
    m.z = item.z
    m.missionType = type as u8
    return m
  }
}

/// The seq a vehicle asks for in a MISSION_REQUEST_INT or in the old MISSION_REQUEST (ArduPilot asks for the items of an upload with the old
/// one, whatever the ground station sends), -1 for any other message.
function requestedSeq(m: MavLinkData?): int {
  if (m instanceof MissionRequestInt) {
    return m.seq as int
  }
  if (m instanceof MissionRequest) {
    return m.seq as int
  }
  return -1
}

function itemFrom(m: MissionItemInt): MissionEntry {
  const item = new MissionEntry(m.command as int, m.frame as int, m.x as int, m.y as int, m.z)
  item.param1 = m.param1
  item.param2 = m.param2
  item.param3 = m.param3
  item.param4 = m.param4
  item.autocontinue = m.autocontinue as int
  item.current = m.current as int
  return item
}

function typeName(type: int): string {
  return (MavMissionType.nameOf(type) ?? "mission").toLowerCase()
}

function checkType(type: int): void throws MissionError {
  if (type < 0 || type > 2) {
    throw new MissionError("INVALID_VALUE", `mission type ${type} is not 0 (mission), 1 (fence) or 2 (rally)`)
  }
}

/// MAV_FRAMEs whose x and y are a latitude and a longitude in degrees times 1e7 (GLOBAL, GLOBAL_RELATIVE_ALT, GLOBAL_INT,
/// GLOBAL_RELATIVE_ALT_INT, GLOBAL_TERRAIN_ALT, GLOBAL_TERRAIN_ALT_INT).
function isGlobalFrame(frame: int): bool {
  return frame == 0 || frame == 3 || frame == 5 || frame == 6 || frame == 10 || frame == 11
}

/// Whether `v` is a number a vehicle can be told (not NaN, not infinite).
function finite(v: f32): bool {
  return v == v && v - v == 0.0
}

/// The parameters of `command` that ArduPilot lets be NaN, as bits (bit 0 is param1 ... bit 3 is param4); every other NaN is refused by
/// the vehicle (INVALID_PARAMn), and an infinity everywhere (AP_Mission::sanity_check_params, `nan_mask`): param4, the yaw, "no change", of
/// NAV_WAYPOINT (16), NAV_LOITER_UNLIM (17), NAV_LAND (21), NAV_TAKEOFF (22) and NAV_VTOL_TAKEOFF (84); param3 and 4 of NAV_VTOL_LAND (85);
/// param2, 3 and 4 of NAV_ARC_WAYPOINT (36). QGroundControl plans have a NaN yaw.
function nanAllowed(command: int): int {
  if (command == 16 || command == 17 || command == 21 || command == 22 || command == 84) {
    return 8
  }
  if (command == 36) {
    return 14
  }
  if (command == 85) {
    return 12
  }
  return 0
}

/// Which of the four parameters (1 to 4) the vehicle would refuse (an infinity, or a NaN where `nanAllowed` does not say so), 0 when none.
function badParameter(it: MissionEntry): int {
  const values: f32[] = [it.param1, it.param2, it.param3, it.param4]
  const allowed = nanAllowed(it.command)
  for (let k = 0; k < 4; k++) {
    const v = values[k]
    if (v == v && v - v != 0.0) {
      return k + 1
    }
    if (v != v && (allowed & (1 << k)) == 0) {
      return k + 1
    }
  }
  return 0
}

/// Throws, before anything is sent (not even the count: the vehicle truncates its mission at the count), for an item that cannot go on
/// the wire or that no vehicle should be given: a number that does not fit its field, a NaN or an infinity in a parameter or the
/// altitude, a place off the globe (in a frame whose x and y are one).
function checkItems(items: MissionEntry[]): void throws MissionError {
  if (items.length == 0) {
    throw new MissionError("INVALID_VALUE", "an empty upload would truncate the mission to nothing, without the guard of a clear: use clear")
  }
  if (items.length > MISSION_MAX_COUNT) {
    throw new MissionError("INVALID_VALUE", `${items.length} items are more than ${MISSION_MAX_COUNT}`)
  }
  for (let i = 0; i < items.length; i++) {
    const it = items[i]
    if (it.command < 0 || it.command > 65535) {
      throw new MissionError("INVALID_VALUE", `item ${i}: command ${it.command} is not 0 to 65535`)
    }
    if (it.frame < 0 || it.frame > 255) {
      throw new MissionError("INVALID_VALUE", `item ${i}: frame ${it.frame} is not 0 to 255`)
    }
    if (it.autocontinue < 0 || it.autocontinue > 255) {
      throw new MissionError("INVALID_VALUE", `item ${i}: autocontinue is not 0 to 255`)
    }
    // ArduPilot does not store an item of the mission whose `current` is 2 or 3 (a guided go-to, a change of altitude: GCS_Common.cpp:987-1012): a
    // vehicle flying its mission is told to fly there NOW, and the item is dropped from the mission. So `current` is 0 or 1 here.
    if (it.current < 0 || it.current > 1) {
      throw new MissionError("INVALID_VALUE", `item ${i}: current ${it.current} is not 0 or 1 (2 and 3 are orders to a flying vehicle, not mission items)`)
    }
    if (it.x < -2147483648 || it.x > 2147483647 || it.y < -2147483648 || it.y > 2147483647) {
      throw new MissionError("INVALID_VALUE", `item ${i}: x or y does not fit 32 bits`)
    }
    const bad = badParameter(it)
    if (bad > 0) {
      throw new MissionError("INVALID_VALUE", `item ${i}: param${bad} is an infinity, or a NaN that the vehicle refuses for command ${it.command}`)
    }
    if (!finite(it.z)) {
      throw new MissionError("INVALID_VALUE", `item ${i}: the altitude is NaN or infinite`)
    }
    if (isGlobalFrame(it.frame) && (it.x < -900000000 || it.x > 900000000 || it.y < -1800000000 || it.y > 1800000000)) {
      throw new MissionError("INVALID_VALUE", `item ${i}: latitude ${it.x} or longitude ${it.y} (degrees times 1e7) is off the globe`)
    }
  }
}

function checkAborted(signal: AbortSignal?, what: string): void throws MissionError {
  if (signal != null && signal!.aborted) {
    throw new MissionError("ABORTED", `${what}: cancelled`)
  }
}

function checkDeadline(deadline: int, what: string): void throws MissionError {
  if ((Date.now() as int) > deadline) {
    throw new MissionError("TIMEOUT", `${what} took too long`)
  }
}

function isCurrent(r: Received, target: Target, seq: int): bool {
  const m = r.message
  if (m instanceof MissionCurrent) {
    return from(r, target) && m.seq as int == seq
  }
  return false
}

/// What the vehicle says of the mission it is flying: the item it is on (MISSION_CURRENT) and the last it reached (MISSION_ITEM_REACHED).
/// The vehicle sends them at the rate the telemetry rates give them (ArduPilot: MISSION_CURRENT about once a second; ask for more with
/// `CommandCall.setMessageInterval`). `conn.run()` must be running.
export class MissionProgress {
  readonly conn: MavLinkConnection
  readonly target: Target
  readonly listener: int
  /// The item the vehicle is on, -1 before it said.
  public current: int = -1
  /// How many items it says it has (0: not said; 65535: no mission).
  public total: int = 0
  /// MISSION_STATE (see `MissionState`); 0 when it does not say.
  public state: int = 0
  /// The last item it said it reached, -1 before it said.
  public reached: int = -1
  /// Called with (current, total, state) every time MISSION_CURRENT arrives.
  public onCurrent: (current: int, total: int, state: int) => void = (_c: int, _t: int, _s: int) => {}
  /// Called with the seq of every MISSION_ITEM_REACHED.
  public onReached: (seq: int) => void = (_seq: int) => {}

  constructor(conn: MavLinkConnection, target: Target) {
    this.conn = conn
    this.target = target
    this.listener = conn.on((r: Received) => this.seen(r))
  }

  seen(r: Received): void {
    if (!from(r, target)) {
      return
    }
    const m = r.message
    if (m instanceof MissionCurrent) {
      current = m.seq as int
      total = m.total as int
      state = m.missionState as int
      const report = this.onCurrent
      report(current, total, state)
    } else if (m instanceof MissionItemReached) {
      reached = m.seq as int
      const report = this.onReached
      report(reached)
    }
  }

  public stop(): void {
    conn.off(listener)
  }
}
