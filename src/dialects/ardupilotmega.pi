/// A fence point. Used to set a point when from GCS -> MAV. Also used to return a point from MAV ->
/// GCS.
export class FencePoint extends MavLinkData {
  public static readonly MSG_ID: int = 160
  public static readonly MSG_NAME: string = "FENCE_POINT"
  public static readonly PAYLOAD_LENGTH: int = 12
  public static readonly MAGIC_NUMBER: int = 78
  public static readonly INFO: MessageInfo = new MessageInfo(160, "FENCE_POINT", 12, 12, 78, [
    new MavLinkPacketField("lat", "lat", 0, false, 4, "float", "deg"),
    new MavLinkPacketField("lng", "lng", 4, false, 4, "float", "deg"),
    new MavLinkPacketField("target_system", "targetSystem", 8, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 9, false, 1, "uint8_t", ""),
    new MavLinkPacketField("idx", "idx", 10, false, 1, "uint8_t", ""),
    new MavLinkPacketField("count", "count", 11, false, 1, "uint8_t", ""),
  ], (p) => FencePoint.decode(p))

  /// System ID.
  public targetSystem: u8 = 0

  /// Component ID.
  public targetComponent: u8 = 0

  /// Point index (first point is 1, 0 is for return point).
  public idx: u8 = 0

  /// Total number of points (for sanity checking).
  public count: u8 = 0

  /// Latitude of point.
  /// Units: deg.
  public lat: f32 = 0.0

  /// Longitude of point.
  /// Units: deg.
  public lng: f32 = 0.0

  /// A FENCE_POINT from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): FencePoint {
    const m = new FencePoint()
    m.lat = readF32(payload, 0)
    m.lng = readF32(payload, 4)
    m.targetSystem = readU8(payload, 8)
    m.targetComponent = readU8(payload, 9)
    m.idx = readU8(payload, 10)
    m.count = readU8(payload, 11)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeF32(into, at + 0, this.lat)
    writeF32(into, at + 4, this.lng)
    writeUint(into, at + 8, 1, this.targetSystem as int)
    writeUint(into, at + 9, 1, this.targetComponent as int)
    writeUint(into, at + 10, 1, this.idx as int)
    writeUint(into, at + 11, 1, this.count as int)
  }

  public override info(): MessageInfo {
    FencePoint.INFO
  }
}

