  /// Values: `LimitsState`.
  public limitsState: u8 = 0

  /// Time (since boot) of last breach.
  /// Units: ms.
  public lastTrigger: u32 = 0

  /// Time (since boot) of last recovery action.
  /// Units: ms.
  public lastAction: u32 = 0

  /// Time (since boot) of last successful recovery.
  /// Units: ms.
  public lastRecovery: u32 = 0

  /// Time (since boot) of last all-clear.
  /// Units: ms.
  public lastClear: u32 = 0

  /// Number of fence breaches.
  public breachCount: u16 = 0

  /// AP_Limit_Module bitfield of enabled modules.
  /// Values: `LimitModule`.
  public modsEnabled: u8 = 0

  /// AP_Limit_Module bitfield of required modules.
  /// Values: `LimitModule`.
  public modsRequired: u8 = 0

  /// AP_Limit_Module bitfield of triggered modules.
  /// Values: `LimitModule`.
  public modsTriggered: u8 = 0

  /// A LIMITS_STATUS from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): LimitsStatus {
    const m = new LimitsStatus()
    m.lastTrigger = readU32(payload, 0)
    m.lastAction = readU32(payload, 4)
    m.lastRecovery = readU32(payload, 8)
    m.lastClear = readU32(payload, 12)
    m.breachCount = readU16(payload, 16)
    m.limitsState = readU8(payload, 18)
    m.modsEnabled = readU8(payload, 19)
    m.modsRequired = readU8(payload, 20)
    m.modsTriggered = readU8(payload, 21)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.lastTrigger as int)
    writeUint(into, at + 4, 4, this.lastAction as int)
    writeUint(into, at + 8, 4, this.lastRecovery as int)
    writeUint(into, at + 12, 4, this.lastClear as int)
    writeUint(into, at + 16, 2, this.breachCount as int)
    writeUint(into, at + 18, 1, this.limitsState as int)
    writeUint(into, at + 19, 1, this.modsEnabled as int)
    writeUint(into, at + 20, 1, this.modsRequired as int)
    writeUint(into, at + 21, 1, this.modsTriggered as int)
  }

  public override info(): MessageInfo {
    LimitsStatus.INFO
  }
}

