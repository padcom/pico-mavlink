/// A rally point. Used to set a point when from GCS -> MAV. Also used to return a point from MAV ->
/// GCS.
export class RallyPoint extends MavLinkData {
  public static readonly MSG_ID: int = 175
  public static readonly MSG_NAME: string = "RALLY_POINT"
  public static readonly PAYLOAD_LENGTH: int = 19
  public static readonly MAGIC_NUMBER: int = 138
  public static readonly INFO: MessageInfo = new MessageInfo(175, "RALLY_POINT", 19, 19, 138, [
    new MavLinkPacketField("lat", "lat", 0, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("lng", "lng", 4, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("alt", "alt", 8, false, 2, "int16_t", "m"),
    new MavLinkPacketField("break_alt", "breakAlt", 10, false, 2, "int16_t", "m"),
    new MavLinkPacketField("land_dir", "landDir", 12, false, 2, "uint16_t", "cdeg"),
    new MavLinkPacketField("target_system", "targetSystem", 14, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 15, false, 1, "uint8_t", ""),
    new MavLinkPacketField("idx", "idx", 16, false, 1, "uint8_t", ""),
    new MavLinkPacketField("count", "count", 17, false, 1, "uint8_t", ""),
    new MavLinkPacketField("flags", "flags", 18, false, 1, "uint8_t", ""),
  ], (p) => RallyPoint.decode(p))

  /// System ID.
  public targetSystem: u8 = 0

  /// Component ID.
  public targetComponent: u8 = 0

  /// Point index (first point is 0).
  public idx: u8 = 0

  /// Total number of points (for sanity checking).
  public count: u8 = 0

  /// Latitude of point.
  /// Units: degE7.
  public lat: i32 = 0

  /// Longitude of point.
  /// Units: degE7.
  public lng: i32 = 0

  /// Transit / loiter altitude relative to home.
  /// Units: m.
  public alt: i16 = 0

  /// Break altitude relative to home.
  /// Units: m.
  public breakAlt: i16 = 0

  /// Heading to aim for when landing.
  /// Units: cdeg.
  public landDir: u16 = 0

  /// Configuration flags.
  /// Values: `RallyFlags`.
  public flags: u8 = 0

  /// A RALLY_POINT from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): RallyPoint {
    const m = new RallyPoint()
    m.lat = readI32(payload, 0)
    m.lng = readI32(payload, 4)
    m.alt = readI16(payload, 8)
    m.breakAlt = readI16(payload, 10)
    m.landDir = readU16(payload, 12)
    m.targetSystem = readU8(payload, 14)
    m.targetComponent = readU8(payload, 15)
    m.idx = readU8(payload, 16)
    m.count = readU8(payload, 17)
    m.flags = readU8(payload, 18)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.lat as int)
    writeUint(into, at + 4, 4, this.lng as int)
    writeUint(into, at + 8, 2, this.alt as int)
    writeUint(into, at + 10, 2, this.breakAlt as int)
    writeUint(into, at + 12, 2, this.landDir as int)
    writeUint(into, at + 14, 1, this.targetSystem as int)
    writeUint(into, at + 15, 1, this.targetComponent as int)
    writeUint(into, at + 16, 1, this.idx as int)
    writeUint(into, at + 17, 1, this.count as int)
    writeUint(into, at + 18, 1, this.flags as int)
  }

  public override info(): MessageInfo {
    RallyPoint.INFO
  }
}

