  /// Delta angle X.
  /// Units: rad.
  public deltaAngleX: f32 = 0.0

  /// Delta angle Y.
  /// Units: rad.
  public deltaAngleY: f32 = 0.0

  /// Delta angle X.
  /// Units: rad.
  public deltaAngleZ: f32 = 0.0

  /// Delta velocity X.
  /// Units: m/s.
  public deltaVelocityX: f32 = 0.0

  /// Delta velocity Y.
  /// Units: m/s.
  public deltaVelocityY: f32 = 0.0

  /// Delta velocity Z.
  /// Units: m/s.
  public deltaVelocityZ: f32 = 0.0

  /// Joint ROLL.
  /// Units: rad.
  public jointRoll: f32 = 0.0

  /// Joint EL.
  /// Units: rad.
  public jointEl: f32 = 0.0

  /// Joint AZ.
  /// Units: rad.
  public jointAz: f32 = 0.0

  /// A GIMBAL_REPORT from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): GimbalReport {
    const m = new GimbalReport()
    m.deltaTime = readF32(payload, 0)
    m.deltaAngleX = readF32(payload, 4)
    m.deltaAngleY = readF32(payload, 8)
    m.deltaAngleZ = readF32(payload, 12)
    m.deltaVelocityX = readF32(payload, 16)
    m.deltaVelocityY = readF32(payload, 20)
    m.deltaVelocityZ = readF32(payload, 24)
    m.jointRoll = readF32(payload, 28)
    m.jointEl = readF32(payload, 32)
    m.jointAz = readF32(payload, 36)
    m.targetSystem = readU8(payload, 40)
    m.targetComponent = readU8(payload, 41)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeF32(into, at + 0, this.deltaTime)
    writeF32(into, at + 4, this.deltaAngleX)
    writeF32(into, at + 8, this.deltaAngleY)
    writeF32(into, at + 12, this.deltaAngleZ)
    writeF32(into, at + 16, this.deltaVelocityX)
    writeF32(into, at + 20, this.deltaVelocityY)
    writeF32(into, at + 24, this.deltaVelocityZ)
    writeF32(into, at + 28, this.jointRoll)
    writeF32(into, at + 32, this.jointEl)
    writeF32(into, at + 36, this.jointAz)
    writeUint(into, at + 40, 1, this.targetSystem as int)
    writeUint(into, at + 41, 1, this.targetComponent as int)
  }

  public override info(): MessageInfo {
    GimbalReport.INFO
  }
}

