/// Response from a GOPRO_COMMAND get request.
export class GoproGetResponse extends MavLinkData {
  public static readonly MSG_ID: int = 217
  public static readonly MSG_NAME: string = "GOPRO_GET_RESPONSE"
  public static readonly PAYLOAD_LENGTH: int = 6
  public static readonly MAGIC_NUMBER: int = 202
  public static readonly INFO: MessageInfo = new MessageInfo(217, "GOPRO_GET_RESPONSE", 6, 6, 202, [
    new MavLinkPacketField("cmd_id", "cmdId", 0, false, 1, "uint8_t", ""),
    new MavLinkPacketField("status", "status", 1, false, 1, "uint8_t", ""),
    new MavLinkPacketField("value", "value", 2, false, 1, "uint8_t[]", "", 4),
  ], (p) => GoproGetResponse.decode(p))

  /// Command ID.
  /// Values: `GoproCommand`.
  public cmdId: u8 = 0

  /// Status.
  /// Values: `GoproRequestStatus`.
  public status: u8 = 0

  /// Value.
  public value: u8[] = []

  /// A GOPRO_GET_RESPONSE from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): GoproGetResponse {
    const m = new GoproGetResponse()
    m.cmdId = readU8(payload, 0)
    m.status = readU8(payload, 1)
    for (let i = 0; i < 4; i++) {
      m.value.push(readU8(payload, 2 + i * 1))
    }
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 1, this.cmdId as int)
    writeUint(into, at + 1, 1, this.status as int)
    for (let i = 0; i < 4 && i < this.value.length; i++) {
      writeUint(into, at + 2 + i * 1, 1, this.value[i] as int)
    }
  }

  public override info(): MessageInfo {
    GoproGetResponse.INFO
  }
}

