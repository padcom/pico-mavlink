/// Send a block of log data to remote location.
export class RemoteLogDataBlock extends MavLinkData {
  public static readonly MSG_ID: int = 184
  public static readonly MSG_NAME: string = "REMOTE_LOG_DATA_BLOCK"
  public static readonly PAYLOAD_LENGTH: int = 206
  public static readonly MAGIC_NUMBER: int = 159
  public static readonly INFO: MessageInfo = new MessageInfo(184, "REMOTE_LOG_DATA_BLOCK", 206, 206, 159, [
    new MavLinkPacketField("seqno", "seqno", 0, false, 4, "uint32_t", ""),
    new MavLinkPacketField("target_system", "targetSystem", 4, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 5, false, 1, "uint8_t", ""),
    new MavLinkPacketField("data", "data", 6, false, 1, "uint8_t[]", "", 200),
  ], (p) => RemoteLogDataBlock.decode(p))

  /// System ID.
  public targetSystem: u8 = 0

  /// Component ID.
  public targetComponent: u8 = 0

  /// Log data block sequence number.
  /// Values: `MavRemoteLogDataBlockCommands`.
  public seqno: u32 = 0

  /// Log data block.
  public data: u8[] = []

  /// A REMOTE_LOG_DATA_BLOCK from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): RemoteLogDataBlock {
    const m = new RemoteLogDataBlock()
    m.seqno = readU32(payload, 0)
    m.targetSystem = readU8(payload, 4)
    m.targetComponent = readU8(payload, 5)
    for (let i = 0; i < 200; i++) {
      m.data.push(readU8(payload, 6 + i * 1))
    }
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.seqno as int)
    writeUint(into, at + 4, 1, this.targetSystem as int)
    writeUint(into, at + 5, 1, this.targetComponent as int)
    for (let i = 0; i < 200 && i < this.data.length; i++) {
      writeUint(into, at + 6 + i * 1, 1, this.data[i] as int)
    }
  }

  public override info(): MessageInfo {
    RemoteLogDataBlock.INFO
  }
}

