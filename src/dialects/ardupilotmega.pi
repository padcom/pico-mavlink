  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 1, this.targetSystem as int)
    writeUint(into, at + 1, 1, this.targetComponent as int)
    writeUint(into, at + 2, 1, this.mountMode as int)
    writeUint(into, at + 3, 1, this.stabRoll as int)
    writeUint(into, at + 4, 1, this.stabPitch as int)
    writeUint(into, at + 5, 1, this.stabYaw as int)
