/// Deepstall path planning.
export class Deepstall extends MavLinkData {
  public static readonly MSG_ID: int = 195
  public static readonly MSG_NAME: string = "DEEPSTALL"
  public static readonly PAYLOAD_LENGTH: int = 37
  public static readonly MAGIC_NUMBER: int = 120
  public static readonly INFO: MessageInfo = new MessageInfo(195, "DEEPSTALL", 37, 37, 120, [
    new MavLinkPacketField("landing_lat", "landingLat", 0, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("landing_lon", "landingLon", 4, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("path_lat", "pathLat", 8, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("path_lon", "pathLon", 12, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("arc_entry_lat", "arcEntryLat", 16, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("arc_entry_lon", "arcEntryLon", 20, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("altitude", "altitude", 24, false, 4, "float", "m"),
    new MavLinkPacketField("expected_travel_distance", "expectedTravelDistance", 28, false, 4, "float", "m"),
    new MavLinkPacketField("cross_track_error", "crossTrackError", 32, false, 4, "float", "m"),
    new MavLinkPacketField("stage", "stage", 36, false, 1, "uint8_t", ""),
  ], (p) => Deepstall.decode(p))

  /// Landing latitude.
  /// Units: degE7.
  public landingLat: i32 = 0

  /// Landing longitude.
  /// Units: degE7.
  public landingLon: i32 = 0

  /// Final heading start point, latitude.
  /// Units: degE7.
  public pathLat: i32 = 0

  /// Final heading start point, longitude.
  /// Units: degE7.
  public pathLon: i32 = 0

  /// Arc entry point, latitude.
  /// Units: degE7.
  public arcEntryLat: i32 = 0

  /// Arc entry point, longitude.
  /// Units: degE7.
  public arcEntryLon: i32 = 0

  /// Altitude.
  /// Units: m.
  public altitude: f32 = 0.0

  /// Distance the aircraft expects to travel during the deepstall.
  /// Units: m.
  public expectedTravelDistance: f32 = 0.0

  /// Deepstall cross track error (only valid when in DEEPSTALL_STAGE_LAND).
  /// Units: m.
  public crossTrackError: f32 = 0.0

  /// Deepstall stage.
  /// Values: `DeepstallStage`.
  public stage: u8 = 0

  /// A DEEPSTALL from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): Deepstall {
    const m = new Deepstall()
    m.landingLat = readI32(payload, 0)
    m.landingLon = readI32(payload, 4)
    m.pathLat = readI32(payload, 8)
    m.pathLon = readI32(payload, 12)
    m.arcEntryLat = readI32(payload, 16)
    m.arcEntryLon = readI32(payload, 20)
    m.altitude = readF32(payload, 24)
    m.expectedTravelDistance = readF32(payload, 28)
    m.crossTrackError = readF32(payload, 32)
    m.stage = readU8(payload, 36)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.landingLat as int)
    writeUint(into, at + 4, 4, this.landingLon as int)
    writeUint(into, at + 8, 4, this.pathLat as int)
    writeUint(into, at + 12, 4, this.pathLon as int)
    writeUint(into, at + 16, 4, this.arcEntryLat as int)
    writeUint(into, at + 20, 4, this.arcEntryLon as int)
    writeF32(into, at + 24, this.altitude)
    writeF32(into, at + 28, this.expectedTravelDistance)
    writeF32(into, at + 32, this.crossTrackError)
    writeUint(into, at + 36, 1, this.stage as int)
  }

  public override info(): MessageInfo {
    Deepstall.INFO
  }
}

