/// Control vehicle LEDs.
export class LedControl extends MavLinkData {
  public static readonly MSG_ID: int = 186
  public static readonly MSG_NAME: string = "LED_CONTROL"
  public static readonly PAYLOAD_LENGTH: int = 29
  public static readonly MAGIC_NUMBER: int = 72
  public static readonly INFO: MessageInfo = new MessageInfo(186, "LED_CONTROL", 29, 29, 72, [
    new MavLinkPacketField("target_system", "targetSystem", 0, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 1, false, 1, "uint8_t", ""),
    new MavLinkPacketField("instance", "instance", 2, false, 1, "uint8_t", ""),
    new MavLinkPacketField("pattern", "pattern", 3, false, 1, "uint8_t", ""),
    new MavLinkPacketField("custom_len", "customLen", 4, false, 1, "uint8_t", ""),
    new MavLinkPacketField("custom_bytes", "customBytes", 5, false, 1, "uint8_t[]", "", 24),
  ], (p) => LedControl.decode(p))

  /// System ID.
  public targetSystem: u8 = 0

  /// Component ID.
  public targetComponent: u8 = 0

  /// Instance (LED instance to control or 255 for all LEDs).
  public instance: u8 = 0

  /// Pattern (see LED_PATTERN_ENUM).
  public pattern: u8 = 0

  /// Custom Byte Length.
  public customLen: u8 = 0

  /// Custom Bytes.
  public customBytes: u8[] = []

  /// A LED_CONTROL from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): LedControl {
    const m = new LedControl()
    m.targetSystem = readU8(payload, 0)
    m.targetComponent = readU8(payload, 1)
    m.instance = readU8(payload, 2)
    m.pattern = readU8(payload, 3)
    m.customLen = readU8(payload, 4)
    for (let i = 0; i < 24; i++) {
      m.customBytes.push(readU8(payload, 5 + i * 1))
    }
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 1, this.targetSystem as int)
    writeUint(into, at + 1, 1, this.targetComponent as int)
    writeUint(into, at + 2, 1, this.instance as int)
    writeUint(into, at + 3, 1, this.pattern as int)
    writeUint(into, at + 4, 1, this.customLen as int)
    for (let i = 0; i < 24 && i < this.customBytes.length; i++) {
      writeUint(into, at + 5 + i * 1, 1, this.customBytes[i] as int)
    }
  }

  public override info(): MessageInfo {
    LedControl.INFO
  }
}

/// Reports progress of compass calibration.
export class MagCalProgress extends MavLinkData {
  public static readonly MSG_ID: int = 191
  public static readonly MSG_NAME: string = "MAG_CAL_PROGRESS"
  public static readonly PAYLOAD_LENGTH: int = 27
  public static readonly MAGIC_NUMBER: int = 92
  public static readonly INFO: MessageInfo = new MessageInfo(191, "MAG_CAL_PROGRESS", 27, 27, 92, [
    new MavLinkPacketField("direction_x", "directionX", 0, false, 4, "float", ""),
    new MavLinkPacketField("direction_y", "directionY", 4, false, 4, "float", ""),
    new MavLinkPacketField("direction_z", "directionZ", 8, false, 4, "float", ""),
    new MavLinkPacketField("compass_id", "compassId", 12, false, 1, "uint8_t", ""),
    new MavLinkPacketField("cal_mask", "calMask", 13, false, 1, "uint8_t", ""),
    new MavLinkPacketField("cal_status", "calStatus", 14, false, 1, "uint8_t", ""),
    new MavLinkPacketField("attempt", "attempt", 15, false, 1, "uint8_t", ""),
    new MavLinkPacketField("completion_pct", "completionPct", 16, false, 1, "uint8_t", "%"),
    new MavLinkPacketField("completion_mask", "completionMask", 17, false, 1, "uint8_t[]", "", 10),
  ], (p) => MagCalProgress.decode(p))

  /// Compass being calibrated.
  public compassId: u8 = 0

  /// Bitmask of compasses being calibrated.
  public calMask: u8 = 0

  /// Calibration Status.
  /// Values: `MagCalStatus`.
  public calStatus: u8 = 0

  /// Attempt number.
  public attempt: u8 = 0

  /// Completion percentage.
  /// Units: %.
  public completionPct: u8 = 0

  /// Bitmask of sphere sections (see http://en.wikipedia.org/wiki/Geodesic_grid).
  public completionMask: u8[] = []

  /// Body frame direction vector for display.
  public directionX: f32 = 0.0

  /// Body frame direction vector for display.
  public directionY: f32 = 0.0

  /// Body frame direction vector for display.
  public directionZ: f32 = 0.0

  /// A MAG_CAL_PROGRESS from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): MagCalProgress {
    const m = new MagCalProgress()
    m.directionX = readF32(payload, 0)
    m.directionY = readF32(payload, 4)
    m.directionZ = readF32(payload, 8)
    m.compassId = readU8(payload, 12)
    m.calMask = readU8(payload, 13)
    m.calStatus = readU8(payload, 14)
    m.attempt = readU8(payload, 15)
    m.completionPct = readU8(payload, 16)
    for (let i = 0; i < 10; i++) {
      m.completionMask.push(readU8(payload, 17 + i * 1))
    }
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeF32(into, at + 0, this.directionX)
    writeF32(into, at + 4, this.directionY)
    writeF32(into, at + 8, this.directionZ)
    writeUint(into, at + 12, 1, this.compassId as int)
    writeUint(into, at + 13, 1, this.calMask as int)
    writeUint(into, at + 14, 1, this.calStatus as int)
    writeUint(into, at + 15, 1, this.attempt as int)
    writeUint(into, at + 16, 1, this.completionPct as int)
    for (let i = 0; i < 10 && i < this.completionMask.length; i++) {
      writeUint(into, at + 17 + i * 1, 1, this.completionMask[i] as int)
    }
  }

  public override info(): MessageInfo {
    MagCalProgress.INFO
  }
}

