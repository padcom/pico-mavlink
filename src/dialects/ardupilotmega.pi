/// Data packet, size 16.
export class Data16 extends MavLinkData {
  public static readonly MSG_ID: int = 169
  public static readonly MSG_NAME: string = "DATA16"
  public static readonly PAYLOAD_LENGTH: int = 18
  public static readonly MAGIC_NUMBER: int = 234
  public static readonly INFO: MessageInfo = new MessageInfo(169, "DATA16", 18, 18, 234, [
    new MavLinkPacketField("type", "type", 0, false, 1, "uint8_t", ""),
    new MavLinkPacketField("len", "len", 1, false, 1, "uint8_t", "bytes"),
    new MavLinkPacketField("data", "data", 2, false, 1, "uint8_t[]", "", 16),
  ], (p) => Data16.decode(p))

  /// Data type.
  public type: u8 = 0

  /// Data length.
  /// Units: bytes.
  public len: u8 = 0

  /// Raw data.
  public data: u8[] = []

  /// A DATA16 from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): Data16 {
    const m = new Data16()
    m.type = readU8(payload, 0)
    m.len = readU8(payload, 1)
    for (let i = 0; i < 16; i++) {
      m.data.push(readU8(payload, 2 + i * 1))
    }
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 1, this.type as int)
    writeUint(into, at + 1, 1, this.len as int)
    for (let i = 0; i < 16 && i < this.data.length; i++) {
      writeUint(into, at + 2 + i * 1, 1, this.data[i] as int)
    }
  }

  public override info(): MessageInfo {
    Data16.INFO
  }
}

