    new MavLinkPacketField("fixed", "fixed", 2, false, 2, "uint16_t", ""),
    new MavLinkPacketField("rssi", "rssi", 4, false, 1, "uint8_t", ""),
    new MavLinkPacketField("remrssi", "remrssi", 5, false, 1, "uint8_t", ""),
    new MavLinkPacketField("txbuf", "txbuf", 6, false, 1, "uint8_t", "%"),
    new MavLinkPacketField("noise", "noise", 7, false, 1, "uint8_t", ""),
    new MavLinkPacketField("remnoise", "remnoise", 8, false, 1, "uint8_t", ""),
  ], (p) => Radio.decode(p))

  /// Local signal strength.
  public rssi: u8 = 0

  /// Remote signal strength.
  public remrssi: u8 = 0

  /// How full the tx buffer is.
  /// Units: %.
  public txbuf: u8 = 0

  /// Background noise level.
  public noise: u8 = 0

  /// Remote background noise level.
  public remnoise: u8 = 0

  /// Receive errors.
  public rxerrors: u16 = 0

  /// Count of error corrected packets.
  public fixed: u16 = 0

  /// A RADIO from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): Radio {
    const m = new Radio()
    m.rxerrors = readU16(payload, 0)
    m.fixed = readU16(payload, 2)
    m.rssi = readU8(payload, 4)
    m.remrssi = readU8(payload, 5)
    m.txbuf = readU8(payload, 6)
    m.noise = readU8(payload, 7)
    m.remnoise = readU8(payload, 8)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 2, this.rxerrors as int)
    writeUint(into, at + 2, 2, this.fixed as int)
    writeUint(into, at + 4, 1, this.rssi as int)
    writeUint(into, at + 5, 1, this.remrssi as int)
    writeUint(into, at + 6, 1, this.txbuf as int)
    writeUint(into, at + 7, 1, this.noise as int)
    writeUint(into, at + 8, 1, this.remnoise as int)
  }

  public override info(): MessageInfo {
    Radio.INFO
  }
}

