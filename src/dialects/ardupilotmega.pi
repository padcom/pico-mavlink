    new MavLinkPacketField("stab_roll", "stabRoll", 3, false, 1, "uint8_t", ""),
    new MavLinkPacketField("stab_pitch", "stabPitch", 4, false, 1, "uint8_t", ""),
    new MavLinkPacketField("stab_yaw", "stabYaw", 5, false, 1, "uint8_t", ""),
