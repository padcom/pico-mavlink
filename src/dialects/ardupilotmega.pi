/// Send a secure command. Data should be signed with a private key corresponding with a public key
/// known to the recipient. Signature should be over the concatenation of the sequence number
/// (little-endian format), the operation (little-endian format) the data and the session key. For
/// SECURE_COMMAND_GET_SESSION_KEY the session key should be zero length. The data array consists of the
/// data followed by the signature. The sum of the data_length and the sig_length cannot be more than
/// 220. The format of the data is command specific.
export class SecureCommand extends MavLinkData {
  public static readonly MSG_ID: int = 11004
  public static readonly MSG_NAME: string = "SECURE_COMMAND"
  public static readonly PAYLOAD_LENGTH: int = 232
  public static readonly MAGIC_NUMBER: int = 11
  public static readonly INFO: MessageInfo = new MessageInfo(11004, "SECURE_COMMAND", 232, 232, 11, [
    new MavLinkPacketField("sequence", "sequence", 0, false, 4, "uint32_t", ""),
    new MavLinkPacketField("operation", "operation", 4, false, 4, "uint32_t", ""),
    new MavLinkPacketField("target_system", "targetSystem", 8, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 9, false, 1, "uint8_t", ""),
    new MavLinkPacketField("data_length", "dataLength", 10, false, 1, "uint8_t", ""),
    new MavLinkPacketField("sig_length", "sigLength", 11, false, 1, "uint8_t", ""),
    new MavLinkPacketField("data", "data", 12, false, 1, "uint8_t[]", "", 220),
  ], (p) => SecureCommand.decode(p))

  /// System ID.
  public targetSystem: u8 = 0

  /// Component ID.
  public targetComponent: u8 = 0

  /// Sequence ID for tagging reply.
  public sequence: u32 = 0

  /// Operation being requested.
  /// Values: `SecureCommandOp`.
  public operation: u32 = 0

  /// Data length.
  public dataLength: u8 = 0

  /// Signature length.
  public sigLength: u8 = 0

  /// Signed data.
  public data: u8[] = []

  /// A SECURE_COMMAND from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): SecureCommand {
    const m = new SecureCommand()
    m.sequence = readU32(payload, 0)
    m.operation = readU32(payload, 4)
    m.targetSystem = readU8(payload, 8)
    m.targetComponent = readU8(payload, 9)
    m.dataLength = readU8(payload, 10)
    m.sigLength = readU8(payload, 11)
    for (let i = 0; i < 220; i++) {
      m.data.push(readU8(payload, 12 + i * 1))
    }
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.sequence as int)
    writeUint(into, at + 4, 4, this.operation as int)
    writeUint(into, at + 8, 1, this.targetSystem as int)
    writeUint(into, at + 9, 1, this.targetComponent as int)
    writeUint(into, at + 10, 1, this.dataLength as int)
    writeUint(into, at + 11, 1, this.sigLength as int)
    for (let i = 0; i < 220 && i < this.data.length; i++) {
      writeUint(into, at + 12 + i * 1, 1, this.data[i] as int)
    }
  }

  public override info(): MessageInfo {
    SecureCommand.INFO
  }
}

