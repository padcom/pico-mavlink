  /// A AHRS2 from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): Ahrs2 {
    const m = new Ahrs2()
    m.roll = readF32(payload, 0)
    m.pitch = readF32(payload, 4)
    m.yaw = readF32(payload, 8)
    m.altitude = readF32(payload, 12)
    m.lat = readI32(payload, 16)
    m.lng = readI32(payload, 20)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeF32(into, at + 0, this.roll)
    writeF32(into, at + 4, this.pitch)
    writeF32(into, at + 8, this.yaw)
    writeF32(into, at + 12, this.altitude)
    writeUint(into, at + 16, 4, this.lat as int)
    writeUint(into, at + 20, 4, this.lng as int)
  }

  public override info(): MessageInfo {
    Ahrs2.INFO
  }
}

/// Camera Event.
export class CameraStatus extends MavLinkData {
  public static readonly MSG_ID: int = 179
  public static readonly MSG_NAME: string = "CAMERA_STATUS"
  public static readonly PAYLOAD_LENGTH: int = 29
  public static readonly MAGIC_NUMBER: int = 189
  public static readonly INFO: MessageInfo = new MessageInfo(179, "CAMERA_STATUS", 29, 29, 189, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("p1", "p1", 8, false, 4, "float", ""),
    new MavLinkPacketField("p2", "p2", 12, false, 4, "float", ""),
    new MavLinkPacketField("p3", "p3", 16, false, 4, "float", ""),
    new MavLinkPacketField("p4", "p4", 20, false, 4, "float", ""),
    new MavLinkPacketField("img_idx", "imgIdx", 24, false, 2, "uint16_t", ""),
    new MavLinkPacketField("target_system", "targetSystem", 26, false, 1, "uint8_t", ""),
    new MavLinkPacketField("cam_idx", "camIdx", 27, false, 1, "uint8_t", ""),
    new MavLinkPacketField("event_id", "eventId", 28, false, 1, "uint8_t", ""),
  ], (p) => CameraStatus.decode(p))

  /// Image timestamp (since UNIX epoch, according to camera clock).
  /// Units: us.
  public timeUsec: u64 = 0

  /// System ID.
  public targetSystem: u8 = 0

  /// Camera ID.
  public camIdx: u8 = 0

  /// Image index.
  public imgIdx: u16 = 0

  /// Event type.
  /// Values: `CameraStatusTypes`.
  public eventId: u8 = 0

  /// Parameter 1 (meaning depends on event_id, see CAMERA_STATUS_TYPES enum).
  public p1: f32 = 0.0

  /// Parameter 2 (meaning depends on event_id, see CAMERA_STATUS_TYPES enum).
  public p2: f32 = 0.0

  /// Parameter 3 (meaning depends on event_id, see CAMERA_STATUS_TYPES enum).
  public p3: f32 = 0.0

  /// Parameter 4 (meaning depends on event_id, see CAMERA_STATUS_TYPES enum).
  public p4: f32 = 0.0

  /// A CAMERA_STATUS from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): CameraStatus {
    const m = new CameraStatus()
    m.timeUsec = readU64(payload, 0)
    m.p1 = readF32(payload, 8)
    m.p2 = readF32(payload, 12)
    m.p3 = readF32(payload, 16)
    m.p4 = readF32(payload, 20)
    m.imgIdx = readU16(payload, 24)
    m.targetSystem = readU8(payload, 26)
    m.camIdx = readU8(payload, 27)
    m.eventId = readU8(payload, 28)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    writeF32(into, at + 8, this.p1)
    writeF32(into, at + 12, this.p2)
    writeF32(into, at + 16, this.p3)
    writeF32(into, at + 20, this.p4)
    writeUint(into, at + 24, 2, this.imgIdx as int)
    writeUint(into, at + 26, 1, this.targetSystem as int)
    writeUint(into, at + 27, 1, this.camIdx as int)
    writeUint(into, at + 28, 1, this.eventId as int)
  }

  public override info(): MessageInfo {
    CameraStatus.INFO
  }
}

/// Camera Capture Feedback.
export class CameraFeedback extends MavLinkData {
  public static readonly MSG_ID: int = 180
  public static readonly MSG_NAME: string = "CAMERA_FEEDBACK"
  public static readonly PAYLOAD_LENGTH: int = 47
  public static readonly MAGIC_NUMBER: int = 52
  public static readonly INFO: MessageInfo = new MessageInfo(180, "CAMERA_FEEDBACK", 47, 45, 52, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("lat", "lat", 8, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("lng", "lng", 12, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("alt_msl", "altMsl", 16, false, 4, "float", "m"),
    new MavLinkPacketField("alt_rel", "altRel", 20, false, 4, "float", "m"),
    new MavLinkPacketField("roll", "roll", 24, false, 4, "float", "deg"),
    new MavLinkPacketField("pitch", "pitch", 28, false, 4, "float", "deg"),
    new MavLinkPacketField("yaw", "yaw", 32, false, 4, "float", "deg"),
    new MavLinkPacketField("foc_len", "focLen", 36, false, 4, "float", "mm"),
    new MavLinkPacketField("img_idx", "imgIdx", 40, false, 2, "uint16_t", ""),
    new MavLinkPacketField("target_system", "targetSystem", 42, false, 1, "uint8_t", ""),
    new MavLinkPacketField("cam_idx", "camIdx", 43, false, 1, "uint8_t", ""),
    new MavLinkPacketField("flags", "flags", 44, false, 1, "uint8_t", ""),
    new MavLinkPacketField("completed_captures", "completedCaptures", 45, true, 2, "uint16_t", ""),
  ], (p) => CameraFeedback.decode(p))

  /// Image timestamp (since UNIX epoch), as passed in by CAMERA_STATUS message (or autopilot if no CCB).
  /// Units: us.
  public timeUsec: u64 = 0

  /// System ID.
  public targetSystem: u8 = 0

  /// Camera ID.
  public camIdx: u8 = 0

  /// Image index.
  public imgIdx: u16 = 0

  /// Latitude.
  /// Units: degE7.
  public lat: i32 = 0

  /// Longitude.
  /// Units: degE7.
  public lng: i32 = 0

  /// Altitude (MSL).
  /// Units: m.
  public altMsl: f32 = 0.0

  /// Altitude (Relative to HOME location).
  /// Units: m.
  public altRel: f32 = 0.0

  /// Camera Roll angle (earth frame, +-180).
  /// Units: deg.
  public roll: f32 = 0.0

  /// Camera Pitch angle (earth frame, +-180).
  /// Units: deg.
  public pitch: f32 = 0.0

  /// Camera Yaw (earth frame, 0-360, true).
  /// Units: deg.
  public yaw: f32 = 0.0

  /// Focal Length.
  /// Units: mm.
  public focLen: f32 = 0.0

  /// Feedback flags.
  /// Values: `CameraFeedbackFlags`.
  public flags: u8 = 0

  /// Completed image captures.
  public completedCaptures: u16 = 0

  /// A CAMERA_FEEDBACK from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): CameraFeedback {
    const m = new CameraFeedback()
    m.timeUsec = readU64(payload, 0)
    m.lat = readI32(payload, 8)
    m.lng = readI32(payload, 12)
    m.altMsl = readF32(payload, 16)
    m.altRel = readF32(payload, 20)
    m.roll = readF32(payload, 24)
    m.pitch = readF32(payload, 28)
    m.yaw = readF32(payload, 32)
    m.focLen = readF32(payload, 36)
    m.imgIdx = readU16(payload, 40)
    m.targetSystem = readU8(payload, 42)
    m.camIdx = readU8(payload, 43)
    m.flags = readU8(payload, 44)
    m.completedCaptures = readU16(payload, 45)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    writeUint(into, at + 8, 4, this.lat as int)
    writeUint(into, at + 12, 4, this.lng as int)
    writeF32(into, at + 16, this.altMsl)
    writeF32(into, at + 20, this.altRel)
    writeF32(into, at + 24, this.roll)
    writeF32(into, at + 28, this.pitch)
    writeF32(into, at + 32, this.yaw)
    writeF32(into, at + 36, this.focLen)
    writeUint(into, at + 40, 2, this.imgIdx as int)
    writeUint(into, at + 42, 1, this.targetSystem as int)
    writeUint(into, at + 43, 1, this.camIdx as int)
    writeUint(into, at + 44, 1, this.flags as int)
    writeUint(into, at + 45, 2, this.completedCaptures as int)
  }

  public override info(): MessageInfo {
    CameraFeedback.INFO
  }
}

