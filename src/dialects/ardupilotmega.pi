    new MavLinkPacketField("target_component", "targetComponent", 1, false, 1, "uint8_t", ""),
    new MavLinkPacketField("cmd_id", "cmdId", 2, false, 1, "uint8_t", ""),
  ], (p) => GoproGetRequest.decode(p))

