    new MavLinkPacketField("lat", "lat", 16, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("lng", "lng", 20, false, 4, "int32_t", "degE7"),
  ], (p) => Ahrs2.decode(p))

