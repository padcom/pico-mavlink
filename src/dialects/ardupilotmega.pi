  /// RATE_ACRO
  public static readonly RATE_ACRO: int = 29

  /// The name of `value` (`STABILIZE` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "STABILIZE",
      1 => "ACRO",
