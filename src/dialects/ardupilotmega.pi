    writeUint(into, at + 0, 2, this.brkval as int)
    writeUint(into, at + 2, 2, this.freemem as int)
    writeUint(into, at + 4, 4, this.freemem32 as int)
  }

  public override info(): MessageInfo {
    MemInfo.INFO
  }
}

