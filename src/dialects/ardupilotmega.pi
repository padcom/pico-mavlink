    new MavLinkPacketField("MCU_voltage", "MCUVoltage", 2, false, 2, "uint16_t", "mV"),
    new MavLinkPacketField("MCU_voltage_min", "MCUVoltageMin", 4, false, 2, "uint16_t", "mV"),
    new MavLinkPacketField("MCU_voltage_max", "MCUVoltageMax", 6, false, 2, "uint16_t", "mV"),
    new MavLinkPacketField("id", "id", 8, false, 1, "uint8_t", ""),
  ], (p) => McuStatus.decode(p))

  /// MCU instance
  public id: u8 = 0

  /// MCU Internal temperature
  /// Units: cdegC.
  public MCUTemperature: i16 = 0

  /// MCU voltage
  /// Units: mV.
  public MCUVoltage: u16 = 0

  /// MCU voltage minimum
  /// Units: mV.
  public MCUVoltageMin: u16 = 0

  /// MCU voltage maximum
  /// Units: mV.
  public MCUVoltageMax: u16 = 0

  /// A MCU_STATUS from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): McuStatus {
    const m = new McuStatus()
    m.MCUTemperature = readI16(payload, 0)
    m.MCUVoltage = readU16(payload, 2)
    m.MCUVoltageMin = readU16(payload, 4)
    m.MCUVoltageMax = readU16(payload, 6)
    m.id = readU8(payload, 8)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 2, this.MCUTemperature as int)
    writeUint(into, at + 2, 2, this.MCUVoltage as int)
    writeUint(into, at + 4, 2, this.MCUVoltageMin as int)
    writeUint(into, at + 6, 2, this.MCUVoltageMax as int)
    writeUint(into, at + 8, 1, this.id as int)
  }

  public override info(): MessageInfo {
