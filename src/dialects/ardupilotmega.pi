/// Configure on-board Camera Control System.
export class DigicamConfigure extends MavLinkData {
  public static readonly MSG_ID: int = 154
  public static readonly MSG_NAME: string = "DIGICAM_CONFIGURE"
  public static readonly PAYLOAD_LENGTH: int = 15
  public static readonly MAGIC_NUMBER: int = 84
  public static readonly INFO: MessageInfo = new MessageInfo(154, "DIGICAM_CONFIGURE", 15, 15, 84, [
    new MavLinkPacketField("extra_value", "extraValue", 0, false, 4, "float", ""),
    new MavLinkPacketField("shutter_speed", "shutterSpeed", 4, false, 2, "uint16_t", ""),
    new MavLinkPacketField("target_system", "targetSystem", 6, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 7, false, 1, "uint8_t", ""),
    new MavLinkPacketField("mode", "mode", 8, false, 1, "uint8_t", ""),
    new MavLinkPacketField("aperture", "aperture", 9, false, 1, "uint8_t", ""),
    new MavLinkPacketField("iso", "iso", 10, false, 1, "uint8_t", ""),
    new MavLinkPacketField("exposure_type", "exposureType", 11, false, 1, "uint8_t", ""),
    new MavLinkPacketField("command_id", "commandId", 12, false, 1, "uint8_t", ""),
    new MavLinkPacketField("engine_cut_off", "engineCutOff", 13, false, 1, "uint8_t", "ds"),
    new MavLinkPacketField("extra_param", "extraParam", 14, false, 1, "uint8_t", ""),
  ], (p) => DigicamConfigure.decode(p))

  /// System ID.
  public targetSystem: u8 = 0

  /// Component ID.
  public targetComponent: u8 = 0

  /// Mode enumeration from 1 to N //P, TV, AV, M, etc. (0 means ignore).
  public mode: u8 = 0

  /// Divisor number //e.g. 1000 means 1/1000 (0 means ignore).
  public shutterSpeed: u16 = 0

  /// F stop number x 10 //e.g. 28 means 2.8 (0 means ignore).
  public aperture: u8 = 0

  /// ISO enumeration from 1 to N //e.g. 80, 100, 200, Etc (0 means ignore).
  public iso: u8 = 0

  /// Exposure type enumeration from 1 to N (0 means ignore).
  public exposureType: u8 = 0

  /// Command Identity (incremental loop: 0 to 255). //A command sent multiple times will be executed or
  /// pooled just once.
  public commandId: u8 = 0

  /// Main engine cut-off time before camera trigger (0 means no cut-off).
  /// Units: ds.
  public engineCutOff: u8 = 0

  /// Extra parameters enumeration (0 means ignore).
  public extraParam: u8 = 0

  /// Correspondent value to given extra_param.
  public extraValue: f32 = 0.0

  /// A DIGICAM_CONFIGURE from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): DigicamConfigure {
    const m = new DigicamConfigure()
    m.extraValue = readF32(payload, 0)
    m.shutterSpeed = readU16(payload, 4)
    m.targetSystem = readU8(payload, 6)
    m.targetComponent = readU8(payload, 7)
    m.mode = readU8(payload, 8)
    m.aperture = readU8(payload, 9)
    m.iso = readU8(payload, 10)
    m.exposureType = readU8(payload, 11)
    m.commandId = readU8(payload, 12)
    m.engineCutOff = readU8(payload, 13)
    m.extraParam = readU8(payload, 14)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeF32(into, at + 0, this.extraValue)
    writeUint(into, at + 4, 2, this.shutterSpeed as int)
    writeUint(into, at + 6, 1, this.targetSystem as int)
    writeUint(into, at + 7, 1, this.targetComponent as int)
    writeUint(into, at + 8, 1, this.mode as int)
    writeUint(into, at + 9, 1, this.aperture as int)
    writeUint(into, at + 10, 1, this.iso as int)
    writeUint(into, at + 11, 1, this.exposureType as int)
    writeUint(into, at + 12, 1, this.commandId as int)
    writeUint(into, at + 13, 1, this.engineCutOff as int)
    writeUint(into, at + 14, 1, this.extraParam as int)
  }

  public override info(): MessageInfo {
    DigicamConfigure.INFO
  }
}

/// Control on-board Camera Control System to take shots.
export class DigicamControl extends MavLinkData {
  public static readonly MSG_ID: int = 155
  public static readonly MSG_NAME: string = "DIGICAM_CONTROL"
  public static readonly PAYLOAD_LENGTH: int = 13
  public static readonly MAGIC_NUMBER: int = 22
  public static readonly INFO: MessageInfo = new MessageInfo(155, "DIGICAM_CONTROL", 13, 13, 22, [
    new MavLinkPacketField("extra_value", "extraValue", 0, false, 4, "float", ""),
    new MavLinkPacketField("target_system", "targetSystem", 4, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 5, false, 1, "uint8_t", ""),
    new MavLinkPacketField("session", "session", 6, false, 1, "uint8_t", ""),
    new MavLinkPacketField("zoom_pos", "zoomPos", 7, false, 1, "uint8_t", ""),
    new MavLinkPacketField("zoom_step", "zoomStep", 8, false, 1, "int8_t", ""),
    new MavLinkPacketField("focus_lock", "focusLock", 9, false, 1, "uint8_t", ""),
    new MavLinkPacketField("shot", "shot", 10, false, 1, "uint8_t", ""),
    new MavLinkPacketField("command_id", "commandId", 11, false, 1, "uint8_t", ""),
    new MavLinkPacketField("extra_param", "extraParam", 12, false, 1, "uint8_t", ""),
  ], (p) => DigicamControl.decode(p))

  /// System ID.
  public targetSystem: u8 = 0

  /// Component ID.
  public targetComponent: u8 = 0

  /// 0: stop, 1: start or keep it up //Session control e.g. show/hide lens.
  public session: u8 = 0

  /// 1 to N //Zoom's absolute position (0 means ignore).
  public zoomPos: u8 = 0

  /// -100 to 100 //Zooming step value to offset zoom from the current position.
  public zoomStep: i8 = 0

  /// 0: unlock focus or keep unlocked, 1: lock focus or keep locked, 3: re-lock focus.
  public focusLock: u8 = 0

  /// 0: ignore, 1: shot or start filming.
  public shot: u8 = 0

  /// Command Identity (incremental loop: 0 to 255)//A command sent multiple times will be executed or
  /// pooled just once.
  public commandId: u8 = 0

  /// Extra parameters enumeration (0 means ignore).
  public extraParam: u8 = 0

  /// Correspondent value to given extra_param.
  public extraValue: f32 = 0.0

  /// A DIGICAM_CONTROL from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): DigicamControl {
    const m = new DigicamControl()
    m.extraValue = readF32(payload, 0)
    m.targetSystem = readU8(payload, 4)
    m.targetComponent = readU8(payload, 5)
    m.session = readU8(payload, 6)
    m.zoomPos = readU8(payload, 7)
    m.zoomStep = readI8(payload, 8)
    m.focusLock = readU8(payload, 9)
    m.shot = readU8(payload, 10)
    m.commandId = readU8(payload, 11)
    m.extraParam = readU8(payload, 12)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeF32(into, at + 0, this.extraValue)
    writeUint(into, at + 4, 1, this.targetSystem as int)
    writeUint(into, at + 5, 1, this.targetComponent as int)
    writeUint(into, at + 6, 1, this.session as int)
    writeUint(into, at + 7, 1, this.zoomPos as int)
    writeUint(into, at + 8, 1, this.zoomStep as int)
    writeUint(into, at + 9, 1, this.focusLock as int)
    writeUint(into, at + 10, 1, this.shot as int)
    writeUint(into, at + 11, 1, this.commandId as int)
    writeUint(into, at + 12, 1, this.extraParam as int)
  }

  public override info(): MessageInfo {
    DigicamControl.INFO
  }
}

