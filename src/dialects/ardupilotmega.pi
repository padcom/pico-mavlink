/// Camera vision based attitude and position deltas.
export class VisionPositionDelta extends MavLinkData {
  public static readonly MSG_ID: int = 11011
  public static readonly MSG_NAME: string = "VISION_POSITION_DELTA"
  public static readonly PAYLOAD_LENGTH: int = 44
  public static readonly MAGIC_NUMBER: int = 106
  public static readonly INFO: MessageInfo = new MessageInfo(11011, "VISION_POSITION_DELTA", 44, 44, 106, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("time_delta_usec", "timeDeltaUsec", 8, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("angle_delta", "angleDelta", 16, false, 4, "float[]", "rad", 3),
    new MavLinkPacketField("position_delta", "positionDelta", 28, false, 4, "float[]", "m", 3),
    new MavLinkPacketField("confidence", "confidence", 40, false, 4, "float", "%"),
  ], (p) => VisionPositionDelta.decode(p))

  /// Timestamp (synced to UNIX time or since system boot).
  /// Units: us.
  public timeUsec: u64 = 0

  /// Time since the last reported camera frame.
  /// Units: us.
  public timeDeltaUsec: u64 = 0

  /// Defines a rotation vector [roll, pitch, yaw] to the current MAV_FRAME_BODY_FRD from the previous
  /// MAV_FRAME_BODY_FRD.
  /// Units: rad.
  public angleDelta: f32[] = []

  /// Change in position to the current MAV_FRAME_BODY_FRD from the previous FRAME_BODY_FRD rotated to the
  /// current MAV_FRAME_BODY_FRD.
  /// Units: m.
  public positionDelta: f32[] = []

  /// Normalised confidence value from 0 to 100.
  /// Units: %.
  public confidence: f32 = 0.0

  /// A VISION_POSITION_DELTA from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): VisionPositionDelta {
    const m = new VisionPositionDelta()
    m.timeUsec = readU64(payload, 0)
    m.timeDeltaUsec = readU64(payload, 8)
    for (let i = 0; i < 3; i++) {
      m.angleDelta.push(readF32(payload, 16 + i * 4))
    }
    for (let i = 0; i < 3; i++) {
      m.positionDelta.push(readF32(payload, 28 + i * 4))
    }
    m.confidence = readF32(payload, 40)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    writeU64(into, at + 8, this.timeDeltaUsec)
    for (let i = 0; i < 3 && i < this.angleDelta.length; i++) {
      writeF32(into, at + 16 + i * 4, this.angleDelta[i])
    }
    for (let i = 0; i < 3 && i < this.positionDelta.length; i++) {
      writeF32(into, at + 28 + i * 4, this.positionDelta[i])
    }
    writeF32(into, at + 40, this.confidence)
  }

  public override info(): MessageInfo {
    VisionPositionDelta.INFO
  }
}

/// Angle of Attack and Side Slip Angle.
export class AoaSsa extends MavLinkData {
  public static readonly MSG_ID: int = 11020
  public static readonly MSG_NAME: string = "AOA_SSA"
  public static readonly PAYLOAD_LENGTH: int = 16
  public static readonly MAGIC_NUMBER: int = 205
  public static readonly INFO: MessageInfo = new MessageInfo(11020, "AOA_SSA", 16, 16, 205, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("AOA", "AOA", 8, false, 4, "float", "deg"),
    new MavLinkPacketField("SSA", "SSA", 12, false, 4, "float", "deg"),
  ], (p) => AoaSsa.decode(p))

  /// Timestamp (since boot or Unix epoch).
  /// Units: us.
  public timeUsec: u64 = 0

  /// Angle of Attack.
  /// Units: deg.
  public AOA: f32 = 0.0

  /// Side Slip Angle.
  /// Units: deg.
  public SSA: f32 = 0.0

  /// A AOA_SSA from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): AoaSsa {
    const m = new AoaSsa()
    m.timeUsec = readU64(payload, 0)
    m.AOA = readF32(payload, 8)
    m.SSA = readF32(payload, 12)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    writeF32(into, at + 8, this.AOA)
    writeF32(into, at + 12, this.SSA)
  }

  public override info(): MessageInfo {
    AoaSsa.INFO
  }
}

/// ESC Telemetry Data for ESCs 1 to 4, matching data sent by BLHeli ESCs.
export class EscTelemetry1To4 extends MavLinkData {
  public static readonly MSG_ID: int = 11030
  public static readonly MSG_NAME: string = "ESC_TELEMETRY_1_TO_4"
  public static readonly PAYLOAD_LENGTH: int = 44
  public static readonly MAGIC_NUMBER: int = 144
  public static readonly INFO: MessageInfo = new MessageInfo(11030, "ESC_TELEMETRY_1_TO_4", 44, 44, 144, [
    new MavLinkPacketField("voltage", "voltage", 0, false, 2, "uint16_t[]", "cV", 4),
    new MavLinkPacketField("current", "current", 8, false, 2, "uint16_t[]", "cA", 4),
    new MavLinkPacketField("totalcurrent", "totalcurrent", 16, false, 2, "uint16_t[]", "mAh", 4),
    new MavLinkPacketField("rpm", "rpm", 24, false, 2, "uint16_t[]", "rpm", 4),
    new MavLinkPacketField("count", "count", 32, false, 2, "uint16_t[]", "", 4),
    new MavLinkPacketField("temperature", "temperature", 40, false, 1, "uint8_t[]", "degC", 4),
  ], (p) => EscTelemetry1To4.decode(p))

  /// Temperature.
  /// Units: degC.
  public temperature: u8[] = []

  /// Voltage.
  /// Units: cV.
  public voltage: u16[] = []

  /// Current.
  /// Units: cA.
  public current: u16[] = []

  /// Total current.
  /// Units: mAh.
  public totalcurrent: u16[] = []

  /// RPM (eRPM).
  /// Units: rpm.
  public rpm: u16[] = []

  /// count of telemetry packets received (wraps at 65535).
  public count: u16[] = []

  /// A ESC_TELEMETRY_1_TO_4 from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): EscTelemetry1To4 {
    const m = new EscTelemetry1To4()
    for (let i = 0; i < 4; i++) {
      m.voltage.push(readU16(payload, 0 + i * 2))
    }
    for (let i = 0; i < 4; i++) {
      m.current.push(readU16(payload, 8 + i * 2))
    }
    for (let i = 0; i < 4; i++) {
      m.totalcurrent.push(readU16(payload, 16 + i * 2))
    }
    for (let i = 0; i < 4; i++) {
      m.rpm.push(readU16(payload, 24 + i * 2))
    }
    for (let i = 0; i < 4; i++) {
      m.count.push(readU16(payload, 32 + i * 2))
    }
    for (let i = 0; i < 4; i++) {
      m.temperature.push(readU8(payload, 40 + i * 1))
    }
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    for (let i = 0; i < 4 && i < this.voltage.length; i++) {
      writeUint(into, at + 0 + i * 2, 2, this.voltage[i] as int)
    }
    for (let i = 0; i < 4 && i < this.current.length; i++) {
      writeUint(into, at + 8 + i * 2, 2, this.current[i] as int)
    }
    for (let i = 0; i < 4 && i < this.totalcurrent.length; i++) {
      writeUint(into, at + 16 + i * 2, 2, this.totalcurrent[i] as int)
    }
    for (let i = 0; i < 4 && i < this.rpm.length; i++) {
      writeUint(into, at + 24 + i * 2, 2, this.rpm[i] as int)
    }
    for (let i = 0; i < 4 && i < this.count.length; i++) {
      writeUint(into, at + 32 + i * 2, 2, this.count[i] as int)
    }
    for (let i = 0; i < 4 && i < this.temperature.length; i++) {
      writeUint(into, at + 40 + i * 1, 1, this.temperature[i] as int)
    }
  }

  public override info(): MessageInfo {
    EscTelemetry1To4.INFO
  }
}

