  /// PAUSE button has been clicked.
  public static readonly SOLO_BTN_PAUSE_CLICK: int = 42003

  /// Magnetometer calibration based on fixed position in earth field given by inclination, declination
  /// and intensity.
  public static readonly FIXED_MAG_CAL: int = 42004

  /// Magnetometer calibration based on fixed expected field values.
  public static readonly FIXED_MAG_CAL_FIELD: int = 42005

  /// Set EKF sensor source set.
  public static readonly SET_EKF_SOURCE_SET: int = 42007

  /// Initiate a magnetometer calibration.
