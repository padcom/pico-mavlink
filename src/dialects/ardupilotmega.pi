/// Offsets and calibrations values for hardware sensors. This makes it easier to debug the calibration
/// process.
///
/// Deprecated since 2022-02, replaced by MAG_CAL_REPORT, Accel Parameters, and Gyro Parameters.
export class SensorOffsets extends MavLinkData {
  public static readonly MSG_ID: int = 150
  public static readonly MSG_NAME: string = "SENSOR_OFFSETS"
  public static readonly PAYLOAD_LENGTH: int = 42
  public static readonly MAGIC_NUMBER: int = 134
  public static readonly INFO: MessageInfo = new MessageInfo(150, "SENSOR_OFFSETS", 42, 42, 134, [
    new MavLinkPacketField("mag_declination", "magDeclination", 0, false, 4, "float", "rad"),
    new MavLinkPacketField("raw_press", "rawPress", 4, false, 4, "int32_t", ""),
    new MavLinkPacketField("raw_temp", "rawTemp", 8, false, 4, "int32_t", ""),
    new MavLinkPacketField("gyro_cal_x", "gyroCalX", 12, false, 4, "float", ""),
    new MavLinkPacketField("gyro_cal_y", "gyroCalY", 16, false, 4, "float", ""),
    new MavLinkPacketField("gyro_cal_z", "gyroCalZ", 20, false, 4, "float", ""),
    new MavLinkPacketField("accel_cal_x", "accelCalX", 24, false, 4, "float", ""),
    new MavLinkPacketField("accel_cal_y", "accelCalY", 28, false, 4, "float", ""),
    new MavLinkPacketField("accel_cal_z", "accelCalZ", 32, false, 4, "float", ""),
    new MavLinkPacketField("mag_ofs_x", "magOfsX", 36, false, 2, "int16_t", ""),
    new MavLinkPacketField("mag_ofs_y", "magOfsY", 38, false, 2, "int16_t", ""),
    new MavLinkPacketField("mag_ofs_z", "magOfsZ", 40, false, 2, "int16_t", ""),
  ], (p) => SensorOffsets.decode(p))

  /// Magnetometer X offset.
  public magOfsX: i16 = 0

  /// Magnetometer Y offset.
  public magOfsY: i16 = 0

  /// Magnetometer Z offset.
  public magOfsZ: i16 = 0

  /// Magnetic declination.
  /// Units: rad.
  public magDeclination: f32 = 0.0

  /// Raw pressure from barometer.
  public rawPress: i32 = 0

  /// Raw temperature from barometer.
  public rawTemp: i32 = 0

  /// Gyro X calibration.
  public gyroCalX: f32 = 0.0

  /// Gyro Y calibration.
  public gyroCalY: f32 = 0.0

  /// Gyro Z calibration.
  public gyroCalZ: f32 = 0.0

  /// Accel X calibration.
  public accelCalX: f32 = 0.0

  /// Accel Y calibration.
  public accelCalY: f32 = 0.0

  /// Accel Z calibration.
  public accelCalZ: f32 = 0.0

  /// A SENSOR_OFFSETS from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): SensorOffsets {
    const m = new SensorOffsets()
    m.magDeclination = readF32(payload, 0)
    m.rawPress = readI32(payload, 4)
    m.rawTemp = readI32(payload, 8)
    m.gyroCalX = readF32(payload, 12)
    m.gyroCalY = readF32(payload, 16)
    m.gyroCalZ = readF32(payload, 20)
    m.accelCalX = readF32(payload, 24)
    m.accelCalY = readF32(payload, 28)
    m.accelCalZ = readF32(payload, 32)
    m.magOfsX = readI16(payload, 36)
    m.magOfsY = readI16(payload, 38)
    m.magOfsZ = readI16(payload, 40)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeF32(into, at + 0, this.magDeclination)
    writeUint(into, at + 4, 4, this.rawPress as int)
    writeUint(into, at + 8, 4, this.rawTemp as int)
    writeF32(into, at + 12, this.gyroCalX)
    writeF32(into, at + 16, this.gyroCalY)
    writeF32(into, at + 20, this.gyroCalZ)
    writeF32(into, at + 24, this.accelCalX)
    writeF32(into, at + 28, this.accelCalY)
    writeF32(into, at + 32, this.accelCalZ)
    writeUint(into, at + 36, 2, this.magOfsX as int)
    writeUint(into, at + 38, 2, this.magOfsY as int)
    writeUint(into, at + 40, 2, this.magOfsZ as int)
  }

  public override info(): MessageInfo {
    SensorOffsets.INFO
  }
}

/// Set the magnetometer offsets
///
/// Deprecated since 2014-07, replaced by MAV_CMD_PREFLIGHT_SET_SENSOR_OFFSETS.
export class SetMagOffsets extends MavLinkData {
  public static readonly MSG_ID: int = 151
  public static readonly MSG_NAME: string = "SET_MAG_OFFSETS"
  public static readonly PAYLOAD_LENGTH: int = 8
  public static readonly MAGIC_NUMBER: int = 219
  public static readonly INFO: MessageInfo = new MessageInfo(151, "SET_MAG_OFFSETS", 8, 8, 219, [
    new MavLinkPacketField("mag_ofs_x", "magOfsX", 0, false, 2, "int16_t", ""),
    new MavLinkPacketField("mag_ofs_y", "magOfsY", 2, false, 2, "int16_t", ""),
    new MavLinkPacketField("mag_ofs_z", "magOfsZ", 4, false, 2, "int16_t", ""),
    new MavLinkPacketField("target_system", "targetSystem", 6, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 7, false, 1, "uint8_t", ""),
  ], (p) => SetMagOffsets.decode(p))

  /// System ID.
  public targetSystem: u8 = 0

  /// Component ID.
  public targetComponent: u8 = 0

  /// Magnetometer X offset.
  public magOfsX: i16 = 0

  /// Magnetometer Y offset.
  public magOfsY: i16 = 0

  /// Magnetometer Z offset.
  public magOfsZ: i16 = 0

  /// A SET_MAG_OFFSETS from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): SetMagOffsets {
    const m = new SetMagOffsets()
    m.magOfsX = readI16(payload, 0)
    m.magOfsY = readI16(payload, 2)
    m.magOfsZ = readI16(payload, 4)
    m.targetSystem = readU8(payload, 6)
    m.targetComponent = readU8(payload, 7)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 2, this.magOfsX as int)
    writeUint(into, at + 2, 2, this.magOfsY as int)
    writeUint(into, at + 4, 2, this.magOfsZ as int)
    writeUint(into, at + 6, 1, this.targetSystem as int)
    writeUint(into, at + 7, 1, this.targetComponent as int)
  }

  public override info(): MessageInfo {
    SetMagOffsets.INFO
  }
}

/// State of autopilot RAM.
