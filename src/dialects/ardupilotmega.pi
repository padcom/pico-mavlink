/// Configure an OSD parameter slot.
export class OsdParamConfig extends MavLinkData {
  public static readonly MSG_ID: int = 11033
  public static readonly MSG_NAME: string = "OSD_PARAM_CONFIG"
  public static readonly PAYLOAD_LENGTH: int = 37
  public static readonly MAGIC_NUMBER: int = 195
  public static readonly INFO: MessageInfo = new MessageInfo(11033, "OSD_PARAM_CONFIG", 37, 37, 195, [
    new MavLinkPacketField("request_id", "requestId", 0, false, 4, "uint32_t", ""),
    new MavLinkPacketField("min_value", "minValue", 4, false, 4, "float", ""),
    new MavLinkPacketField("max_value", "maxValue", 8, false, 4, "float", ""),
    new MavLinkPacketField("increment", "increment", 12, false, 4, "float", ""),
    new MavLinkPacketField("target_system", "targetSystem", 16, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 17, false, 1, "uint8_t", ""),
    new MavLinkPacketField("osd_screen", "osdScreen", 18, false, 1, "uint8_t", ""),
    new MavLinkPacketField("osd_index", "osdIndex", 19, false, 1, "uint8_t", ""),
    new MavLinkPacketField("param_id", "paramId", 20, false, 1, "char[]", "", 16),
    new MavLinkPacketField("config_type", "configType", 36, false, 1, "uint8_t", ""),
  ], (p) => OsdParamConfig.decode(p))

  /// System ID.
  public targetSystem: u8 = 0

  /// Component ID.
  public targetComponent: u8 = 0

  /// Request ID - copied to reply.
  public requestId: u32 = 0

  /// OSD parameter screen index.
  public osdScreen: u8 = 0

  /// OSD parameter display index.
  public osdIndex: u8 = 0

  /// Onboard parameter id, terminated by NULL if the length is less than 16 human-readable chars and
  /// WITHOUT null termination (NULL) byte if the length is exactly 16 chars - applications have to
  /// provide 16+1 bytes storage if the ID is stored as string
  public paramId: string = ""

  /// Config type.
  /// Values: `OsdParamConfigType`.
  public configType: u8 = 0

  /// OSD parameter minimum value.
  public minValue: f32 = 0.0

  /// OSD parameter maximum value.
  public maxValue: f32 = 0.0

  /// OSD parameter increment.
  public increment: f32 = 0.0

  /// A OSD_PARAM_CONFIG from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): OsdParamConfig {
    const m = new OsdParamConfig()
    m.requestId = readU32(payload, 0)
    m.minValue = readF32(payload, 4)
    m.maxValue = readF32(payload, 8)
    m.increment = readF32(payload, 12)
    m.targetSystem = readU8(payload, 16)
    m.targetComponent = readU8(payload, 17)
    m.osdScreen = readU8(payload, 18)
    m.osdIndex = readU8(payload, 19)
    m.paramId = readChars(payload, 20, 16)
    m.configType = readU8(payload, 36)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.requestId as int)
    writeF32(into, at + 4, this.minValue)
    writeF32(into, at + 8, this.maxValue)
    writeF32(into, at + 12, this.increment)
    writeUint(into, at + 16, 1, this.targetSystem as int)
    writeUint(into, at + 17, 1, this.targetComponent as int)
    writeUint(into, at + 18, 1, this.osdScreen as int)
    writeUint(into, at + 19, 1, this.osdIndex as int)
    writeChars(into, at + 20, 16, this.paramId)
    writeUint(into, at + 36, 1, this.configType as int)
  }

  public override info(): MessageInfo {
    OsdParamConfig.INFO
  }
}

/// Configure OSD parameter reply.
export class OsdParamConfigReply extends MavLinkData {
  public static readonly MSG_ID: int = 11034
  public static readonly MSG_NAME: string = "OSD_PARAM_CONFIG_REPLY"
  public static readonly PAYLOAD_LENGTH: int = 5
  public static readonly MAGIC_NUMBER: int = 79
  public static readonly INFO: MessageInfo = new MessageInfo(11034, "OSD_PARAM_CONFIG_REPLY", 5, 5, 79, [
    new MavLinkPacketField("request_id", "requestId", 0, false, 4, "uint32_t", ""),
    new MavLinkPacketField("result", "result", 4, false, 1, "uint8_t", ""),
  ], (p) => OsdParamConfigReply.decode(p))

  /// Request ID - copied from request.
  public requestId: u32 = 0

  /// Config error type.
  /// Values: `OsdParamConfigError`.
  public result: u8 = 0

  /// A OSD_PARAM_CONFIG_REPLY from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): OsdParamConfigReply {
    const m = new OsdParamConfigReply()
    m.requestId = readU32(payload, 0)
    m.result = readU8(payload, 4)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.requestId as int)
    writeUint(into, at + 4, 1, this.result as int)
  }

  public override info(): MessageInfo {
    OsdParamConfigReply.INFO
  }
}

