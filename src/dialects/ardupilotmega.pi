  /// A GOPRO_SET_REQUEST from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): GoproSetRequest {
    const m = new GoproSetRequest()
    m.targetSystem = readU8(payload, 0)
    m.targetComponent = readU8(payload, 1)
    m.cmdId = readU8(payload, 2)
    for (let i = 0; i < 4; i++) {
      m.value.push(readU8(payload, 3 + i * 1))
    }
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 1, this.targetSystem as int)
    writeUint(into, at + 1, 1, this.targetComponent as int)
    writeUint(into, at + 2, 1, this.cmdId as int)
    for (let i = 0; i < 4 && i < this.value.length; i++) {
