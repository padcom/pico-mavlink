  /// Voltage.
  /// Units: cV.
  public voltage: u16[] = []

  /// Current.
  /// Units: cA.
  public current: u16[] = []

  /// Total current.
  /// Units: mAh.
  public totalcurrent: u16[] = []

  /// RPM (eRPM).
  /// Units: rpm.
  public rpm: u16[] = []

  /// count of telemetry packets received (wraps at 65535).
  public count: u16[] = []

  /// A ESC_TELEMETRY_13_TO_16 from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): EscTelemetry13To16 {
    const m = new EscTelemetry13To16()
    for (let i = 0; i < 4; i++) {
      m.voltage.push(readU16(payload, 0 + i * 2))
    }
    for (let i = 0; i < 4; i++) {
      m.current.push(readU16(payload, 8 + i * 2))
    }
    for (let i = 0; i < 4; i++) {
      m.totalcurrent.push(readU16(payload, 16 + i * 2))
    }
    for (let i = 0; i < 4; i++) {
      m.rpm.push(readU16(payload, 24 + i * 2))
    }
    for (let i = 0; i < 4; i++) {
      m.count.push(readU16(payload, 32 + i * 2))
    }
    for (let i = 0; i < 4; i++) {
      m.temperature.push(readU8(payload, 40 + i * 1))
    }
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    for (let i = 0; i < 4 && i < this.voltage.length; i++) {
      writeUint(into, at + 0 + i * 2, 2, this.voltage[i] as int)
    }
    for (let i = 0; i < 4 && i < this.current.length; i++) {
      writeUint(into, at + 8 + i * 2, 2, this.current[i] as int)
    }
    for (let i = 0; i < 4 && i < this.totalcurrent.length; i++) {
      writeUint(into, at + 16 + i * 2, 2, this.totalcurrent[i] as int)
    }
    for (let i = 0; i < 4 && i < this.rpm.length; i++) {
      writeUint(into, at + 24 + i * 2, 2, this.rpm[i] as int)
    }
    for (let i = 0; i < 4 && i < this.count.length; i++) {
      writeUint(into, at + 32 + i * 2, 2, this.count[i] as int)
    }
    for (let i = 0; i < 4 && i < this.temperature.length; i++) {
      writeUint(into, at + 40 + i * 1, 1, this.temperature[i] as int)
    }
  }

  public override info(): MessageInfo {
    EscTelemetry13To16.INFO
  }
}

