    }
    for (let i = 0; i < 4; i++) {
      m.temperature.push(readU8(payload, 40 + i * 1))
    }
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    for (let i = 0; i < 4 && i < this.voltage.length; i++) {
      writeUint(into, at + 0 + i * 2, 2, this.voltage[i] as int)
    }
    for (let i = 0; i < 4 && i < this.current.length; i++) {
      writeUint(into, at + 8 + i * 2, 2, this.current[i] as int)
    }
    for (let i = 0; i < 4 && i < this.totalcurrent.length; i++) {
      writeUint(into, at + 16 + i * 2, 2, this.totalcurrent[i] as int)
    }
    for (let i = 0; i < 4 && i < this.rpm.length; i++) {
      writeUint(into, at + 24 + i * 2, 2, this.rpm[i] as int)
    }
    for (let i = 0; i < 4 && i < this.count.length; i++) {
      writeUint(into, at + 32 + i * 2, 2, this.count[i] as int)
    }
    for (let i = 0; i < 4 && i < this.temperature.length; i++) {
      writeUint(into, at + 40 + i * 1, 1, this.temperature[i] as int)
    }
  }

  public override info(): MessageInfo {
    EscTelemetry25To28.INFO
  }
}

/// ESC Telemetry Data for ESCs 29 to 32, matching data sent by BLHeli ESCs.
export class EscTelemetry29To32 extends MavLinkData {
  public static readonly MSG_ID: int = 11044
  public static readonly MSG_NAME: string = "ESC_TELEMETRY_29_TO_32"
  public static readonly PAYLOAD_LENGTH: int = 44
  public static readonly MAGIC_NUMBER: int = 189
  public static readonly INFO: MessageInfo = new MessageInfo(11044, "ESC_TELEMETRY_29_TO_32", 44, 44, 189, [
    new MavLinkPacketField("voltage", "voltage", 0, false, 2, "uint16_t[]", "cV", 4),
    new MavLinkPacketField("current", "current", 8, false, 2, "uint16_t[]", "cA", 4),
    new MavLinkPacketField("totalcurrent", "totalcurrent", 16, false, 2, "uint16_t[]", "mAh", 4),
    new MavLinkPacketField("rpm", "rpm", 24, false, 2, "uint16_t[]", "rpm", 4),
    new MavLinkPacketField("count", "count", 32, false, 2, "uint16_t[]", "", 4),
    new MavLinkPacketField("temperature", "temperature", 40, false, 1, "uint8_t[]", "degC", 4),
  ], (p) => EscTelemetry29To32.decode(p))

  /// Temperature.
  /// Units: degC.
  public temperature: u8[] = []

  /// Voltage.
  /// Units: cV.
  public voltage: u16[] = []

  /// Current.
  /// Units: cA.
  public current: u16[] = []

  /// Total current.
  /// Units: mAh.
  public totalcurrent: u16[] = []

  /// RPM (eRPM).
  /// Units: rpm.
  public rpm: u16[] = []

  /// count of telemetry packets received (wraps at 65535).
  public count: u16[] = []

  /// A ESC_TELEMETRY_29_TO_32 from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): EscTelemetry29To32 {
    const m = new EscTelemetry29To32()
    for (let i = 0; i < 4; i++) {
      m.voltage.push(readU16(payload, 0 + i * 2))
    }
    for (let i = 0; i < 4; i++) {
      m.current.push(readU16(payload, 8 + i * 2))
    }
    for (let i = 0; i < 4; i++) {
      m.totalcurrent.push(readU16(payload, 16 + i * 2))
    }
    for (let i = 0; i < 4; i++) {
      m.rpm.push(readU16(payload, 24 + i * 2))
    }
    for (let i = 0; i < 4; i++) {
      m.count.push(readU16(payload, 32 + i * 2))
    }
    for (let i = 0; i < 4; i++) {
      m.temperature.push(readU8(payload, 40 + i * 1))
    }
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    for (let i = 0; i < 4 && i < this.voltage.length; i++) {
      writeUint(into, at + 0 + i * 2, 2, this.voltage[i] as int)
    }
    for (let i = 0; i < 4 && i < this.current.length; i++) {
      writeUint(into, at + 8 + i * 2, 2, this.current[i] as int)
    }
    for (let i = 0; i < 4 && i < this.totalcurrent.length; i++) {
      writeUint(into, at + 16 + i * 2, 2, this.totalcurrent[i] as int)
    }
    for (let i = 0; i < 4 && i < this.rpm.length; i++) {
      writeUint(into, at + 24 + i * 2, 2, this.rpm[i] as int)
    }
    for (let i = 0; i < 4 && i < this.count.length; i++) {
      writeUint(into, at + 32 + i * 2, 2, this.count[i] as int)
    }
    for (let i = 0; i < 4 && i < this.temperature.length; i++) {
      writeUint(into, at + 40 + i * 1, 1, this.temperature[i] as int)
    }
  }

  public override info(): MessageInfo {
    EscTelemetry29To32.INFO
  }
}

/// Send a key-value pair as string. The use of this message is discouraged for normal packets, but a
/// quite efficient way for testing new messages and getting experimental debug output.
export class NamedValueString extends MavLinkData {
  public static readonly MSG_ID: int = 11060
  public static readonly MSG_NAME: string = "NAMED_VALUE_STRING"
  public static readonly PAYLOAD_LENGTH: int = 78
  public static readonly MAGIC_NUMBER: int = 162
  public static readonly INFO: MessageInfo = new MessageInfo(11060, "NAMED_VALUE_STRING", 78, 78, 162, [
    new MavLinkPacketField("time_boot_ms", "timeBootMs", 0, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("name", "name", 4, false, 1, "char[]", "", 10),
    new MavLinkPacketField("value", "value", 14, false, 1, "char[]", "", 64),
  ], (p) => NamedValueString.decode(p))

  /// Timestamp (time since system boot).
  /// Units: ms.
  public timeBootMs: u32 = 0

  /// Name of the debug variable
  public name: string = ""

  /// Value of the debug variable
  public value: string = ""

  /// A NAMED_VALUE_STRING from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): NamedValueString {
    const m = new NamedValueString()
    m.timeBootMs = readU32(payload, 0)
    m.name = readChars(payload, 4, 10)
    m.value = readChars(payload, 14, 64)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.timeBootMs as int)
    writeChars(into, at + 4, 10, this.name)
    writeChars(into, at + 14, 64, this.value)
  }

  public override info(): MessageInfo {
    NamedValueString.INFO
  }
}

