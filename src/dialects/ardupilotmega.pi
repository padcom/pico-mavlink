}

/// Message to control a camera mount, directional antenna, etc.
export class MountControl extends MavLinkData {
  public static readonly MSG_ID: int = 157
  public static readonly MSG_NAME: string = "MOUNT_CONTROL"
  public static readonly PAYLOAD_LENGTH: int = 15
  public static readonly MAGIC_NUMBER: int = 21
  public static readonly INFO: MessageInfo = new MessageInfo(157, "MOUNT_CONTROL", 15, 15, 21, [
    new MavLinkPacketField("input_a", "inputA", 0, false, 4, "int32_t", ""),
    new MavLinkPacketField("input_b", "inputB", 4, false, 4, "int32_t", ""),
    new MavLinkPacketField("input_c", "inputC", 8, false, 4, "int32_t", ""),
    new MavLinkPacketField("target_system", "targetSystem", 12, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 13, false, 1, "uint8_t", ""),
    new MavLinkPacketField("save_position", "savePosition", 14, false, 1, "uint8_t", ""),
  ], (p) => MountControl.decode(p))

  /// System ID.
  public targetSystem: u8 = 0

  /// Component ID.
  public targetComponent: u8 = 0

  /// Pitch (centi-degrees) or lat (degE7), depending on mount mode.
  public inputA: i32 = 0

  /// Roll (centi-degrees) or lon (degE7) depending on mount mode.
  public inputB: i32 = 0

  /// Yaw (centi-degrees) or alt (cm) depending on mount mode.
  public inputC: i32 = 0

  /// If "1" it will save current trimmed position on EEPROM (just valid for NEUTRAL and LANDING).
  public savePosition: u8 = 0

  /// A MOUNT_CONTROL from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): MountControl {
    const m = new MountControl()
    m.inputA = readI32(payload, 0)
    m.inputB = readI32(payload, 4)
    m.inputC = readI32(payload, 8)
    m.targetSystem = readU8(payload, 12)
    m.targetComponent = readU8(payload, 13)
    m.savePosition = readU8(payload, 14)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.inputA as int)
    writeUint(into, at + 4, 4, this.inputB as int)
    writeUint(into, at + 8, 4, this.inputC as int)
    writeUint(into, at + 12, 1, this.targetSystem as int)
    writeUint(into, at + 13, 1, this.targetComponent as int)
    writeUint(into, at + 14, 1, this.savePosition as int)
  }

  public override info(): MessageInfo {
    MountControl.INFO
  }
}

