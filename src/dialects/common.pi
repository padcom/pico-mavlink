  public targetComponent: u8 = 0

  /// Onboard parameter id, terminated by NULL if the length is less than 16 human-readable chars and
  /// WITHOUT null termination (NULL) byte if the length is exactly 16 chars - applications have to
  /// provide 16+1 bytes storage if the ID is stored as string
  public paramId: string = ""

  /// Parameter index. Send -1 to use the param ID field as identifier (else the param id will be
  /// ignored), send -2 to disable any existing map for this rc_channel_index.
  public paramIndex: i16 = 0

  /// Index of parameter RC channel. Not equal to the RC channel id. Typically corresponds to a
  /// potentiometer-knob on the RC.
  public parameterRcChannelIndex: u8 = 0

  /// Initial parameter value
  public paramValue0: f32 = 0.0

  /// Scale, maps the RC range [-1, 1] to a parameter value
  public scale: f32 = 0.0

  /// Minimum param value. The protocol does not define if this overwrites an onboard minimum value.
  /// (Depends on implementation)
  public paramValueMin: f32 = 0.0

  /// Maximum param value. The protocol does not define if this overwrites an onboard maximum value.
  /// (Depends on implementation)
  public paramValueMax: f32 = 0.0

  /// A PARAM_MAP_RC from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): ParamMapRc {
    const m = new ParamMapRc()
    m.paramValue0 = readF32(payload, 0)
    m.scale = readF32(payload, 4)
    m.paramValueMin = readF32(payload, 8)
    m.paramValueMax = readF32(payload, 12)
    m.paramIndex = readI16(payload, 16)
    m.targetSystem = readU8(payload, 18)
    m.targetComponent = readU8(payload, 19)
    m.paramId = readChars(payload, 20, 16)
    m.parameterRcChannelIndex = readU8(payload, 36)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeF32(into, at + 0, this.paramValue0)
    writeF32(into, at + 4, this.scale)
    writeF32(into, at + 8, this.paramValueMin)
    writeF32(into, at + 12, this.paramValueMax)
    writeUint(into, at + 16, 2, this.paramIndex as int)
    writeUint(into, at + 18, 1, this.targetSystem as int)
    writeUint(into, at + 19, 1, this.targetComponent as int)
    writeChars(into, at + 20, 16, this.paramId)
    writeUint(into, at + 36, 1, this.parameterRcChannelIndex as int)
  }

  public override info(): MessageInfo {
    ParamMapRc.INFO
  }
}

