    writeF32(into, at + 0, this.airspeed)
    writeF32(into, at + 4, this.groundspeed)
    writeF32(into, at + 8, this.alt)
    writeF32(into, at + 12, this.climb)
    writeUint(into, at + 16, 2, this.heading as int)
    writeUint(into, at + 18, 2, this.throttle as int)
  }

  public override info(): MessageInfo {
    VfrHud.INFO
  }
}

