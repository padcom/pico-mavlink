/// Information about a flight mode. The message can be enumerated to get information for all modes, or
/// requested for a particular mode, using MAV_CMD_REQUEST_MESSAGE. Specify 0 in param2 to request that
/// the message is emitted for all available modes or the specific index for just one mode. The modes
/// must be available/settable for the current vehicle/frame type. Each mode should only be emitted once
/// (even if it is both standard and custom). Note that the current mode should be emitted in
/// CURRENT_MODE, and that if the mode list can change then AVAILABLE_MODES_MONITOR must be emitted on
/// first change and subsequently streamed. See https://mavlink.io/en/services/standard_modes.html
export class AvailableModes extends MavLinkData {
  public static readonly MSG_ID: int = 435
  public static readonly MSG_NAME: string = "AVAILABLE_MODES"
  public static readonly PAYLOAD_LENGTH: int = 46
  public static readonly MAGIC_NUMBER: int = 134
  public static readonly INFO: MessageInfo = new MessageInfo(435, "AVAILABLE_MODES", 46, 46, 134, [
    new MavLinkPacketField("custom_mode", "customMode", 0, false, 4, "uint32_t", ""),
    new MavLinkPacketField("properties", "properties", 4, false, 4, "uint32_t", ""),
    new MavLinkPacketField("number_modes", "numberModes", 8, false, 1, "uint8_t", ""),
    new MavLinkPacketField("mode_index", "modeIndex", 9, false, 1, "uint8_t", ""),
    new MavLinkPacketField("standard_mode", "standardMode", 10, false, 1, "uint8_t", ""),
    new MavLinkPacketField("mode_name", "modeName", 11, false, 1, "char[]", "", 35),
  ], (p) => AvailableModes.decode(p))

  /// The total number of available modes for the current vehicle type.
  public numberModes: u8 = 0

  /// The current mode index within number_modes, indexed from 1. The index is not guaranteed to be
  /// persistent, and may change between reboots or if the set of modes change.
  public modeIndex: u8 = 0

  /// Standard mode.
  /// Values: `MavStandardMode`.
  public standardMode: u8 = 0

  /// A bitfield for use for autopilot-specific flags
  public customMode: u32 = 0

  /// Mode properties.
  /// Values: `MavModeProperty`.
  public properties: u32 = 0

  /// Name of custom mode, with null termination character. Should be omitted for standard modes.
  public modeName: string = ""

  /// A AVAILABLE_MODES from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): AvailableModes {
    const m = new AvailableModes()
    m.customMode = readU32(payload, 0)
    m.properties = readU32(payload, 4)
    m.numberModes = readU8(payload, 8)
    m.modeIndex = readU8(payload, 9)
    m.standardMode = readU8(payload, 10)
    m.modeName = readChars(payload, 11, 35)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.customMode as int)
    writeUint(into, at + 4, 4, this.properties as int)
    writeUint(into, at + 8, 1, this.numberModes as int)
    writeUint(into, at + 9, 1, this.modeIndex as int)
    writeUint(into, at + 10, 1, this.standardMode as int)
    writeChars(into, at + 11, 35, this.modeName)
  }

  public override info(): MessageInfo {
    AvailableModes.INFO
  }
}

/// Get the current mode. This should be emitted on any mode change, and broadcast at low rate
/// (nominally 0.5 Hz). It may be requested using MAV_CMD_REQUEST_MESSAGE. See
/// https://mavlink.io/en/services/standard_modes.html
export class CurrentMode extends MavLinkData {
  public static readonly MSG_ID: int = 436
  public static readonly MSG_NAME: string = "CURRENT_MODE"
  public static readonly PAYLOAD_LENGTH: int = 9
  public static readonly MAGIC_NUMBER: int = 193
  public static readonly INFO: MessageInfo = new MessageInfo(436, "CURRENT_MODE", 9, 9, 193, [
    new MavLinkPacketField("custom_mode", "customMode", 0, false, 4, "uint32_t", ""),
    new MavLinkPacketField("intended_custom_mode", "intendedCustomMode", 4, false, 4, "uint32_t", ""),
    new MavLinkPacketField("standard_mode", "standardMode", 8, false, 1, "uint8_t", ""),
  ], (p) => CurrentMode.decode(p))

  /// Standard mode.
  /// Values: `MavStandardMode`.
  public standardMode: u8 = 0

  /// A bitfield for use for autopilot-specific flags
  public customMode: u32 = 0

  /// The custom_mode of the mode that was last commanded by the user (for example, with
  /// MAV_CMD_DO_SET_STANDARD_MODE, MAV_CMD_DO_SET_MODE or via RC). This should usually be the same as
  /// custom_mode. It will be different if the vehicle is unable to enter the intended mode, or has left
  /// that mode due to a failsafe condition. 0 indicates the intended custom mode is unknown/not supplied
  public intendedCustomMode: u32 = 0

  /// A CURRENT_MODE from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): CurrentMode {
    const m = new CurrentMode()
    m.customMode = readU32(payload, 0)
    m.intendedCustomMode = readU32(payload, 4)
    m.standardMode = readU8(payload, 8)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.customMode as int)
    writeUint(into, at + 4, 4, this.intendedCustomMode as int)
    writeUint(into, at + 8, 1, this.standardMode as int)
  }

  public override info(): MessageInfo {
    CurrentMode.INFO
  }
}

/// A change to the sequence number indicates that the set of AVAILABLE_MODES has changed. A receiver
/// must re-request all available modes whenever the sequence number changes. This is only emitted after
/// the first change and should then be broadcast at low rate (nominally 0.3 Hz) and on change. See
/// https://mavlink.io/en/services/standard_modes.html
export class AvailableModesMonitor extends MavLinkData {
  public static readonly MSG_ID: int = 437
  public static readonly MSG_NAME: string = "AVAILABLE_MODES_MONITOR"
  public static readonly PAYLOAD_LENGTH: int = 1
  public static readonly MAGIC_NUMBER: int = 30
  public static readonly INFO: MessageInfo = new MessageInfo(437, "AVAILABLE_MODES_MONITOR", 1, 1, 30, [
    new MavLinkPacketField("seq", "seq", 0, false, 1, "uint8_t", ""),
  ], (p) => AvailableModesMonitor.decode(p))

  /// Sequence number. The value iterates sequentially whenever AVAILABLE_MODES changes (e.g. support for
  /// a new mode is added/removed dynamically).
  public seq: u8 = 0

  /// A AVAILABLE_MODES_MONITOR from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): AvailableModesMonitor {
    const m = new AvailableModesMonitor()
    m.seq = readU8(payload, 0)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 1, this.seq as int)
  }

  public override info(): MessageInfo {
    AvailableModesMonitor.INFO
  }
}

/// Illuminator status
export class IlluminatorStatus extends MavLinkData {
  public static readonly MSG_ID: int = 440
  public static readonly MSG_NAME: string = "ILLUMINATOR_STATUS"
  public static readonly PAYLOAD_LENGTH: int = 35
  public static readonly MAGIC_NUMBER: int = 66
  public static readonly INFO: MessageInfo = new MessageInfo(440, "ILLUMINATOR_STATUS", 35, 35, 66, [
    new MavLinkPacketField("uptime_ms", "uptimeMs", 0, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("error_status", "errorStatus", 4, false, 4, "uint32_t", ""),
    new MavLinkPacketField("brightness", "brightness", 8, false, 4, "float", "%"),
    new MavLinkPacketField("strobe_period", "strobePeriod", 12, false, 4, "float", "s"),
    new MavLinkPacketField("strobe_duty_cycle", "strobeDutyCycle", 16, false, 4, "float", "%"),
    new MavLinkPacketField("temp_c", "tempC", 20, false, 4, "float", ""),
    new MavLinkPacketField("min_strobe_period", "minStrobePeriod", 24, false, 4, "float", "s"),
    new MavLinkPacketField("max_strobe_period", "maxStrobePeriod", 28, false, 4, "float", "s"),
    new MavLinkPacketField("enable", "enable", 32, false, 1, "uint8_t", ""),
    new MavLinkPacketField("mode_bitmask", "modeBitmask", 33, false, 1, "uint8_t", ""),
    new MavLinkPacketField("mode", "mode", 34, false, 1, "uint8_t", ""),
  ], (p) => IlluminatorStatus.decode(p))

  /// Time since the start-up of the illuminator in ms
  /// Units: ms.
  public uptimeMs: u32 = 0

  /// 0: Illuminators OFF, 1: Illuminators ON
  public enable: u8 = 0

  /// Supported illuminator modes
  /// Values: `IlluminatorMode`.
  public modeBitmask: u8 = 0

  /// Errors
  /// Values: `IlluminatorErrorFlags`.
  public errorStatus: u32 = 0

  /// Illuminator mode
  /// Values: `IlluminatorMode`.
  public mode: u8 = 0

  /// Illuminator brightness
  /// Units: %.
  public brightness: f32 = 0.0

  /// Illuminator strobing period in seconds
  /// Units: s.
  public strobePeriod: f32 = 0.0

  /// Illuminator strobing duty cycle
  /// Units: %.
  public strobeDutyCycle: f32 = 0.0

  /// Temperature in Celsius
  public tempC: f32 = 0.0

  /// Minimum strobing period in seconds
  /// Units: s.
  public minStrobePeriod: f32 = 0.0

  /// Maximum strobing period in seconds
  /// Units: s.
  public maxStrobePeriod: f32 = 0.0

  /// A ILLUMINATOR_STATUS from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): IlluminatorStatus {
    const m = new IlluminatorStatus()
    m.uptimeMs = readU32(payload, 0)
    m.errorStatus = readU32(payload, 4)
    m.brightness = readF32(payload, 8)
    m.strobePeriod = readF32(payload, 12)
    m.strobeDutyCycle = readF32(payload, 16)
    m.tempC = readF32(payload, 20)
    m.minStrobePeriod = readF32(payload, 24)
    m.maxStrobePeriod = readF32(payload, 28)
    m.enable = readU8(payload, 32)
    m.modeBitmask = readU8(payload, 33)
    m.mode = readU8(payload, 34)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.uptimeMs as int)
    writeUint(into, at + 4, 4, this.errorStatus as int)
    writeF32(into, at + 8, this.brightness)
    writeF32(into, at + 12, this.strobePeriod)
    writeF32(into, at + 16, this.strobeDutyCycle)
    writeF32(into, at + 20, this.tempC)
    writeF32(into, at + 24, this.minStrobePeriod)
    writeF32(into, at + 28, this.maxStrobePeriod)
    writeUint(into, at + 32, 1, this.enable as int)
    writeUint(into, at + 33, 1, this.modeBitmask as int)
    writeUint(into, at + 34, 1, this.mode as int)
  }

  public override info(): MessageInfo {
    IlluminatorStatus.INFO
  }
}

/// A forwarded CANFD frame as requested by MAV_CMD_CAN_FORWARD. These are separated from CAN_FRAME as
/// they need different handling (eg. TAO handling)
export class CanfdFrame extends MavLinkData {
  public static readonly MSG_ID: int = 387
  public static readonly MSG_NAME: string = "CANFD_FRAME"
  public static readonly PAYLOAD_LENGTH: int = 72
  public static readonly MAGIC_NUMBER: int = 4
  public static readonly INFO: MessageInfo = new MessageInfo(387, "CANFD_FRAME", 72, 72, 4, [
    new MavLinkPacketField("id", "id", 0, false, 4, "uint32_t", ""),
    new MavLinkPacketField("target_system", "targetSystem", 4, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 5, false, 1, "uint8_t", ""),
    new MavLinkPacketField("bus", "bus", 6, false, 1, "uint8_t", ""),
    new MavLinkPacketField("len", "len", 7, false, 1, "uint8_t", ""),
    new MavLinkPacketField("data", "data", 8, false, 1, "uint8_t[]", "", 64),
  ], (p) => CanfdFrame.decode(p))

  /// System ID.
  public targetSystem: u8 = 0

  /// Component ID.
  public targetComponent: u8 = 0

  /// bus number
  public bus: u8 = 0

  /// Frame length
  public len: u8 = 0

  /// Frame ID
  public id: u32 = 0

  /// Frame data
  public data: u8[] = []

  /// A CANFD_FRAME from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): CanfdFrame {
    const m = new CanfdFrame()
    m.id = readU32(payload, 0)
    m.targetSystem = readU8(payload, 4)
    m.targetComponent = readU8(payload, 5)
    m.bus = readU8(payload, 6)
    m.len = readU8(payload, 7)
    for (let i = 0; i < 64; i++) {
      m.data.push(readU8(payload, 8 + i * 1))
    }
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.id as int)
    writeUint(into, at + 4, 1, this.targetSystem as int)
    writeUint(into, at + 5, 1, this.targetComponent as int)
    writeUint(into, at + 6, 1, this.bus as int)
    writeUint(into, at + 7, 1, this.len as int)
    for (let i = 0; i < 64 && i < this.data.length; i++) {
      writeUint(into, at + 8 + i * 1, 1, this.data[i] as int)
    }
  }

  public override info(): MessageInfo {
    CanfdFrame.INFO
  }
}

/// Modify the filter of what CAN messages to forward over the mavlink. This can be used to make CAN
/// forwarding work well on low bandwidth links. The filtering is applied on bits 8 to 24 of the CAN id
/// (2nd and 3rd bytes) which corresponds to the DroneCAN message ID for DroneCAN. Filters with more
/// than 16 IDs can be constructed by sending multiple CAN_FILTER_MODIFY messages.
export class CanFilterModify extends MavLinkData {
  public static readonly MSG_ID: int = 388
  public static readonly MSG_NAME: string = "CAN_FILTER_MODIFY"
  public static readonly PAYLOAD_LENGTH: int = 37
  public static readonly MAGIC_NUMBER: int = 8
  public static readonly INFO: MessageInfo = new MessageInfo(388, "CAN_FILTER_MODIFY", 37, 37, 8, [
    new MavLinkPacketField("ids", "ids", 0, false, 2, "uint16_t[]", "", 16),
    new MavLinkPacketField("target_system", "targetSystem", 32, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 33, false, 1, "uint8_t", ""),
    new MavLinkPacketField("bus", "bus", 34, false, 1, "uint8_t", ""),
    new MavLinkPacketField("operation", "operation", 35, false, 1, "uint8_t", ""),
    new MavLinkPacketField("num_ids", "numIds", 36, false, 1, "uint8_t", ""),
  ], (p) => CanFilterModify.decode(p))

  /// System ID.
  public targetSystem: u8 = 0

  /// Component ID.
  public targetComponent: u8 = 0

  /// bus number
  public bus: u8 = 0

  /// what operation to perform on the filter list. See CAN_FILTER_OP enum.
  /// Values: `CanFilterOp`.
  public operation: u8 = 0

  /// number of IDs in filter list
  public numIds: u8 = 0

  /// filter IDs, length num_ids
  public ids: u16[] = []

  /// A CAN_FILTER_MODIFY from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): CanFilterModify {
    const m = new CanFilterModify()
    for (let i = 0; i < 16; i++) {
      m.ids.push(readU16(payload, 0 + i * 2))
    }
    m.targetSystem = readU8(payload, 32)
    m.targetComponent = readU8(payload, 33)
    m.bus = readU8(payload, 34)
    m.operation = readU8(payload, 35)
    m.numIds = readU8(payload, 36)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    for (let i = 0; i < 16 && i < this.ids.length; i++) {
      writeUint(into, at + 0 + i * 2, 2, this.ids[i] as int)
    }
    writeUint(into, at + 32, 1, this.targetSystem as int)
    writeUint(into, at + 33, 1, this.targetComponent as int)
    writeUint(into, at + 34, 1, this.bus as int)
    writeUint(into, at + 35, 1, this.operation as int)
    writeUint(into, at + 36, 1, this.numIds as int)
  }

  public override info(): MessageInfo {
    CanFilterModify.INFO
  }
}

/// Cumulative distance traveled for each reported wheel.
export class WheelDistance extends MavLinkData {
  public static readonly MSG_ID: int = 9000
  public static readonly MSG_NAME: string = "WHEEL_DISTANCE"
  public static readonly PAYLOAD_LENGTH: int = 137
  public static readonly MAGIC_NUMBER: int = 113
  public static readonly INFO: MessageInfo = new MessageInfo(9000, "WHEEL_DISTANCE", 137, 137, 113, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("distance", "distance", 8, false, 8, "double[]", "m", 16),
    new MavLinkPacketField("count", "count", 136, false, 1, "uint8_t", ""),
  ], (p) => WheelDistance.decode(p))

  /// Timestamp (synced to UNIX time or since system boot).
  /// Units: us.
  public timeUsec: u64 = 0

  /// Number of wheels reported.
  public count: u8 = 0

  /// Distance reported by individual wheel encoders. Forward rotations increase values, reverse rotations
  /// decrease them. Not all wheels will necessarily have wheel encoders; the mapping of encoders to wheel
  /// positions must be agreed/understood by the endpoints.
  /// Units: m.
  public distance: f64[] = []

  /// A WHEEL_DISTANCE from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): WheelDistance {
    const m = new WheelDistance()
    m.timeUsec = readU64(payload, 0)
    for (let i = 0; i < 16; i++) {
      m.distance.push(readF64(payload, 8 + i * 8))
    }
    m.count = readU8(payload, 136)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    for (let i = 0; i < 16 && i < this.distance.length; i++) {
      writeF64(into, at + 8 + i * 8, this.distance[i])
    }
    writeUint(into, at + 136, 1, this.count as int)
  }

  public override info(): MessageInfo {
    WheelDistance.INFO
  }
}

/// Winch status.
export class WinchStatus extends MavLinkData {
  public static readonly MSG_ID: int = 9005
  public static readonly MSG_NAME: string = "WINCH_STATUS"
  public static readonly PAYLOAD_LENGTH: int = 34
  public static readonly MAGIC_NUMBER: int = 117
  public static readonly INFO: MessageInfo = new MessageInfo(9005, "WINCH_STATUS", 34, 34, 117, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("line_length", "lineLength", 8, false, 4, "float", "m"),
    new MavLinkPacketField("speed", "speed", 12, false, 4, "float", "m/s"),
    new MavLinkPacketField("tension", "tension", 16, false, 4, "float", "kg"),
    new MavLinkPacketField("voltage", "voltage", 20, false, 4, "float", "V"),
    new MavLinkPacketField("current", "current", 24, false, 4, "float", "A"),
    new MavLinkPacketField("status", "status", 28, false, 4, "uint32_t", ""),
    new MavLinkPacketField("temperature", "temperature", 32, false, 2, "int16_t", "degC"),
  ], (p) => WinchStatus.decode(p))

  /// Timestamp (synced to UNIX time or since system boot).
  /// Units: us.
  public timeUsec: u64 = 0

  /// Length of line released. NaN if unknown
  /// Units: m.
  public lineLength: f32 = 0.0

  /// Speed line is being released or retracted. Positive values if being released, negative values if
  /// being retracted, NaN if unknown
  /// Units: m/s.
  public speed: f32 = 0.0

  /// Tension on the line. NaN if unknown
  /// Units: kg.
  public tension: f32 = 0.0

  /// Voltage of the battery supplying the winch. NaN if unknown
  /// Units: V.
  public voltage: f32 = 0.0

  /// Current draw from the winch. NaN if unknown
  /// Units: A.
  public current: f32 = 0.0

  /// Temperature of the motor. INT16_MAX if unknown
  /// Units: degC.
  public temperature: i16 = 0

  /// Status flags
  /// Values: `MavWinchStatusFlag`.
  public status: u32 = 0

  /// A WINCH_STATUS from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): WinchStatus {
    const m = new WinchStatus()
    m.timeUsec = readU64(payload, 0)
    m.lineLength = readF32(payload, 8)
    m.speed = readF32(payload, 12)
    m.tension = readF32(payload, 16)
    m.voltage = readF32(payload, 20)
    m.current = readF32(payload, 24)
    m.status = readU32(payload, 28)
    m.temperature = readI16(payload, 32)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    writeF32(into, at + 8, this.lineLength)
    writeF32(into, at + 12, this.speed)
    writeF32(into, at + 16, this.tension)
    writeF32(into, at + 20, this.voltage)
    writeF32(into, at + 24, this.current)
    writeUint(into, at + 28, 4, this.status as int)
    writeUint(into, at + 32, 2, this.temperature as int)
  }

  public override info(): MessageInfo {
    WinchStatus.INFO
  }
}

/// Data for filling the OpenDroneID Basic ID message. This and the below messages are primarily meant
/// for feeding data to/from an OpenDroneID implementation. E.g.
/// https://github.com/opendroneid/opendroneid-core-c. These messages are compatible with the ASTM F3411
/// Remote ID standard and the ASD-STAN prEN 4709-002 Direct Remote ID standard. Additional information
/// and usage of these messages is documented at https://mavlink.io/en/services/opendroneid.html.
export class OpenDroneIdBasicId extends MavLinkData {
  public static readonly MSG_ID: int = 12900
  public static readonly MSG_NAME: string = "OPEN_DRONE_ID_BASIC_ID"
  public static readonly PAYLOAD_LENGTH: int = 44
  public static readonly MAGIC_NUMBER: int = 114
  public static readonly INFO: MessageInfo = new MessageInfo(12900, "OPEN_DRONE_ID_BASIC_ID", 44, 44, 114, [
    new MavLinkPacketField("target_system", "targetSystem", 0, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 1, false, 1, "uint8_t", ""),
    new MavLinkPacketField("id_or_mac", "idOrMac", 2, false, 1, "uint8_t[]", "", 20),
    new MavLinkPacketField("id_type", "idType", 22, false, 1, "uint8_t", ""),
    new MavLinkPacketField("ua_type", "uaType", 23, false, 1, "uint8_t", ""),
    new MavLinkPacketField("uas_id", "uasId", 24, false, 1, "uint8_t[]", "", 20),
  ], (p) => OpenDroneIdBasicId.decode(p))

  /// System ID (0 for broadcast).
  public targetSystem: u8 = 0

  /// Component ID (0 for broadcast).
  public targetComponent: u8 = 0

  /// Only used for drone ID data received from other UAs. See detailed description at
  /// https://mavlink.io/en/services/opendroneid.html.
  public idOrMac: u8[] = []

  /// Indicates the format for the uas_id field of this message.
  /// Values: `MavOdidIdType`.
  public idType: u8 = 0

  /// Indicates the type of UA (Unmanned Aircraft).
  /// Values: `MavOdidUaType`.
  public uaType: u8 = 0

  /// UAS (Unmanned Aircraft System) ID following the format specified by id_type. Shall be filled with
  /// nulls in the unused portion of the field.
  public uasId: u8[] = []

  /// A OPEN_DRONE_ID_BASIC_ID from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): OpenDroneIdBasicId {
    const m = new OpenDroneIdBasicId()
    m.targetSystem = readU8(payload, 0)
    m.targetComponent = readU8(payload, 1)
    for (let i = 0; i < 20; i++) {
      m.idOrMac.push(readU8(payload, 2 + i * 1))
    }
    m.idType = readU8(payload, 22)
    m.uaType = readU8(payload, 23)
    for (let i = 0; i < 20; i++) {
      m.uasId.push(readU8(payload, 24 + i * 1))
    }
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 1, this.targetSystem as int)
    writeUint(into, at + 1, 1, this.targetComponent as int)
    for (let i = 0; i < 20 && i < this.idOrMac.length; i++) {
      writeUint(into, at + 2 + i * 1, 1, this.idOrMac[i] as int)
    }
    writeUint(into, at + 22, 1, this.idType as int)
    writeUint(into, at + 23, 1, this.uaType as int)
    for (let i = 0; i < 20 && i < this.uasId.length; i++) {
      writeUint(into, at + 24 + i * 1, 1, this.uasId[i] as int)
    }
  }

  public override info(): MessageInfo {
    OpenDroneIdBasicId.INFO
  }
}

/// Data for filling the OpenDroneID Location message. The float data types are 32-bit IEEE 754. The
/// Location message provides the location, altitude, direction and speed of the aircraft.
export class OpenDroneIdLocation extends MavLinkData {
  public static readonly MSG_ID: int = 12901
  public static readonly MSG_NAME: string = "OPEN_DRONE_ID_LOCATION"
  public static readonly PAYLOAD_LENGTH: int = 59
  public static readonly MAGIC_NUMBER: int = 254
  public static readonly INFO: MessageInfo = new MessageInfo(12901, "OPEN_DRONE_ID_LOCATION", 59, 59, 254, [
    new MavLinkPacketField("latitude", "latitude", 0, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("longitude", "longitude", 4, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("altitude_barometric", "altitudeBarometric", 8, false, 4, "float", "m"),
    new MavLinkPacketField("altitude_geodetic", "altitudeGeodetic", 12, false, 4, "float", "m"),
    new MavLinkPacketField("height", "height", 16, false, 4, "float", "m"),
    new MavLinkPacketField("timestamp", "timestamp", 20, false, 4, "float", "s"),
    new MavLinkPacketField("direction", "direction", 24, false, 2, "uint16_t", "cdeg"),
    new MavLinkPacketField("speed_horizontal", "speedHorizontal", 26, false, 2, "uint16_t", "cm/s"),
    new MavLinkPacketField("speed_vertical", "speedVertical", 28, false, 2, "int16_t", "cm/s"),
    new MavLinkPacketField("target_system", "targetSystem", 30, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 31, false, 1, "uint8_t", ""),
    new MavLinkPacketField("id_or_mac", "idOrMac", 32, false, 1, "uint8_t[]", "", 20),
    new MavLinkPacketField("status", "status", 52, false, 1, "uint8_t", ""),
    new MavLinkPacketField("height_reference", "heightReference", 53, false, 1, "uint8_t", ""),
    new MavLinkPacketField("horizontal_accuracy", "horizontalAccuracy", 54, false, 1, "uint8_t", ""),
    new MavLinkPacketField("vertical_accuracy", "verticalAccuracy", 55, false, 1, "uint8_t", ""),
    new MavLinkPacketField("barometer_accuracy", "barometerAccuracy", 56, false, 1, "uint8_t", ""),
    new MavLinkPacketField("speed_accuracy", "speedAccuracy", 57, false, 1, "uint8_t", ""),
    new MavLinkPacketField("timestamp_accuracy", "timestampAccuracy", 58, false, 1, "uint8_t", ""),
  ], (p) => OpenDroneIdLocation.decode(p))

  /// System ID (0 for broadcast).
  public targetSystem: u8 = 0

  /// Component ID (0 for broadcast).
  public targetComponent: u8 = 0

  /// Only used for drone ID data received from other UAs. See detailed description at
  /// https://mavlink.io/en/services/opendroneid.html.
  public idOrMac: u8[] = []

  /// Indicates whether the unmanned aircraft is on the ground or in the air.
  /// Values: `MavOdidStatus`.
  public status: u8 = 0

  /// Direction over ground (not heading, but direction of movement) measured clockwise from true North: 0
  /// - 35999 centi-degrees. If unknown: 36100 centi-degrees.
  /// Units: cdeg.
  public direction: u16 = 0

  /// Ground speed. Positive only. If unknown: 25500 cm/s. If speed is larger than 25425 cm/s, use 25425
  /// cm/s.
  /// Units: cm/s.
  public speedHorizontal: u16 = 0

  /// The vertical speed. Up is positive. If unknown: 6300 cm/s. If speed is larger than 6200 cm/s, use
  /// 6200 cm/s. If lower than -6200 cm/s, use -6200 cm/s.
  /// Units: cm/s.
  public speedVertical: i16 = 0

  /// Current latitude of the unmanned aircraft. If unknown: 0 (both Lat/Lon).
  /// Units: degE7.
  public latitude: i32 = 0

  /// Current longitude of the unmanned aircraft. If unknown: 0 (both Lat/Lon).
  /// Units: degE7.
  public longitude: i32 = 0

  /// The altitude calculated from the barometric pressure. Reference is against 29.92inHg or 1013.2mb. If
  /// unknown: -1000 m.
  /// Units: m.
  public altitudeBarometric: f32 = 0.0

  /// The geodetic altitude as defined by WGS84. If unknown: -1000 m.
  /// Units: m.
  public altitudeGeodetic: f32 = 0.0

  /// Indicates the reference point for the height field.
  /// Values: `MavOdidHeightRef`.
  public heightReference: u8 = 0

  /// The current height of the unmanned aircraft above the take-off location or the ground as indicated
  /// by height_reference. If unknown: -1000 m.
  /// Units: m.
  public height: f32 = 0.0

  /// The accuracy of the horizontal position.
  /// Values: `MavOdidHorAcc`.
  public horizontalAccuracy: u8 = 0

  /// The accuracy of the vertical position.
  /// Values: `MavOdidVerAcc`.
  public verticalAccuracy: u8 = 0

  /// The accuracy of the barometric altitude.
  /// Values: `MavOdidVerAcc`.
  public barometerAccuracy: u8 = 0

  /// The accuracy of the horizontal and vertical speed.
  /// Values: `MavOdidSpeedAcc`.
  public speedAccuracy: u8 = 0

  /// Seconds after the full hour with reference to UTC time. Typically the GPS outputs a time-of-week
  /// value in milliseconds. First convert that to UTC and then convert for this field using ((float)
  /// (time_week_ms % (60*60*1000))) / 1000. If unknown: 0xFFFF.
  /// Units: s.
  public timestamp: f32 = 0.0

  /// The accuracy of the timestamps.
  /// Values: `MavOdidTimeAcc`.
  public timestampAccuracy: u8 = 0

  /// A OPEN_DRONE_ID_LOCATION from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): OpenDroneIdLocation {
    const m = new OpenDroneIdLocation()
    m.latitude = readI32(payload, 0)
    m.longitude = readI32(payload, 4)
    m.altitudeBarometric = readF32(payload, 8)
    m.altitudeGeodetic = readF32(payload, 12)
    m.height = readF32(payload, 16)
    m.timestamp = readF32(payload, 20)
    m.direction = readU16(payload, 24)
    m.speedHorizontal = readU16(payload, 26)
    m.speedVertical = readI16(payload, 28)
    m.targetSystem = readU8(payload, 30)
    m.targetComponent = readU8(payload, 31)
    for (let i = 0; i < 20; i++) {
      m.idOrMac.push(readU8(payload, 32 + i * 1))
    }
    m.status = readU8(payload, 52)
    m.heightReference = readU8(payload, 53)
    m.horizontalAccuracy = readU8(payload, 54)
    m.verticalAccuracy = readU8(payload, 55)
    m.barometerAccuracy = readU8(payload, 56)
    m.speedAccuracy = readU8(payload, 57)
    m.timestampAccuracy = readU8(payload, 58)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.latitude as int)
    writeUint(into, at + 4, 4, this.longitude as int)
    writeF32(into, at + 8, this.altitudeBarometric)
    writeF32(into, at + 12, this.altitudeGeodetic)
    writeF32(into, at + 16, this.height)
    writeF32(into, at + 20, this.timestamp)
    writeUint(into, at + 24, 2, this.direction as int)
    writeUint(into, at + 26, 2, this.speedHorizontal as int)
    writeUint(into, at + 28, 2, this.speedVertical as int)
    writeUint(into, at + 30, 1, this.targetSystem as int)
    writeUint(into, at + 31, 1, this.targetComponent as int)
    for (let i = 0; i < 20 && i < this.idOrMac.length; i++) {
      writeUint(into, at + 32 + i * 1, 1, this.idOrMac[i] as int)
    }
    writeUint(into, at + 52, 1, this.status as int)
