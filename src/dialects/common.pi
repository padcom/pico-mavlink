/// Reports measurement/estimate from a global position sensor. Used as navigation fusion source and
/// optionally displayed in the UI.
export class GlobalPositionSensor extends MavLinkData {
  public static readonly MSG_ID: int = 296
  public static readonly MSG_NAME: string = "GLOBAL_POSITION_SENSOR"
  public static readonly PAYLOAD_LENGTH: int = 41
  public static readonly MAGIC_NUMBER: int = 158
  public static readonly INFO: MessageInfo = new MessageInfo(296, "GLOBAL_POSITION_SENSOR", 41, 41, 158, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("processing_time", "processingTime", 8, false, 4, "uint32_t", "us"),
    new MavLinkPacketField("lat", "lat", 12, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("lon", "lon", 16, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("alt_ellipsoid", "altEllipsoid", 20, false, 4, "float", "m"),
    new MavLinkPacketField("alt", "alt", 24, false, 4, "float", "m"),
    new MavLinkPacketField("eph", "eph", 28, false, 4, "float", "m"),
    new MavLinkPacketField("epv", "epv", 32, false, 4, "float", "m"),
    new MavLinkPacketField("target_system", "targetSystem", 36, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 37, false, 1, "uint8_t", ""),
    new MavLinkPacketField("id", "id", 38, false, 1, "uint8_t", ""),
    new MavLinkPacketField("source", "source", 39, false, 1, "uint8_t", ""),
    new MavLinkPacketField("flags", "flags", 40, false, 1, "uint8_t", ""),
  ], (p) => GlobalPositionSensor.decode(p))

  /// System ID (ID of target system, normally autopilot and ground station).
  public targetSystem: u8 = 0

  /// Component ID (normally 0 for broadcast).
  public targetComponent: u8 = 0

  /// Sensor ID
  public id: u8 = 0

  /// Timestamp of message transmission (UNIX Epoch time or time since system boot). The receiving end can
  /// infer timestamp format (since 1.1.1970 or since system boot) by checking for the magnitude of the
  /// number.
  /// Units: us.
  public timeUsec: u64 = 0

  /// The time spent in processing the sensor data that is the basis for this position. The recipient can
  /// use this to improve time alignment of the data. This is the time between measurement (e.g. camera
  /// exposure time) and transmission of this message. Set to NaN if not known.
  /// Units: us.
  public processingTime: u32 = 0

  /// Source of position/estimate (such as GNSS, estimator, etc.)
  /// Values: `GlobalPositionSrc`.
  public source: u8 = 0

  /// Status flags
  /// Values: `GlobalPositionFlags`.
  public flags: u8 = 0

  /// Latitude (WGS84)
  /// Units: degE7.
  public lat: i32 = 0

  /// Longitude (WGS84)
  /// Units: degE7.
  public lon: i32 = 0

  /// Altitude (WGS84 elipsoid), preferred if available
  /// Units: m.
  public altEllipsoid: f32 = 0.0

  /// Altitude (MSL - position-system specific value) use if no alt_ellipsoid available
  /// Units: m.
  public alt: f32 = 0.0

  /// Standard deviation of horizontal position error
  /// Units: m.
  public eph: f32 = 0.0

  /// Standard deviation of vertical position error
  /// Units: m.
  public epv: f32 = 0.0

  /// A GLOBAL_POSITION_SENSOR from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): GlobalPositionSensor {
    const m = new GlobalPositionSensor()
    m.timeUsec = readU64(payload, 0)
    m.processingTime = readU32(payload, 8)
    m.lat = readI32(payload, 12)
    m.lon = readI32(payload, 16)
    m.altEllipsoid = readF32(payload, 20)
    m.alt = readF32(payload, 24)
    m.eph = readF32(payload, 28)
    m.epv = readF32(payload, 32)
    m.targetSystem = readU8(payload, 36)
    m.targetComponent = readU8(payload, 37)
    m.id = readU8(payload, 38)
    m.source = readU8(payload, 39)
    m.flags = readU8(payload, 40)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    writeUint(into, at + 8, 4, this.processingTime as int)
    writeUint(into, at + 12, 4, this.lat as int)
    writeUint(into, at + 16, 4, this.lon as int)
    writeF32(into, at + 20, this.altEllipsoid)
    writeF32(into, at + 24, this.alt)
    writeF32(into, at + 28, this.eph)
    writeF32(into, at + 32, this.epv)
    writeUint(into, at + 36, 1, this.targetSystem as int)
    writeUint(into, at + 37, 1, this.targetComponent as int)
    writeUint(into, at + 38, 1, this.id as int)
    writeUint(into, at + 39, 1, this.source as int)
    writeUint(into, at + 40, 1, this.flags as int)
  }

  public override info(): MessageInfo {
    GlobalPositionSensor.INFO
  }
}

