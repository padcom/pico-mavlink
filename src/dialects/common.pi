  public static readonly INFO: MessageInfo = new MessageInfo(246, "ADSB_VEHICLE", 38, 38, 184, [
    new MavLinkPacketField("ICAO_address", "ICAOAddress", 0, false, 4, "uint32_t", ""),
    new MavLinkPacketField("lat", "lat", 4, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("lon", "lon", 8, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("altitude", "altitude", 12, false, 4, "int32_t", "mm"),
    new MavLinkPacketField("heading", "heading", 16, false, 2, "uint16_t", "cdeg"),
    new MavLinkPacketField("hor_velocity", "horVelocity", 18, false, 2, "uint16_t", "cm/s"),
    new MavLinkPacketField("ver_velocity", "verVelocity", 20, false, 2, "int16_t", "cm/s"),
    new MavLinkPacketField("flags", "flags", 22, false, 2, "uint16_t", ""),
    new MavLinkPacketField("squawk", "squawk", 24, false, 2, "uint16_t", ""),
    new MavLinkPacketField("altitude_type", "altitudeType", 26, false, 1, "uint8_t", ""),
    new MavLinkPacketField("callsign", "callsign", 27, false, 1, "char[]", "", 9),
    new MavLinkPacketField("emitter_type", "emitterType", 36, false, 1, "uint8_t", ""),
    new MavLinkPacketField("tslc", "tslc", 37, false, 1, "uint8_t", "s"),
  ], (p) => AdsbVehicle.decode(p))

  /// ICAO address
  public ICAOAddress: u32 = 0

  /// Latitude
  /// Units: degE7.
  public lat: i32 = 0

  /// Longitude
  /// Units: degE7.
  public lon: i32 = 0

  /// ADSB altitude type.
  /// Values: `AdsbAltitudeType`.
  public altitudeType: u8 = 0

  /// Altitude(ASL)
  /// Units: mm.
  public altitude: i32 = 0

  /// Course over ground
  /// Units: cdeg.
  public heading: u16 = 0

  /// The horizontal velocity
  /// Units: cm/s.
  public horVelocity: u16 = 0

  /// The vertical velocity. Positive is up
  /// Units: cm/s.
  public verVelocity: i16 = 0

  /// The callsign, 8+null
  public callsign: string = ""

  /// ADSB emitter type.
  /// Values: `AdsbEmitterType`.
  public emitterType: u8 = 0

  /// Time since last communication in seconds
  /// Units: s.
  public tslc: u8 = 0

  /// Bitmap to indicate various statuses including valid data fields
  /// Values: `AdsbFlags`.
  public flags: u16 = 0

  /// Squawk code. Note that the code is in decimal: e.g. 7700 (general emergency) is encoded as binary
  /// 0b0001_1110_0001_0100, not(!) as 0b0000_111_111_000_000
  public squawk: u16 = 0

  /// A ADSB_VEHICLE from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): AdsbVehicle {
    const m = new AdsbVehicle()
    m.ICAOAddress = readU32(payload, 0)
    m.lat = readI32(payload, 4)
    m.lon = readI32(payload, 8)
    m.altitude = readI32(payload, 12)
    m.heading = readU16(payload, 16)
    m.horVelocity = readU16(payload, 18)
    m.verVelocity = readI16(payload, 20)
    m.flags = readU16(payload, 22)
    m.squawk = readU16(payload, 24)
    m.altitudeType = readU8(payload, 26)
    m.callsign = readChars(payload, 27, 9)
    m.emitterType = readU8(payload, 36)
    m.tslc = readU8(payload, 37)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.ICAOAddress as int)
    writeUint(into, at + 4, 4, this.lat as int)
    writeUint(into, at + 8, 4, this.lon as int)
    writeUint(into, at + 12, 4, this.altitude as int)
    writeUint(into, at + 16, 2, this.heading as int)
    writeUint(into, at + 18, 2, this.horVelocity as int)
    writeUint(into, at + 20, 2, this.verVelocity as int)
    writeUint(into, at + 22, 2, this.flags as int)
    writeUint(into, at + 24, 2, this.squawk as int)
    writeUint(into, at + 26, 1, this.altitudeType as int)
    writeChars(into, at + 27, 9, this.callsign)
    writeUint(into, at + 36, 1, this.emitterType as int)
    writeUint(into, at + 37, 1, this.tslc as int)
  }

  public override info(): MessageInfo {
    AdsbVehicle.INFO
  }
}

/// Information about a potential collision
export class Collision extends MavLinkData {
  public static readonly MSG_ID: int = 247
  public static readonly MSG_NAME: string = "COLLISION"
  public static readonly PAYLOAD_LENGTH: int = 19
  public static readonly MAGIC_NUMBER: int = 81
  public static readonly INFO: MessageInfo = new MessageInfo(247, "COLLISION", 19, 19, 81, [
    new MavLinkPacketField("id", "id", 0, false, 4, "uint32_t", ""),
    new MavLinkPacketField("time_to_minimum_delta", "timeToMinimumDelta", 4, false, 4, "float", "s"),
    new MavLinkPacketField("altitude_minimum_delta", "altitudeMinimumDelta", 8, false, 4, "float", "m"),
    new MavLinkPacketField("horizontal_minimum_delta", "horizontalMinimumDelta", 12, false, 4, "float", "m"),
    new MavLinkPacketField("src", "src", 16, false, 1, "uint8_t", ""),
    new MavLinkPacketField("action", "action", 17, false, 1, "uint8_t", ""),
    new MavLinkPacketField("threat_level", "threatLevel", 18, false, 1, "uint8_t", ""),
  ], (p) => Collision.decode(p))

  /// Collision data source
  /// Values: `MavCollisionSrc`.
  public src: u8 = 0

  /// Unique identifier, domain based on src field
  public id: u32 = 0

  /// Action that is being taken to avoid this collision
  /// Values: `MavCollisionAction`.
  public action: u8 = 0

  /// How concerned the aircraft is about this collision
  /// Values: `MavCollisionThreatLevel`.
  public threatLevel: u8 = 0

  /// Estimated time until collision occurs
  /// Units: s.
  public timeToMinimumDelta: f32 = 0.0

  /// Closest vertical distance between vehicle and object
  /// Units: m.
  public altitudeMinimumDelta: f32 = 0.0

  /// Closest horizontal distance between vehicle and object
  /// Units: m.
  public horizontalMinimumDelta: f32 = 0.0

  /// A COLLISION from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): Collision {
    const m = new Collision()
    m.id = readU32(payload, 0)
    m.timeToMinimumDelta = readF32(payload, 4)
    m.altitudeMinimumDelta = readF32(payload, 8)
    m.horizontalMinimumDelta = readF32(payload, 12)
    m.src = readU8(payload, 16)
    m.action = readU8(payload, 17)
    m.threatLevel = readU8(payload, 18)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.id as int)
    writeF32(into, at + 4, this.timeToMinimumDelta)
    writeF32(into, at + 8, this.altitudeMinimumDelta)
    writeF32(into, at + 12, this.horizontalMinimumDelta)
    writeUint(into, at + 16, 1, this.src as int)
    writeUint(into, at + 17, 1, this.action as int)
    writeUint(into, at + 18, 1, this.threatLevel as int)
  }

  public override info(): MessageInfo {
    Collision.INFO
  }
}

/// Message implementing parts of the V2 payload specs in V1 frames for transitional support.
export class V2Extension extends MavLinkData {
  public static readonly MSG_ID: int = 248
  public static readonly MSG_NAME: string = "V2_EXTENSION"
  public static readonly PAYLOAD_LENGTH: int = 254
  public static readonly MAGIC_NUMBER: int = 8
  public static readonly INFO: MessageInfo = new MessageInfo(248, "V2_EXTENSION", 254, 254, 8, [
    new MavLinkPacketField("message_type", "messageType", 0, false, 2, "uint16_t", ""),
    new MavLinkPacketField("target_network", "targetNetwork", 2, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_system", "targetSystem", 3, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 4, false, 1, "uint8_t", ""),
    new MavLinkPacketField("payload", "payload", 5, false, 1, "uint8_t[]", "", 249),
  ], (p) => V2Extension.decode(p))

  /// Network ID (0 for broadcast)
  public targetNetwork: u8 = 0

  /// System ID (0 for broadcast)
  public targetSystem: u8 = 0

  /// Component ID (0 for broadcast)
  public targetComponent: u8 = 0

  /// A code that identifies the software component that understands this message (analogous to USB device
  /// classes or mime type strings). If this code is less than 32768, it is considered a 'registered'
  /// protocol extension and the corresponding entry should be added to
  /// https://github.com/mavlink/mavlink/definition_files/extension_message_ids.xml. Software creators can
  /// register blocks of message IDs as needed (useful for GCS specific metadata, etc...). Message_types
  /// greater than 32767 are considered local experiments and should not be checked in to any widely
  /// distributed codebase.
  public messageType: u16 = 0

  /// Variable length payload. The length must be encoded in the payload as part of the message_type
  /// protocol, e.g. by including the length as payload data, or by terminating the payload data with a
  /// non-zero marker. This is required in order to reconstruct zero-terminated payloads that are (or
  /// otherwise would be) trimmed by MAVLink 2 empty-byte truncation. The entire content of the payload
  /// block is opaque unless you understand the encoding message_type. The particular encoding used can be
  /// extension specific and might not always be documented as part of the MAVLink specification.
  public payload: u8[] = []

  /// A V2_EXTENSION from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): V2Extension {
    const m = new V2Extension()
    m.messageType = readU16(payload, 0)
    m.targetNetwork = readU8(payload, 2)
    m.targetSystem = readU8(payload, 3)
    m.targetComponent = readU8(payload, 4)
    for (let i = 0; i < 249; i++) {
      m.payload.push(readU8(payload, 5 + i * 1))
    }
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 2, this.messageType as int)
    writeUint(into, at + 2, 1, this.targetNetwork as int)
    writeUint(into, at + 3, 1, this.targetSystem as int)
    writeUint(into, at + 4, 1, this.targetComponent as int)
    for (let i = 0; i < 249 && i < this.payload.length; i++) {
      writeUint(into, at + 5 + i * 1, 1, this.payload[i] as int)
    }
  }

  public override info(): MessageInfo {
    V2Extension.INFO
  }
}

/// Send raw controller memory. The use of this message is discouraged for normal packets, but a quite
/// efficient way for testing new messages and getting experimental debug output.
export class MemoryVect extends MavLinkData {
  public static readonly MSG_ID: int = 249
  public static readonly MSG_NAME: string = "MEMORY_VECT"
  public static readonly PAYLOAD_LENGTH: int = 36
  public static readonly MAGIC_NUMBER: int = 204
  public static readonly INFO: MessageInfo = new MessageInfo(249, "MEMORY_VECT", 36, 36, 204, [
    new MavLinkPacketField("address", "address", 0, false, 2, "uint16_t", ""),
    new MavLinkPacketField("ver", "ver", 2, false, 1, "uint8_t", ""),
    new MavLinkPacketField("type", "type", 3, false, 1, "uint8_t", ""),
    new MavLinkPacketField("value", "value", 4, false, 1, "int8_t[]", "", 32),
  ], (p) => MemoryVect.decode(p))

  /// Starting address of the debug variables
  public address: u16 = 0

  /// Version code of the type variable. 0=unknown, type ignored and assumed int16_t. 1=as below
  public ver: u8 = 0

  /// Type code of the memory variables. for ver = 1: 0=16 x int16_t, 1=16 x uint16_t, 2=16 x Q15, 3=16 x
  /// 1Q14
  public type: u8 = 0

  /// Memory contents at specified address
  public value: i8[] = []

  /// A MEMORY_VECT from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): MemoryVect {
    const m = new MemoryVect()
    m.address = readU16(payload, 0)
    m.ver = readU8(payload, 2)
    m.type = readU8(payload, 3)
    for (let i = 0; i < 32; i++) {
      m.value.push(readI8(payload, 4 + i * 1))
    }
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 2, this.address as int)
    writeUint(into, at + 2, 1, this.ver as int)
    writeUint(into, at + 3, 1, this.type as int)
    for (let i = 0; i < 32 && i < this.value.length; i++) {
      writeUint(into, at + 4 + i * 1, 1, this.value[i] as int)
    }
  }

  public override info(): MessageInfo {
    MemoryVect.INFO
  }
}

/// To debug something using a named 3D vector.
export class DebugVect extends MavLinkData {
  public static readonly MSG_ID: int = 250
  public static readonly MSG_NAME: string = "DEBUG_VECT"
  public static readonly PAYLOAD_LENGTH: int = 30
  public static readonly MAGIC_NUMBER: int = 49
  public static readonly INFO: MessageInfo = new MessageInfo(250, "DEBUG_VECT", 30, 30, 49, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("x", "x", 8, false, 4, "float", ""),
    new MavLinkPacketField("y", "y", 12, false, 4, "float", ""),
    new MavLinkPacketField("z", "z", 16, false, 4, "float", ""),
    new MavLinkPacketField("name", "name", 20, false, 1, "char[]", "", 10),
  ], (p) => DebugVect.decode(p))

  /// Name
  public name: string = ""

  /// Timestamp (UNIX Epoch time or time since system boot). The receiving end can infer timestamp format
  /// (since 1.1.1970 or since system boot) by checking for the magnitude of the number.
  /// Units: us.
  public timeUsec: u64 = 0

  /// x
  public x: f32 = 0.0

  /// y
  public y: f32 = 0.0

  /// z
  public z: f32 = 0.0

  /// A DEBUG_VECT from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): DebugVect {
    const m = new DebugVect()
    m.timeUsec = readU64(payload, 0)
    m.x = readF32(payload, 8)
    m.y = readF32(payload, 12)
    m.z = readF32(payload, 16)
    m.name = readChars(payload, 20, 10)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    writeF32(into, at + 8, this.x)
    writeF32(into, at + 12, this.y)
    writeF32(into, at + 16, this.z)
    writeChars(into, at + 20, 10, this.name)
  }

  public override info(): MessageInfo {
    DebugVect.INFO
  }
}

