    writeUint(into, at + 1, 1, this.targetComponent as int)
    for (let i = 0; i < 20 && i < this.idOrMac.length; i++) {
      writeUint(into, at + 2 + i * 1, 1, this.idOrMac[i] as int)
    }
    writeUint(into, at + 22, 1, this.singleMessageSize as int)
    writeUint(into, at + 23, 1, this.msgPackSize as int)
    for (let i = 0; i < 225 && i < this.messages.length; i++) {
      writeUint(into, at + 24 + i * 1, 1, this.messages[i] as int)
