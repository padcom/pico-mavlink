/// Manual (joystick) control message. This message represents movement axes and button using standard
/// joystick axes nomenclature. Unused axes can be disabled and buttons states are transmitted as
/// individual on/off bits of a bitmask. For more information see
/// https://mavlink.io/en/manual_control.html
export class ManualControl extends MavLinkData {
  public static readonly MSG_ID: int = 69
  public static readonly MSG_NAME: string = "MANUAL_CONTROL"
  public static readonly PAYLOAD_LENGTH: int = 30
  public static readonly MAGIC_NUMBER: int = 243
  public static readonly INFO: MessageInfo = new MessageInfo(69, "MANUAL_CONTROL", 30, 11, 243, [
    new MavLinkPacketField("x", "x", 0, false, 2, "int16_t", ""),
    new MavLinkPacketField("y", "y", 2, false, 2, "int16_t", ""),
    new MavLinkPacketField("z", "z", 4, false, 2, "int16_t", ""),
    new MavLinkPacketField("r", "r", 6, false, 2, "int16_t", ""),
    new MavLinkPacketField("buttons", "buttons", 8, false, 2, "uint16_t", ""),
    new MavLinkPacketField("target", "target", 10, false, 1, "uint8_t", ""),
    new MavLinkPacketField("buttons2", "buttons2", 11, true, 2, "uint16_t", ""),
    new MavLinkPacketField("enabled_extensions", "enabledExtensions", 13, true, 1, "uint8_t", ""),
    new MavLinkPacketField("s", "s", 14, true, 2, "int16_t", ""),
    new MavLinkPacketField("t", "t", 16, true, 2, "int16_t", ""),
    new MavLinkPacketField("aux1", "aux1", 18, true, 2, "int16_t", ""),
    new MavLinkPacketField("aux2", "aux2", 20, true, 2, "int16_t", ""),
    new MavLinkPacketField("aux3", "aux3", 22, true, 2, "int16_t", ""),
    new MavLinkPacketField("aux4", "aux4", 24, true, 2, "int16_t", ""),
    new MavLinkPacketField("aux5", "aux5", 26, true, 2, "int16_t", ""),
    new MavLinkPacketField("aux6", "aux6", 28, true, 2, "int16_t", ""),
  ], (p) => ManualControl.decode(p))

  /// The system to be controlled.
  public target: u8 = 0

  /// X-axis, normalized to the range [-1000,1000]. A value of INT16_MAX indicates that this axis is
  /// invalid. Generally corresponds to forward(1000)-backward(-1000) movement on a joystick and the pitch
  /// of a vehicle.
  public x: i16 = 0

  /// Y-axis, normalized to the range [-1000,1000]. A value of INT16_MAX indicates that this axis is
  /// invalid. Generally corresponds to left(-1000)-right(1000) movement on a joystick and the roll of a
  /// vehicle.
  public y: i16 = 0

  /// Z-axis, normalized to the range [-1000,1000]. A value of INT16_MAX indicates that this axis is
  /// invalid. Generally corresponds to a separate slider movement with maximum being 1000 and minimum
  /// being -1000 on a joystick and the thrust of a vehicle. Positive values are positive thrust, negative
  /// values are negative thrust.
  public z: i16 = 0

  /// R-axis, normalized to the range [-1000,1000]. A value of INT16_MAX indicates that this axis is
  /// invalid. Generally corresponds to a twisting of the joystick, with clockwise being 1000 and
  /// counter-clockwise being -1000, and the yaw of a vehicle.
  public r: i16 = 0

  /// A bitfield corresponding to the joystick buttons' 0-15 current state, 1 for pressed, 0 for released.
  /// The lowest bit corresponds to Button 1.
  public buttons: u16 = 0

  /// A bitfield corresponding to the joystick buttons' 16-31 current state, 1 for pressed, 0 for
  /// released. The lowest bit corresponds to Button 16.
  public buttons2: u16 = 0

  /// Set bits to 1 to indicate which of the following extension fields contain valid data: bit 0: pitch,
  /// bit 1: roll, bit 2: aux1, bit 3: aux2, bit 4: aux3, bit 5: aux4, bit 6: aux5, bit 7: aux6
  public enabledExtensions: u8 = 0

  /// Pitch-only-axis, normalized to the range [-1000,1000]. Generally corresponds to pitch on vehicles
  /// with additional degrees of freedom. Valid if bit 0 of enabled_extensions field is set. Set to 0 if
  /// invalid.
  public s: i16 = 0

  /// Roll-only-axis, normalized to the range [-1000,1000]. Generally corresponds to roll on vehicles with
  /// additional degrees of freedom. Valid if bit 1 of enabled_extensions field is set. Set to 0 if
  /// invalid.
  public t: i16 = 0

  /// Aux continuous input field 1. Normalized in the range [-1000,1000]. Purpose defined by recipient.
  /// Valid data if bit 2 of enabled_extensions field is set. 0 if bit 2 is unset.
  public aux1: i16 = 0

  /// Aux continuous input field 2. Normalized in the range [-1000,1000]. Purpose defined by recipient.
  /// Valid data if bit 3 of enabled_extensions field is set. 0 if bit 3 is unset.
  public aux2: i16 = 0

  /// Aux continuous input field 3. Normalized in the range [-1000,1000]. Purpose defined by recipient.
  /// Valid data if bit 4 of enabled_extensions field is set. 0 if bit 4 is unset.
  public aux3: i16 = 0

  /// Aux continuous input field 4. Normalized in the range [-1000,1000]. Purpose defined by recipient.
  /// Valid data if bit 5 of enabled_extensions field is set. 0 if bit 5 is unset.
  public aux4: i16 = 0

  /// Aux continuous input field 5. Normalized in the range [-1000,1000]. Purpose defined by recipient.
  /// Valid data if bit 6 of enabled_extensions field is set. 0 if bit 6 is unset.
  public aux5: i16 = 0

  /// Aux continuous input field 6. Normalized in the range [-1000,1000]. Purpose defined by recipient.
  /// Valid data if bit 7 of enabled_extensions field is set. 0 if bit 7 is unset.
  public aux6: i16 = 0

  /// A MANUAL_CONTROL from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): ManualControl {
    const m = new ManualControl()
    m.x = readI16(payload, 0)
    m.y = readI16(payload, 2)
    m.z = readI16(payload, 4)
    m.r = readI16(payload, 6)
    m.buttons = readU16(payload, 8)
    m.target = readU8(payload, 10)
    m.buttons2 = readU16(payload, 11)
    m.enabledExtensions = readU8(payload, 13)
    m.s = readI16(payload, 14)
    m.t = readI16(payload, 16)
    m.aux1 = readI16(payload, 18)
    m.aux2 = readI16(payload, 20)
    m.aux3 = readI16(payload, 22)
    m.aux4 = readI16(payload, 24)
    m.aux5 = readI16(payload, 26)
    m.aux6 = readI16(payload, 28)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 2, this.x as int)
    writeUint(into, at + 2, 2, this.y as int)
    writeUint(into, at + 4, 2, this.z as int)
    writeUint(into, at + 6, 2, this.r as int)
    writeUint(into, at + 8, 2, this.buttons as int)
    writeUint(into, at + 10, 1, this.target as int)
    writeUint(into, at + 11, 2, this.buttons2 as int)
    writeUint(into, at + 13, 1, this.enabledExtensions as int)
    writeUint(into, at + 14, 2, this.s as int)
    writeUint(into, at + 16, 2, this.t as int)
    writeUint(into, at + 18, 2, this.aux1 as int)
    writeUint(into, at + 20, 2, this.aux2 as int)
    writeUint(into, at + 22, 2, this.aux3 as int)
    writeUint(into, at + 24, 2, this.aux4 as int)
    writeUint(into, at + 26, 2, this.aux5 as int)
    writeUint(into, at + 28, 2, this.aux6 as int)
  }

  public override info(): MessageInfo {
    ManualControl.INFO
  }
