    m.vibrationY = readF32(payload, 12)
    m.vibrationZ = readF32(payload, 16)
    m.clipping0 = readU32(payload, 20)
    m.clipping1 = readU32(payload, 24)
    m.clipping2 = readU32(payload, 28)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
