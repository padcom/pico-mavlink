/// Request a partial list of mission items from the system/component.
/// https://mavlink.io/en/services/mission.html. If start and end index are the same, just send one
/// waypoint.
export class MissionRequestPartialList extends MavLinkData {
  public static readonly MSG_ID: int = 37
  public static readonly MSG_NAME: string = "MISSION_REQUEST_PARTIAL_LIST"
  public static readonly PAYLOAD_LENGTH: int = 7
  public static readonly MAGIC_NUMBER: int = 212
  public static readonly INFO: MessageInfo = new MessageInfo(37, "MISSION_REQUEST_PARTIAL_LIST", 7, 6, 212, [
    new MavLinkPacketField("start_index", "startIndex", 0, false, 2, "int16_t", ""),
    new MavLinkPacketField("end_index", "endIndex", 2, false, 2, "int16_t", ""),
    new MavLinkPacketField("target_system", "targetSystem", 4, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 5, false, 1, "uint8_t", ""),
    new MavLinkPacketField("mission_type", "missionType", 6, true, 1, "uint8_t", ""),
  ], (p) => MissionRequestPartialList.decode(p))

  /// System ID
  public targetSystem: u8 = 0

  /// Component ID
  public targetComponent: u8 = 0

  /// Start index
  public startIndex: i16 = 0

  /// End index, -1 by default (-1: send list to end). Else a valid index of the list
  public endIndex: i16 = 0

  /// Mission type.
  /// Values: `MavMissionType`.
  public missionType: u8 = 0

  /// A MISSION_REQUEST_PARTIAL_LIST from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): MissionRequestPartialList {
    const m = new MissionRequestPartialList()
    m.startIndex = readI16(payload, 0)
    m.endIndex = readI16(payload, 2)
    m.targetSystem = readU8(payload, 4)
    m.targetComponent = readU8(payload, 5)
    m.missionType = readU8(payload, 6)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 2, this.startIndex as int)
    writeUint(into, at + 2, 2, this.endIndex as int)
    writeUint(into, at + 4, 1, this.targetSystem as int)
    writeUint(into, at + 5, 1, this.targetComponent as int)
    writeUint(into, at + 6, 1, this.missionType as int)
  }

  public override info(): MessageInfo {
    MissionRequestPartialList.INFO
  }
}

/// This message is sent to the MAV to write a partial list. If start index == end index, only one item
/// will be transmitted / updated. If the start index is NOT 0 and above the current list size, this
/// request should be REJECTED!
export class MissionWritePartialList extends MavLinkData {
  public static readonly MSG_ID: int = 38
  public static readonly MSG_NAME: string = "MISSION_WRITE_PARTIAL_LIST"
  public static readonly PAYLOAD_LENGTH: int = 7
  public static readonly MAGIC_NUMBER: int = 9
