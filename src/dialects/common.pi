/// Information about the field of view of a camera. Can be requested with a MAV_CMD_REQUEST_MESSAGE
/// command.
export class CameraFovStatus extends MavLinkData {
  public static readonly MSG_ID: int = 271
  public static readonly MSG_NAME: string = "CAMERA_FOV_STATUS"
  public static readonly PAYLOAD_LENGTH: int = 53
  public static readonly MAGIC_NUMBER: int = 22
  public static readonly INFO: MessageInfo = new MessageInfo(271, "CAMERA_FOV_STATUS", 53, 52, 22, [
    new MavLinkPacketField("time_boot_ms", "timeBootMs", 0, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("lat_camera", "latCamera", 4, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("lon_camera", "lonCamera", 8, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("alt_camera", "altCamera", 12, false, 4, "int32_t", "mm"),
    new MavLinkPacketField("lat_image", "latImage", 16, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("lon_image", "lonImage", 20, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("alt_image", "altImage", 24, false, 4, "int32_t", "mm"),
    new MavLinkPacketField("q", "q", 28, false, 4, "float[]", "", 4),
    new MavLinkPacketField("hfov", "hfov", 44, false, 4, "float", "deg"),
    new MavLinkPacketField("vfov", "vfov", 48, false, 4, "float", "deg"),
    new MavLinkPacketField("camera_device_id", "cameraDeviceId", 52, true, 1, "uint8_t", ""),
  ], (p) => CameraFovStatus.decode(p))

  /// Timestamp (time since system boot).
  /// Units: ms.
  public timeBootMs: u32 = 0

  /// Latitude of camera (INT32_MAX if unknown).
  /// Units: degE7.
  public latCamera: i32 = 0

  /// Longitude of camera (INT32_MAX if unknown).
  /// Units: degE7.
  public lonCamera: i32 = 0

  /// Altitude (MSL) of camera (INT32_MAX if unknown).
  /// Units: mm.
  public altCamera: i32 = 0

  /// Latitude of center of image (INT32_MAX if unknown, INT32_MIN if at infinity, not intersecting with
  /// horizon).
  /// Units: degE7.
  public latImage: i32 = 0

  /// Longitude of center of image (INT32_MAX if unknown, INT32_MIN if at infinity, not intersecting with
  /// horizon).
  /// Units: degE7.
  public lonImage: i32 = 0

  /// Altitude (MSL) of center of image (INT32_MAX if unknown, INT32_MIN if at infinity, not intersecting
  /// with horizon).
  /// Units: mm.
  public altImage: i32 = 0

  /// Quaternion of camera orientation (w, x, y, z order, zero-rotation is 1, 0, 0, 0)
  public q: f32[] = []

  /// Horizontal field of view (NaN if unknown).
  /// Units: deg.
  public hfov: f32 = 0.0

  /// Vertical field of view (NaN if unknown).
  /// Units: deg.
  public vfov: f32 = 0.0

  /// Camera id of a non-MAVLink camera attached to an autopilot (1-6). 0 if the component is a MAVLink
  /// camera (with its own component id).
  public cameraDeviceId: u8 = 0

  /// A CAMERA_FOV_STATUS from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): CameraFovStatus {
    const m = new CameraFovStatus()
    m.timeBootMs = readU32(payload, 0)
    m.latCamera = readI32(payload, 4)
    m.lonCamera = readI32(payload, 8)
    m.altCamera = readI32(payload, 12)
    m.latImage = readI32(payload, 16)
    m.lonImage = readI32(payload, 20)
    m.altImage = readI32(payload, 24)
    for (let i = 0; i < 4; i++) {
      m.q.push(readF32(payload, 28 + i * 4))
    }
    m.hfov = readF32(payload, 44)
    m.vfov = readF32(payload, 48)
    m.cameraDeviceId = readU8(payload, 52)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.timeBootMs as int)
    writeUint(into, at + 4, 4, this.latCamera as int)
    writeUint(into, at + 8, 4, this.lonCamera as int)
    writeUint(into, at + 12, 4, this.altCamera as int)
    writeUint(into, at + 16, 4, this.latImage as int)
    writeUint(into, at + 20, 4, this.lonImage as int)
    writeUint(into, at + 24, 4, this.altImage as int)
    for (let i = 0; i < 4 && i < this.q.length; i++) {
      writeF32(into, at + 28 + i * 4, this.q[i])
    }
    writeF32(into, at + 44, this.hfov)
    writeF32(into, at + 48, this.vfov)
    writeUint(into, at + 52, 1, this.cameraDeviceId as int)
  }

  public override info(): MessageInfo {
    CameraFovStatus.INFO
  }
}

