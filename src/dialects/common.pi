/// Report current used cellular network status
export class CellularStatus extends MavLinkData {
  public static readonly MSG_ID: int = 334
  public static readonly MSG_NAME: string = "CELLULAR_STATUS"
  public static readonly PAYLOAD_LENGTH: int = 10
  public static readonly MAGIC_NUMBER: int = 72
  public static readonly INFO: MessageInfo = new MessageInfo(334, "CELLULAR_STATUS", 10, 10, 72, [
    new MavLinkPacketField("mcc", "mcc", 0, false, 2, "uint16_t", ""),
    new MavLinkPacketField("mnc", "mnc", 2, false, 2, "uint16_t", ""),
    new MavLinkPacketField("lac", "lac", 4, false, 2, "uint16_t", ""),
    new MavLinkPacketField("status", "status", 6, false, 1, "uint8_t", ""),
    new MavLinkPacketField("failure_reason", "failureReason", 7, false, 1, "uint8_t", ""),
    new MavLinkPacketField("type", "type", 8, false, 1, "uint8_t", ""),
    new MavLinkPacketField("quality", "quality", 9, false, 1, "uint8_t", ""),
  ], (p) => CellularStatus.decode(p))

  /// Cellular modem status
  /// Values: `CellularStatusFlag`.
  public status: u8 = 0

  /// Failure reason when status in in CELLULAR_STATUS_FLAG_FAILED
  /// Values: `CellularNetworkFailedReason`.
  public failureReason: u8 = 0

  /// Cellular network radio type: gsm, cdma, lte...
  /// Values: `CellularNetworkRadioType`.
  public type: u8 = 0

  /// Signal quality in percent. If unknown, set to UINT8_MAX
  public quality: u8 = 0

  /// Mobile country code. If unknown, set to UINT16_MAX
  public mcc: u16 = 0

  /// Mobile network code. If unknown, set to UINT16_MAX
  public mnc: u16 = 0

  /// Location area code. If unknown, set to 0
  public lac: u16 = 0

  /// A CELLULAR_STATUS from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): CellularStatus {
    const m = new CellularStatus()
    m.mcc = readU16(payload, 0)
    m.mnc = readU16(payload, 2)
    m.lac = readU16(payload, 4)
    m.status = readU8(payload, 6)
    m.failureReason = readU8(payload, 7)
    m.type = readU8(payload, 8)
    m.quality = readU8(payload, 9)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 2, this.mcc as int)
    writeUint(into, at + 2, 2, this.mnc as int)
    writeUint(into, at + 4, 2, this.lac as int)
    writeUint(into, at + 6, 1, this.status as int)
    writeUint(into, at + 7, 1, this.failureReason as int)
    writeUint(into, at + 8, 1, this.type as int)
    writeUint(into, at + 9, 1, this.quality as int)
  }

  public override info(): MessageInfo {
    CellularStatus.INFO
  }
}

/// Status of the Iridium SBD link.
export class IsbdLinkStatus extends MavLinkData {
  public static readonly MSG_ID: int = 335
  public static readonly MSG_NAME: string = "ISBD_LINK_STATUS"
  public static readonly PAYLOAD_LENGTH: int = 24
  public static readonly MAGIC_NUMBER: int = 225
  public static readonly INFO: MessageInfo = new MessageInfo(335, "ISBD_LINK_STATUS", 24, 24, 225, [
    new MavLinkPacketField("timestamp", "timestamp", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("last_heartbeat", "lastHeartbeat", 8, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("failed_sessions", "failedSessions", 16, false, 2, "uint16_t", ""),
    new MavLinkPacketField("successful_sessions", "successfulSessions", 18, false, 2, "uint16_t", ""),
    new MavLinkPacketField("signal_quality", "signalQuality", 20, false, 1, "uint8_t", ""),
    new MavLinkPacketField("ring_pending", "ringPending", 21, false, 1, "uint8_t", ""),
    new MavLinkPacketField("tx_session_pending", "txSessionPending", 22, false, 1, "uint8_t", ""),
    new MavLinkPacketField("rx_session_pending", "rxSessionPending", 23, false, 1, "uint8_t", ""),
  ], (p) => IsbdLinkStatus.decode(p))

  /// Timestamp (UNIX Epoch time or time since system boot). The receiving end can infer timestamp format
  /// (since 1.1.1970 or since system boot) by checking for the magnitude of the number.
  /// Units: us.
  public timestamp: u64 = 0

  /// Timestamp of the last successful sbd session. The receiving end can infer timestamp format (since
  /// 1.1.1970 or since system boot) by checking for the magnitude of the number.
  /// Units: us.
  public lastHeartbeat: u64 = 0

  /// Number of failed SBD sessions.
  public failedSessions: u16 = 0

  /// Number of successful SBD sessions.
  public successfulSessions: u16 = 0

  /// Signal quality equal to the number of bars displayed on the ISU signal strength indicator. Range is
  /// 0 to 5, where 0 indicates no signal and 5 indicates maximum signal strength.
  public signalQuality: u8 = 0

  /// 1: Ring call pending, 0: No call pending.
  public ringPending: u8 = 0

  /// 1: Transmission session pending, 0: No transmission session pending.
  public txSessionPending: u8 = 0

  /// 1: Receiving session pending, 0: No receiving session pending.
  public rxSessionPending: u8 = 0

  /// A ISBD_LINK_STATUS from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): IsbdLinkStatus {
    const m = new IsbdLinkStatus()
    m.timestamp = readU64(payload, 0)
    m.lastHeartbeat = readU64(payload, 8)
    m.failedSessions = readU16(payload, 16)
    m.successfulSessions = readU16(payload, 18)
    m.signalQuality = readU8(payload, 20)
    m.ringPending = readU8(payload, 21)
    m.txSessionPending = readU8(payload, 22)
    m.rxSessionPending = readU8(payload, 23)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timestamp)
    writeU64(into, at + 8, this.lastHeartbeat)
    writeUint(into, at + 16, 2, this.failedSessions as int)
    writeUint(into, at + 18, 2, this.successfulSessions as int)
    writeUint(into, at + 20, 1, this.signalQuality as int)
    writeUint(into, at + 21, 1, this.ringPending as int)
    writeUint(into, at + 22, 1, this.txSessionPending as int)
    writeUint(into, at + 23, 1, this.rxSessionPending as int)
  }

  public override info(): MessageInfo {
    IsbdLinkStatus.INFO
  }
}

/// Configure cellular modems. This message is re-emitted as an acknowledgement by the modem. The
/// message may also be explicitly requested using MAV_CMD_REQUEST_MESSAGE.
export class CellularConfig extends MavLinkData {
  public static readonly MSG_ID: int = 336
  public static readonly MSG_NAME: string = "CELLULAR_CONFIG"
  public static readonly PAYLOAD_LENGTH: int = 84
  public static readonly MAGIC_NUMBER: int = 245
  public static readonly INFO: MessageInfo = new MessageInfo(336, "CELLULAR_CONFIG", 84, 84, 245, [
    new MavLinkPacketField("enable_lte", "enableLte", 0, false, 1, "uint8_t", ""),
    new MavLinkPacketField("enable_pin", "enablePin", 1, false, 1, "uint8_t", ""),
    new MavLinkPacketField("pin", "pin", 2, false, 1, "char[]", "", 16),
    new MavLinkPacketField("new_pin", "newPin", 18, false, 1, "char[]", "", 16),
    new MavLinkPacketField("apn", "apn", 34, false, 1, "char[]", "", 32),
    new MavLinkPacketField("puk", "puk", 66, false, 1, "char[]", "", 16),
    new MavLinkPacketField("roaming", "roaming", 82, false, 1, "uint8_t", ""),
    new MavLinkPacketField("response", "response", 83, false, 1, "uint8_t", ""),
  ], (p) => CellularConfig.decode(p))

  /// Enable/disable LTE. 0: setting unchanged, 1: disabled, 2: enabled. Current setting when sent back as
  /// a response.
  public enableLte: u8 = 0

  /// Enable/disable PIN on the SIM card. 0: setting unchanged, 1: disabled, 2: enabled. Current setting
  /// when sent back as a response.
  public enablePin: u8 = 0

  /// PIN sent to the SIM card. Blank when PIN is disabled. Empty when message is sent back as a response.
  public pin: string = ""

  /// New PIN when changing the PIN. Blank to leave it unchanged. Empty when message is sent back as a
  /// response.
  public newPin: string = ""

  /// Name of the cellular APN. Blank to leave it unchanged. Current APN when sent back as a response.
  public apn: string = ""

  /// Required PUK code in case the user failed to authenticate 3 times with the PIN. Empty when message
  /// is sent back as a response.
  public puk: string = ""

  /// Enable/disable roaming. 0: setting unchanged, 1: disabled, 2: enabled. Current setting when sent
  /// back as a response.
  public roaming: u8 = 0

  /// Message acceptance response (sent back to GS).
  /// Values: `CellularConfigResponse`.
  public response: u8 = 0

  /// A CELLULAR_CONFIG from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): CellularConfig {
    const m = new CellularConfig()
    m.enableLte = readU8(payload, 0)
    m.enablePin = readU8(payload, 1)
    m.pin = readChars(payload, 2, 16)
    m.newPin = readChars(payload, 18, 16)
    m.apn = readChars(payload, 34, 32)
    m.puk = readChars(payload, 66, 16)
    m.roaming = readU8(payload, 82)
    m.response = readU8(payload, 83)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 1, this.enableLte as int)
    writeUint(into, at + 1, 1, this.enablePin as int)
    writeChars(into, at + 2, 16, this.pin)
    writeChars(into, at + 18, 16, this.newPin)
    writeChars(into, at + 34, 32, this.apn)
    writeChars(into, at + 66, 16, this.puk)
    writeUint(into, at + 82, 1, this.roaming as int)
    writeUint(into, at + 83, 1, this.response as int)
  }

  public override info(): MessageInfo {
    CellularConfig.INFO
  }
}

/// RPM sensor data message.
export class RawRpm extends MavLinkData {
  public static readonly MSG_ID: int = 339
  public static readonly MSG_NAME: string = "RAW_RPM"
