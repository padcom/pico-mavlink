  /// Camera has separate Video and Image/Photo modes (MAV_CMD_SET_CAMERA_MODE)
  public static readonly HAS_MODES: int = 4

  /// Camera can capture images while in video mode
  public static readonly CAN_CAPTURE_IMAGE_IN_VIDEO_MODE: int = 8

  /// Camera can capture videos while in Photo/Image mode
  public static readonly CAN_CAPTURE_VIDEO_IN_IMAGE_MODE: int = 16

  /// Camera has image survey mode (MAV_CMD_SET_CAMERA_MODE)
  public static readonly HAS_IMAGE_SURVEY_MODE: int = 32

  /// Camera has basic zoom control (MAV_CMD_SET_CAMERA_ZOOM)
  public static readonly HAS_BASIC_ZOOM: int = 64

  /// Camera has basic focus control (MAV_CMD_SET_CAMERA_FOCUS)
  public static readonly HAS_BASIC_FOCUS: int = 128

  /// Camera has video streaming capabilities (request VIDEO_STREAM_INFORMATION with
