/// The global position, as returned by the Global Positioning System (GPS). This is NOT the global
/// position estimate of the system, but rather a RAW sensor value. See message GLOBAL_POSITION_INT for
/// the global position estimate.
export class GpsRawInt extends MavLinkData {
  public static readonly MSG_ID: int = 24
  public static readonly MSG_NAME: string = "GPS_RAW_INT"
  public static readonly PAYLOAD_LENGTH: int = 52
  public static readonly MAGIC_NUMBER: int = 24
  public static readonly INFO: MessageInfo = new MessageInfo(24, "GPS_RAW_INT", 52, 30, 24, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("lat", "lat", 8, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("lon", "lon", 12, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("alt", "alt", 16, false, 4, "int32_t", "mm"),
    new MavLinkPacketField("eph", "eph", 20, false, 2, "uint16_t", ""),
    new MavLinkPacketField("epv", "epv", 22, false, 2, "uint16_t", ""),
    new MavLinkPacketField("vel", "vel", 24, false, 2, "uint16_t", "cm/s"),
    new MavLinkPacketField("cog", "cog", 26, false, 2, "uint16_t", "cdeg"),
    new MavLinkPacketField("fix_type", "fixType", 28, false, 1, "uint8_t", ""),
    new MavLinkPacketField("satellites_visible", "satellitesVisible", 29, false, 1, "uint8_t", ""),
    new MavLinkPacketField("alt_ellipsoid", "altEllipsoid", 30, true, 4, "int32_t", "mm"),
    new MavLinkPacketField("h_acc", "hAcc", 34, true, 4, "uint32_t", "mm"),
    new MavLinkPacketField("v_acc", "vAcc", 38, true, 4, "uint32_t", "mm"),
    new MavLinkPacketField("vel_acc", "velAcc", 42, true, 4, "uint32_t", "mm/s"),
    new MavLinkPacketField("hdg_acc", "hdgAcc", 46, true, 4, "uint32_t", "degE5"),
    new MavLinkPacketField("yaw", "yaw", 50, true, 2, "uint16_t", "cdeg"),
  ], (p) => GpsRawInt.decode(p))

  /// Timestamp (UNIX Epoch time or time since system boot). The receiving end can infer timestamp format
  /// (since 1.1.1970 or since system boot) by checking for the magnitude of the number.
  /// Units: us.
  public timeUsec: u64 = 0

  /// GPS fix type.
  /// Values: `GpsFixType`.
  public fixType: u8 = 0

  /// Latitude (WGS84, EGM96 ellipsoid)
  /// Units: degE7.
  public lat: i32 = 0

  /// Longitude (WGS84, EGM96 ellipsoid)
  /// Units: degE7.
  public lon: i32 = 0

  /// Altitude (MSL). Positive for up. Note that virtually all GPS modules provide the MSL altitude in
  /// addition to the WGS84 altitude.
  /// Units: mm.
  public alt: i32 = 0

  /// GPS HDOP horizontal dilution of position (unitless * 100). If unknown, set to: UINT16_MAX
  public eph: u16 = 0

  /// GPS VDOP vertical dilution of position (unitless * 100). If unknown, set to: UINT16_MAX
  public epv: u16 = 0

  /// GPS ground speed. If unknown, set to: UINT16_MAX
  /// Units: cm/s.
  public vel: u16 = 0

  /// Course over ground (NOT heading, but direction of movement) in degrees * 100, 0.0..359.99 degrees.
  /// If unknown, set to: UINT16_MAX
  /// Units: cdeg.
  public cog: u16 = 0

  /// Number of satellites visible. If unknown, set to UINT8_MAX
  public satellitesVisible: u8 = 0

  /// Altitude (above WGS84, EGM96 ellipsoid). Positive for up.
  /// Units: mm.
  public altEllipsoid: i32 = 0

  /// Position uncertainty.
  /// Units: mm.
  public hAcc: u32 = 0

  /// Altitude uncertainty.
  /// Units: mm.
  public vAcc: u32 = 0

  /// Speed uncertainty.
  /// Units: mm/s.
  public velAcc: u32 = 0

  /// Heading / track uncertainty
  /// Units: degE5.
  public hdgAcc: u32 = 0

  /// Yaw in earth frame from north. Use 0 if this GPS does not provide yaw. Use UINT16_MAX if this GPS is
  /// configured to provide yaw and is currently unable to provide it. Use 36000 for north.
  /// Units: cdeg.
  public yaw: u16 = 0

  /// A GPS_RAW_INT from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): GpsRawInt {
    const m = new GpsRawInt()
    m.timeUsec = readU64(payload, 0)
    m.lat = readI32(payload, 8)
    m.lon = readI32(payload, 12)
    m.alt = readI32(payload, 16)
    m.eph = readU16(payload, 20)
    m.epv = readU16(payload, 22)
    m.vel = readU16(payload, 24)
    m.cog = readU16(payload, 26)
    m.fixType = readU8(payload, 28)
    m.satellitesVisible = readU8(payload, 29)
    m.altEllipsoid = readI32(payload, 30)
    m.hAcc = readU32(payload, 34)
    m.vAcc = readU32(payload, 38)
    m.velAcc = readU32(payload, 42)
    m.hdgAcc = readU32(payload, 46)
    m.yaw = readU16(payload, 50)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    writeUint(into, at + 8, 4, this.lat as int)
    writeUint(into, at + 12, 4, this.lon as int)
    writeUint(into, at + 16, 4, this.alt as int)
    writeUint(into, at + 20, 2, this.eph as int)
    writeUint(into, at + 22, 2, this.epv as int)
    writeUint(into, at + 24, 2, this.vel as int)
    writeUint(into, at + 26, 2, this.cog as int)
    writeUint(into, at + 28, 1, this.fixType as int)
    writeUint(into, at + 29, 1, this.satellitesVisible as int)
    writeUint(into, at + 30, 4, this.altEllipsoid as int)
    writeUint(into, at + 34, 4, this.hAcc as int)
    writeUint(into, at + 38, 4, this.vAcc as int)
    writeUint(into, at + 42, 4, this.velAcc as int)
    writeUint(into, at + 46, 4, this.hdgAcc as int)
    writeUint(into, at + 50, 2, this.yaw as int)
  }

  public override info(): MessageInfo {
    GpsRawInt.INFO
  }
}

/// The positioning status, as reported by GPS. This message is intended to display status information
/// about each satellite visible to the receiver. See message GLOBAL_POSITION_INT for the global
/// position estimate. This message can contain information for up to 20 satellites.
export class GpsStatus extends MavLinkData {
  public static readonly MSG_ID: int = 25
  public static readonly MSG_NAME: string = "GPS_STATUS"
  public static readonly PAYLOAD_LENGTH: int = 101
  public static readonly MAGIC_NUMBER: int = 23
  public static readonly INFO: MessageInfo = new MessageInfo(25, "GPS_STATUS", 101, 101, 23, [
    new MavLinkPacketField("satellites_visible", "satellitesVisible", 0, false, 1, "uint8_t", ""),
    new MavLinkPacketField("satellite_prn", "satellitePrn", 1, false, 1, "uint8_t[]", "", 20),
    new MavLinkPacketField("satellite_used", "satelliteUsed", 21, false, 1, "uint8_t[]", "", 20),
    new MavLinkPacketField("satellite_elevation", "satelliteElevation", 41, false, 1, "uint8_t[]", "deg", 20),
    new MavLinkPacketField("satellite_azimuth", "satelliteAzimuth", 61, false, 1, "uint8_t[]", "deg", 20),
    new MavLinkPacketField("satellite_snr", "satelliteSnr", 81, false, 1, "uint8_t[]", "dB", 20),
  ], (p) => GpsStatus.decode(p))

  /// Number of satellites visible
  public satellitesVisible: u8 = 0

  /// Global satellite ID
  public satellitePrn: u8[] = []

  /// 0: Satellite not used, 1: used for localization
  public satelliteUsed: u8[] = []

  /// Elevation (0: right on top of receiver, 90: on the horizon) of satellite
  /// Units: deg.
  public satelliteElevation: u8[] = []

  /// Direction of satellite, 0: 0 deg, 255: 360 deg.
  /// Units: deg.
  public satelliteAzimuth: u8[] = []

  /// Signal to noise ratio of satellite
  /// Units: dB.
  public satelliteSnr: u8[] = []

  /// A GPS_STATUS from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): GpsStatus {
    const m = new GpsStatus()
    m.satellitesVisible = readU8(payload, 0)
    for (let i = 0; i < 20; i++) {
      m.satellitePrn.push(readU8(payload, 1 + i * 1))
    }
    for (let i = 0; i < 20; i++) {
      m.satelliteUsed.push(readU8(payload, 21 + i * 1))
    }
    for (let i = 0; i < 20; i++) {
      m.satelliteElevation.push(readU8(payload, 41 + i * 1))
    }
    for (let i = 0; i < 20; i++) {
      m.satelliteAzimuth.push(readU8(payload, 61 + i * 1))
    }
    for (let i = 0; i < 20; i++) {
      m.satelliteSnr.push(readU8(payload, 81 + i * 1))
    }
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 1, this.satellitesVisible as int)
    for (let i = 0; i < 20 && i < this.satellitePrn.length; i++) {
      writeUint(into, at + 1 + i * 1, 1, this.satellitePrn[i] as int)
    }
    for (let i = 0; i < 20 && i < this.satelliteUsed.length; i++) {
      writeUint(into, at + 21 + i * 1, 1, this.satelliteUsed[i] as int)
    }
    for (let i = 0; i < 20 && i < this.satelliteElevation.length; i++) {
      writeUint(into, at + 41 + i * 1, 1, this.satelliteElevation[i] as int)
    }
    for (let i = 0; i < 20 && i < this.satelliteAzimuth.length; i++) {
      writeUint(into, at + 61 + i * 1, 1, this.satelliteAzimuth[i] as int)
    }
    for (let i = 0; i < 20 && i < this.satelliteSnr.length; i++) {
      writeUint(into, at + 81 + i * 1, 1, this.satelliteSnr[i] as int)
    }
  }

  public override info(): MessageInfo {
    GpsStatus.INFO
  }
}

/// The RAW IMU readings for the usual 9DOF sensor setup. This message should contain the scaled values
/// to the described units
export class ScaledImu extends MavLinkData {
  public static readonly MSG_ID: int = 26
  public static readonly MSG_NAME: string = "SCALED_IMU"
  public static readonly PAYLOAD_LENGTH: int = 24
  public static readonly MAGIC_NUMBER: int = 170
  public static readonly INFO: MessageInfo = new MessageInfo(26, "SCALED_IMU", 24, 22, 170, [
    new MavLinkPacketField("time_boot_ms", "timeBootMs", 0, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("xacc", "xacc", 4, false, 2, "int16_t", "mG"),
    new MavLinkPacketField("yacc", "yacc", 6, false, 2, "int16_t", "mG"),
    new MavLinkPacketField("zacc", "zacc", 8, false, 2, "int16_t", "mG"),
    new MavLinkPacketField("xgyro", "xgyro", 10, false, 2, "int16_t", "mrad/s"),
    new MavLinkPacketField("ygyro", "ygyro", 12, false, 2, "int16_t", "mrad/s"),
    new MavLinkPacketField("zgyro", "zgyro", 14, false, 2, "int16_t", "mrad/s"),
    new MavLinkPacketField("xmag", "xmag", 16, false, 2, "int16_t", "mgauss"),
    new MavLinkPacketField("ymag", "ymag", 18, false, 2, "int16_t", "mgauss"),
    new MavLinkPacketField("zmag", "zmag", 20, false, 2, "int16_t", "mgauss"),
    new MavLinkPacketField("temperature", "temperature", 22, true, 2, "int16_t", "cdegC"),
  ], (p) => ScaledImu.decode(p))

  /// Timestamp (time since system boot).
  /// Units: ms.
  public timeBootMs: u32 = 0

  /// X acceleration
  /// Units: mG.
  public xacc: i16 = 0

  /// Y acceleration
  /// Units: mG.
  public yacc: i16 = 0

  /// Z acceleration
  /// Units: mG.
  public zacc: i16 = 0

  /// Angular speed around X axis
  /// Units: mrad/s.
  public xgyro: i16 = 0

  /// Angular speed around Y axis
  /// Units: mrad/s.
  public ygyro: i16 = 0

  /// Angular speed around Z axis
  /// Units: mrad/s.
  public zgyro: i16 = 0

  /// X Magnetic field
  /// Units: mgauss.
  public xmag: i16 = 0

  /// Y Magnetic field
  /// Units: mgauss.
  public ymag: i16 = 0

  /// Z Magnetic field
  /// Units: mgauss.
  public zmag: i16 = 0

  /// Temperature, 0: IMU does not provide temperature values. If the IMU is at 0C it must send 1 (0.01C).
  /// Units: cdegC.
  public temperature: i16 = 0

  /// A SCALED_IMU from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): ScaledImu {
    const m = new ScaledImu()
    m.timeBootMs = readU32(payload, 0)
    m.xacc = readI16(payload, 4)
    m.yacc = readI16(payload, 6)
    m.zacc = readI16(payload, 8)
    m.xgyro = readI16(payload, 10)
    m.ygyro = readI16(payload, 12)
    m.zgyro = readI16(payload, 14)
    m.xmag = readI16(payload, 16)
    m.ymag = readI16(payload, 18)
    m.zmag = readI16(payload, 20)
    m.temperature = readI16(payload, 22)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.timeBootMs as int)
    writeUint(into, at + 4, 2, this.xacc as int)
    writeUint(into, at + 6, 2, this.yacc as int)
    writeUint(into, at + 8, 2, this.zacc as int)
    writeUint(into, at + 10, 2, this.xgyro as int)
    writeUint(into, at + 12, 2, this.ygyro as int)
    writeUint(into, at + 14, 2, this.zgyro as int)
    writeUint(into, at + 16, 2, this.xmag as int)
    writeUint(into, at + 18, 2, this.ymag as int)
    writeUint(into, at + 20, 2, this.zmag as int)
    writeUint(into, at + 22, 2, this.temperature as int)
  }

  public override info(): MessageInfo {
    ScaledImu.INFO
  }
}

/// The RAW IMU readings for a 9DOF sensor, which is identified by the id (default IMU1). This message
/// should always contain the true raw values without any scaling to allow data capture and system
/// debugging.
export class RawImu extends MavLinkData {
  public static readonly MSG_ID: int = 27
  public static readonly MSG_NAME: string = "RAW_IMU"
  public static readonly PAYLOAD_LENGTH: int = 29
  public static readonly MAGIC_NUMBER: int = 144
  public static readonly INFO: MessageInfo = new MessageInfo(27, "RAW_IMU", 29, 26, 144, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("xacc", "xacc", 8, false, 2, "int16_t", ""),
    new MavLinkPacketField("yacc", "yacc", 10, false, 2, "int16_t", ""),
    new MavLinkPacketField("zacc", "zacc", 12, false, 2, "int16_t", ""),
    new MavLinkPacketField("xgyro", "xgyro", 14, false, 2, "int16_t", ""),
    new MavLinkPacketField("ygyro", "ygyro", 16, false, 2, "int16_t", ""),
    new MavLinkPacketField("zgyro", "zgyro", 18, false, 2, "int16_t", ""),
    new MavLinkPacketField("xmag", "xmag", 20, false, 2, "int16_t", ""),
    new MavLinkPacketField("ymag", "ymag", 22, false, 2, "int16_t", ""),
    new MavLinkPacketField("zmag", "zmag", 24, false, 2, "int16_t", ""),
    new MavLinkPacketField("id", "id", 26, true, 1, "uint8_t", ""),
    new MavLinkPacketField("temperature", "temperature", 27, true, 2, "int16_t", "cdegC"),
  ], (p) => RawImu.decode(p))

  /// Timestamp (UNIX Epoch time or time since system boot). The receiving end can infer timestamp format
  /// (since 1.1.1970 or since system boot) by checking for the magnitude of the number.
  /// Units: us.
  public timeUsec: u64 = 0

  /// X acceleration (raw)
  public xacc: i16 = 0

  /// Y acceleration (raw)
  public yacc: i16 = 0

  /// Z acceleration (raw)
  public zacc: i16 = 0

  /// Angular speed around X axis (raw)
  public xgyro: i16 = 0

  /// Angular speed around Y axis (raw)
  public ygyro: i16 = 0

  /// Angular speed around Z axis (raw)
  public zgyro: i16 = 0

  /// X Magnetic field (raw)
  public xmag: i16 = 0

  /// Y Magnetic field (raw)
  public ymag: i16 = 0

  /// Z Magnetic field (raw)
  public zmag: i16 = 0

  /// Id. Ids are numbered from 0 and map to IMUs numbered from 1 (e.g. IMU1 will have a message with
  /// id=0)
  public id: u8 = 0

  /// Temperature, 0: IMU does not provide temperature values. If the IMU is at 0C it must send 1 (0.01C).
  /// Units: cdegC.
  public temperature: i16 = 0

  /// A RAW_IMU from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): RawImu {
    const m = new RawImu()
    m.timeUsec = readU64(payload, 0)
    m.xacc = readI16(payload, 8)
    m.yacc = readI16(payload, 10)
    m.zacc = readI16(payload, 12)
    m.xgyro = readI16(payload, 14)
    m.ygyro = readI16(payload, 16)
    m.zgyro = readI16(payload, 18)
    m.xmag = readI16(payload, 20)
    m.ymag = readI16(payload, 22)
    m.zmag = readI16(payload, 24)
    m.id = readU8(payload, 26)
    m.temperature = readI16(payload, 27)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    writeUint(into, at + 8, 2, this.xacc as int)
    writeUint(into, at + 10, 2, this.yacc as int)
    writeUint(into, at + 12, 2, this.zacc as int)
    writeUint(into, at + 14, 2, this.xgyro as int)
    writeUint(into, at + 16, 2, this.ygyro as int)
    writeUint(into, at + 18, 2, this.zgyro as int)
    writeUint(into, at + 20, 2, this.xmag as int)
    writeUint(into, at + 22, 2, this.ymag as int)
    writeUint(into, at + 24, 2, this.zmag as int)
    writeUint(into, at + 26, 1, this.id as int)
    writeUint(into, at + 27, 2, this.temperature as int)
  }

  public override info(): MessageInfo {
    RawImu.INFO
  }
}

/// The RAW pressure readings for the typical setup of one absolute pressure and one differential
/// pressure sensor. The sensor values should be the raw, UNSCALED ADC values.
export class RawPressure extends MavLinkData {
  public static readonly MSG_ID: int = 28
  public static readonly MSG_NAME: string = "RAW_PRESSURE"
  public static readonly PAYLOAD_LENGTH: int = 16
  public static readonly MAGIC_NUMBER: int = 67
  public static readonly INFO: MessageInfo = new MessageInfo(28, "RAW_PRESSURE", 16, 16, 67, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("press_abs", "pressAbs", 8, false, 2, "int16_t", ""),
    new MavLinkPacketField("press_diff1", "pressDiff1", 10, false, 2, "int16_t", ""),
    new MavLinkPacketField("press_diff2", "pressDiff2", 12, false, 2, "int16_t", ""),
    new MavLinkPacketField("temperature", "temperature", 14, false, 2, "int16_t", ""),
  ], (p) => RawPressure.decode(p))

  /// Timestamp (UNIX Epoch time or time since system boot). The receiving end can infer timestamp format
  /// (since 1.1.1970 or since system boot) by checking for the magnitude of the number.
  /// Units: us.
  public timeUsec: u64 = 0

  /// Absolute pressure (raw)
  public pressAbs: i16 = 0

  /// Differential pressure 1 (raw, 0 if nonexistent)
  public pressDiff1: i16 = 0

  /// Differential pressure 2 (raw, 0 if nonexistent)
  public pressDiff2: i16 = 0

  /// Raw Temperature measurement (raw)
  public temperature: i16 = 0

  /// A RAW_PRESSURE from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): RawPressure {
    const m = new RawPressure()
    m.timeUsec = readU64(payload, 0)
    m.pressAbs = readI16(payload, 8)
    m.pressDiff1 = readI16(payload, 10)
    m.pressDiff2 = readI16(payload, 12)
    m.temperature = readI16(payload, 14)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    writeUint(into, at + 8, 2, this.pressAbs as int)
    writeUint(into, at + 10, 2, this.pressDiff1 as int)
    writeUint(into, at + 12, 2, this.pressDiff2 as int)
    writeUint(into, at + 14, 2, this.temperature as int)
  }

  public override info(): MessageInfo {
    RawPressure.INFO
  }
}

/// The pressure readings for the typical setup of one absolute and differential pressure sensor. The
/// units are as specified in each field.
export class ScaledPressure extends MavLinkData {
  public static readonly MSG_ID: int = 29
  public static readonly MSG_NAME: string = "SCALED_PRESSURE"
  public static readonly PAYLOAD_LENGTH: int = 16
  public static readonly MAGIC_NUMBER: int = 115
  public static readonly INFO: MessageInfo = new MessageInfo(29, "SCALED_PRESSURE", 16, 14, 115, [
    new MavLinkPacketField("time_boot_ms", "timeBootMs", 0, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("press_abs", "pressAbs", 4, false, 4, "float", "hPa"),
    new MavLinkPacketField("press_diff", "pressDiff", 8, false, 4, "float", "hPa"),
    new MavLinkPacketField("temperature", "temperature", 12, false, 2, "int16_t", "cdegC"),
    new MavLinkPacketField("temperature_press_diff", "temperaturePressDiff", 14, true, 2, "int16_t", "cdegC"),
  ], (p) => ScaledPressure.decode(p))

  /// Timestamp (time since system boot).
  /// Units: ms.
  public timeBootMs: u32 = 0

  /// Absolute pressure
  /// Units: hPa.
  public pressAbs: f32 = 0.0

  /// Differential pressure 1
  /// Units: hPa.
  public pressDiff: f32 = 0.0

  /// Absolute pressure temperature
  /// Units: cdegC.
  public temperature: i16 = 0

  /// Differential pressure temperature (0, if not available). Report values of 0 (or 1) as 1 cdegC.
  /// Units: cdegC.
  public temperaturePressDiff: i16 = 0

  /// A SCALED_PRESSURE from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): ScaledPressure {
    const m = new ScaledPressure()
    m.timeBootMs = readU32(payload, 0)
    m.pressAbs = readF32(payload, 4)
    m.pressDiff = readF32(payload, 8)
    m.temperature = readI16(payload, 12)
    m.temperaturePressDiff = readI16(payload, 14)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.timeBootMs as int)
    writeF32(into, at + 4, this.pressAbs)
    writeF32(into, at + 8, this.pressDiff)
    writeUint(into, at + 12, 2, this.temperature as int)
    writeUint(into, at + 14, 2, this.temperaturePressDiff as int)
  }

  public override info(): MessageInfo {
    ScaledPressure.INFO
  }
}

/// The attitude in the aeronautical frame (right-handed, Z-down, Y-right, X-front, ZYX, intrinsic).
export class Attitude extends MavLinkData {
  public static readonly MSG_ID: int = 30
  public static readonly MSG_NAME: string = "ATTITUDE"
  public static readonly PAYLOAD_LENGTH: int = 28
  public static readonly MAGIC_NUMBER: int = 39
  public static readonly INFO: MessageInfo = new MessageInfo(30, "ATTITUDE", 28, 28, 39, [
    new MavLinkPacketField("time_boot_ms", "timeBootMs", 0, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("roll", "roll", 4, false, 4, "float", "rad"),
    new MavLinkPacketField("pitch", "pitch", 8, false, 4, "float", "rad"),
    new MavLinkPacketField("yaw", "yaw", 12, false, 4, "float", "rad"),
    new MavLinkPacketField("rollspeed", "rollspeed", 16, false, 4, "float", "rad/s"),
    new MavLinkPacketField("pitchspeed", "pitchspeed", 20, false, 4, "float", "rad/s"),
    new MavLinkPacketField("yawspeed", "yawspeed", 24, false, 4, "float", "rad/s"),
  ], (p) => Attitude.decode(p))

  /// Timestamp (time since system boot).
  /// Units: ms.
