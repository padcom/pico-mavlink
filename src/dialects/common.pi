  public static readonly MAGIC_NUMBER: int = 199
  public static readonly INFO: MessageInfo = new MessageInfo(339, "RAW_RPM", 5, 5, 199, [
    new MavLinkPacketField("frequency", "frequency", 0, false, 4, "float", "rpm"),
    new MavLinkPacketField("index", "index", 4, false, 1, "uint8_t", ""),
  ], (p) => RawRpm.decode(p))

  /// Index of this RPM sensor (0-indexed)
  public index: u8 = 0

  /// Indicated rate
  /// Units: rpm.
  public frequency: f32 = 0.0

  /// A RAW_RPM from `payload` (zeros past its end).
