  /// Vibration levels on Y-axis
  public vibrationY: f32 = 0.0

  /// Vibration levels on Z-axis
  public vibrationZ: f32 = 0.0

  /// first accelerometer clipping count
  public clipping0: u32 = 0

  /// second accelerometer clipping count
  public clipping1: u32 = 0

  /// third accelerometer clipping count
  public clipping2: u32 = 0

  /// A VIBRATION from `payload` (zeros past its end).
