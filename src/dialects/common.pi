/// This message is emitted as response to MISSION_REQUEST_LIST by the MAV and to initiate a write
/// transaction. The GCS can then request the individual mission item based on the knowledge of the
/// total number of waypoints.
export class MissionCount extends MavLinkData {
  public static readonly MSG_ID: int = 44
  public static readonly MSG_NAME: string = "MISSION_COUNT"
  public static readonly PAYLOAD_LENGTH: int = 9
  public static readonly MAGIC_NUMBER: int = 221
  public static readonly INFO: MessageInfo = new MessageInfo(44, "MISSION_COUNT", 9, 4, 221, [
    new MavLinkPacketField("count", "count", 0, false, 2, "uint16_t", ""),
    new MavLinkPacketField("target_system", "targetSystem", 2, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 3, false, 1, "uint8_t", ""),
    new MavLinkPacketField("mission_type", "missionType", 4, true, 1, "uint8_t", ""),
    new MavLinkPacketField("opaque_id", "opaqueId", 5, true, 4, "uint32_t", ""),
  ], (p) => MissionCount.decode(p))

  /// System ID
  public targetSystem: u8 = 0

  /// Component ID
  public targetComponent: u8 = 0

  /// Number of mission items in the sequence
  public count: u16 = 0

  /// Mission type.
  /// Values: `MavMissionType`.
  public missionType: u8 = 0

  /// Id of current on-vehicle mission, fence, or rally point plan (on download from vehicle). This field
  /// is used when downloading a plan from a vehicle to a GCS. 0 on upload to the vehicle from GCS. 0 if
  /// plan ids are not supported. The current on-vehicle plan ids are streamed in `MISSION_CURRENT`,
  /// allowing a GCS to determine if any part of the plan has changed and needs to be re-uploaded. The ids
  /// are recalculated by the vehicle when any part of the on-vehicle plan changes (when a new plan is
  /// uploaded, the vehicle returns the new id to the GCS in MISSION_ACK).
  public opaqueId: u32 = 0

  /// A MISSION_COUNT from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): MissionCount {
    const m = new MissionCount()
    m.count = readU16(payload, 0)
    m.targetSystem = readU8(payload, 2)
    m.targetComponent = readU8(payload, 3)
    m.missionType = readU8(payload, 4)
    m.opaqueId = readU32(payload, 5)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 2, this.count as int)
    writeUint(into, at + 2, 1, this.targetSystem as int)
    writeUint(into, at + 3, 1, this.targetComponent as int)
    writeUint(into, at + 4, 1, this.missionType as int)
    writeUint(into, at + 5, 4, this.opaqueId as int)
  }

  public override info(): MessageInfo {
    MissionCount.INFO
  }
}

