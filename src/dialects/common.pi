/// SERIAL_CONTROL flags (bitmask)
export class SerialControlFlag {
  /// Set if this is a reply
  public static readonly REPLY: int = 1

  /// Set if the sender wants the receiver to send a response as another SERIAL_CONTROL message
  public static readonly RESPOND: int = 2

  /// Set if access to the serial port should be removed from whatever driver is currently using it,
  /// giving exclusive access to the SERIAL_CONTROL protocol. The port can be handed back by sending a
  /// request without this flag set
  public static readonly EXCLUSIVE: int = 4

  /// Block on writes to the serial port
  public static readonly BLOCKING: int = 8

  /// Send multiple replies until port is drained
  public static readonly MULTI: int = 16

  /// The name of `value` (`REPLY` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      1 => "REPLY",
      2 => "RESPOND",
      4 => "EXCLUSIVE",
      8 => "BLOCKING",
      16 => "MULTI",
      _ => null,
    }
  }
}

