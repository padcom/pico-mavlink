      0 => "OK",
      1 => "WARNING",
      2 => "ERROR",
      3 => "CRITICAL",
      _ => null,
    }
  }
}

/// Generalized UAVCAN node mode
export class UavcanNodeMode {
  /// The node is performing its primary functions.
