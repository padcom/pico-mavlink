  /// This field is to be used if the gimbal manager and the gimbal device are the same component and
  /// hence have the same component ID. This field is then set a number between 1-6. If the component ID
  /// is separate, this field is not required and must be set to 0.
  public gimbalDeviceId: u8 = 0

  /// A GIMBAL_DEVICE_ATTITUDE_STATUS from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): GimbalDeviceAttitudeStatus {
    const m = new GimbalDeviceAttitudeStatus()
    m.timeBootMs = readU32(payload, 0)
    for (let i = 0; i < 4; i++) {
      m.q.push(readF32(payload, 4 + i * 4))
    }
    m.angularVelocityX = readF32(payload, 20)
    m.angularVelocityY = readF32(payload, 24)
    m.angularVelocityZ = readF32(payload, 28)
    m.failureFlags = readU32(payload, 32)
    m.flags = readU16(payload, 36)
    m.targetSystem = readU8(payload, 38)
    m.targetComponent = readU8(payload, 39)
    m.deltaYaw = readF32(payload, 40)
    m.deltaYawVelocity = readF32(payload, 44)
    m.gimbalDeviceId = readU8(payload, 48)
    m
  }

