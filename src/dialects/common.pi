  public alt: i32 = 0

  /// Ground X Speed (Latitude)
  /// Units: cm/s.
  public vx: i16 = 0

  /// Ground Y Speed (Longitude)
  /// Units: cm/s.
  public vy: i16 = 0

  /// Ground Z Speed (Altitude)
  /// Units: cm/s.
  public vz: i16 = 0

  /// X acceleration
  /// Units: mG.
  public xacc: i16 = 0

  /// Y acceleration
  /// Units: mG.
  public yacc: i16 = 0

  /// Z acceleration
  /// Units: mG.
  public zacc: i16 = 0

