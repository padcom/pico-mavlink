/// Status text message. These messages are printed in yellow in the COMM console of QGroundControl.
/// WARNING: They consume quite some bandwidth, so use only for important status and error messages. If
/// implemented wisely, these messages are buffered on the MCU and sent only at a limited rate (e.g. 10
/// Hz).
export class StatusText extends MavLinkData {
  public static readonly MSG_ID: int = 253
  public static readonly MSG_NAME: string = "STATUSTEXT"
  public static readonly PAYLOAD_LENGTH: int = 54
  public static readonly MAGIC_NUMBER: int = 83
  public static readonly INFO: MessageInfo = new MessageInfo(253, "STATUSTEXT", 54, 51, 83, [
    new MavLinkPacketField("severity", "severity", 0, false, 1, "uint8_t", ""),
    new MavLinkPacketField("text", "text", 1, false, 1, "char[]", "", 50),
    new MavLinkPacketField("id", "id", 51, true, 2, "uint16_t", ""),
    new MavLinkPacketField("chunk_seq", "chunkSeq", 53, true, 1, "uint8_t", ""),
  ], (p) => StatusText.decode(p))

  /// Severity of status. Relies on the definitions within RFC-5424.
  /// Values: `MavSeverity`.
  public severity: u8 = 0

  /// Status text message, without null termination character. UTF-8 encoded.
  public text: string = ""

  /// Unique (opaque) identifier for this statustext message. May be used to reassemble a logical
  /// long-statustext message from a sequence of chunks. A value of zero indicates this is the only chunk
  /// in the sequence and the message can be emitted immediately.
  public id: u16 = 0

  /// This chunk's sequence number; indexing is from zero. Any null character in the text field is taken
  /// to mean this was the last chunk.
  public chunkSeq: u8 = 0

  /// A STATUSTEXT from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): StatusText {
    const m = new StatusText()
    m.severity = readU8(payload, 0)
    m.text = readChars(payload, 1, 50)
    m.id = readU16(payload, 51)
    m.chunkSeq = readU8(payload, 53)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 1, this.severity as int)
    writeChars(into, at + 1, 50, this.text)
    writeUint(into, at + 51, 2, this.id as int)
    writeUint(into, at + 53, 1, this.chunkSeq as int)
  }

  public override info(): MessageInfo {
    StatusText.INFO
  }
}

/// Send a debug value. The index is used to discriminate between values. These values show up in the
/// plot of QGroundControl as DEBUG N.
export class Debug extends MavLinkData {
  public static readonly MSG_ID: int = 254
  public static readonly MSG_NAME: string = "DEBUG"
  public static readonly PAYLOAD_LENGTH: int = 9
  public static readonly MAGIC_NUMBER: int = 46
  public static readonly INFO: MessageInfo = new MessageInfo(254, "DEBUG", 9, 9, 46, [
    new MavLinkPacketField("time_boot_ms", "timeBootMs", 0, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("value", "value", 4, false, 4, "float", ""),
    new MavLinkPacketField("ind", "ind", 8, false, 1, "uint8_t", ""),
  ], (p) => Debug.decode(p))

  /// Timestamp (time since system boot).
  /// Units: ms.
  public timeBootMs: u32 = 0

  /// index of debug variable
  public ind: u8 = 0

  /// DEBUG value
  public value: f32 = 0.0

  /// A DEBUG from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): Debug {
    const m = new Debug()
    m.timeBootMs = readU32(payload, 0)
    m.value = readF32(payload, 4)
    m.ind = readU8(payload, 8)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.timeBootMs as int)
    writeF32(into, at + 4, this.value)
    writeUint(into, at + 8, 1, this.ind as int)
  }

  public override info(): MessageInfo {
    Debug.INFO
  }
}

/// Setup a MAVLink2 signing key. If called with secret_key of all zero and zero initial_timestamp will
/// disable signing
export class SetupSigning extends MavLinkData {
  public static readonly MSG_ID: int = 256
  public static readonly MSG_NAME: string = "SETUP_SIGNING"
  public static readonly PAYLOAD_LENGTH: int = 42
  public static readonly MAGIC_NUMBER: int = 71
  public static readonly INFO: MessageInfo = new MessageInfo(256, "SETUP_SIGNING", 42, 42, 71, [
    new MavLinkPacketField("initial_timestamp", "initialTimestamp", 0, false, 8, "uint64_t", ""),
    new MavLinkPacketField("target_system", "targetSystem", 8, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 9, false, 1, "uint8_t", ""),
    new MavLinkPacketField("secret_key", "secretKey", 10, false, 1, "uint8_t[]", "", 32),
  ], (p) => SetupSigning.decode(p))

  /// system id of the target
  public targetSystem: u8 = 0

  /// component ID of the target
  public targetComponent: u8 = 0

  /// signing key
  public secretKey: u8[] = []

  /// initial timestamp
  public initialTimestamp: u64 = 0

  /// A SETUP_SIGNING from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): SetupSigning {
    const m = new SetupSigning()
    m.initialTimestamp = readU64(payload, 0)
    m.targetSystem = readU8(payload, 8)
    m.targetComponent = readU8(payload, 9)
    for (let i = 0; i < 32; i++) {
      m.secretKey.push(readU8(payload, 10 + i * 1))
    }
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.initialTimestamp)
    writeUint(into, at + 8, 1, this.targetSystem as int)
    writeUint(into, at + 9, 1, this.targetComponent as int)
    for (let i = 0; i < 32 && i < this.secretKey.length; i++) {
      writeUint(into, at + 10 + i * 1, 1, this.secretKey[i] as int)
    }
  }

  public override info(): MessageInfo {
    SetupSigning.INFO
  }
}

