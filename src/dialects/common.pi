/// A data stream is not a fixed set of messages, but rather a recommendation to the autopilot software.
/// Individual autopilots may or may not obey the recommended messages.
export class MavDataStream {
  /// Enable all data streams
  public static readonly ALL: int = 0

  /// Enable IMU_RAW, GPS_RAW, GPS_STATUS packets.
  public static readonly RAW_SENSORS: int = 1

  /// Enable GPS_STATUS, CONTROL_STATUS, AUX_STATUS
  public static readonly EXTENDED_STATUS: int = 2

  /// Enable RC_CHANNELS_SCALED, RC_CHANNELS_RAW, SERVO_OUTPUT_RAW
  public static readonly RC_CHANNELS: int = 3

  /// Enable ATTITUDE_CONTROLLER_OUTPUT, POSITION_CONTROLLER_OUTPUT, NAV_CONTROLLER_OUTPUT.
  public static readonly RAW_CONTROLLER: int = 4

  /// Enable LOCAL_POSITION, GLOBAL_POSITION_INT messages.
  public static readonly POSITION: int = 6

  /// Dependent on the autopilot
  public static readonly EXTRA1: int = 10

  /// Dependent on the autopilot
  public static readonly EXTRA2: int = 11

  /// Dependent on the autopilot
  public static readonly EXTRA3: int = 12

  /// The name of `value` (`ALL` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "ALL",
      1 => "RAW_SENSORS",
      2 => "EXTENDED_STATUS",
      3 => "RC_CHANNELS",
      4 => "RAW_CONTROLLER",
      6 => "POSITION",
      10 => "EXTRA1",
      11 => "EXTRA2",
      12 => "EXTRA3",
      _ => null,
    }
  }
}

/// The ROI (region of interest) for the vehicle. This can be be used by the vehicle for camera/vehicle
/// attitude alignment (see MAV_CMD_NAV_ROI).
export class MavRoi {
  /// No region of interest.
  public static readonly NONE: int = 0

  /// Point toward next waypoint, with optional pitch/roll/yaw offset.
  public static readonly WPNEXT: int = 1

  /// Point toward given waypoint.
  public static readonly WPINDEX: int = 2

  /// Point toward fixed location.
  public static readonly LOCATION: int = 3

  /// Point toward of given id.
  public static readonly TARGET: int = 4

  /// The name of `value` (`NONE` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "NONE",
      1 => "WPNEXT",
      2 => "WPINDEX",
      3 => "LOCATION",
      4 => "TARGET",
      _ => null,
    }
  }
}

/// Specifies the datatype of a MAVLink parameter.
export class MavParamType {
  /// 8-bit unsigned integer
  public static readonly UINT8: int = 1

  /// 8-bit signed integer
  public static readonly INT8: int = 2

  /// 16-bit unsigned integer
  public static readonly UINT16: int = 3

  /// 16-bit signed integer
  public static readonly INT16: int = 4

  /// 32-bit unsigned integer
  public static readonly UINT32: int = 5

  /// 32-bit signed integer
  public static readonly INT32: int = 6

  /// 64-bit unsigned integer
  public static readonly UINT64: int = 7

  /// 64-bit signed integer
  public static readonly INT64: int = 8

  /// 32-bit floating-point
  public static readonly REAL32: int = 9

  /// 64-bit floating-point
  public static readonly REAL64: int = 10

  /// The name of `value` (`UINT8` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      1 => "UINT8",
      2 => "INT8",
      3 => "UINT16",
      4 => "INT16",
      5 => "UINT32",
      6 => "INT32",
      7 => "UINT64",
      8 => "INT64",
      9 => "REAL32",
      10 => "REAL64",
      _ => null,
    }
  }
}

/// Parameter protocol error types (see PARAM_ERROR).
export class MavParamError {
  /// No error occurred (not expected in PARAM_ERROR but may be used in future implementations.
  public static readonly NO_ERROR: int = 0

  /// Parameter does not exist
  public static readonly DOES_NOT_EXIST: int = 1

  /// Parameter value does not fit within accepted range
  public static readonly VALUE_OUT_OF_RANGE: int = 2

  /// Caller is not permitted to set the value of this parameter
  public static readonly PERMISSION_DENIED: int = 3

  /// Unknown component specified
  public static readonly COMPONENT_NOT_FOUND: int = 4

  /// Parameter is read-only
  public static readonly READ_ONLY: int = 5

  /// Parameter data type (MAV_PARAM_TYPE) is not supported by flight stack (at all)
  public static readonly TYPE_UNSUPPORTED: int = 6

  /// Parameter type does not match expected type
  public static readonly TYPE_MISMATCH: int = 7

  /// Parameter exists but reading failed
  public static readonly READ_FAIL: int = 8

  /// The name of `value` (`NO_ERROR` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "NO_ERROR",
      1 => "DOES_NOT_EXIST",
      2 => "VALUE_OUT_OF_RANGE",
      3 => "PERMISSION_DENIED",
      4 => "COMPONENT_NOT_FOUND",
      5 => "READ_ONLY",
      6 => "TYPE_UNSUPPORTED",
      7 => "TYPE_MISMATCH",
      8 => "READ_FAIL",
      _ => null,
    }
  }
}

/// Specifies the datatype of a MAVLink extended parameter.
export class MavParamExtType {
  /// 8-bit unsigned integer
