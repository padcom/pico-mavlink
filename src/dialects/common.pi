/// Information about video stream. It may be requested using MAV_CMD_REQUEST_MESSAGE, where param2
/// indicates the video stream id: 0 for all streams, 1 for first, 2 for second, etc.
export class VideoStreamInformation extends MavLinkData {
  public static readonly MSG_ID: int = 269
  public static readonly MSG_NAME: string = "VIDEO_STREAM_INFORMATION"
  public static readonly PAYLOAD_LENGTH: int = 215
  public static readonly MAGIC_NUMBER: int = 109
  public static readonly INFO: MessageInfo = new MessageInfo(269, "VIDEO_STREAM_INFORMATION", 215, 213, 109, [
    new MavLinkPacketField("framerate", "framerate", 0, false, 4, "float", "Hz"),
    new MavLinkPacketField("bitrate", "bitrate", 4, false, 4, "uint32_t", "bits/s"),
    new MavLinkPacketField("flags", "flags", 8, false, 2, "uint16_t", ""),
    new MavLinkPacketField("resolution_h", "resolutionH", 10, false, 2, "uint16_t", "pix"),
    new MavLinkPacketField("resolution_v", "resolutionV", 12, false, 2, "uint16_t", "pix"),
    new MavLinkPacketField("rotation", "rotation", 14, false, 2, "uint16_t", "deg"),
    new MavLinkPacketField("hfov", "hfov", 16, false, 2, "uint16_t", "deg"),
    new MavLinkPacketField("stream_id", "streamId", 18, false, 1, "uint8_t", ""),
    new MavLinkPacketField("count", "count", 19, false, 1, "uint8_t", ""),
    new MavLinkPacketField("type", "type", 20, false, 1, "uint8_t", ""),
    new MavLinkPacketField("name", "name", 21, false, 1, "char[]", "", 32),
    new MavLinkPacketField("uri", "uri", 53, false, 1, "char[]", "", 160),
    new MavLinkPacketField("encoding", "encoding", 213, true, 1, "uint8_t", ""),
    new MavLinkPacketField("camera_device_id", "cameraDeviceId", 214, true, 1, "uint8_t", ""),
  ], (p) => VideoStreamInformation.decode(p))

  /// Video Stream ID (1 for first, 2 for second, etc.)
  public streamId: u8 = 0

  /// Number of streams available.
  public count: u8 = 0

  /// Type of stream.
  /// Values: `VideoStreamType`.
  public type: u8 = 0

  /// Bitmap of stream status flags.
  /// Values: `VideoStreamStatusFlags`.
  public flags: u16 = 0

  /// Frame rate.
  /// Units: Hz.
  public framerate: f32 = 0.0

  /// Horizontal resolution.
  /// Units: pix.
  public resolutionH: u16 = 0

  /// Vertical resolution.
  /// Units: pix.
  public resolutionV: u16 = 0

  /// Bit rate.
  /// Units: bits/s.
  public bitrate: u32 = 0

  /// Video image rotation clockwise.
  /// Units: deg.
  public rotation: u16 = 0

  /// Horizontal Field of view.
  /// Units: deg.
  public hfov: u16 = 0

  /// Stream name.
  public name: string = ""

  /// Video stream URI (TCP or RTSP URI ground station should connect to) or port number (UDP port ground
  /// station should listen to).
  public uri: string = ""

  /// Encoding of stream.
  /// Values: `VideoStreamEncoding`.
  public encoding: u8 = 0

  /// Camera id of a non-MAVLink camera attached to an autopilot (1-6). 0 if the component is a MAVLink
  /// camera (with its own component id).
  public cameraDeviceId: u8 = 0

  /// A VIDEO_STREAM_INFORMATION from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): VideoStreamInformation {
    const m = new VideoStreamInformation()
    m.framerate = readF32(payload, 0)
    m.bitrate = readU32(payload, 4)
    m.flags = readU16(payload, 8)
    m.resolutionH = readU16(payload, 10)
    m.resolutionV = readU16(payload, 12)
    m.rotation = readU16(payload, 14)
    m.hfov = readU16(payload, 16)
    m.streamId = readU8(payload, 18)
    m.count = readU8(payload, 19)
    m.type = readU8(payload, 20)
    m.name = readChars(payload, 21, 32)
    m.uri = readChars(payload, 53, 160)
    m.encoding = readU8(payload, 213)
    m.cameraDeviceId = readU8(payload, 214)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeF32(into, at + 0, this.framerate)
    writeUint(into, at + 4, 4, this.bitrate as int)
    writeUint(into, at + 8, 2, this.flags as int)
    writeUint(into, at + 10, 2, this.resolutionH as int)
    writeUint(into, at + 12, 2, this.resolutionV as int)
    writeUint(into, at + 14, 2, this.rotation as int)
    writeUint(into, at + 16, 2, this.hfov as int)
    writeUint(into, at + 18, 1, this.streamId as int)
    writeUint(into, at + 19, 1, this.count as int)
    writeUint(into, at + 20, 1, this.type as int)
    writeChars(into, at + 21, 32, this.name)
    writeChars(into, at + 53, 160, this.uri)
    writeUint(into, at + 213, 1, this.encoding as int)
    writeUint(into, at + 214, 1, this.cameraDeviceId as int)
  }

  public override info(): MessageInfo {
    VideoStreamInformation.INFO
  }
}

