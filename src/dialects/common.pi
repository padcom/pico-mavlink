    writeF32(into, at + 16, this.roll)
    writeF32(into, at + 20, this.pitch)
    writeF32(into, at + 24, this.yaw)
    writeF32(into, at + 28, this.xacc)
    writeF32(into, at + 32, this.yacc)
    writeF32(into, at + 36, this.zacc)
    writeF32(into, at + 40, this.xgyro)
    writeF32(into, at + 44, this.ygyro)
    writeF32(into, at + 48, this.zgyro)
    writeF32(into, at + 52, this.lat)
    writeF32(into, at + 56, this.lon)
    writeF32(into, at + 60, this.alt)
    writeF32(into, at + 64, this.stdDevHorz)
    writeF32(into, at + 68, this.stdDevVert)
    writeF32(into, at + 72, this.vn)
    writeF32(into, at + 76, this.ve)
    writeF32(into, at + 80, this.vd)
    writeUint(into, at + 84, 4, this.latInt as int)
    writeUint(into, at + 88, 4, this.lonInt as int)
  }

  public override info(): MessageInfo {
    SimState.INFO
  }
}

/// Status generated by radio and injected into MAVLink stream.
export class RadioStatus extends MavLinkData {
  public static readonly MSG_ID: int = 109
  public static readonly MSG_NAME: string = "RADIO_STATUS"
  public static readonly PAYLOAD_LENGTH: int = 9
  public static readonly MAGIC_NUMBER: int = 185
  public static readonly INFO: MessageInfo = new MessageInfo(109, "RADIO_STATUS", 9, 9, 185, [
    new MavLinkPacketField("rxerrors", "rxerrors", 0, false, 2, "uint16_t", ""),
    new MavLinkPacketField("fixed", "fixed", 2, false, 2, "uint16_t", ""),
    new MavLinkPacketField("rssi", "rssi", 4, false, 1, "uint8_t", ""),
    new MavLinkPacketField("remrssi", "remrssi", 5, false, 1, "uint8_t", ""),
    new MavLinkPacketField("txbuf", "txbuf", 6, false, 1, "uint8_t", "%"),
    new MavLinkPacketField("noise", "noise", 7, false, 1, "uint8_t", ""),
    new MavLinkPacketField("remnoise", "remnoise", 8, false, 1, "uint8_t", ""),
  ], (p) => RadioStatus.decode(p))

  /// Local (message sender) received signal strength indication in device-dependent units/scale. Values:
  /// [0-254], UINT8_MAX: invalid/unknown.
  public rssi: u8 = 0

  /// Remote (message receiver) signal strength indication in device-dependent units/scale. Values:
  /// [0-254], UINT8_MAX: invalid/unknown.
  public remrssi: u8 = 0

  /// Remaining free transmitter buffer space.
  /// Units: %.
  public txbuf: u8 = 0

  /// Local background noise level. These are device dependent RSSI values (scale as approx 2x dB on SiK
  /// radios). Values: [0-254], UINT8_MAX: invalid/unknown.
  public noise: u8 = 0

  /// Remote background noise level. These are device dependent RSSI values (scale as approx 2x dB on SiK
  /// radios). Values: [0-254], UINT8_MAX: invalid/unknown.
  public remnoise: u8 = 0

  /// Count of radio packet receive errors (since boot).
  public rxerrors: u16 = 0

  /// Count of error corrected radio packets (since boot).
  public fixed: u16 = 0

  /// A RADIO_STATUS from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): RadioStatus {
    const m = new RadioStatus()
    m.rxerrors = readU16(payload, 0)
    m.fixed = readU16(payload, 2)
    m.rssi = readU8(payload, 4)
    m.remrssi = readU8(payload, 5)
    m.txbuf = readU8(payload, 6)
    m.noise = readU8(payload, 7)
    m.remnoise = readU8(payload, 8)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 2, this.rxerrors as int)
    writeUint(into, at + 2, 2, this.fixed as int)
    writeUint(into, at + 4, 1, this.rssi as int)
    writeUint(into, at + 5, 1, this.remrssi as int)
    writeUint(into, at + 6, 1, this.txbuf as int)
    writeUint(into, at + 7, 1, this.noise as int)
    writeUint(into, at + 8, 1, this.remnoise as int)
  }

  public override info(): MessageInfo {
    RadioStatus.INFO
  }
}

/// File transfer protocol message: https://mavlink.io/en/services/ftp.html.
export class FileTransferProtocol extends MavLinkData {
  public static readonly MSG_ID: int = 110
  public static readonly MSG_NAME: string = "FILE_TRANSFER_PROTOCOL"
  public static readonly PAYLOAD_LENGTH: int = 254
  public static readonly MAGIC_NUMBER: int = 84
  public static readonly INFO: MessageInfo = new MessageInfo(110, "FILE_TRANSFER_PROTOCOL", 254, 254, 84, [
    new MavLinkPacketField("target_network", "targetNetwork", 0, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_system", "targetSystem", 1, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 2, false, 1, "uint8_t", ""),
    new MavLinkPacketField("payload", "payload", 3, false, 1, "uint8_t[]", "", 251),
  ], (p) => FileTransferProtocol.decode(p))

  /// Network ID (0 for broadcast)
  public targetNetwork: u8 = 0

  /// System ID (0 for broadcast)
  public targetSystem: u8 = 0

  /// Component ID (0 for broadcast)
  public targetComponent: u8 = 0

  /// Variable length payload. The content/format of this block is defined in
  /// https://mavlink.io/en/services/ftp.html. The length is defined by the remaining message length when
  /// subtracting the header and other fields. See also MAV_FTP_OPCODE and MAV_FTP_ERR.
  public payload: u8[] = []

  /// A FILE_TRANSFER_PROTOCOL from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): FileTransferProtocol {
    const m = new FileTransferProtocol()
    m.targetNetwork = readU8(payload, 0)
    m.targetSystem = readU8(payload, 1)
    m.targetComponent = readU8(payload, 2)
    for (let i = 0; i < 251; i++) {
      m.payload.push(readU8(payload, 3 + i * 1))
    }
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 1, this.targetNetwork as int)
    writeUint(into, at + 1, 1, this.targetSystem as int)
    writeUint(into, at + 2, 1, this.targetComponent as int)
    for (let i = 0; i < 251 && i < this.payload.length; i++) {
      writeUint(into, at + 3 + i * 1, 1, this.payload[i] as int)
    }
  }

  public override info(): MessageInfo {
    FileTransferProtocol.INFO
  }
}

/// Time synchronization message. The message is used for both timesync requests and responses. The
/// request is sent with `ts1=syncing component timestamp` and `tc1=0`, and may be broadcast or targeted
/// to a specific system/component. The response is sent with `ts1=syncing component timestamp` (mirror
/// back unchanged), and `tc1=responding component timestamp`, with the `target_system` and
/// `target_component` set to ids of the original request. Systems can determine if they are receiving a
/// request or response based on the value of `tc`. If the response has
/// `target_system==target_component==0` the remote system has not been updated to use the component IDs
/// and cannot reliably timesync; the requester may report an error. Timestamps are UNIX Epoch time or
/// time since system boot in nanoseconds (the timestamp format can be inferred by checking for the
/// magnitude of the number; generally it doesn't matter as only the offset is used). The message
/// sequence is repeated numerous times with results being filtered/averaged to estimate the offset. See
/// also: https://mavlink.io/en/services/timesync.html.
export class TimeSync extends MavLinkData {
  public static readonly MSG_ID: int = 111
  public static readonly MSG_NAME: string = "TIMESYNC"
  public static readonly PAYLOAD_LENGTH: int = 18
  public static readonly MAGIC_NUMBER: int = 34
  public static readonly INFO: MessageInfo = new MessageInfo(111, "TIMESYNC", 18, 16, 34, [
    new MavLinkPacketField("tc1", "tc1", 0, false, 8, "int64_t", "ns"),
    new MavLinkPacketField("ts1", "ts1", 8, false, 8, "int64_t", "ns"),
    new MavLinkPacketField("target_system", "targetSystem", 16, true, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 17, true, 1, "uint8_t", ""),
  ], (p) => TimeSync.decode(p))

  /// Time sync timestamp 1. Syncing: 0. Responding: Timestamp of responding component.
  /// Units: ns.
  public tc1: i64 = 0

  /// Time sync timestamp 2. Timestamp of syncing component (mirrored in response).
  /// Units: ns.
  public ts1: i64 = 0

  /// Target system id. Request: 0 (broadcast) or id of specific system. Response must contain system id
  /// of the requesting component.
  public targetSystem: u8 = 0

  /// Target component id. Request: 0 (broadcast) or id of specific component. Response must contain
  /// component id of the requesting component.
  public targetComponent: u8 = 0

  /// A TIMESYNC from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): TimeSync {
    const m = new TimeSync()
    m.tc1 = readI64(payload, 0)
    m.ts1 = readI64(payload, 8)
    m.targetSystem = readU8(payload, 16)
    m.targetComponent = readU8(payload, 17)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 8, this.tc1)
    writeUint(into, at + 8, 8, this.ts1)
    writeUint(into, at + 16, 1, this.targetSystem as int)
    writeUint(into, at + 17, 1, this.targetComponent as int)
  }

  public override info(): MessageInfo {
    TimeSync.INFO
  }
}

/// Camera-IMU triggering and synchronisation message.
