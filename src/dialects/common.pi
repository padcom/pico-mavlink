    m.paramValue = readChars(payload, 20, 128)
    m.paramType = readU8(payload, 148)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 2, this.paramCount as int)
    writeUint(into, at + 2, 2, this.paramIndex as int)
    writeChars(into, at + 4, 16, this.paramId)
    writeChars(into, at + 20, 128, this.paramValue)
    writeUint(into, at + 148, 1, this.paramType as int)
  }

