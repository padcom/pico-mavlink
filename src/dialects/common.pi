  /// Units: ms.
  public timeBootMs: u32 = 0

  /// Camera mode
  /// Values: `CameraMode`.
  public modeId: u8 = 0

  /// Current zoom level as a percentage of the full range (0.0 to 100.0, NaN if not known)
  public zoomLevel: f32 = 0.0

  /// Current focus level as a percentage of the full range (0.0 to 100.0, NaN if not known)
  public focusLevel: f32 = 0.0

  /// Camera id of a non-MAVLink camera attached to an autopilot (1-6). 0 if the component is a MAVLink
  /// camera (with its own component id).
  public cameraDeviceId: u8 = 0

  /// A CAMERA_SETTINGS from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): CameraSettings {
    const m = new CameraSettings()
    m.timeBootMs = readU32(payload, 0)
    m.modeId = readU8(payload, 4)
    m.zoomLevel = readF32(payload, 5)
    m.focusLevel = readF32(payload, 9)
    m.cameraDeviceId = readU8(payload, 13)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.timeBootMs as int)
    writeUint(into, at + 4, 1, this.modeId as int)
    writeF32(into, at + 5, this.zoomLevel)
    writeF32(into, at + 9, this.focusLevel)
    writeUint(into, at + 13, 1, this.cameraDeviceId as int)
  }

  public override info(): MessageInfo {
    CameraSettings.INFO
  }
}

/// Information about a storage medium. This message is sent in response to a request with
/// MAV_CMD_REQUEST_MESSAGE and whenever the status of the storage changes (STORAGE_STATUS). Use
/// MAV_CMD_REQUEST_MESSAGE.param2 to indicate the index/id of requested storage: 0 for all, 1 for
/// first, 2 for second, etc.
export class StorageInformation extends MavLinkData {
  public static readonly MSG_ID: int = 261
  public static readonly MSG_NAME: string = "STORAGE_INFORMATION"
  public static readonly PAYLOAD_LENGTH: int = 61
  public static readonly MAGIC_NUMBER: int = 179
  public static readonly INFO: MessageInfo = new MessageInfo(261, "STORAGE_INFORMATION", 61, 27, 179, [
    new MavLinkPacketField("time_boot_ms", "timeBootMs", 0, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("total_capacity", "totalCapacity", 4, false, 4, "float", "MiB"),
    new MavLinkPacketField("used_capacity", "usedCapacity", 8, false, 4, "float", "MiB"),
    new MavLinkPacketField("available_capacity", "availableCapacity", 12, false, 4, "float", "MiB"),
    new MavLinkPacketField("read_speed", "readSpeed", 16, false, 4, "float", "MiB/s"),
    new MavLinkPacketField("write_speed", "writeSpeed", 20, false, 4, "float", "MiB/s"),
    new MavLinkPacketField("storage_id", "storageId", 24, false, 1, "uint8_t", ""),
    new MavLinkPacketField("storage_count", "storageCount", 25, false, 1, "uint8_t", ""),
    new MavLinkPacketField("status", "status", 26, false, 1, "uint8_t", ""),
    new MavLinkPacketField("type", "type", 27, true, 1, "uint8_t", ""),
    new MavLinkPacketField("name", "name", 28, true, 1, "char[]", "", 32),
    new MavLinkPacketField("storage_usage", "storageUsage", 60, true, 1, "uint8_t", ""),
  ], (p) => StorageInformation.decode(p))

  /// Timestamp (time since system boot).
  /// Units: ms.
  public timeBootMs: u32 = 0

  /// Storage ID (1 for first, 2 for second, etc.)
  public storageId: u8 = 0

  /// Number of storage devices
  public storageCount: u8 = 0

  /// Status of storage
  /// Values: `StorageStatus`.
  public status: u8 = 0

  /// Total capacity. If storage is not ready (STORAGE_STATUS_READY) value will be ignored.
  /// Units: MiB.
  public totalCapacity: f32 = 0.0

  /// Used capacity. If storage is not ready (STORAGE_STATUS_READY) value will be ignored.
  /// Units: MiB.
  public usedCapacity: f32 = 0.0

  /// Available storage capacity. If storage is not ready (STORAGE_STATUS_READY) value will be ignored.
  /// Units: MiB.
  public availableCapacity: f32 = 0.0

  /// Read speed.
  /// Units: MiB/s.
  public readSpeed: f32 = 0.0

  /// Write speed.
  /// Units: MiB/s.
  public writeSpeed: f32 = 0.0

  /// Type of storage
  /// Values: `StorageType`.
  public type: u8 = 0

  /// Textual storage name to be used in UI (microSD 1, Internal Memory, etc.) This is a NULL terminated
  /// string. If it is exactly 32 characters long, add a terminating NULL. If this string is empty, the
  /// generic type is shown to the user.
  public name: string = ""

  /// Flags indicating whether this instance is preferred storage for photos, videos, etc. Note:
  /// Implementations should initially set the flags on the system-default storage id used for saving
  /// media (if possible/supported). This setting can then be overridden using MAV_CMD_SET_STORAGE_USAGE.
  /// If the media usage flags are not set, a GCS may assume storage ID 1 is the default storage for all
  /// media types.
  /// Values: `StorageUsageFlag`.
  public storageUsage: u8 = 0

  /// A STORAGE_INFORMATION from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): StorageInformation {
    const m = new StorageInformation()
    m.timeBootMs = readU32(payload, 0)
    m.totalCapacity = readF32(payload, 4)
    m.usedCapacity = readF32(payload, 8)
    m.availableCapacity = readF32(payload, 12)
    m.readSpeed = readF32(payload, 16)
    m.writeSpeed = readF32(payload, 20)
    m.storageId = readU8(payload, 24)
    m.storageCount = readU8(payload, 25)
    m.status = readU8(payload, 26)
    m.type = readU8(payload, 27)
    m.name = readChars(payload, 28, 32)
    m.storageUsage = readU8(payload, 60)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.timeBootMs as int)
    writeF32(into, at + 4, this.totalCapacity)
    writeF32(into, at + 8, this.usedCapacity)
    writeF32(into, at + 12, this.availableCapacity)
    writeF32(into, at + 16, this.readSpeed)
    writeF32(into, at + 20, this.writeSpeed)
    writeUint(into, at + 24, 1, this.storageId as int)
    writeUint(into, at + 25, 1, this.storageCount as int)
    writeUint(into, at + 26, 1, this.status as int)
    writeUint(into, at + 27, 1, this.type as int)
    writeChars(into, at + 28, 32, this.name)
    writeUint(into, at + 60, 1, this.storageUsage as int)
  }

  public override info(): MessageInfo {
    StorageInformation.INFO
  }
}

/// Information about the status of a capture. Can be requested with a MAV_CMD_REQUEST_MESSAGE command.
export class CameraCaptureStatus extends MavLinkData {
  public static readonly MSG_ID: int = 262
  public static readonly MSG_NAME: string = "CAMERA_CAPTURE_STATUS"
  public static readonly PAYLOAD_LENGTH: int = 23
  public static readonly MAGIC_NUMBER: int = 12
  public static readonly INFO: MessageInfo = new MessageInfo(262, "CAMERA_CAPTURE_STATUS", 23, 18, 12, [
    new MavLinkPacketField("time_boot_ms", "timeBootMs", 0, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("image_interval", "imageInterval", 4, false, 4, "float", "s"),
    new MavLinkPacketField("recording_time_ms", "recordingTimeMs", 8, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("available_capacity", "availableCapacity", 12, false, 4, "float", "MiB"),
    new MavLinkPacketField("image_status", "imageStatus", 16, false, 1, "uint8_t", ""),
    new MavLinkPacketField("video_status", "videoStatus", 17, false, 1, "uint8_t", ""),
    new MavLinkPacketField("image_count", "imageCount", 18, true, 4, "int32_t", ""),
    new MavLinkPacketField("camera_device_id", "cameraDeviceId", 22, true, 1, "uint8_t", ""),
  ], (p) => CameraCaptureStatus.decode(p))

  /// Timestamp (time since system boot).
  /// Units: ms.
  public timeBootMs: u32 = 0

  /// Current status of image capturing (0: idle, 1: capture in progress, 2: interval set but idle, 3:
  /// interval set and capture in progress)
  public imageStatus: u8 = 0

  /// Current status of video capturing (0: idle, 1: capture in progress)
  public videoStatus: u8 = 0

  /// Image capture interval
  /// Units: s.
  public imageInterval: f32 = 0.0

  /// Elapsed time since recording started (0: Not supported/available). A GCS should compute recording
  /// time and use non-zero values of this field to correct any discrepancy.
  /// Units: ms.
  public recordingTimeMs: u32 = 0

  /// Available storage capacity.
  /// Units: MiB.
  public availableCapacity: f32 = 0.0

  /// Total number of images captured ('forever', or until reset using MAV_CMD_STORAGE_FORMAT).
  public imageCount: i32 = 0

  /// Camera id of a non-MAVLink camera attached to an autopilot (1-6). 0 if the component is a MAVLink
  /// camera (with its own component id).
  public cameraDeviceId: u8 = 0

  /// A CAMERA_CAPTURE_STATUS from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): CameraCaptureStatus {
    const m = new CameraCaptureStatus()
    m.timeBootMs = readU32(payload, 0)
    m.imageInterval = readF32(payload, 4)
    m.recordingTimeMs = readU32(payload, 8)
    m.availableCapacity = readF32(payload, 12)
    m.imageStatus = readU8(payload, 16)
    m.videoStatus = readU8(payload, 17)
    m.imageCount = readI32(payload, 18)
    m.cameraDeviceId = readU8(payload, 22)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.timeBootMs as int)
    writeF32(into, at + 4, this.imageInterval)
    writeUint(into, at + 8, 4, this.recordingTimeMs as int)
    writeF32(into, at + 12, this.availableCapacity)
    writeUint(into, at + 16, 1, this.imageStatus as int)
    writeUint(into, at + 17, 1, this.videoStatus as int)
    writeUint(into, at + 18, 4, this.imageCount as int)
    writeUint(into, at + 22, 1, this.cameraDeviceId as int)
  }

  public override info(): MessageInfo {
    CameraCaptureStatus.INFO
  }
}

/// Information about a captured image. This is emitted every time a message is captured.
/// MAV_CMD_REQUEST_MESSAGE can be used to (re)request this message for a specific sequence number or
/// range of sequence numbers: MAV_CMD_REQUEST_MESSAGE.param2 indicates the sequence number the first
/// image to send, or set to -1 to send the message for all sequence numbers.
/// MAV_CMD_REQUEST_MESSAGE.param3 is used to specify a range of messages to send: set to 0 (default) to
/// send just the the message for the sequence number in param 2, set to -1 to send the message for the
/// sequence number in param 2 and all the following sequence numbers, set to the sequence number of the
/// final message in the range.
export class CameraImageCaptured extends MavLinkData {
  public static readonly MSG_ID: int = 263
  public static readonly MSG_NAME: string = "CAMERA_IMAGE_CAPTURED"
  public static readonly PAYLOAD_LENGTH: int = 255
  public static readonly MAGIC_NUMBER: int = 133
  public static readonly INFO: MessageInfo = new MessageInfo(263, "CAMERA_IMAGE_CAPTURED", 255, 255, 133, [
    new MavLinkPacketField("time_utc", "timeUtc", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("time_boot_ms", "timeBootMs", 8, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("lat", "lat", 12, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("lon", "lon", 16, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("alt", "alt", 20, false, 4, "int32_t", "mm"),
    new MavLinkPacketField("relative_alt", "relativeAlt", 24, false, 4, "int32_t", "mm"),
    new MavLinkPacketField("q", "q", 28, false, 4, "float[]", "", 4),
    new MavLinkPacketField("image_index", "imageIndex", 44, false, 4, "int32_t", ""),
    new MavLinkPacketField("camera_id", "cameraId", 48, false, 1, "uint8_t", ""),
    new MavLinkPacketField("capture_result", "captureResult", 49, false, 1, "int8_t", ""),
    new MavLinkPacketField("file_url", "fileUrl", 50, false, 1, "char[]", "", 205),
  ], (p) => CameraImageCaptured.decode(p))

  /// Timestamp (time since system boot).
  /// Units: ms.
  public timeBootMs: u32 = 0

  /// Timestamp (time since UNIX epoch) in UTC. 0 for unknown.
  /// Units: us.
  public timeUtc: u64 = 0

  /// Camera id of a non-MAVLink camera attached to an autopilot (1-6). 0 if the component is a MAVLink
  /// camera (with its own component id). Field name is usually camera_device_id.
  public cameraId: u8 = 0

  /// Latitude where image was taken
  /// Units: degE7.
  public lat: i32 = 0

  /// Longitude where capture was taken
  /// Units: degE7.
  public lon: i32 = 0

  /// Altitude (MSL) where image was taken
  /// Units: mm.
  public alt: i32 = 0

  /// Altitude above ground
  /// Units: mm.
  public relativeAlt: i32 = 0

  /// Quaternion of camera orientation (w, x, y, z order, zero-rotation is 1, 0, 0, 0)
  public q: f32[] = []

  /// Zero based index of this image (i.e. a new image will have index CAMERA_CAPTURE_STATUS.image count
  /// -1)
  public imageIndex: i32 = 0

  /// Image was captured successfully (MAV_BOOL_TRUE). Values not equal to 0 or 1 are invalid.
  /// Values: `MavBool`.
  public captureResult: i8 = 0

  /// URL of image taken. Either local storage or http://foo.jpg if camera provides an HTTP interface.
  public fileUrl: string = ""

  /// A CAMERA_IMAGE_CAPTURED from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): CameraImageCaptured {
    const m = new CameraImageCaptured()
    m.timeUtc = readU64(payload, 0)
    m.timeBootMs = readU32(payload, 8)
    m.lat = readI32(payload, 12)
    m.lon = readI32(payload, 16)
    m.alt = readI32(payload, 20)
    m.relativeAlt = readI32(payload, 24)
    for (let i = 0; i < 4; i++) {
      m.q.push(readF32(payload, 28 + i * 4))
    }
    m.imageIndex = readI32(payload, 44)
    m.cameraId = readU8(payload, 48)
    m.captureResult = readI8(payload, 49)
    m.fileUrl = readChars(payload, 50, 205)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUtc)
    writeUint(into, at + 8, 4, this.timeBootMs as int)
    writeUint(into, at + 12, 4, this.lat as int)
    writeUint(into, at + 16, 4, this.lon as int)
    writeUint(into, at + 20, 4, this.alt as int)
    writeUint(into, at + 24, 4, this.relativeAlt as int)
    for (let i = 0; i < 4 && i < this.q.length; i++) {
      writeF32(into, at + 28 + i * 4, this.q[i])
    }
    writeUint(into, at + 44, 4, this.imageIndex as int)
    writeUint(into, at + 48, 1, this.cameraId as int)
    writeUint(into, at + 49, 1, this.captureResult as int)
    writeChars(into, at + 50, 205, this.fileUrl)
  }

  public override info(): MessageInfo {
    CameraImageCaptured.INFO
  }
}

/// Flight information. This includes time since boot for arm, takeoff, and land, and a flight number.
/// Takeoff and landing values reset to zero on arm. This can be requested using
/// MAV_CMD_REQUEST_MESSAGE. Note, some fields are misnamed - timestamps are from boot (not UTC) and the
/// flight_uuid is a sequence number.
export class FlightInformation extends MavLinkData {
  public static readonly MSG_ID: int = 264
  public static readonly MSG_NAME: string = "FLIGHT_INFORMATION"
  public static readonly PAYLOAD_LENGTH: int = 32
  public static readonly MAGIC_NUMBER: int = 49
  public static readonly INFO: MessageInfo = new MessageInfo(264, "FLIGHT_INFORMATION", 32, 28, 49, [
    new MavLinkPacketField("arming_time_utc", "armingTimeUtc", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("takeoff_time_utc", "takeoffTimeUtc", 8, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("flight_uuid", "flightUuid", 16, false, 8, "uint64_t", ""),
    new MavLinkPacketField("time_boot_ms", "timeBootMs", 24, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("landing_time", "landingTime", 28, true, 4, "uint32_t", "ms"),
  ], (p) => FlightInformation.decode(p))

  /// Timestamp (time since system boot).
  /// Units: ms.
  public timeBootMs: u32 = 0

  /// Timestamp at arming (since system boot). Set to 0 on boot. Set value on arming. Note, field is
  /// misnamed UTC.
  /// Units: us.
  public armingTimeUtc: u64 = 0

  /// Timestamp at takeoff (since system boot). Set to 0 at boot and on arming. Note, field is misnamed
  /// UTC.
  /// Units: us.
  public takeoffTimeUtc: u64 = 0

  /// Flight number. Note, field is misnamed UUID.
  public flightUuid: u64 = 0

  /// Timestamp at landing (in ms since system boot). Set to 0 at boot and on arming.
  /// Units: ms.
  public landingTime: u32 = 0

  /// A FLIGHT_INFORMATION from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): FlightInformation {
    const m = new FlightInformation()
    m.armingTimeUtc = readU64(payload, 0)
    m.takeoffTimeUtc = readU64(payload, 8)
    m.flightUuid = readU64(payload, 16)
    m.timeBootMs = readU32(payload, 24)
    m.landingTime = readU32(payload, 28)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.armingTimeUtc)
    writeU64(into, at + 8, this.takeoffTimeUtc)
    writeU64(into, at + 16, this.flightUuid)
    writeUint(into, at + 24, 4, this.timeBootMs as int)
    writeUint(into, at + 28, 4, this.landingTime as int)
  }

  public override info(): MessageInfo {
    FlightInformation.INFO
  }
}

