/// Type of mission items being requested/sent in mission protocol.
export class MavMissionType {
  /// Items are mission commands for main mission.
  public static readonly MISSION: int = 0

  /// Specifies GeoFence area(s). Items are MAV_CMD_NAV_FENCE_ GeoFence items.
  public static readonly FENCE: int = 1

  /// Specifies the rally points for the vehicle. Rally points are alternative RTL points. Items are
  /// MAV_CMD_NAV_RALLY_POINT rally point items.
  public static readonly RALLY: int = 2

  /// Only used in MISSION_CLEAR_ALL to clear all mission types.
  public static readonly ALL: int = 255

  /// The name of `value` (`MISSION` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "MISSION",
      1 => "FENCE",
      2 => "RALLY",
      255 => "ALL",
      _ => null,
    }
  }
}

/// Enumeration of estimator types
export class MavEstimatorType {
  /// Unknown type of the estimator.
  public static readonly UNKNOWN: int = 0

  /// This is a naive estimator without any real covariance feedback.
  public static readonly NAIVE: int = 1

  /// Computer vision based estimate. Might be up to scale.
  public static readonly VISION: int = 2

  /// Visual-inertial estimate.
  public static readonly VIO: int = 3

  /// Plain GPS estimate.
  public static readonly GPS: int = 4

  /// Estimator integrating GPS and inertial sensing.
  public static readonly GPS_INS: int = 5

  /// Estimate from external motion capturing system.
  public static readonly MOCAP: int = 6

  /// Estimator based on lidar sensor input.
  public static readonly LIDAR: int = 7

  /// Estimator on autopilot.
  public static readonly AUTOPILOT: int = 8

  /// The name of `value` (`UNKNOWN` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "UNKNOWN",
      1 => "NAIVE",
      2 => "VISION",
      3 => "VIO",
      4 => "GPS",
      5 => "GPS_INS",
      6 => "MOCAP",
      7 => "LIDAR",
      8 => "AUTOPILOT",
      _ => null,
    }
  }
}

/// Enumeration of battery types
export class MavBatteryType {
  /// Not specified.
