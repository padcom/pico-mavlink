  /// Load neutral position and start to point to Lat,Lon,Alt
  public static readonly GPS_POINT: int = 4

  /// Gimbal tracks system with specified system ID
  public static readonly SYSID_TARGET: int = 5

  /// Gimbal tracks home position
  public static readonly HOME_LOCATION: int = 6

  /// The name of `value` (`RETRACT` …), or null for a value this dialect doesn't define.
