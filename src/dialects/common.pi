    writeUint(into, at + 12, 2, this.COG as int)
    writeUint(into, at + 14, 2, this.heading as int)
    writeUint(into, at + 16, 2, this.velocity as int)
    writeUint(into, at + 18, 2, this.dimensionBow as int)
    writeUint(into, at + 20, 2, this.dimensionStern as int)
    writeUint(into, at + 22, 2, this.tslc as int)
    writeUint(into, at + 24, 2, this.flags as int)
    writeUint(into, at + 26, 1, this.turnRate as int)
    writeUint(into, at + 27, 1, this.navigationalStatus as int)
    writeUint(into, at + 28, 1, this.type as int)
