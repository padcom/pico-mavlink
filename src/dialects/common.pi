/// Sets a desired vehicle attitude. Used by an external controller to command the vehicle (manual
/// controller or other system).
export class SetAttitudeTarget extends MavLinkData {
  public static readonly MSG_ID: int = 82
  public static readonly MSG_NAME: string = "SET_ATTITUDE_TARGET"
  public static readonly PAYLOAD_LENGTH: int = 51
  public static readonly MAGIC_NUMBER: int = 49
  public static readonly INFO: MessageInfo = new MessageInfo(82, "SET_ATTITUDE_TARGET", 51, 39, 49, [
    new MavLinkPacketField("time_boot_ms", "timeBootMs", 0, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("q", "q", 4, false, 4, "float[]", "", 4),
    new MavLinkPacketField("body_roll_rate", "bodyRollRate", 20, false, 4, "float", "rad/s"),
    new MavLinkPacketField("body_pitch_rate", "bodyPitchRate", 24, false, 4, "float", "rad/s"),
    new MavLinkPacketField("body_yaw_rate", "bodyYawRate", 28, false, 4, "float", "rad/s"),
    new MavLinkPacketField("thrust", "thrust", 32, false, 4, "float", ""),
    new MavLinkPacketField("target_system", "targetSystem", 36, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 37, false, 1, "uint8_t", ""),
    new MavLinkPacketField("type_mask", "typeMask", 38, false, 1, "uint8_t", ""),
    new MavLinkPacketField("thrust_body", "thrustBody", 39, true, 4, "float[]", "", 3),
  ], (p) => SetAttitudeTarget.decode(p))

  /// Timestamp (time since system boot).
  /// Units: ms.
  public timeBootMs: u32 = 0

  /// System ID
  public targetSystem: u8 = 0

  /// Component ID
  public targetComponent: u8 = 0

  /// Bitmap to indicate which dimensions should be ignored by the vehicle.
  /// Values: `AttitudeTargetTypemask`.
  public typeMask: u8 = 0

  /// Attitude quaternion (w, x, y, z order, zero-rotation is 1, 0, 0, 0) from MAV_FRAME_LOCAL_NED to
  /// MAV_FRAME_BODY_FRD
  public q: f32[] = []

  /// Body roll rate
  /// Units: rad/s.
  public bodyRollRate: f32 = 0.0

  /// Body pitch rate
  /// Units: rad/s.
  public bodyPitchRate: f32 = 0.0

  /// Body yaw rate
  /// Units: rad/s.
  public bodyYawRate: f32 = 0.0

  /// Collective thrust, normalized to 0 .. 1 (-1 .. 1 for vehicles capable of reverse thrust)
  public thrust: f32 = 0.0

  /// 3D thrust setpoint in the body NED frame, normalized to -1 .. 1
  public thrustBody: f32[] = []

  /// A SET_ATTITUDE_TARGET from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): SetAttitudeTarget {
    const m = new SetAttitudeTarget()
    m.timeBootMs = readU32(payload, 0)
    for (let i = 0; i < 4; i++) {
      m.q.push(readF32(payload, 4 + i * 4))
    }
    m.bodyRollRate = readF32(payload, 20)
    m.bodyPitchRate = readF32(payload, 24)
    m.bodyYawRate = readF32(payload, 28)
    m.thrust = readF32(payload, 32)
    m.targetSystem = readU8(payload, 36)
    m.targetComponent = readU8(payload, 37)
    m.typeMask = readU8(payload, 38)
    for (let i = 0; i < 3; i++) {
      m.thrustBody.push(readF32(payload, 39 + i * 4))
    }
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.timeBootMs as int)
    for (let i = 0; i < 4 && i < this.q.length; i++) {
      writeF32(into, at + 4 + i * 4, this.q[i])
    }
    writeF32(into, at + 20, this.bodyRollRate)
    writeF32(into, at + 24, this.bodyPitchRate)
    writeF32(into, at + 28, this.bodyYawRate)
    writeF32(into, at + 32, this.thrust)
    writeUint(into, at + 36, 1, this.targetSystem as int)
    writeUint(into, at + 37, 1, this.targetComponent as int)
    writeUint(into, at + 38, 1, this.typeMask as int)
    for (let i = 0; i < 3 && i < this.thrustBody.length; i++) {
      writeF32(into, at + 39 + i * 4, this.thrustBody[i])
    }
  }

  public override info(): MessageInfo {
    SetAttitudeTarget.INFO
  }
}

