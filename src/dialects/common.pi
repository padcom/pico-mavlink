}

/// The global position resulting from GPS and sensor fusion.
export class UtmGlobalPosition extends MavLinkData {
  public static readonly MSG_ID: int = 340
  public static readonly MSG_NAME: string = "UTM_GLOBAL_POSITION"
  public static readonly PAYLOAD_LENGTH: int = 70
  public static readonly MAGIC_NUMBER: int = 99
  public static readonly INFO: MessageInfo = new MessageInfo(340, "UTM_GLOBAL_POSITION", 70, 70, 99, [
    new MavLinkPacketField("time", "time", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("lat", "lat", 8, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("lon", "lon", 12, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("alt", "alt", 16, false, 4, "int32_t", "mm"),
    new MavLinkPacketField("relative_alt", "relativeAlt", 20, false, 4, "int32_t", "mm"),
    new MavLinkPacketField("next_lat", "nextLat", 24, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("next_lon", "nextLon", 28, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("next_alt", "nextAlt", 32, false, 4, "int32_t", "mm"),
    new MavLinkPacketField("vx", "vx", 36, false, 2, "int16_t", "cm/s"),
    new MavLinkPacketField("vy", "vy", 38, false, 2, "int16_t", "cm/s"),
    new MavLinkPacketField("vz", "vz", 40, false, 2, "int16_t", "cm/s"),
    new MavLinkPacketField("h_acc", "hAcc", 42, false, 2, "uint16_t", "mm"),
    new MavLinkPacketField("v_acc", "vAcc", 44, false, 2, "uint16_t", "mm"),
    new MavLinkPacketField("vel_acc", "velAcc", 46, false, 2, "uint16_t", "cm/s"),
    new MavLinkPacketField("update_rate", "updateRate", 48, false, 2, "uint16_t", "cs"),
    new MavLinkPacketField("uas_id", "uasId", 50, false, 1, "uint8_t[]", "", 18),
    new MavLinkPacketField("flight_state", "flightState", 68, false, 1, "uint8_t", ""),
    new MavLinkPacketField("flags", "flags", 69, false, 1, "uint8_t", ""),
  ], (p) => UtmGlobalPosition.decode(p))

  /// Time of applicability of position (microseconds since UNIX epoch).
  /// Units: us.
  public time: u64 = 0

  /// Unique UAS ID.
  public uasId: u8[] = []

  /// Latitude (WGS84)
  /// Units: degE7.
  public lat: i32 = 0

  /// Longitude (WGS84)
  /// Units: degE7.
  public lon: i32 = 0

  /// Altitude (WGS84)
  /// Units: mm.
  public alt: i32 = 0

  /// Altitude above ground
  /// Units: mm.
  public relativeAlt: i32 = 0

  /// Ground X speed (latitude, positive north)
  /// Units: cm/s.
  public vx: i16 = 0

  /// Ground Y speed (longitude, positive east)
  /// Units: cm/s.
  public vy: i16 = 0

  /// Ground Z speed (altitude, positive down)
  /// Units: cm/s.
  public vz: i16 = 0

  /// Horizontal position uncertainty (standard deviation)
  /// Units: mm.
  public hAcc: u16 = 0

  /// Altitude uncertainty (standard deviation)
  /// Units: mm.
  public vAcc: u16 = 0

  /// Speed uncertainty (standard deviation)
  /// Units: cm/s.
  public velAcc: u16 = 0

  /// Next waypoint, latitude (WGS84)
  /// Units: degE7.
  public nextLat: i32 = 0

  /// Next waypoint, longitude (WGS84)
  /// Units: degE7.
  public nextLon: i32 = 0

  /// Next waypoint, altitude (WGS84)
  /// Units: mm.
  public nextAlt: i32 = 0

  /// Time until next update. Set to 0 if unknown or in data driven mode.
  /// Units: cs.
  public updateRate: u16 = 0

  /// Flight state
  /// Values: `UtmFlightState`.
  public flightState: u8 = 0

  /// Bitwise OR combination of the data available flags.
  /// Values: `UtmDataAvailFlags`.
  public flags: u8 = 0

  /// A UTM_GLOBAL_POSITION from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): UtmGlobalPosition {
    const m = new UtmGlobalPosition()
    m.time = readU64(payload, 0)
    m.lat = readI32(payload, 8)
    m.lon = readI32(payload, 12)
    m.alt = readI32(payload, 16)
    m.relativeAlt = readI32(payload, 20)
    m.nextLat = readI32(payload, 24)
    m.nextLon = readI32(payload, 28)
    m.nextAlt = readI32(payload, 32)
    m.vx = readI16(payload, 36)
    m.vy = readI16(payload, 38)
    m.vz = readI16(payload, 40)
    m.hAcc = readU16(payload, 42)
    m.vAcc = readU16(payload, 44)
    m.velAcc = readU16(payload, 46)
    m.updateRate = readU16(payload, 48)
    for (let i = 0; i < 18; i++) {
      m.uasId.push(readU8(payload, 50 + i * 1))
    }
    m.flightState = readU8(payload, 68)
    m.flags = readU8(payload, 69)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.time)
    writeUint(into, at + 8, 4, this.lat as int)
    writeUint(into, at + 12, 4, this.lon as int)
    writeUint(into, at + 16, 4, this.alt as int)
    writeUint(into, at + 20, 4, this.relativeAlt as int)
    writeUint(into, at + 24, 4, this.nextLat as int)
    writeUint(into, at + 28, 4, this.nextLon as int)
    writeUint(into, at + 32, 4, this.nextAlt as int)
    writeUint(into, at + 36, 2, this.vx as int)
    writeUint(into, at + 38, 2, this.vy as int)
    writeUint(into, at + 40, 2, this.vz as int)
    writeUint(into, at + 42, 2, this.hAcc as int)
    writeUint(into, at + 44, 2, this.vAcc as int)
    writeUint(into, at + 46, 2, this.velAcc as int)
    writeUint(into, at + 48, 2, this.updateRate as int)
    for (let i = 0; i < 18 && i < this.uasId.length; i++) {
      writeUint(into, at + 50 + i * 1, 1, this.uasId[i] as int)
    }
    writeUint(into, at + 68, 1, this.flightState as int)
    writeUint(into, at + 69, 1, this.flags as int)
  }

  public override info(): MessageInfo {
    UtmGlobalPosition.INFO
  }
}

/// Large debug/prototyping array. The message uses the maximum available payload for data. The array_id
/// and name fields are used to discriminate between messages in code and in user interfaces
/// (respectively). Do not use in production code.
export class DebugFloatArray extends MavLinkData {
  public static readonly MSG_ID: int = 350
  public static readonly MSG_NAME: string = "DEBUG_FLOAT_ARRAY"
  public static readonly PAYLOAD_LENGTH: int = 252
  public static readonly MAGIC_NUMBER: int = 232
  public static readonly INFO: MessageInfo = new MessageInfo(350, "DEBUG_FLOAT_ARRAY", 252, 20, 232, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("array_id", "arrayId", 8, false, 2, "uint16_t", ""),
    new MavLinkPacketField("name", "name", 10, false, 1, "char[]", "", 10),
    new MavLinkPacketField("data", "data", 20, true, 4, "float[]", "", 58),
  ], (p) => DebugFloatArray.decode(p))

  /// Timestamp (UNIX Epoch time or time since system boot). The receiving end can infer timestamp format
  /// (since 1.1.1970 or since system boot) by checking for the magnitude of the number.
  /// Units: us.
  public timeUsec: u64 = 0

  /// Name, for human-friendly display in a Ground Control Station
  public name: string = ""

  /// Unique ID used to discriminate between arrays
  public arrayId: u16 = 0

  /// data
  public data: f32[] = []

  /// A DEBUG_FLOAT_ARRAY from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): DebugFloatArray {
    const m = new DebugFloatArray()
    m.timeUsec = readU64(payload, 0)
    m.arrayId = readU16(payload, 8)
    m.name = readChars(payload, 10, 10)
    for (let i = 0; i < 58; i++) {
      m.data.push(readF32(payload, 20 + i * 4))
    }
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    writeUint(into, at + 8, 2, this.arrayId as int)
    writeChars(into, at + 10, 10, this.name)
    for (let i = 0; i < 58 && i < this.data.length; i++) {
      writeF32(into, at + 20 + i * 4, this.data[i])
    }
  }

  public override info(): MessageInfo {
    DebugFloatArray.INFO
  }
}

/// Vehicle status report that is sent out while orbit execution is in progress (see MAV_CMD_DO_ORBIT).
export class OrbitExecutionStatus extends MavLinkData {
  public static readonly MSG_ID: int = 360
  public static readonly MSG_NAME: string = "ORBIT_EXECUTION_STATUS"
  public static readonly PAYLOAD_LENGTH: int = 25
  public static readonly MAGIC_NUMBER: int = 11
  public static readonly INFO: MessageInfo = new MessageInfo(360, "ORBIT_EXECUTION_STATUS", 25, 25, 11, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("radius", "radius", 8, false, 4, "float", "m"),
    new MavLinkPacketField("x", "x", 12, false, 4, "int32_t", ""),
    new MavLinkPacketField("y", "y", 16, false, 4, "int32_t", ""),
    new MavLinkPacketField("z", "z", 20, false, 4, "float", "m"),
    new MavLinkPacketField("frame", "frame", 24, false, 1, "uint8_t", ""),
  ], (p) => OrbitExecutionStatus.decode(p))

  /// Timestamp (UNIX Epoch time or time since system boot). The receiving end can infer timestamp format
  /// (since 1.1.1970 or since system boot) by checking for the magnitude of the number.
  /// Units: us.
  public timeUsec: u64 = 0

  /// Radius of the orbit circle. Positive values orbit clockwise, negative values orbit
  /// counter-clockwise.
  /// Units: m.
  public radius: f32 = 0.0

  /// The coordinate system of the fields: x, y, z.
  /// Values: `MavFrame`.
  public frame: u8 = 0

  /// X coordinate of center point. Coordinate system depends on frame field: local = x position in meters
  /// * 1e4, global = latitude in degrees * 1e7.
  public x: i32 = 0

  /// Y coordinate of center point. Coordinate system depends on frame field: local = x position in meters
  /// * 1e4, global = latitude in degrees * 1e7.
  public y: i32 = 0

  /// Altitude of center point. Coordinate system depends on frame field.
  /// Units: m.
  public z: f32 = 0.0

  /// A ORBIT_EXECUTION_STATUS from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): OrbitExecutionStatus {
    const m = new OrbitExecutionStatus()
    m.timeUsec = readU64(payload, 0)
    m.radius = readF32(payload, 8)
    m.x = readI32(payload, 12)
    m.y = readI32(payload, 16)
    m.z = readF32(payload, 20)
    m.frame = readU8(payload, 24)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    writeF32(into, at + 8, this.radius)
    writeUint(into, at + 12, 4, this.x as int)
    writeUint(into, at + 16, 4, this.y as int)
    writeF32(into, at + 20, this.z)
    writeUint(into, at + 24, 1, this.frame as int)
  }

  public override info(): MessageInfo {
    OrbitExecutionStatus.INFO
  }
}

/// Smart Battery information (static/infrequent update). Use for updates from: smart battery to flight
/// stack, flight stack to GCS. Use BATTERY_STATUS for the frequent battery updates.
export class SmartBatteryInfo extends MavLinkData {
  public static readonly MSG_ID: int = 370
  public static readonly MSG_NAME: string = "SMART_BATTERY_INFO"
  public static readonly PAYLOAD_LENGTH: int = 109
  public static readonly MAGIC_NUMBER: int = 75
  public static readonly INFO: MessageInfo = new MessageInfo(370, "SMART_BATTERY_INFO", 109, 87, 75, [
    new MavLinkPacketField("capacity_full_specification", "capacityFullSpecification", 0, false, 4, "int32_t", "mAh"),
    new MavLinkPacketField("capacity_full", "capacityFull", 4, false, 4, "int32_t", "mAh"),
    new MavLinkPacketField("cycle_count", "cycleCount", 8, false, 2, "uint16_t", ""),
    new MavLinkPacketField("weight", "weight", 10, false, 2, "uint16_t", "g"),
    new MavLinkPacketField("discharge_minimum_voltage", "dischargeMinimumVoltage", 12, false, 2, "uint16_t", "mV"),
    new MavLinkPacketField("charging_minimum_voltage", "chargingMinimumVoltage", 14, false, 2, "uint16_t", "mV"),
    new MavLinkPacketField("resting_minimum_voltage", "restingMinimumVoltage", 16, false, 2, "uint16_t", "mV"),
    new MavLinkPacketField("id", "id", 18, false, 1, "uint8_t", ""),
    new MavLinkPacketField("battery_function", "batteryFunction", 19, false, 1, "uint8_t", ""),
    new MavLinkPacketField("type", "type", 20, false, 1, "uint8_t", ""),
    new MavLinkPacketField("serial_number", "serialNumber", 21, false, 1, "char[]", "", 16),
    new MavLinkPacketField("device_name", "deviceName", 37, false, 1, "char[]", "", 50),
    new MavLinkPacketField("charging_maximum_voltage", "chargingMaximumVoltage", 87, true, 2, "uint16_t", "mV"),
    new MavLinkPacketField("cells_in_series", "cellsInSeries", 89, true, 1, "uint8_t", ""),
    new MavLinkPacketField("discharge_maximum_current", "dischargeMaximumCurrent", 90, true, 4, "uint32_t", "mA"),
    new MavLinkPacketField("discharge_maximum_burst_current", "dischargeMaximumBurstCurrent", 94, true, 4, "uint32_t", "mA"),
    new MavLinkPacketField("manufacture_date", "manufactureDate", 98, true, 1, "char[]", "", 11),
  ], (p) => SmartBatteryInfo.decode(p))

  /// Battery ID
  public id: u8 = 0

  /// Function of the battery
  /// Values: `MavBatteryFunction`.
  public batteryFunction: u8 = 0

  /// Type (chemistry) of the battery
  /// Values: `MavBatteryType`.
  public type: u8 = 0

  /// Capacity when full according to manufacturer, -1: field not provided.
  /// Units: mAh.
  public capacityFullSpecification: i32 = 0

  /// Capacity when full (accounting for battery degradation), -1: field not provided.
  /// Units: mAh.
  public capacityFull: i32 = 0

  /// Charge/discharge cycle count. UINT16_MAX: field not provided.
  public cycleCount: u16 = 0

  /// Serial number in ASCII characters, 0 terminated. All 0: field not provided.
  public serialNumber: string = ""

  /// Static device name in ASCII characters, 0 terminated. All 0: field not provided. Encode as
  /// manufacturer name then product name separated using an underscore.
  public deviceName: string = ""

  /// Battery weight. 0: field not provided.
  /// Units: g.
  public weight: u16 = 0

  /// Minimum per-cell voltage when discharging. If not supplied set to UINT16_MAX value.
  /// Units: mV.
  public dischargeMinimumVoltage: u16 = 0

  /// Minimum per-cell voltage when charging. If not supplied set to UINT16_MAX value.
  /// Units: mV.
  public chargingMinimumVoltage: u16 = 0

  /// Minimum per-cell voltage when resting. If not supplied set to UINT16_MAX value.
  /// Units: mV.
  public restingMinimumVoltage: u16 = 0

  /// Maximum per-cell voltage when charged. 0: field not provided.
  /// Units: mV.
  public chargingMaximumVoltage: u16 = 0

  /// Number of battery cells in series. 0: field not provided.
  public cellsInSeries: u8 = 0

  /// Maximum pack discharge current. 0: field not provided.
  /// Units: mA.
  public dischargeMaximumCurrent: u32 = 0

  /// Maximum pack discharge burst current. 0: field not provided.
  /// Units: mA.
  public dischargeMaximumBurstCurrent: u32 = 0

  /// Manufacture date (DD/MM/YYYY) in ASCII characters, 0 terminated. All 0: field not provided.
  public manufactureDate: string = ""

  /// A SMART_BATTERY_INFO from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): SmartBatteryInfo {
    const m = new SmartBatteryInfo()
    m.capacityFullSpecification = readI32(payload, 0)
    m.capacityFull = readI32(payload, 4)
    m.cycleCount = readU16(payload, 8)
    m.weight = readU16(payload, 10)
    m.dischargeMinimumVoltage = readU16(payload, 12)
    m.chargingMinimumVoltage = readU16(payload, 14)
    m.restingMinimumVoltage = readU16(payload, 16)
    m.id = readU8(payload, 18)
    m.batteryFunction = readU8(payload, 19)
    m.type = readU8(payload, 20)
    m.serialNumber = readChars(payload, 21, 16)
    m.deviceName = readChars(payload, 37, 50)
    m.chargingMaximumVoltage = readU16(payload, 87)
    m.cellsInSeries = readU8(payload, 89)
    m.dischargeMaximumCurrent = readU32(payload, 90)
    m.dischargeMaximumBurstCurrent = readU32(payload, 94)
    m.manufactureDate = readChars(payload, 98, 11)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.capacityFullSpecification as int)
    writeUint(into, at + 4, 4, this.capacityFull as int)
    writeUint(into, at + 8, 2, this.cycleCount as int)
    writeUint(into, at + 10, 2, this.weight as int)
    writeUint(into, at + 12, 2, this.dischargeMinimumVoltage as int)
    writeUint(into, at + 14, 2, this.chargingMinimumVoltage as int)
    writeUint(into, at + 16, 2, this.restingMinimumVoltage as int)
    writeUint(into, at + 18, 1, this.id as int)
    writeUint(into, at + 19, 1, this.batteryFunction as int)
    writeUint(into, at + 20, 1, this.type as int)
    writeChars(into, at + 21, 16, this.serialNumber)
    writeChars(into, at + 37, 50, this.deviceName)
    writeUint(into, at + 87, 2, this.chargingMaximumVoltage as int)
    writeUint(into, at + 89, 1, this.cellsInSeries as int)
    writeUint(into, at + 90, 4, this.dischargeMaximumCurrent as int)
    writeUint(into, at + 94, 4, this.dischargeMaximumBurstCurrent as int)
    writeChars(into, at + 98, 11, this.manufactureDate)
  }

  public override info(): MessageInfo {
    SmartBatteryInfo.INFO
  }
}

/// Vehicle status report that is sent out while figure eight execution is in progress (see
/// MAV_CMD_DO_FIGURE_EIGHT). This may typically send at low rates: of the order of 2Hz.
export class FigureEightExecutionStatus extends MavLinkData {
  public static readonly MSG_ID: int = 361
  public static readonly MSG_NAME: string = "FIGURE_EIGHT_EXECUTION_STATUS"
  public static readonly PAYLOAD_LENGTH: int = 33
  public static readonly MAGIC_NUMBER: int = 93
  public static readonly INFO: MessageInfo = new MessageInfo(361, "FIGURE_EIGHT_EXECUTION_STATUS", 33, 33, 93, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("major_radius", "majorRadius", 8, false, 4, "float", "m"),
    new MavLinkPacketField("minor_radius", "minorRadius", 12, false, 4, "float", "m"),
    new MavLinkPacketField("orientation", "orientation", 16, false, 4, "float", "rad"),
    new MavLinkPacketField("x", "x", 20, false, 4, "int32_t", ""),
    new MavLinkPacketField("y", "y", 24, false, 4, "int32_t", ""),
    new MavLinkPacketField("z", "z", 28, false, 4, "float", "m"),
    new MavLinkPacketField("frame", "frame", 32, false, 1, "uint8_t", ""),
  ], (p) => FigureEightExecutionStatus.decode(p))

  /// Timestamp (UNIX Epoch time or time since system boot). The receiving end can infer timestamp format
  /// (since 1.1.1970 or since system boot) by checking for the magnitude of the number.
  /// Units: us.
  public timeUsec: u64 = 0

  /// Major axis radius of the figure eight. Positive: orbit the north circle clockwise. Negative: orbit
  /// the north circle counter-clockwise.
  /// Units: m.
  public majorRadius: f32 = 0.0

  /// Minor axis radius of the figure eight. Defines the radius of two circles that make up the figure.
  /// Units: m.
  public minorRadius: f32 = 0.0

  /// Orientation of the figure eight major axis with respect to true north in [-pi,pi).
  /// Units: rad.
  public orientation: f32 = 0.0

  /// The coordinate system of the fields: x, y, z.
  /// Values: `MavFrame`.
  public frame: u8 = 0

  /// X coordinate of center point. Coordinate system depends on frame field.
  public x: i32 = 0

  /// Y coordinate of center point. Coordinate system depends on frame field.
  public y: i32 = 0

  /// Altitude of center point. Coordinate system depends on frame field.
  /// Units: m.
  public z: f32 = 0.0

  /// A FIGURE_EIGHT_EXECUTION_STATUS from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): FigureEightExecutionStatus {
    const m = new FigureEightExecutionStatus()
    m.timeUsec = readU64(payload, 0)
    m.majorRadius = readF32(payload, 8)
    m.minorRadius = readF32(payload, 12)
    m.orientation = readF32(payload, 16)
    m.x = readI32(payload, 20)
    m.y = readI32(payload, 24)
    m.z = readF32(payload, 28)
    m.frame = readU8(payload, 32)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    writeF32(into, at + 8, this.majorRadius)
    writeF32(into, at + 12, this.minorRadius)
    writeF32(into, at + 16, this.orientation)
    writeUint(into, at + 20, 4, this.x as int)
    writeUint(into, at + 24, 4, this.y as int)
    writeF32(into, at + 28, this.z)
    writeUint(into, at + 32, 1, this.frame as int)
  }

  public override info(): MessageInfo {
    FigureEightExecutionStatus.INFO
  }
}

/// Fuel status. This message provides "generic" fuel level information for in a GCS and for triggering
/// failsafes in an autopilot. The fuel type and associated units for fields in this message are defined
/// in the enum MAV_FUEL_TYPE. The reported `consumed_fuel` and `remaining_fuel` must only be supplied
/// if measured: they must not be inferred from the `maximum_fuel` and the other value. A recipient can
/// assume that if these fields are supplied they are accurate. If not provided, the recipient can infer
/// `remaining_fuel` from `maximum_fuel` and `consumed_fuel` on the assumption that the fuel was
/// initially at its maximum (this is what battery monitors assume). Note however that this is an
/// assumption, and the UI should prompt the user appropriately (i.e. notify user that they should fill
/// the tank before boot). This kind of information may also be sent in fuel-specific messages such as
/// BATTERY_STATUS_V2. If both messages are sent for the same fuel system, the ids and corresponding
/// information must match. This should be streamed (nominally at 0.1 Hz).
export class FuelStatus extends MavLinkData {
  public static readonly MSG_ID: int = 371
  public static readonly MSG_NAME: string = "FUEL_STATUS"
  public static readonly PAYLOAD_LENGTH: int = 26
  public static readonly MAGIC_NUMBER: int = 10
  public static readonly INFO: MessageInfo = new MessageInfo(371, "FUEL_STATUS", 26, 26, 10, [
    new MavLinkPacketField("maximum_fuel", "maximumFuel", 0, false, 4, "float", ""),
    new MavLinkPacketField("consumed_fuel", "consumedFuel", 4, false, 4, "float", ""),
    new MavLinkPacketField("remaining_fuel", "remainingFuel", 8, false, 4, "float", ""),
    new MavLinkPacketField("flow_rate", "flowRate", 12, false, 4, "float", ""),
    new MavLinkPacketField("temperature", "temperature", 16, false, 4, "float", "K"),
    new MavLinkPacketField("fuel_type", "fuelType", 20, false, 4, "uint32_t", ""),
    new MavLinkPacketField("id", "id", 24, false, 1, "uint8_t", ""),
    new MavLinkPacketField("percent_remaining", "percentRemaining", 25, false, 1, "uint8_t", "%"),
  ], (p) => FuelStatus.decode(p))

  /// Fuel ID. Must match ID of other messages for same fuel system, such as BATTERY_STATUS_V2.
  public id: u8 = 0

  /// Capacity when full. Must be provided.
  public maximumFuel: f32 = 0.0

  /// Consumed fuel (measured). This value should not be inferred: if not measured set to NaN. NaN: field
  /// not provided.
  public consumedFuel: f32 = 0.0

  /// Remaining fuel until empty (measured). The value should not be inferred: if not measured set to NaN.
  /// NaN: field not provided.
  public remainingFuel: f32 = 0.0

  /// Percentage of remaining fuel, relative to full. Values: [0-100], UINT8_MAX: field not provided.
  /// Units: %.
  public percentRemaining: u8 = 0

  /// Positive value when emptying/using, and negative if filling/replacing. NaN: field not provided.
  public flowRate: f32 = 0.0

  /// Fuel temperature. NaN: field not provided.
  /// Units: K.
  public temperature: f32 = 0.0

  /// Fuel type. Defines units for fuel capacity and consumption fields above.
  /// Values: `MavFuelType`.
  public fuelType: u32 = 0

  /// A FUEL_STATUS from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): FuelStatus {
    const m = new FuelStatus()
    m.maximumFuel = readF32(payload, 0)
    m.consumedFuel = readF32(payload, 4)
    m.remainingFuel = readF32(payload, 8)
    m.flowRate = readF32(payload, 12)
    m.temperature = readF32(payload, 16)
    m.fuelType = readU32(payload, 20)
    m.id = readU8(payload, 24)
    m.percentRemaining = readU8(payload, 25)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeF32(into, at + 0, this.maximumFuel)
    writeF32(into, at + 4, this.consumedFuel)
    writeF32(into, at + 8, this.remainingFuel)
    writeF32(into, at + 12, this.flowRate)
    writeF32(into, at + 16, this.temperature)
    writeUint(into, at + 20, 4, this.fuelType as int)
    writeUint(into, at + 24, 1, this.id as int)
    writeUint(into, at + 25, 1, this.percentRemaining as int)
  }

  public override info(): MessageInfo {
    FuelStatus.INFO
  }
}

/// Telemetry of power generation system. Alternator or mechanical generator.
export class GeneratorStatus extends MavLinkData {
  public static readonly MSG_ID: int = 373
  public static readonly MSG_NAME: string = "GENERATOR_STATUS"
  public static readonly PAYLOAD_LENGTH: int = 42
  public static readonly MAGIC_NUMBER: int = 117
  public static readonly INFO: MessageInfo = new MessageInfo(373, "GENERATOR_STATUS", 42, 42, 117, [
    new MavLinkPacketField("status", "status", 0, false, 8, "uint64_t", ""),
    new MavLinkPacketField("battery_current", "batteryCurrent", 8, false, 4, "float", "A"),
    new MavLinkPacketField("load_current", "loadCurrent", 12, false, 4, "float", "A"),
    new MavLinkPacketField("power_generated", "powerGenerated", 16, false, 4, "float", "W"),
    new MavLinkPacketField("bus_voltage", "busVoltage", 20, false, 4, "float", "V"),
    new MavLinkPacketField("bat_current_setpoint", "batCurrentSetpoint", 24, false, 4, "float", "A"),
    new MavLinkPacketField("runtime", "runtime", 28, false, 4, "uint32_t", "s"),
    new MavLinkPacketField("time_until_maintenance", "timeUntilMaintenance", 32, false, 4, "int32_t", "s"),
    new MavLinkPacketField("generator_speed", "generatorSpeed", 36, false, 2, "uint16_t", "rpm"),
    new MavLinkPacketField("rectifier_temperature", "rectifierTemperature", 38, false, 2, "int16_t", "degC"),
    new MavLinkPacketField("generator_temperature", "generatorTemperature", 40, false, 2, "int16_t", "degC"),
  ], (p) => GeneratorStatus.decode(p))

  /// Status flags.
  /// Values: `MavGeneratorStatusFlag`.
  public status: u64 = 0

  /// Speed of electrical generator or alternator. UINT16_MAX: field not provided.
  /// Units: rpm.
  public generatorSpeed: u16 = 0

  /// Current into/out of battery. Positive for out. Negative for in. NaN: field not provided.
  /// Units: A.
  public batteryCurrent: f32 = 0.0

  /// Current going to the UAV. If battery current not available this is the DC current from the
  /// generator. Positive for out. Negative for in. NaN: field not provided
  /// Units: A.
  public loadCurrent: f32 = 0.0

  /// The power being generated. NaN: field not provided
  /// Units: W.
  public powerGenerated: f32 = 0.0

  /// Voltage of the bus seen at the generator, or battery bus if battery bus is controlled by generator
  /// and at a different voltage to main bus.
  /// Units: V.
  public busVoltage: f32 = 0.0

  /// The temperature of the rectifier or power converter. INT16_MAX: field not provided.
  /// Units: degC.
  public rectifierTemperature: i16 = 0

  /// The target battery current. Positive for out. Negative for in. NaN: field not provided
  /// Units: A.
  public batCurrentSetpoint: f32 = 0.0

  /// The temperature of the mechanical motor, fuel cell core or generator. INT16_MAX: field not provided.
  /// Units: degC.
  public generatorTemperature: i16 = 0

  /// Seconds this generator has run since it was rebooted. UINT32_MAX: field not provided.
  /// Units: s.
  public runtime: u32 = 0

  /// Seconds until this generator requires maintenance. A negative value indicates maintenance is
  /// past-due. INT32_MAX: field not provided.
  /// Units: s.
  public timeUntilMaintenance: i32 = 0

  /// A GENERATOR_STATUS from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): GeneratorStatus {
    const m = new GeneratorStatus()
    m.status = readU64(payload, 0)
    m.batteryCurrent = readF32(payload, 8)
    m.loadCurrent = readF32(payload, 12)
    m.powerGenerated = readF32(payload, 16)
    m.busVoltage = readF32(payload, 20)
    m.batCurrentSetpoint = readF32(payload, 24)
    m.runtime = readU32(payload, 28)
    m.timeUntilMaintenance = readI32(payload, 32)
    m.generatorSpeed = readU16(payload, 36)
    m.rectifierTemperature = readI16(payload, 38)
    m.generatorTemperature = readI16(payload, 40)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.status)
    writeF32(into, at + 8, this.batteryCurrent)
    writeF32(into, at + 12, this.loadCurrent)
    writeF32(into, at + 16, this.powerGenerated)
    writeF32(into, at + 20, this.busVoltage)
    writeF32(into, at + 24, this.batCurrentSetpoint)
    writeUint(into, at + 28, 4, this.runtime as int)
    writeUint(into, at + 32, 4, this.timeUntilMaintenance as int)
    writeUint(into, at + 36, 2, this.generatorSpeed as int)
    writeUint(into, at + 38, 2, this.rectifierTemperature as int)
    writeUint(into, at + 40, 2, this.generatorTemperature as int)
  }

  public override info(): MessageInfo {
    GeneratorStatus.INFO
  }
}

/// The raw values of the actuator outputs (e.g. on Pixhawk, from MAIN, AUX ports). This message
/// supersedes SERVO_OUTPUT_RAW.
export class ActuatorOutputStatus extends MavLinkData {
  public static readonly MSG_ID: int = 375
  public static readonly MSG_NAME: string = "ACTUATOR_OUTPUT_STATUS"
  public static readonly PAYLOAD_LENGTH: int = 140
  public static readonly MAGIC_NUMBER: int = 251
  public static readonly INFO: MessageInfo = new MessageInfo(375, "ACTUATOR_OUTPUT_STATUS", 140, 140, 251, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("active", "active", 8, false, 4, "uint32_t", ""),
    new MavLinkPacketField("actuator", "actuator", 12, false, 4, "float[]", "", 32),
  ], (p) => ActuatorOutputStatus.decode(p))

  /// Timestamp (since system boot).
  /// Units: us.
  public timeUsec: u64 = 0

  /// Active outputs
  public active: u32 = 0

  /// Servo / motor output array values. Zero values indicate unused channels.
  public actuator: f32[] = []

  /// A ACTUATOR_OUTPUT_STATUS from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): ActuatorOutputStatus {
    const m = new ActuatorOutputStatus()
    m.timeUsec = readU64(payload, 0)
    m.active = readU32(payload, 8)
    for (let i = 0; i < 32; i++) {
      m.actuator.push(readF32(payload, 12 + i * 4))
    }
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    writeUint(into, at + 8, 4, this.active as int)
    for (let i = 0; i < 32 && i < this.actuator.length; i++) {
      writeF32(into, at + 12 + i * 4, this.actuator[i])
    }
  }

  public override info(): MessageInfo {
    ActuatorOutputStatus.INFO
  }
}

/// Reports the on/off state of relays, as controlled by MAV_CMD_DO_SET_RELAY. Message streaming should
/// be requested using MAV_CMD_SET_MESSAGE_INTERVAL. Note that it should not be sent on every relay
/// state change to avoid flooding the link.
export class RelayStatus extends MavLinkData {
  public static readonly MSG_ID: int = 376
  public static readonly MSG_NAME: string = "RELAY_STATUS"
  public static readonly PAYLOAD_LENGTH: int = 8
  public static readonly MAGIC_NUMBER: int = 199
  public static readonly INFO: MessageInfo = new MessageInfo(376, "RELAY_STATUS", 8, 8, 199, [
    new MavLinkPacketField("time_boot_ms", "timeBootMs", 0, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("on", "on", 4, false, 2, "uint16_t", ""),
    new MavLinkPacketField("present", "present", 6, false, 2, "uint16_t", ""),
  ], (p) => RelayStatus.decode(p))

  /// Timestamp (time since system boot).
  /// Units: ms.
  public timeBootMs: u32 = 0

  /// Relay states. Relay instance numbers are represented as individual bits in this mask by offset.
  public on: u16 = 0

  /// Relay present. Relay instance numbers are represented as individual bits in this mask by offset.
  /// Bits will be true if a relay instance is configured.
  public present: u16 = 0

  /// A RELAY_STATUS from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): RelayStatus {
    const m = new RelayStatus()
    m.timeBootMs = readU32(payload, 0)
    m.on = readU16(payload, 4)
    m.present = readU16(payload, 6)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.timeBootMs as int)
    writeUint(into, at + 4, 2, this.on as int)
    writeUint(into, at + 6, 2, this.present as int)
  }

  public override info(): MessageInfo {
    RelayStatus.INFO
  }
}

/// Message for transporting "arbitrary" variable-length data from one component to another (broadcast
/// is not forbidden, but discouraged). The encoding of the data is usually extension specific, i.e.
/// determined by the source, and is usually not documented as part of the MAVLink specification.
export class Tunnel extends MavLinkData {
  public static readonly MSG_ID: int = 385
  public static readonly MSG_NAME: string = "TUNNEL"
  public static readonly PAYLOAD_LENGTH: int = 133
  public static readonly MAGIC_NUMBER: int = 147
  public static readonly INFO: MessageInfo = new MessageInfo(385, "TUNNEL", 133, 133, 147, [
    new MavLinkPacketField("payload_type", "payloadType", 0, false, 2, "uint16_t", ""),
    new MavLinkPacketField("target_system", "targetSystem", 2, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 3, false, 1, "uint8_t", ""),
    new MavLinkPacketField("payload_length", "payloadLength", 4, false, 1, "uint8_t", ""),
    new MavLinkPacketField("payload", "payload", 5, false, 1, "uint8_t[]", "", 128),
  ], (p) => Tunnel.decode(p))

  /// System ID (can be 0 for broadcast, but this is discouraged)
  public targetSystem: u8 = 0

  /// Component ID (can be 0 for broadcast, but this is discouraged)
  public targetComponent: u8 = 0

  /// A code that identifies the content of the payload (0 for unknown, which is the default). If this
  /// code is less than 32768, it is a 'registered' payload type and the corresponding code should be
  /// added to the MAV_TUNNEL_PAYLOAD_TYPE enum. Software creators can register blocks of types as needed.
  /// Codes greater than 32767 are considered local experiments and should not be checked in to any widely
  /// distributed codebase.
  /// Values: `MavTunnelPayloadType`.
  public payloadType: u16 = 0

  /// Length of the data transported in payload
  public payloadLength: u8 = 0

  /// Variable length payload. The payload length is defined by payload_length. The entire content of this
  /// block is opaque unless you understand the encoding specified by payload_type.
  public payload: u8[] = []

  /// A TUNNEL from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): Tunnel {
    const m = new Tunnel()
    m.payloadType = readU16(payload, 0)
    m.targetSystem = readU8(payload, 2)
    m.targetComponent = readU8(payload, 3)
    m.payloadLength = readU8(payload, 4)
    for (let i = 0; i < 128; i++) {
      m.payload.push(readU8(payload, 5 + i * 1))
    }
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 2, this.payloadType as int)
    writeUint(into, at + 2, 1, this.targetSystem as int)
    writeUint(into, at + 3, 1, this.targetComponent as int)
    writeUint(into, at + 4, 1, this.payloadLength as int)
    for (let i = 0; i < 128 && i < this.payload.length; i++) {
      writeUint(into, at + 5 + i * 1, 1, this.payload[i] as int)
    }
  }

  public override info(): MessageInfo {
    Tunnel.INFO
  }
}

/// A forwarded CAN frame as requested by MAV_CMD_CAN_FORWARD.
export class CanFrame extends MavLinkData {
  public static readonly MSG_ID: int = 386
  public static readonly MSG_NAME: string = "CAN_FRAME"
  public static readonly PAYLOAD_LENGTH: int = 16
  public static readonly MAGIC_NUMBER: int = 132
  public static readonly INFO: MessageInfo = new MessageInfo(386, "CAN_FRAME", 16, 16, 132, [
    new MavLinkPacketField("id", "id", 0, false, 4, "uint32_t", ""),
    new MavLinkPacketField("target_system", "targetSystem", 4, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 5, false, 1, "uint8_t", ""),
    new MavLinkPacketField("bus", "bus", 6, false, 1, "uint8_t", ""),
    new MavLinkPacketField("len", "len", 7, false, 1, "uint8_t", ""),
    new MavLinkPacketField("data", "data", 8, false, 1, "uint8_t[]", "", 8),
  ], (p) => CanFrame.decode(p))

  /// System ID.
  public targetSystem: u8 = 0

  /// Component ID.
  public targetComponent: u8 = 0

  /// Bus number
  public bus: u8 = 0

  /// Frame length
  public len: u8 = 0

  /// Frame ID
  public id: u32 = 0

  /// Frame data
  public data: u8[] = []

  /// A CAN_FRAME from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): CanFrame {
    const m = new CanFrame()
    m.id = readU32(payload, 0)
    m.targetSystem = readU8(payload, 4)
    m.targetComponent = readU8(payload, 5)
    m.bus = readU8(payload, 6)
    m.len = readU8(payload, 7)
    for (let i = 0; i < 8; i++) {
      m.data.push(readU8(payload, 8 + i * 1))
    }
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.id as int)
    writeUint(into, at + 4, 1, this.targetSystem as int)
    writeUint(into, at + 5, 1, this.targetComponent as int)
    writeUint(into, at + 6, 1, this.bus as int)
    writeUint(into, at + 7, 1, this.len as int)
    for (let i = 0; i < 8 && i < this.data.length; i++) {
      writeUint(into, at + 8 + i * 1, 1, this.data[i] as int)
    }
  }

  public override info(): MessageInfo {
    CanFrame.INFO
  }
}

/// Hardware status sent by an onboard computer.
export class OnboardComputerStatus extends MavLinkData {
  public static readonly MSG_ID: int = 390
  public static readonly MSG_NAME: string = "ONBOARD_COMPUTER_STATUS"
  public static readonly PAYLOAD_LENGTH: int = 240
  public static readonly MAGIC_NUMBER: int = 156
  public static readonly INFO: MessageInfo = new MessageInfo(390, "ONBOARD_COMPUTER_STATUS", 240, 238, 156, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("uptime", "uptime", 8, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("ram_usage", "ramUsage", 12, false, 4, "uint32_t", "MiB"),
    new MavLinkPacketField("ram_total", "ramTotal", 16, false, 4, "uint32_t", "MiB"),
    new MavLinkPacketField("storage_type", "storageType", 20, false, 4, "uint32_t[]", "", 4),
    new MavLinkPacketField("storage_usage", "storageUsage", 36, false, 4, "uint32_t[]", "MiB", 4),
    new MavLinkPacketField("storage_total", "storageTotal", 52, false, 4, "uint32_t[]", "MiB", 4),
    new MavLinkPacketField("link_type", "linkType", 68, false, 4, "uint32_t[]", "", 6),
    new MavLinkPacketField("link_tx_rate", "linkTxRate", 92, false, 4, "uint32_t[]", "KiB/s", 6),
    new MavLinkPacketField("link_rx_rate", "linkRxRate", 116, false, 4, "uint32_t[]", "KiB/s", 6),
    new MavLinkPacketField("link_tx_max", "linkTxMax", 140, false, 4, "uint32_t[]", "KiB/s", 6),
    new MavLinkPacketField("link_rx_max", "linkRxMax", 164, false, 4, "uint32_t[]", "KiB/s", 6),
    new MavLinkPacketField("fan_speed", "fanSpeed", 188, false, 2, "int16_t[]", "rpm", 4),
    new MavLinkPacketField("type", "type", 196, false, 1, "uint8_t", ""),
    new MavLinkPacketField("cpu_cores", "cpuCores", 197, false, 1, "uint8_t[]", "", 8),
    new MavLinkPacketField("cpu_combined", "cpuCombined", 205, false, 1, "uint8_t[]", "", 10),
    new MavLinkPacketField("gpu_cores", "gpuCores", 215, false, 1, "uint8_t[]", "", 4),
    new MavLinkPacketField("gpu_combined", "gpuCombined", 219, false, 1, "uint8_t[]", "", 10),
    new MavLinkPacketField("temperature_board", "temperatureBoard", 229, false, 1, "int8_t", "degC"),
    new MavLinkPacketField("temperature_core", "temperatureCore", 230, false, 1, "int8_t[]", "degC", 8),
    new MavLinkPacketField("status_flags", "statusFlags", 238, true, 2, "uint16_t", ""),
  ], (p) => OnboardComputerStatus.decode(p))

  /// Timestamp (UNIX Epoch time or time since system boot). The receiving end can infer timestamp format
  /// (since 1.1.1970 or since system boot) by checking for the magnitude of the number.
  /// Units: us.
  public timeUsec: u64 = 0

  /// Time since system boot.
  /// Units: ms.
  public uptime: u32 = 0

  /// Type of the onboard computer: 0: Mission computer primary, 1: Mission computer backup 1, 2: Mission
  /// computer backup 2, 3: Compute node, 4-5: Compute spares, 6-9: Payload computers.
  public type: u8 = 0

  /// CPU usage on the component in percent (100 - idle). A value of UINT8_MAX implies the field is
  /// unused.
  public cpuCores: u8[] = []

  /// Combined CPU usage as the last 10 slices of 100 MS (a histogram). This allows to identify spikes in
  /// load that max out the system, but only for a short amount of time. A value of UINT8_MAX implies the
  /// field is unused.
  public cpuCombined: u8[] = []

  /// GPU usage on the component in percent (100 - idle). A value of UINT8_MAX implies the field is
  /// unused.
  public gpuCores: u8[] = []

  /// Combined GPU usage as the last 10 slices of 100 MS (a histogram). This allows to identify spikes in
  /// load that max out the system, but only for a short amount of time. A value of UINT8_MAX implies the
  /// field is unused.
  public gpuCombined: u8[] = []

  /// Temperature of the board. A value of INT8_MAX implies the field is unused.
  /// Units: degC.
  public temperatureBoard: i8 = 0

  /// Temperature of the CPU core. A value of INT8_MAX implies the field is unused.
  /// Units: degC.
  public temperatureCore: i8[] = []

  /// Fan speeds. A value of INT16_MAX implies the field is unused.
  /// Units: rpm.
  public fanSpeed: i16[] = []

  /// Amount of used RAM on the component system. A value of UINT32_MAX implies the field is unused.
  /// Units: MiB.
  public ramUsage: u32 = 0

  /// Total amount of RAM on the component system. A value of UINT32_MAX implies the field is unused.
  /// Units: MiB.
  public ramTotal: u32 = 0

  /// Storage type: 0: HDD, 1: SSD, 2: EMMC, 3: SD card (non-removable), 4: SD card (removable). A value
  /// of UINT32_MAX implies the field is unused.
  public storageType: u32[] = []

  /// Amount of used storage space on the component system. A value of UINT32_MAX implies the field is
  /// unused.
  /// Units: MiB.
  public storageUsage: u32[] = []

  /// Total amount of storage space on the component system. A value of UINT32_MAX implies the field is
  /// unused.
  /// Units: MiB.
  public storageTotal: u32[] = []

  /// Link type: 0-9: UART, 10-19: Wired network, 20-29: Wifi, 30-39: Point-to-point proprietary, 40-49:
  /// Mesh proprietary
  public linkType: u32[] = []

  /// Network traffic from the component system. A value of UINT32_MAX implies the field is unused.
  /// Units: KiB/s.
  public linkTxRate: u32[] = []

  /// Network traffic to the component system. A value of UINT32_MAX implies the field is unused.
  /// Units: KiB/s.
  public linkRxRate: u32[] = []

  /// Network capacity from the component system. A value of UINT32_MAX implies the field is unused.
  /// Units: KiB/s.
  public linkTxMax: u32[] = []

  /// Network capacity to the component system. A value of UINT32_MAX implies the field is unused.
  /// Units: KiB/s.
  public linkRxMax: u32[] = []

  /// Bitmap of status flags.
  /// Values: `ComputerStatusFlags`.
  public statusFlags: u16 = 0

  /// A ONBOARD_COMPUTER_STATUS from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): OnboardComputerStatus {
    const m = new OnboardComputerStatus()
    m.timeUsec = readU64(payload, 0)
    m.uptime = readU32(payload, 8)
    m.ramUsage = readU32(payload, 12)
    m.ramTotal = readU32(payload, 16)
    for (let i = 0; i < 4; i++) {
      m.storageType.push(readU32(payload, 20 + i * 4))
    }
    for (let i = 0; i < 4; i++) {
      m.storageUsage.push(readU32(payload, 36 + i * 4))
    }
    for (let i = 0; i < 4; i++) {
      m.storageTotal.push(readU32(payload, 52 + i * 4))
    }
    for (let i = 0; i < 6; i++) {
      m.linkType.push(readU32(payload, 68 + i * 4))
    }
    for (let i = 0; i < 6; i++) {
      m.linkTxRate.push(readU32(payload, 92 + i * 4))
    }
    for (let i = 0; i < 6; i++) {
      m.linkRxRate.push(readU32(payload, 116 + i * 4))
    }
    for (let i = 0; i < 6; i++) {
      m.linkTxMax.push(readU32(payload, 140 + i * 4))
    }
    for (let i = 0; i < 6; i++) {
      m.linkRxMax.push(readU32(payload, 164 + i * 4))
    }
    for (let i = 0; i < 4; i++) {
      m.fanSpeed.push(readI16(payload, 188 + i * 2))
    }
    m.type = readU8(payload, 196)
    for (let i = 0; i < 8; i++) {
      m.cpuCores.push(readU8(payload, 197 + i * 1))
    }
    for (let i = 0; i < 10; i++) {
      m.cpuCombined.push(readU8(payload, 205 + i * 1))
    }
    for (let i = 0; i < 4; i++) {
      m.gpuCores.push(readU8(payload, 215 + i * 1))
    }
    for (let i = 0; i < 10; i++) {
      m.gpuCombined.push(readU8(payload, 219 + i * 1))
    }
    m.temperatureBoard = readI8(payload, 229)
    for (let i = 0; i < 8; i++) {
      m.temperatureCore.push(readI8(payload, 230 + i * 1))
    }
    m.statusFlags = readU16(payload, 238)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    writeUint(into, at + 8, 4, this.uptime as int)
    writeUint(into, at + 12, 4, this.ramUsage as int)
    writeUint(into, at + 16, 4, this.ramTotal as int)
    for (let i = 0; i < 4 && i < this.storageType.length; i++) {
      writeUint(into, at + 20 + i * 4, 4, this.storageType[i] as int)
    }
    for (let i = 0; i < 4 && i < this.storageUsage.length; i++) {
      writeUint(into, at + 36 + i * 4, 4, this.storageUsage[i] as int)
    }
    for (let i = 0; i < 4 && i < this.storageTotal.length; i++) {
      writeUint(into, at + 52 + i * 4, 4, this.storageTotal[i] as int)
    }
    for (let i = 0; i < 6 && i < this.linkType.length; i++) {
      writeUint(into, at + 68 + i * 4, 4, this.linkType[i] as int)
    }
    for (let i = 0; i < 6 && i < this.linkTxRate.length; i++) {
      writeUint(into, at + 92 + i * 4, 4, this.linkTxRate[i] as int)
    }
    for (let i = 0; i < 6 && i < this.linkRxRate.length; i++) {
      writeUint(into, at + 116 + i * 4, 4, this.linkRxRate[i] as int)
    }
    for (let i = 0; i < 6 && i < this.linkTxMax.length; i++) {
      writeUint(into, at + 140 + i * 4, 4, this.linkTxMax[i] as int)
    }
    for (let i = 0; i < 6 && i < this.linkRxMax.length; i++) {
      writeUint(into, at + 164 + i * 4, 4, this.linkRxMax[i] as int)
    }
    for (let i = 0; i < 4 && i < this.fanSpeed.length; i++) {
      writeUint(into, at + 188 + i * 2, 2, this.fanSpeed[i] as int)
    }
    writeUint(into, at + 196, 1, this.type as int)
    for (let i = 0; i < 8 && i < this.cpuCores.length; i++) {
      writeUint(into, at + 197 + i * 1, 1, this.cpuCores[i] as int)
    }
    for (let i = 0; i < 10 && i < this.cpuCombined.length; i++) {
      writeUint(into, at + 205 + i * 1, 1, this.cpuCombined[i] as int)
    }
    for (let i = 0; i < 4 && i < this.gpuCores.length; i++) {
      writeUint(into, at + 215 + i * 1, 1, this.gpuCores[i] as int)
    }
    for (let i = 0; i < 10 && i < this.gpuCombined.length; i++) {
      writeUint(into, at + 219 + i * 1, 1, this.gpuCombined[i] as int)
    }
    writeUint(into, at + 229, 1, this.temperatureBoard as int)
    for (let i = 0; i < 8 && i < this.temperatureCore.length; i++) {
      writeUint(into, at + 230 + i * 1, 1, this.temperatureCore[i] as int)
    }
    writeUint(into, at + 238, 2, this.statusFlags as int)
  }

  public override info(): MessageInfo {
    OnboardComputerStatus.INFO
  }
}

/// Component information message, which may be requested using MAV_CMD_REQUEST_MESSAGE.
///
/// Deprecated since 2022-04, replaced by COMPONENT_METADATA.
export class ComponentInformation extends MavLinkData {
  public static readonly MSG_ID: int = 395
  public static readonly MSG_NAME: string = "COMPONENT_INFORMATION"
  public static readonly PAYLOAD_LENGTH: int = 212
  public static readonly MAGIC_NUMBER: int = 0
  public static readonly INFO: MessageInfo = new MessageInfo(395, "COMPONENT_INFORMATION", 212, 212, 0, [
    new MavLinkPacketField("time_boot_ms", "timeBootMs", 0, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("general_metadata_file_crc", "generalMetadataFileCrc", 4, false, 4, "uint32_t", ""),
    new MavLinkPacketField("peripherals_metadata_file_crc", "peripheralsMetadataFileCrc", 8, false, 4, "uint32_t", ""),
    new MavLinkPacketField("general_metadata_uri", "generalMetadataUri", 12, false, 1, "char[]", "", 100),
    new MavLinkPacketField("peripherals_metadata_uri", "peripheralsMetadataUri", 112, false, 1, "char[]", "", 100),
  ], (p) => ComponentInformation.decode(p))

  /// Timestamp (time since system boot).
  /// Units: ms.
  public timeBootMs: u32 = 0

  /// CRC32 of the general metadata file (general_metadata_uri).
  public generalMetadataFileCrc: u32 = 0

  /// MAVLink FTP URI for the general metadata file (COMP_METADATA_TYPE_GENERAL), which may be compressed
  /// with xz. The file contains general component metadata, and may contain URI links for additional
  /// metadata (see COMP_METADATA_TYPE). The information is static from boot, and may be generated at
  /// compile time. The string needs to be zero terminated.
  public generalMetadataUri: string = ""

  /// CRC32 of peripherals metadata file (peripherals_metadata_uri).
  public peripheralsMetadataFileCrc: u32 = 0

  /// (Optional) MAVLink FTP URI for the peripherals metadata file (COMP_METADATA_TYPE_PERIPHERALS), which
  /// may be compressed with xz. This contains data about "attached components" such as UAVCAN nodes. The
  /// peripherals are in a separate file because the information must be generated dynamically at runtime.
  /// The string needs to be zero terminated.
  public peripheralsMetadataUri: string = ""

  /// A COMPONENT_INFORMATION from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): ComponentInformation {
    const m = new ComponentInformation()
    m.timeBootMs = readU32(payload, 0)
    m.generalMetadataFileCrc = readU32(payload, 4)
    m.peripheralsMetadataFileCrc = readU32(payload, 8)
    m.generalMetadataUri = readChars(payload, 12, 100)
    m.peripheralsMetadataUri = readChars(payload, 112, 100)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.timeBootMs as int)
    writeUint(into, at + 4, 4, this.generalMetadataFileCrc as int)
    writeUint(into, at + 8, 4, this.peripheralsMetadataFileCrc as int)
    writeChars(into, at + 12, 100, this.generalMetadataUri)
    writeChars(into, at + 112, 100, this.peripheralsMetadataUri)
  }

  public override info(): MessageInfo {
    ComponentInformation.INFO
  }
}

/// Basic component information data. Should be requested using MAV_CMD_REQUEST_MESSAGE on startup, or
/// when required.
export class ComponentInformationBasic extends MavLinkData {
  public static readonly MSG_ID: int = 396
  public static readonly MSG_NAME: string = "COMPONENT_INFORMATION_BASIC"
  public static readonly PAYLOAD_LENGTH: int = 160
  public static readonly MAGIC_NUMBER: int = 50
  public static readonly INFO: MessageInfo = new MessageInfo(396, "COMPONENT_INFORMATION_BASIC", 160, 160, 50, [
    new MavLinkPacketField("capabilities", "capabilities", 0, false, 8, "uint64_t", ""),
    new MavLinkPacketField("time_boot_ms", "timeBootMs", 8, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("time_manufacture_s", "timeManufactureS", 12, false, 4, "uint32_t", "s"),
    new MavLinkPacketField("vendor_name", "vendorName", 16, false, 1, "char[]", "", 32),
    new MavLinkPacketField("model_name", "modelName", 48, false, 1, "char[]", "", 32),
    new MavLinkPacketField("software_version", "softwareVersion", 80, false, 1, "char[]", "", 24),
    new MavLinkPacketField("hardware_version", "hardwareVersion", 104, false, 1, "char[]", "", 24),
    new MavLinkPacketField("serial_number", "serialNumber", 128, false, 1, "char[]", "", 32),
  ], (p) => ComponentInformationBasic.decode(p))

  /// Timestamp (time since system boot).
  /// Units: ms.
  public timeBootMs: u32 = 0

  /// Component capability flags
  /// Values: `MavProtocolCapability`.
  public capabilities: u64 = 0

  /// Date of manufacture as a UNIX Epoch time (since 1.1.1970) in seconds.
  /// Units: s.
  public timeManufactureS: u32 = 0

  /// Name of the component vendor. Needs to be zero terminated. The field is optional and can be
  /// empty/all zeros.
  public vendorName: string = ""

  /// Name of the component model. Needs to be zero terminated. The field is optional and can be empty/all
  /// zeros.
  public modelName: string = ""

  /// Software version. The recommended format is SEMVER: 'major.minor.patch' (any format may be used).
  /// The field must be zero terminated if it has a value. The field is optional and can be empty/all
  /// zeros.
  public softwareVersion: string = ""

  /// Hardware version. The recommended format is SEMVER: 'major.minor.patch' (any format may be used).
  /// The field must be zero terminated if it has a value. The field is optional and can be empty/all
  /// zeros.
  public hardwareVersion: string = ""

  /// Hardware serial number. The field must be zero terminated if it has a value. The field is optional
  /// and can be empty/all zeros.
  public serialNumber: string = ""

  /// A COMPONENT_INFORMATION_BASIC from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): ComponentInformationBasic {
    const m = new ComponentInformationBasic()
    m.capabilities = readU64(payload, 0)
    m.timeBootMs = readU32(payload, 8)
    m.timeManufactureS = readU32(payload, 12)
    m.vendorName = readChars(payload, 16, 32)
    m.modelName = readChars(payload, 48, 32)
    m.softwareVersion = readChars(payload, 80, 24)
    m.hardwareVersion = readChars(payload, 104, 24)
    m.serialNumber = readChars(payload, 128, 32)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.capabilities)
    writeUint(into, at + 8, 4, this.timeBootMs as int)
    writeUint(into, at + 12, 4, this.timeManufactureS as int)
    writeChars(into, at + 16, 32, this.vendorName)
    writeChars(into, at + 48, 32, this.modelName)
    writeChars(into, at + 80, 24, this.softwareVersion)
    writeChars(into, at + 104, 24, this.hardwareVersion)
    writeChars(into, at + 128, 32, this.serialNumber)
  }

  public override info(): MessageInfo {
    ComponentInformationBasic.INFO
  }
}

/// Component metadata message, which may be requested using MAV_CMD_REQUEST_MESSAGE. This contains the
/// MAVLink FTP URI and CRC for the component's general metadata file. The file must be hosted on the
/// component, and may be xz compressed. The file CRC can be used for file caching. The general metadata
/// file can be read to get the locations of other metadata files (COMP_METADATA_TYPE) and translations,
/// which may be hosted either on the vehicle or the internet. For more information see:
/// https://mavlink.io/en/services/component_information.html. Note: Camera components should use
/// CAMERA_INFORMATION instead, and autopilots may use both this message and AUTOPILOT_VERSION.
export class ComponentMetadata extends MavLinkData {
  public static readonly MSG_ID: int = 397
  public static readonly MSG_NAME: string = "COMPONENT_METADATA"
  public static readonly PAYLOAD_LENGTH: int = 108
  public static readonly MAGIC_NUMBER: int = 182
  public static readonly INFO: MessageInfo = new MessageInfo(397, "COMPONENT_METADATA", 108, 108, 182, [
    new MavLinkPacketField("time_boot_ms", "timeBootMs", 0, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("file_crc", "fileCrc", 4, false, 4, "uint32_t", ""),
    new MavLinkPacketField("uri", "uri", 8, false, 1, "char[]", "", 100),
  ], (p) => ComponentMetadata.decode(p))

  /// Timestamp (time since system boot).
  /// Units: ms.
  public timeBootMs: u32 = 0

  /// CRC32 of the general metadata file.
  public fileCrc: u32 = 0

  /// MAVLink FTP URI for the general metadata file (COMP_METADATA_TYPE_GENERAL), which may be compressed
  /// with xz. The file contains general component metadata, and may contain URI links for additional
  /// metadata (see COMP_METADATA_TYPE). The information is static from boot, and may be generated at
  /// compile time. The string needs to be zero terminated.
  public uri: string = ""

  /// A COMPONENT_METADATA from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): ComponentMetadata {
    const m = new ComponentMetadata()
    m.timeBootMs = readU32(payload, 0)
    m.fileCrc = readU32(payload, 4)
    m.uri = readChars(payload, 8, 100)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.timeBootMs as int)
    writeUint(into, at + 4, 4, this.fileCrc as int)
    writeChars(into, at + 8, 100, this.uri)
  }

  public override info(): MessageInfo {
    ComponentMetadata.INFO
  }
}

