    new MavLinkPacketField("start_index", "startIndex", 0, false, 2, "int16_t", ""),
    new MavLinkPacketField("end_index", "endIndex", 2, false, 2, "int16_t", ""),
    new MavLinkPacketField("target_system", "targetSystem", 4, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 5, false, 1, "uint8_t", ""),
    new MavLinkPacketField("mission_type", "missionType", 6, true, 1, "uint8_t", ""),
  ], (p) => MissionWritePartialList.decode(p))

  /// System ID
  public targetSystem: u8 = 0

  /// Component ID
  public targetComponent: u8 = 0

  /// Start index. Must be smaller / equal to the largest index of the current onboard list.
  public startIndex: i16 = 0

  /// End index, equal or greater than start index.
  public endIndex: i16 = 0

  /// Mission type.
  /// Values: `MavMissionType`.
  public missionType: u8 = 0

  /// A MISSION_WRITE_PARTIAL_LIST from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): MissionWritePartialList {
    const m = new MissionWritePartialList()
    m.startIndex = readI16(payload, 0)
    m.endIndex = readI16(payload, 2)
    m.targetSystem = readU8(payload, 4)
    m.targetComponent = readU8(payload, 5)
    m.missionType = readU8(payload, 6)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 2, this.startIndex as int)
    writeUint(into, at + 2, 2, this.endIndex as int)
    writeUint(into, at + 4, 1, this.targetSystem as int)
    writeUint(into, at + 5, 1, this.targetComponent as int)
    writeUint(into, at + 6, 1, this.missionType as int)
  }

  public override info(): MessageInfo {
    MissionWritePartialList.INFO
  }
}

/// Message encoding a mission item. This message is emitted to announce the presence of a mission item
/// and to set a mission item on the system. The mission item can be either in x, y, z meters (type:
/// LOCAL) or x:lat, y:lon, z:altitude. Local frame is Z-down, right handed (NED), global frame is Z-up,
/// right handed (ENU). NaN may be used to indicate an optional/default value (e.g. to use the system's
/// current latitude or yaw rather than a specific value). See also
/// https://mavlink.io/en/services/mission.html.
///
/// Deprecated since 2020-06, replaced by MISSION_ITEM_INT.
export class MissionItem extends MavLinkData {
  public static readonly MSG_ID: int = 39
  public static readonly MSG_NAME: string = "MISSION_ITEM"
  public static readonly PAYLOAD_LENGTH: int = 38
  public static readonly MAGIC_NUMBER: int = 254
  public static readonly INFO: MessageInfo = new MessageInfo(39, "MISSION_ITEM", 38, 37, 254, [
    new MavLinkPacketField("param1", "param1", 0, false, 4, "float", ""),
    new MavLinkPacketField("param2", "param2", 4, false, 4, "float", ""),
    new MavLinkPacketField("param3", "param3", 8, false, 4, "float", ""),
    new MavLinkPacketField("param4", "param4", 12, false, 4, "float", ""),
    new MavLinkPacketField("x", "x", 16, false, 4, "float", ""),
    new MavLinkPacketField("y", "y", 20, false, 4, "float", ""),
    new MavLinkPacketField("z", "z", 24, false, 4, "float", ""),
    new MavLinkPacketField("seq", "seq", 28, false, 2, "uint16_t", ""),
    new MavLinkPacketField("command", "command", 30, false, 2, "uint16_t", ""),
    new MavLinkPacketField("target_system", "targetSystem", 32, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 33, false, 1, "uint8_t", ""),
    new MavLinkPacketField("frame", "frame", 34, false, 1, "uint8_t", ""),
    new MavLinkPacketField("current", "current", 35, false, 1, "uint8_t", ""),
    new MavLinkPacketField("autocontinue", "autocontinue", 36, false, 1, "uint8_t", ""),
    new MavLinkPacketField("mission_type", "missionType", 37, true, 1, "uint8_t", ""),
  ], (p) => MissionItem.decode(p))

  /// System ID
  public targetSystem: u8 = 0

  /// Component ID
  public targetComponent: u8 = 0

  /// Sequence
  public seq: u16 = 0

  /// The coordinate system of the waypoint.
  /// Values: `MavFrame`.
  public frame: u8 = 0

  /// The scheduled action for the waypoint.
  /// Values: `MavCmd`.
  public command: u16 = 0

  /// false:0, true:1
  public current: u8 = 0

  /// Autocontinue to next waypoint. 0: false, 1: true. Set false to pause mission after the item
  /// completes.
  public autocontinue: u8 = 0

  /// PARAM1, see MAV_CMD enum
  public param1: f32 = 0.0

  /// PARAM2, see MAV_CMD enum
  public param2: f32 = 0.0

  /// PARAM3, see MAV_CMD enum
  public param3: f32 = 0.0

  /// PARAM4, see MAV_CMD enum
  public param4: f32 = 0.0

  /// PARAM5 / local: X coordinate, global: latitude
  public x: f32 = 0.0

  /// PARAM6 / local: Y coordinate, global: longitude
  public y: f32 = 0.0

  /// PARAM7 / local: Z coordinate, global: altitude (relative or absolute, depending on frame).
  public z: f32 = 0.0

  /// Mission type.
  /// Values: `MavMissionType`.
  public missionType: u8 = 0

  /// A MISSION_ITEM from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): MissionItem {
    const m = new MissionItem()
    m.param1 = readF32(payload, 0)
    m.param2 = readF32(payload, 4)
    m.param3 = readF32(payload, 8)
    m.param4 = readF32(payload, 12)
    m.x = readF32(payload, 16)
    m.y = readF32(payload, 20)
    m.z = readF32(payload, 24)
    m.seq = readU16(payload, 28)
    m.command = readU16(payload, 30)
    m.targetSystem = readU8(payload, 32)
    m.targetComponent = readU8(payload, 33)
    m.frame = readU8(payload, 34)
    m.current = readU8(payload, 35)
    m.autocontinue = readU8(payload, 36)
    m.missionType = readU8(payload, 37)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeF32(into, at + 0, this.param1)
    writeF32(into, at + 4, this.param2)
    writeF32(into, at + 8, this.param3)
    writeF32(into, at + 12, this.param4)
    writeF32(into, at + 16, this.x)
    writeF32(into, at + 20, this.y)
    writeF32(into, at + 24, this.z)
    writeUint(into, at + 28, 2, this.seq as int)
    writeUint(into, at + 30, 2, this.command as int)
    writeUint(into, at + 32, 1, this.targetSystem as int)
    writeUint(into, at + 33, 1, this.targetComponent as int)
    writeUint(into, at + 34, 1, this.frame as int)
    writeUint(into, at + 35, 1, this.current as int)
    writeUint(into, at + 36, 1, this.autocontinue as int)
    writeUint(into, at + 37, 1, this.missionType as int)
  }

  public override info(): MessageInfo {
    MissionItem.INFO
  }
}

/// Request the information of the mission item with the sequence number seq. The response of the system
