    match (value) {
      1 => "ALT_MAX",
      2 => "CIRCLE",
      4 => "POLYGON",
      8 => "ALT_MIN",
      _ => null,
    }
  }
}

/// Enumeration of possible mount operation modes. This message is used by obsolete/deprecated gimbal
