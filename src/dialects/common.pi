/// Bitmap to indicate which dimensions should be ignored by the vehicle: a value of 0b0000000000000000
/// or 0b0000001000000000 indicates that none of the setpoint dimensions should be ignored. If bit 9 is
/// set the floats afx afy afz should be interpreted as force instead of acceleration.
export class PositionTargetTypemask {
  /// Ignore position x
  public static readonly X_IGNORE: int = 1

  /// Ignore position y
  public static readonly Y_IGNORE: int = 2

  /// Ignore position z
  public static readonly Z_IGNORE: int = 4

  /// Ignore velocity x
  public static readonly VX_IGNORE: int = 8

  /// Ignore velocity y
  public static readonly VY_IGNORE: int = 16

  /// Ignore velocity z
  public static readonly VZ_IGNORE: int = 32

  /// Ignore acceleration x
  public static readonly AX_IGNORE: int = 64

  /// Ignore acceleration y
  public static readonly AY_IGNORE: int = 128

  /// Ignore acceleration z
  public static readonly AZ_IGNORE: int = 256

  /// Use force instead of acceleration
  public static readonly FORCE_SET: int = 512

  /// Ignore yaw
  public static readonly YAW_IGNORE: int = 1024

  /// Ignore yaw rate
  public static readonly YAW_RATE_IGNORE: int = 2048

  /// The name of `value` (`X_IGNORE` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      1 => "X_IGNORE",
      2 => "Y_IGNORE",
      4 => "Z_IGNORE",
      8 => "VX_IGNORE",
      16 => "VY_IGNORE",
      32 => "VZ_IGNORE",
      64 => "AX_IGNORE",
      128 => "AY_IGNORE",
      256 => "AZ_IGNORE",
      512 => "FORCE_SET",
      1024 => "YAW_IGNORE",
      2048 => "YAW_RATE_IGNORE",
      _ => null,
    }
  }
}

/// Bitmap to indicate which dimensions should be ignored by the vehicle: a value of 0b00000000
