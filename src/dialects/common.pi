  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 2, this.seq as int)
    writeUint(into, at + 2, 1, this.targetSystem as int)
    writeUint(into, at + 3, 1, this.targetComponent as int)
    writeUint(into, at + 4, 1, this.missionType as int)
  }

  public override info(): MessageInfo {
    MissionRequestInt.INFO
  }
}

/// Set a safety zone (volume), which is defined by two corners of a cube. This message can be used to
/// tell the MAV which setpoints/waypoints to accept and which to reject. Safety areas are often
/// enforced by national or competition regulations.
export class SafetySetAllowedArea extends MavLinkData {
  public static readonly MSG_ID: int = 54
  public static readonly MSG_NAME: string = "SAFETY_SET_ALLOWED_AREA"
  public static readonly PAYLOAD_LENGTH: int = 27
  public static readonly MAGIC_NUMBER: int = 15
  public static readonly INFO: MessageInfo = new MessageInfo(54, "SAFETY_SET_ALLOWED_AREA", 27, 27, 15, [
    new MavLinkPacketField("p1x", "p1x", 0, false, 4, "float", "m"),
    new MavLinkPacketField("p1y", "p1y", 4, false, 4, "float", "m"),
    new MavLinkPacketField("p1z", "p1z", 8, false, 4, "float", "m"),
    new MavLinkPacketField("p2x", "p2x", 12, false, 4, "float", "m"),
    new MavLinkPacketField("p2y", "p2y", 16, false, 4, "float", "m"),
    new MavLinkPacketField("p2z", "p2z", 20, false, 4, "float", "m"),
    new MavLinkPacketField("target_system", "targetSystem", 24, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 25, false, 1, "uint8_t", ""),
    new MavLinkPacketField("frame", "frame", 26, false, 1, "uint8_t", ""),
  ], (p) => SafetySetAllowedArea.decode(p))

  /// System ID
  public targetSystem: u8 = 0

  /// Component ID
  public targetComponent: u8 = 0

  /// Coordinate frame. Can be either global, GPS, right-handed with Z axis up or local, right handed, Z
  /// axis down.
  /// Values: `MavFrame`.
  public frame: u8 = 0

  /// x position 1 / Latitude 1
  /// Units: m.
  public p1x: f32 = 0.0

  /// y position 1 / Longitude 1
  /// Units: m.
  public p1y: f32 = 0.0

  /// z position 1 / Altitude 1
  /// Units: m.
  public p1z: f32 = 0.0

  /// x position 2 / Latitude 2
  /// Units: m.
  public p2x: f32 = 0.0

  /// y position 2 / Longitude 2
  /// Units: m.
  public p2y: f32 = 0.0

  /// z position 2 / Altitude 2
  /// Units: m.
  public p2z: f32 = 0.0

  /// A SAFETY_SET_ALLOWED_AREA from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): SafetySetAllowedArea {
    const m = new SafetySetAllowedArea()
    m.p1x = readF32(payload, 0)
    m.p1y = readF32(payload, 4)
    m.p1z = readF32(payload, 8)
    m.p2x = readF32(payload, 12)
    m.p2y = readF32(payload, 16)
    m.p2z = readF32(payload, 20)
    m.targetSystem = readU8(payload, 24)
    m.targetComponent = readU8(payload, 25)
    m.frame = readU8(payload, 26)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeF32(into, at + 0, this.p1x)
    writeF32(into, at + 4, this.p1y)
    writeF32(into, at + 8, this.p1z)
    writeF32(into, at + 12, this.p2x)
    writeF32(into, at + 16, this.p2y)
    writeF32(into, at + 20, this.p2z)
    writeUint(into, at + 24, 1, this.targetSystem as int)
    writeUint(into, at + 25, 1, this.targetComponent as int)
    writeUint(into, at + 26, 1, this.frame as int)
  }

  public override info(): MessageInfo {
    SafetySetAllowedArea.INFO
  }
}

