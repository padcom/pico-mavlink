  /// Lithium polymer battery
  public static readonly LIPO: int = 1

  /// Lithium-iron-phosphate battery
  public static readonly LIFE: int = 2

  /// Lithium-ION battery
  public static readonly LION: int = 3

  /// Nickel metal hydride battery
  public static readonly NIMH: int = 4

  /// The name of `value` (`UNKNOWN` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "UNKNOWN",
      1 => "LIPO",
      2 => "LIFE",
      3 => "LION",
      4 => "NIMH",
      _ => null,
    }
  }
}

/// Enumeration of battery functions
export class MavBatteryFunction {
  /// Battery function is unknown
  public static readonly UNKNOWN: int = 0

  /// Battery supports all flight systems
  public static readonly ALL: int = 1

  /// Battery for the propulsion system
  public static readonly PROPULSION: int = 2

  /// Avionics battery
  public static readonly AVIONICS: int = 3

  /// Payload battery
  public static readonly PAYLOAD: int = 4

  /// The name of `value` (`UNKNOWN` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "UNKNOWN",
      1 => "ALL",
      2 => "PROPULSION",
      3 => "AVIONICS",
      4 => "PAYLOAD",
      _ => null,
    }
  }
}

/// Enumeration for battery charge states.
export class MavBatteryChargeState {
  /// Low battery state is not provided
  public static readonly UNDEFINED: int = 0

  /// Battery is not in low state. Normal operation.
  public static readonly OK: int = 1

  /// Battery state is low, warn and monitor close.
  public static readonly LOW: int = 2

  /// Battery state is critical, return or abort immediately.
  public static readonly CRITICAL: int = 3

  /// Battery state is too low for ordinary abort sequence. Perform fastest possible emergency stop to
  /// prevent damage.
  public static readonly EMERGENCY: int = 4

  /// Battery failed, damage unavoidable. Possible causes (faults) are listed in MAV_BATTERY_FAULT.
  public static readonly FAILED: int = 5

  /// Battery is diagnosed to be defective or an error occurred, usage is discouraged / prohibited.
  /// Possible causes (faults) are listed in MAV_BATTERY_FAULT.
  public static readonly UNHEALTHY: int = 6

  /// Battery is charging.
  public static readonly CHARGING: int = 7

  /// The name of `value` (`UNDEFINED` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "UNDEFINED",
      1 => "OK",
      2 => "LOW",
      3 => "CRITICAL",
      4 => "EMERGENCY",
      5 => "FAILED",
      6 => "UNHEALTHY",
      7 => "CHARGING",
      _ => null,
    }
  }
}

/// Battery mode. Note, the normal operation mode (i.e. when flying) should be reported as
/// MAV_BATTERY_MODE_UNKNOWN to allow message trimming in normal flight.
export class MavBatteryMode {
  /// Battery mode not supported/unknown battery mode/normal operation.
  public static readonly UNKNOWN: int = 0

  /// Battery is auto discharging (towards storage level).
  public static readonly AUTO_DISCHARGING: int = 1

  /// Battery in hot-swap mode (current limited to prevent spikes that might damage sensitive electrical
  /// circuits).
  public static readonly HOT_SWAP: int = 2

  /// The name of `value` (`UNKNOWN` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "UNKNOWN",
      1 => "AUTO_DISCHARGING",
      2 => "HOT_SWAP",
      _ => null,
    }
  }
}

/// Smart battery supply status/fault flags (bitmask) for health indication. The battery must also
/// report either MAV_BATTERY_CHARGE_STATE_FAILED or MAV_BATTERY_CHARGE_STATE_UNHEALTHY if any of these
/// are set.
export class MavBatteryFault {
  /// Battery has deep discharged.
  public static readonly DEEP_DISCHARGE: int = 1

  /// Voltage spikes.
  public static readonly SPIKES: int = 2

  /// One or more cells have failed. Battery should also report MAV_BATTERY_CHARGE_STATE_FAILE (and should
  /// not be used).
  public static readonly CELL_FAIL: int = 4

  /// Over-current fault.
  public static readonly OVER_CURRENT: int = 8

  /// Over-temperature fault.
  public static readonly OVER_TEMPERATURE: int = 16

  /// Under-temperature fault.
  public static readonly UNDER_TEMPERATURE: int = 32

  /// Vehicle voltage is not compatible with this battery (batteries on same power rail should have
  /// similar voltage).
  public static readonly INCOMPATIBLE_VOLTAGE: int = 64

  /// Battery firmware is not compatible with current autopilot firmware.
  public static readonly INCOMPATIBLE_FIRMWARE: int = 128

  /// Battery is not compatible due to cell configuration (e.g. 5s1p when vehicle requires 6s).
  public static readonly BATTERY_FAULT_INCOMPATIBLE_CELLS_CONFIGURATION: int = 256

  /// The name of `value` (`DEEP_DISCHARGE` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      1 => "DEEP_DISCHARGE",
      2 => "SPIKES",
      4 => "CELL_FAIL",
      8 => "OVER_CURRENT",
      16 => "OVER_TEMPERATURE",
      32 => "UNDER_TEMPERATURE",
      64 => "INCOMPATIBLE_VOLTAGE",
      128 => "INCOMPATIBLE_FIRMWARE",
      256 => "BATTERY_FAULT_INCOMPATIBLE_CELLS_CONFIGURATION",
      _ => null,
    }
  }
}

/// Fuel types for use in FUEL_TYPE. Fuel types specify the units for the maximum, available and
/// consumed fuel, and for the flow rates.
export class MavFuelType {
  /// Not specified. Fuel levels are normalized (i.e. maximum is 1, and other levels are relative to 1).
  public static readonly UNKNOWN: int = 0

  /// A generic liquid fuel. Fuel levels are in millilitres (ml). Fuel rates are in millilitres/second.
  public static readonly LIQUID: int = 1

  /// A gas tank. Fuel levels are in kilo-Pascal (kPa), and flow rates are in milliliters per second
  /// (ml/s).
  public static readonly GAS: int = 2

  /// The name of `value` (`UNKNOWN` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "UNKNOWN",
      1 => "LIQUID",
      2 => "GAS",
      _ => null,
    }
  }
}

/// Flags to report status/failure cases for a power generator (used in GENERATOR_STATUS). Note that
/// FAULTS are conditions that cause the generator to fail. Warnings are conditions that require
/// attention before the next use (they indicate the system is not operating properly).
export class MavGeneratorStatusFlag {
  /// Generator is off.
  public static readonly OFF: int = 1

  /// Generator is ready to start generating power.
  public static readonly READY: int = 2

  /// Generator is generating power.
  public static readonly GENERATING: int = 4

  /// Generator is charging the batteries (generating enough power to charge and provide the load).
  public static readonly CHARGING: int = 8

  /// Generator is operating at a reduced maximum power.
  public static readonly REDUCED_POWER: int = 16

  /// Generator is providing the maximum output.
  public static readonly MAXPOWER: int = 32

  /// Generator is near the maximum operating temperature, cooling is insufficient.
  public static readonly OVERTEMP_WARNING: int = 64

  /// Generator hit the maximum operating temperature and shutdown.
  public static readonly OVERTEMP_FAULT: int = 128

  /// Power electronics are near the maximum operating temperature, cooling is insufficient.
  public static readonly ELECTRONICS_OVERTEMP_WARNING: int = 256

  /// Power electronics hit the maximum operating temperature and shutdown.
  public static readonly ELECTRONICS_OVERTEMP_FAULT: int = 512

  /// Power electronics experienced a fault and shutdown.
  public static readonly ELECTRONICS_FAULT: int = 1024

  /// The power source supplying the generator failed e.g. mechanical generator stopped, tether is no
  /// longer providing power, solar cell is in shade, hydrogen reaction no longer happening.
  public static readonly POWERSOURCE_FAULT: int = 2048

  /// Generator controller having communication problems.
  public static readonly COMMUNICATION_WARNING: int = 4096

  /// Power electronic or generator cooling system error.
  public static readonly COOLING_WARNING: int = 8192

  /// Generator controller power rail experienced a fault.
  public static readonly POWER_RAIL_FAULT: int = 16384

  /// Generator controller exceeded the overcurrent threshold and shutdown to prevent damage.
  public static readonly OVERCURRENT_FAULT: int = 32768

  /// Generator controller detected a high current going into the batteries and shutdown to prevent
  /// battery damage.
  public static readonly BATTERY_OVERCHARGE_CURRENT_FAULT: int = 65536

  /// Generator controller exceeded it's overvoltage threshold and shutdown to prevent it exceeding the
  /// voltage rating.
  public static readonly OVERVOLTAGE_FAULT: int = 131072

  /// Batteries are under voltage (generator will not start).
  public static readonly BATTERY_UNDERVOLT_FAULT: int = 262144

  /// Generator start is inhibited by e.g. a safety switch.
  public static readonly START_INHIBITED: int = 524288

  /// Generator requires maintenance.
  public static readonly MAINTENANCE_REQUIRED: int = 1048576

  /// Generator is not ready to generate yet.
  public static readonly WARMING_UP: int = 2097152

  /// Generator is idle.
  public static readonly IDLE: int = 4194304

  /// The name of `value` (`OFF` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      1 => "OFF",
      2 => "READY",
      4 => "GENERATING",
      8 => "CHARGING",
      16 => "REDUCED_POWER",
      32 => "MAXPOWER",
      64 => "OVERTEMP_WARNING",
      128 => "OVERTEMP_FAULT",
      256 => "ELECTRONICS_OVERTEMP_WARNING",
      512 => "ELECTRONICS_OVERTEMP_FAULT",
      1024 => "ELECTRONICS_FAULT",
      2048 => "POWERSOURCE_FAULT",
      4096 => "COMMUNICATION_WARNING",
      8192 => "COOLING_WARNING",
      16384 => "POWER_RAIL_FAULT",
      32768 => "OVERCURRENT_FAULT",
      65536 => "BATTERY_OVERCHARGE_CURRENT_FAULT",
      131072 => "OVERVOLTAGE_FAULT",
      262144 => "BATTERY_UNDERVOLT_FAULT",
      524288 => "START_INHIBITED",
      1048576 => "MAINTENANCE_REQUIRED",
      2097152 => "WARMING_UP",
      4194304 => "IDLE",
      _ => null,
    }
  }
}

