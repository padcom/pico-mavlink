    m.airspeed = readF32(payload, 0)
    m.groundspeed = readF32(payload, 4)
    m.alt = readF32(payload, 8)
    m.climb = readF32(payload, 12)
    m.heading = readI16(payload, 16)
    m.throttle = readU16(payload, 18)
    m
  }

