  public static readonly SYSTEM_MOTOR: int = 101

  public static readonly SYSTEM_SERVO: int = 102

  public static readonly SYSTEM_AVOIDANCE: int = 103

  public static readonly SYSTEM_RC_SIGNAL: int = 104

  public static readonly SYSTEM_MAVLINK_SIGNAL: int = 105

  /// The name of `value` (`SENSOR_GYRO` …), or null for a value this dialect doesn't define.
