  public static readonly VISION_OTHER: int = 3

  /// The name of `value` (`LIGHT_BEACON` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "LIGHT_BEACON",
      1 => "RADIO_BEACON",
      2 => "VISION_FIDUCIAL",
      3 => "VISION_OTHER",
      _ => null,
    }
  }
}

/// Direction of VTOL transition
export class VtolTransitionHeading {
  /// Respect the heading configuration of the vehicle.
  public static readonly VEHICLE_DEFAULT: int = 0

  /// Use the heading pointing towards the next waypoint.
  public static readonly NEXT_WAYPOINT: int = 1

  /// Use the heading on takeoff (while sitting on the ground).
  public static readonly TAKEOFF: int = 2

  /// Use the specified heading in parameter 4.
  public static readonly SPECIFIED: int = 3

  /// Use the current heading when reaching takeoff altitude (potentially facing the wind when
  /// weather-vaning is active).
  public static readonly ANY: int = 4

  /// The name of `value` (`VEHICLE_DEFAULT` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "VEHICLE_DEFAULT",
      1 => "NEXT_WAYPOINT",
      2 => "TAKEOFF",
      3 => "SPECIFIED",
      4 => "ANY",
      _ => null,
    }
  }
}

/// Camera capability flags (Bitmap)
