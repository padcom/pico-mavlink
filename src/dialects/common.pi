    m.param2 = readF32(payload, 4)
    m.param3 = readF32(payload, 8)
    m.param4 = readF32(payload, 12)
    m.x = readI32(payload, 16)
    m.y = readI32(payload, 20)
    m.z = readF32(payload, 24)
    m.seq = readU16(payload, 28)
    m.command = readU16(payload, 30)
    m.targetSystem = readU8(payload, 32)
    m.targetComponent = readU8(payload, 33)
    m.frame = readU8(payload, 34)
    m.current = readU8(payload, 35)
    m.autocontinue = readU8(payload, 36)
