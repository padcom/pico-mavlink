/// Set the mission item with sequence number seq as the current item and emit MISSION_CURRENT (whether
/// or not the mission number changed). If a mission is currently being executed, the system will
/// continue to this new mission item on the shortest path, skipping any intermediate mission items.
/// Note that mission jump repeat counters are not reset (see MAV_CMD_DO_JUMP param2). This message may
/// trigger a mission state-machine change on some systems: for example from MISSION_STATE_NOT_STARTED
/// or MISSION_STATE_PAUSED to MISSION_STATE_ACTIVE. If the system is in mission mode, on those systems
/// this command might therefore start, restart or resume the mission. If the system is not in mission
/// mode this message must not trigger a switch to mission mode.
export class MissionSetCurrent extends MavLinkData {
  public static readonly MSG_ID: int = 41
  public static readonly MSG_NAME: string = "MISSION_SET_CURRENT"
  public static readonly PAYLOAD_LENGTH: int = 4
  public static readonly MAGIC_NUMBER: int = 28
  public static readonly INFO: MessageInfo = new MessageInfo(41, "MISSION_SET_CURRENT", 4, 4, 28, [
    new MavLinkPacketField("seq", "seq", 0, false, 2, "uint16_t", ""),
    new MavLinkPacketField("target_system", "targetSystem", 2, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 3, false, 1, "uint8_t", ""),
  ], (p) => MissionSetCurrent.decode(p))

  /// System ID
  public targetSystem: u8 = 0

  /// Component ID
  public targetComponent: u8 = 0

  /// Sequence
  public seq: u16 = 0

  /// A MISSION_SET_CURRENT from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): MissionSetCurrent {
    const m = new MissionSetCurrent()
    m.seq = readU16(payload, 0)
    m.targetSystem = readU8(payload, 2)
    m.targetComponent = readU8(payload, 3)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 2, this.seq as int)
    writeUint(into, at + 2, 1, this.targetSystem as int)
    writeUint(into, at + 3, 1, this.targetComponent as int)
  }

  public override info(): MessageInfo {
    MissionSetCurrent.INFO
  }
}

/// Message that announces the sequence number of the current target mission item (that the system will
/// fly towards/execute when the mission is running). This message should be streamed all the time
/// (nominally at 1Hz). This message should be emitted following a call to
/// MAV_CMD_DO_SET_MISSION_CURRENT or MISSION_SET_CURRENT.
export class MissionCurrent extends MavLinkData {
  public static readonly MSG_ID: int = 42
  public static readonly MSG_NAME: string = "MISSION_CURRENT"
  public static readonly PAYLOAD_LENGTH: int = 18
  public static readonly MAGIC_NUMBER: int = 28
  public static readonly INFO: MessageInfo = new MessageInfo(42, "MISSION_CURRENT", 18, 2, 28, [
    new MavLinkPacketField("seq", "seq", 0, false, 2, "uint16_t", ""),
    new MavLinkPacketField("total", "total", 2, true, 2, "uint16_t", ""),
    new MavLinkPacketField("mission_state", "missionState", 4, true, 1, "uint8_t", ""),
    new MavLinkPacketField("mission_mode", "missionMode", 5, true, 1, "uint8_t", ""),
    new MavLinkPacketField("mission_id", "missionId", 6, true, 4, "uint32_t", ""),
    new MavLinkPacketField("fence_id", "fenceId", 10, true, 4, "uint32_t", ""),
    new MavLinkPacketField("rally_points_id", "rallyPointsId", 14, true, 4, "uint32_t", ""),
  ], (p) => MissionCurrent.decode(p))

  /// Sequence
  public seq: u16 = 0

  /// Total number of mission items on vehicle (on last item, sequence == total). If the autopilot stores
  /// its home location as part of the mission this will be excluded from the total. 0: Not supported,
  /// UINT16_MAX if no mission is present on the vehicle.
  public total: u16 = 0

  /// Mission state machine state. MISSION_STATE_UNKNOWN if state reporting not supported.
  /// Values: `MissionState`.
  public missionState: u8 = 0

  /// Vehicle is in a mode that can execute mission items or suspended. 0: Unknown, 1: In mission mode, 2:
  /// Suspended (not in mission mode).
  public missionMode: u8 = 0

  /// Id of current on-vehicle mission plan, or 0 if IDs are not supported or there is no mission loaded.
  /// GCS can use this to track changes to the mission plan type. The same value is returned on mission
  /// upload (in the MISSION_ACK).
  public missionId: u32 = 0

  /// Id of current on-vehicle fence plan, or 0 if IDs are not supported or there is no fence loaded. GCS
  /// can use this to track changes to the fence plan type. The same value is returned on fence upload (in
  /// the MISSION_ACK).
  public fenceId: u32 = 0

  /// Id of current on-vehicle rally point plan, or 0 if IDs are not supported or there are no rally
  /// points loaded. GCS can use this to track changes to the rally point plan type. The same value is
  /// returned on rally point upload (in the MISSION_ACK).
  public rallyPointsId: u32 = 0

  /// A MISSION_CURRENT from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): MissionCurrent {
    const m = new MissionCurrent()
    m.seq = readU16(payload, 0)
    m.total = readU16(payload, 2)
    m.missionState = readU8(payload, 4)
    m.missionMode = readU8(payload, 5)
    m.missionId = readU32(payload, 6)
    m.fenceId = readU32(payload, 10)
    m.rallyPointsId = readU32(payload, 14)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 2, this.seq as int)
    writeUint(into, at + 2, 2, this.total as int)
    writeUint(into, at + 4, 1, this.missionState as int)
    writeUint(into, at + 5, 1, this.missionMode as int)
    writeUint(into, at + 6, 4, this.missionId as int)
    writeUint(into, at + 10, 4, this.fenceId as int)
    writeUint(into, at + 14, 4, this.rallyPointsId as int)
  }

  public override info(): MessageInfo {
    MissionCurrent.INFO
  }
}

