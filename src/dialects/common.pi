/// Flags to report failure cases over the high latency telemetry.
export class HlFailureFlag {
  /// GPS failure.
  public static readonly GPS: int = 1

  /// Differential pressure sensor failure.
  public static readonly DIFFERENTIAL_PRESSURE: int = 2

  /// Absolute pressure sensor failure.
  public static readonly ABSOLUTE_PRESSURE: int = 4

  /// Accelerometer sensor failure.
  public static readonly HL_FAILURE_FLAG_3D_ACCEL: int = 8

  /// Gyroscope sensor failure.
  public static readonly HL_FAILURE_FLAG_3D_GYRO: int = 16

  /// Magnetometer sensor failure.
  public static readonly HL_FAILURE_FLAG_3D_MAG: int = 32

  /// Terrain subsystem failure.
  public static readonly TERRAIN: int = 64

  /// Battery failure/critical low battery.
  public static readonly BATTERY: int = 128

  /// RC receiver failure/no RC connection.
  public static readonly RC_RECEIVER: int = 256

  /// Offboard link failure.
  public static readonly OFFBOARD_LINK: int = 512

  /// Engine failure.
  public static readonly ENGINE: int = 1024

  /// Geofence violation.
  public static readonly GEOFENCE: int = 2048

  /// Estimator failure, for example measurement rejection or large variances.
  public static readonly ESTIMATOR: int = 4096

  /// Mission failure.
  public static readonly MISSION: int = 8192

  /// The name of `value` (`GPS` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      1 => "GPS",
      2 => "DIFFERENTIAL_PRESSURE",
      4 => "ABSOLUTE_PRESSURE",
      8 => "HL_FAILURE_FLAG_3D_ACCEL",
      16 => "HL_FAILURE_FLAG_3D_GYRO",
      32 => "HL_FAILURE_FLAG_3D_MAG",
      64 => "TERRAIN",
      128 => "BATTERY",
      256 => "RC_RECEIVER",
      512 => "OFFBOARD_LINK",
      1024 => "ENGINE",
      2048 => "GEOFENCE",
      4096 => "ESTIMATOR",
      8192 => "MISSION",
      _ => null,
    }
  }
}

/// Actions that may be specified in MAV_CMD_OVERRIDE_GOTO to override mission execution.
export class MavGoto {
  /// Hold at the current position.
  public static readonly DO_HOLD: int = 0

  /// Continue with the next item in mission execution.
  public static readonly DO_CONTINUE: int = 1

  /// Hold at the current position of the system
  public static readonly HOLD_AT_CURRENT_POSITION: int = 2

  /// Hold at the position specified in the parameters of the DO_HOLD action
  public static readonly HOLD_AT_SPECIFIED_POSITION: int = 3

  /// The name of `value` (`DO_HOLD` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "DO_HOLD",
      1 => "DO_CONTINUE",
      2 => "HOLD_AT_CURRENT_POSITION",
      3 => "HOLD_AT_SPECIFIED_POSITION",
      _ => null,
    }
  }
}

/// Predefined OR-combined MAV_MODE_FLAG values. These can simplify using the flags when setting modes.
/// Note that manual input is enabled in all modes as a safety override.
export class MavMode {
  /// System is not ready to fly, booting, calibrating, etc. No flag is set.
  public static readonly PREFLIGHT: int = 0

  /// System is allowed to be active, under assisted RC control (MAV_MODE_FLAG_SAFETY_ARMED,
  /// MAV_MODE_FLAG_STABILIZE_ENABLED)
  public static readonly STABILIZE_DISARMED: int = 80

  /// System is allowed to be active, under assisted RC control (MAV_MODE_FLAG_SAFETY_ARMED,
  /// MAV_MODE_FLAG_MANUAL_INPUT_ENABLED, MAV_MODE_FLAG_STABILIZE_ENABLED)
  public static readonly STABILIZE_ARMED: int = 208

  /// System is allowed to be active, under manual (RC) control, no stabilization
  /// (MAV_MODE_FLAG_MANUAL_INPUT_ENABLED)
  public static readonly MANUAL_DISARMED: int = 64

  /// System is allowed to be active, under manual (RC) control, no stabilization
  /// (MAV_MODE_FLAG_SAFETY_ARMED, MAV_MODE_FLAG_MANUAL_INPUT_ENABLED)
  public static readonly MANUAL_ARMED: int = 192

  /// System is allowed to be active, under autonomous control, manual setpoint
  /// (MAV_MODE_FLAG_SAFETY_ARMED, MAV_MODE_FLAG_STABILIZE_ENABLED, MAV_MODE_FLAG_GUIDED_ENABLED)
  public static readonly GUIDED_DISARMED: int = 88

  /// System is allowed to be active, under autonomous control, manual setpoint
  /// (MAV_MODE_FLAG_SAFETY_ARMED, MAV_MODE_FLAG_MANUAL_INPUT_ENABLED, MAV_MODE_FLAG_STABILIZE_ENABLED,
  /// MAV_MODE_FLAG_GUIDED_ENABLED)
  public static readonly GUIDED_ARMED: int = 216

  /// System is allowed to be active, under autonomous control and navigation (the trajectory is decided
  /// onboard and not pre-programmed by waypoints). (MAV_MODE_FLAG_SAFETY_ARMED,
  /// MAV_MODE_FLAG_STABILIZE_ENABLED, MAV_MODE_FLAG_GUIDED_ENABLED, MAV_MODE_FLAG_AUTO_ENABLED).
  public static readonly AUTO_DISARMED: int = 92

  /// System is allowed to be active, under autonomous control and navigation (the trajectory is decided
  /// onboard and not pre-programmed by waypoints). (MAV_MODE_FLAG_SAFETY_ARMED,
  /// MAV_MODE_FLAG_MANUAL_INPUT_ENABLED, MAV_MODE_FLAG_STABILIZE_ENABLED,
  /// MAV_MODE_FLAG_GUIDED_ENABLED,MAV_MODE_FLAG_AUTO_ENABLED).
  public static readonly AUTO_ARMED: int = 220

  /// UNDEFINED mode. This solely depends on the autopilot - use with caution, intended for developers
  /// only. (MAV_MODE_FLAG_MANUAL_INPUT_ENABLED, MAV_MODE_FLAG_TEST_ENABLED).
  public static readonly TEST_DISARMED: int = 66

  /// UNDEFINED mode. This solely depends on the autopilot - use with caution, intended for developers
  /// only (MAV_MODE_FLAG_SAFETY_ARMED, MAV_MODE_FLAG_MANUAL_INPUT_ENABLED, MAV_MODE_FLAG_TEST_ENABLED)
  public static readonly TEST_ARMED: int = 194

  /// The name of `value` (`PREFLIGHT` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "PREFLIGHT",
      80 => "STABILIZE_DISARMED",
      208 => "STABILIZE_ARMED",
      64 => "MANUAL_DISARMED",
      192 => "MANUAL_ARMED",
      88 => "GUIDED_DISARMED",
      216 => "GUIDED_ARMED",
      92 => "AUTO_DISARMED",
      220 => "AUTO_ARMED",
      66 => "TEST_DISARMED",
      194 => "TEST_ARMED",
      _ => null,
    }
  }
}

