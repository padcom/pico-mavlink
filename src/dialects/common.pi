    }
  }
}

/// Gimbal device (low level) error flags (bitmap, 0 means no error)
export class GimbalDeviceErrorFlags {
  /// Gimbal device is limited by hardware roll limit.
  public static readonly AT_ROLL_LIMIT: int = 1

  /// Gimbal device is limited by hardware pitch limit.
  public static readonly AT_PITCH_LIMIT: int = 2

  /// Gimbal device is limited by hardware yaw limit.
  public static readonly AT_YAW_LIMIT: int = 4

  /// There is an error with the gimbal encoders.
  public static readonly ENCODER_ERROR: int = 8

  /// There is an error with the gimbal power source.
  public static readonly POWER_ERROR: int = 16

  /// There is an error with the gimbal motors.
  public static readonly MOTOR_ERROR: int = 32

  /// There is an error with the gimbal's software.
  public static readonly SOFTWARE_ERROR: int = 64

  /// There is an error with the gimbal's communication.
  public static readonly COMMS_ERROR: int = 128

  /// Gimbal device is currently calibrating.
  public static readonly CALIBRATION_RUNNING: int = 256

  /// Gimbal device is not assigned to a gimbal manager.
  public static readonly NO_MANAGER: int = 512

  /// The name of `value` (`AT_ROLL_LIMIT` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      1 => "AT_ROLL_LIMIT",
      2 => "AT_PITCH_LIMIT",
      4 => "AT_YAW_LIMIT",
      8 => "ENCODER_ERROR",
      16 => "POWER_ERROR",
      32 => "MOTOR_ERROR",
      64 => "SOFTWARE_ERROR",
      128 => "COMMS_ERROR",
      256 => "CALIBRATION_RUNNING",
      512 => "NO_MANAGER",
      _ => null,
    }
  }
}

/// Gripper actions.
export class GripperActions {
  /// Gripper release cargo.
  public static readonly RELEASE: int = 0

  /// Gripper grab onto cargo.
  public static readonly GRAB: int = 1

  /// Gripper hold current grip state/position.
  public static readonly HOLD: int = 2

  /// The name of `value` (`RELEASE` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "RELEASE",
      1 => "GRAB",
      2 => "HOLD",
      _ => null,
    }
  }
}

/// Winch actions.
export class WinchActions {
  /// Allow motor to freewheel.
  public static readonly RELAXED: int = 0

  /// Wind or unwind specified length of line, optionally using specified rate.
  public static readonly RELATIVE_LENGTH_CONTROL: int = 1

  /// Wind or unwind line at specified rate.
  public static readonly RATE_CONTROL: int = 2

  /// Perform the locking sequence to relieve motor while in the fully retracted position. Only action and
  /// instance command parameters are used, others are ignored.
  public static readonly LOCK: int = 3

  /// Sequence of drop, slow down, touch down, reel up, lock. Only action and instance command parameters
  /// are used, others are ignored.
  public static readonly DELIVER: int = 4

  /// Engage motor and hold current position. Only action and instance command parameters are used, others
  /// are ignored.
  public static readonly HOLD: int = 5

  /// Return the reel to the fully retracted position. Only action and instance command parameters are
  /// used, others are ignored.
  public static readonly RETRACT: int = 6

  /// Load the reel with line. The winch will calculate the total loaded length and stop when the tension
  /// exceeds a threshold. Only action and instance command parameters are used, others are ignored.
  public static readonly LOAD_LINE: int = 7

  /// Spool out the entire length of the line. Only action and instance command parameters are used,
  /// others are ignored.
  public static readonly ABANDON_LINE: int = 8

  /// Spools out just enough to present the hook to the user to load the payload. Only action and instance
  /// command parameters are used, others are ignored
  public static readonly LOAD_PAYLOAD: int = 9

  /// The name of `value` (`RELAXED` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "RELAXED",
      1 => "RELATIVE_LENGTH_CONTROL",
      2 => "RATE_CONTROL",
      3 => "LOCK",
      4 => "DELIVER",
      5 => "HOLD",
      6 => "RETRACT",
      7 => "LOAD_LINE",
      8 => "ABANDON_LINE",
      9 => "LOAD_PAYLOAD",
      _ => null,
    }
  }
}

/// Generalized UAVCAN node health
export class UavcanNodeHealth {
  /// The node is functioning properly.
