    m.heading = readU8(payload, 26)
    m.targetHeading = readU8(payload, 27)
    m.throttle = readU8(payload, 28)
    m.airspeed = readU8(payload, 29)
    m.airspeedSp = readU8(payload, 30)
    m.groundspeed = readU8(payload, 31)
    m.windspeed = readU8(payload, 32)
    m.windHeading = readU8(payload, 33)
    m.eph = readU8(payload, 34)
    m.epv = readU8(payload, 35)
    m.temperatureAir = readI8(payload, 36)
    m.climbRate = readI8(payload, 37)
    m.battery = readI8(payload, 38)
    m.custom0 = readI8(payload, 39)
    m.custom1 = readI8(payload, 40)
    m.custom2 = readI8(payload, 41)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.timestamp as int)
