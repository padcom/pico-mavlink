  /// RC channel 3 value
  /// Units: us.
  public chan3Raw: u16 = 0

  /// RC channel 4 value
  /// Units: us.
  public chan4Raw: u16 = 0

  /// RC channel 5 value
  /// Units: us.
  public chan5Raw: u16 = 0

  /// RC channel 6 value
  /// Units: us.
  public chan6Raw: u16 = 0

  /// RC channel 7 value
  /// Units: us.
  public chan7Raw: u16 = 0

  /// RC channel 8 value
  /// Units: us.
  public chan8Raw: u16 = 0

  /// RC channel 9 value
  /// Units: us.
  public chan9Raw: u16 = 0

  /// RC channel 10 value
  /// Units: us.
  public chan10Raw: u16 = 0

  /// RC channel 11 value
  /// Units: us.
  public chan11Raw: u16 = 0

  /// RC channel 12 value
  /// Units: us.
  public chan12Raw: u16 = 0

  /// Receive signal strength indicator in device-dependent units/scale. Values: [0-254], UINT8_MAX:
  /// invalid/unknown.
  public rssi: u8 = 0

  /// A HIL_RC_INPUTS_RAW from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): HilRcInputsRaw {
    const m = new HilRcInputsRaw()
    m.timeUsec = readU64(payload, 0)
    m.chan1Raw = readU16(payload, 8)
    m.chan2Raw = readU16(payload, 10)
    m.chan3Raw = readU16(payload, 12)
    m.chan4Raw = readU16(payload, 14)
    m.chan5Raw = readU16(payload, 16)
    m.chan6Raw = readU16(payload, 18)
    m.chan7Raw = readU16(payload, 20)
    m.chan8Raw = readU16(payload, 22)
    m.chan9Raw = readU16(payload, 24)
    m.chan10Raw = readU16(payload, 26)
    m.chan11Raw = readU16(payload, 28)
    m.chan12Raw = readU16(payload, 30)
    m.rssi = readU8(payload, 32)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    writeUint(into, at + 8, 2, this.chan1Raw as int)
    writeUint(into, at + 10, 2, this.chan2Raw as int)
    writeUint(into, at + 12, 2, this.chan3Raw as int)
    writeUint(into, at + 14, 2, this.chan4Raw as int)
    writeUint(into, at + 16, 2, this.chan5Raw as int)
    writeUint(into, at + 18, 2, this.chan6Raw as int)
    writeUint(into, at + 20, 2, this.chan7Raw as int)
    writeUint(into, at + 22, 2, this.chan8Raw as int)
    writeUint(into, at + 24, 2, this.chan9Raw as int)
    writeUint(into, at + 26, 2, this.chan10Raw as int)
    writeUint(into, at + 28, 2, this.chan11Raw as int)
    writeUint(into, at + 30, 2, this.chan12Raw as int)
    writeUint(into, at + 32, 1, this.rssi as int)
  }

  public override info(): MessageInfo {
    HilRcInputsRaw.INFO
  }
}

/// Sent from autopilot to simulation. Hardware in the loop control outputs. Alternative to
/// HIL_CONTROLS.
export class HilActuatorControls extends MavLinkData {
  public static readonly MSG_ID: int = 93
  public static readonly MSG_NAME: string = "HIL_ACTUATOR_CONTROLS"
  public static readonly PAYLOAD_LENGTH: int = 81
  public static readonly MAGIC_NUMBER: int = 47
  public static readonly INFO: MessageInfo = new MessageInfo(93, "HIL_ACTUATOR_CONTROLS", 81, 81, 47, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("flags", "flags", 8, false, 8, "uint64_t", ""),
    new MavLinkPacketField("controls", "controls", 16, false, 4, "float[]", "", 16),
    new MavLinkPacketField("mode", "mode", 80, false, 1, "uint8_t", ""),
  ], (p) => HilActuatorControls.decode(p))

  /// Timestamp (UNIX Epoch time or time since system boot). The receiving end can infer timestamp format
  /// (since 1.1.1970 or since system boot) by checking for the magnitude of the number.
  /// Units: us.
  public timeUsec: u64 = 0

  /// Control outputs -1 .. 1. Channel assignment depends on the simulated hardware.
  public controls: f32[] = []

  /// System mode. Includes arming state.
  /// Values: `MavModeFlag`.
  public mode: u8 = 0

  /// Flags bitmask.
  /// Values: `HilActuatorControlsFlags`.
  public flags: u64 = 0

  /// A HIL_ACTUATOR_CONTROLS from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): HilActuatorControls {
    const m = new HilActuatorControls()
    m.timeUsec = readU64(payload, 0)
    m.flags = readU64(payload, 8)
    for (let i = 0; i < 16; i++) {
      m.controls.push(readF32(payload, 16 + i * 4))
    }
    m.mode = readU8(payload, 80)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    writeU64(into, at + 8, this.flags)
    for (let i = 0; i < 16 && i < this.controls.length; i++) {
      writeF32(into, at + 16 + i * 4, this.controls[i])
    }
    writeUint(into, at + 80, 1, this.mode as int)
  }

  public override info(): MessageInfo {
    HilActuatorControls.INFO
  }
}

/// Optical flow from a flow sensor (e.g. optical mouse sensor)
export class OpticalFlow extends MavLinkData {
  public static readonly MSG_ID: int = 100
  public static readonly MSG_NAME: string = "OPTICAL_FLOW"
  public static readonly PAYLOAD_LENGTH: int = 34
  public static readonly MAGIC_NUMBER: int = 175
  public static readonly INFO: MessageInfo = new MessageInfo(100, "OPTICAL_FLOW", 34, 26, 175, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("flow_comp_m_x", "flowCompMX", 8, false, 4, "float", "m/s"),
    new MavLinkPacketField("flow_comp_m_y", "flowCompMY", 12, false, 4, "float", "m/s"),
    new MavLinkPacketField("ground_distance", "groundDistance", 16, false, 4, "float", "m"),
    new MavLinkPacketField("flow_x", "flowX", 20, false, 2, "int16_t", "dpix"),
    new MavLinkPacketField("flow_y", "flowY", 22, false, 2, "int16_t", "dpix"),
    new MavLinkPacketField("sensor_id", "sensorId", 24, false, 1, "uint8_t", ""),
    new MavLinkPacketField("quality", "quality", 25, false, 1, "uint8_t", ""),
    new MavLinkPacketField("flow_rate_x", "flowRateX", 26, true, 4, "float", "rad/s"),
    new MavLinkPacketField("flow_rate_y", "flowRateY", 30, true, 4, "float", "rad/s"),
  ], (p) => OpticalFlow.decode(p))

  /// Timestamp (UNIX Epoch time or time since system boot). The receiving end can infer timestamp format
  /// (since 1.1.1970 or since system boot) by checking for the magnitude of the number.
  /// Units: us.
  public timeUsec: u64 = 0

  /// Sensor ID
  public sensorId: u8 = 0

  /// Flow in x-sensor direction
  /// Units: dpix.
  public flowX: i16 = 0

  /// Flow in y-sensor direction
  /// Units: dpix.
  public flowY: i16 = 0

  /// Flow in x-sensor direction, angular-speed compensated
  /// Units: m/s.
  public flowCompMX: f32 = 0.0

  /// Flow in y-sensor direction, angular-speed compensated
  /// Units: m/s.
  public flowCompMY: f32 = 0.0

  /// Optical flow quality / confidence. 0: bad, 255: maximum quality
  public quality: u8 = 0

  /// Ground distance. Positive value: distance known. Negative value: Unknown distance
  /// Units: m.
  public groundDistance: f32 = 0.0

  /// Flow rate about X axis
  /// Units: rad/s.
  public flowRateX: f32 = 0.0

  /// Flow rate about Y axis
  /// Units: rad/s.
  public flowRateY: f32 = 0.0

  /// A OPTICAL_FLOW from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): OpticalFlow {
    const m = new OpticalFlow()
    m.timeUsec = readU64(payload, 0)
    m.flowCompMX = readF32(payload, 8)
    m.flowCompMY = readF32(payload, 12)
    m.groundDistance = readF32(payload, 16)
    m.flowX = readI16(payload, 20)
    m.flowY = readI16(payload, 22)
    m.sensorId = readU8(payload, 24)
    m.quality = readU8(payload, 25)
    m.flowRateX = readF32(payload, 26)
    m.flowRateY = readF32(payload, 30)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    writeF32(into, at + 8, this.flowCompMX)
    writeF32(into, at + 12, this.flowCompMY)
    writeF32(into, at + 16, this.groundDistance)
    writeUint(into, at + 20, 2, this.flowX as int)
    writeUint(into, at + 22, 2, this.flowY as int)
    writeUint(into, at + 24, 1, this.sensorId as int)
    writeUint(into, at + 25, 1, this.quality as int)
    writeF32(into, at + 26, this.flowRateX)
    writeF32(into, at + 30, this.flowRateY)
  }

  public override info(): MessageInfo {
    OpticalFlow.INFO
  }
}

/// Global position/attitude estimate from a vision source.
export class GlobalVisionPositionEstimate extends MavLinkData {
  public static readonly MSG_ID: int = 101
  public static readonly MSG_NAME: string = "GLOBAL_VISION_POSITION_ESTIMATE"
  public static readonly PAYLOAD_LENGTH: int = 117
  public static readonly MAGIC_NUMBER: int = 102
  public static readonly INFO: MessageInfo = new MessageInfo(101, "GLOBAL_VISION_POSITION_ESTIMATE", 117, 32, 102, [
    new MavLinkPacketField("usec", "usec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("x", "x", 8, false, 4, "float", "m"),
    new MavLinkPacketField("y", "y", 12, false, 4, "float", "m"),
    new MavLinkPacketField("z", "z", 16, false, 4, "float", "m"),
    new MavLinkPacketField("roll", "roll", 20, false, 4, "float", "rad"),
    new MavLinkPacketField("pitch", "pitch", 24, false, 4, "float", "rad"),
    new MavLinkPacketField("yaw", "yaw", 28, false, 4, "float", "rad"),
    new MavLinkPacketField("covariance", "covariance", 32, true, 4, "float[]", "", 21),
    new MavLinkPacketField("reset_counter", "resetCounter", 116, true, 1, "uint8_t", ""),
  ], (p) => GlobalVisionPositionEstimate.decode(p))

  /// Timestamp (UNIX time or since system boot)
  /// Units: us.
  public usec: u64 = 0

  /// Global X position
  /// Units: m.
  public x: f32 = 0.0

  /// Global Y position
  /// Units: m.
  public y: f32 = 0.0

  /// Global Z position
  /// Units: m.
  public z: f32 = 0.0

  /// Roll angle
  /// Units: rad.
  public roll: f32 = 0.0

  /// Pitch angle
  /// Units: rad.
  public pitch: f32 = 0.0

  /// Yaw angle
  /// Units: rad.
  public yaw: f32 = 0.0

  /// Row-major representation of pose 6x6 cross-covariance matrix upper right triangle (states: x_global,
  /// y_global, z_global, roll, pitch, yaw; first six entries are the first ROW, next five entries are the
  /// second ROW, etc.). If unknown, assign NaN value to first element in the array.
  public covariance: f32[] = []

  /// Estimate reset counter. This should be incremented when the estimate resets in any of the dimensions
  /// (position, velocity, attitude, angular speed). This is designed to be used when e.g an external SLAM
  /// system detects a loop-closure and the estimate jumps.
  public resetCounter: u8 = 0

  /// A GLOBAL_VISION_POSITION_ESTIMATE from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): GlobalVisionPositionEstimate {
    const m = new GlobalVisionPositionEstimate()
    m.usec = readU64(payload, 0)
    m.x = readF32(payload, 8)
    m.y = readF32(payload, 12)
    m.z = readF32(payload, 16)
    m.roll = readF32(payload, 20)
    m.pitch = readF32(payload, 24)
    m.yaw = readF32(payload, 28)
    for (let i = 0; i < 21; i++) {
      m.covariance.push(readF32(payload, 32 + i * 4))
    }
    m.resetCounter = readU8(payload, 116)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.usec)
    writeF32(into, at + 8, this.x)
    writeF32(into, at + 12, this.y)
    writeF32(into, at + 16, this.z)
    writeF32(into, at + 20, this.roll)
    writeF32(into, at + 24, this.pitch)
    writeF32(into, at + 28, this.yaw)
    for (let i = 0; i < 21 && i < this.covariance.length; i++) {
      writeF32(into, at + 32 + i * 4, this.covariance[i])
    }
    writeUint(into, at + 116, 1, this.resetCounter as int)
  }

  public override info(): MessageInfo {
    GlobalVisionPositionEstimate.INFO
  }
}

