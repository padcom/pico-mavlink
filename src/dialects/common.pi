    new MavLinkPacketField("q", "q", 0, false, 4, "float[]", "", 4),
    new MavLinkPacketField("angular_velocity_x", "angularVelocityX", 16, false, 4, "float", "rad/s"),
    new MavLinkPacketField("angular_velocity_y", "angularVelocityY", 20, false, 4, "float", "rad/s"),
    new MavLinkPacketField("angular_velocity_z", "angularVelocityZ", 24, false, 4, "float", "rad/s"),
    new MavLinkPacketField("flags", "flags", 28, false, 2, "uint16_t", ""),
    new MavLinkPacketField("target_system", "targetSystem", 30, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 31, false, 1, "uint8_t", ""),
  ], (p) => GimbalDeviceSetAttitude.decode(p))

  /// System ID
  public targetSystem: u8 = 0

  /// Component ID
  public targetComponent: u8 = 0

  /// Low level gimbal flags.
  /// Values: `GimbalDeviceFlags`.
  public flags: u16 = 0

  /// Quaternion components, w, x, y, z (1 0 0 0 is the null-rotation). The frame is described in the
  /// message description. Set fields to NaN to be ignored.
  public q: f32[] = []

  /// X component of angular velocity (positive: rolling to the right). The frame is described in the
  /// message description. NaN to be ignored.
  /// Units: rad/s.
  public angularVelocityX: f32 = 0.0

  /// Y component of angular velocity (positive: pitching up). The frame is described in the message
  /// description. NaN to be ignored.
  /// Units: rad/s.
  public angularVelocityY: f32 = 0.0

  /// Z component of angular velocity (positive: yawing to the right). The frame is described in the
  /// message description. NaN to be ignored.
  /// Units: rad/s.
  public angularVelocityZ: f32 = 0.0

  /// A GIMBAL_DEVICE_SET_ATTITUDE from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): GimbalDeviceSetAttitude {
    const m = new GimbalDeviceSetAttitude()
    for (let i = 0; i < 4; i++) {
      m.q.push(readF32(payload, 0 + i * 4))
    }
    m.angularVelocityX = readF32(payload, 16)
    m.angularVelocityY = readF32(payload, 20)
    m.angularVelocityZ = readF32(payload, 24)
    m.flags = readU16(payload, 28)
    m.targetSystem = readU8(payload, 30)
    m.targetComponent = readU8(payload, 31)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    for (let i = 0; i < 4 && i < this.q.length; i++) {
      writeF32(into, at + 0 + i * 4, this.q[i])
    }
    writeF32(into, at + 16, this.angularVelocityX)
    writeF32(into, at + 20, this.angularVelocityY)
    writeF32(into, at + 24, this.angularVelocityZ)
    writeUint(into, at + 28, 2, this.flags as int)
    writeUint(into, at + 30, 1, this.targetSystem as int)
    writeUint(into, at + 31, 1, this.targetComponent as int)
  }

  public override info(): MessageInfo {
    GimbalDeviceSetAttitude.INFO
  }
}

/// Message reporting the status of a gimbal device. This message should be broadcast by a gimbal device
/// component at a low regular rate (e.g. 5 Hz). For the angles encoded in the quaternion and the
/// angular velocities holds: If the flag GIMBAL_DEVICE_FLAGS_YAW_IN_VEHICLE_FRAME is set, then they are
/// relative to the vehicle heading (vehicle frame). If the flag GIMBAL_DEVICE_FLAGS_YAW_IN_EARTH_FRAME
/// is set, then they are relative to absolute North (earth frame). If neither of these flags are set,
/// then (for backwards compatibility) it holds: If the flag GIMBAL_DEVICE_FLAGS_YAW_LOCK is set, then
/// they are relative to absolute North (earth frame), else they are relative to the vehicle heading
/// (vehicle frame). Other conditions of the flags are not allowed. The quaternion and angular
/// velocities in the other frame can be calculated from delta_yaw and delta_yaw_velocity as q_earth =
/// q_delta_yaw * q_vehicle and w_earth = w_delta_yaw_velocity + w_vehicle (if not NaN). If neither the
/// GIMBAL_DEVICE_FLAGS_YAW_IN_VEHICLE_FRAME nor the GIMBAL_DEVICE_FLAGS_YAW_IN_EARTH_FRAME flag is set,
/// then (for backwards compatibility) the data in the delta_yaw and delta_yaw_velocity fields are to be
/// ignored. New implementations should always set either GIMBAL_DEVICE_FLAGS_YAW_IN_VEHICLE_FRAME or
/// GIMBAL_DEVICE_FLAGS_YAW_IN_EARTH_FRAME, and always should set delta_yaw and delta_yaw_velocity
/// either to the proper value or NaN.
