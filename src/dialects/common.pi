  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.timeLastBaselineMs as int)
    writeUint(into, at + 4, 4, this.tow as int)
    writeUint(into, at + 8, 4, this.baselineAMm as int)
    writeUint(into, at + 12, 4, this.baselineBMm as int)
    writeUint(into, at + 16, 4, this.baselineCMm as int)
    writeUint(into, at + 20, 4, this.accuracy as int)
    writeUint(into, at + 24, 4, this.iarNumHypotheses as int)
    writeUint(into, at + 28, 2, this.wn as int)
    writeUint(into, at + 30, 1, this.rtkReceiverId as int)
    writeUint(into, at + 31, 1, this.rtkHealth as int)
    writeUint(into, at + 32, 1, this.rtkRate as int)
    writeUint(into, at + 33, 1, this.nsats as int)
    writeUint(into, at + 34, 1, this.baselineCoordsType as int)
  }

  public override info(): MessageInfo {
    Gps2Rtk.INFO
  }
}

/// The RAW IMU readings for 3rd 9DOF sensor setup. This message should contain the scaled values to the
/// described units
export class ScaledImu3 extends MavLinkData {
  public static readonly MSG_ID: int = 129
  public static readonly MSG_NAME: string = "SCALED_IMU3"
  public static readonly PAYLOAD_LENGTH: int = 24
  public static readonly MAGIC_NUMBER: int = 46
  public static readonly INFO: MessageInfo = new MessageInfo(129, "SCALED_IMU3", 24, 22, 46, [
    new MavLinkPacketField("time_boot_ms", "timeBootMs", 0, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("xacc", "xacc", 4, false, 2, "int16_t", "mG"),
    new MavLinkPacketField("yacc", "yacc", 6, false, 2, "int16_t", "mG"),
    new MavLinkPacketField("zacc", "zacc", 8, false, 2, "int16_t", "mG"),
    new MavLinkPacketField("xgyro", "xgyro", 10, false, 2, "int16_t", "mrad/s"),
    new MavLinkPacketField("ygyro", "ygyro", 12, false, 2, "int16_t", "mrad/s"),
    new MavLinkPacketField("zgyro", "zgyro", 14, false, 2, "int16_t", "mrad/s"),
    new MavLinkPacketField("xmag", "xmag", 16, false, 2, "int16_t", "mgauss"),
    new MavLinkPacketField("ymag", "ymag", 18, false, 2, "int16_t", "mgauss"),
    new MavLinkPacketField("zmag", "zmag", 20, false, 2, "int16_t", "mgauss"),
    new MavLinkPacketField("temperature", "temperature", 22, true, 2, "int16_t", "cdegC"),
  ], (p) => ScaledImu3.decode(p))

  /// Timestamp (time since system boot).
  /// Units: ms.
  public timeBootMs: u32 = 0

  /// X acceleration
  /// Units: mG.
  public xacc: i16 = 0

  /// Y acceleration
  /// Units: mG.
  public yacc: i16 = 0

  /// Z acceleration
  /// Units: mG.
  public zacc: i16 = 0

  /// Angular speed around X axis
  /// Units: mrad/s.
  public xgyro: i16 = 0

  /// Angular speed around Y axis
  /// Units: mrad/s.
  public ygyro: i16 = 0

  /// Angular speed around Z axis
  /// Units: mrad/s.
  public zgyro: i16 = 0

  /// X Magnetic field
  /// Units: mgauss.
  public xmag: i16 = 0

  /// Y Magnetic field
  /// Units: mgauss.
  public ymag: i16 = 0

  /// Z Magnetic field
  /// Units: mgauss.
  public zmag: i16 = 0

  /// Temperature, 0: IMU does not provide temperature values. If the IMU is at 0C it must send 1 (0.01C).
  /// Units: cdegC.
  public temperature: i16 = 0

  /// A SCALED_IMU3 from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): ScaledImu3 {
    const m = new ScaledImu3()
    m.timeBootMs = readU32(payload, 0)
    m.xacc = readI16(payload, 4)
    m.yacc = readI16(payload, 6)
    m.zacc = readI16(payload, 8)
    m.xgyro = readI16(payload, 10)
    m.ygyro = readI16(payload, 12)
    m.zgyro = readI16(payload, 14)
    m.xmag = readI16(payload, 16)
    m.ymag = readI16(payload, 18)
    m.zmag = readI16(payload, 20)
    m.temperature = readI16(payload, 22)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.timeBootMs as int)
    writeUint(into, at + 4, 2, this.xacc as int)
    writeUint(into, at + 6, 2, this.yacc as int)
    writeUint(into, at + 8, 2, this.zacc as int)
    writeUint(into, at + 10, 2, this.xgyro as int)
    writeUint(into, at + 12, 2, this.ygyro as int)
    writeUint(into, at + 14, 2, this.zgyro as int)
    writeUint(into, at + 16, 2, this.xmag as int)
    writeUint(into, at + 18, 2, this.ymag as int)
    writeUint(into, at + 20, 2, this.zmag as int)
    writeUint(into, at + 22, 2, this.temperature as int)
  }

  public override info(): MessageInfo {
    ScaledImu3.INFO
  }
}

/// Handshake message to initiate, control and stop image streaming when using the Image Transmission
/// Protocol: https://mavlink.io/en/services/image_transmission.html.
export class DataTransmissionHandshake extends MavLinkData {
  public static readonly MSG_ID: int = 130
  public static readonly MSG_NAME: string = "DATA_TRANSMISSION_HANDSHAKE"
  public static readonly PAYLOAD_LENGTH: int = 13
  public static readonly MAGIC_NUMBER: int = 29
  public static readonly INFO: MessageInfo = new MessageInfo(130, "DATA_TRANSMISSION_HANDSHAKE", 13, 13, 29, [
    new MavLinkPacketField("size", "size", 0, false, 4, "uint32_t", "bytes"),
    new MavLinkPacketField("width", "width", 4, false, 2, "uint16_t", ""),
    new MavLinkPacketField("height", "height", 6, false, 2, "uint16_t", ""),
    new MavLinkPacketField("packets", "packets", 8, false, 2, "uint16_t", ""),
    new MavLinkPacketField("type", "type", 10, false, 1, "uint8_t", ""),
    new MavLinkPacketField("payload", "payload", 11, false, 1, "uint8_t", "bytes"),
    new MavLinkPacketField("jpg_quality", "jpgQuality", 12, false, 1, "uint8_t", "%"),
  ], (p) => DataTransmissionHandshake.decode(p))

  /// Type of requested/acknowledged data.
  /// Values: `MavlinkDataStreamType`.
  public type: u8 = 0

  /// total data size (set on ACK only).
  /// Units: bytes.
  public size: u32 = 0

  /// Width of a matrix or image.
  public width: u16 = 0

  /// Height of a matrix or image.
  public height: u16 = 0

  /// Number of packets being sent (set on ACK only).
  public packets: u16 = 0

  /// Payload size per packet (normally 253 byte, see DATA field size in message ENCAPSULATED_DATA) (set
  /// on ACK only).
  /// Units: bytes.
  public payload: u8 = 0

  /// JPEG quality. Values: [1-100].
  /// Units: %.
  public jpgQuality: u8 = 0

  /// A DATA_TRANSMISSION_HANDSHAKE from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): DataTransmissionHandshake {
    const m = new DataTransmissionHandshake()
    m.size = readU32(payload, 0)
    m.width = readU16(payload, 4)
    m.height = readU16(payload, 6)
    m.packets = readU16(payload, 8)
    m.type = readU8(payload, 10)
    m.payload = readU8(payload, 11)
    m.jpgQuality = readU8(payload, 12)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.size as int)
    writeUint(into, at + 4, 2, this.width as int)
    writeUint(into, at + 6, 2, this.height as int)
    writeUint(into, at + 8, 2, this.packets as int)
    writeUint(into, at + 10, 1, this.type as int)
    writeUint(into, at + 11, 1, this.payload as int)
    writeUint(into, at + 12, 1, this.jpgQuality as int)
  }

  public override info(): MessageInfo {
    DataTransmissionHandshake.INFO
  }
}

/// Data packet for images sent using the Image Transmission Protocol:
/// https://mavlink.io/en/services/image_transmission.html.
export class EncapsulatedData extends MavLinkData {
  public static readonly MSG_ID: int = 131
  public static readonly MSG_NAME: string = "ENCAPSULATED_DATA"
  public static readonly PAYLOAD_LENGTH: int = 255
  public static readonly MAGIC_NUMBER: int = 223
  public static readonly INFO: MessageInfo = new MessageInfo(131, "ENCAPSULATED_DATA", 255, 255, 223, [
    new MavLinkPacketField("seqnr", "seqnr", 0, false, 2, "uint16_t", ""),
    new MavLinkPacketField("data", "data", 2, false, 1, "uint8_t[]", "", 253),
  ], (p) => EncapsulatedData.decode(p))

  /// sequence number (starting with 0 on every transmission)
  public seqnr: u16 = 0

  /// image data bytes
  public data: u8[] = []

  /// A ENCAPSULATED_DATA from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): EncapsulatedData {
    const m = new EncapsulatedData()
    m.seqnr = readU16(payload, 0)
    for (let i = 0; i < 253; i++) {
      m.data.push(readU8(payload, 2 + i * 1))
    }
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 2, this.seqnr as int)
    for (let i = 0; i < 253 && i < this.data.length; i++) {
      writeUint(into, at + 2 + i * 1, 1, this.data[i] as int)
    }
  }

  public override info(): MessageInfo {
    EncapsulatedData.INFO
  }
}

/// Distance sensor information for an onboard rangefinder.
export class DistanceSensor extends MavLinkData {
  public static readonly MSG_ID: int = 132
  public static readonly MSG_NAME: string = "DISTANCE_SENSOR"
  public static readonly PAYLOAD_LENGTH: int = 39
  public static readonly MAGIC_NUMBER: int = 85
  public static readonly INFO: MessageInfo = new MessageInfo(132, "DISTANCE_SENSOR", 39, 14, 85, [
    new MavLinkPacketField("time_boot_ms", "timeBootMs", 0, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("min_distance", "minDistance", 4, false, 2, "uint16_t", "cm"),
    new MavLinkPacketField("max_distance", "maxDistance", 6, false, 2, "uint16_t", "cm"),
    new MavLinkPacketField("current_distance", "currentDistance", 8, false, 2, "uint16_t", "cm"),
    new MavLinkPacketField("type", "type", 10, false, 1, "uint8_t", ""),
    new MavLinkPacketField("id", "id", 11, false, 1, "uint8_t", ""),
    new MavLinkPacketField("orientation", "orientation", 12, false, 1, "uint8_t", ""),
    new MavLinkPacketField("covariance", "covariance", 13, false, 1, "uint8_t", "cm^2"),
    new MavLinkPacketField("horizontal_fov", "horizontalFov", 14, true, 4, "float", "rad"),
    new MavLinkPacketField("vertical_fov", "verticalFov", 18, true, 4, "float", "rad"),
    new MavLinkPacketField("quaternion", "quaternion", 22, true, 4, "float[]", "", 4),
    new MavLinkPacketField("signal_quality", "signalQuality", 38, true, 1, "uint8_t", "%"),
  ], (p) => DistanceSensor.decode(p))

  /// Timestamp (time since system boot).
  /// Units: ms.
  public timeBootMs: u32 = 0

  /// Minimum distance the sensor can measure
  /// Units: cm.
  public minDistance: u16 = 0

  /// Maximum distance the sensor can measure
  /// Units: cm.
  public maxDistance: u16 = 0

  /// Current distance reading
  /// Units: cm.
  public currentDistance: u16 = 0

  /// Type of distance sensor.
  /// Values: `MavDistanceSensor`.
  public type: u8 = 0

  /// Onboard ID of the sensor
  public id: u8 = 0

  /// Direction the sensor faces. downward-facing: ROTATION_PITCH_270, upward-facing: ROTATION_PITCH_90,
  /// backward-facing: ROTATION_PITCH_180, forward-facing: ROTATION_NONE, left-facing: ROTATION_YAW_90,
  /// right-facing: ROTATION_YAW_270
  /// Values: `MavSensorOrientation`.
  public orientation: u8 = 0

  /// Measurement variance. Max standard deviation is 6cm. UINT8_MAX if unknown.
  /// Units: cm^2.
  public covariance: u8 = 0

  /// Horizontal Field of View (angle) where the distance measurement is valid and the field of view is
  /// known. Otherwise this is set to 0.
  /// Units: rad.
  public horizontalFov: f32 = 0.0

  /// Vertical Field of View (angle) where the distance measurement is valid and the field of view is
  /// known. Otherwise this is set to 0.
  /// Units: rad.
  public verticalFov: f32 = 0.0

  /// Quaternion of the sensor orientation in vehicle body frame (w, x, y, z order, zero-rotation is 1, 0,
  /// 0, 0). Zero-rotation is along the vehicle body x-axis. This field is required if the orientation is
  /// set to MAV_SENSOR_ROTATION_CUSTOM. Set it to 0 if invalid."
  public quaternion: f32[] = []

  /// Signal quality of the sensor. Specific to each sensor type, representing the relation of the signal
  /// strength with the target reflectivity, distance, size or aspect, but normalised as a percentage. 0 =
  /// unknown/unset signal quality, 1 = invalid signal, 100 = perfect signal.
  /// Units: %.
  public signalQuality: u8 = 0

  /// A DISTANCE_SENSOR from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): DistanceSensor {
    const m = new DistanceSensor()
    m.timeBootMs = readU32(payload, 0)
    m.minDistance = readU16(payload, 4)
    m.maxDistance = readU16(payload, 6)
    m.currentDistance = readU16(payload, 8)
    m.type = readU8(payload, 10)
    m.id = readU8(payload, 11)
    m.orientation = readU8(payload, 12)
    m.covariance = readU8(payload, 13)
    m.horizontalFov = readF32(payload, 14)
    m.verticalFov = readF32(payload, 18)
    for (let i = 0; i < 4; i++) {
      m.quaternion.push(readF32(payload, 22 + i * 4))
    }
    m.signalQuality = readU8(payload, 38)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.timeBootMs as int)
    writeUint(into, at + 4, 2, this.minDistance as int)
    writeUint(into, at + 6, 2, this.maxDistance as int)
    writeUint(into, at + 8, 2, this.currentDistance as int)
    writeUint(into, at + 10, 1, this.type as int)
    writeUint(into, at + 11, 1, this.id as int)
    writeUint(into, at + 12, 1, this.orientation as int)
    writeUint(into, at + 13, 1, this.covariance as int)
    writeF32(into, at + 14, this.horizontalFov)
    writeF32(into, at + 18, this.verticalFov)
    for (let i = 0; i < 4 && i < this.quaternion.length; i++) {
      writeF32(into, at + 22 + i * 4, this.quaternion[i])
    }
    writeUint(into, at + 38, 1, this.signalQuality as int)
  }

  public override info(): MessageInfo {
    DistanceSensor.INFO
  }
}

/// Request for terrain data and terrain status. See terrain protocol docs:
/// https://mavlink.io/en/services/terrain.html
export class TerrainRequest extends MavLinkData {
  public static readonly MSG_ID: int = 133
  public static readonly MSG_NAME: string = "TERRAIN_REQUEST"
  public static readonly PAYLOAD_LENGTH: int = 18
  public static readonly MAGIC_NUMBER: int = 6
  public static readonly INFO: MessageInfo = new MessageInfo(133, "TERRAIN_REQUEST", 18, 18, 6, [
    new MavLinkPacketField("mask", "mask", 0, false, 8, "uint64_t", ""),
    new MavLinkPacketField("lat", "lat", 8, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("lon", "lon", 12, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("grid_spacing", "gridSpacing", 16, false, 2, "uint16_t", "m"),
  ], (p) => TerrainRequest.decode(p))

  /// Latitude of SW corner of first grid
  /// Units: degE7.
  public lat: i32 = 0

  /// Longitude of SW corner of first grid
  /// Units: degE7.
  public lon: i32 = 0

  /// Grid spacing
  /// Units: m.
  public gridSpacing: u16 = 0

  /// Bitmask of requested 4x4 grids (row major 8x7 array of grids, 56 bits)
  public mask: u64 = 0

  /// A TERRAIN_REQUEST from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): TerrainRequest {
    const m = new TerrainRequest()
    m.mask = readU64(payload, 0)
    m.lat = readI32(payload, 8)
    m.lon = readI32(payload, 12)
    m.gridSpacing = readU16(payload, 16)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.mask)
    writeUint(into, at + 8, 4, this.lat as int)
    writeUint(into, at + 12, 4, this.lon as int)
    writeUint(into, at + 16, 2, this.gridSpacing as int)
  }

  public override info(): MessageInfo {
    TerrainRequest.INFO
  }
}

/// Terrain data sent from GCS. The lat/lon and grid_spacing must be the same as a lat/lon from a
/// TERRAIN_REQUEST. See terrain protocol docs: https://mavlink.io/en/services/terrain.html
export class TerrainData extends MavLinkData {
  public static readonly MSG_ID: int = 134
  public static readonly MSG_NAME: string = "TERRAIN_DATA"
  public static readonly PAYLOAD_LENGTH: int = 43
  public static readonly MAGIC_NUMBER: int = 229
  public static readonly INFO: MessageInfo = new MessageInfo(134, "TERRAIN_DATA", 43, 43, 229, [
    new MavLinkPacketField("lat", "lat", 0, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("lon", "lon", 4, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("grid_spacing", "gridSpacing", 8, false, 2, "uint16_t", "m"),
    new MavLinkPacketField("data", "data", 10, false, 2, "int16_t[]", "m", 16),
    new MavLinkPacketField("gridbit", "gridbit", 42, false, 1, "uint8_t", ""),
  ], (p) => TerrainData.decode(p))

  /// Latitude of SW corner of first grid
  /// Units: degE7.
  public lat: i32 = 0

  /// Longitude of SW corner of first grid
  /// Units: degE7.
  public lon: i32 = 0

  /// Grid spacing
  /// Units: m.
  public gridSpacing: u16 = 0

  /// bit within the terrain request mask
  public gridbit: u8 = 0

  /// Terrain data MSL
  /// Units: m.
  public data: i16[] = []

  /// A TERRAIN_DATA from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): TerrainData {
    const m = new TerrainData()
    m.lat = readI32(payload, 0)
    m.lon = readI32(payload, 4)
    m.gridSpacing = readU16(payload, 8)
    for (let i = 0; i < 16; i++) {
      m.data.push(readI16(payload, 10 + i * 2))
    }
    m.gridbit = readU8(payload, 42)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.lat as int)
    writeUint(into, at + 4, 4, this.lon as int)
    writeUint(into, at + 8, 2, this.gridSpacing as int)
    for (let i = 0; i < 16 && i < this.data.length; i++) {
      writeUint(into, at + 10 + i * 2, 2, this.data[i] as int)
    }
    writeUint(into, at + 42, 1, this.gridbit as int)
  }

  public override info(): MessageInfo {
    TerrainData.INFO
  }
}

/// Request that the vehicle report terrain height at the given location (expected response is a
/// TERRAIN_REPORT). Used by GCS to check if vehicle has all terrain data needed for a mission.
export class TerrainCheck extends MavLinkData {
  public static readonly MSG_ID: int = 135
  public static readonly MSG_NAME: string = "TERRAIN_CHECK"
  public static readonly PAYLOAD_LENGTH: int = 8
  public static readonly MAGIC_NUMBER: int = 203
  public static readonly INFO: MessageInfo = new MessageInfo(135, "TERRAIN_CHECK", 8, 8, 203, [
    new MavLinkPacketField("lat", "lat", 0, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("lon", "lon", 4, false, 4, "int32_t", "degE7"),
  ], (p) => TerrainCheck.decode(p))

  /// Latitude
  /// Units: degE7.
  public lat: i32 = 0

  /// Longitude
  /// Units: degE7.
  public lon: i32 = 0

  /// A TERRAIN_CHECK from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): TerrainCheck {
    const m = new TerrainCheck()
    m.lat = readI32(payload, 0)
    m.lon = readI32(payload, 4)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.lat as int)
    writeUint(into, at + 4, 4, this.lon as int)
  }

  public override info(): MessageInfo {
    TerrainCheck.INFO
  }
}

/// Streamed from drone to report progress of terrain map download (initiated by TERRAIN_REQUEST), or
/// sent as a response to a TERRAIN_CHECK request. See terrain protocol docs:
/// https://mavlink.io/en/services/terrain.html
export class TerrainReport extends MavLinkData {
  public static readonly MSG_ID: int = 136
  public static readonly MSG_NAME: string = "TERRAIN_REPORT"
  public static readonly PAYLOAD_LENGTH: int = 22
  public static readonly MAGIC_NUMBER: int = 1
  public static readonly INFO: MessageInfo = new MessageInfo(136, "TERRAIN_REPORT", 22, 22, 1, [
    new MavLinkPacketField("lat", "lat", 0, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("lon", "lon", 4, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("terrain_height", "terrainHeight", 8, false, 4, "float", "m"),
    new MavLinkPacketField("current_height", "currentHeight", 12, false, 4, "float", "m"),
    new MavLinkPacketField("spacing", "spacing", 16, false, 2, "uint16_t", ""),
    new MavLinkPacketField("pending", "pending", 18, false, 2, "uint16_t", ""),
    new MavLinkPacketField("loaded", "loaded", 20, false, 2, "uint16_t", ""),
  ], (p) => TerrainReport.decode(p))

  /// Latitude
  /// Units: degE7.
  public lat: i32 = 0

  /// Longitude
  /// Units: degE7.
  public lon: i32 = 0

  /// grid spacing (zero if terrain at this location unavailable)
  public spacing: u16 = 0

  /// Terrain height MSL
  /// Units: m.
  public terrainHeight: f32 = 0.0

  /// Current vehicle height above lat/lon terrain height
  /// Units: m.
  public currentHeight: f32 = 0.0

  /// Number of 4x4 terrain blocks waiting to be received or read from disk
  public pending: u16 = 0

  /// Number of 4x4 terrain blocks in memory
  public loaded: u16 = 0

  /// A TERRAIN_REPORT from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): TerrainReport {
    const m = new TerrainReport()
    m.lat = readI32(payload, 0)
    m.lon = readI32(payload, 4)
    m.terrainHeight = readF32(payload, 8)
    m.currentHeight = readF32(payload, 12)
    m.spacing = readU16(payload, 16)
    m.pending = readU16(payload, 18)
    m.loaded = readU16(payload, 20)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.lat as int)
    writeUint(into, at + 4, 4, this.lon as int)
    writeF32(into, at + 8, this.terrainHeight)
    writeF32(into, at + 12, this.currentHeight)
    writeUint(into, at + 16, 2, this.spacing as int)
    writeUint(into, at + 18, 2, this.pending as int)
    writeUint(into, at + 20, 2, this.loaded as int)
  }

  public override info(): MessageInfo {
    TerrainReport.INFO
  }
}

/// Barometer readings for 2nd barometer
export class ScaledPressure2 extends MavLinkData {
  public static readonly MSG_ID: int = 137
  public static readonly MSG_NAME: string = "SCALED_PRESSURE2"
  public static readonly PAYLOAD_LENGTH: int = 16
  public static readonly MAGIC_NUMBER: int = 195
  public static readonly INFO: MessageInfo = new MessageInfo(137, "SCALED_PRESSURE2", 16, 14, 195, [
    new MavLinkPacketField("time_boot_ms", "timeBootMs", 0, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("press_abs", "pressAbs", 4, false, 4, "float", "hPa"),
    new MavLinkPacketField("press_diff", "pressDiff", 8, false, 4, "float", "hPa"),
    new MavLinkPacketField("temperature", "temperature", 12, false, 2, "int16_t", "cdegC"),
    new MavLinkPacketField("temperature_press_diff", "temperaturePressDiff", 14, true, 2, "int16_t", "cdegC"),
  ], (p) => ScaledPressure2.decode(p))

  /// Timestamp (time since system boot).
  /// Units: ms.
  public timeBootMs: u32 = 0

  /// Absolute pressure
  /// Units: hPa.
  public pressAbs: f32 = 0.0

  /// Differential pressure
  /// Units: hPa.
  public pressDiff: f32 = 0.0

  /// Absolute pressure temperature
  /// Units: cdegC.
  public temperature: i16 = 0

  /// Differential pressure temperature (0, if not available). Report values of 0 (or 1) as 1 cdegC.
  /// Units: cdegC.
  public temperaturePressDiff: i16 = 0

  /// A SCALED_PRESSURE2 from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): ScaledPressure2 {
    const m = new ScaledPressure2()
    m.timeBootMs = readU32(payload, 0)
    m.pressAbs = readF32(payload, 4)
    m.pressDiff = readF32(payload, 8)
    m.temperature = readI16(payload, 12)
    m.temperaturePressDiff = readI16(payload, 14)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.timeBootMs as int)
    writeF32(into, at + 4, this.pressAbs)
    writeF32(into, at + 8, this.pressDiff)
    writeUint(into, at + 12, 2, this.temperature as int)
    writeUint(into, at + 14, 2, this.temperaturePressDiff as int)
  }

  public override info(): MessageInfo {
    ScaledPressure2.INFO
  }
}

/// Motion capture attitude and position
export class MotionCaptureAttPos extends MavLinkData {
  public static readonly MSG_ID: int = 138
  public static readonly MSG_NAME: string = "ATT_POS_MOCAP"
  public static readonly PAYLOAD_LENGTH: int = 120
  public static readonly MAGIC_NUMBER: int = 109
  public static readonly INFO: MessageInfo = new MessageInfo(138, "ATT_POS_MOCAP", 120, 36, 109, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("q", "q", 8, false, 4, "float[]", "", 4),
    new MavLinkPacketField("x", "x", 24, false, 4, "float", "m"),
    new MavLinkPacketField("y", "y", 28, false, 4, "float", "m"),
    new MavLinkPacketField("z", "z", 32, false, 4, "float", "m"),
    new MavLinkPacketField("covariance", "covariance", 36, true, 4, "float[]", "", 21),
  ], (p) => MotionCaptureAttPos.decode(p))

  /// Timestamp (UNIX Epoch time or time since system boot). The receiving end can infer timestamp format
  /// (since 1.1.1970 or since system boot) by checking for the magnitude of the number.
  /// Units: us.
  public timeUsec: u64 = 0

  /// Attitude quaternion (w, x, y, z order, zero-rotation is 1, 0, 0, 0)
  public q: f32[] = []

  /// X position (NED)
  /// Units: m.
  public x: f32 = 0.0

  /// Y position (NED)
  /// Units: m.
  public y: f32 = 0.0

  /// Z position (NED)
  /// Units: m.
  public z: f32 = 0.0

  /// Row-major representation of a pose 6x6 cross-covariance matrix upper right triangle (states: x, y,
  /// z, roll, pitch, yaw; first six entries are the first ROW, next five entries are the second ROW,
  /// etc.). If unknown, assign NaN value to first element in the array.
  public covariance: f32[] = []

  /// A ATT_POS_MOCAP from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): MotionCaptureAttPos {
    const m = new MotionCaptureAttPos()
    m.timeUsec = readU64(payload, 0)
    for (let i = 0; i < 4; i++) {
      m.q.push(readF32(payload, 8 + i * 4))
    }
    m.x = readF32(payload, 24)
    m.y = readF32(payload, 28)
    m.z = readF32(payload, 32)
    for (let i = 0; i < 21; i++) {
      m.covariance.push(readF32(payload, 36 + i * 4))
    }
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    for (let i = 0; i < 4 && i < this.q.length; i++) {
      writeF32(into, at + 8 + i * 4, this.q[i])
    }
    writeF32(into, at + 24, this.x)
    writeF32(into, at + 28, this.y)
    writeF32(into, at + 32, this.z)
    for (let i = 0; i < 21 && i < this.covariance.length; i++) {
      writeF32(into, at + 36 + i * 4, this.covariance[i])
    }
  }

  public override info(): MessageInfo {
    MotionCaptureAttPos.INFO
  }
}

/// Set the vehicle attitude and body angular rates.
export class SetActuatorControlTarget extends MavLinkData {
  public static readonly MSG_ID: int = 139
  public static readonly MSG_NAME: string = "SET_ACTUATOR_CONTROL_TARGET"
  public static readonly PAYLOAD_LENGTH: int = 43
  public static readonly MAGIC_NUMBER: int = 168
  public static readonly INFO: MessageInfo = new MessageInfo(139, "SET_ACTUATOR_CONTROL_TARGET", 43, 43, 168, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("controls", "controls", 8, false, 4, "float[]", "", 8),
    new MavLinkPacketField("group_mlx", "groupMlx", 40, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_system", "targetSystem", 41, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 42, false, 1, "uint8_t", ""),
  ], (p) => SetActuatorControlTarget.decode(p))

  /// Timestamp (UNIX Epoch time or time since system boot). The receiving end can infer timestamp format
  /// (since 1.1.1970 or since system boot) by checking for the magnitude of the number.
  /// Units: us.
  public timeUsec: u64 = 0

  /// Actuator group. The "_mlx" indicates this is a multi-instance message and a MAVLink parser should
  /// use this field to difference between instances.
  public groupMlx: u8 = 0

  /// System ID
  public targetSystem: u8 = 0

  /// Component ID
  public targetComponent: u8 = 0

  /// Actuator controls. Normed to -1..+1 where 0 is neutral position. Throttle for single rotation
  /// direction motors is 0..1, negative range for reverse direction. Standard mapping for attitude
  /// controls (group 0): (index 0-7): roll, pitch, yaw, throttle, flaps, spoilers, airbrakes, landing
  /// gear. Load a pass-through mixer to repurpose them as generic outputs.
  public controls: f32[] = []

  /// A SET_ACTUATOR_CONTROL_TARGET from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): SetActuatorControlTarget {
    const m = new SetActuatorControlTarget()
    m.timeUsec = readU64(payload, 0)
    for (let i = 0; i < 8; i++) {
      m.controls.push(readF32(payload, 8 + i * 4))
    }
    m.groupMlx = readU8(payload, 40)
    m.targetSystem = readU8(payload, 41)
    m.targetComponent = readU8(payload, 42)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    for (let i = 0; i < 8 && i < this.controls.length; i++) {
      writeF32(into, at + 8 + i * 4, this.controls[i])
    }
    writeUint(into, at + 40, 1, this.groupMlx as int)
    writeUint(into, at + 41, 1, this.targetSystem as int)
    writeUint(into, at + 42, 1, this.targetComponent as int)
  }

  public override info(): MessageInfo {
    SetActuatorControlTarget.INFO
  }
}

/// Set the vehicle attitude and body angular rates.
export class ActuatorControlTarget extends MavLinkData {
  public static readonly MSG_ID: int = 140
  public static readonly MSG_NAME: string = "ACTUATOR_CONTROL_TARGET"
  public static readonly PAYLOAD_LENGTH: int = 41
  public static readonly MAGIC_NUMBER: int = 181
  public static readonly INFO: MessageInfo = new MessageInfo(140, "ACTUATOR_CONTROL_TARGET", 41, 41, 181, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("controls", "controls", 8, false, 4, "float[]", "", 8),
    new MavLinkPacketField("group_mlx", "groupMlx", 40, false, 1, "uint8_t", ""),
  ], (p) => ActuatorControlTarget.decode(p))

  /// Timestamp (UNIX Epoch time or time since system boot). The receiving end can infer timestamp format
  /// (since 1.1.1970 or since system boot) by checking for the magnitude of the number.
  /// Units: us.
  public timeUsec: u64 = 0

  /// Actuator group. The "_mlx" indicates this is a multi-instance message and a MAVLink parser should
  /// use this field to difference between instances.
  public groupMlx: u8 = 0

  /// Actuator controls. Normed to -1..+1 where 0 is neutral position. Throttle for single rotation
  /// direction motors is 0..1, negative range for reverse direction. Standard mapping for attitude
  /// controls (group 0): (index 0-7): roll, pitch, yaw, throttle, flaps, spoilers, airbrakes, landing
  /// gear. Load a pass-through mixer to repurpose them as generic outputs.
  public controls: f32[] = []

  /// A ACTUATOR_CONTROL_TARGET from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): ActuatorControlTarget {
    const m = new ActuatorControlTarget()
    m.timeUsec = readU64(payload, 0)
    for (let i = 0; i < 8; i++) {
      m.controls.push(readF32(payload, 8 + i * 4))
    }
