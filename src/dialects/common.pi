    m.yacc = readF32(payload, 32)
    m.zacc = readF32(payload, 36)
    m.xgyro = readF32(payload, 40)
    m.ygyro = readF32(payload, 44)
    m.zgyro = readF32(payload, 48)
    m.lat = readF32(payload, 52)
    m.lon = readF32(payload, 56)
    m.alt = readF32(payload, 60)
    m.stdDevHorz = readF32(payload, 64)
    m.stdDevVert = readF32(payload, 68)
    m.vn = readF32(payload, 72)
    m.ve = readF32(payload, 76)
    m.vd = readF32(payload, 80)
    m.latInt = readI32(payload, 84)
    m.lonInt = readI32(payload, 88)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeF32(into, at + 0, this.q1)
