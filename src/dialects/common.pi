    }
    for (let i = 0; i < 5 && i < this.posY.length; i++) {
      writeF32(into, at + 28 + i * 4, this.posY[i])
    }
    for (let i = 0; i < 5 && i < this.posZ.length; i++) {
      writeF32(into, at + 48 + i * 4, this.posZ[i])
    }
    for (let i = 0; i < 5 && i < this.velX.length; i++) {
      writeF32(into, at + 68 + i * 4, this.velX[i])
    }
    for (let i = 0; i < 5 && i < this.velY.length; i++) {
      writeF32(into, at + 88 + i * 4, this.velY[i])
    }
    for (let i = 0; i < 5 && i < this.velZ.length; i++) {
      writeF32(into, at + 108 + i * 4, this.velZ[i])
    }
    for (let i = 0; i < 5 && i < this.accX.length; i++) {
      writeF32(into, at + 128 + i * 4, this.accX[i])
    }
    for (let i = 0; i < 5 && i < this.accY.length; i++) {
      writeF32(into, at + 148 + i * 4, this.accY[i])
    }
    for (let i = 0; i < 5 && i < this.accZ.length; i++) {
      writeF32(into, at + 168 + i * 4, this.accZ[i])
    }
    for (let i = 0; i < 5 && i < this.posYaw.length; i++) {
