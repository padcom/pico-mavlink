  public static readonly MOTOR5: int = 5

  /// Motor 6
  public static readonly MOTOR6: int = 6

  /// Motor 7
  public static readonly MOTOR7: int = 7

  /// Motor 8
  public static readonly MOTOR8: int = 8

  /// Motor 9
  public static readonly MOTOR9: int = 9

  /// Motor 10
  public static readonly MOTOR10: int = 10

  /// Motor 11
  public static readonly MOTOR11: int = 11

  /// Motor 12
  public static readonly MOTOR12: int = 12

  /// Motor 13
  public static readonly MOTOR13: int = 13

  /// Motor 14
  public static readonly MOTOR14: int = 14

  /// Motor 15
  public static readonly MOTOR15: int = 15

  /// Motor 16
  public static readonly MOTOR16: int = 16

  /// Servo 1
  public static readonly SERVO1: int = 33

  /// Servo 2
  public static readonly SERVO2: int = 34

  /// Servo 3
  public static readonly SERVO3: int = 35

  /// Servo 4
  public static readonly SERVO4: int = 36

  /// Servo 5
  public static readonly SERVO5: int = 37

  /// Servo 6
  public static readonly SERVO6: int = 38

  /// Servo 7
  public static readonly SERVO7: int = 39

  /// Servo 8
  public static readonly SERVO8: int = 40

  /// Servo 9
  public static readonly SERVO9: int = 41

  /// Servo 10
  public static readonly SERVO10: int = 42

  /// Servo 11
  public static readonly SERVO11: int = 43

  /// Servo 12
  public static readonly SERVO12: int = 44

  /// Servo 13
  public static readonly SERVO13: int = 45

  /// Servo 14
  public static readonly SERVO14: int = 46

  /// Servo 15
  public static readonly SERVO15: int = 47

  /// Servo 16
  public static readonly SERVO16: int = 48

  /// The name of `value` (`NONE` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "NONE",
      1 => "MOTOR1",
      2 => "MOTOR2",
      3 => "MOTOR3",
      4 => "MOTOR4",
      5 => "MOTOR5",
      6 => "MOTOR6",
      7 => "MOTOR7",
      8 => "MOTOR8",
      9 => "MOTOR9",
      10 => "MOTOR10",
      11 => "MOTOR11",
      12 => "MOTOR12",
      13 => "MOTOR13",
      14 => "MOTOR14",
      15 => "MOTOR15",
      16 => "MOTOR16",
      33 => "SERVO1",
      34 => "SERVO2",
      35 => "SERVO3",
      36 => "SERVO4",
      37 => "SERVO5",
      38 => "SERVO6",
      39 => "SERVO7",
      40 => "SERVO8",
      41 => "SERVO9",
      42 => "SERVO10",
      43 => "SERVO11",
      44 => "SERVO12",
      45 => "SERVO13",
      46 => "SERVO14",
      47 => "SERVO15",
      48 => "SERVO16",
      _ => null,
    }
  }
}

/// Axes that will be autotuned by MAV_CMD_DO_AUTOTUNE_ENABLE. Note that at least one flag must be set
/// in MAV_CMD_DO_AUTOTUNE_ENABLE.param2: if none are set, the flight stack will tune its default set of
/// axes.
export class AutotuneAxis {
  /// Autotune roll axis.
  public static readonly ROLL: int = 1

  /// Autotune pitch axis.
  public static readonly PITCH: int = 2

  /// Autotune yaw axis.
  public static readonly YAW: int = 4

  /// The name of `value` (`ROLL` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      1 => "ROLL",
      2 => "PITCH",
      4 => "YAW",
      _ => null,
    }
  }
}

/// Actions for reading/writing parameters between persistent and volatile storage when using
/// MAV_CMD_PREFLIGHT_STORAGE. (Commonly parameters are loaded from persistent storage (flash/EEPROM)
/// into volatile storage (RAM) on startup and written back when they are changed.)
export class PreflightStorageParameterAction {
  /// Read all parameters from persistent storage. Replaces values in volatile storage.
  public static readonly READ_PERSISTENT: int = 0

  /// Write all parameter values to persistent storage (flash/EEPROM)
  public static readonly WRITE_PERSISTENT: int = 1

  /// Reset parameters to default values (such as sensor calibration, safety settings, and so on). Note
  /// that a flight stack may choose not to reset some parameters at their own discretion (such as those
  /// that are locked or expected to persist for the vehicle lifetime).
  public static readonly RESET_FACTORY_DEFAULT: int = 2

  /// Reset only sensor calibration parameters to factory defaults (or firmware default if not available)
  public static readonly RESET_SENSOR_DEFAULT: int = 3

  /// Reset all parameters to default values.
  public static readonly RESET_ALL_DEFAULT: int = 4

  /// The name of `value` (`READ_PERSISTENT` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "READ_PERSISTENT",
      1 => "WRITE_PERSISTENT",
      2 => "RESET_FACTORY_DEFAULT",
      3 => "RESET_SENSOR_DEFAULT",
      4 => "RESET_ALL_DEFAULT",
      _ => null,
    }
  }
}

/// Actions for reading and writing plan information (mission, rally points, geofence) between
/// persistent and volatile storage when using MAV_CMD_PREFLIGHT_STORAGE. (Commonly missions are loaded
/// from persistent storage (flash/EEPROM) into volatile storage (RAM) on startup and written back when
/// they are changed.)
export class PreflightStorageMissionAction {
  /// Read current mission data from persistent storage
  public static readonly READ_PERSISTENT: int = 0

  /// Write current mission data to persistent storage
  public static readonly WRITE_PERSISTENT: int = 1

  /// Erase all mission data stored on the vehicle (both persistent and volatile storage)
  public static readonly RESET_DEFAULT: int = 2

  /// The name of `value` (`READ_PERSISTENT` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "READ_PERSISTENT",
      1 => "WRITE_PERSISTENT",
      2 => "RESET_DEFAULT",
      _ => null,
    }
  }
}

/// Reboot/shutdown action for selected component in MAV_CMD_PREFLIGHT_REBOOT_SHUTDOWN.
export class RebootShutdownAction {
  /// Do nothing.
  public static readonly NONE: int = 0

  /// Reboot component.
  public static readonly REBOOT: int = 1

  /// Shutdown component.
  public static readonly SHUTDOWN: int = 2

  /// Reboot component and keep it in the bootloader until upgraded.
  public static readonly REBOOT_TO_BOOTLOADER: int = 3

  /// Power on component. Do nothing if component is already powered (ACK command with
  /// MAV_RESULT_ACCEPTED).
  public static readonly POWER_ON: int = 4

  /// The name of `value` (`NONE` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "NONE",
      1 => "REBOOT",
      2 => "SHUTDOWN",
      3 => "REBOOT_TO_BOOTLOADER",
      4 => "POWER_ON",
      _ => null,
    }
  }
}

/// Specifies the conditions under which the MAV_CMD_PREFLIGHT_REBOOT_SHUTDOWN command should be
/// accepted.
export class RebootShutdownConditions {
  /// Reboot/Shutdown only if allowed by safety checks, such as being landed.
  public static readonly SAFETY_INTERLOCKED: int = 0

  /// Force reboot/shutdown of the autopilot/component regardless of system state.
  public static readonly FORCE: int = 20190226

  /// The name of `value` (`SAFETY_INTERLOCKED` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "SAFETY_INTERLOCKED",
      20190226 => "FORCE",
      _ => null,
    }
  }
}

/// Commands to be executed by the MAV. They can be executed on user request, or as part of a mission
/// script. If the action is used in a mission, the parameter mapping to the waypoint/mission message is
/// as follows: Param 1, Param 2, Param 3, Param 4, X: Param 5, Y:Param 6, Z:Param 7. This command list
/// is similar what ARINC 424 is for commercial aircraft: A data format how to interpret
/// waypoint/mission data. NaN and INT32_MAX may be used in float/integer params (respectively) to
/// indicate optional/default values (e.g. to use the component's current yaw or latitude rather than a
/// specific value). See https://mavlink.io/en/guide/xml_schema.html#MAV_CMD for information about the
/// structure of the MAV_CMD entries
export class MavCmd {
  /// Navigate to waypoint. This is intended for use in missions (for guided commands outside of missions
  /// use MAV_CMD_DO_REPOSITION).
  public static readonly NAV_WAYPOINT: int = 16

  /// Loiter around this waypoint an unlimited amount of time
  public static readonly NAV_LOITER_UNLIM: int = 17

  /// Loiter around this waypoint for X turns
  public static readonly NAV_LOITER_TURNS: int = 18

  /// Loiter at the specified latitude, longitude and altitude for a certain amount of time. Multicopter
  /// vehicles stop at the point (within a vehicle-specific acceptance radius). Forward-only moving
  /// vehicles (e.g. fixed-wing) circle the point with the specified radius/direction. If the Heading
  /// Required parameter (2) is non-zero forward moving aircraft will only leave the loiter circle once
  /// heading towards the next waypoint.
  public static readonly NAV_LOITER_TIME: int = 19

  /// Return to launch location
  public static readonly NAV_RETURN_TO_LAUNCH: int = 20

  /// Land at location.
  public static readonly NAV_LAND: int = 21

  /// Takeoff from ground / hand. Vehicles that support multiple takeoff modes (e.g. VTOL quadplane)
  /// should take off using the currently configured mode.
  public static readonly NAV_TAKEOFF: int = 22

  /// Land at local position (local frame only)
  public static readonly NAV_LAND_LOCAL: int = 23

  /// Takeoff from local position (local frame only)
  public static readonly NAV_TAKEOFF_LOCAL: int = 24

  /// Vehicle following, i.e. this waypoint represents the position of a moving vehicle
  public static readonly NAV_FOLLOW: int = 25

  /// Continue on the current course and climb/descend to specified altitude. When the altitude is reached
  /// continue to the next command (i.e., don't proceed to the next command until the desired altitude is
  /// reached.
  public static readonly NAV_CONTINUE_AND_CHANGE_ALT: int = 30

  /// Begin loiter at the specified Latitude and Longitude. If Lat=Lon=0, then loiter at the current
  /// position. Don't consider the navigation command complete (don't leave loiter) until the altitude has
  /// been reached. Additionally, if the Heading Required parameter is non-zero the aircraft will not
  /// leave the loiter until heading toward the next waypoint.
  public static readonly NAV_LOITER_TO_ALT: int = 31

  /// Begin following a target
  public static readonly DO_FOLLOW: int = 32

  /// Reposition the MAV after a follow target command has been sent
  public static readonly DO_FOLLOW_REPOSITION: int = 33

  /// Start orbiting on the circumference of a circle defined by the parameters. Setting values to
  /// NaN/INT32_MAX (as appropriate) results in using defaults.
  public static readonly DO_ORBIT: int = 34

  /// Fly a figure eight path as defined by the parameters. Set parameters to NaN/INT32_MAX (as
  /// appropriate) to use system-default values. The command is intended for fixed wing vehicles (and VTOL
  /// hybrids flying in fixed-wing mode), allowing POI tracking for gimbals that don't support infinite
  /// rotation. This command only defines the flight path. Speed should be set independently (use e.g.
  /// MAV_CMD_DO_CHANGE_SPEED). Yaw and other degrees of freedom are not specified, and will be
  /// flight-stack specific (on vehicles where they can be controlled independent of the heading).
  public static readonly DO_FIGURE_EIGHT: int = 35

  /// Sets the region of interest (ROI) for a sensor set or the vehicle itself. This can then be used by
  /// the vehicle's control system to control the vehicle attitude and the attitude of various sensors
  /// such as cameras.
  public static readonly NAV_ROI: int = 80

  /// Control autonomous path planning on the MAV.
  public static readonly NAV_PATHPLANNING: int = 81

  /// Navigate to waypoint using a spline path.
  public static readonly NAV_SPLINE_WAYPOINT: int = 82

  /// Takeoff from ground using VTOL mode, and transition to forward flight with specified heading. The
  /// command should be ignored by vehicles that dont support both VTOL and fixed-wing flight
  /// (multicopters, boats,etc.).
  public static readonly NAV_VTOL_TAKEOFF: int = 84

  /// Land using VTOL mode
  public static readonly NAV_VTOL_LAND: int = 85

  /// Hand control over to an external controller
  public static readonly NAV_GUIDED_ENABLE: int = 92

  /// Delay the next navigation command a number of seconds or until a specified time
  public static readonly NAV_DELAY: int = 93

  /// Descend and place payload. Vehicle moves to specified location, descends until it detects a hanging
  /// payload has reached the ground, and then releases the payload. If ground is not detected before the
  /// reaching the maximum descent value (param1), the command will complete without releasing the
  /// payload.
  public static readonly NAV_PAYLOAD_PLACE: int = 94

  /// NOP - This command is only used to mark the upper limit of the NAV/ACTION commands in the
  /// enumeration
  public static readonly NAV_LAST: int = 95

  /// Delay mission state machine.
  public static readonly CONDITION_DELAY: int = 112

  /// Ascend/descend to target altitude at specified rate. Delay mission state machine until desired
  /// altitude reached.
  public static readonly CONDITION_CHANGE_ALT: int = 113

  /// Delay mission state machine until within desired distance of next NAV point.
  public static readonly CONDITION_DISTANCE: int = 114

  /// Reach a certain target angle.
  public static readonly CONDITION_YAW: int = 115

  /// NOP - This command is only used to mark the upper limit of the CONDITION commands in the enumeration
  public static readonly CONDITION_LAST: int = 159

  /// Set system mode.
  public static readonly DO_SET_MODE: int = 176

  /// Jump to the desired command in the mission list. Repeat this action only the specified number of
  /// times
  public static readonly DO_JUMP: int = 177

  /// Change speed and/or throttle set points. The value persists until it is overridden or there is a
  /// mode change
  public static readonly DO_CHANGE_SPEED: int = 178

  /// Sets the home position to either to the current position or a specified position. The home position
  /// is the default position that the system will return to and land on. The position is set
  /// automatically by the system during the takeoff (and may also be set using this command). Note: the
  /// current home position may be emitted in a HOME_POSITION message on request (using
  /// MAV_CMD_REQUEST_MESSAGE with param1=242).
  public static readonly DO_SET_HOME: int = 179

  /// Set a system parameter. Caution! Use of this command requires knowledge of the numeric enumeration
  /// value of the parameter.
  public static readonly DO_SET_PARAMETER: int = 180

  /// Set a relay to a condition. The current value may optionally be reported using RELAY_STATUS.
  public static readonly DO_SET_RELAY: int = 181

  /// Cycle a relay on and off for a desired number of cycles with a desired period.
  public static readonly DO_REPEAT_RELAY: int = 182

  /// Set a servo to a desired PWM value.
  public static readonly DO_SET_SERVO: int = 183

  /// Cycle a between its nominal setting and a desired PWM for a desired number of cycles with a desired
  /// period.
  public static readonly DO_REPEAT_SERVO: int = 184

  /// Terminate flight immediately. Flight termination immediately and irreversibly terminates the current
  /// flight, returning the vehicle to ground. The vehicle will ignore RC or other input until it has been
  /// power-cycled. Termination may trigger safety measures, including: disabling motors and deployment of
  /// parachute on multicopters, and setting flight surfaces to initiate a landing pattern on fixed-wing).
  /// On multicopters without a parachute it may trigger a crash landing. Support for this command can be
  /// tested using the protocol bit: MAV_PROTOCOL_CAPABILITY_FLIGHT_TERMINATION. Support for this command
  /// can also be tested by sending the command with param1=0 (< 0.5); the ACK should be either
  /// MAV_RESULT_FAILED or MAV_RESULT_UNSUPPORTED.
  public static readonly DO_FLIGHTTERMINATION: int = 185

  /// Change altitude set point.
  public static readonly DO_CHANGE_ALTITUDE: int = 186

  /// Sets actuators (e.g. servos) to a desired value. The actuator numbers are mapped to specific outputs
  /// (e.g. on any MAIN or AUX PWM or UAVCAN) using a flight-stack specific mechanism (i.e. a parameter).
  public static readonly DO_SET_ACTUATOR: int = 187

  /// Mission item to specify the start of a failsafe/landing return-path segment (the end of the segment
  /// is the next MAV_CMD_DO_LAND_START item). A vehicle that is using missions for landing (e.g. in a
  /// return mode) will join the mission on the closest path of the return-path segment (instead of
  /// MAV_CMD_DO_LAND_START or the nearest waypoint). The main use case is to minimize the failsafe flight
  /// path in corridor missions, where the inbound/outbound paths are constrained (by geofences) to the
  /// same particular path. The MAV_CMD_NAV_RETURN_PATH_START would be placed at the start of the return
  /// path. If a failsafe occurs on the outbound path the vehicle will move to the nearest point on the
  /// return path (which is parallel for this kind of mission), effectively turning round and following
  /// the shortest path to landing. If a failsafe occurs on the inbound path the vehicle is already on the
  /// return segment and will continue to landing. The Latitude/Longitude/Altitude are optional, and may
  /// be set to 0 if not needed. If specified, the item defines the waypoint at which the return segment
  /// starts. If sent using as a command, the vehicle will perform a mission landing (using the land
  /// segment if defined) or reject the command if mission landings are not supported, or no mission
  /// landing is defined. When used as a command any position information in the command is ignored.
  public static readonly DO_RETURN_PATH_START: int = 188

  /// Mission item to mark the start of a mission landing pattern, or a command to land with a mission
  /// landing pattern. When used in a mission, this is a marker for the start of a sequence of mission
  /// items that represent a landing pattern. It should be followed by a navigation item that defines the
  /// first waypoint of the landing sequence. The start marker positional params are used only for
  /// selecting what landing pattern to use if several are defined in the mission (the selected pattern
  /// will be the one with the marker position that is closest to the vehicle when a landing is
  /// commanded). If the marker item position has zero-values for latitude, longitude, and altitude, then
  /// landing pattern selection is instead based on the position of the first waypoint in the landing
  /// sequence. When sent as a command it triggers a landing using a mission landing pattern. The location
  /// parameters are not used in this case, and should be set to 0.
  public static readonly DO_LAND_START: int = 189

  /// Mission command to perform a landing from a rally point.
  public static readonly DO_RALLY_LAND: int = 190

  /// Mission command to safely abort an autonomous landing.
  public static readonly DO_GO_AROUND: int = 191

  /// Reposition the vehicle to a specific WGS84 global position. This command is intended for guided
  /// commands (for missions use MAV_CMD_NAV_WAYPOINT instead).
  public static readonly DO_REPOSITION: int = 192

  /// If in a GPS controlled position mode, hold the current position or continue.
  public static readonly DO_PAUSE_CONTINUE: int = 193

  /// Set moving direction to forward or reverse.
  public static readonly DO_SET_REVERSE: int = 194

  /// Sets the region of interest (ROI) to a location. This can then be used by the vehicle's control
  /// system to control the vehicle attitude and the attitude of various sensors such as cameras. This
  /// command can be sent to a gimbal manager but not to a gimbal device. A gimbal is not to react to this
  /// message.
  public static readonly DO_SET_ROI_LOCATION: int = 195

  /// Sets the region of interest (ROI) to be toward next waypoint, with optional pitch/roll/yaw offset.
  /// This can then be used by the vehicle's control system to control the vehicle attitude and the
  /// attitude of various sensors such as cameras. This command can be sent to a gimbal manager but not to
  /// a gimbal device. A gimbal device is not to react to this message.
  public static readonly DO_SET_ROI_WPNEXT_OFFSET: int = 196

  /// Cancels any previous ROI command returning the vehicle/sensors to default flight characteristics.
  /// This can then be used by the vehicle's control system to control the vehicle attitude and the
  /// attitude of various sensors such as cameras. This command can be sent to a gimbal manager but not to
  /// a gimbal device. A gimbal device is not to react to this message. After this command the gimbal
  /// manager should go back to manual input if available, and otherwise assume a neutral position.
  public static readonly DO_SET_ROI_NONE: int = 197

  /// Mount tracks system with specified system ID. Determination of target vehicle position may be done
  /// with GLOBAL_POSITION_INT or any other means. This command can be sent to a gimbal manager but not to
  /// a gimbal device. A gimbal device is not to react to this message.
  public static readonly DO_SET_ROI_SYSID: int = 198

  /// Control onboard camera system.
  public static readonly DO_CONTROL_VIDEO: int = 200

  /// Sets the region of interest (ROI) for a sensor set or the vehicle itself. This can then be used by
  /// the vehicle's control system to control the vehicle attitude and the attitude of various sensors
  /// such as cameras.
  public static readonly DO_SET_ROI: int = 201

  /// Configure digital camera. This is a fallback message for systems that have not yet implemented
  /// PARAM_EXT_XXX messages and camera definition files (see
  /// https://mavlink.io/en/services/camera_def.html ).
  public static readonly DO_DIGICAM_CONFIGURE: int = 202

  /// Control digital camera. This is a fallback message for systems that have not yet implemented
  /// PARAM_EXT_XXX messages and camera definition files (see
  /// https://mavlink.io/en/services/camera_def.html ).
  public static readonly DO_DIGICAM_CONTROL: int = 203

  /// Mission command to configure a camera or antenna mount
  public static readonly DO_MOUNT_CONFIGURE: int = 204

  /// Mission command to control a camera or antenna mount
  public static readonly DO_MOUNT_CONTROL: int = 205

  /// Mission command to set camera trigger distance for this flight. The camera is triggered each time
  /// this distance is exceeded. This command can also be used to set the shutter integration time for the
  /// camera.
  public static readonly DO_SET_CAM_TRIGG_DIST: int = 206

  /// Enable the geofence. This can be used in a mission or via the command protocol. The
  /// persistence/lifetime of the setting is undefined. Depending on flight stack implementation it may
  /// persist until superseded, or it may revert to a system default at the end of a mission. Flight
  /// stacks typically reset the setting to system defaults on reboot.
  public static readonly DO_FENCE_ENABLE: int = 207

  /// Mission item/command to release a parachute or enable/disable auto release.
  public static readonly DO_PARACHUTE: int = 208

  /// Command to perform motor test.
  public static readonly DO_MOTOR_TEST: int = 209

  /// Change to/from inverted flight.
  public static readonly DO_INVERTED_FLIGHT: int = 210

  /// Mission command to operate a gripper.
  public static readonly DO_GRIPPER: int = 211

  /// Enable/disable autotune.
  public static readonly DO_AUTOTUNE_ENABLE: int = 212

  /// Sets a desired vehicle turn angle and speed change.
  public static readonly NAV_SET_YAW_SPEED: int = 213

  /// Mission command to set camera trigger interval for this flight. If triggering is enabled, the camera
  /// is triggered each time this interval expires. This command can also be used to set the shutter
  /// integration time for the camera.
  public static readonly DO_SET_CAM_TRIGG_INTERVAL: int = 214

  /// Mission command to control a camera or antenna mount, using a quaternion as reference.
  public static readonly DO_MOUNT_CONTROL_QUAT: int = 220

  /// set id of master controller
  public static readonly DO_GUIDED_MASTER: int = 221

  /// Set limits for external control
  public static readonly DO_GUIDED_LIMITS: int = 222

  /// Control vehicle engine. This is interpreted by the vehicles engine controller to change the target
  /// engine state. It is intended for vehicles with internal combustion engines
  public static readonly DO_ENGINE_CONTROL: int = 223

  /// Set the mission item with sequence number seq as the current item and emit MISSION_CURRENT (whether
  /// or not the mission number changed). If a mission is currently being executed, the system will
  /// continue to this new mission item on the shortest path, skipping any intermediate mission items.
  /// Note that mission jump repeat counters are not reset unless param2 is set (see MAV_CMD_DO_JUMP
  /// param2). This command may trigger a mission state-machine change on some systems: for example from
  /// MISSION_STATE_NOT_STARTED or MISSION_STATE_PAUSED to MISSION_STATE_ACTIVE. If the system is in
  /// mission mode, on those systems this command might therefore start, restart or resume the mission. If
  /// the system is not in mission mode this command must not trigger a switch to mission mode. The
  /// mission may be "reset" using param2. Resetting sets jump counters to initial values (to reset
  /// counters without changing the current mission item set the param1 to `-1`). Resetting also
  /// explicitly changes a mission state of MISSION_STATE_COMPLETE to MISSION_STATE_PAUSED or
  /// MISSION_STATE_ACTIVE, potentially allowing it to resume when it is (next) in a mission mode. The
  /// command will ACK with MAV_RESULT_FAILED if the sequence number is out of range (including if there
  /// is no mission item).
  public static readonly DO_SET_MISSION_CURRENT: int = 224

  /// NOP - This command is only used to mark the upper limit of the DO commands in the enumeration
  public static readonly DO_LAST: int = 240

  /// Trigger calibration. This command will be only accepted if in pre-flight mode. Except for
  /// Temperature Calibration, only one sensor should be set in a single message and all others should be
  /// zero.
  public static readonly PREFLIGHT_CALIBRATION: int = 241

  /// Set sensor offsets. This command will be only accepted if in pre-flight mode.
  public static readonly PREFLIGHT_SET_SENSOR_OFFSETS: int = 242

  /// Trigger UAVCAN configuration (actuator ID assignment and direction mapping). Note that this maps to
  /// the legacy UAVCAN v0 function UAVCAN_ENUMERATE, which is intended to be executed just once during
  /// initial vehicle configuration (it is not a normal pre-flight command and has been poorly named).
  public static readonly PREFLIGHT_UAVCAN: int = 243

  /// Request storage of different parameter values and logs. This command will be only accepted if in
  /// pre-flight mode.
  public static readonly PREFLIGHT_STORAGE: int = 245

  /// Request the reboot or shutdown of system components.
  public static readonly PREFLIGHT_REBOOT_SHUTDOWN: int = 246

  /// Override current mission with command to pause mission, pause mission and move to position,
  /// continue/resume mission. When param 1 indicates that the mission is paused (MAV_GOTO_DO_HOLD), param
  /// 2 defines whether it holds in place or moves to another position.
  public static readonly OVERRIDE_GOTO: int = 252

  /// Mission command to set a Camera Auto Mount Pivoting Oblique Survey (Replaces CAM_TRIGG_DIST for this
  /// purpose). The camera is triggered each time this distance is exceeded, then the mount moves to the
  /// next position. Params 4~6 set-up the angle limits and number of positions for oblique survey, where
  /// mount-enabled vehicles automatically roll the camera between shots to emulate an oblique camera
  /// setup (providing an increased HFOV). This command can also be used to set the shutter integration
  /// time for the camera.
  public static readonly OBLIQUE_SURVEY: int = 260

  /// Enable the specified standard MAVLink mode. If the specified mode is not supported, the vehicle
  /// should ACK with MAV_RESULT_FAILED. See https://mavlink.io/en/services/standard_modes.html
  public static readonly DO_SET_STANDARD_MODE: int = 262

  /// start running a mission
  public static readonly MISSION_START: int = 300

  /// Actuator testing command. This is similar to MAV_CMD_DO_MOTOR_TEST but operates on the level of
  /// output functions, i.e. it is possible to test Motor1 independent from which output it is configured
  /// on. Autopilots must NACK this command with MAV_RESULT_TEMPORARILY_REJECTED while armed.
  public static readonly ACTUATOR_TEST: int = 310

  /// Actuator configuration command.
  public static readonly CONFIGURE_ACTUATOR: int = 311

  /// Arms / Disarms a component
  public static readonly COMPONENT_ARM_DISARM: int = 400

  /// Instructs a target system to run pre-arm checks. This allows preflight checks to be run on demand,
  /// which may be useful on systems that normally run them at low rate, or which do not trigger checks
  /// when the armable state might have changed. This command should return MAV_RESULT_ACCEPTED if it will
  /// run the checks. The results of the checks are usually then reported in SYS_STATUS messages (this is
  /// system-specific). The command should return MAV_RESULT_TEMPORARILY_REJECTED if the system is already
  /// armed.
  public static readonly RUN_PREARM_CHECKS: int = 401

  /// Turns illuminators ON/OFF. An illuminator is a light source that is used for lighting up dark areas
  /// external to the system: e.g. a torch or searchlight (as opposed to a light source for illuminating
  /// the system itself, e.g. an indicator light).
  public static readonly ILLUMINATOR_ON_OFF: int = 405

  /// Configures illuminator settings. An illuminator is a light source that is used for lighting up dark
  /// areas external to the system: e.g. a torch or searchlight (as opposed to a light source for
  /// illuminating the system itself, e.g. an indicator light).
  public static readonly DO_ILLUMINATOR_CONFIGURE: int = 406

  /// Request the home position from the vehicle. The vehicle will ACK the command and emit the
  /// HOME_POSITION message.
  public static readonly GET_HOME_POSITION: int = 410

  /// Inject artificial failure for testing purposes. Note that autopilots should implement an additional
  /// protection before accepting this command such as a specific param setting.
  public static readonly INJECT_FAILURE: int = 420

  /// Starts receiver pairing.
  public static readonly START_RX_PAIR: int = 500

  /// Request the interval between messages for a particular MAVLink message ID. The receiver should ACK
  /// the command and then emit its response in a MESSAGE_INTERVAL message.
  public static readonly GET_MESSAGE_INTERVAL: int = 510

  /// Set the interval between messages for a particular MAVLink message ID. This interface replaces
  /// REQUEST_DATA_STREAM.
  public static readonly SET_MESSAGE_INTERVAL: int = 511

  /// Request the target system(s) emit a single instance of a specified message (i.e. a "one-shot"
  /// version of MAV_CMD_SET_MESSAGE_INTERVAL).
  public static readonly REQUEST_MESSAGE: int = 512

  /// Request MAVLink protocol version compatibility. All receivers should ACK the command and then emit
  /// their capabilities in an PROTOCOL_VERSION message
  public static readonly REQUEST_PROTOCOL_VERSION: int = 519

  /// Request autopilot capabilities. The receiver should ACK the command and then emit its capabilities
  /// in an AUTOPILOT_VERSION message
  public static readonly REQUEST_AUTOPILOT_CAPABILITIES: int = 520

  /// Request camera information (CAMERA_INFORMATION).
  public static readonly REQUEST_CAMERA_INFORMATION: int = 521

  /// Request camera settings (CAMERA_SETTINGS).
  public static readonly REQUEST_CAMERA_SETTINGS: int = 522

  /// Request storage information (STORAGE_INFORMATION). Use the command's target_component to target a
  /// specific component's storage.
  public static readonly REQUEST_STORAGE_INFORMATION: int = 525

  /// Format a storage medium. Once format is complete, a STORAGE_INFORMATION message is sent. Use the
  /// command's target_component to target a specific component's storage.
  public static readonly STORAGE_FORMAT: int = 526

  /// Request camera capture status (CAMERA_CAPTURE_STATUS)
  public static readonly REQUEST_CAMERA_CAPTURE_STATUS: int = 527

  /// Request flight information (FLIGHT_INFORMATION)
  public static readonly REQUEST_FLIGHT_INFORMATION: int = 528

  /// Reset all camera settings to Factory Default
  public static readonly RESET_CAMERA_SETTINGS: int = 529

  /// Set camera running mode. Use NaN for reserved values. GCS will send a
  /// MAV_CMD_REQUEST_VIDEO_STREAM_STATUS command after a mode change if the camera supports video
  /// streaming.
  public static readonly SET_CAMERA_MODE: int = 530

  /// Set camera zoom. Camera must respond with a CAMERA_SETTINGS message (on success).
  public static readonly SET_CAMERA_ZOOM: int = 531

  /// Set camera focus. Camera must respond with a CAMERA_SETTINGS message (on success).
  public static readonly SET_CAMERA_FOCUS: int = 532

  /// Set that a particular storage is the preferred location for saving photos, videos, and/or other
  /// media (e.g. to set that an SD card is used for storing videos). There can only be one preferred save
  /// location for each particular media type: setting a media usage flag will clear/reset that same flag
  /// if set on any other storage. If no flag is set the system should use its default storage. A target
  /// system can choose to always use default storage, in which case it should ACK the command with
  /// MAV_RESULT_UNSUPPORTED. A target system can choose to not allow a particular storage to be set as
  /// preferred storage, in which case it should ACK the command with MAV_RESULT_DENIED.
  public static readonly SET_STORAGE_USAGE: int = 533

  /// Set camera source. Changes the camera's active sources on cameras with multiple image sensors.
  public static readonly SET_CAMERA_SOURCE: int = 534

  /// Tagged jump target. Can be jumped to with MAV_CMD_DO_JUMP_TAG.
  public static readonly JUMP_TAG: int = 600

  /// Jump to the matching tag in the mission list. Repeat this action for the specified number of times.
  /// A mission should contain a single matching tag for each jump. If this is not the case then a jump to
  /// a missing tag should complete the mission, and a jump where there are multiple matching tags should
  /// always select the one with the lowest mission sequence number.
  public static readonly DO_JUMP_TAG: int = 601

  /// Set gimbal manager pitch/yaw setpoints (low rate command). It is possible to set combinations of the
  /// values below. E.g. an angle as well as a desired angular rate can be used to get to this angle at a
  /// certain angular rate, or an angular rate only will result in continuous turning. NaN is to be used
  /// to signal unset. Note: only the gimbal manager will react to this command - it will be ignored by a
  /// gimbal device. Use GIMBAL_MANAGER_SET_PITCHYAW if you need to stream pitch/yaw setpoints at higher
  /// rate.
  public static readonly DO_GIMBAL_MANAGER_PITCHYAW: int = 1000

  /// Gimbal configuration to set which sysid/compid is in primary and secondary control.
  public static readonly DO_GIMBAL_MANAGER_CONFIGURE: int = 1001

  /// Start image capture sequence. CAMERA_IMAGE_CAPTURED must be emitted after each capture. Param1 (id)
  /// may be used to specify the target camera: 0: all cameras, 1 to 6: autopilot-connected cameras,
  /// 7-255: MAVLink camera component ID. It is needed in order to target specific cameras connected to
  /// the autopilot, or specific sensors in a multi-sensor camera (neither of which have a distinct
  /// MAVLink component ID). It is also needed to specify the target camera in missions. When used in a
  /// mission, an autopilot should execute the MAV_CMD for a specified local camera (param1 = 1-6), or
  /// resend it as a command if it is intended for a MAVLink camera (param1 = 7 - 255), setting the
  /// command's target_component as the param1 value (and setting param1 in the command to zero). If the
  /// param1 is 0 the autopilot should do both. When sent in a command the target MAVLink address is set
  /// using target_component. If addressed specifically to an autopilot: param1 should be used in the same
  /// way as it is for missions (though command should NACK with MAV_RESULT_DENIED if a specified local
  /// camera does not exist). If addressed to a MAVLink camera, param 1 can be used to address all cameras
  /// (0), or to separately address 1 to 7 individual sensors. Other values should be NACKed with
  /// MAV_RESULT_DENIED. If the command is broadcast (target_component is 0) then param 1 should be set to
  /// 0 (any other value should be NACKED with MAV_RESULT_DENIED). An autopilot would trigger any local
  /// cameras and forward the command to all channels.
  public static readonly IMAGE_START_CAPTURE: int = 2000

  /// Stop image capture sequence. Param1 (id) may be used to specify the target camera: 0: all cameras, 1
  /// to 6: autopilot-connected cameras, 7-255: MAVLink camera component ID. It is needed in order to
  /// target specific cameras connected to the autopilot, or specific sensors in a multi-sensor camera
  /// (neither of which have a distinct MAVLink component ID). It is also needed to specify the target
  /// camera in missions. When used in a mission, an autopilot should execute the MAV_CMD for a specified
  /// local camera (param1 = 1-6), or resend it as a command if it is intended for a MAVLink camera
  /// (param1 = 7 - 255), setting the command's target_component as the param1 value (and setting param1
  /// in the command to zero). If the param1 is 0 the autopilot should do both. When sent in a command the
  /// target MAVLink address is set using target_component. If addressed specifically to an autopilot:
  /// param1 should be used in the same way as it is for missions (though command should NACK with
  /// MAV_RESULT_DENIED if a specified local camera does not exist). If addressed to a MAVLink camera,
  /// param1 can be used to address all cameras (0), or to separately address 1 to 7 individual sensors.
  /// Other values should be NACKed with MAV_RESULT_DENIED. If the command is broadcast (target_component
  /// is 0) then param 1 should be set to 0 (any other value should be NACKED with MAV_RESULT_DENIED). An
  /// autopilot would trigger any local cameras and forward the command to all channels.
  public static readonly IMAGE_STOP_CAPTURE: int = 2001

  /// Re-request a CAMERA_IMAGE_CAPTURED message.
  public static readonly REQUEST_CAMERA_IMAGE_CAPTURE: int = 2002

  /// Enable or disable on-board camera triggering system.
  public static readonly DO_TRIGGER_CONTROL: int = 2003

  /// If the camera supports point visual tracking (CAMERA_CAP_FLAGS_HAS_TRACKING_POINT is set), this
  /// command allows to initiate the tracking.
  public static readonly CAMERA_TRACK_POINT: int = 2004

  /// If the camera supports rectangle visual tracking (CAMERA_CAP_FLAGS_HAS_TRACKING_RECTANGLE is set),
  /// this command allows to initiate the tracking.
  public static readonly CAMERA_TRACK_RECTANGLE: int = 2005

  /// Stops ongoing tracking.
  public static readonly CAMERA_STOP_TRACKING: int = 2010

  /// Starts video capture (recording).
  public static readonly VIDEO_START_CAPTURE: int = 2500

  /// Stop the current video capture (recording).
  public static readonly VIDEO_STOP_CAPTURE: int = 2501

  /// Start video streaming
  public static readonly VIDEO_START_STREAMING: int = 2502

  /// Stop the given video stream
  public static readonly VIDEO_STOP_STREAMING: int = 2503

  /// Request video stream information (VIDEO_STREAM_INFORMATION)
  public static readonly REQUEST_VIDEO_STREAM_INFORMATION: int = 2504

  /// Request video stream status (VIDEO_STREAM_STATUS)
  public static readonly REQUEST_VIDEO_STREAM_STATUS: int = 2505

  /// Request to start streaming logging data over MAVLink (see also LOGGING_DATA message)
  public static readonly LOGGING_START: int = 2510

  /// Request to stop streaming log data over MAVLink
  public static readonly LOGGING_STOP: int = 2511

  public static readonly AIRFRAME_CONFIGURATION: int = 2520

  /// Request to start/stop transmitting over the high latency telemetry
  public static readonly CONTROL_HIGH_LATENCY: int = 2600

  /// Create a panorama at the current position
  public static readonly PANORAMA_CREATE: int = 2800

  /// Request VTOL transition
  public static readonly DO_VTOL_TRANSITION: int = 3000

  /// Request authorization to arm the vehicle to a external entity, the arm authorizer is responsible to
  /// request all data that is needs from the vehicle before authorize or deny the request. If approved
  /// the COMMAND_ACK message progress field should be set with period of time that this authorization is
  /// valid in seconds. If the authorization is denied COMMAND_ACK.result_param2 should be set with one of
  /// the reasons in ARM_AUTH_DENIED_REASON.
  public static readonly ARM_AUTHORIZATION_REQUEST: int = 3001

  /// This command sets the submode to standard guided when vehicle is in guided mode. The vehicle holds
  /// position and altitude and the user can input the desired velocities along all three axes.
  public static readonly SET_GUIDED_SUBMODE_STANDARD: int = 4000

  /// This command sets submode circle when vehicle is in guided mode. Vehicle flies along a circle facing
  /// the center of the circle. The user can input the velocity along the circle and change the radius. If
  /// no input is given the vehicle will hold position.
  public static readonly SET_GUIDED_SUBMODE_CIRCLE: int = 4001

  /// Delay mission state machine until gate has been reached.
  public static readonly CONDITION_GATE: int = 4501

  /// Fence return point (there can only be one such point in a geofence definition). If rally points are
  /// supported they should be used instead.
  public static readonly NAV_FENCE_RETURN_POINT: int = 5000

  /// Fence vertex for an inclusion polygon (the polygon must not be self-intersecting). The vehicle must
  /// stay within this area. Minimum of 3 vertices required. The vertices for a polygon must be sent
  /// sequentially, each with param1 set to the total number of vertices in the polygon.
  public static readonly NAV_FENCE_POLYGON_VERTEX_INCLUSION: int = 5001

  /// Fence vertex for an exclusion polygon (the polygon must not be self-intersecting). The vehicle must
  /// stay outside this area. Minimum of 3 vertices required. The vertices for a polygon must be sent
  /// sequentially, each with param1 set to the total number of vertices in the polygon.
  public static readonly NAV_FENCE_POLYGON_VERTEX_EXCLUSION: int = 5002

  /// Circular fence area. The vehicle must stay inside this area.
  public static readonly NAV_FENCE_CIRCLE_INCLUSION: int = 5003

  /// Circular fence area. The vehicle must stay outside this area.
  public static readonly NAV_FENCE_CIRCLE_EXCLUSION: int = 5004

  /// Rally point. You can have multiple rally points defined.
  public static readonly NAV_RALLY_POINT: int = 5100

  /// Commands the vehicle to respond with a sequence of messages UAVCAN_NODE_INFO, one message per every
  /// UAVCAN node that is online. Note that some of the response messages can be lost, which the receiver
  /// can detect easily by checking whether every received UAVCAN_NODE_STATUS has a matching message
  /// UAVCAN_NODE_INFO received earlier; if not, this command should be sent again in order to request
  /// re-transmission of the node information messages.
  public static readonly UAVCAN_GET_NODE_INFO: int = 5200

  /// Change state of safety switch.
  public static readonly DO_SET_SAFETY_SWITCH_STATE: int = 5300

  /// Trigger the start of an ADSB-out IDENT. This should only be used when requested to do so by an Air
  /// Traffic Controller in controlled airspace. This starts the IDENT which is then typically held for 18
  /// seconds by the hardware per the Mode A, C, and S transponder spec.
  public static readonly DO_ADSB_OUT_IDENT: int = 10001

  /// Deploy payload on a Lat / Lon / Alt position. This includes the navigation to reach the required
  /// release position and velocity.
  public static readonly PAYLOAD_PREPARE_DEPLOY: int = 30001

  /// Control the payload deployment.
  public static readonly PAYLOAD_CONTROL_DEPLOY: int = 30002

  /// Magnetometer calibration based on provided known yaw. This allows for fast calibration using WMM
  /// field tables in the vehicle, given only the known yaw of the vehicle. If Latitude and longitude are
  /// both zero then use the current vehicle location.
  public static readonly FIXED_MAG_CAL_YAW: int = 42006

  /// Command to operate winch.
  public static readonly DO_WINCH: int = 42600

  /// Provide an external position estimate for use when dead-reckoning. This is meant to be used for
  /// occasional position resets that may be provided by a external system such as a remote pilot using
  /// landmarks over a video link.
  public static readonly EXTERNAL_POSITION_ESTIMATE: int = 43003

  /// User defined waypoint item. Ground Station will show the Vehicle as flying through this item.
  public static readonly WAYPOINT_USER_1: int = 31000

  /// User defined waypoint item. Ground Station will show the Vehicle as flying through this item.
  public static readonly WAYPOINT_USER_2: int = 31001

  /// User defined waypoint item. Ground Station will show the Vehicle as flying through this item.
  public static readonly WAYPOINT_USER_3: int = 31002

  /// User defined waypoint item. Ground Station will show the Vehicle as flying through this item.
  public static readonly WAYPOINT_USER_4: int = 31003

  /// User defined waypoint item. Ground Station will show the Vehicle as flying through this item.
  public static readonly WAYPOINT_USER_5: int = 31004

  /// User defined spatial item. Ground Station will not show the Vehicle as flying through this item.
  /// Example: ROI item.
  public static readonly SPATIAL_USER_1: int = 31005

  /// User defined spatial item. Ground Station will not show the Vehicle as flying through this item.
  /// Example: ROI item.
  public static readonly SPATIAL_USER_2: int = 31006

  /// User defined spatial item. Ground Station will not show the Vehicle as flying through this item.
  /// Example: ROI item.
  public static readonly SPATIAL_USER_3: int = 31007

  /// User defined spatial item. Ground Station will not show the Vehicle as flying through this item.
  /// Example: ROI item.
  public static readonly SPATIAL_USER_4: int = 31008

  /// User defined spatial item. Ground Station will not show the Vehicle as flying through this item.
  /// Example: ROI item.
  public static readonly SPATIAL_USER_5: int = 31009

  /// User defined command. Ground Station will not show the Vehicle as flying through this item. Example:
  /// MAV_CMD_DO_SET_PARAMETER item.
  public static readonly USER_1: int = 31010

  /// User defined command. Ground Station will not show the Vehicle as flying through this item. Example:
  /// MAV_CMD_DO_SET_PARAMETER item.
  public static readonly USER_2: int = 31011

  /// User defined command. Ground Station will not show the Vehicle as flying through this item. Example:
  /// MAV_CMD_DO_SET_PARAMETER item.
  public static readonly USER_3: int = 31012

  /// User defined command. Ground Station will not show the Vehicle as flying through this item. Example:
  /// MAV_CMD_DO_SET_PARAMETER item.
  public static readonly USER_4: int = 31013

  /// User defined command. Ground Station will not show the Vehicle as flying through this item. Example:
  /// MAV_CMD_DO_SET_PARAMETER item.
  public static readonly USER_5: int = 31014

  /// Request forwarding of CAN packets from the given CAN bus to this component. CAN Frames are sent
  /// using CAN_FRAME and CANFD_FRAME messages
  public static readonly CAN_FORWARD: int = 32000

