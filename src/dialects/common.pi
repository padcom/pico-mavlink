    new MavLinkPacketField("rec_top_x", "recTopX", 12, false, 4, "float", ""),
    new MavLinkPacketField("rec_top_y", "recTopY", 16, false, 4, "float", ""),
    new MavLinkPacketField("rec_bottom_x", "recBottomX", 20, false, 4, "float", ""),
    new MavLinkPacketField("rec_bottom_y", "recBottomY", 24, false, 4, "float", ""),
    new MavLinkPacketField("tracking_status", "trackingStatus", 28, false, 1, "uint8_t", ""),
    new MavLinkPacketField("tracking_mode", "trackingMode", 29, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_data", "targetData", 30, false, 1, "uint8_t", ""),
    new MavLinkPacketField("camera_device_id", "cameraDeviceId", 31, true, 1, "uint8_t", ""),
  ], (p) => CameraTrackingImageStatus.decode(p))

  /// Current tracking status
  /// Values: `CameraTrackingStatusFlags`.
  public trackingStatus: u8 = 0

  /// Current tracking mode
  /// Values: `CameraTrackingMode`.
  public trackingMode: u8 = 0

  /// Defines location of target data
  /// Values: `CameraTrackingTargetData`.
  public targetData: u8 = 0

  /// Current tracked point x value if CAMERA_TRACKING_MODE_POINT (normalized 0..1, 0 is left, 1 is
  /// right), NAN if unknown
  public pointX: f32 = 0.0

  /// Current tracked point y value if CAMERA_TRACKING_MODE_POINT (normalized 0..1, 0 is top, 1 is
  /// bottom), NAN if unknown
  public pointY: f32 = 0.0

  /// Current tracked radius if CAMERA_TRACKING_MODE_POINT (normalized 0..1, 0 is image left, 1 is image
  /// right), NAN if unknown
  public radius: f32 = 0.0

  /// Current tracked rectangle top x value if CAMERA_TRACKING_MODE_RECTANGLE (normalized 0..1, 0 is left,
  /// 1 is right), NAN if unknown
  public recTopX: f32 = 0.0

  /// Current tracked rectangle top y value if CAMERA_TRACKING_MODE_RECTANGLE (normalized 0..1, 0 is top,
  /// 1 is bottom), NAN if unknown
  public recTopY: f32 = 0.0

  /// Current tracked rectangle bottom x value if CAMERA_TRACKING_MODE_RECTANGLE (normalized 0..1, 0 is
  /// left, 1 is right), NAN if unknown
  public recBottomX: f32 = 0.0

  /// Current tracked rectangle bottom y value if CAMERA_TRACKING_MODE_RECTANGLE (normalized 0..1, 0 is
  /// top, 1 is bottom), NAN if unknown
  public recBottomY: f32 = 0.0

  /// Camera id of a non-MAVLink camera attached to an autopilot (1-6). 0 if the component is a MAVLink
  /// camera (with its own component id).
  public cameraDeviceId: u8 = 0

  /// A CAMERA_TRACKING_IMAGE_STATUS from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): CameraTrackingImageStatus {
    const m = new CameraTrackingImageStatus()
    m.pointX = readF32(payload, 0)
    m.pointY = readF32(payload, 4)
    m.radius = readF32(payload, 8)
    m.recTopX = readF32(payload, 12)
    m.recTopY = readF32(payload, 16)
    m.recBottomX = readF32(payload, 20)
    m.recBottomY = readF32(payload, 24)
    m.trackingStatus = readU8(payload, 28)
    m.trackingMode = readU8(payload, 29)
    m.targetData = readU8(payload, 30)
    m.cameraDeviceId = readU8(payload, 31)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeF32(into, at + 0, this.pointX)
    writeF32(into, at + 4, this.pointY)
    writeF32(into, at + 8, this.radius)
    writeF32(into, at + 12, this.recTopX)
    writeF32(into, at + 16, this.recTopY)
    writeF32(into, at + 20, this.recBottomX)
    writeF32(into, at + 24, this.recBottomY)
    writeUint(into, at + 28, 1, this.trackingStatus as int)
    writeUint(into, at + 29, 1, this.trackingMode as int)
    writeUint(into, at + 30, 1, this.targetData as int)
    writeUint(into, at + 31, 1, this.cameraDeviceId as int)
  }

  public override info(): MessageInfo {
    CameraTrackingImageStatus.INFO
  }
}

