  /// Roll angle (-pi..+pi)
  /// Units: rad.
  public roll: f32 = 0.0

  /// Pitch angle (-pi..+pi)
  /// Units: rad.
  public pitch: f32 = 0.0

  /// Yaw angle (-pi..+pi)
  /// Units: rad.
  public yaw: f32 = 0.0

  /// Roll angular speed
  /// Units: rad/s.
  public rollspeed: f32 = 0.0

  /// Pitch angular speed
  /// Units: rad/s.
  public pitchspeed: f32 = 0.0

  /// Yaw angular speed
  /// Units: rad/s.
  public yawspeed: f32 = 0.0

  /// A ATTITUDE from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): Attitude {
    const m = new Attitude()
    m.timeBootMs = readU32(payload, 0)
    m.roll = readF32(payload, 4)
    m.pitch = readF32(payload, 8)
    m.yaw = readF32(payload, 12)
    m.rollspeed = readF32(payload, 16)
    m.pitchspeed = readF32(payload, 20)
    m.yawspeed = readF32(payload, 24)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.timeBootMs as int)
    writeF32(into, at + 4, this.roll)
    writeF32(into, at + 8, this.pitch)
    writeF32(into, at + 12, this.yaw)
    writeF32(into, at + 16, this.rollspeed)
    writeF32(into, at + 20, this.pitchspeed)
    writeF32(into, at + 24, this.yawspeed)
  }

  public override info(): MessageInfo {
    Attitude.INFO
  }
}

/// The attitude in the aeronautical frame (right-handed, Z-down, X-front, Y-right), expressed as
/// quaternion. Quaternion order is w, x, y, z and a zero rotation would be expressed as (1 0 0 0).
export class AttitudeQuaternion extends MavLinkData {
  public static readonly MSG_ID: int = 31
  public static readonly MSG_NAME: string = "ATTITUDE_QUATERNION"
  public static readonly PAYLOAD_LENGTH: int = 48
  public static readonly MAGIC_NUMBER: int = 246
  public static readonly INFO: MessageInfo = new MessageInfo(31, "ATTITUDE_QUATERNION", 48, 32, 246, [
    new MavLinkPacketField("time_boot_ms", "timeBootMs", 0, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("q1", "q1", 4, false, 4, "float", ""),
    new MavLinkPacketField("q2", "q2", 8, false, 4, "float", ""),
    new MavLinkPacketField("q3", "q3", 12, false, 4, "float", ""),
    new MavLinkPacketField("q4", "q4", 16, false, 4, "float", ""),
    new MavLinkPacketField("rollspeed", "rollspeed", 20, false, 4, "float", "rad/s"),
    new MavLinkPacketField("pitchspeed", "pitchspeed", 24, false, 4, "float", "rad/s"),
    new MavLinkPacketField("yawspeed", "yawspeed", 28, false, 4, "float", "rad/s"),
    new MavLinkPacketField("repr_offset_q", "reprOffsetQ", 32, true, 4, "float[]", "", 4),
  ], (p) => AttitudeQuaternion.decode(p))

  /// Timestamp (time since system boot).
  /// Units: ms.
  public timeBootMs: u32 = 0

  /// Quaternion component 1, w (1 in null-rotation)
  public q1: f32 = 0.0

  /// Quaternion component 2, x (0 in null-rotation)
  public q2: f32 = 0.0

  /// Quaternion component 3, y (0 in null-rotation)
  public q3: f32 = 0.0

  /// Quaternion component 4, z (0 in null-rotation)
  public q4: f32 = 0.0

  /// Roll angular speed
  /// Units: rad/s.
  public rollspeed: f32 = 0.0

  /// Pitch angular speed
  /// Units: rad/s.
  public pitchspeed: f32 = 0.0

  /// Yaw angular speed
  /// Units: rad/s.
  public yawspeed: f32 = 0.0

  /// Rotation offset by which the attitude quaternion and angular speed vector should be rotated for user
  /// display (quaternion with [w, x, y, z] order, zero-rotation is [1, 0, 0, 0], send [0, 0, 0, 0] if
  /// field not supported). This field is intended for systems in which the reference attitude may change
  /// during flight. For example, tailsitters VTOLs rotate their reference attitude by 90 degrees between
  /// hover mode and fixed wing mode, thus repr_offset_q is equal to [1, 0, 0, 0] in hover mode and equal
  /// to [0.7071, 0, 0.7071, 0] in fixed wing mode.
  public reprOffsetQ: f32[] = []

  /// A ATTITUDE_QUATERNION from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): AttitudeQuaternion {
    const m = new AttitudeQuaternion()
    m.timeBootMs = readU32(payload, 0)
    m.q1 = readF32(payload, 4)
    m.q2 = readF32(payload, 8)
    m.q3 = readF32(payload, 12)
    m.q4 = readF32(payload, 16)
    m.rollspeed = readF32(payload, 20)
    m.pitchspeed = readF32(payload, 24)
    m.yawspeed = readF32(payload, 28)
    for (let i = 0; i < 4; i++) {
      m.reprOffsetQ.push(readF32(payload, 32 + i * 4))
    }
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.timeBootMs as int)
    writeF32(into, at + 4, this.q1)
    writeF32(into, at + 8, this.q2)
    writeF32(into, at + 12, this.q3)
    writeF32(into, at + 16, this.q4)
    writeF32(into, at + 20, this.rollspeed)
    writeF32(into, at + 24, this.pitchspeed)
    writeF32(into, at + 28, this.yawspeed)
    for (let i = 0; i < 4 && i < this.reprOffsetQ.length; i++) {
      writeF32(into, at + 32 + i * 4, this.reprOffsetQ[i])
    }
  }

  public override info(): MessageInfo {
    AttitudeQuaternion.INFO
  }
}

/// The filtered local position (e.g. fused computer vision and accelerometers). Coordinate frame is
/// right-handed, Z-axis down (aeronautical frame, NED / north-east-down convention)
export class LocalPositionNed extends MavLinkData {
  public static readonly MSG_ID: int = 32
  public static readonly MSG_NAME: string = "LOCAL_POSITION_NED"
  public static readonly PAYLOAD_LENGTH: int = 28
  public static readonly MAGIC_NUMBER: int = 185
  public static readonly INFO: MessageInfo = new MessageInfo(32, "LOCAL_POSITION_NED", 28, 28, 185, [
    new MavLinkPacketField("time_boot_ms", "timeBootMs", 0, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("x", "x", 4, false, 4, "float", "m"),
    new MavLinkPacketField("y", "y", 8, false, 4, "float", "m"),
    new MavLinkPacketField("z", "z", 12, false, 4, "float", "m"),
    new MavLinkPacketField("vx", "vx", 16, false, 4, "float", "m/s"),
    new MavLinkPacketField("vy", "vy", 20, false, 4, "float", "m/s"),
    new MavLinkPacketField("vz", "vz", 24, false, 4, "float", "m/s"),
  ], (p) => LocalPositionNed.decode(p))

  /// Timestamp (time since system boot).
  /// Units: ms.
