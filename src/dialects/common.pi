    writeUint(into, at + 12, 2, this.customMode as int)
    writeUint(into, at + 14, 2, this.altitude as int)
    writeUint(into, at + 16, 2, this.targetAltitude as int)
    writeUint(into, at + 18, 2, this.targetDistance as int)
    writeUint(into, at + 20, 2, this.wpNum as int)
    writeUint(into, at + 22, 2, this.failureFlags as int)
    writeUint(into, at + 24, 1, this.type as int)
    writeUint(into, at + 25, 1, this.autopilot as int)
    writeUint(into, at + 26, 1, this.heading as int)
    writeUint(into, at + 27, 1, this.targetHeading as int)
    writeUint(into, at + 28, 1, this.throttle as int)
    writeUint(into, at + 29, 1, this.airspeed as int)
    writeUint(into, at + 30, 1, this.airspeedSp as int)
    writeUint(into, at + 31, 1, this.groundspeed as int)
    writeUint(into, at + 32, 1, this.windspeed as int)
    writeUint(into, at + 33, 1, this.windHeading as int)
    writeUint(into, at + 34, 1, this.eph as int)
    writeUint(into, at + 35, 1, this.epv as int)
    writeUint(into, at + 36, 1, this.temperatureAir as int)
    writeUint(into, at + 37, 1, this.climbRate as int)
    writeUint(into, at + 38, 1, this.battery as int)
    writeUint(into, at + 39, 1, this.custom0 as int)
    writeUint(into, at + 40, 1, this.custom1 as int)
    writeUint(into, at + 41, 1, this.custom2 as int)
