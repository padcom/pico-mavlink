  /// X Acceleration
  /// Units: m/s/s.
  public ax: f32 = 0.0

  /// Y Acceleration
  /// Units: m/s/s.
  public ay: f32 = 0.0

  /// Z Acceleration
  /// Units: m/s/s.
  public az: f32 = 0.0

  /// Row-major representation of position, velocity and acceleration 9x9 cross-covariance matrix upper
  /// right triangle (states: x, y, z, vx, vy, vz, ax, ay, az; first nine entries are the first ROW, next
  /// eight entries are the second row, etc.). If unknown, assign NaN value to first element in the array.
  public covariance: f32[] = []

  /// A LOCAL_POSITION_NED_COV from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): LocalPositionNedCov {
    const m = new LocalPositionNedCov()
    m.timeUsec = readU64(payload, 0)
    m.x = readF32(payload, 8)
    m.y = readF32(payload, 12)
    m.z = readF32(payload, 16)
    m.vx = readF32(payload, 20)
    m.vy = readF32(payload, 24)
    m.vz = readF32(payload, 28)
    m.ax = readF32(payload, 32)
    m.ay = readF32(payload, 36)
    m.az = readF32(payload, 40)
    for (let i = 0; i < 45; i++) {
      m.covariance.push(readF32(payload, 44 + i * 4))
    }
    m.estimatorType = readU8(payload, 224)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    writeF32(into, at + 8, this.x)
    writeF32(into, at + 12, this.y)
    writeF32(into, at + 16, this.z)
    writeF32(into, at + 20, this.vx)
    writeF32(into, at + 24, this.vy)
    writeF32(into, at + 28, this.vz)
    writeF32(into, at + 32, this.ax)
    writeF32(into, at + 36, this.ay)
    writeF32(into, at + 40, this.az)
    for (let i = 0; i < 45 && i < this.covariance.length; i++) {
      writeF32(into, at + 44 + i * 4, this.covariance[i])
    }
    writeUint(into, at + 224, 1, this.estimatorType as int)
  }

  public override info(): MessageInfo {
    LocalPositionNedCov.INFO
  }
}

