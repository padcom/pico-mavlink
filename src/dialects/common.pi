}

/// The location and information of an ADSB vehicle
export class AdsbVehicle extends MavLinkData {
  public static readonly MSG_ID: int = 246
  public static readonly MSG_NAME: string = "ADSB_VEHICLE"
  public static readonly PAYLOAD_LENGTH: int = 38
