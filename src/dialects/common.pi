  /// Values: `WifiConfigApResponse`.
  public response: i8 = 0

  /// A WIFI_CONFIG_AP from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): WifiConfigAp {
    const m = new WifiConfigAp()
    m.ssid = readChars(payload, 0, 32)
    m.password = readChars(payload, 32, 64)
    m.mode = readI8(payload, 96)
    m.response = readI8(payload, 97)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeChars(into, at + 0, 32, this.ssid)
    writeChars(into, at + 32, 64, this.password)
    writeUint(into, at + 96, 1, this.mode as int)
    writeUint(into, at + 97, 1, this.response as int)
  }

  public override info(): MessageInfo {
    WifiConfigAp.INFO
  }
}

/// Version and capability of protocol version. This message can be requested with
/// MAV_CMD_REQUEST_MESSAGE and is used as part of the handshaking to establish which MAVLink version
/// should be used on the network. Every node should respond to a request for PROTOCOL_VERSION to enable
/// the handshaking. Library implementers should consider adding this into the default decoding state
/// machine to allow the protocol core to respond directly.
///
/// Deprecated since 2025-11, replaced by Nothing.
export class ProtocolVersion extends MavLinkData {
  public static readonly MSG_ID: int = 300
  public static readonly MSG_NAME: string = "PROTOCOL_VERSION"
  public static readonly PAYLOAD_LENGTH: int = 22
  public static readonly MAGIC_NUMBER: int = 217
  public static readonly INFO: MessageInfo = new MessageInfo(300, "PROTOCOL_VERSION", 22, 22, 217, [
    new MavLinkPacketField("version", "version", 0, false, 2, "uint16_t", ""),
    new MavLinkPacketField("min_version", "minVersion", 2, false, 2, "uint16_t", ""),
    new MavLinkPacketField("max_version", "maxVersion", 4, false, 2, "uint16_t", ""),
    new MavLinkPacketField("spec_version_hash", "specVersionHash", 6, false, 1, "uint8_t[]", "", 8),
    new MavLinkPacketField("library_version_hash", "libraryVersionHash", 14, false, 1, "uint8_t[]", "", 8),
  ], (p) => ProtocolVersion.decode(p))

  /// Currently active MAVLink version number * 100: v1.0 is 100, v2.0 is 200, etc.
  public version: u16 = 0

  /// Minimum MAVLink version supported
  public minVersion: u16 = 0

  /// Maximum MAVLink version supported (set to the same value as version by default)
  public maxVersion: u16 = 0

  /// The first 8 bytes (not characters printed in hex!) of the git hash.
  public specVersionHash: u8[] = []

  /// The first 8 bytes (not characters printed in hex!) of the git hash.
  public libraryVersionHash: u8[] = []

  /// A PROTOCOL_VERSION from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): ProtocolVersion {
    const m = new ProtocolVersion()
    m.version = readU16(payload, 0)
    m.minVersion = readU16(payload, 2)
    m.maxVersion = readU16(payload, 4)
    for (let i = 0; i < 8; i++) {
      m.specVersionHash.push(readU8(payload, 6 + i * 1))
    }
    for (let i = 0; i < 8; i++) {
      m.libraryVersionHash.push(readU8(payload, 14 + i * 1))
    }
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 2, this.version as int)
    writeUint(into, at + 2, 2, this.minVersion as int)
    writeUint(into, at + 4, 2, this.maxVersion as int)
    for (let i = 0; i < 8 && i < this.specVersionHash.length; i++) {
      writeUint(into, at + 6 + i * 1, 1, this.specVersionHash[i] as int)
    }
    for (let i = 0; i < 8 && i < this.libraryVersionHash.length; i++) {
      writeUint(into, at + 14 + i * 1, 1, this.libraryVersionHash[i] as int)
    }
  }

  public override info(): MessageInfo {
    ProtocolVersion.INFO
  }
}

