/// MAV FTP error codes (may be used in FILE_TRANSFER_PROTOCOL). See
/// https://mavlink.io/en/services/ftp.html.
export class MavFtpErr {
  /// None: No error
  public static readonly NONE: int = 0

  /// Fail: Unknown failure
  public static readonly FAIL: int = 1

  /// FailErrno: Command failed, Err number sent back in PayloadHeader.data[1]. This is a file-system
  /// error number understood by the server operating system.
  public static readonly FAILERRNO: int = 2

  /// InvalidDataSize: Payload size is invalid
  public static readonly INVALIDDATASIZE: int = 3

  /// InvalidSession: Session is not currently open
  public static readonly INVALIDSESSION: int = 4

  /// NoSessionsAvailable: All available sessions are already in use
  public static readonly NOSESSIONSAVAILABLE: int = 5

  /// EOF: Offset past end of file for ListDirectory and ReadFile commands
  public static readonly EOF: int = 6

  /// UnknownCommand: Unknown command / opcode
  public static readonly UNKNOWNCOMMAND: int = 7

  /// FileExists: File/directory already exists
  public static readonly FILEEXISTS: int = 8

  /// FileProtected: File/directory is write protected
  public static readonly FILEPROTECTED: int = 9

  /// FileNotFound: File/directory not found
  public static readonly FILENOTFOUND: int = 10

  /// The name of `value` (`NONE` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "NONE",
      1 => "FAIL",
      2 => "FAILERRNO",
      3 => "INVALIDDATASIZE",
      4 => "INVALIDSESSION",
      5 => "NOSESSIONSAVAILABLE",
      6 => "EOF",
      7 => "UNKNOWNCOMMAND",
      8 => "FILEEXISTS",
      9 => "FILEPROTECTED",
      10 => "FILENOTFOUND",
      _ => null,
    }
  }
}

/// MAV FTP opcodes (may be used in FILE_TRANSFER_PROTOCOL). See
/// https://mavlink.io/en/services/ftp.html.
export class MavFtpOpcode {
  /// None. Ignored, always ACKed
  public static readonly NONE: int = 0

  /// TerminateSession: Terminates open Read session
  public static readonly TERMINATESESSION: int = 1

  /// ResetSessions: Terminates all open read sessions
  public static readonly RESETSESSION: int = 2

  /// ListDirectory. List files and directories in path from offset
  public static readonly LISTDIRECTORY: int = 3

  /// OpenFileRO: Opens file at path for reading, returns session
  public static readonly OPENFILERO: int = 4

  /// ReadFile: Reads size bytes from offset in session
  public static readonly READFILE: int = 5

  /// CreateFile: Creates file at path for writing, returns session
  public static readonly CREATEFILE: int = 6

  /// WriteFile: Writes size bytes to offset in session
  public static readonly WRITEFILE: int = 7

  /// RemoveFile: Remove file at path
  public static readonly REMOVEFILE: int = 8

  /// CreateDirectory: Creates directory at path
  public static readonly CREATEDIRECTORY: int = 9

  /// RemoveDirectory: Removes directory at path. The directory must be empty.
  public static readonly REMOVEDIRECTORY: int = 10

  /// OpenFileWO: Opens file at path for writing, returns session
  public static readonly OPENFILEWO: int = 11

  /// TruncateFile: Truncate file at path to offset length
  public static readonly TRUNCATEFILE: int = 12

  /// Rename: Rename path1 to path2
  public static readonly RENAME: int = 13

  /// CalcFileCRC32: Calculate CRC32 for file at path
  public static readonly CALCFILECRC: int = 14

  /// BurstReadFile: Burst download session file
  public static readonly BURSTREADFILE: int = 15

  /// ACK: ACK response
  public static readonly ACK: int = 128

  /// NAK: NAK response
  public static readonly NAK: int = 129

  /// The name of `value` (`NONE` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "NONE",
      1 => "TERMINATESESSION",
      2 => "RESETSESSION",
      3 => "LISTDIRECTORY",
      4 => "OPENFILERO",
      5 => "READFILE",
      6 => "CREATEFILE",
      7 => "WRITEFILE",
      8 => "REMOVEFILE",
      9 => "CREATEDIRECTORY",
      10 => "REMOVEDIRECTORY",
      11 => "OPENFILEWO",
      12 => "TRUNCATEFILE",
      13 => "RENAME",
      14 => "CALCFILECRC",
      15 => "BURSTREADFILE",
      128 => "ACK",
      129 => "NAK",
      _ => null,
    }
  }
}

/// States of the mission state machine. Note that these states are independent of whether the mission
/// is in a mode that can execute mission items or not (is suspended). They may not all be relevant on
/// all vehicles.
export class MissionState {
  /// The mission status reporting is not supported.
  public static readonly UNKNOWN: int = 0

  /// No mission on the vehicle.
  public static readonly NO_MISSION: int = 1

  /// Mission has not started. This is the case after a mission has uploaded but not yet started
  /// executing.
  public static readonly NOT_STARTED: int = 2

  /// Mission is active, and will execute mission items when in auto mode.
  public static readonly ACTIVE: int = 3

  /// Mission is paused when in auto mode.
  public static readonly PAUSED: int = 4

  /// Mission has executed all mission items.
  public static readonly COMPLETE: int = 5

  /// The name of `value` (`UNKNOWN` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "UNKNOWN",
      1 => "NO_MISSION",
      2 => "NOT_STARTED",
      3 => "ACTIVE",
      4 => "PAUSED",
      5 => "COMPLETE",
      _ => null,
    }
  }
}

/// Possible safety switch states.
export class SafetySwitchState {
  /// Safety switch is engaged and vehicle should be safe to approach.
  public static readonly SAFE: int = 0

  /// Safety switch is NOT engaged and motors, propellers and other actuators should be considered active.
  public static readonly DANGEROUS: int = 1

  /// The name of `value` (`SAFE` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "SAFE",
      1 => "DANGEROUS",
      _ => null,
    }
  }
}

/// Modes of illuminator
export class IlluminatorMode {
  /// Illuminator mode is not specified/unknown
  public static readonly UNKNOWN: int = 0

  /// Illuminator behavior is controlled by MAV_CMD_DO_ILLUMINATOR_CONFIGURE settings
  public static readonly INTERNAL_CONTROL: int = 1

  /// Illuminator behavior is controlled by external factors: e.g. an external hardware signal
  public static readonly EXTERNAL_SYNC: int = 2

  /// The name of `value` (`UNKNOWN` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "UNKNOWN",
      1 => "INTERNAL_CONTROL",
      2 => "EXTERNAL_SYNC",
      _ => null,
    }
  }
}

/// Illuminator module error flags (bitmap, 0 means no error)
export class IlluminatorErrorFlags {
  /// Illuminator thermal throttling error.
  public static readonly THERMAL_THROTTLING: int = 1

  /// Illuminator over temperature shutdown error.
  public static readonly OVER_TEMPERATURE_SHUTDOWN: int = 2

  /// Illuminator thermistor failure.
  public static readonly THERMISTOR_FAILURE: int = 4

  /// The name of `value` (`THERMAL_THROTTLING` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      1 => "THERMAL_THROTTLING",
      2 => "OVER_TEMPERATURE_SHUTDOWN",
      4 => "THERMISTOR_FAILURE",
      _ => null,
    }
  }
}

/// Standard modes with a well understood meaning across flight stacks and vehicle types. For example,
/// most flight stack have the concept of a "return" or "RTL" mode that takes a vehicle to safety, even
/// though the precise mechanics of this mode may differ. The modes supported by a flight stack can be
/// queried using AVAILABLE_MODES and set using MAV_CMD_DO_SET_STANDARD_MODE. The current mode is
/// streamed in CURRENT_MODE. See https://mavlink.io/en/services/standard_modes.html
export class MavStandardMode {
  /// Non standard mode. This may be used when reporting the mode if the current flight mode is not a
  /// standard mode.
  public static readonly NON_STANDARD: int = 0

  /// Position mode (manual). Position-controlled and stabilized manual mode. When sticks are released
  /// vehicles return to their level-flight orientation and hold both position and altitude against wind
  /// and external forces. This mode can only be set by vehicles that can hold a fixed position.
  /// Multicopter (MC) vehicles actively brake and hold both position and altitude against wind and
  /// external forces. Hybrid MC/FW ("VTOL") vehicles first transition to multicopter mode (if needed) but
  /// otherwise behave in the same way as MC vehicles. Fixed-wing (FW) vehicles must not support this
  /// mode. Other vehicle types must not support this mode (this may be revisited through the PR process).
  public static readonly POSITION_HOLD: int = 1

  /// Orbit (manual). Position-controlled and stabilized manual mode. The vehicle circles around a fixed
  /// setpoint in the horizontal plane at a particular radius, altitude, and direction. Flight stacks may
  /// further allow manual control over the setpoint position, radius, direction, speed, and/or altitude
  /// of the circle, but this is not mandated. Flight stacks may support the
  /// [MAV_CMD_DO_ORBIT](https://mavlink.io/en/messages/common.html#MAV_CMD_DO_ORBIT) for changing the
  /// orbit parameters. MC and FW vehicles may support this mode. Hybrid MC/FW ("VTOL") vehicles may
  /// support this mode in MC/FW or both modes; if the mode is not supported by the current configuration
  /// the vehicle should transition to the supported configuration. Other vehicle types must not support
  /// this mode (this may be revisited through the PR process).
  public static readonly ORBIT: int = 2

  /// Cruise mode (manual). Position-controlled and stabilized manual mode. When sticks are released
  /// vehicles return to their level-flight orientation and hold their original track against wind and
  /// external forces. Fixed-wing (FW) vehicles level orientation and maintain current track and altitude
  /// against wind and external forces. Hybrid MC/FW ("VTOL") vehicles first transition to FW mode (if
  /// needed) but otherwise behave in the same way as MC vehicles. Multicopter (MC) vehicles must not
  /// support this mode. Other vehicle types must not support this mode (this may be revisited through the
  /// PR process).
  public static readonly CRUISE: int = 3

  /// Altitude hold (manual). Altitude-controlled and stabilized manual mode. When sticks are released
  /// vehicles return to their level-flight orientation and hold their altitude. MC vehicles continue with
  /// existing momentum and may move with wind (or other external forces). FW vehicles continue with
  /// current heading, but may be moved off-track by wind. Hybrid MC/FW ("VTOL") vehicles behave according
  /// to their current configuration/mode (FW or MC). Other vehicle types must not support this mode (this
  /// may be revisited through the PR process).
  public static readonly ALTITUDE_HOLD: int = 4

  /// Safe recovery mode (auto). Automatic mode that takes vehicle to a predefined safe location via a
  /// safe flight path, and may also automatically land the vehicle. This mode is more commonly referred
  /// to as RTL and/or or Smart RTL. The precise return location, flight path, and landing behaviour
  /// depend on vehicle configuration and type. For example, the vehicle might return to the home/launch
  /// location, a rally point, or the start of a mission landing, it might follow a direct path, mission
  /// path, or breadcrumb path, and land using a mission landing pattern or some other kind of descent.
  public static readonly SAFE_RECOVERY: int = 5

  /// Mission mode (automatic). Automatic mode that executes MAVLink missions. Missions are executed from
  /// the current waypoint as soon as the mode is enabled.
  public static readonly MISSION: int = 6

  /// Land mode (auto). Automatic mode that lands the vehicle at the current location. The precise landing
  /// behaviour depends on vehicle configuration and type.
  public static readonly LAND: int = 7

  /// Takeoff mode (auto). Automatic takeoff mode. The precise takeoff behaviour depends on vehicle
  /// configuration and type.
  public static readonly TAKEOFF: int = 8

  /// The name of `value` (`NON_STANDARD` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "NON_STANDARD",
      1 => "POSITION_HOLD",
      2 => "ORBIT",
      3 => "CRUISE",
      4 => "ALTITUDE_HOLD",
      5 => "SAFE_RECOVERY",
      6 => "MISSION",
      7 => "LAND",
      8 => "TAKEOFF",
      _ => null,
    }
  }
}

/// Mode properties.
export class MavModeProperty {
  /// If set, this mode is an advanced mode. For example a rate-controlled manual mode might be advanced,
  /// whereas a position-controlled manual mode is not. A GCS can optionally use this flag to configure
  /// the UI for its intended users.
  public static readonly ADVANCED: int = 1

  /// If set, this mode should not be added to the list of selectable modes. The mode might still be
  /// selected by the FC directly (for example as part of a failsafe).
  public static readonly NOT_USER_SELECTABLE: int = 2

  /// If set, this mode is automatically controlled (it may use but does not require a manual controller).
  /// If unset the mode is a assumed to require user input (be a manual mode).
  public static readonly AUTO_MODE: int = 4

  /// The name of `value` (`ADVANCED` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      1 => "ADVANCED",
      2 => "NOT_USER_SELECTABLE",
      4 => "AUTO_MODE",
      _ => null,
    }
  }
}

/// Flags used in HIL_ACTUATOR_CONTROLS message.
export class HilActuatorControlsFlags {
  /// Simulation is using lockstep
