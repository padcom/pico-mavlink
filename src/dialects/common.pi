  /// Bitmap to indicate which dimensions should be ignored by the vehicle.
  /// Values: `PositionTargetTypemask`.
  public typeMask: u16 = 0

  /// Latitude in WGS84 frame
  /// Units: degE7.
  public latInt: i32 = 0

  /// Longitude in WGS84 frame
  /// Units: degE7.
  public lonInt: i32 = 0

  /// Altitude (MSL, Relative to home, or AGL - depending on frame)
  /// Units: m.
  public alt: f32 = 0.0

  /// X velocity in NED frame
  /// Units: m/s.
  public vx: f32 = 0.0

  /// Y velocity in NED frame
  /// Units: m/s.
  public vy: f32 = 0.0

  /// Z velocity in NED frame
  /// Units: m/s.
  public vz: f32 = 0.0

  /// X acceleration or force (if bit 10 of type_mask is set) in NED frame in meter / s^2 or N
  /// Units: m/s/s.
  public afx: f32 = 0.0

  /// Y acceleration or force (if bit 10 of type_mask is set) in NED frame in meter / s^2 or N
  /// Units: m/s/s.
  public afy: f32 = 0.0

  /// Z acceleration or force (if bit 10 of type_mask is set) in NED frame in meter / s^2 or N
  /// Units: m/s/s.
  public afz: f32 = 0.0

  /// yaw setpoint
  /// Units: rad.
  public yaw: f32 = 0.0

  /// yaw rate setpoint
  /// Units: rad/s.
  public yawRate: f32 = 0.0

  /// A SET_POSITION_TARGET_GLOBAL_INT from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): SetPositionTargetGlobalInt {
    const m = new SetPositionTargetGlobalInt()
    m.timeBootMs = readU32(payload, 0)
    m.latInt = readI32(payload, 4)
    m.lonInt = readI32(payload, 8)
    m.alt = readF32(payload, 12)
    m.vx = readF32(payload, 16)
    m.vy = readF32(payload, 20)
    m.vz = readF32(payload, 24)
    m.afx = readF32(payload, 28)
    m.afy = readF32(payload, 32)
    m.afz = readF32(payload, 36)
    m.yaw = readF32(payload, 40)
    m.yawRate = readF32(payload, 44)
    m.typeMask = readU16(payload, 48)
    m.targetSystem = readU8(payload, 50)
    m.targetComponent = readU8(payload, 51)
    m.coordinateFrame = readU8(payload, 52)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.timeBootMs as int)
    writeUint(into, at + 4, 4, this.latInt as int)
    writeUint(into, at + 8, 4, this.lonInt as int)
    writeF32(into, at + 12, this.alt)
    writeF32(into, at + 16, this.vx)
    writeF32(into, at + 20, this.vy)
    writeF32(into, at + 24, this.vz)
    writeF32(into, at + 28, this.afx)
    writeF32(into, at + 32, this.afy)
    writeF32(into, at + 36, this.afz)
    writeF32(into, at + 40, this.yaw)
    writeF32(into, at + 44, this.yawRate)
    writeUint(into, at + 48, 2, this.typeMask as int)
    writeUint(into, at + 50, 1, this.targetSystem as int)
    writeUint(into, at + 51, 1, this.targetComponent as int)
    writeUint(into, at + 52, 1, this.coordinateFrame as int)
