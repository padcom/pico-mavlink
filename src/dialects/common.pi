  /// Based on GIMBAL_DEVICE_FLAGS_ACCEPTS_YAW_IN_EARTH_FRAME.
  public static readonly ACCEPTS_YAW_IN_EARTH_FRAME: int = 128

  /// Based on GIMBAL_DEVICE_FLAGS_RC_EXCLUSIVE.
  public static readonly RC_EXCLUSIVE: int = 256

