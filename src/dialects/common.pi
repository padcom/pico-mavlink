    new MavLinkPacketField("uptime_sec", "uptimeSec", 8, false, 4, "uint32_t", "s"),
    new MavLinkPacketField("vendor_specific_status_code", "vendorSpecificStatusCode", 12, false, 2, "uint16_t", ""),
    new MavLinkPacketField("health", "health", 14, false, 1, "uint8_t", ""),
    new MavLinkPacketField("mode", "mode", 15, false, 1, "uint8_t", ""),
    new MavLinkPacketField("sub_mode", "subMode", 16, false, 1, "uint8_t", ""),
  ], (p) => UavcanNodeStatus.decode(p))

  /// Timestamp (UNIX Epoch time or time since system boot). The receiving end can infer timestamp format
  /// (since 1.1.1970 or since system boot) by checking for the magnitude of the number.
  /// Units: us.
  public timeUsec: u64 = 0

  /// Time since the start-up of the node.
  /// Units: s.
  public uptimeSec: u32 = 0

  /// Generalized node health status.
  /// Values: `UavcanNodeHealth`.
  public health: u8 = 0

  /// Generalized operating mode.
  /// Values: `UavcanNodeMode`.
  public mode: u8 = 0

  /// Not used currently.
  public subMode: u8 = 0

  /// Vendor-specific status information.
  public vendorSpecificStatusCode: u16 = 0

  /// A UAVCAN_NODE_STATUS from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): UavcanNodeStatus {
    const m = new UavcanNodeStatus()
    m.timeUsec = readU64(payload, 0)
    m.uptimeSec = readU32(payload, 8)
    m.vendorSpecificStatusCode = readU16(payload, 12)
    m.health = readU8(payload, 14)
    m.mode = readU8(payload, 15)
    m.subMode = readU8(payload, 16)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    writeUint(into, at + 8, 4, this.uptimeSec as int)
    writeUint(into, at + 12, 2, this.vendorSpecificStatusCode as int)
    writeUint(into, at + 14, 1, this.health as int)
    writeUint(into, at + 15, 1, this.mode as int)
    writeUint(into, at + 16, 1, this.subMode as int)
  }

  public override info(): MessageInfo {
    UavcanNodeStatus.INFO
  }
}

/// General information describing a particular UAVCAN node. Please refer to the definition of the
/// UAVCAN service "uavcan.protocol.GetNodeInfo" for the background information. This message should be
/// emitted by the system whenever a new node appears online, or an existing node reboots. Additionally,
/// it can be emitted upon request from the other end of the MAVLink channel (see
/// MAV_CMD_UAVCAN_GET_NODE_INFO). It is also not prohibited to emit this message unconditionally at a
/// low frequency. The UAVCAN specification is available at http://uavcan.org.
export class UavcanNodeInfo extends MavLinkData {
  public static readonly MSG_ID: int = 311
  public static readonly MSG_NAME: string = "UAVCAN_NODE_INFO"
  public static readonly PAYLOAD_LENGTH: int = 116
  public static readonly MAGIC_NUMBER: int = 95
  public static readonly INFO: MessageInfo = new MessageInfo(311, "UAVCAN_NODE_INFO", 116, 116, 95, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("uptime_sec", "uptimeSec", 8, false, 4, "uint32_t", "s"),
    new MavLinkPacketField("sw_vcs_commit", "swVcsCommit", 12, false, 4, "uint32_t", ""),
    new MavLinkPacketField("name", "name", 16, false, 1, "char[]", "", 80),
    new MavLinkPacketField("hw_version_major", "hwVersionMajor", 96, false, 1, "uint8_t", ""),
    new MavLinkPacketField("hw_version_minor", "hwVersionMinor", 97, false, 1, "uint8_t", ""),
    new MavLinkPacketField("hw_unique_id", "hwUniqueId", 98, false, 1, "uint8_t[]", "", 16),
    new MavLinkPacketField("sw_version_major", "swVersionMajor", 114, false, 1, "uint8_t", ""),
    new MavLinkPacketField("sw_version_minor", "swVersionMinor", 115, false, 1, "uint8_t", ""),
  ], (p) => UavcanNodeInfo.decode(p))

  /// Timestamp (UNIX Epoch time or time since system boot). The receiving end can infer timestamp format
  /// (since 1.1.1970 or since system boot) by checking for the magnitude of the number.
  /// Units: us.
  public timeUsec: u64 = 0

  /// Time since the start-up of the node.
  /// Units: s.
  public uptimeSec: u32 = 0

  /// Node name string. For example, "sapog.px4.io".
  public name: string = ""

  /// Hardware major version number.
  public hwVersionMajor: u8 = 0

  /// Hardware minor version number.
  public hwVersionMinor: u8 = 0

  /// Hardware unique 128-bit ID.
  public hwUniqueId: u8[] = []

  /// Software major version number.
  public swVersionMajor: u8 = 0

  /// Software minor version number.
  public swVersionMinor: u8 = 0

  /// Version control system (VCS) revision identifier (e.g. git short commit hash). 0 if unknown.
  public swVcsCommit: u32 = 0

  /// A UAVCAN_NODE_INFO from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): UavcanNodeInfo {
    const m = new UavcanNodeInfo()
    m.timeUsec = readU64(payload, 0)
    m.uptimeSec = readU32(payload, 8)
    m.swVcsCommit = readU32(payload, 12)
    m.name = readChars(payload, 16, 80)
    m.hwVersionMajor = readU8(payload, 96)
    m.hwVersionMinor = readU8(payload, 97)
    for (let i = 0; i < 16; i++) {
      m.hwUniqueId.push(readU8(payload, 98 + i * 1))
    }
    m.swVersionMajor = readU8(payload, 114)
    m.swVersionMinor = readU8(payload, 115)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    writeUint(into, at + 8, 4, this.uptimeSec as int)
    writeUint(into, at + 12, 4, this.swVcsCommit as int)
    writeChars(into, at + 16, 80, this.name)
    writeUint(into, at + 96, 1, this.hwVersionMajor as int)
    writeUint(into, at + 97, 1, this.hwVersionMinor as int)
    for (let i = 0; i < 16 && i < this.hwUniqueId.length; i++) {
      writeUint(into, at + 98 + i * 1, 1, this.hwUniqueId[i] as int)
    }
    writeUint(into, at + 114, 1, this.swVersionMajor as int)
    writeUint(into, at + 115, 1, this.swVersionMinor as int)
  }

  public override info(): MessageInfo {
    UavcanNodeInfo.INFO
  }
}

