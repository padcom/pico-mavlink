/// Zoom types for MAV_CMD_SET_CAMERA_ZOOM
export class CameraZoomType {
  /// Zoom one step increment (-1 for wide, 1 for tele)
  public static readonly STEP: int = 0

  /// Continuous normalized zoom in/out rate until stopped. Range -1..1, negative: wide, positive:
  /// narrow/tele, 0 to stop zooming. Other values should be clipped to the range.
  public static readonly CONTINUOUS: int = 1

  /// Zoom value as proportion of full camera range (a percentage value between 0.0 and 100.0)
  public static readonly RANGE: int = 2

  /// Zoom value/variable focal length in millimetres. Note that there is no message to get the valid zoom
  /// range of the camera, so this can type can only be used for cameras where the zoom range is known
  /// (implying that this cannot reliably be used in a GCS for an arbitrary camera)
  public static readonly FOCAL_LENGTH: int = 3

  /// Zoom value as horizontal field of view in degrees.
  public static readonly HORIZONTAL_FOV: int = 4

  /// The name of `value` (`STEP` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "STEP",
      1 => "CONTINUOUS",
      2 => "RANGE",
      3 => "FOCAL_LENGTH",
      4 => "HORIZONTAL_FOV",
      _ => null,
    }
  }
}

/// Focus types for MAV_CMD_SET_CAMERA_FOCUS
export class SetFocusType {
  /// Focus one step increment (-1 for focusing in, 1 for focusing out towards infinity).
  public static readonly STEP: int = 0

  /// Continuous normalized focus in/out rate until stopped. Range -1..1, negative: in, positive: out
  /// towards infinity, 0 to stop focusing. Other values should be clipped to the range.
  public static readonly CONTINUOUS: int = 1

  /// Focus value as proportion of full camera focus range (a value between 0.0 and 100.0)
  public static readonly RANGE: int = 2

  /// Focus value in metres. Note that there is no message to get the valid focus range of the camera, so
  /// this can type can only be used for cameras where the range is known (implying that this cannot
  /// reliably be used in a GCS for an arbitrary camera).
  public static readonly METERS: int = 3

  /// Focus automatically.
  public static readonly AUTO: int = 4

  /// Single auto focus. Mainly used for still pictures. Usually abbreviated as AF-S.
  public static readonly AUTO_SINGLE: int = 5

  /// Continuous auto focus. Mainly used for dynamic scenes. Abbreviated as AF-C.
  public static readonly AUTO_CONTINUOUS: int = 6

  /// The name of `value` (`STEP` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "STEP",
      1 => "CONTINUOUS",
      2 => "RANGE",
      3 => "METERS",
      4 => "AUTO",
      5 => "AUTO_SINGLE",
      6 => "AUTO_CONTINUOUS",
      _ => null,
    }
  }
}

