/// These flags encode the cellular network status
export class CellularStatusFlag {
  /// State unknown or not reportable.
  public static readonly UNKNOWN: int = 0

  /// Modem is unusable
  public static readonly FAILED: int = 1

  /// Modem is being initialized
  public static readonly INITIALIZING: int = 2

  /// Modem is locked
  public static readonly LOCKED: int = 3

  /// Modem is not enabled and is powered down
  public static readonly DISABLED: int = 4

  /// Modem is currently transitioning to the CELLULAR_STATUS_FLAG_DISABLED state
  public static readonly DISABLING: int = 5

  /// Modem is currently transitioning to the CELLULAR_STATUS_FLAG_ENABLED state
  public static readonly ENABLING: int = 6

  /// Modem is enabled and powered on but not registered with a network provider and not available for
  /// data connections
  public static readonly ENABLED: int = 7

  /// Modem is searching for a network provider to register
  public static readonly SEARCHING: int = 8

  /// Modem is registered with a network provider, and data connections and messaging may be available for
  /// use
  public static readonly REGISTERED: int = 9

  /// Modem is disconnecting and deactivating the last active packet data bearer. This state will not be
  /// entered if more than one packet data bearer is active and one of the active bearers is deactivated
  public static readonly DISCONNECTING: int = 10

  /// Modem is activating and connecting the first packet data bearer. Subsequent bearer activations when
  /// another bearer is already active do not cause this state to be entered
  public static readonly CONNECTING: int = 11

  /// One or more packet data bearers is active and connected
  public static readonly CONNECTED: int = 12

  /// The name of `value` (`UNKNOWN` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "UNKNOWN",
      1 => "FAILED",
      2 => "INITIALIZING",
      3 => "LOCKED",
      4 => "DISABLED",
      5 => "DISABLING",
      6 => "ENABLING",
      7 => "ENABLED",
      8 => "SEARCHING",
      9 => "REGISTERED",
      10 => "DISCONNECTING",
      11 => "CONNECTING",
      12 => "CONNECTED",
      _ => null,
    }
  }
}

