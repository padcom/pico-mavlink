}

/// Source for GLOBAL_POSITION measurement or estimate.
export class GlobalPositionSrc {
  /// Source is unknown or not one of the listed types.
  public static readonly UNKNOWN: int = 0

  /// Global Navigation Satellite System (e.g.: GPS, Galileo, Glonass, BeiDou).
  public static readonly GNSS: int = 1

  /// Vision system (e.g.: map matching).
  public static readonly VISION: int = 2

  /// A pseudo-satellite system using transceiver beacons to perform GNSS-like positioning.
  public static readonly PSEUDOLITES: int = 3

  /// Terrain referenced navigation.
  public static readonly TERRAIN: int = 4

  /// Magnetic positioning.
  public static readonly MAGNETIC: int = 5

  /// Estimated position based on various sensors (eg. a Kalman Filter).
  public static readonly ESTIMATOR: int = 6

  /// The name of `value` (`UNKNOWN` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "UNKNOWN",
      1 => "GNSS",
      2 => "VISION",
      3 => "PSEUDOLITES",
      4 => "TERRAIN",
      5 => "MAGNETIC",
      6 => "ESTIMATOR",
      _ => null,
    }
  }
}

/// Status flags for GLOBAL_POSITION
export class GlobalPositionFlags {
  /// Unhealthy sensor/estimator.
  public static readonly UNHEALTHY: int = 1

  /// True if the data originates from or is consumed by the primary estimator.
  public static readonly PRIMARY: int = 2

  /// The name of `value` (`UNHEALTHY` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      1 => "UNHEALTHY",
      2 => "PRIMARY",
      _ => null,
    }
  }
}

/// Sensor and subsystem status information. Provides a compact representation of sensor/subsystem
/// status and a few other basic statistics.
export class SysStatus extends MavLinkData {
  public static readonly MSG_ID: int = 1
  public static readonly MSG_NAME: string = "SYS_STATUS"
  public static readonly PAYLOAD_LENGTH: int = 43
  public static readonly MAGIC_NUMBER: int = 124
  public static readonly INFO: MessageInfo = new MessageInfo(1, "SYS_STATUS", 43, 31, 124, [
    new MavLinkPacketField("onboard_control_sensors_present", "onboardControlSensorsPresent", 0, false, 4, "uint32_t", ""),
    new MavLinkPacketField("onboard_control_sensors_enabled", "onboardControlSensorsEnabled", 4, false, 4, "uint32_t", ""),
    new MavLinkPacketField("onboard_control_sensors_health", "onboardControlSensorsHealth", 8, false, 4, "uint32_t", ""),
    new MavLinkPacketField("load", "load", 12, false, 2, "uint16_t", "d%"),
    new MavLinkPacketField("voltage_battery", "voltageBattery", 14, false, 2, "uint16_t", "mV"),
    new MavLinkPacketField("current_battery", "currentBattery", 16, false, 2, "int16_t", "cA"),
    new MavLinkPacketField("drop_rate_comm", "dropRateComm", 18, false, 2, "uint16_t", "c%"),
    new MavLinkPacketField("errors_comm", "errorsComm", 20, false, 2, "uint16_t", ""),
    new MavLinkPacketField("errors_count1", "errorsCount1", 22, false, 2, "uint16_t", ""),
    new MavLinkPacketField("errors_count2", "errorsCount2", 24, false, 2, "uint16_t", ""),
    new MavLinkPacketField("errors_count3", "errorsCount3", 26, false, 2, "uint16_t", ""),
    new MavLinkPacketField("errors_count4", "errorsCount4", 28, false, 2, "uint16_t", ""),
    new MavLinkPacketField("battery_remaining", "batteryRemaining", 30, false, 1, "int8_t", "%"),
    new MavLinkPacketField("onboard_control_sensors_present_extended", "onboardControlSensorsPresentExtended", 31, true, 4, "uint32_t", ""),
    new MavLinkPacketField("onboard_control_sensors_enabled_extended", "onboardControlSensorsEnabledExtended", 35, true, 4, "uint32_t", ""),
    new MavLinkPacketField("onboard_control_sensors_health_extended", "onboardControlSensorsHealthExtended", 39, true, 4, "uint32_t", ""),
  ], (p) => SysStatus.decode(p))

  /// Bitmap showing which onboard controllers and sensors are present. Value of 0: not present. Value of
  /// 1: present.
  /// Values: `MavSysStatusSensor`.
  public onboardControlSensorsPresent: u32 = 0

  /// Bitmap showing which onboard controllers and sensors are enabled: Value of 0: not enabled. Value of
  /// 1: enabled.
  /// Values: `MavSysStatusSensor`.
  public onboardControlSensorsEnabled: u32 = 0

  /// Bitmap showing which onboard controllers and sensors have an error (or are operational). Value of 0:
  /// error. Value of 1: healthy.
  /// Values: `MavSysStatusSensor`.
  public onboardControlSensorsHealth: u32 = 0

  /// Maximum usage in percent of the mainloop time. Values: [0-1000] - should always be below 1000
  /// Units: d%.
  public load: u16 = 0

  /// Battery voltage, UINT16_MAX: Voltage not sent by autopilot
  /// Units: mV.
  public voltageBattery: u16 = 0

  /// Battery current, -1: Current not sent by autopilot
  /// Units: cA.
  public currentBattery: i16 = 0

  /// Battery energy remaining, -1: Battery remaining energy not sent by autopilot
  /// Units: %.
  public batteryRemaining: i8 = 0

  /// Communication drop rate, (UART, I2C, SPI, CAN), dropped packets on all links (packets that were
  /// corrupted on reception on the MAV)
  /// Units: c%.
  public dropRateComm: u16 = 0

  /// Communication errors (UART, I2C, SPI, CAN), dropped packets on all links (packets that were
  /// corrupted on reception on the MAV)
  public errorsComm: u16 = 0

  /// Autopilot-specific errors
  public errorsCount1: u16 = 0

  /// Autopilot-specific errors
  public errorsCount2: u16 = 0

  /// Autopilot-specific errors
  public errorsCount3: u16 = 0

  /// Autopilot-specific errors
  public errorsCount4: u16 = 0

  /// Bitmap showing which onboard controllers and sensors are present. Value of 0: not present. Value of
  /// 1: present.
  /// Values: `MavSysStatusSensorExtended`.
  public onboardControlSensorsPresentExtended: u32 = 0

  /// Bitmap showing which onboard controllers and sensors are enabled: Value of 0: not enabled. Value of
  /// 1: enabled.
  /// Values: `MavSysStatusSensorExtended`.
  public onboardControlSensorsEnabledExtended: u32 = 0

  /// Bitmap showing which onboard controllers and sensors have an error (or are operational). Value of 0:
  /// error. Value of 1: healthy.
  /// Values: `MavSysStatusSensorExtended`.
  public onboardControlSensorsHealthExtended: u32 = 0

  /// A SYS_STATUS from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): SysStatus {
    const m = new SysStatus()
    m.onboardControlSensorsPresent = readU32(payload, 0)
    m.onboardControlSensorsEnabled = readU32(payload, 4)
    m.onboardControlSensorsHealth = readU32(payload, 8)
    m.load = readU16(payload, 12)
    m.voltageBattery = readU16(payload, 14)
    m.currentBattery = readI16(payload, 16)
    m.dropRateComm = readU16(payload, 18)
    m.errorsComm = readU16(payload, 20)
    m.errorsCount1 = readU16(payload, 22)
    m.errorsCount2 = readU16(payload, 24)
    m.errorsCount3 = readU16(payload, 26)
    m.errorsCount4 = readU16(payload, 28)
    m.batteryRemaining = readI8(payload, 30)
    m.onboardControlSensorsPresentExtended = readU32(payload, 31)
    m.onboardControlSensorsEnabledExtended = readU32(payload, 35)
    m.onboardControlSensorsHealthExtended = readU32(payload, 39)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.onboardControlSensorsPresent as int)
    writeUint(into, at + 4, 4, this.onboardControlSensorsEnabled as int)
    writeUint(into, at + 8, 4, this.onboardControlSensorsHealth as int)
    writeUint(into, at + 12, 2, this.load as int)
    writeUint(into, at + 14, 2, this.voltageBattery as int)
    writeUint(into, at + 16, 2, this.currentBattery as int)
    writeUint(into, at + 18, 2, this.dropRateComm as int)
    writeUint(into, at + 20, 2, this.errorsComm as int)
    writeUint(into, at + 22, 2, this.errorsCount1 as int)
    writeUint(into, at + 24, 2, this.errorsCount2 as int)
    writeUint(into, at + 26, 2, this.errorsCount3 as int)
    writeUint(into, at + 28, 2, this.errorsCount4 as int)
    writeUint(into, at + 30, 1, this.batteryRemaining as int)
    writeUint(into, at + 31, 4, this.onboardControlSensorsPresentExtended as int)
    writeUint(into, at + 35, 4, this.onboardControlSensorsEnabledExtended as int)
    writeUint(into, at + 39, 4, this.onboardControlSensorsHealthExtended as int)
  }

  public override info(): MessageInfo {
    SysStatus.INFO
  }
}

/// The system time is the time of the sender's master clock. This can be emitted by flight controllers,
/// onboard computers, or other components in the MAVLink network. Components that are using a less
/// reliable time source, such as a battery-backed real time clock, can choose to match their system
/// clock to that of a system that indicates a more recent time. This allows more broadly accurate date
/// stamping of logs, and so on. If precise time synchronization is needed then use TIMESYNC instead.
export class SystemTime extends MavLinkData {
  public static readonly MSG_ID: int = 2
  public static readonly MSG_NAME: string = "SYSTEM_TIME"
  public static readonly PAYLOAD_LENGTH: int = 12
  public static readonly MAGIC_NUMBER: int = 137
  public static readonly INFO: MessageInfo = new MessageInfo(2, "SYSTEM_TIME", 12, 12, 137, [
    new MavLinkPacketField("time_unix_usec", "timeUnixUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("time_boot_ms", "timeBootMs", 8, false, 4, "uint32_t", "ms"),
  ], (p) => SystemTime.decode(p))

  /// Timestamp (UNIX epoch time).
  /// Units: us.
  public timeUnixUsec: u64 = 0

  /// Timestamp (time since system boot).
  /// Units: ms.
  public timeBootMs: u32 = 0

  /// A SYSTEM_TIME from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): SystemTime {
    const m = new SystemTime()
    m.timeUnixUsec = readU64(payload, 0)
    m.timeBootMs = readU32(payload, 8)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUnixUsec)
    writeUint(into, at + 8, 4, this.timeBootMs as int)
  }

  public override info(): MessageInfo {
    SystemTime.INFO
  }
}

/// A ping message either requesting or responding to a ping. This allows to measure the system
/// latencies, including serial port, radio modem and UDP connections. The ping microservice is
/// documented at https://mavlink.io/en/services/ping.html
export class Ping extends MavLinkData {
  public static readonly MSG_ID: int = 4
  public static readonly MSG_NAME: string = "PING"
  public static readonly PAYLOAD_LENGTH: int = 14
  public static readonly MAGIC_NUMBER: int = 237
  public static readonly INFO: MessageInfo = new MessageInfo(4, "PING", 14, 14, 237, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("seq", "seq", 8, false, 4, "uint32_t", ""),
    new MavLinkPacketField("target_system", "targetSystem", 12, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 13, false, 1, "uint8_t", ""),
  ], (p) => Ping.decode(p))

  /// Timestamp (UNIX Epoch time or time since system boot). The receiving end can infer timestamp format
  /// (since 1.1.1970 or since system boot) by checking for the magnitude of the number.
  /// Units: us.
  public timeUsec: u64 = 0

  /// PING sequence
  public seq: u32 = 0

  /// 0: request ping from all receiving systems. If greater than 0: message is a ping response and number
  /// is the system id of the requesting system
  public targetSystem: u8 = 0

  /// 0: request ping from all receiving components. If greater than 0: message is a ping response and
  /// number is the component id of the requesting component.
  public targetComponent: u8 = 0

  /// A PING from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): Ping {
    const m = new Ping()
    m.timeUsec = readU64(payload, 0)
    m.seq = readU32(payload, 8)
    m.targetSystem = readU8(payload, 12)
    m.targetComponent = readU8(payload, 13)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    writeUint(into, at + 8, 4, this.seq as int)
    writeUint(into, at + 12, 1, this.targetSystem as int)
    writeUint(into, at + 13, 1, this.targetComponent as int)
  }

  public override info(): MessageInfo {
    Ping.INFO
  }
}

/// Request to control this MAV
export class ChangeOperatorControl extends MavLinkData {
  public static readonly MSG_ID: int = 5
  public static readonly MSG_NAME: string = "CHANGE_OPERATOR_CONTROL"
  public static readonly PAYLOAD_LENGTH: int = 28
  public static readonly MAGIC_NUMBER: int = 217
  public static readonly INFO: MessageInfo = new MessageInfo(5, "CHANGE_OPERATOR_CONTROL", 28, 28, 217, [
    new MavLinkPacketField("target_system", "targetSystem", 0, false, 1, "uint8_t", ""),
