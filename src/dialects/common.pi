    new MavLinkPacketField("q4", "q4", 12, false, 4, "float", ""),
    new MavLinkPacketField("roll", "roll", 16, false, 4, "float", "rad"),
    new MavLinkPacketField("pitch", "pitch", 20, false, 4, "float", "rad"),
