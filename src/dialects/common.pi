  /// Z Speed
  /// Units: m/s.
  public vz: f32 = 0.0

  /// A LOCAL_POSITION_NED from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): LocalPositionNed {
    const m = new LocalPositionNed()
    m.timeBootMs = readU32(payload, 0)
    m.x = readF32(payload, 4)
    m.y = readF32(payload, 8)
    m.z = readF32(payload, 12)
    m.vx = readF32(payload, 16)
    m.vy = readF32(payload, 20)
    m.vz = readF32(payload, 24)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.timeBootMs as int)
    writeF32(into, at + 4, this.x)
    writeF32(into, at + 8, this.y)
    writeF32(into, at + 12, this.z)
    writeF32(into, at + 16, this.vx)
    writeF32(into, at + 20, this.vy)
    writeF32(into, at + 24, this.vz)
  }

  public override info(): MessageInfo {
    LocalPositionNed.INFO
  }
}

/// The scaled values of the RC channels received: (-100%) -10000, (0%) 0, (100%) 10000. Channels that
/// are inactive should be set to INT16_MAX.
export class RcChannelsScaled extends MavLinkData {
