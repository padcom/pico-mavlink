  /// Field for custom payload.
  public custom1: i8 = 0

  /// Field for custom payload.
  public custom2: i8 = 0

  /// A HIGH_LATENCY2 from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): HighLatency2 {
    const m = new HighLatency2()
