    m.targetComponent = readU8(payload, 17)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.operatorLatitude as int)
    writeUint(into, at + 4, 4, this.operatorLongitude as int)
    writeF32(into, at + 8, this.operatorAltitudeGeo)
    writeUint(into, at + 12, 4, this.timestamp as int)
    writeUint(into, at + 16, 1, this.targetSystem as int)
    writeUint(into, at + 17, 1, this.targetComponent as int)
  }

  public override info(): MessageInfo {
    OpenDroneIdSystemUpdate.INFO
  }
}

/// Temperature and humidity from hygrometer.
export class HygrometerSensor extends MavLinkData {
  public static readonly MSG_ID: int = 12920
  public static readonly MSG_NAME: string = "HYGROMETER_SENSOR"
  public static readonly PAYLOAD_LENGTH: int = 5
  public static readonly MAGIC_NUMBER: int = 20
  public static readonly INFO: MessageInfo = new MessageInfo(12920, "HYGROMETER_SENSOR", 5, 5, 20, [
    new MavLinkPacketField("temperature", "temperature", 0, false, 2, "int16_t", "cdegC"),
    new MavLinkPacketField("humidity", "humidity", 2, false, 2, "uint16_t", "c%"),
    new MavLinkPacketField("id", "id", 4, false, 1, "uint8_t", ""),
  ], (p) => HygrometerSensor.decode(p))

  /// Hygrometer ID
  public id: u8 = 0

  /// Temperature
  /// Units: cdegC.
  public temperature: i16 = 0

  /// Humidity
  /// Units: c%.
  public humidity: u16 = 0

  /// A HYGROMETER_SENSOR from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): HygrometerSensor {
    const m = new HygrometerSensor()
    m.temperature = readI16(payload, 0)
    m.humidity = readU16(payload, 2)
    m.id = readU8(payload, 4)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 2, this.temperature as int)
    writeUint(into, at + 2, 2, this.humidity as int)
    writeUint(into, at + 4, 1, this.id as int)
  }

  public override info(): MessageInfo {
    HygrometerSensor.INFO
  }
}

