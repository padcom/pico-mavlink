    new MavLinkPacketField("zacc", "zacc", 36, false, 4, "float", "m/s/s"),
    new MavLinkPacketField("xgyro", "xgyro", 40, false, 4, "float", "rad/s"),
    new MavLinkPacketField("ygyro", "ygyro", 44, false, 4, "float", "rad/s"),
    new MavLinkPacketField("zgyro", "zgyro", 48, false, 4, "float", "rad/s"),
    new MavLinkPacketField("lat", "lat", 52, false, 4, "float", "deg"),
    new MavLinkPacketField("lon", "lon", 56, false, 4, "float", "deg"),
    new MavLinkPacketField("alt", "alt", 60, false, 4, "float", "m"),
    new MavLinkPacketField("std_dev_horz", "stdDevHorz", 64, false, 4, "float", ""),
    new MavLinkPacketField("std_dev_vert", "stdDevVert", 68, false, 4, "float", ""),
    new MavLinkPacketField("vn", "vn", 72, false, 4, "float", "m/s"),
    new MavLinkPacketField("ve", "ve", 76, false, 4, "float", "m/s"),
    new MavLinkPacketField("vd", "vd", 80, false, 4, "float", "m/s"),
    new MavLinkPacketField("lat_int", "latInt", 84, true, 4, "int32_t", "degE7"),
    new MavLinkPacketField("lon_int", "lonInt", 88, true, 4, "int32_t", "degE7"),
  ], (p) => SimState.decode(p))

  /// True attitude quaternion component 1, w (1 in null-rotation)
  public q1: f32 = 0.0

  /// True attitude quaternion component 2, x (0 in null-rotation)
  public q2: f32 = 0.0

  /// True attitude quaternion component 3, y (0 in null-rotation)
  public q3: f32 = 0.0

  /// True attitude quaternion component 4, z (0 in null-rotation)
  public q4: f32 = 0.0

  /// Attitude roll expressed as Euler angles, not recommended except for human-readable outputs
  /// Units: rad.
  public roll: f32 = 0.0

  /// Attitude pitch expressed as Euler angles, not recommended except for human-readable outputs
  /// Units: rad.
  public pitch: f32 = 0.0

  /// Attitude yaw expressed as Euler angles, not recommended except for human-readable outputs
  /// Units: rad.
  public yaw: f32 = 0.0

  /// X acceleration
  /// Units: m/s/s.
  public xacc: f32 = 0.0

  /// Y acceleration
  /// Units: m/s/s.
  public yacc: f32 = 0.0

  /// Z acceleration
  /// Units: m/s/s.
  public zacc: f32 = 0.0

  /// Angular speed around X axis
  /// Units: rad/s.
  public xgyro: f32 = 0.0

  /// Angular speed around Y axis
  /// Units: rad/s.
  public ygyro: f32 = 0.0

  /// Angular speed around Z axis
  /// Units: rad/s.
  public zgyro: f32 = 0.0

  /// Latitude (lower precision). Both this and the lat_int field should be set.
  /// Units: deg.
  public lat: f32 = 0.0

  /// Longitude (lower precision). Both this and the lon_int field should be set.
  /// Units: deg.
  public lon: f32 = 0.0

