    writeUint(into, at + 26, 1, this.authenticationType as int)
    writeUint(into, at + 27, 1, this.dataPage as int)
    writeUint(into, at + 28, 1, this.lastPageIndex as int)
    writeUint(into, at + 29, 1, this.length as int)
