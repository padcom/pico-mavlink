/// Obstacle distances in front of the sensor, starting from the left in increment degrees to the right
export class ObstacleDistance extends MavLinkData {
  public static readonly MSG_ID: int = 330
  public static readonly MSG_NAME: string = "OBSTACLE_DISTANCE"
  public static readonly PAYLOAD_LENGTH: int = 167
  public static readonly MAGIC_NUMBER: int = 23
  public static readonly INFO: MessageInfo = new MessageInfo(330, "OBSTACLE_DISTANCE", 167, 158, 23, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("distances", "distances", 8, false, 2, "uint16_t[]", "cm", 72),
    new MavLinkPacketField("min_distance", "minDistance", 152, false, 2, "uint16_t", "cm"),
    new MavLinkPacketField("max_distance", "maxDistance", 154, false, 2, "uint16_t", "cm"),
    new MavLinkPacketField("sensor_type", "sensorType", 156, false, 1, "uint8_t", ""),
    new MavLinkPacketField("increment", "increment", 157, false, 1, "uint8_t", "deg"),
    new MavLinkPacketField("increment_f", "incrementF", 158, true, 4, "float", "deg"),
    new MavLinkPacketField("angle_offset", "angleOffset", 162, true, 4, "float", "deg"),
    new MavLinkPacketField("frame", "frame", 166, true, 1, "uint8_t", ""),
  ], (p) => ObstacleDistance.decode(p))

  /// Timestamp (UNIX Epoch time or time since system boot). The receiving end can infer timestamp format
  /// (since 1.1.1970 or since system boot) by checking for the magnitude of the number.
  /// Units: us.
  public timeUsec: u64 = 0

  /// Class id of the distance sensor type.
  /// Values: `MavDistanceSensor`.
  public sensorType: u8 = 0

  /// Distance of obstacles around the vehicle with index 0 corresponding to north + angle_offset, unless
  /// otherwise specified in the frame. A value of 0 is valid and means that the obstacle is practically
  /// touching the sensor. A value of max_distance +1 means no obstacle is present. A value of UINT16_MAX
  /// for unknown/not used. In a array element, one unit corresponds to 1cm.
  /// Units: cm.
  public distances: u16[] = []

  /// Angular width in degrees of each array element. Increment direction is clockwise. This field is
  /// ignored if increment_f is non-zero.
  /// Units: deg.
  public increment: u8 = 0

  /// Minimum distance the sensor can measure.
  /// Units: cm.
  public minDistance: u16 = 0

  /// Maximum distance the sensor can measure.
  /// Units: cm.
  public maxDistance: u16 = 0

  /// Angular width in degrees of each array element as a float. If non-zero then this value is used
  /// instead of the uint8_t increment field. Positive is clockwise direction, negative is
  /// counter-clockwise.
  /// Units: deg.
  public incrementF: f32 = 0.0

  /// Relative angle offset of the 0-index element in the distances array. Value of 0 corresponds to
  /// forward. Positive is clockwise direction, negative is counter-clockwise.
  /// Units: deg.
  public angleOffset: f32 = 0.0

  /// Coordinate frame of reference for the yaw rotation and offset of the sensor data. Defaults to
  /// MAV_FRAME_GLOBAL, which is north aligned. For body-mounted sensors use MAV_FRAME_BODY_FRD, which is
  /// vehicle front aligned.
  /// Values: `MavFrame`.
  public frame: u8 = 0

  /// A OBSTACLE_DISTANCE from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): ObstacleDistance {
    const m = new ObstacleDistance()
    m.timeUsec = readU64(payload, 0)
    for (let i = 0; i < 72; i++) {
      m.distances.push(readU16(payload, 8 + i * 2))
    }
    m.minDistance = readU16(payload, 152)
    m.maxDistance = readU16(payload, 154)
    m.sensorType = readU8(payload, 156)
    m.increment = readU8(payload, 157)
    m.incrementF = readF32(payload, 158)
    m.angleOffset = readF32(payload, 162)
    m.frame = readU8(payload, 166)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    for (let i = 0; i < 72 && i < this.distances.length; i++) {
      writeUint(into, at + 8 + i * 2, 2, this.distances[i] as int)
    }
    writeUint(into, at + 152, 2, this.minDistance as int)
    writeUint(into, at + 154, 2, this.maxDistance as int)
    writeUint(into, at + 156, 1, this.sensorType as int)
    writeUint(into, at + 157, 1, this.increment as int)
    writeF32(into, at + 158, this.incrementF)
    writeF32(into, at + 162, this.angleOffset)
    writeUint(into, at + 166, 1, this.frame as int)
  }

  public override info(): MessageInfo {
    ObstacleDistance.INFO
  }
}

/// Odometry message to communicate odometry information with an external interface. Fits ROS REP 147
/// standard for aerial vehicles (http://www.ros.org/reps/rep-0147.html).
export class Odometry extends MavLinkData {
  public static readonly MSG_ID: int = 331
  public static readonly MSG_NAME: string = "ODOMETRY"
  public static readonly PAYLOAD_LENGTH: int = 233
  public static readonly MAGIC_NUMBER: int = 91
  public static readonly INFO: MessageInfo = new MessageInfo(331, "ODOMETRY", 233, 230, 91, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("x", "x", 8, false, 4, "float", "m"),
    new MavLinkPacketField("y", "y", 12, false, 4, "float", "m"),
    new MavLinkPacketField("z", "z", 16, false, 4, "float", "m"),
    new MavLinkPacketField("q", "q", 20, false, 4, "float[]", "", 4),
    new MavLinkPacketField("vx", "vx", 36, false, 4, "float", "m/s"),
    new MavLinkPacketField("vy", "vy", 40, false, 4, "float", "m/s"),
    new MavLinkPacketField("vz", "vz", 44, false, 4, "float", "m/s"),
    new MavLinkPacketField("rollspeed", "rollspeed", 48, false, 4, "float", "rad/s"),
    new MavLinkPacketField("pitchspeed", "pitchspeed", 52, false, 4, "float", "rad/s"),
    new MavLinkPacketField("yawspeed", "yawspeed", 56, false, 4, "float", "rad/s"),
    new MavLinkPacketField("pose_covariance", "poseCovariance", 60, false, 4, "float[]", "", 21),
    new MavLinkPacketField("velocity_covariance", "velocityCovariance", 144, false, 4, "float[]", "", 21),
    new MavLinkPacketField("frame_id", "frameId", 228, false, 1, "uint8_t", ""),
    new MavLinkPacketField("child_frame_id", "childFrameId", 229, false, 1, "uint8_t", ""),
    new MavLinkPacketField("reset_counter", "resetCounter", 230, true, 1, "uint8_t", ""),
    new MavLinkPacketField("estimator_type", "estimatorType", 231, true, 1, "uint8_t", ""),
    new MavLinkPacketField("quality", "quality", 232, true, 1, "int8_t", "%"),
  ], (p) => Odometry.decode(p))

  /// Timestamp (UNIX Epoch time or time since system boot). The receiving end can infer timestamp format
  /// (since 1.1.1970 or since system boot) by checking for the magnitude of the number.
  /// Units: us.
  public timeUsec: u64 = 0

  /// Coordinate frame of reference for the pose data.
  /// Values: `MavFrame`.
  public frameId: u8 = 0

  /// Coordinate frame of reference for the velocity in free space (twist) data.
  /// Values: `MavFrame`.
  public childFrameId: u8 = 0

  /// X Position
  /// Units: m.
  public x: f32 = 0.0

  /// Y Position
  /// Units: m.
  public y: f32 = 0.0

  /// Z Position
  /// Units: m.
  public z: f32 = 0.0

  /// Quaternion components, w, x, y, z (1 0 0 0 is the null-rotation)
  public q: f32[] = []

  /// X linear speed
  /// Units: m/s.
  public vx: f32 = 0.0

  /// Y linear speed
  /// Units: m/s.
  public vy: f32 = 0.0

  /// Z linear speed
  /// Units: m/s.
  public vz: f32 = 0.0

  /// Roll angular speed
  /// Units: rad/s.
  public rollspeed: f32 = 0.0

  /// Pitch angular speed
  /// Units: rad/s.
  public pitchspeed: f32 = 0.0

  /// Yaw angular speed
  /// Units: rad/s.
  public yawspeed: f32 = 0.0

  /// Row-major representation of a 6x6 pose cross-covariance matrix upper right triangle (states: x, y,
  /// z, roll, pitch, yaw; first six entries are the first ROW, next five entries are the second ROW,
  /// etc.). If unknown, assign NaN value to first element in the array.
  public poseCovariance: f32[] = []

  /// Row-major representation of a 6x6 velocity cross-covariance matrix upper right triangle (states: vx,
  /// vy, vz, rollspeed, pitchspeed, yawspeed; first six entries are the first ROW, next five entries are
  /// the second ROW, etc.). If unknown, assign NaN value to first element in the array.
  public velocityCovariance: f32[] = []

  /// Estimate reset counter. This should be incremented when the estimate resets in any of the dimensions
  /// (position, velocity, attitude, angular speed). This is designed to be used when e.g an external SLAM
  /// system detects a loop-closure and the estimate jumps.
  public resetCounter: u8 = 0

  /// Type of estimator that is providing the odometry.
  /// Values: `MavEstimatorType`.
  public estimatorType: u8 = 0

  /// Optional odometry quality metric as a percentage. -1 = odometry has failed, 0 = unknown/unset
  /// quality, 1 = worst quality, 100 = best quality
  /// Units: %.
  public quality: i8 = 0

  /// A ODOMETRY from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): Odometry {
    const m = new Odometry()
    m.timeUsec = readU64(payload, 0)
    m.x = readF32(payload, 8)
    m.y = readF32(payload, 12)
    m.z = readF32(payload, 16)
    for (let i = 0; i < 4; i++) {
      m.q.push(readF32(payload, 20 + i * 4))
    }
    m.vx = readF32(payload, 36)
    m.vy = readF32(payload, 40)
    m.vz = readF32(payload, 44)
    m.rollspeed = readF32(payload, 48)
    m.pitchspeed = readF32(payload, 52)
    m.yawspeed = readF32(payload, 56)
    for (let i = 0; i < 21; i++) {
      m.poseCovariance.push(readF32(payload, 60 + i * 4))
    }
    for (let i = 0; i < 21; i++) {
      m.velocityCovariance.push(readF32(payload, 144 + i * 4))
    }
    m.frameId = readU8(payload, 228)
    m.childFrameId = readU8(payload, 229)
    m.resetCounter = readU8(payload, 230)
    m.estimatorType = readU8(payload, 231)
    m.quality = readI8(payload, 232)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    writeF32(into, at + 8, this.x)
    writeF32(into, at + 12, this.y)
    writeF32(into, at + 16, this.z)
    for (let i = 0; i < 4 && i < this.q.length; i++) {
      writeF32(into, at + 20 + i * 4, this.q[i])
    }
    writeF32(into, at + 36, this.vx)
    writeF32(into, at + 40, this.vy)
    writeF32(into, at + 44, this.vz)
    writeF32(into, at + 48, this.rollspeed)
    writeF32(into, at + 52, this.pitchspeed)
    writeF32(into, at + 56, this.yawspeed)
    for (let i = 0; i < 21 && i < this.poseCovariance.length; i++) {
      writeF32(into, at + 60 + i * 4, this.poseCovariance[i])
    }
    for (let i = 0; i < 21 && i < this.velocityCovariance.length; i++) {
      writeF32(into, at + 144 + i * 4, this.velocityCovariance[i])
    }
    writeUint(into, at + 228, 1, this.frameId as int)
    writeUint(into, at + 229, 1, this.childFrameId as int)
    writeUint(into, at + 230, 1, this.resetCounter as int)
    writeUint(into, at + 231, 1, this.estimatorType as int)
    writeUint(into, at + 232, 1, this.quality as int)
  }

  public override info(): MessageInfo {
    Odometry.INFO
  }
}

