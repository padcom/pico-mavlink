      64 => "HAS_BASIC_ZOOM",
      128 => "HAS_BASIC_FOCUS",
      256 => "HAS_VIDEO_STREAM",
      512 => "HAS_TRACKING_POINT",
      1024 => "HAS_TRACKING_RECTANGLE",
      2048 => "HAS_TRACKING_GEO_STATUS",
      4096 => "HAS_THERMAL_RANGE",
      8192 => "HAS_MTI",
      _ => null,
