/// Data for injecting into the onboard GPS (used for DGPS)
export class GpsInjectData extends MavLinkData {
  public static readonly MSG_ID: int = 123
  public static readonly MSG_NAME: string = "GPS_INJECT_DATA"
  public static readonly PAYLOAD_LENGTH: int = 113
  public static readonly MAGIC_NUMBER: int = 250
  public static readonly INFO: MessageInfo = new MessageInfo(123, "GPS_INJECT_DATA", 113, 113, 250, [
    new MavLinkPacketField("target_system", "targetSystem", 0, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 1, false, 1, "uint8_t", ""),
    new MavLinkPacketField("len", "len", 2, false, 1, "uint8_t", "bytes"),
    new MavLinkPacketField("data", "data", 3, false, 1, "uint8_t[]", "", 110),
  ], (p) => GpsInjectData.decode(p))

  /// System ID
  public targetSystem: u8 = 0

  /// Component ID
  public targetComponent: u8 = 0

  /// Data length
  /// Units: bytes.
  public len: u8 = 0

  /// Raw data (110 is enough for 12 satellites of RTCMv2)
  public data: u8[] = []

  /// A GPS_INJECT_DATA from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): GpsInjectData {
    const m = new GpsInjectData()
    m.targetSystem = readU8(payload, 0)
    m.targetComponent = readU8(payload, 1)
    m.len = readU8(payload, 2)
    for (let i = 0; i < 110; i++) {
      m.data.push(readU8(payload, 3 + i * 1))
    }
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 1, this.targetSystem as int)
    writeUint(into, at + 1, 1, this.targetComponent as int)
    writeUint(into, at + 2, 1, this.len as int)
    for (let i = 0; i < 110 && i < this.data.length; i++) {
      writeUint(into, at + 3 + i * 1, 1, this.data[i] as int)
    }
  }

  public override info(): MessageInfo {
    GpsInjectData.INFO
  }
}

/// Second GPS data.
export class Gps2Raw extends MavLinkData {
  public static readonly MSG_ID: int = 124
  public static readonly MSG_NAME: string = "GPS2_RAW"
  public static readonly PAYLOAD_LENGTH: int = 57
  public static readonly MAGIC_NUMBER: int = 87
  public static readonly INFO: MessageInfo = new MessageInfo(124, "GPS2_RAW", 57, 35, 87, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("lat", "lat", 8, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("lon", "lon", 12, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("alt", "alt", 16, false, 4, "int32_t", "mm"),
    new MavLinkPacketField("dgps_age", "dgpsAge", 20, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("eph", "eph", 24, false, 2, "uint16_t", ""),
    new MavLinkPacketField("epv", "epv", 26, false, 2, "uint16_t", ""),
    new MavLinkPacketField("vel", "vel", 28, false, 2, "uint16_t", "cm/s"),
    new MavLinkPacketField("cog", "cog", 30, false, 2, "uint16_t", "cdeg"),
    new MavLinkPacketField("fix_type", "fixType", 32, false, 1, "uint8_t", ""),
    new MavLinkPacketField("satellites_visible", "satellitesVisible", 33, false, 1, "uint8_t", ""),
    new MavLinkPacketField("dgps_numch", "dgpsNumch", 34, false, 1, "uint8_t", ""),
    new MavLinkPacketField("yaw", "yaw", 35, true, 2, "uint16_t", "cdeg"),
    new MavLinkPacketField("alt_ellipsoid", "altEllipsoid", 37, true, 4, "int32_t", "mm"),
    new MavLinkPacketField("h_acc", "hAcc", 41, true, 4, "uint32_t", "mm"),
    new MavLinkPacketField("v_acc", "vAcc", 45, true, 4, "uint32_t", "mm"),
    new MavLinkPacketField("vel_acc", "velAcc", 49, true, 4, "uint32_t", "mm/s"),
    new MavLinkPacketField("hdg_acc", "hdgAcc", 53, true, 4, "uint32_t", "degE5"),
  ], (p) => Gps2Raw.decode(p))

  /// Timestamp (UNIX Epoch time or time since system boot). The receiving end can infer timestamp format
  /// (since 1.1.1970 or since system boot) by checking for the magnitude of the number.
  /// Units: us.
  public timeUsec: u64 = 0

  /// GPS fix type.
  /// Values: `GpsFixType`.
  public fixType: u8 = 0

  /// Latitude (WGS84)
  /// Units: degE7.
  public lat: i32 = 0

  /// Longitude (WGS84)
  /// Units: degE7.
  public lon: i32 = 0

  /// Altitude (MSL). Positive for up.
  /// Units: mm.
  public alt: i32 = 0

  /// GPS HDOP horizontal dilution of position (unitless * 100). If unknown, set to: UINT16_MAX
  public eph: u16 = 0

  /// GPS VDOP vertical dilution of position (unitless * 100). If unknown, set to: UINT16_MAX
  public epv: u16 = 0

  /// GPS ground speed. If unknown, set to: UINT16_MAX
  /// Units: cm/s.
  public vel: u16 = 0

  /// Course over ground (NOT heading, but direction of movement): 0.0..359.99 degrees. If unknown, set
  /// to: UINT16_MAX
  /// Units: cdeg.
  public cog: u16 = 0

  /// Number of satellites visible. If unknown, set to UINT8_MAX
  public satellitesVisible: u8 = 0

  /// Number of DGPS satellites
  public dgpsNumch: u8 = 0

  /// Age of DGPS info
  /// Units: ms.
  public dgpsAge: u32 = 0

  /// Yaw in earth frame from north. Use 0 if this GPS does not provide yaw. Use UINT16_MAX if this GPS is
  /// configured to provide yaw and is currently unable to provide it. Use 36000 for north.
  /// Units: cdeg.
  public yaw: u16 = 0

  /// Altitude (above WGS84, EGM96 ellipsoid). Positive for up.
  /// Units: mm.
  public altEllipsoid: i32 = 0

  /// Position uncertainty.
  /// Units: mm.
  public hAcc: u32 = 0

  /// Altitude uncertainty.
  /// Units: mm.
  public vAcc: u32 = 0

  /// Speed uncertainty.
  /// Units: mm/s.
  public velAcc: u32 = 0

  /// Heading / track uncertainty
  /// Units: degE5.
  public hdgAcc: u32 = 0

  /// A GPS2_RAW from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): Gps2Raw {
    const m = new Gps2Raw()
    m.timeUsec = readU64(payload, 0)
    m.lat = readI32(payload, 8)
    m.lon = readI32(payload, 12)
    m.alt = readI32(payload, 16)
    m.dgpsAge = readU32(payload, 20)
    m.eph = readU16(payload, 24)
    m.epv = readU16(payload, 26)
    m.vel = readU16(payload, 28)
    m.cog = readU16(payload, 30)
    m.fixType = readU8(payload, 32)
    m.satellitesVisible = readU8(payload, 33)
    m.dgpsNumch = readU8(payload, 34)
    m.yaw = readU16(payload, 35)
    m.altEllipsoid = readI32(payload, 37)
    m.hAcc = readU32(payload, 41)
    m.vAcc = readU32(payload, 45)
    m.velAcc = readU32(payload, 49)
    m.hdgAcc = readU32(payload, 53)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    writeUint(into, at + 8, 4, this.lat as int)
    writeUint(into, at + 12, 4, this.lon as int)
    writeUint(into, at + 16, 4, this.alt as int)
    writeUint(into, at + 20, 4, this.dgpsAge as int)
    writeUint(into, at + 24, 2, this.eph as int)
    writeUint(into, at + 26, 2, this.epv as int)
    writeUint(into, at + 28, 2, this.vel as int)
    writeUint(into, at + 30, 2, this.cog as int)
    writeUint(into, at + 32, 1, this.fixType as int)
    writeUint(into, at + 33, 1, this.satellitesVisible as int)
    writeUint(into, at + 34, 1, this.dgpsNumch as int)
    writeUint(into, at + 35, 2, this.yaw as int)
    writeUint(into, at + 37, 4, this.altEllipsoid as int)
    writeUint(into, at + 41, 4, this.hAcc as int)
    writeUint(into, at + 45, 4, this.vAcc as int)
    writeUint(into, at + 49, 4, this.velAcc as int)
    writeUint(into, at + 53, 4, this.hdgAcc as int)
  }

  public override info(): MessageInfo {
    Gps2Raw.INFO
  }
}

/// Power supply status
export class PowerStatus extends MavLinkData {
  public static readonly MSG_ID: int = 125
  public static readonly MSG_NAME: string = "POWER_STATUS"
  public static readonly PAYLOAD_LENGTH: int = 6
  public static readonly MAGIC_NUMBER: int = 203
  public static readonly INFO: MessageInfo = new MessageInfo(125, "POWER_STATUS", 6, 6, 203, [
    new MavLinkPacketField("Vcc", "Vcc", 0, false, 2, "uint16_t", "mV"),
    new MavLinkPacketField("Vservo", "Vservo", 2, false, 2, "uint16_t", "mV"),
    new MavLinkPacketField("flags", "flags", 4, false, 2, "uint16_t", ""),
  ], (p) => PowerStatus.decode(p))

  /// 5V rail voltage.
  /// Units: mV.
  public Vcc: u16 = 0

  /// Servo rail voltage.
  /// Units: mV.
  public Vservo: u16 = 0

  /// Bitmap of power supply status flags.
  /// Values: `MavPowerStatus`.
  public flags: u16 = 0

  /// A POWER_STATUS from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): PowerStatus {
    const m = new PowerStatus()
    m.Vcc = readU16(payload, 0)
    m.Vservo = readU16(payload, 2)
    m.flags = readU16(payload, 4)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 2, this.Vcc as int)
    writeUint(into, at + 2, 2, this.Vservo as int)
    writeUint(into, at + 4, 2, this.flags as int)
  }

  public override info(): MessageInfo {
    PowerStatus.INFO
  }
}

/// Control a serial port. This can be used for raw access to an onboard serial peripheral such as a GPS
/// or telemetry radio. It is designed to make it possible to update the devices firmware via MAVLink
/// messages or change the devices settings. A message with zero bytes can be used to change just the
/// baudrate.
export class SerialControl extends MavLinkData {
  public static readonly MSG_ID: int = 126
  public static readonly MSG_NAME: string = "SERIAL_CONTROL"
  public static readonly PAYLOAD_LENGTH: int = 81
  public static readonly MAGIC_NUMBER: int = 220
  public static readonly INFO: MessageInfo = new MessageInfo(126, "SERIAL_CONTROL", 81, 79, 220, [
    new MavLinkPacketField("baudrate", "baudrate", 0, false, 4, "uint32_t", "bits/s"),
    new MavLinkPacketField("timeout", "timeout", 4, false, 2, "uint16_t", "ms"),
    new MavLinkPacketField("device", "device", 6, false, 1, "uint8_t", ""),
    new MavLinkPacketField("flags", "flags", 7, false, 1, "uint8_t", ""),
    new MavLinkPacketField("count", "count", 8, false, 1, "uint8_t", "bytes"),
    new MavLinkPacketField("data", "data", 9, false, 1, "uint8_t[]", "", 70),
    new MavLinkPacketField("target_system", "targetSystem", 79, true, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 80, true, 1, "uint8_t", ""),
  ], (p) => SerialControl.decode(p))

  /// Serial control device type.
  /// Values: `SerialControlDev`.
  public device: u8 = 0

  /// Bitmap of serial control flags.
  /// Values: `SerialControlFlag`.
  public flags: u8 = 0

  /// Timeout for reply data
  /// Units: ms.
  public timeout: u16 = 0

  /// Baudrate of transfer. Zero means no change.
  /// Units: bits/s.
  public baudrate: u32 = 0

  /// how many bytes in this transfer
  /// Units: bytes.
  public count: u8 = 0

  /// serial data
  public data: u8[] = []

  /// System ID
  public targetSystem: u8 = 0

  /// Component ID
  public targetComponent: u8 = 0

  /// A SERIAL_CONTROL from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): SerialControl {
    const m = new SerialControl()
    m.baudrate = readU32(payload, 0)
    m.timeout = readU16(payload, 4)
    m.device = readU8(payload, 6)
    m.flags = readU8(payload, 7)
    m.count = readU8(payload, 8)
    for (let i = 0; i < 70; i++) {
      m.data.push(readU8(payload, 9 + i * 1))
    }
    m.targetSystem = readU8(payload, 79)
    m.targetComponent = readU8(payload, 80)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.baudrate as int)
    writeUint(into, at + 4, 2, this.timeout as int)
    writeUint(into, at + 6, 1, this.device as int)
    writeUint(into, at + 7, 1, this.flags as int)
    writeUint(into, at + 8, 1, this.count as int)
    for (let i = 0; i < 70 && i < this.data.length; i++) {
      writeUint(into, at + 9 + i * 1, 1, this.data[i] as int)
    }
    writeUint(into, at + 79, 1, this.targetSystem as int)
    writeUint(into, at + 80, 1, this.targetComponent as int)
  }

  public override info(): MessageInfo {
    SerialControl.INFO
  }
}

/// RTK GPS data. Gives information on the relative baseline calculation the GPS is reporting
export class GpsRtk extends MavLinkData {
  public static readonly MSG_ID: int = 127
  public static readonly MSG_NAME: string = "GPS_RTK"
  public static readonly PAYLOAD_LENGTH: int = 35
  public static readonly MAGIC_NUMBER: int = 25
  public static readonly INFO: MessageInfo = new MessageInfo(127, "GPS_RTK", 35, 35, 25, [
    new MavLinkPacketField("time_last_baseline_ms", "timeLastBaselineMs", 0, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("tow", "tow", 4, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("baseline_a_mm", "baselineAMm", 8, false, 4, "int32_t", "mm"),
    new MavLinkPacketField("baseline_b_mm", "baselineBMm", 12, false, 4, "int32_t", "mm"),
    new MavLinkPacketField("baseline_c_mm", "baselineCMm", 16, false, 4, "int32_t", "mm"),
    new MavLinkPacketField("accuracy", "accuracy", 20, false, 4, "uint32_t", ""),
    new MavLinkPacketField("iar_num_hypotheses", "iarNumHypotheses", 24, false, 4, "int32_t", ""),
    new MavLinkPacketField("wn", "wn", 28, false, 2, "uint16_t", ""),
    new MavLinkPacketField("rtk_receiver_id", "rtkReceiverId", 30, false, 1, "uint8_t", ""),
    new MavLinkPacketField("rtk_health", "rtkHealth", 31, false, 1, "uint8_t", ""),
    new MavLinkPacketField("rtk_rate", "rtkRate", 32, false, 1, "uint8_t", "Hz"),
    new MavLinkPacketField("nsats", "nsats", 33, false, 1, "uint8_t", ""),
    new MavLinkPacketField("baseline_coords_type", "baselineCoordsType", 34, false, 1, "uint8_t", ""),
  ], (p) => GpsRtk.decode(p))

  /// Time since boot of last baseline message received.
  /// Units: ms.
  public timeLastBaselineMs: u32 = 0

  /// Identification of connected RTK receiver.
  public rtkReceiverId: u8 = 0

  /// GPS Week Number of last baseline
  public wn: u16 = 0

  /// GPS Time of Week of last baseline
  /// Units: ms.
  public tow: u32 = 0

  /// GPS-specific health report for RTK data.
  public rtkHealth: u8 = 0

  /// Rate of baseline messages being received by GPS
  /// Units: Hz.
  public rtkRate: u8 = 0

  /// Current number of sats used for RTK calculation.
  public nsats: u8 = 0

  /// Coordinate system of baseline
  /// Values: `RtkBaselineCoordinateSystem`.
  public baselineCoordsType: u8 = 0

  /// Current baseline in ECEF x or NED north component.
  /// Units: mm.
  public baselineAMm: i32 = 0

  /// Current baseline in ECEF y or NED east component.
  /// Units: mm.
  public baselineBMm: i32 = 0

  /// Current baseline in ECEF z or NED down component.
  /// Units: mm.
  public baselineCMm: i32 = 0

  /// Current estimate of baseline accuracy.
  public accuracy: u32 = 0

  /// Current number of integer ambiguity hypotheses.
  public iarNumHypotheses: i32 = 0

  /// A GPS_RTK from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): GpsRtk {
    const m = new GpsRtk()
    m.timeLastBaselineMs = readU32(payload, 0)
    m.tow = readU32(payload, 4)
    m.baselineAMm = readI32(payload, 8)
    m.baselineBMm = readI32(payload, 12)
    m.baselineCMm = readI32(payload, 16)
    m.accuracy = readU32(payload, 20)
    m.iarNumHypotheses = readI32(payload, 24)
    m.wn = readU16(payload, 28)
    m.rtkReceiverId = readU8(payload, 30)
    m.rtkHealth = readU8(payload, 31)
    m.rtkRate = readU8(payload, 32)
    m.nsats = readU8(payload, 33)
    m.baselineCoordsType = readU8(payload, 34)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.timeLastBaselineMs as int)
    writeUint(into, at + 4, 4, this.tow as int)
    writeUint(into, at + 8, 4, this.baselineAMm as int)
    writeUint(into, at + 12, 4, this.baselineBMm as int)
    writeUint(into, at + 16, 4, this.baselineCMm as int)
    writeUint(into, at + 20, 4, this.accuracy as int)
    writeUint(into, at + 24, 4, this.iarNumHypotheses as int)
    writeUint(into, at + 28, 2, this.wn as int)
    writeUint(into, at + 30, 1, this.rtkReceiverId as int)
    writeUint(into, at + 31, 1, this.rtkHealth as int)
    writeUint(into, at + 32, 1, this.rtkRate as int)
    writeUint(into, at + 33, 1, this.nsats as int)
    writeUint(into, at + 34, 1, this.baselineCoordsType as int)
  }

  public override info(): MessageInfo {
    GpsRtk.INFO
  }
}

/// RTK GPS data. Gives information on the relative baseline calculation the GPS is reporting
export class Gps2Rtk extends MavLinkData {
  public static readonly MSG_ID: int = 128
  public static readonly MSG_NAME: string = "GPS2_RTK"
  public static readonly PAYLOAD_LENGTH: int = 35
  public static readonly MAGIC_NUMBER: int = 226
  public static readonly INFO: MessageInfo = new MessageInfo(128, "GPS2_RTK", 35, 35, 226, [
    new MavLinkPacketField("time_last_baseline_ms", "timeLastBaselineMs", 0, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("tow", "tow", 4, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("baseline_a_mm", "baselineAMm", 8, false, 4, "int32_t", "mm"),
    new MavLinkPacketField("baseline_b_mm", "baselineBMm", 12, false, 4, "int32_t", "mm"),
    new MavLinkPacketField("baseline_c_mm", "baselineCMm", 16, false, 4, "int32_t", "mm"),
    new MavLinkPacketField("accuracy", "accuracy", 20, false, 4, "uint32_t", ""),
