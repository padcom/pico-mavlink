    }
    for (let i = 0; i < 5; i++) {
      m.accY.push(readF32(payload, 148 + i * 4))
    }
    for (let i = 0; i < 5; i++) {
      m.accZ.push(readF32(payload, 168 + i * 4))
    }
    for (let i = 0; i < 5; i++) {
      m.posYaw.push(readF32(payload, 188 + i * 4))
    }
    for (let i = 0; i < 5; i++) {
      m.velYaw.push(readF32(payload, 208 + i * 4))
    }
    for (let i = 0; i < 5; i++) {
