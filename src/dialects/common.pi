/// List of possible failure type to inject.
export class FailureType {
  /// No failure injected, used to reset a previous failure.
  public static readonly OK: int = 0

  /// Sets unit off, so completely non-responsive.
  public static readonly OFF: int = 1

  /// Unit is stuck e.g. keeps reporting the same value.
  public static readonly STUCK: int = 2

  /// Unit is reporting complete garbage.
  public static readonly GARBAGE: int = 3

  /// Unit is consistently wrong.
  public static readonly WRONG: int = 4

  /// Unit is slow, so e.g. reporting at slower than expected rate.
  public static readonly SLOW: int = 5

  /// Data of unit is delayed in time.
  public static readonly DELAYED: int = 6

  /// Unit is sometimes working, sometimes not.
  public static readonly INTERMITTENT: int = 7

  /// The name of `value` (`OK` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "OK",
      1 => "OFF",
      2 => "STUCK",
      3 => "GARBAGE",
      4 => "WRONG",
      5 => "SLOW",
      6 => "DELAYED",
      7 => "INTERMITTENT",
      _ => null,
    }
  }
}

/// NAV_VTOL_LAND_OPTIONS
export class NavVtolLandOptions {
  /// Default autopilot landing behaviour.
  public static readonly DEFAULT: int = 0

  /// Descend in fixed wing mode, transitioning to multicopter mode for vertical landing when close to the
  /// ground. The fixed wing descent pattern is at the discretion of the vehicle (e.g. transition
  /// altitude, loiter direction, radius, and speed, etc.).
  public static readonly FW_DESCENT: int = 1

  /// Land in multicopter mode on reaching the landing coordinates (the whole landing is by "hover
  /// descent").
  public static readonly HOVER_DESCENT: int = 2

  /// The name of `value` (`DEFAULT` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "DEFAULT",
      1 => "FW_DESCENT",
      2 => "HOVER_DESCENT",
      _ => null,
    }
  }
}

/// Winch status flags used in WINCH_STATUS
export class MavWinchStatusFlag {
  /// Winch is healthy
  public static readonly HEALTHY: int = 1

  /// Winch line is fully retracted
  public static readonly FULLY_RETRACTED: int = 2

  /// Winch motor is moving
  public static readonly MOVING: int = 4

  /// Winch clutch is engaged allowing motor to move freely.
  public static readonly CLUTCH_ENGAGED: int = 8

  /// Winch is locked by locking mechanism.
  public static readonly LOCKED: int = 16

  /// Winch is gravity dropping payload.
  public static readonly DROPPING: int = 32

  /// Winch is arresting payload descent.
  public static readonly ARRESTING: int = 64

  /// Winch is using torque measurements to sense the ground.
  public static readonly GROUND_SENSE: int = 128

  /// Winch is returning to the fully retracted position.
  public static readonly RETRACTING: int = 256

  /// Winch is redelivering the payload. This is a failover state if the line tension goes above a
  /// threshold during RETRACTING.
  public static readonly REDELIVER: int = 512

  /// Winch is abandoning the line and possibly payload. Winch unspools the entire calculated line length.
  /// This is a failover state from REDELIVER if the number of attempts exceeds a threshold.
  public static readonly ABANDON_LINE: int = 1024

  /// Winch is engaging the locking mechanism.
  public static readonly LOCKING: int = 2048

  /// Winch is spooling on line.
  public static readonly LOAD_LINE: int = 4096

  /// Winch is loading a payload.
  public static readonly LOAD_PAYLOAD: int = 8192

  /// The name of `value` (`HEALTHY` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      1 => "HEALTHY",
      2 => "FULLY_RETRACTED",
      4 => "MOVING",
      8 => "CLUTCH_ENGAGED",
      16 => "LOCKED",
      32 => "DROPPING",
      64 => "ARRESTING",
      128 => "GROUND_SENSE",
      256 => "RETRACTING",
      512 => "REDELIVER",
      1024 => "ABANDON_LINE",
      2048 => "LOCKING",
      4096 => "LOAD_LINE",
      8192 => "LOAD_PAYLOAD",
      _ => null,
    }
  }
}

