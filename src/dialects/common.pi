  /// Aircraft to move perpendicular to the collision's velocity vector
  public static readonly MOVE_PERPENDICULAR: int = 4

  /// Aircraft to fly directly back to its launch point
  public static readonly RTL: int = 5

  /// Aircraft to stop in place
  public static readonly HOVER: int = 6

  /// The name of `value` (`NONE` …), or null for a value this dialect doesn't define.
