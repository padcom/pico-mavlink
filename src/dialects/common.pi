/// The global position, as returned by the Global Positioning System (GPS). This is NOT the global
/// position estimate of the system, but rather a RAW sensor value. See message GLOBAL_POSITION_INT for
/// the global position estimate.
export class HilGps extends MavLinkData {
  public static readonly MSG_ID: int = 113
  public static readonly MSG_NAME: string = "HIL_GPS"
  public static readonly PAYLOAD_LENGTH: int = 39
  public static readonly MAGIC_NUMBER: int = 124
  public static readonly INFO: MessageInfo = new MessageInfo(113, "HIL_GPS", 39, 36, 124, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("lat", "lat", 8, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("lon", "lon", 12, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("alt", "alt", 16, false, 4, "int32_t", "mm"),
    new MavLinkPacketField("eph", "eph", 20, false, 2, "uint16_t", ""),
    new MavLinkPacketField("epv", "epv", 22, false, 2, "uint16_t", ""),
    new MavLinkPacketField("vel", "vel", 24, false, 2, "uint16_t", "cm/s"),
    new MavLinkPacketField("vn", "vn", 26, false, 2, "int16_t", "cm/s"),
    new MavLinkPacketField("ve", "ve", 28, false, 2, "int16_t", "cm/s"),
    new MavLinkPacketField("vd", "vd", 30, false, 2, "int16_t", "cm/s"),
    new MavLinkPacketField("cog", "cog", 32, false, 2, "uint16_t", "cdeg"),
    new MavLinkPacketField("fix_type", "fixType", 34, false, 1, "uint8_t", ""),
    new MavLinkPacketField("satellites_visible", "satellitesVisible", 35, false, 1, "uint8_t", ""),
    new MavLinkPacketField("id", "id", 36, true, 1, "uint8_t", ""),
    new MavLinkPacketField("yaw", "yaw", 37, true, 2, "uint16_t", "cdeg"),
  ], (p) => HilGps.decode(p))

  /// Timestamp (UNIX Epoch time or time since system boot). The receiving end can infer timestamp format
  /// (since 1.1.1970 or since system boot) by checking for the magnitude of the number.
  /// Units: us.
  public timeUsec: u64 = 0

  /// 0-1: no fix, 2: 2D fix, 3: 3D fix. Some applications will not use the value of this field unless it
  /// is at least two, so always correctly fill in the fix.
  public fixType: u8 = 0

  /// Latitude (WGS84)
  /// Units: degE7.
  public lat: i32 = 0

  /// Longitude (WGS84)
  /// Units: degE7.
  public lon: i32 = 0

  /// Altitude (MSL). Positive for up.
  /// Units: mm.
  public alt: i32 = 0

  /// GPS HDOP horizontal dilution of position (unitless * 100). If unknown, set to: UINT16_MAX
  public eph: u16 = 0

  /// GPS VDOP vertical dilution of position (unitless * 100). If unknown, set to: UINT16_MAX
  public epv: u16 = 0

  /// GPS ground speed. If unknown, set to: UINT16_MAX
  /// Units: cm/s.
  public vel: u16 = 0

  /// GPS velocity in north direction in earth-fixed NED frame
  /// Units: cm/s.
  public vn: i16 = 0

  /// GPS velocity in east direction in earth-fixed NED frame
  /// Units: cm/s.
  public ve: i16 = 0

  /// GPS velocity in down direction in earth-fixed NED frame
  /// Units: cm/s.
  public vd: i16 = 0

  /// Course over ground (NOT heading, but direction of movement), 0.0..359.99 degrees. If unknown, set
  /// to: UINT16_MAX
  /// Units: cdeg.
  public cog: u16 = 0

  /// Number of satellites visible. If unknown, set to UINT8_MAX
  public satellitesVisible: u8 = 0

  /// GPS ID (zero indexed). Used for multiple GPS inputs
  public id: u8 = 0

  /// Yaw of vehicle relative to Earth's North, zero means not available, use 36000 for north
  /// Units: cdeg.
  public yaw: u16 = 0

  /// A HIL_GPS from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): HilGps {
    const m = new HilGps()
    m.timeUsec = readU64(payload, 0)
    m.lat = readI32(payload, 8)
    m.lon = readI32(payload, 12)
    m.alt = readI32(payload, 16)
    m.eph = readU16(payload, 20)
    m.epv = readU16(payload, 22)
    m.vel = readU16(payload, 24)
    m.vn = readI16(payload, 26)
    m.ve = readI16(payload, 28)
    m.vd = readI16(payload, 30)
    m.cog = readU16(payload, 32)
    m.fixType = readU8(payload, 34)
    m.satellitesVisible = readU8(payload, 35)
    m.id = readU8(payload, 36)
    m.yaw = readU16(payload, 37)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    writeUint(into, at + 8, 4, this.lat as int)
    writeUint(into, at + 12, 4, this.lon as int)
    writeUint(into, at + 16, 4, this.alt as int)
    writeUint(into, at + 20, 2, this.eph as int)
    writeUint(into, at + 22, 2, this.epv as int)
    writeUint(into, at + 24, 2, this.vel as int)
    writeUint(into, at + 26, 2, this.vn as int)
    writeUint(into, at + 28, 2, this.ve as int)
    writeUint(into, at + 30, 2, this.vd as int)
    writeUint(into, at + 32, 2, this.cog as int)
    writeUint(into, at + 34, 1, this.fixType as int)
    writeUint(into, at + 35, 1, this.satellitesVisible as int)
    writeUint(into, at + 36, 1, this.id as int)
    writeUint(into, at + 37, 2, this.yaw as int)
  }

  public override info(): MessageInfo {
    HilGps.INFO
  }
}

/// Simulated optical flow from a flow sensor (e.g. PX4FLOW or optical mouse sensor)
export class HilOpticalFlow extends MavLinkData {
  public static readonly MSG_ID: int = 114
  public static readonly MSG_NAME: string = "HIL_OPTICAL_FLOW"
  public static readonly PAYLOAD_LENGTH: int = 44
  public static readonly MAGIC_NUMBER: int = 237
  public static readonly INFO: MessageInfo = new MessageInfo(114, "HIL_OPTICAL_FLOW", 44, 44, 237, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("integration_time_us", "integrationTimeUs", 8, false, 4, "uint32_t", "us"),
    new MavLinkPacketField("integrated_x", "integratedX", 12, false, 4, "float", "rad"),
    new MavLinkPacketField("integrated_y", "integratedY", 16, false, 4, "float", "rad"),
    new MavLinkPacketField("integrated_xgyro", "integratedXgyro", 20, false, 4, "float", "rad"),
    new MavLinkPacketField("integrated_ygyro", "integratedYgyro", 24, false, 4, "float", "rad"),
    new MavLinkPacketField("integrated_zgyro", "integratedZgyro", 28, false, 4, "float", "rad"),
    new MavLinkPacketField("time_delta_distance_us", "timeDeltaDistanceUs", 32, false, 4, "uint32_t", "us"),
    new MavLinkPacketField("distance", "distance", 36, false, 4, "float", "m"),
    new MavLinkPacketField("temperature", "temperature", 40, false, 2, "int16_t", "cdegC"),
    new MavLinkPacketField("sensor_id", "sensorId", 42, false, 1, "uint8_t", ""),
    new MavLinkPacketField("quality", "quality", 43, false, 1, "uint8_t", ""),
  ], (p) => HilOpticalFlow.decode(p))

  /// Timestamp (UNIX Epoch time or time since system boot). The receiving end can infer timestamp format
  /// (since 1.1.1970 or since system boot) by checking for the magnitude of the number.
  /// Units: us.
  public timeUsec: u64 = 0

  /// Sensor ID
  public sensorId: u8 = 0

  /// Integration time. Divide integrated_x and integrated_y by the integration time to obtain average
  /// flow. The integration time also indicates the.
  /// Units: us.
  public integrationTimeUs: u32 = 0

  /// Flow in radians around X axis (Sensor RH rotation about the X axis induces a positive flow. Sensor
  /// linear motion along the positive Y axis induces a negative flow.)
  /// Units: rad.
  public integratedX: f32 = 0.0

  /// Flow in radians around Y axis (Sensor RH rotation about the Y axis induces a positive flow. Sensor
  /// linear motion along the positive X axis induces a positive flow.)
  /// Units: rad.
  public integratedY: f32 = 0.0

  /// RH rotation around X axis
  /// Units: rad.
  public integratedXgyro: f32 = 0.0

  /// RH rotation around Y axis
  /// Units: rad.
  public integratedYgyro: f32 = 0.0

  /// RH rotation around Z axis
  /// Units: rad.
  public integratedZgyro: f32 = 0.0

  /// Temperature
  /// Units: cdegC.
  public temperature: i16 = 0

  /// Optical flow quality / confidence. 0: no valid flow, 255: maximum quality
  public quality: u8 = 0

  /// Time since the distance was sampled.
  /// Units: us.
  public timeDeltaDistanceUs: u32 = 0

  /// Distance to the center of the flow field. Positive value (including zero): distance known. Negative
  /// value: Unknown distance.
  /// Units: m.
  public distance: f32 = 0.0

  /// A HIL_OPTICAL_FLOW from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): HilOpticalFlow {
    const m = new HilOpticalFlow()
    m.timeUsec = readU64(payload, 0)
    m.integrationTimeUs = readU32(payload, 8)
    m.integratedX = readF32(payload, 12)
    m.integratedY = readF32(payload, 16)
    m.integratedXgyro = readF32(payload, 20)
    m.integratedYgyro = readF32(payload, 24)
    m.integratedZgyro = readF32(payload, 28)
    m.timeDeltaDistanceUs = readU32(payload, 32)
    m.distance = readF32(payload, 36)
    m.temperature = readI16(payload, 40)
    m.sensorId = readU8(payload, 42)
    m.quality = readU8(payload, 43)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    writeUint(into, at + 8, 4, this.integrationTimeUs as int)
    writeF32(into, at + 12, this.integratedX)
    writeF32(into, at + 16, this.integratedY)
    writeF32(into, at + 20, this.integratedXgyro)
    writeF32(into, at + 24, this.integratedYgyro)
    writeF32(into, at + 28, this.integratedZgyro)
    writeUint(into, at + 32, 4, this.timeDeltaDistanceUs as int)
    writeF32(into, at + 36, this.distance)
    writeUint(into, at + 40, 2, this.temperature as int)
    writeUint(into, at + 42, 1, this.sensorId as int)
    writeUint(into, at + 43, 1, this.quality as int)
  }

  public override info(): MessageInfo {
    HilOpticalFlow.INFO
  }
}

/// Sent from simulation to autopilot, avoids in contrast to HIL_STATE singularities. This packet is
/// useful for high throughput applications such as hardware in the loop simulations.
export class HilStateQuaternion extends MavLinkData {
  public static readonly MSG_ID: int = 115
  public static readonly MSG_NAME: string = "HIL_STATE_QUATERNION"
  public static readonly PAYLOAD_LENGTH: int = 64
  public static readonly MAGIC_NUMBER: int = 4
  public static readonly INFO: MessageInfo = new MessageInfo(115, "HIL_STATE_QUATERNION", 64, 64, 4, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("attitude_quaternion", "attitudeQuaternion", 8, false, 4, "float[]", "", 4),
    new MavLinkPacketField("rollspeed", "rollspeed", 24, false, 4, "float", "rad/s"),
    new MavLinkPacketField("pitchspeed", "pitchspeed", 28, false, 4, "float", "rad/s"),
    new MavLinkPacketField("yawspeed", "yawspeed", 32, false, 4, "float", "rad/s"),
    new MavLinkPacketField("lat", "lat", 36, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("lon", "lon", 40, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("alt", "alt", 44, false, 4, "int32_t", "mm"),
    new MavLinkPacketField("vx", "vx", 48, false, 2, "int16_t", "cm/s"),
    new MavLinkPacketField("vy", "vy", 50, false, 2, "int16_t", "cm/s"),
    new MavLinkPacketField("vz", "vz", 52, false, 2, "int16_t", "cm/s"),
    new MavLinkPacketField("ind_airspeed", "indAirspeed", 54, false, 2, "uint16_t", "cm/s"),
    new MavLinkPacketField("true_airspeed", "trueAirspeed", 56, false, 2, "uint16_t", "cm/s"),
    new MavLinkPacketField("xacc", "xacc", 58, false, 2, "int16_t", "mG"),
    new MavLinkPacketField("yacc", "yacc", 60, false, 2, "int16_t", "mG"),
    new MavLinkPacketField("zacc", "zacc", 62, false, 2, "int16_t", "mG"),
  ], (p) => HilStateQuaternion.decode(p))

  /// Timestamp (UNIX Epoch time or time since system boot). The receiving end can infer timestamp format
  /// (since 1.1.1970 or since system boot) by checking for the magnitude of the number.
  /// Units: us.
  public timeUsec: u64 = 0

  /// Vehicle attitude expressed as normalized quaternion in w, x, y, z order (with 1 0 0 0 being the
  /// null-rotation)
  public attitudeQuaternion: f32[] = []

  /// Body frame roll / phi angular speed
  /// Units: rad/s.
  public rollspeed: f32 = 0.0

  /// Body frame pitch / theta angular speed
  /// Units: rad/s.
  public pitchspeed: f32 = 0.0

  /// Body frame yaw / psi angular speed
  /// Units: rad/s.
  public yawspeed: f32 = 0.0

  /// Latitude
  /// Units: degE7.
  public lat: i32 = 0

  /// Longitude
  /// Units: degE7.
  public lon: i32 = 0

  /// Altitude
  /// Units: mm.
  public alt: i32 = 0

  /// Ground X Speed (Latitude)
  /// Units: cm/s.
  public vx: i16 = 0

  /// Ground Y Speed (Longitude)
  /// Units: cm/s.
  public vy: i16 = 0

  /// Ground Z Speed (Altitude)
  /// Units: cm/s.
  public vz: i16 = 0

  /// Indicated airspeed
  /// Units: cm/s.
  public indAirspeed: u16 = 0

  /// True airspeed
  /// Units: cm/s.
  public trueAirspeed: u16 = 0

  /// X acceleration
  /// Units: mG.
  public xacc: i16 = 0

  /// Y acceleration
  /// Units: mG.
  public yacc: i16 = 0

  /// Z acceleration
  /// Units: mG.
  public zacc: i16 = 0

  /// A HIL_STATE_QUATERNION from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): HilStateQuaternion {
    const m = new HilStateQuaternion()
    m.timeUsec = readU64(payload, 0)
    for (let i = 0; i < 4; i++) {
      m.attitudeQuaternion.push(readF32(payload, 8 + i * 4))
    }
    m.rollspeed = readF32(payload, 24)
    m.pitchspeed = readF32(payload, 28)
    m.yawspeed = readF32(payload, 32)
    m.lat = readI32(payload, 36)
    m.lon = readI32(payload, 40)
    m.alt = readI32(payload, 44)
    m.vx = readI16(payload, 48)
    m.vy = readI16(payload, 50)
    m.vz = readI16(payload, 52)
    m.indAirspeed = readU16(payload, 54)
    m.trueAirspeed = readU16(payload, 56)
    m.xacc = readI16(payload, 58)
    m.yacc = readI16(payload, 60)
    m.zacc = readI16(payload, 62)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    for (let i = 0; i < 4 && i < this.attitudeQuaternion.length; i++) {
      writeF32(into, at + 8 + i * 4, this.attitudeQuaternion[i])
    }
    writeF32(into, at + 24, this.rollspeed)
    writeF32(into, at + 28, this.pitchspeed)
    writeF32(into, at + 32, this.yawspeed)
    writeUint(into, at + 36, 4, this.lat as int)
    writeUint(into, at + 40, 4, this.lon as int)
    writeUint(into, at + 44, 4, this.alt as int)
    writeUint(into, at + 48, 2, this.vx as int)
    writeUint(into, at + 50, 2, this.vy as int)
    writeUint(into, at + 52, 2, this.vz as int)
    writeUint(into, at + 54, 2, this.indAirspeed as int)
    writeUint(into, at + 56, 2, this.trueAirspeed as int)
    writeUint(into, at + 58, 2, this.xacc as int)
    writeUint(into, at + 60, 2, this.yacc as int)
    writeUint(into, at + 62, 2, this.zacc as int)
  }

  public override info(): MessageInfo {
    HilStateQuaternion.INFO
  }
}

/// The RAW IMU readings for secondary 9DOF sensor setup. This message should contain the scaled values
/// to the described units
export class ScaledImu2 extends MavLinkData {
  public static readonly MSG_ID: int = 116
  public static readonly MSG_NAME: string = "SCALED_IMU2"
  public static readonly PAYLOAD_LENGTH: int = 24
  public static readonly MAGIC_NUMBER: int = 76
  public static readonly INFO: MessageInfo = new MessageInfo(116, "SCALED_IMU2", 24, 22, 76, [
    new MavLinkPacketField("time_boot_ms", "timeBootMs", 0, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("xacc", "xacc", 4, false, 2, "int16_t", "mG"),
    new MavLinkPacketField("yacc", "yacc", 6, false, 2, "int16_t", "mG"),
    new MavLinkPacketField("zacc", "zacc", 8, false, 2, "int16_t", "mG"),
    new MavLinkPacketField("xgyro", "xgyro", 10, false, 2, "int16_t", "mrad/s"),
    new MavLinkPacketField("ygyro", "ygyro", 12, false, 2, "int16_t", "mrad/s"),
    new MavLinkPacketField("zgyro", "zgyro", 14, false, 2, "int16_t", "mrad/s"),
    new MavLinkPacketField("xmag", "xmag", 16, false, 2, "int16_t", "mgauss"),
    new MavLinkPacketField("ymag", "ymag", 18, false, 2, "int16_t", "mgauss"),
    new MavLinkPacketField("zmag", "zmag", 20, false, 2, "int16_t", "mgauss"),
    new MavLinkPacketField("temperature", "temperature", 22, true, 2, "int16_t", "cdegC"),
  ], (p) => ScaledImu2.decode(p))

  /// Timestamp (time since system boot).
  /// Units: ms.
  public timeBootMs: u32 = 0

  /// X acceleration
  /// Units: mG.
  public xacc: i16 = 0

  /// Y acceleration
  /// Units: mG.
  public yacc: i16 = 0

  /// Z acceleration
  /// Units: mG.
  public zacc: i16 = 0

  /// Angular speed around X axis
  /// Units: mrad/s.
  public xgyro: i16 = 0

  /// Angular speed around Y axis
  /// Units: mrad/s.
  public ygyro: i16 = 0

  /// Angular speed around Z axis
  /// Units: mrad/s.
  public zgyro: i16 = 0

  /// X Magnetic field
  /// Units: mgauss.
  public xmag: i16 = 0

  /// Y Magnetic field
  /// Units: mgauss.
  public ymag: i16 = 0

  /// Z Magnetic field
  /// Units: mgauss.
  public zmag: i16 = 0

  /// Temperature, 0: IMU does not provide temperature values. If the IMU is at 0C it must send 1 (0.01C).
  /// Units: cdegC.
  public temperature: i16 = 0

  /// A SCALED_IMU2 from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): ScaledImu2 {
    const m = new ScaledImu2()
    m.timeBootMs = readU32(payload, 0)
    m.xacc = readI16(payload, 4)
    m.yacc = readI16(payload, 6)
    m.zacc = readI16(payload, 8)
    m.xgyro = readI16(payload, 10)
    m.ygyro = readI16(payload, 12)
    m.zgyro = readI16(payload, 14)
    m.xmag = readI16(payload, 16)
    m.ymag = readI16(payload, 18)
    m.zmag = readI16(payload, 20)
    m.temperature = readI16(payload, 22)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.timeBootMs as int)
    writeUint(into, at + 4, 2, this.xacc as int)
    writeUint(into, at + 6, 2, this.yacc as int)
    writeUint(into, at + 8, 2, this.zacc as int)
    writeUint(into, at + 10, 2, this.xgyro as int)
    writeUint(into, at + 12, 2, this.ygyro as int)
    writeUint(into, at + 14, 2, this.zgyro as int)
    writeUint(into, at + 16, 2, this.xmag as int)
    writeUint(into, at + 18, 2, this.ymag as int)
    writeUint(into, at + 20, 2, this.zmag as int)
    writeUint(into, at + 22, 2, this.temperature as int)
  }

  public override info(): MessageInfo {
    ScaledImu2.INFO
  }
}

/// Request a list of available logs. On some systems calling this may stop on-board logging until
/// LOG_REQUEST_END is called. If there are no log files available this request shall be answered with
/// one LOG_ENTRY message with id = 0 and num_logs = 0. LOG_ENTRY messages can start with id 1 or 0. The
/// ground station needs to be able to process either.
export class LogRequestList extends MavLinkData {
  public static readonly MSG_ID: int = 117
  public static readonly MSG_NAME: string = "LOG_REQUEST_LIST"
  public static readonly PAYLOAD_LENGTH: int = 6
  public static readonly MAGIC_NUMBER: int = 128
  public static readonly INFO: MessageInfo = new MessageInfo(117, "LOG_REQUEST_LIST", 6, 6, 128, [
    new MavLinkPacketField("start", "start", 0, false, 2, "uint16_t", ""),
    new MavLinkPacketField("end", "end", 2, false, 2, "uint16_t", ""),
    new MavLinkPacketField("target_system", "targetSystem", 4, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 5, false, 1, "uint8_t", ""),
  ], (p) => LogRequestList.decode(p))

  /// System ID
  public targetSystem: u8 = 0

  /// Component ID
  public targetComponent: u8 = 0

  /// First log id (0 for first available)
  public start: u16 = 0

  /// Last log id (0xffff for last available)
  public end: u16 = 0

  /// A LOG_REQUEST_LIST from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): LogRequestList {
    const m = new LogRequestList()
    m.start = readU16(payload, 0)
    m.end = readU16(payload, 2)
    m.targetSystem = readU8(payload, 4)
    m.targetComponent = readU8(payload, 5)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 2, this.start as int)
    writeUint(into, at + 2, 2, this.end as int)
    writeUint(into, at + 4, 1, this.targetSystem as int)
    writeUint(into, at + 5, 1, this.targetComponent as int)
  }

  public override info(): MessageInfo {
    LogRequestList.INFO
  }
}

/// Reply to LOG_REQUEST_LIST
export class LogEntry extends MavLinkData {
  public static readonly MSG_ID: int = 118
  public static readonly MSG_NAME: string = "LOG_ENTRY"
  public static readonly PAYLOAD_LENGTH: int = 14
  public static readonly MAGIC_NUMBER: int = 56
  public static readonly INFO: MessageInfo = new MessageInfo(118, "LOG_ENTRY", 14, 14, 56, [
    new MavLinkPacketField("time_utc", "timeUtc", 0, false, 4, "uint32_t", "s"),
    new MavLinkPacketField("size", "size", 4, false, 4, "uint32_t", "bytes"),
    new MavLinkPacketField("id", "id", 8, false, 2, "uint16_t", ""),
    new MavLinkPacketField("num_logs", "numLogs", 10, false, 2, "uint16_t", ""),
    new MavLinkPacketField("last_log_num", "lastLogNum", 12, false, 2, "uint16_t", ""),
  ], (p) => LogEntry.decode(p))

  /// Log id
  public id: u16 = 0

  /// Total number of logs
  public numLogs: u16 = 0

  /// High log number
  public lastLogNum: u16 = 0

  /// UTC timestamp of log since 1970, or 0 if not available
  /// Units: s.
  public timeUtc: u32 = 0

  /// Size of the log (may be approximate)
  /// Units: bytes.
  public size: u32 = 0

  /// A LOG_ENTRY from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): LogEntry {
    const m = new LogEntry()
    m.timeUtc = readU32(payload, 0)
    m.size = readU32(payload, 4)
    m.id = readU16(payload, 8)
    m.numLogs = readU16(payload, 10)
    m.lastLogNum = readU16(payload, 12)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.timeUtc as int)
    writeUint(into, at + 4, 4, this.size as int)
    writeUint(into, at + 8, 2, this.id as int)
    writeUint(into, at + 10, 2, this.numLogs as int)
    writeUint(into, at + 12, 2, this.lastLogNum as int)
  }

  public override info(): MessageInfo {
    LogEntry.INFO
  }
}

/// Request a chunk of a log
export class LogRequestData extends MavLinkData {
  public static readonly MSG_ID: int = 119
  public static readonly MSG_NAME: string = "LOG_REQUEST_DATA"
  public static readonly PAYLOAD_LENGTH: int = 12
  public static readonly MAGIC_NUMBER: int = 116
  public static readonly INFO: MessageInfo = new MessageInfo(119, "LOG_REQUEST_DATA", 12, 12, 116, [
    new MavLinkPacketField("ofs", "ofs", 0, false, 4, "uint32_t", ""),
    new MavLinkPacketField("count", "count", 4, false, 4, "uint32_t", "bytes"),
    new MavLinkPacketField("id", "id", 8, false, 2, "uint16_t", ""),
    new MavLinkPacketField("target_system", "targetSystem", 10, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 11, false, 1, "uint8_t", ""),
  ], (p) => LogRequestData.decode(p))

  /// System ID
  public targetSystem: u8 = 0

  /// Component ID
  public targetComponent: u8 = 0

  /// Log id (from LOG_ENTRY reply)
  public id: u16 = 0

  /// Offset into the log
  public ofs: u32 = 0

  /// Number of bytes
  /// Units: bytes.
  public count: u32 = 0

  /// A LOG_REQUEST_DATA from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): LogRequestData {
    const m = new LogRequestData()
    m.ofs = readU32(payload, 0)
    m.count = readU32(payload, 4)
    m.id = readU16(payload, 8)
    m.targetSystem = readU8(payload, 10)
    m.targetComponent = readU8(payload, 11)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.ofs as int)
    writeUint(into, at + 4, 4, this.count as int)
    writeUint(into, at + 8, 2, this.id as int)
    writeUint(into, at + 10, 1, this.targetSystem as int)
    writeUint(into, at + 11, 1, this.targetComponent as int)
  }

  public override info(): MessageInfo {
    LogRequestData.INFO
  }
}

/// Reply to LOG_REQUEST_DATA
export class LogData extends MavLinkData {
  public static readonly MSG_ID: int = 120
  public static readonly MSG_NAME: string = "LOG_DATA"
  public static readonly PAYLOAD_LENGTH: int = 97
  public static readonly MAGIC_NUMBER: int = 134
  public static readonly INFO: MessageInfo = new MessageInfo(120, "LOG_DATA", 97, 97, 134, [
    new MavLinkPacketField("ofs", "ofs", 0, false, 4, "uint32_t", ""),
    new MavLinkPacketField("id", "id", 4, false, 2, "uint16_t", ""),
    new MavLinkPacketField("count", "count", 6, false, 1, "uint8_t", "bytes"),
    new MavLinkPacketField("data", "data", 7, false, 1, "uint8_t[]", "", 90),
  ], (p) => LogData.decode(p))

  /// Log id (from LOG_ENTRY reply)
  public id: u16 = 0

  /// Offset into the log
  public ofs: u32 = 0

  /// Number of bytes (zero for end of log)
  /// Units: bytes.
  public count: u8 = 0

  /// log data
  public data: u8[] = []

  /// A LOG_DATA from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): LogData {
    const m = new LogData()
    m.ofs = readU32(payload, 0)
    m.id = readU16(payload, 4)
    m.count = readU8(payload, 6)
    for (let i = 0; i < 90; i++) {
      m.data.push(readU8(payload, 7 + i * 1))
    }
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.ofs as int)
    writeUint(into, at + 4, 2, this.id as int)
    writeUint(into, at + 6, 1, this.count as int)
    for (let i = 0; i < 90 && i < this.data.length; i++) {
      writeUint(into, at + 7 + i * 1, 1, this.data[i] as int)
    }
  }

  public override info(): MessageInfo {
    LogData.INFO
  }
}

/// Erase all logs
export class LogErase extends MavLinkData {
  public static readonly MSG_ID: int = 121
