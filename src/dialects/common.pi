/// Navigational status of AIS vessel, enum duplicated from AIS standard,
/// https://gpsd.gitlab.io/gpsd/AIVDM.html
export class AisNavStatus {
  /// Under way using engine.
  public static readonly UNDER_WAY: int = 0

  public static readonly ANCHORED: int = 1

  public static readonly UN_COMMANDED: int = 2

  public static readonly RESTRICTED_MANOEUVERABILITY: int = 3

  public static readonly DRAUGHT_CONSTRAINED: int = 4

  public static readonly MOORED: int = 5

  public static readonly AGROUND: int = 6

  public static readonly FISHING: int = 7

  public static readonly SAILING: int = 8

  public static readonly RESERVED_HSC: int = 9

  public static readonly RESERVED_WIG: int = 10

  public static readonly RESERVED_1: int = 11

  public static readonly RESERVED_2: int = 12

  public static readonly RESERVED_3: int = 13

  /// Search And Rescue Transponder.
  public static readonly AIS_SART: int = 14

  /// Not available (default).
  public static readonly UNKNOWN: int = 15

  /// The name of `value` (`UNDER_WAY` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "UNDER_WAY",
      1 => "ANCHORED",
      2 => "UN_COMMANDED",
      3 => "RESTRICTED_MANOEUVERABILITY",
      4 => "DRAUGHT_CONSTRAINED",
      5 => "MOORED",
      6 => "AGROUND",
      7 => "FISHING",
      8 => "SAILING",
      9 => "RESERVED_HSC",
      10 => "RESERVED_WIG",
      11 => "RESERVED_1",
      12 => "RESERVED_2",
      13 => "RESERVED_3",
      14 => "AIS_SART",
      15 => "UNKNOWN",
      _ => null,
    }
  }
}

/// These flags are used in the AIS_VESSEL.fields bitmask to indicate validity of data in the other
/// message fields. When set, the data is valid.
export class AisFlags {
  /// 1 = Position accuracy less than 10m, 0 = position accuracy greater than 10m.
  public static readonly POSITION_ACCURACY: int = 1

  public static readonly VALID_COG: int = 2

  public static readonly VALID_VELOCITY: int = 4

  /// 1 = Velocity over 52.5765m/s (102.2 knots)
  public static readonly HIGH_VELOCITY: int = 8

  public static readonly VALID_TURN_RATE: int = 16

  /// Only the sign of the returned turn rate value is valid, either greater than 5deg/30s or less than
  /// -5deg/30s
  public static readonly TURN_RATE_SIGN_ONLY: int = 32

  public static readonly VALID_DIMENSIONS: int = 64

  /// Distance to bow is larger than 511m
  public static readonly LARGE_BOW_DIMENSION: int = 128

  /// Distance to stern is larger than 511m
  public static readonly LARGE_STERN_DIMENSION: int = 256

  /// Distance to port side is larger than 63m
  public static readonly LARGE_PORT_DIMENSION: int = 512

  /// Distance to starboard side is larger than 63m
  public static readonly LARGE_STARBOARD_DIMENSION: int = 1024

  public static readonly VALID_CALLSIGN: int = 2048

  public static readonly VALID_NAME: int = 4096

  /// The name of `value` (`POSITION_ACCURACY` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      1 => "POSITION_ACCURACY",
      2 => "VALID_COG",
      4 => "VALID_VELOCITY",
      8 => "HIGH_VELOCITY",
      16 => "VALID_TURN_RATE",
      32 => "TURN_RATE_SIGN_ONLY",
      64 => "VALID_DIMENSIONS",
      128 => "LARGE_BOW_DIMENSION",
      256 => "LARGE_STERN_DIMENSION",
      512 => "LARGE_PORT_DIMENSION",
      1024 => "LARGE_STARBOARD_DIMENSION",
      2048 => "VALID_CALLSIGN",
      4096 => "VALID_NAME",
      _ => null,
    }
  }
}

