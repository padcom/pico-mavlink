/// Contains the home position. The home position is the default position that the system will return to
/// and land on. The position must be set automatically by the system during the takeoff, and may also
/// be explicitly set using MAV_CMD_DO_SET_HOME. The global and local positions encode the position in
/// the respective coordinate frames, while the q parameter encodes the orientation of the surface.
/// Under normal conditions it describes the heading and terrain slope, which can be used by the
/// aircraft to adjust the approach. The approach 3D vector describes the point to which the system
/// should fly in normal flight mode and then perform a landing sequence along the vector. Note: this
/// message can be requested by sending the MAV_CMD_REQUEST_MESSAGE with param1=242 (or the deprecated
/// MAV_CMD_GET_HOME_POSITION command).
export class HomePosition extends MavLinkData {
  public static readonly MSG_ID: int = 242
  public static readonly MSG_NAME: string = "HOME_POSITION"
  public static readonly PAYLOAD_LENGTH: int = 60
  public static readonly MAGIC_NUMBER: int = 104
  public static readonly INFO: MessageInfo = new MessageInfo(242, "HOME_POSITION", 60, 52, 104, [
    new MavLinkPacketField("latitude", "latitude", 0, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("longitude", "longitude", 4, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("altitude", "altitude", 8, false, 4, "int32_t", "mm"),
    new MavLinkPacketField("x", "x", 12, false, 4, "float", "m"),
    new MavLinkPacketField("y", "y", 16, false, 4, "float", "m"),
    new MavLinkPacketField("z", "z", 20, false, 4, "float", "m"),
    new MavLinkPacketField("q", "q", 24, false, 4, "float[]", "", 4),
    new MavLinkPacketField("approach_x", "approachX", 40, false, 4, "float", "m"),
    new MavLinkPacketField("approach_y", "approachY", 44, false, 4, "float", "m"),
    new MavLinkPacketField("approach_z", "approachZ", 48, false, 4, "float", "m"),
    new MavLinkPacketField("time_usec", "timeUsec", 52, true, 8, "uint64_t", "us"),
  ], (p) => HomePosition.decode(p))

  /// Latitude (WGS84)
  /// Units: degE7.
  public latitude: i32 = 0

  /// Longitude (WGS84)
  /// Units: degE7.
  public longitude: i32 = 0

  /// Altitude (MSL). Positive for up.
  /// Units: mm.
  public altitude: i32 = 0

  /// Local X position of this position in the local coordinate frame (NED)
  /// Units: m.
  public x: f32 = 0.0

  /// Local Y position of this position in the local coordinate frame (NED)
  /// Units: m.
  public y: f32 = 0.0

  /// Local Z position of this position in the local coordinate frame (NED: positive "down")
  /// Units: m.
  public z: f32 = 0.0

  /// Quaternion indicating world-to-surface-normal and heading transformation of the takeoff position.
  /// Used to indicate the heading and slope of the ground. All fields should be set to NaN if an accurate
  /// quaternion for both heading and surface slope cannot be supplied.
  public q: f32[] = []

  /// Local X position of the end of the approach vector. Multicopters should set this position based on
  /// their takeoff path. Grass-landing fixed wing aircraft should set it the same way as multicopters.
  /// Runway-landing fixed wing aircraft should set it to the opposite direction of the takeoff, assuming
  /// the takeoff happened from the threshold / touchdown zone.
  /// Units: m.
  public approachX: f32 = 0.0

  /// Local Y position of the end of the approach vector. Multicopters should set this position based on
  /// their takeoff path. Grass-landing fixed wing aircraft should set it the same way as multicopters.
  /// Runway-landing fixed wing aircraft should set it to the opposite direction of the takeoff, assuming
  /// the takeoff happened from the threshold / touchdown zone.
  /// Units: m.
  public approachY: f32 = 0.0

  /// Local Z position of the end of the approach vector. Multicopters should set this position based on
  /// their takeoff path. Grass-landing fixed wing aircraft should set it the same way as multicopters.
  /// Runway-landing fixed wing aircraft should set it to the opposite direction of the takeoff, assuming
  /// the takeoff happened from the threshold / touchdown zone.
  /// Units: m.
  public approachZ: f32 = 0.0

  /// Timestamp (UNIX Epoch time or time since system boot). The receiving end can infer timestamp format
  /// (since 1.1.1970 or since system boot) by checking for the magnitude of the number.
  /// Units: us.
  public timeUsec: u64 = 0

  /// A HOME_POSITION from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): HomePosition {
    const m = new HomePosition()
    m.latitude = readI32(payload, 0)
    m.longitude = readI32(payload, 4)
    m.altitude = readI32(payload, 8)
    m.x = readF32(payload, 12)
    m.y = readF32(payload, 16)
    m.z = readF32(payload, 20)
    for (let i = 0; i < 4; i++) {
      m.q.push(readF32(payload, 24 + i * 4))
    }
    m.approachX = readF32(payload, 40)
    m.approachY = readF32(payload, 44)
    m.approachZ = readF32(payload, 48)
    m.timeUsec = readU64(payload, 52)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.latitude as int)
    writeUint(into, at + 4, 4, this.longitude as int)
    writeUint(into, at + 8, 4, this.altitude as int)
    writeF32(into, at + 12, this.x)
    writeF32(into, at + 16, this.y)
    writeF32(into, at + 20, this.z)
    for (let i = 0; i < 4 && i < this.q.length; i++) {
      writeF32(into, at + 24 + i * 4, this.q[i])
    }
    writeF32(into, at + 40, this.approachX)
    writeF32(into, at + 44, this.approachY)
    writeF32(into, at + 48, this.approachZ)
    writeU64(into, at + 52, this.timeUsec)
  }

  public override info(): MessageInfo {
    HomePosition.INFO
  }
}

/// Sets the home position. The home position is the default position that the system will return to and
