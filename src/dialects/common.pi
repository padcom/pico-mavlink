/// The attitude in the aeronautical frame (right-handed, Z-down, X-front, Y-right), expressed as
/// quaternion. Quaternion order is w, x, y, z and a zero rotation would be expressed as (1 0 0 0).
export class AttitudeQuaternionCov extends MavLinkData {
  public static readonly MSG_ID: int = 61
  public static readonly MSG_NAME: string = "ATTITUDE_QUATERNION_COV"
  public static readonly PAYLOAD_LENGTH: int = 72
  public static readonly MAGIC_NUMBER: int = 167
  public static readonly INFO: MessageInfo = new MessageInfo(61, "ATTITUDE_QUATERNION_COV", 72, 72, 167, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("q", "q", 8, false, 4, "float[]", "", 4),
    new MavLinkPacketField("rollspeed", "rollspeed", 24, false, 4, "float", "rad/s"),
    new MavLinkPacketField("pitchspeed", "pitchspeed", 28, false, 4, "float", "rad/s"),
    new MavLinkPacketField("yawspeed", "yawspeed", 32, false, 4, "float", "rad/s"),
    new MavLinkPacketField("covariance", "covariance", 36, false, 4, "float[]", "", 9),
  ], (p) => AttitudeQuaternionCov.decode(p))

  /// Timestamp (UNIX Epoch time or time since system boot). The receiving end can infer timestamp format
  /// (since 1.1.1970 or since system boot) by checking for the magnitude of the number.
  /// Units: us.
  public timeUsec: u64 = 0

  /// Quaternion components, w, x, y, z (1 0 0 0 is the null-rotation)
  public q: f32[] = []

  /// Roll angular speed
  /// Units: rad/s.
  public rollspeed: f32 = 0.0

  /// Pitch angular speed
  /// Units: rad/s.
  public pitchspeed: f32 = 0.0

  /// Yaw angular speed
  /// Units: rad/s.
  public yawspeed: f32 = 0.0

  /// Row-major representation of a 3x3 attitude covariance matrix (states: roll, pitch, yaw; first three
  /// entries are the first ROW, next three entries are the second row, etc.). If unknown, assign NaN
  /// value to first element in the array.
  public covariance: f32[] = []

  /// A ATTITUDE_QUATERNION_COV from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): AttitudeQuaternionCov {
    const m = new AttitudeQuaternionCov()
    m.timeUsec = readU64(payload, 0)
    for (let i = 0; i < 4; i++) {
      m.q.push(readF32(payload, 8 + i * 4))
    }
    m.rollspeed = readF32(payload, 24)
    m.pitchspeed = readF32(payload, 28)
    m.yawspeed = readF32(payload, 32)
    for (let i = 0; i < 9; i++) {
      m.covariance.push(readF32(payload, 36 + i * 4))
    }
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    for (let i = 0; i < 4 && i < this.q.length; i++) {
      writeF32(into, at + 8 + i * 4, this.q[i])
    }
    writeF32(into, at + 24, this.rollspeed)
    writeF32(into, at + 28, this.pitchspeed)
    writeF32(into, at + 32, this.yawspeed)
    for (let i = 0; i < 9 && i < this.covariance.length; i++) {
      writeF32(into, at + 36 + i * 4, this.covariance[i])
    }
  }

  public override info(): MessageInfo {
    AttitudeQuaternionCov.INFO
  }
}

/// The state of the navigation and position controller.
export class NavControllerOutput extends MavLinkData {
  public static readonly MSG_ID: int = 62
  public static readonly MSG_NAME: string = "NAV_CONTROLLER_OUTPUT"
  public static readonly PAYLOAD_LENGTH: int = 26
  public static readonly MAGIC_NUMBER: int = 183
  public static readonly INFO: MessageInfo = new MessageInfo(62, "NAV_CONTROLLER_OUTPUT", 26, 26, 183, [
    new MavLinkPacketField("nav_roll", "navRoll", 0, false, 4, "float", "deg"),
    new MavLinkPacketField("nav_pitch", "navPitch", 4, false, 4, "float", "deg"),
    new MavLinkPacketField("alt_error", "altError", 8, false, 4, "float", "m"),
    new MavLinkPacketField("aspd_error", "aspdError", 12, false, 4, "float", "m/s"),
    new MavLinkPacketField("xtrack_error", "xtrackError", 16, false, 4, "float", "m"),
    new MavLinkPacketField("nav_bearing", "navBearing", 20, false, 2, "int16_t", "deg"),
    new MavLinkPacketField("target_bearing", "targetBearing", 22, false, 2, "int16_t", "deg"),
    new MavLinkPacketField("wp_dist", "wpDist", 24, false, 2, "uint16_t", "m"),
  ], (p) => NavControllerOutput.decode(p))

  /// Current desired roll
  /// Units: deg.
  public navRoll: f32 = 0.0

  /// Current desired pitch
  /// Units: deg.
  public navPitch: f32 = 0.0

  /// Current desired heading
  /// Units: deg.
  public navBearing: i16 = 0

  /// Bearing to current waypoint/target
  /// Units: deg.
  public targetBearing: i16 = 0

  /// Distance to active waypoint
  /// Units: m.
  public wpDist: u16 = 0

  /// Current altitude error
  /// Units: m.
  public altError: f32 = 0.0

  /// Current airspeed error
  /// Units: m/s.
  public aspdError: f32 = 0.0

  /// Current crosstrack error on x-y plane
  /// Units: m.
  public xtrackError: f32 = 0.0

  /// A NAV_CONTROLLER_OUTPUT from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): NavControllerOutput {
    const m = new NavControllerOutput()
    m.navRoll = readF32(payload, 0)
    m.navPitch = readF32(payload, 4)
    m.altError = readF32(payload, 8)
    m.aspdError = readF32(payload, 12)
    m.xtrackError = readF32(payload, 16)
    m.navBearing = readI16(payload, 20)
    m.targetBearing = readI16(payload, 22)
    m.wpDist = readU16(payload, 24)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeF32(into, at + 0, this.navRoll)
    writeF32(into, at + 4, this.navPitch)
    writeF32(into, at + 8, this.altError)
    writeF32(into, at + 12, this.aspdError)
    writeF32(into, at + 16, this.xtrackError)
    writeUint(into, at + 20, 2, this.navBearing as int)
    writeUint(into, at + 22, 2, this.targetBearing as int)
    writeUint(into, at + 24, 2, this.wpDist as int)
  }

  public override info(): MessageInfo {
    NavControllerOutput.INFO
  }
}

/// The filtered global position (e.g. fused GPS and accelerometers). The position is in GPS-frame
/// (right-handed, Z-up). It is designed as scaled integer message since the resolution of float is not
/// sufficient. NOTE: This message is intended for onboard networks / companion computers and
/// higher-bandwidth links and optimized for accuracy and completeness. Please use the
/// GLOBAL_POSITION_INT message for a minimal subset.
export class GlobalPositionIntCov extends MavLinkData {
  public static readonly MSG_ID: int = 63
  public static readonly MSG_NAME: string = "GLOBAL_POSITION_INT_COV"
  public static readonly PAYLOAD_LENGTH: int = 181
  public static readonly MAGIC_NUMBER: int = 119
  public static readonly INFO: MessageInfo = new MessageInfo(63, "GLOBAL_POSITION_INT_COV", 181, 181, 119, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("lat", "lat", 8, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("lon", "lon", 12, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("alt", "alt", 16, false, 4, "int32_t", "mm"),
    new MavLinkPacketField("relative_alt", "relativeAlt", 20, false, 4, "int32_t", "mm"),
    new MavLinkPacketField("vx", "vx", 24, false, 4, "float", "m/s"),
    new MavLinkPacketField("vy", "vy", 28, false, 4, "float", "m/s"),
    new MavLinkPacketField("vz", "vz", 32, false, 4, "float", "m/s"),
    new MavLinkPacketField("covariance", "covariance", 36, false, 4, "float[]", "", 36),
    new MavLinkPacketField("estimator_type", "estimatorType", 180, false, 1, "uint8_t", ""),
  ], (p) => GlobalPositionIntCov.decode(p))

  /// Timestamp (UNIX Epoch time or time since system boot). The receiving end can infer timestamp format
  /// (since 1.1.1970 or since system boot) by checking for the magnitude of the number.
  /// Units: us.
  public timeUsec: u64 = 0

  /// Class id of the estimator this estimate originated from.
  /// Values: `MavEstimatorType`.
  public estimatorType: u8 = 0

  /// Latitude
  /// Units: degE7.
  public lat: i32 = 0

  /// Longitude
  /// Units: degE7.
  public lon: i32 = 0

  /// Altitude in meters above MSL
  /// Units: mm.
  public alt: i32 = 0

  /// Altitude above ground
  /// Units: mm.
  public relativeAlt: i32 = 0

  /// Ground X Speed (Latitude)
  /// Units: m/s.
  public vx: f32 = 0.0

  /// Ground Y Speed (Longitude)
  /// Units: m/s.
  public vy: f32 = 0.0

  /// Ground Z Speed (Altitude)
  /// Units: m/s.
  public vz: f32 = 0.0

  /// Row-major representation of a 6x6 position and velocity 6x6 cross-covariance matrix (states: lat,
  /// lon, alt, vx, vy, vz; first six entries are the first ROW, next six entries are the second row,
  /// etc.). If unknown, assign NaN value to first element in the array.
  public covariance: f32[] = []

  /// A GLOBAL_POSITION_INT_COV from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): GlobalPositionIntCov {
    const m = new GlobalPositionIntCov()
    m.timeUsec = readU64(payload, 0)
    m.lat = readI32(payload, 8)
    m.lon = readI32(payload, 12)
    m.alt = readI32(payload, 16)
    m.relativeAlt = readI32(payload, 20)
    m.vx = readF32(payload, 24)
    m.vy = readF32(payload, 28)
    m.vz = readF32(payload, 32)
    for (let i = 0; i < 36; i++) {
      m.covariance.push(readF32(payload, 36 + i * 4))
    }
    m.estimatorType = readU8(payload, 180)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    writeUint(into, at + 8, 4, this.lat as int)
    writeUint(into, at + 12, 4, this.lon as int)
    writeUint(into, at + 16, 4, this.alt as int)
    writeUint(into, at + 20, 4, this.relativeAlt as int)
    writeF32(into, at + 24, this.vx)
    writeF32(into, at + 28, this.vy)
    writeF32(into, at + 32, this.vz)
    for (let i = 0; i < 36 && i < this.covariance.length; i++) {
      writeF32(into, at + 36 + i * 4, this.covariance[i])
    }
    writeUint(into, at + 180, 1, this.estimatorType as int)
  }

  public override info(): MessageInfo {
    GlobalPositionIntCov.INFO
  }
}

/// The filtered local position (e.g. fused computer vision and accelerometers). Coordinate frame is
/// right-handed, Z-axis down (aeronautical frame, NED / north-east-down convention)
export class LocalPositionNedCov extends MavLinkData {
