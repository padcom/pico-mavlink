    const m = new MissionAck()
    m.targetSystem = readU8(payload, 0)
    m.targetComponent = readU8(payload, 1)
    m.type = readU8(payload, 2)
    m.missionType = readU8(payload, 3)
    m.opaqueId = readU32(payload, 4)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 1, this.targetSystem as int)
    writeUint(into, at + 1, 1, this.targetComponent as int)
    writeUint(into, at + 2, 1, this.type as int)
    writeUint(into, at + 3, 1, this.missionType as int)
    writeUint(into, at + 4, 4, this.opaqueId as int)
  }

  public override info(): MessageInfo {
    MissionAck.INFO
  }
}

/// Sets the GPS coordinates of the vehicle local origin (0,0,0) position. Vehicle should emit
/// GPS_GLOBAL_ORIGIN irrespective of whether the origin is changed. This enables transform between the
/// local coordinate frame and the global (GPS) coordinate frame, which may be necessary when (for
/// example) indoor and outdoor settings are connected and the MAV should move from in- to outdoor.
export class SetGpsGlobalOrigin extends MavLinkData {
  public static readonly MSG_ID: int = 48
  public static readonly MSG_NAME: string = "SET_GPS_GLOBAL_ORIGIN"
  public static readonly PAYLOAD_LENGTH: int = 21
  public static readonly MAGIC_NUMBER: int = 41
  public static readonly INFO: MessageInfo = new MessageInfo(48, "SET_GPS_GLOBAL_ORIGIN", 21, 13, 41, [
    new MavLinkPacketField("latitude", "latitude", 0, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("longitude", "longitude", 4, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("altitude", "altitude", 8, false, 4, "int32_t", "mm"),
    new MavLinkPacketField("target_system", "targetSystem", 12, false, 1, "uint8_t", ""),
    new MavLinkPacketField("time_usec", "timeUsec", 13, true, 8, "uint64_t", "us"),
  ], (p) => SetGpsGlobalOrigin.decode(p))

  /// System ID
  public targetSystem: u8 = 0

  /// Latitude (WGS84)
  /// Units: degE7.
  public latitude: i32 = 0

  /// Longitude (WGS84)
  /// Units: degE7.
  public longitude: i32 = 0

  /// Altitude (MSL). Positive for up.
  /// Units: mm.
  public altitude: i32 = 0

  /// Timestamp (UNIX Epoch time or time since system boot). The receiving end can infer timestamp format
  /// (since 1.1.1970 or since system boot) by checking for the magnitude of the number.
  /// Units: us.
  public timeUsec: u64 = 0

  /// A SET_GPS_GLOBAL_ORIGIN from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): SetGpsGlobalOrigin {
    const m = new SetGpsGlobalOrigin()
    m.latitude = readI32(payload, 0)
    m.longitude = readI32(payload, 4)
    m.altitude = readI32(payload, 8)
    m.targetSystem = readU8(payload, 12)
    m.timeUsec = readU64(payload, 13)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.latitude as int)
    writeUint(into, at + 4, 4, this.longitude as int)
    writeUint(into, at + 8, 4, this.altitude as int)
    writeUint(into, at + 12, 1, this.targetSystem as int)
    writeU64(into, at + 13, this.timeUsec)
  }

  public override info(): MessageInfo {
    SetGpsGlobalOrigin.INFO
  }
}

