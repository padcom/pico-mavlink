    writeF32(into, at + 4, this.pitch)
    writeF32(into, at + 8, this.yaw)
    writeF32(into, at + 12, this.pitchRate)
    writeF32(into, at + 16, this.yawRate)
    writeUint(into, at + 20, 1, this.targetSystem as int)
