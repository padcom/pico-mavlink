/// The current system altitude.
export class Altitude extends MavLinkData {
  public static readonly MSG_ID: int = 141
  public static readonly MSG_NAME: string = "ALTITUDE"
  public static readonly PAYLOAD_LENGTH: int = 32
  public static readonly MAGIC_NUMBER: int = 47
  public static readonly INFO: MessageInfo = new MessageInfo(141, "ALTITUDE", 32, 32, 47, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("altitude_monotonic", "altitudeMonotonic", 8, false, 4, "float", "m"),
    new MavLinkPacketField("altitude_amsl", "altitudeAmsl", 12, false, 4, "float", "m"),
    new MavLinkPacketField("altitude_local", "altitudeLocal", 16, false, 4, "float", "m"),
    new MavLinkPacketField("altitude_relative", "altitudeRelative", 20, false, 4, "float", "m"),
    new MavLinkPacketField("altitude_terrain", "altitudeTerrain", 24, false, 4, "float", "m"),
    new MavLinkPacketField("bottom_clearance", "bottomClearance", 28, false, 4, "float", "m"),
  ], (p) => Altitude.decode(p))

  /// Timestamp (UNIX Epoch time or time since system boot). The receiving end can infer timestamp format
  /// (since 1.1.1970 or since system boot) by checking for the magnitude of the number.
  /// Units: us.
  public timeUsec: u64 = 0

  /// This altitude measure is initialized on system boot and monotonic (it is never reset, but represents
  /// the local altitude change). The only guarantee on this field is that it will never be reset and is
  /// consistent within a flight. The recommended value for this field is the uncorrected barometric
  /// altitude at boot time. This altitude will also drift and vary between flights.
  /// Units: m.
  public altitudeMonotonic: f32 = 0.0

  /// This altitude measure is strictly above mean sea level and might be non-monotonic (it might reset on
  /// events like GPS lock or when a new QNH value is set). It should be the altitude to which global
  /// altitude waypoints are compared to. Note that it is *not* the GPS altitude, however, most GPS
  /// modules already output MSL by default and not the WGS84 altitude.
  /// Units: m.
  public altitudeAmsl: f32 = 0.0

  /// This is the local altitude in the local coordinate frame. It is not the altitude above home, but in
  /// reference to the coordinate origin (0, 0, 0). It is up-positive.
  /// Units: m.
  public altitudeLocal: f32 = 0.0

  /// This is the altitude above the home position. It resets on each change of the current home position.
  /// Units: m.
  public altitudeRelative: f32 = 0.0

  /// This is the altitude above terrain. It might be fed by a terrain database or an altimeter. Values
  /// smaller than -1000 should be interpreted as unknown.
  /// Units: m.
  public altitudeTerrain: f32 = 0.0

  /// This is not the altitude, but the clear space below the system according to the fused clearance
  /// estimate. It generally should max out at the maximum range of e.g. the laser altimeter. It is
  /// generally a moving target. A negative value indicates no measurement available.
  /// Units: m.
  public bottomClearance: f32 = 0.0

  /// A ALTITUDE from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): Altitude {
    const m = new Altitude()
    m.timeUsec = readU64(payload, 0)
    m.altitudeMonotonic = readF32(payload, 8)
    m.altitudeAmsl = readF32(payload, 12)
    m.altitudeLocal = readF32(payload, 16)
    m.altitudeRelative = readF32(payload, 20)
    m.altitudeTerrain = readF32(payload, 24)
    m.bottomClearance = readF32(payload, 28)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    writeF32(into, at + 8, this.altitudeMonotonic)
    writeF32(into, at + 12, this.altitudeAmsl)
    writeF32(into, at + 16, this.altitudeLocal)
    writeF32(into, at + 20, this.altitudeRelative)
    writeF32(into, at + 24, this.altitudeTerrain)
    writeF32(into, at + 28, this.bottomClearance)
  }

  public override info(): MessageInfo {
    Altitude.INFO
  }
}

/// The autopilot is requesting a resource (file, binary, other type of data)
export class ResourceRequest extends MavLinkData {
  public static readonly MSG_ID: int = 142
  public static readonly MSG_NAME: string = "RESOURCE_REQUEST"
  public static readonly PAYLOAD_LENGTH: int = 243
  public static readonly MAGIC_NUMBER: int = 72
  public static readonly INFO: MessageInfo = new MessageInfo(142, "RESOURCE_REQUEST", 243, 243, 72, [
    new MavLinkPacketField("request_id", "requestId", 0, false, 1, "uint8_t", ""),
    new MavLinkPacketField("uri_type", "uriType", 1, false, 1, "uint8_t", ""),
    new MavLinkPacketField("uri", "uri", 2, false, 1, "uint8_t[]", "", 120),
    new MavLinkPacketField("transfer_type", "transferType", 122, false, 1, "uint8_t", ""),
    new MavLinkPacketField("storage", "storage", 123, false, 1, "uint8_t[]", "", 120),
  ], (p) => ResourceRequest.decode(p))

  /// Request ID. This ID should be reused when sending back URI contents
  public requestId: u8 = 0

  /// The type of requested URI. 0 = a file via URL. 1 = a UAVCAN binary
  public uriType: u8 = 0

  /// The requested unique resource identifier (URI). It is not necessarily a straight domain name
  /// (depends on the URI type enum)
  public uri: u8[] = []

  /// The way the autopilot wants to receive the URI. 0 = MAVLink FTP. 1 = binary stream.
  public transferType: u8 = 0

  /// The storage path the autopilot wants the URI to be stored in. Will only be valid if the
  /// transfer_type has a storage associated (e.g. MAVLink FTP).
  public storage: u8[] = []

  /// A RESOURCE_REQUEST from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): ResourceRequest {
    const m = new ResourceRequest()
    m.requestId = readU8(payload, 0)
    m.uriType = readU8(payload, 1)
    for (let i = 0; i < 120; i++) {
      m.uri.push(readU8(payload, 2 + i * 1))
    }
    m.transferType = readU8(payload, 122)
    for (let i = 0; i < 120; i++) {
      m.storage.push(readU8(payload, 123 + i * 1))
    }
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 1, this.requestId as int)
    writeUint(into, at + 1, 1, this.uriType as int)
    for (let i = 0; i < 120 && i < this.uri.length; i++) {
      writeUint(into, at + 2 + i * 1, 1, this.uri[i] as int)
    }
    writeUint(into, at + 122, 1, this.transferType as int)
    for (let i = 0; i < 120 && i < this.storage.length; i++) {
      writeUint(into, at + 123 + i * 1, 1, this.storage[i] as int)
    }
  }

  public override info(): MessageInfo {
    ResourceRequest.INFO
  }
}

/// Barometer readings for 3rd barometer
export class ScaledPressure3 extends MavLinkData {
  public static readonly MSG_ID: int = 143
  public static readonly MSG_NAME: string = "SCALED_PRESSURE3"
  public static readonly PAYLOAD_LENGTH: int = 16
  public static readonly MAGIC_NUMBER: int = 131
  public static readonly INFO: MessageInfo = new MessageInfo(143, "SCALED_PRESSURE3", 16, 14, 131, [
    new MavLinkPacketField("time_boot_ms", "timeBootMs", 0, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("press_abs", "pressAbs", 4, false, 4, "float", "hPa"),
    new MavLinkPacketField("press_diff", "pressDiff", 8, false, 4, "float", "hPa"),
    new MavLinkPacketField("temperature", "temperature", 12, false, 2, "int16_t", "cdegC"),
    new MavLinkPacketField("temperature_press_diff", "temperaturePressDiff", 14, true, 2, "int16_t", "cdegC"),
  ], (p) => ScaledPressure3.decode(p))

  /// Timestamp (time since system boot).
  /// Units: ms.
  public timeBootMs: u32 = 0

  /// Absolute pressure
  /// Units: hPa.
  public pressAbs: f32 = 0.0

  /// Differential pressure
  /// Units: hPa.
  public pressDiff: f32 = 0.0

  /// Absolute pressure temperature
  /// Units: cdegC.
  public temperature: i16 = 0

  /// Differential pressure temperature (0, if not available). Report values of 0 (or 1) as 1 cdegC.
  /// Units: cdegC.
  public temperaturePressDiff: i16 = 0

  /// A SCALED_PRESSURE3 from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): ScaledPressure3 {
    const m = new ScaledPressure3()
    m.timeBootMs = readU32(payload, 0)
    m.pressAbs = readF32(payload, 4)
    m.pressDiff = readF32(payload, 8)
    m.temperature = readI16(payload, 12)
    m.temperaturePressDiff = readI16(payload, 14)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.timeBootMs as int)
    writeF32(into, at + 4, this.pressAbs)
    writeF32(into, at + 8, this.pressDiff)
    writeUint(into, at + 12, 2, this.temperature as int)
    writeUint(into, at + 14, 2, this.temperaturePressDiff as int)
  }

  public override info(): MessageInfo {
    ScaledPressure3.INFO
  }
}

/// Current motion information from a designated system
export class FollowTarget extends MavLinkData {
  public static readonly MSG_ID: int = 144
  public static readonly MSG_NAME: string = "FOLLOW_TARGET"
  public static readonly PAYLOAD_LENGTH: int = 93
  public static readonly MAGIC_NUMBER: int = 127
  public static readonly INFO: MessageInfo = new MessageInfo(144, "FOLLOW_TARGET", 93, 93, 127, [
    new MavLinkPacketField("timestamp", "timestamp", 0, false, 8, "uint64_t", "ms"),
    new MavLinkPacketField("custom_state", "customState", 8, false, 8, "uint64_t", ""),
    new MavLinkPacketField("lat", "lat", 16, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("lon", "lon", 20, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("alt", "alt", 24, false, 4, "float", "m"),
    new MavLinkPacketField("vel", "vel", 28, false, 4, "float[]", "m/s", 3),
    new MavLinkPacketField("acc", "acc", 40, false, 4, "float[]", "m/s/s", 3),
    new MavLinkPacketField("attitude_q", "attitudeQ", 52, false, 4, "float[]", "", 4),
    new MavLinkPacketField("rates", "rates", 68, false, 4, "float[]", "", 3),
    new MavLinkPacketField("position_cov", "positionCov", 80, false, 4, "float[]", "", 3),
    new MavLinkPacketField("est_capabilities", "estCapabilities", 92, false, 1, "uint8_t", ""),
  ], (p) => FollowTarget.decode(p))

  /// Timestamp (time since system boot).
  /// Units: ms.
  public timestamp: u64 = 0

  /// bit positions for tracker reporting capabilities (POS = 0, VEL = 1, ACCEL = 2, ATT + RATES = 3)
  public estCapabilities: u8 = 0

  /// Latitude (WGS84)
  /// Units: degE7.
  public lat: i32 = 0

  /// Longitude (WGS84)
  /// Units: degE7.
  public lon: i32 = 0

  /// Altitude (MSL)
  /// Units: m.
  public alt: f32 = 0.0

  /// target velocity (0,0,0) for unknown
  /// Units: m/s.
  public vel: f32[] = []

  /// linear target acceleration (0,0,0) for unknown
  /// Units: m/s/s.
  public acc: f32[] = []

  /// (0 0 0 0 for unknown)
  public attitudeQ: f32[] = []

  /// (0 0 0 for unknown)
  public rates: f32[] = []

  /// eph epv
  public positionCov: f32[] = []

  /// button states or switches of a tracker device
  public customState: u64 = 0

  /// A FOLLOW_TARGET from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): FollowTarget {
    const m = new FollowTarget()
    m.timestamp = readU64(payload, 0)
    m.customState = readU64(payload, 8)
    m.lat = readI32(payload, 16)
    m.lon = readI32(payload, 20)
    m.alt = readF32(payload, 24)
    for (let i = 0; i < 3; i++) {
      m.vel.push(readF32(payload, 28 + i * 4))
    }
    for (let i = 0; i < 3; i++) {
      m.acc.push(readF32(payload, 40 + i * 4))
    }
    for (let i = 0; i < 4; i++) {
      m.attitudeQ.push(readF32(payload, 52 + i * 4))
    }
    for (let i = 0; i < 3; i++) {
      m.rates.push(readF32(payload, 68 + i * 4))
    }
    for (let i = 0; i < 3; i++) {
      m.positionCov.push(readF32(payload, 80 + i * 4))
    }
    m.estCapabilities = readU8(payload, 92)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timestamp)
    writeU64(into, at + 8, this.customState)
    writeUint(into, at + 16, 4, this.lat as int)
    writeUint(into, at + 20, 4, this.lon as int)
    writeF32(into, at + 24, this.alt)
    for (let i = 0; i < 3 && i < this.vel.length; i++) {
      writeF32(into, at + 28 + i * 4, this.vel[i])
    }
    for (let i = 0; i < 3 && i < this.acc.length; i++) {
      writeF32(into, at + 40 + i * 4, this.acc[i])
    }
    for (let i = 0; i < 4 && i < this.attitudeQ.length; i++) {
      writeF32(into, at + 52 + i * 4, this.attitudeQ[i])
    }
    for (let i = 0; i < 3 && i < this.rates.length; i++) {
      writeF32(into, at + 68 + i * 4, this.rates[i])
    }
    for (let i = 0; i < 3 && i < this.positionCov.length; i++) {
      writeF32(into, at + 80 + i * 4, this.positionCov[i])
    }
    writeUint(into, at + 92, 1, this.estCapabilities as int)
  }

  public override info(): MessageInfo {
    FollowTarget.INFO
  }
}

/// The smoothed, monotonic system state used to feed the control loops of the system.
export class ControlSystemState extends MavLinkData {
  public static readonly MSG_ID: int = 146
  public static readonly MSG_NAME: string = "CONTROL_SYSTEM_STATE"
  public static readonly PAYLOAD_LENGTH: int = 100
  public static readonly MAGIC_NUMBER: int = 103
  public static readonly INFO: MessageInfo = new MessageInfo(146, "CONTROL_SYSTEM_STATE", 100, 100, 103, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("x_acc", "xAcc", 8, false, 4, "float", "m/s/s"),
    new MavLinkPacketField("y_acc", "yAcc", 12, false, 4, "float", "m/s/s"),
    new MavLinkPacketField("z_acc", "zAcc", 16, false, 4, "float", "m/s/s"),
    new MavLinkPacketField("x_vel", "xVel", 20, false, 4, "float", "m/s"),
    new MavLinkPacketField("y_vel", "yVel", 24, false, 4, "float", "m/s"),
    new MavLinkPacketField("z_vel", "zVel", 28, false, 4, "float", "m/s"),
    new MavLinkPacketField("x_pos", "xPos", 32, false, 4, "float", "m"),
    new MavLinkPacketField("y_pos", "yPos", 36, false, 4, "float", "m"),
    new MavLinkPacketField("z_pos", "zPos", 40, false, 4, "float", "m"),
    new MavLinkPacketField("airspeed", "airspeed", 44, false, 4, "float", "m/s"),
    new MavLinkPacketField("vel_variance", "velVariance", 48, false, 4, "float[]", "", 3),
    new MavLinkPacketField("pos_variance", "posVariance", 60, false, 4, "float[]", "", 3),
    new MavLinkPacketField("q", "q", 72, false, 4, "float[]", "", 4),
    new MavLinkPacketField("roll_rate", "rollRate", 88, false, 4, "float", "rad/s"),
    new MavLinkPacketField("pitch_rate", "pitchRate", 92, false, 4, "float", "rad/s"),
    new MavLinkPacketField("yaw_rate", "yawRate", 96, false, 4, "float", "rad/s"),
  ], (p) => ControlSystemState.decode(p))

  /// Timestamp (UNIX Epoch time or time since system boot). The receiving end can infer timestamp format
  /// (since 1.1.1970 or since system boot) by checking for the magnitude of the number.
  /// Units: us.
  public timeUsec: u64 = 0

  /// X acceleration in body frame
  /// Units: m/s/s.
  public xAcc: f32 = 0.0

  /// Y acceleration in body frame
  /// Units: m/s/s.
  public yAcc: f32 = 0.0

  /// Z acceleration in body frame
  /// Units: m/s/s.
  public zAcc: f32 = 0.0

  /// X velocity in body frame
  /// Units: m/s.
  public xVel: f32 = 0.0

  /// Y velocity in body frame
  /// Units: m/s.
  public yVel: f32 = 0.0

  /// Z velocity in body frame
  /// Units: m/s.
  public zVel: f32 = 0.0

  /// X position in local frame
  /// Units: m.
  public xPos: f32 = 0.0

  /// Y position in local frame
  /// Units: m.
  public yPos: f32 = 0.0

  /// Z position in local frame
  /// Units: m.
  public zPos: f32 = 0.0

  /// Airspeed, set to -1 if unknown
  /// Units: m/s.
  public airspeed: f32 = 0.0

  /// Variance of body velocity estimate
  public velVariance: f32[] = []

  /// Variance in local position
  public posVariance: f32[] = []

  /// The attitude, represented as Quaternion
  public q: f32[] = []

  /// Angular rate in roll axis
  /// Units: rad/s.
  public rollRate: f32 = 0.0

  /// Angular rate in pitch axis
  /// Units: rad/s.
  public pitchRate: f32 = 0.0

  /// Angular rate in yaw axis
  /// Units: rad/s.
  public yawRate: f32 = 0.0

  /// A CONTROL_SYSTEM_STATE from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): ControlSystemState {
    const m = new ControlSystemState()
    m.timeUsec = readU64(payload, 0)
    m.xAcc = readF32(payload, 8)
    m.yAcc = readF32(payload, 12)
    m.zAcc = readF32(payload, 16)
    m.xVel = readF32(payload, 20)
    m.yVel = readF32(payload, 24)
    m.zVel = readF32(payload, 28)
    m.xPos = readF32(payload, 32)
    m.yPos = readF32(payload, 36)
    m.zPos = readF32(payload, 40)
    m.airspeed = readF32(payload, 44)
    for (let i = 0; i < 3; i++) {
      m.velVariance.push(readF32(payload, 48 + i * 4))
    }
    for (let i = 0; i < 3; i++) {
      m.posVariance.push(readF32(payload, 60 + i * 4))
    }
    for (let i = 0; i < 4; i++) {
      m.q.push(readF32(payload, 72 + i * 4))
    }
    m.rollRate = readF32(payload, 88)
    m.pitchRate = readF32(payload, 92)
    m.yawRate = readF32(payload, 96)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    writeF32(into, at + 8, this.xAcc)
    writeF32(into, at + 12, this.yAcc)
    writeF32(into, at + 16, this.zAcc)
    writeF32(into, at + 20, this.xVel)
    writeF32(into, at + 24, this.yVel)
    writeF32(into, at + 28, this.zVel)
    writeF32(into, at + 32, this.xPos)
    writeF32(into, at + 36, this.yPos)
    writeF32(into, at + 40, this.zPos)
    writeF32(into, at + 44, this.airspeed)
    for (let i = 0; i < 3 && i < this.velVariance.length; i++) {
      writeF32(into, at + 48 + i * 4, this.velVariance[i])
    }
    for (let i = 0; i < 3 && i < this.posVariance.length; i++) {
      writeF32(into, at + 60 + i * 4, this.posVariance[i])
    }
    for (let i = 0; i < 4 && i < this.q.length; i++) {
      writeF32(into, at + 72 + i * 4, this.q[i])
    }
    writeF32(into, at + 88, this.rollRate)
    writeF32(into, at + 92, this.pitchRate)
    writeF32(into, at + 96, this.yawRate)
  }

  public override info(): MessageInfo {
    ControlSystemState.INFO
  }
}

/// Battery information. Updates GCS with flight controller battery status. Smart batteries also use
/// this message, but may additionally send BATTERY_INFO.
export class BatteryStatus extends MavLinkData {
  public static readonly MSG_ID: int = 147
  public static readonly MSG_NAME: string = "BATTERY_STATUS"
  public static readonly PAYLOAD_LENGTH: int = 54
  public static readonly MAGIC_NUMBER: int = 154
  public static readonly INFO: MessageInfo = new MessageInfo(147, "BATTERY_STATUS", 54, 36, 154, [
    new MavLinkPacketField("current_consumed", "currentConsumed", 0, false, 4, "int32_t", "mAh"),
    new MavLinkPacketField("energy_consumed", "energyConsumed", 4, false, 4, "int32_t", "hJ"),
    new MavLinkPacketField("temperature", "temperature", 8, false, 2, "int16_t", "cdegC"),
    new MavLinkPacketField("voltages", "voltages", 10, false, 2, "uint16_t[]", "mV", 10),
    new MavLinkPacketField("current_battery", "currentBattery", 30, false, 2, "int16_t", "cA"),
    new MavLinkPacketField("id", "id", 32, false, 1, "uint8_t", ""),
    new MavLinkPacketField("battery_function", "batteryFunction", 33, false, 1, "uint8_t", ""),
    new MavLinkPacketField("type", "type", 34, false, 1, "uint8_t", ""),
    new MavLinkPacketField("battery_remaining", "batteryRemaining", 35, false, 1, "int8_t", "%"),
    new MavLinkPacketField("time_remaining", "timeRemaining", 36, true, 4, "int32_t", "s"),
    new MavLinkPacketField("charge_state", "chargeState", 40, true, 1, "uint8_t", ""),
    new MavLinkPacketField("voltages_ext", "voltagesExt", 41, true, 2, "uint16_t[]", "mV", 4),
    new MavLinkPacketField("mode", "mode", 49, true, 1, "uint8_t", ""),
    new MavLinkPacketField("fault_bitmask", "faultBitmask", 50, true, 4, "uint32_t", ""),
  ], (p) => BatteryStatus.decode(p))

  /// Battery ID
  public id: u8 = 0

  /// Function of the battery
  /// Values: `MavBatteryFunction`.
  public batteryFunction: u8 = 0

  /// Type (chemistry) of the battery
  /// Values: `MavBatteryType`.
  public type: u8 = 0

  /// Temperature of the battery. INT16_MAX for unknown temperature.
  /// Units: cdegC.
  public temperature: i16 = 0

  /// Battery voltage of cells 1 to 10 (see voltages_ext for cells 11-14). Cells in this field above the
  /// valid cell count for this battery should have the UINT16_MAX value. If individual cell voltages are
  /// unknown or not measured for this battery, then the overall battery voltage should be filled in cell
  /// 0, with all others set to UINT16_MAX. If the voltage of the battery is greater than (UINT16_MAX -
  /// 1), then cell 0 should be set to (UINT16_MAX - 1), and cell 1 to the remaining voltage. This can be
  /// extended to multiple cells if the total voltage is greater than 2 * (UINT16_MAX - 1).
  /// Units: mV.
  public voltages: u16[] = []

  /// Battery current, -1: autopilot does not measure the current
  /// Units: cA.
  public currentBattery: i16 = 0

  /// Consumed charge, -1: autopilot does not provide consumption estimate
  /// Units: mAh.
  public currentConsumed: i32 = 0

  /// Consumed energy, -1: autopilot does not provide energy consumption estimate
  /// Units: hJ.
  public energyConsumed: i32 = 0

  /// Remaining battery energy. Values: [0-100], -1: autopilot does not estimate the remaining battery.
  /// Units: %.
  public batteryRemaining: i8 = 0

  /// Remaining battery time, 0: autopilot does not provide remaining battery time estimate
  /// Units: s.
  public timeRemaining: i32 = 0

  /// State for extent of discharge, provided by autopilot for warning or external reactions
  /// Values: `MavBatteryChargeState`.
  public chargeState: u8 = 0

  /// Battery voltages for cells 11 to 14. Cells above the valid cell count for this battery should have a
  /// value of 0, where zero indicates not supported (note, this is different than for the voltages field
  /// and allows empty byte truncation). If the measured value is 0 then 1 should be sent instead.
  /// Units: mV.
  public voltagesExt: u16[] = []

  /// Battery mode. Default (0) is that battery mode reporting is not supported or battery is in
  /// normal-use mode.
  /// Values: `MavBatteryMode`.
  public mode: u8 = 0

  /// Fault/health indications. These should be set when charge_state is MAV_BATTERY_CHARGE_STATE_FAILED
  /// or MAV_BATTERY_CHARGE_STATE_UNHEALTHY (if not, fault reporting is not supported).
  /// Values: `MavBatteryFault`.
  public faultBitmask: u32 = 0

  /// A BATTERY_STATUS from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): BatteryStatus {
    const m = new BatteryStatus()
    m.currentConsumed = readI32(payload, 0)
    m.energyConsumed = readI32(payload, 4)
    m.temperature = readI16(payload, 8)
    for (let i = 0; i < 10; i++) {
      m.voltages.push(readU16(payload, 10 + i * 2))
    }
    m.currentBattery = readI16(payload, 30)
    m.id = readU8(payload, 32)
    m.batteryFunction = readU8(payload, 33)
    m.type = readU8(payload, 34)
    m.batteryRemaining = readI8(payload, 35)
    m.timeRemaining = readI32(payload, 36)
    m.chargeState = readU8(payload, 40)
    for (let i = 0; i < 4; i++) {
      m.voltagesExt.push(readU16(payload, 41 + i * 2))
    }
    m.mode = readU8(payload, 49)
    m.faultBitmask = readU32(payload, 50)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.currentConsumed as int)
    writeUint(into, at + 4, 4, this.energyConsumed as int)
    writeUint(into, at + 8, 2, this.temperature as int)
    for (let i = 0; i < 10 && i < this.voltages.length; i++) {
      writeUint(into, at + 10 + i * 2, 2, this.voltages[i] as int)
    }
    writeUint(into, at + 30, 2, this.currentBattery as int)
    writeUint(into, at + 32, 1, this.id as int)
    writeUint(into, at + 33, 1, this.batteryFunction as int)
    writeUint(into, at + 34, 1, this.type as int)
    writeUint(into, at + 35, 1, this.batteryRemaining as int)
    writeUint(into, at + 36, 4, this.timeRemaining as int)
    writeUint(into, at + 40, 1, this.chargeState as int)
    for (let i = 0; i < 4 && i < this.voltagesExt.length; i++) {
      writeUint(into, at + 41 + i * 2, 2, this.voltagesExt[i] as int)
    }
    writeUint(into, at + 49, 1, this.mode as int)
    writeUint(into, at + 50, 4, this.faultBitmask as int)
  }

  public override info(): MessageInfo {
    BatteryStatus.INFO
  }
}

/// The location of a landing target. See: https://mavlink.io/en/services/landing_target.html
export class LandingTarget extends MavLinkData {
  public static readonly MSG_ID: int = 149
  public static readonly MSG_NAME: string = "LANDING_TARGET"
  public static readonly PAYLOAD_LENGTH: int = 60
  public static readonly MAGIC_NUMBER: int = 200
  public static readonly INFO: MessageInfo = new MessageInfo(149, "LANDING_TARGET", 60, 30, 200, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("angle_x", "angleX", 8, false, 4, "float", "rad"),
    new MavLinkPacketField("angle_y", "angleY", 12, false, 4, "float", "rad"),
    new MavLinkPacketField("distance", "distance", 16, false, 4, "float", "m"),
    new MavLinkPacketField("size_x", "sizeX", 20, false, 4, "float", "rad"),
    new MavLinkPacketField("size_y", "sizeY", 24, false, 4, "float", "rad"),
    new MavLinkPacketField("target_num", "targetNum", 28, false, 1, "uint8_t", ""),
    new MavLinkPacketField("frame", "frame", 29, false, 1, "uint8_t", ""),
    new MavLinkPacketField("x", "x", 30, true, 4, "float", "m"),
    new MavLinkPacketField("y", "y", 34, true, 4, "float", "m"),
    new MavLinkPacketField("z", "z", 38, true, 4, "float", "m"),
    new MavLinkPacketField("q", "q", 42, true, 4, "float[]", "", 4),
    new MavLinkPacketField("type", "type", 58, true, 1, "uint8_t", ""),
    new MavLinkPacketField("position_valid", "positionValid", 59, true, 1, "uint8_t", ""),
  ], (p) => LandingTarget.decode(p))

  /// Timestamp (UNIX Epoch time or time since system boot). The receiving end can infer timestamp format
  /// (since 1.1.1970 or since system boot) by checking for the magnitude of the number.
  /// Units: us.
  public timeUsec: u64 = 0

  /// The ID of the target if multiple targets are present
  public targetNum: u8 = 0

  /// Coordinate frame used for following fields.
  /// Values: `MavFrame`.
  public frame: u8 = 0

  /// X-axis angular offset of the target from the center of the image
  /// Units: rad.
  public angleX: f32 = 0.0

  /// Y-axis angular offset of the target from the center of the image
  /// Units: rad.
  public angleY: f32 = 0.0

  /// Distance to the target from the vehicle
  /// Units: m.
  public distance: f32 = 0.0

  /// Size of target along x-axis
  /// Units: rad.
  public sizeX: f32 = 0.0

  /// Size of target along y-axis
  /// Units: rad.
  public sizeY: f32 = 0.0

  /// X Position of the landing target in MAV_FRAME
  /// Units: m.
  public x: f32 = 0.0

  /// Y Position of the landing target in MAV_FRAME
  /// Units: m.
  public y: f32 = 0.0

  /// Z Position of the landing target in MAV_FRAME
  /// Units: m.
  public z: f32 = 0.0

  /// Quaternion of landing target orientation (w, x, y, z order, zero-rotation is 1, 0, 0, 0)
  public q: f32[] = []

  /// Type of landing target
  /// Values: `LandingTargetType`.
  public type: u8 = 0

  /// Position fields (x, y, z, q, type) contain valid target position information (MAV_BOOL_FALSE:
  /// invalid values). Values not equal to 0 or 1 are invalid.
  /// Values: `MavBool`.
  public positionValid: u8 = 0

  /// A LANDING_TARGET from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): LandingTarget {
    const m = new LandingTarget()
    m.timeUsec = readU64(payload, 0)
    m.angleX = readF32(payload, 8)
    m.angleY = readF32(payload, 12)
    m.distance = readF32(payload, 16)
    m.sizeX = readF32(payload, 20)
    m.sizeY = readF32(payload, 24)
    m.targetNum = readU8(payload, 28)
    m.frame = readU8(payload, 29)
    m.x = readF32(payload, 30)
    m.y = readF32(payload, 34)
    m.z = readF32(payload, 38)
    for (let i = 0; i < 4; i++) {
      m.q.push(readF32(payload, 42 + i * 4))
    }
    m.type = readU8(payload, 58)
    m.positionValid = readU8(payload, 59)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    writeF32(into, at + 8, this.angleX)
    writeF32(into, at + 12, this.angleY)
    writeF32(into, at + 16, this.distance)
    writeF32(into, at + 20, this.sizeX)
    writeF32(into, at + 24, this.sizeY)
    writeUint(into, at + 28, 1, this.targetNum as int)
    writeUint(into, at + 29, 1, this.frame as int)
    writeF32(into, at + 30, this.x)
    writeF32(into, at + 34, this.y)
    writeF32(into, at + 38, this.z)
    for (let i = 0; i < 4 && i < this.q.length; i++) {
      writeF32(into, at + 42 + i * 4, this.q[i])
    }
    writeUint(into, at + 58, 1, this.type as int)
    writeUint(into, at + 59, 1, this.positionValid as int)
  }

  public override info(): MessageInfo {
    LandingTarget.INFO
  }
}

/// Status of geo-fencing. Sent in extended status stream when fencing enabled.
export class FenceStatus extends MavLinkData {
  public static readonly MSG_ID: int = 162
  public static readonly MSG_NAME: string = "FENCE_STATUS"
  public static readonly PAYLOAD_LENGTH: int = 9
  public static readonly MAGIC_NUMBER: int = 189
  public static readonly INFO: MessageInfo = new MessageInfo(162, "FENCE_STATUS", 9, 8, 189, [
    new MavLinkPacketField("breach_time", "breachTime", 0, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("breach_count", "breachCount", 4, false, 2, "uint16_t", ""),
    new MavLinkPacketField("breach_status", "breachStatus", 6, false, 1, "uint8_t", ""),
    new MavLinkPacketField("breach_type", "breachType", 7, false, 1, "uint8_t", ""),
    new MavLinkPacketField("breach_mitigation", "breachMitigation", 8, true, 1, "uint8_t", ""),
  ], (p) => FenceStatus.decode(p))

  /// Breach status (0 if currently inside fence, 1 if outside).
  public breachStatus: u8 = 0

  /// Number of fence breaches.
  public breachCount: u16 = 0

  /// Last breach type.
  /// Values: `FenceBreach`.
  public breachType: u8 = 0

  /// Time (since boot) of last breach.
  /// Units: ms.
  public breachTime: u32 = 0

  /// Active action to prevent fence breach
  /// Values: `FenceMitigate`.
  public breachMitigation: u8 = 0

  /// A FENCE_STATUS from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): FenceStatus {
    const m = new FenceStatus()
    m.breachTime = readU32(payload, 0)
    m.breachCount = readU16(payload, 4)
    m.breachStatus = readU8(payload, 6)
    m.breachType = readU8(payload, 7)
    m.breachMitigation = readU8(payload, 8)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.breachTime as int)
    writeUint(into, at + 4, 2, this.breachCount as int)
    writeUint(into, at + 6, 1, this.breachStatus as int)
    writeUint(into, at + 7, 1, this.breachType as int)
    writeUint(into, at + 8, 1, this.breachMitigation as int)
  }

  public override info(): MessageInfo {
    FenceStatus.INFO
  }
}

/// Reports results of completed compass calibration. Sent until MAG_CAL_ACK received.
export class MagCalReport extends MavLinkData {
  public static readonly MSG_ID: int = 192
  public static readonly MSG_NAME: string = "MAG_CAL_REPORT"
  public static readonly PAYLOAD_LENGTH: int = 54
  public static readonly MAGIC_NUMBER: int = 36
  public static readonly INFO: MessageInfo = new MessageInfo(192, "MAG_CAL_REPORT", 54, 44, 36, [
    new MavLinkPacketField("fitness", "fitness", 0, false, 4, "float", "mgauss"),
    new MavLinkPacketField("ofs_x", "ofsX", 4, false, 4, "float", ""),
    new MavLinkPacketField("ofs_y", "ofsY", 8, false, 4, "float", ""),
    new MavLinkPacketField("ofs_z", "ofsZ", 12, false, 4, "float", ""),
    new MavLinkPacketField("diag_x", "diagX", 16, false, 4, "float", ""),
    new MavLinkPacketField("diag_y", "diagY", 20, false, 4, "float", ""),
    new MavLinkPacketField("diag_z", "diagZ", 24, false, 4, "float", ""),
    new MavLinkPacketField("offdiag_x", "offdiagX", 28, false, 4, "float", ""),
    new MavLinkPacketField("offdiag_y", "offdiagY", 32, false, 4, "float", ""),
    new MavLinkPacketField("offdiag_z", "offdiagZ", 36, false, 4, "float", ""),
    new MavLinkPacketField("compass_id", "compassId", 40, false, 1, "uint8_t", ""),
    new MavLinkPacketField("cal_mask", "calMask", 41, false, 1, "uint8_t", ""),
    new MavLinkPacketField("cal_status", "calStatus", 42, false, 1, "uint8_t", ""),
    new MavLinkPacketField("autosaved", "autosaved", 43, false, 1, "uint8_t", ""),
    new MavLinkPacketField("orientation_confidence", "orientationConfidence", 44, true, 4, "float", ""),
    new MavLinkPacketField("old_orientation", "oldOrientation", 48, true, 1, "uint8_t", ""),
    new MavLinkPacketField("new_orientation", "newOrientation", 49, true, 1, "uint8_t", ""),
    new MavLinkPacketField("scale_factor", "scaleFactor", 50, true, 4, "float", ""),
  ], (p) => MagCalReport.decode(p))

  /// Compass being calibrated.
  public compassId: u8 = 0

  /// Bitmask of compasses being calibrated.
  public calMask: u8 = 0

  /// Calibration Status.
  /// Values: `MagCalStatus`.
  public calStatus: u8 = 0

  /// 0=requires a MAV_CMD_DO_ACCEPT_MAG_CAL, 1=saved to parameters.
  public autosaved: u8 = 0

  /// RMS milligauss residuals.
  /// Units: mgauss.
  public fitness: f32 = 0.0

  /// X offset.
  public ofsX: f32 = 0.0

  /// Y offset.
  public ofsY: f32 = 0.0

  /// Z offset.
  public ofsZ: f32 = 0.0

  /// X diagonal (matrix 11).
  public diagX: f32 = 0.0

  /// Y diagonal (matrix 22).
  public diagY: f32 = 0.0

  /// Z diagonal (matrix 33).
  public diagZ: f32 = 0.0

  /// X off-diagonal (matrix 12 and 21).
  public offdiagX: f32 = 0.0

  /// Y off-diagonal (matrix 13 and 31).
  public offdiagY: f32 = 0.0

  /// Z off-diagonal (matrix 32 and 23).
  public offdiagZ: f32 = 0.0

  /// Confidence in orientation (higher is better).
  public orientationConfidence: f32 = 0.0

  /// orientation before calibration.
  /// Values: `MavSensorOrientation`.
  public oldOrientation: u8 = 0

  /// orientation after calibration.
  /// Values: `MavSensorOrientation`.
  public newOrientation: u8 = 0

  /// field radius correction factor
  public scaleFactor: f32 = 0.0

  /// A MAG_CAL_REPORT from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): MagCalReport {
    const m = new MagCalReport()
    m.fitness = readF32(payload, 0)
    m.ofsX = readF32(payload, 4)
    m.ofsY = readF32(payload, 8)
    m.ofsZ = readF32(payload, 12)
    m.diagX = readF32(payload, 16)
    m.diagY = readF32(payload, 20)
    m.diagZ = readF32(payload, 24)
    m.offdiagX = readF32(payload, 28)
    m.offdiagY = readF32(payload, 32)
    m.offdiagZ = readF32(payload, 36)
    m.compassId = readU8(payload, 40)
    m.calMask = readU8(payload, 41)
    m.calStatus = readU8(payload, 42)
    m.autosaved = readU8(payload, 43)
    m.orientationConfidence = readF32(payload, 44)
    m.oldOrientation = readU8(payload, 48)
    m.newOrientation = readU8(payload, 49)
    m.scaleFactor = readF32(payload, 50)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeF32(into, at + 0, this.fitness)
    writeF32(into, at + 4, this.ofsX)
    writeF32(into, at + 8, this.ofsY)
    writeF32(into, at + 12, this.ofsZ)
    writeF32(into, at + 16, this.diagX)
    writeF32(into, at + 20, this.diagY)
    writeF32(into, at + 24, this.diagZ)
    writeF32(into, at + 28, this.offdiagX)
    writeF32(into, at + 32, this.offdiagY)
    writeF32(into, at + 36, this.offdiagZ)
    writeUint(into, at + 40, 1, this.compassId as int)
    writeUint(into, at + 41, 1, this.calMask as int)
    writeUint(into, at + 42, 1, this.calStatus as int)
    writeUint(into, at + 43, 1, this.autosaved as int)
    writeF32(into, at + 44, this.orientationConfidence)
    writeUint(into, at + 48, 1, this.oldOrientation as int)
    writeUint(into, at + 49, 1, this.newOrientation as int)
    writeF32(into, at + 50, this.scaleFactor)
  }

  public override info(): MessageInfo {
    MagCalReport.INFO
  }
}

/// EFI status output
export class EfiStatus extends MavLinkData {
  public static readonly MSG_ID: int = 225
  public static readonly MSG_NAME: string = "EFI_STATUS"
  public static readonly PAYLOAD_LENGTH: int = 73
  public static readonly MAGIC_NUMBER: int = 208
  public static readonly INFO: MessageInfo = new MessageInfo(225, "EFI_STATUS", 73, 65, 208, [
    new MavLinkPacketField("ecu_index", "ecuIndex", 0, false, 4, "float", ""),
    new MavLinkPacketField("rpm", "rpm", 4, false, 4, "float", ""),
    new MavLinkPacketField("fuel_consumed", "fuelConsumed", 8, false, 4, "float", "cm^3"),
    new MavLinkPacketField("fuel_flow", "fuelFlow", 12, false, 4, "float", "cm^3/min"),
    new MavLinkPacketField("engine_load", "engineLoad", 16, false, 4, "float", "%"),
    new MavLinkPacketField("throttle_position", "throttlePosition", 20, false, 4, "float", "%"),
    new MavLinkPacketField("spark_dwell_time", "sparkDwellTime", 24, false, 4, "float", "ms"),
    new MavLinkPacketField("barometric_pressure", "barometricPressure", 28, false, 4, "float", "kPa"),
    new MavLinkPacketField("intake_manifold_pressure", "intakeManifoldPressure", 32, false, 4, "float", "kPa"),
    new MavLinkPacketField("intake_manifold_temperature", "intakeManifoldTemperature", 36, false, 4, "float", "degC"),
    new MavLinkPacketField("cylinder_head_temperature", "cylinderHeadTemperature", 40, false, 4, "float", "degC"),
    new MavLinkPacketField("ignition_timing", "ignitionTiming", 44, false, 4, "float", "deg"),
    new MavLinkPacketField("injection_time", "injectionTime", 48, false, 4, "float", "ms"),
    new MavLinkPacketField("exhaust_gas_temperature", "exhaustGasTemperature", 52, false, 4, "float", "degC"),
    new MavLinkPacketField("throttle_out", "throttleOut", 56, false, 4, "float", "%"),
    new MavLinkPacketField("pt_compensation", "ptCompensation", 60, false, 4, "float", ""),
    new MavLinkPacketField("health", "health", 64, false, 1, "uint8_t", ""),
    new MavLinkPacketField("ignition_voltage", "ignitionVoltage", 65, true, 4, "float", "V"),
    new MavLinkPacketField("fuel_pressure", "fuelPressure", 69, true, 4, "float", "kPa"),
  ], (p) => EfiStatus.decode(p))

  /// EFI health status
  public health: u8 = 0

  /// ECU index
  public ecuIndex: f32 = 0.0

  /// RPM
  public rpm: f32 = 0.0

  /// Fuel consumed
  /// Units: cm^3.
  public fuelConsumed: f32 = 0.0

  /// Fuel flow rate
  /// Units: cm^3/min.
  public fuelFlow: f32 = 0.0

  /// Engine load
  /// Units: %.
  public engineLoad: f32 = 0.0

  /// Throttle position
  /// Units: %.
  public throttlePosition: f32 = 0.0

  /// Spark dwell time
  /// Units: ms.
  public sparkDwellTime: f32 = 0.0

  /// Barometric pressure
  /// Units: kPa.
  public barometricPressure: f32 = 0.0

  /// Intake manifold pressure(
  /// Units: kPa.
  public intakeManifoldPressure: f32 = 0.0

  /// Intake manifold temperature
  /// Units: degC.
  public intakeManifoldTemperature: f32 = 0.0

  /// Cylinder head temperature
  /// Units: degC.
  public cylinderHeadTemperature: f32 = 0.0

  /// Ignition timing (Crank angle degrees)
  /// Units: deg.
  public ignitionTiming: f32 = 0.0

  /// Injection time
  /// Units: ms.
  public injectionTime: f32 = 0.0

  /// Exhaust gas temperature
  /// Units: degC.
  public exhaustGasTemperature: f32 = 0.0

  /// Output throttle
  /// Units: %.
  public throttleOut: f32 = 0.0

  /// Pressure/temperature compensation
  public ptCompensation: f32 = 0.0

  /// Supply voltage to EFI sparking system. Zero in this value means "unknown", so if the supply voltage
  /// really is zero volts use 0.0001 instead.
  /// Units: V.
  public ignitionVoltage: f32 = 0.0

  /// Fuel pressure. Zero in this value means "unknown", so if the fuel pressure really is zero kPa use
  /// 0.0001 instead.
  /// Units: kPa.
  public fuelPressure: f32 = 0.0

  /// A EFI_STATUS from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): EfiStatus {
    const m = new EfiStatus()
    m.ecuIndex = readF32(payload, 0)
    m.rpm = readF32(payload, 4)
    m.fuelConsumed = readF32(payload, 8)
    m.fuelFlow = readF32(payload, 12)
    m.engineLoad = readF32(payload, 16)
    m.throttlePosition = readF32(payload, 20)
    m.sparkDwellTime = readF32(payload, 24)
    m.barometricPressure = readF32(payload, 28)
    m.intakeManifoldPressure = readF32(payload, 32)
    m.intakeManifoldTemperature = readF32(payload, 36)
    m.cylinderHeadTemperature = readF32(payload, 40)
    m.ignitionTiming = readF32(payload, 44)
    m.injectionTime = readF32(payload, 48)
    m.exhaustGasTemperature = readF32(payload, 52)
    m.throttleOut = readF32(payload, 56)
    m.ptCompensation = readF32(payload, 60)
    m.health = readU8(payload, 64)
    m.ignitionVoltage = readF32(payload, 65)
    m.fuelPressure = readF32(payload, 69)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeF32(into, at + 0, this.ecuIndex)
    writeF32(into, at + 4, this.rpm)
    writeF32(into, at + 8, this.fuelConsumed)
    writeF32(into, at + 12, this.fuelFlow)
    writeF32(into, at + 16, this.engineLoad)
    writeF32(into, at + 20, this.throttlePosition)
    writeF32(into, at + 24, this.sparkDwellTime)
    writeF32(into, at + 28, this.barometricPressure)
    writeF32(into, at + 32, this.intakeManifoldPressure)
    writeF32(into, at + 36, this.intakeManifoldTemperature)
    writeF32(into, at + 40, this.cylinderHeadTemperature)
    writeF32(into, at + 44, this.ignitionTiming)
    writeF32(into, at + 48, this.injectionTime)
    writeF32(into, at + 52, this.exhaustGasTemperature)
    writeF32(into, at + 56, this.throttleOut)
    writeF32(into, at + 60, this.ptCompensation)
    writeUint(into, at + 64, 1, this.health as int)
    writeF32(into, at + 65, this.ignitionVoltage)
    writeF32(into, at + 69, this.fuelPressure)
  }

  public override info(): MessageInfo {
    EfiStatus.INFO
  }
}

/// Estimator status message including flags, innovation test ratios and estimated accuracies. The flags
/// message is an integer bitmask containing information on which EKF outputs are valid. See the
/// ESTIMATOR_STATUS_FLAGS enum definition for further information. The innovation test ratios show the
/// magnitude of the sensor innovation divided by the innovation check threshold. Under normal operation
/// the innovation test ratios should be below 0.5 with occasional values up to 1.0. Values greater than
/// 1.0 should be rare under normal operation and indicate that a measurement has been rejected by the
/// filter. The user should be notified if an innovation test ratio greater than 1.0 is recorded.
/// Notifications for values in the range between 0.5 and 1.0 should be optional and controllable by the
/// user.
export class EstimatorStatus extends MavLinkData {
  public static readonly MSG_ID: int = 230
  public static readonly MSG_NAME: string = "ESTIMATOR_STATUS"
  public static readonly PAYLOAD_LENGTH: int = 42
  public static readonly MAGIC_NUMBER: int = 163
  public static readonly INFO: MessageInfo = new MessageInfo(230, "ESTIMATOR_STATUS", 42, 42, 163, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("vel_ratio", "velRatio", 8, false, 4, "float", ""),
    new MavLinkPacketField("pos_horiz_ratio", "posHorizRatio", 12, false, 4, "float", ""),
    new MavLinkPacketField("pos_vert_ratio", "posVertRatio", 16, false, 4, "float", ""),
    new MavLinkPacketField("mag_ratio", "magRatio", 20, false, 4, "float", ""),
    new MavLinkPacketField("hagl_ratio", "haglRatio", 24, false, 4, "float", ""),
    new MavLinkPacketField("tas_ratio", "tasRatio", 28, false, 4, "float", ""),
    new MavLinkPacketField("pos_horiz_accuracy", "posHorizAccuracy", 32, false, 4, "float", "m"),
    new MavLinkPacketField("pos_vert_accuracy", "posVertAccuracy", 36, false, 4, "float", "m"),
    new MavLinkPacketField("flags", "flags", 40, false, 2, "uint16_t", ""),
  ], (p) => EstimatorStatus.decode(p))

  /// Timestamp (UNIX Epoch time or time since system boot). The receiving end can infer timestamp format
  /// (since 1.1.1970 or since system boot) by checking for the magnitude of the number.
  /// Units: us.
  public timeUsec: u64 = 0

  /// Bitmap indicating which EKF outputs are valid.
  /// Values: `EstimatorStatusFlags`.
  public flags: u16 = 0

  /// Velocity innovation test ratio
  public velRatio: f32 = 0.0

  /// Horizontal position innovation test ratio
  public posHorizRatio: f32 = 0.0

  /// Vertical position innovation test ratio
  public posVertRatio: f32 = 0.0

  /// Magnetometer innovation test ratio
  public magRatio: f32 = 0.0

  /// Height above terrain innovation test ratio
  public haglRatio: f32 = 0.0

  /// True airspeed innovation test ratio
  public tasRatio: f32 = 0.0

  /// Horizontal position 1-STD accuracy relative to the EKF local origin
  /// Units: m.
  public posHorizAccuracy: f32 = 0.0

  /// Vertical position 1-STD accuracy relative to the EKF local origin
  /// Units: m.
  public posVertAccuracy: f32 = 0.0

  /// A ESTIMATOR_STATUS from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): EstimatorStatus {
    const m = new EstimatorStatus()
    m.timeUsec = readU64(payload, 0)
    m.velRatio = readF32(payload, 8)
    m.posHorizRatio = readF32(payload, 12)
    m.posVertRatio = readF32(payload, 16)
    m.magRatio = readF32(payload, 20)
    m.haglRatio = readF32(payload, 24)
    m.tasRatio = readF32(payload, 28)
    m.posHorizAccuracy = readF32(payload, 32)
    m.posVertAccuracy = readF32(payload, 36)
    m.flags = readU16(payload, 40)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    writeF32(into, at + 8, this.velRatio)
    writeF32(into, at + 12, this.posHorizRatio)
    writeF32(into, at + 16, this.posVertRatio)
    writeF32(into, at + 20, this.magRatio)
    writeF32(into, at + 24, this.haglRatio)
    writeF32(into, at + 28, this.tasRatio)
    writeF32(into, at + 32, this.posHorizAccuracy)
    writeF32(into, at + 36, this.posVertAccuracy)
    writeUint(into, at + 40, 2, this.flags as int)
  }

  public override info(): MessageInfo {
    EstimatorStatus.INFO
  }
}

/// Wind estimate from vehicle. Note that despite the name, this message does not actually contain any
/// covariances but instead variability and accuracy fields in terms of standard deviation (1-STD).
export class WindCov extends MavLinkData {
  public static readonly MSG_ID: int = 231
  public static readonly MSG_NAME: string = "WIND_COV"
  public static readonly PAYLOAD_LENGTH: int = 40
  public static readonly MAGIC_NUMBER: int = 105
  public static readonly INFO: MessageInfo = new MessageInfo(231, "WIND_COV", 40, 40, 105, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("wind_x", "windX", 8, false, 4, "float", "m/s"),
    new MavLinkPacketField("wind_y", "windY", 12, false, 4, "float", "m/s"),
    new MavLinkPacketField("wind_z", "windZ", 16, false, 4, "float", "m/s"),
    new MavLinkPacketField("var_horiz", "varHoriz", 20, false, 4, "float", "m/s"),
    new MavLinkPacketField("var_vert", "varVert", 24, false, 4, "float", "m/s"),
    new MavLinkPacketField("wind_alt", "windAlt", 28, false, 4, "float", "m"),
    new MavLinkPacketField("horiz_accuracy", "horizAccuracy", 32, false, 4, "float", "m/s"),
    new MavLinkPacketField("vert_accuracy", "vertAccuracy", 36, false, 4, "float", "m/s"),
  ], (p) => WindCov.decode(p))

  /// Timestamp (UNIX Epoch time or time since system boot). The receiving end can infer timestamp format
  /// (since 1.1.1970 or since system boot) by checking for the magnitude of the number.
  /// Units: us.
  public timeUsec: u64 = 0

  /// Wind in North (NED) direction (NAN if unknown)
  /// Units: m/s.
  public windX: f32 = 0.0

  /// Wind in East (NED) direction (NAN if unknown)
  /// Units: m/s.
  public windY: f32 = 0.0

  /// Wind in down (NED) direction (NAN if unknown)
  /// Units: m/s.
  public windZ: f32 = 0.0

  /// Variability of wind in XY, 1-STD estimated from a 1 Hz lowpassed wind estimate (NAN if unknown)
  /// Units: m/s.
  public varHoriz: f32 = 0.0

  /// Variability of wind in Z, 1-STD estimated from a 1 Hz lowpassed wind estimate (NAN if unknown)
  /// Units: m/s.
  public varVert: f32 = 0.0

  /// Altitude (MSL) that this measurement was taken at (NAN if unknown)
  /// Units: m.
  public windAlt: f32 = 0.0

  /// Horizontal speed 1-STD accuracy (0 if unknown)
  /// Units: m/s.
  public horizAccuracy: f32 = 0.0

  /// Vertical speed 1-STD accuracy (0 if unknown)
  /// Units: m/s.
  public vertAccuracy: f32 = 0.0

  /// A WIND_COV from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): WindCov {
    const m = new WindCov()
    m.timeUsec = readU64(payload, 0)
    m.windX = readF32(payload, 8)
    m.windY = readF32(payload, 12)
    m.windZ = readF32(payload, 16)
    m.varHoriz = readF32(payload, 20)
    m.varVert = readF32(payload, 24)
    m.windAlt = readF32(payload, 28)
    m.horizAccuracy = readF32(payload, 32)
    m.vertAccuracy = readF32(payload, 36)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    writeF32(into, at + 8, this.windX)
    writeF32(into, at + 12, this.windY)
    writeF32(into, at + 16, this.windZ)
    writeF32(into, at + 20, this.varHoriz)
    writeF32(into, at + 24, this.varVert)
    writeF32(into, at + 28, this.windAlt)
    writeF32(into, at + 32, this.horizAccuracy)
    writeF32(into, at + 36, this.vertAccuracy)
  }

  public override info(): MessageInfo {
    WindCov.INFO
  }
}

/// GPS sensor input message. This is a raw sensor value sent by the GPS. This is NOT the global
/// position estimate of the system.
export class GpsInput extends MavLinkData {
  public static readonly MSG_ID: int = 232
  public static readonly MSG_NAME: string = "GPS_INPUT"
  public static readonly PAYLOAD_LENGTH: int = 65
  public static readonly MAGIC_NUMBER: int = 151
  public static readonly INFO: MessageInfo = new MessageInfo(232, "GPS_INPUT", 65, 63, 151, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("time_week_ms", "timeWeekMs", 8, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("lat", "lat", 12, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("lon", "lon", 16, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("alt", "alt", 20, false, 4, "float", "m"),
    new MavLinkPacketField("hdop", "hdop", 24, false, 4, "float", ""),
    new MavLinkPacketField("vdop", "vdop", 28, false, 4, "float", ""),
    new MavLinkPacketField("vn", "vn", 32, false, 4, "float", "m/s"),
    new MavLinkPacketField("ve", "ve", 36, false, 4, "float", "m/s"),
    new MavLinkPacketField("vd", "vd", 40, false, 4, "float", "m/s"),
    new MavLinkPacketField("speed_accuracy", "speedAccuracy", 44, false, 4, "float", "m/s"),
    new MavLinkPacketField("horiz_accuracy", "horizAccuracy", 48, false, 4, "float", "m"),
    new MavLinkPacketField("vert_accuracy", "vertAccuracy", 52, false, 4, "float", "m"),
    new MavLinkPacketField("ignore_flags", "ignoreFlags", 56, false, 2, "uint16_t", ""),
    new MavLinkPacketField("time_week", "timeWeek", 58, false, 2, "uint16_t", ""),
    new MavLinkPacketField("gps_id", "gpsId", 60, false, 1, "uint8_t", ""),
    new MavLinkPacketField("fix_type", "fixType", 61, false, 1, "uint8_t", ""),
    new MavLinkPacketField("satellites_visible", "satellitesVisible", 62, false, 1, "uint8_t", ""),
    new MavLinkPacketField("yaw", "yaw", 63, true, 2, "uint16_t", "cdeg"),
  ], (p) => GpsInput.decode(p))

  /// Timestamp (UNIX Epoch time or time since system boot). The receiving end can infer timestamp format
  /// (since 1.1.1970 or since system boot) by checking for the magnitude of the number.
  /// Units: us.
  public timeUsec: u64 = 0

  /// ID of the GPS for multiple GPS inputs
  public gpsId: u8 = 0

  /// Bitmap indicating which GPS input flags fields to ignore. All other fields must be provided.
  /// Values: `GpsInputIgnoreFlags`.
  public ignoreFlags: u16 = 0

  /// GPS time (from start of GPS week)
  /// Units: ms.
  public timeWeekMs: u32 = 0

  /// GPS week number
  public timeWeek: u16 = 0

  /// 0-1: no fix, 2: 2D fix, 3: 3D fix. 4: 3D with DGPS. 5: 3D with RTK
  public fixType: u8 = 0

  /// Latitude (WGS84)
  /// Units: degE7.
  public lat: i32 = 0

  /// Longitude (WGS84)
  /// Units: degE7.
  public lon: i32 = 0

  /// Altitude (MSL). Positive for up.
  /// Units: m.
  public alt: f32 = 0.0

  /// GPS HDOP horizontal dilution of position (unitless). If unknown, set to: UINT16_MAX
  public hdop: f32 = 0.0

  /// GPS VDOP vertical dilution of position (unitless). If unknown, set to: UINT16_MAX
  public vdop: f32 = 0.0

  /// GPS velocity in north direction in earth-fixed NED frame
  /// Units: m/s.
  public vn: f32 = 0.0

  /// GPS velocity in east direction in earth-fixed NED frame
  /// Units: m/s.
  public ve: f32 = 0.0

  /// GPS velocity in down direction in earth-fixed NED frame
  /// Units: m/s.
  public vd: f32 = 0.0

  /// GPS speed accuracy
  /// Units: m/s.
  public speedAccuracy: f32 = 0.0

  /// GPS horizontal accuracy
  /// Units: m.
  public horizAccuracy: f32 = 0.0

  /// GPS vertical accuracy
  /// Units: m.
  public vertAccuracy: f32 = 0.0

  /// Number of satellites visible.
  public satellitesVisible: u8 = 0

  /// Yaw of vehicle relative to Earth's North, zero means not available, use 36000 for north
  /// Units: cdeg.
  public yaw: u16 = 0

  /// A GPS_INPUT from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): GpsInput {
    const m = new GpsInput()
    m.timeUsec = readU64(payload, 0)
    m.timeWeekMs = readU32(payload, 8)
    m.lat = readI32(payload, 12)
    m.lon = readI32(payload, 16)
    m.alt = readF32(payload, 20)
    m.hdop = readF32(payload, 24)
    m.vdop = readF32(payload, 28)
    m.vn = readF32(payload, 32)
    m.ve = readF32(payload, 36)
    m.vd = readF32(payload, 40)
    m.speedAccuracy = readF32(payload, 44)
    m.horizAccuracy = readF32(payload, 48)
    m.vertAccuracy = readF32(payload, 52)
    m.ignoreFlags = readU16(payload, 56)
    m.timeWeek = readU16(payload, 58)
    m.gpsId = readU8(payload, 60)
    m.fixType = readU8(payload, 61)
    m.satellitesVisible = readU8(payload, 62)
    m.yaw = readU16(payload, 63)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    writeUint(into, at + 8, 4, this.timeWeekMs as int)
    writeUint(into, at + 12, 4, this.lat as int)
    writeUint(into, at + 16, 4, this.lon as int)
    writeF32(into, at + 20, this.alt)
    writeF32(into, at + 24, this.hdop)
    writeF32(into, at + 28, this.vdop)
    writeF32(into, at + 32, this.vn)
    writeF32(into, at + 36, this.ve)
    writeF32(into, at + 40, this.vd)
    writeF32(into, at + 44, this.speedAccuracy)
    writeF32(into, at + 48, this.horizAccuracy)
    writeF32(into, at + 52, this.vertAccuracy)
    writeUint(into, at + 56, 2, this.ignoreFlags as int)
    writeUint(into, at + 58, 2, this.timeWeek as int)
    writeUint(into, at + 60, 1, this.gpsId as int)
    writeUint(into, at + 61, 1, this.fixType as int)
    writeUint(into, at + 62, 1, this.satellitesVisible as int)
    writeUint(into, at + 63, 2, this.yaw as int)
  }

  public override info(): MessageInfo {
    GpsInput.INFO
  }
}

/// RTCM message for injecting into the onboard GPS (used for DGPS)
export class GpsRtcmData extends MavLinkData {
  public static readonly MSG_ID: int = 233
  public static readonly MSG_NAME: string = "GPS_RTCM_DATA"
  public static readonly PAYLOAD_LENGTH: int = 182
  public static readonly MAGIC_NUMBER: int = 35
  public static readonly INFO: MessageInfo = new MessageInfo(233, "GPS_RTCM_DATA", 182, 182, 35, [
    new MavLinkPacketField("flags", "flags", 0, false, 1, "uint8_t", ""),
    new MavLinkPacketField("len", "len", 1, false, 1, "uint8_t", "bytes"),
    new MavLinkPacketField("data", "data", 2, false, 1, "uint8_t[]", "", 180),
  ], (p) => GpsRtcmData.decode(p))

  /// LSB: 1 means message is fragmented, next 2 bits are the fragment ID, the remaining 5 bits are used
  /// for the sequence ID. Messages are only to be flushed to the GPS when the entire message has been
  /// reconstructed on the autopilot. The fragment ID specifies which order the fragments should be
  /// assembled into a buffer, while the sequence ID is used to detect a mismatch between different
  /// buffers. The buffer is considered fully reconstructed when either all 4 fragments are present, or
  /// all the fragments before the first fragment with a non full payload is received. This management is
  /// used to ensure that normal GPS operation doesn't corrupt RTCM data, and to recover from a unreliable
  /// transport delivery order.
  public flags: u8 = 0

  /// data length
  /// Units: bytes.
  public len: u8 = 0

  /// RTCM message (may be fragmented)
  public data: u8[] = []

  /// A GPS_RTCM_DATA from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): GpsRtcmData {
    const m = new GpsRtcmData()
    m.flags = readU8(payload, 0)
    m.len = readU8(payload, 1)
    for (let i = 0; i < 180; i++) {
      m.data.push(readU8(payload, 2 + i * 1))
    }
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 1, this.flags as int)
    writeUint(into, at + 1, 1, this.len as int)
    for (let i = 0; i < 180 && i < this.data.length; i++) {
      writeUint(into, at + 2 + i * 1, 1, this.data[i] as int)
    }
  }

  public override info(): MessageInfo {
    GpsRtcmData.INFO
  }
}

/// Message appropriate for high latency connections like Iridium
export class HighLatency extends MavLinkData {
  public static readonly MSG_ID: int = 234
  public static readonly MSG_NAME: string = "HIGH_LATENCY"
  public static readonly PAYLOAD_LENGTH: int = 40
  public static readonly MAGIC_NUMBER: int = 150
  public static readonly INFO: MessageInfo = new MessageInfo(234, "HIGH_LATENCY", 40, 40, 150, [
    new MavLinkPacketField("custom_mode", "customMode", 0, false, 4, "uint32_t", ""),
    new MavLinkPacketField("latitude", "latitude", 4, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("longitude", "longitude", 8, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("roll", "roll", 12, false, 2, "int16_t", "cdeg"),
    new MavLinkPacketField("pitch", "pitch", 14, false, 2, "int16_t", "cdeg"),
    new MavLinkPacketField("heading", "heading", 16, false, 2, "uint16_t", "cdeg"),
    new MavLinkPacketField("heading_sp", "headingSp", 18, false, 2, "int16_t", "cdeg"),
    new MavLinkPacketField("altitude_amsl", "altitudeAmsl", 20, false, 2, "int16_t", "m"),
    new MavLinkPacketField("altitude_sp", "altitudeSp", 22, false, 2, "int16_t", "m"),
    new MavLinkPacketField("wp_distance", "wpDistance", 24, false, 2, "uint16_t", "m"),
    new MavLinkPacketField("base_mode", "baseMode", 26, false, 1, "uint8_t", ""),
    new MavLinkPacketField("landed_state", "landedState", 27, false, 1, "uint8_t", ""),
    new MavLinkPacketField("throttle", "throttle", 28, false, 1, "int8_t", "%"),
    new MavLinkPacketField("airspeed", "airspeed", 29, false, 1, "uint8_t", "m/s"),
    new MavLinkPacketField("airspeed_sp", "airspeedSp", 30, false, 1, "uint8_t", "m/s"),
    new MavLinkPacketField("groundspeed", "groundspeed", 31, false, 1, "uint8_t", "m/s"),
    new MavLinkPacketField("climb_rate", "climbRate", 32, false, 1, "int8_t", "m/s"),
    new MavLinkPacketField("gps_nsat", "gpsNsat", 33, false, 1, "uint8_t", ""),
    new MavLinkPacketField("gps_fix_type", "gpsFixType", 34, false, 1, "uint8_t", ""),
    new MavLinkPacketField("battery_remaining", "batteryRemaining", 35, false, 1, "uint8_t", "%"),
    new MavLinkPacketField("temperature", "temperature", 36, false, 1, "int8_t", "degC"),
    new MavLinkPacketField("temperature_air", "temperatureAir", 37, false, 1, "int8_t", "degC"),
    new MavLinkPacketField("failsafe", "failsafe", 38, false, 1, "uint8_t", ""),
    new MavLinkPacketField("wp_num", "wpNum", 39, false, 1, "uint8_t", ""),
  ], (p) => HighLatency.decode(p))

  /// Bitmap of enabled system modes.
  /// Values: `MavModeFlag`.
  public baseMode: u8 = 0

  /// A bitfield for use for autopilot-specific flags.
  public customMode: u32 = 0

  /// The landed state. Is set to MAV_LANDED_STATE_UNDEFINED if landed state is unknown.
  /// Values: `MavLandedState`.
  public landedState: u8 = 0

  /// roll
  /// Units: cdeg.
  public roll: i16 = 0

  /// pitch
  /// Units: cdeg.
  public pitch: i16 = 0

  /// heading
  /// Units: cdeg.
  public heading: u16 = 0

  /// throttle (percentage)
  /// Units: %.
  public throttle: i8 = 0

  /// heading setpoint
  /// Units: cdeg.
  public headingSp: i16 = 0

  /// Latitude
  /// Units: degE7.
  public latitude: i32 = 0

  /// Longitude
  /// Units: degE7.
  public longitude: i32 = 0

  /// Altitude above mean sea level
  /// Units: m.
  public altitudeAmsl: i16 = 0

  /// Altitude setpoint relative to the home position
  /// Units: m.
  public altitudeSp: i16 = 0

  /// airspeed
  /// Units: m/s.
  public airspeed: u8 = 0

  /// airspeed setpoint
  /// Units: m/s.
  public airspeedSp: u8 = 0

  /// groundspeed
  /// Units: m/s.
  public groundspeed: u8 = 0

  /// climb rate
  /// Units: m/s.
  public climbRate: i8 = 0

  /// Number of satellites visible. If unknown, set to UINT8_MAX
  public gpsNsat: u8 = 0

  /// GPS Fix type.
  /// Values: `GpsFixType`.
  public gpsFixType: u8 = 0

  /// Remaining battery (percentage)
  /// Units: %.
  public batteryRemaining: u8 = 0

  /// Autopilot temperature (degrees C)
  /// Units: degC.
  public temperature: i8 = 0

  /// Air temperature (degrees C) from airspeed sensor
  /// Units: degC.
  public temperatureAir: i8 = 0

  /// failsafe (each bit represents a failsafe where 0=ok, 1=failsafe active (bit0:RC, bit1:batt,
  /// bit2:GPS, bit3:GCS, bit4:fence)
  public failsafe: u8 = 0

  /// current waypoint number
  public wpNum: u8 = 0

  /// distance to target
  /// Units: m.
  public wpDistance: u16 = 0

  /// A HIGH_LATENCY from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): HighLatency {
    const m = new HighLatency()
    m.customMode = readU32(payload, 0)
    m.latitude = readI32(payload, 4)
    m.longitude = readI32(payload, 8)
    m.roll = readI16(payload, 12)
    m.pitch = readI16(payload, 14)
    m.heading = readU16(payload, 16)
    m.headingSp = readI16(payload, 18)
    m.altitudeAmsl = readI16(payload, 20)
    m.altitudeSp = readI16(payload, 22)
    m.wpDistance = readU16(payload, 24)
    m.baseMode = readU8(payload, 26)
    m.landedState = readU8(payload, 27)
    m.throttle = readI8(payload, 28)
    m.airspeed = readU8(payload, 29)
    m.airspeedSp = readU8(payload, 30)
    m.groundspeed = readU8(payload, 31)
    m.climbRate = readI8(payload, 32)
    m.gpsNsat = readU8(payload, 33)
    m.gpsFixType = readU8(payload, 34)
    m.batteryRemaining = readU8(payload, 35)
    m.temperature = readI8(payload, 36)
    m.temperatureAir = readI8(payload, 37)
    m.failsafe = readU8(payload, 38)
    m.wpNum = readU8(payload, 39)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.customMode as int)
    writeUint(into, at + 4, 4, this.latitude as int)
    writeUint(into, at + 8, 4, this.longitude as int)
    writeUint(into, at + 12, 2, this.roll as int)
    writeUint(into, at + 14, 2, this.pitch as int)
    writeUint(into, at + 16, 2, this.heading as int)
    writeUint(into, at + 18, 2, this.headingSp as int)
    writeUint(into, at + 20, 2, this.altitudeAmsl as int)
    writeUint(into, at + 22, 2, this.altitudeSp as int)
    writeUint(into, at + 24, 2, this.wpDistance as int)
    writeUint(into, at + 26, 1, this.baseMode as int)
    writeUint(into, at + 27, 1, this.landedState as int)
    writeUint(into, at + 28, 1, this.throttle as int)
    writeUint(into, at + 29, 1, this.airspeed as int)
    writeUint(into, at + 30, 1, this.airspeedSp as int)
    writeUint(into, at + 31, 1, this.groundspeed as int)
    writeUint(into, at + 32, 1, this.climbRate as int)
    writeUint(into, at + 33, 1, this.gpsNsat as int)
    writeUint(into, at + 34, 1, this.gpsFixType as int)
    writeUint(into, at + 35, 1, this.batteryRemaining as int)
    writeUint(into, at + 36, 1, this.temperature as int)
    writeUint(into, at + 37, 1, this.temperatureAir as int)
    writeUint(into, at + 38, 1, this.failsafe as int)
    writeUint(into, at + 39, 1, this.wpNum as int)
  }

  public override info(): MessageInfo {
    HighLatency.INFO
  }
}

/// Message appropriate for high latency connections like Iridium (version 2)
export class HighLatency2 extends MavLinkData {
  public static readonly MSG_ID: int = 235
  public static readonly MSG_NAME: string = "HIGH_LATENCY2"
  public static readonly PAYLOAD_LENGTH: int = 42
  public static readonly MAGIC_NUMBER: int = 179
  public static readonly INFO: MessageInfo = new MessageInfo(235, "HIGH_LATENCY2", 42, 42, 179, [
    new MavLinkPacketField("timestamp", "timestamp", 0, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("latitude", "latitude", 4, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("longitude", "longitude", 8, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("custom_mode", "customMode", 12, false, 2, "uint16_t", ""),
    new MavLinkPacketField("altitude", "altitude", 14, false, 2, "int16_t", "m"),
    new MavLinkPacketField("target_altitude", "targetAltitude", 16, false, 2, "int16_t", "m"),
