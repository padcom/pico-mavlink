      0 => "EMPTY",
      1 => "UNFORMATTED",
      2 => "READY",
      3 => "NOT_SUPPORTED",
      _ => null,
    }
  }
}

/// Flags to indicate the type of storage.
export class StorageType {
  /// Storage type is not known.
  public static readonly UNKNOWN: int = 0

  /// Storage type is USB device.
