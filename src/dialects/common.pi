    writeUint(into, at + 0, 1, this.targetSystem as int)
    writeUint(into, at + 1, 1, this.controlRequest as int)
    writeUint(into, at + 2, 1, this.version as int)
    writeChars(into, at + 3, 25, this.passkey)
  }

  public override info(): MessageInfo {
    ChangeOperatorControl.INFO
  }
}

