    m.timestamp = readU32(payload, 0)
    m.targetSystem = readU8(payload, 4)
    m.targetComponent = readU8(payload, 5)
    for (let i = 0; i < 20; i++) {
      m.idOrMac.push(readU8(payload, 6 + i * 1))
    }
    m.authenticationType = readU8(payload, 26)
    m.dataPage = readU8(payload, 27)
    m.lastPageIndex = readU8(payload, 28)
    m.length = readU8(payload, 29)
