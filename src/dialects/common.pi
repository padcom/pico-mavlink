}

/// Control vehicle tone generation (buzzer).
export class PlayTune extends MavLinkData {
  public static readonly MSG_ID: int = 258
  public static readonly MSG_NAME: string = "PLAY_TUNE"
  public static readonly PAYLOAD_LENGTH: int = 232
  public static readonly MAGIC_NUMBER: int = 187
  public static readonly INFO: MessageInfo = new MessageInfo(258, "PLAY_TUNE", 232, 32, 187, [
    new MavLinkPacketField("target_system", "targetSystem", 0, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 1, false, 1, "uint8_t", ""),
    new MavLinkPacketField("tune", "tune", 2, false, 1, "char[]", "", 30),
    new MavLinkPacketField("tune2", "tune2", 32, true, 1, "char[]", "", 200),
  ], (p) => PlayTune.decode(p))

  /// System ID
  public targetSystem: u8 = 0

  /// Component ID
  public targetComponent: u8 = 0

  /// tune in board specific format
  public tune: string = ""

  /// tune extension (appended to tune)
  public tune2: string = ""

  /// A PLAY_TUNE from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): PlayTune {
    const m = new PlayTune()
    m.targetSystem = readU8(payload, 0)
    m.targetComponent = readU8(payload, 1)
    m.tune = readChars(payload, 2, 30)
    m.tune2 = readChars(payload, 32, 200)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 1, this.targetSystem as int)
    writeUint(into, at + 1, 1, this.targetComponent as int)
    writeChars(into, at + 2, 30, this.tune)
    writeChars(into, at + 32, 200, this.tune2)
  }

  public override info(): MessageInfo {
    PlayTune.INFO
  }
}

/// Information about a camera. Can be requested with a MAV_CMD_REQUEST_MESSAGE command.
export class CameraInformation extends MavLinkData {
  public static readonly MSG_ID: int = 259
  public static readonly MSG_NAME: string = "CAMERA_INFORMATION"
  public static readonly PAYLOAD_LENGTH: int = 237
  public static readonly MAGIC_NUMBER: int = 92
  public static readonly INFO: MessageInfo = new MessageInfo(259, "CAMERA_INFORMATION", 237, 235, 92, [
    new MavLinkPacketField("time_boot_ms", "timeBootMs", 0, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("firmware_version", "firmwareVersion", 4, false, 4, "uint32_t", ""),
    new MavLinkPacketField("focal_length", "focalLength", 8, false, 4, "float", "mm"),
    new MavLinkPacketField("sensor_size_h", "sensorSizeH", 12, false, 4, "float", "mm"),
    new MavLinkPacketField("sensor_size_v", "sensorSizeV", 16, false, 4, "float", "mm"),
    new MavLinkPacketField("flags", "flags", 20, false, 4, "uint32_t", ""),
    new MavLinkPacketField("resolution_h", "resolutionH", 24, false, 2, "uint16_t", "pix"),
    new MavLinkPacketField("resolution_v", "resolutionV", 26, false, 2, "uint16_t", "pix"),
    new MavLinkPacketField("cam_definition_version", "camDefinitionVersion", 28, false, 2, "uint16_t", ""),
    new MavLinkPacketField("vendor_name", "vendorName", 30, false, 1, "uint8_t[]", "", 32),
    new MavLinkPacketField("model_name", "modelName", 62, false, 1, "uint8_t[]", "", 32),
    new MavLinkPacketField("lens_id", "lensId", 94, false, 1, "uint8_t", ""),
    new MavLinkPacketField("cam_definition_uri", "camDefinitionUri", 95, false, 1, "char[]", "", 140),
    new MavLinkPacketField("gimbal_device_id", "gimbalDeviceId", 235, true, 1, "uint8_t", ""),
    new MavLinkPacketField("camera_device_id", "cameraDeviceId", 236, true, 1, "uint8_t", ""),
  ], (p) => CameraInformation.decode(p))

  /// Timestamp (time since system boot).
  /// Units: ms.
  public timeBootMs: u32 = 0

  /// Name of the camera vendor
  public vendorName: u8[] = []

  /// Name of the camera model
  public modelName: u8[] = []

  /// Version of the camera firmware, encoded as: `(Dev & 0xff) << 24 + (Patch & 0xff) << 16 + (Minor &
  /// 0xff) << 8 + (Major & 0xff)`. Use 0 if not known.
  public firmwareVersion: u32 = 0

  /// Focal length. Use NaN if not known.
  /// Units: mm.
  public focalLength: f32 = 0.0

  /// Image sensor size horizontal. Use NaN if not known.
  /// Units: mm.
  public sensorSizeH: f32 = 0.0

  /// Image sensor size vertical. Use NaN if not known.
  /// Units: mm.
  public sensorSizeV: f32 = 0.0

  /// Horizontal image resolution. Use 0 if not known.
  /// Units: pix.
  public resolutionH: u16 = 0

  /// Vertical image resolution. Use 0 if not known.
  /// Units: pix.
  public resolutionV: u16 = 0

  /// Reserved for a lens ID. Use 0 if not known.
  public lensId: u8 = 0

  /// Bitmap of camera capability flags.
  /// Values: `CameraCapFlags`.
  public flags: u32 = 0

  /// Camera definition version (iteration). Use 0 if not known.
  public camDefinitionVersion: u16 = 0

  /// Camera definition URI (if any, otherwise only basic functions will be available). HTTP- (http://)
  /// and MAVLink FTP- (mavlinkftp://) formatted URIs are allowed (and both must be supported by any GCS
  /// that implements the Camera Protocol). The definition file may be xz compressed, which will be
  /// indicated by the file extension .xml.xz (a GCS that implements the protocol must support
  /// decompressing the file). The string needs to be zero terminated. Use a zero-length string if not
  /// known.
  public camDefinitionUri: string = ""

  /// Gimbal id of a gimbal associated with this camera. This is the component id of the gimbal device, or
  /// 1-6 for non mavlink gimbals. Use 0 if no gimbal is associated with the camera.
  public gimbalDeviceId: u8 = 0

  /// Camera id of a non-MAVLink camera attached to an autopilot (1-6). 0 if the component is a MAVLink
  /// camera (with its own component id).
  public cameraDeviceId: u8 = 0

  /// A CAMERA_INFORMATION from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): CameraInformation {
    const m = new CameraInformation()
    m.timeBootMs = readU32(payload, 0)
    m.firmwareVersion = readU32(payload, 4)
    m.focalLength = readF32(payload, 8)
    m.sensorSizeH = readF32(payload, 12)
    m.sensorSizeV = readF32(payload, 16)
    m.flags = readU32(payload, 20)
    m.resolutionH = readU16(payload, 24)
    m.resolutionV = readU16(payload, 26)
    m.camDefinitionVersion = readU16(payload, 28)
    for (let i = 0; i < 32; i++) {
      m.vendorName.push(readU8(payload, 30 + i * 1))
    }
    for (let i = 0; i < 32; i++) {
      m.modelName.push(readU8(payload, 62 + i * 1))
    }
    m.lensId = readU8(payload, 94)
    m.camDefinitionUri = readChars(payload, 95, 140)
    m.gimbalDeviceId = readU8(payload, 235)
    m.cameraDeviceId = readU8(payload, 236)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.timeBootMs as int)
    writeUint(into, at + 4, 4, this.firmwareVersion as int)
    writeF32(into, at + 8, this.focalLength)
    writeF32(into, at + 12, this.sensorSizeH)
    writeF32(into, at + 16, this.sensorSizeV)
    writeUint(into, at + 20, 4, this.flags as int)
    writeUint(into, at + 24, 2, this.resolutionH as int)
    writeUint(into, at + 26, 2, this.resolutionV as int)
    writeUint(into, at + 28, 2, this.camDefinitionVersion as int)
    for (let i = 0; i < 32 && i < this.vendorName.length; i++) {
      writeUint(into, at + 30 + i * 1, 1, this.vendorName[i] as int)
    }
    for (let i = 0; i < 32 && i < this.modelName.length; i++) {
      writeUint(into, at + 62 + i * 1, 1, this.modelName[i] as int)
    }
    writeUint(into, at + 94, 1, this.lensId as int)
    writeChars(into, at + 95, 140, this.camDefinitionUri)
    writeUint(into, at + 235, 1, this.gimbalDeviceId as int)
    writeUint(into, at + 236, 1, this.cameraDeviceId as int)
  }

  public override info(): MessageInfo {
    CameraInformation.INFO
  }
}

/// Settings of a camera. Can be requested with a MAV_CMD_REQUEST_MESSAGE command.
export class CameraSettings extends MavLinkData {
  public static readonly MSG_ID: int = 260
  public static readonly MSG_NAME: string = "CAMERA_SETTINGS"
