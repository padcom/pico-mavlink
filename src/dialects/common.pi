    writeUint(into, at + 44, 2, this.vx as int)
    writeUint(into, at + 46, 2, this.vy as int)
    writeUint(into, at + 48, 2, this.vz as int)
    writeUint(into, at + 50, 2, this.xacc as int)
    writeUint(into, at + 52, 2, this.yacc as int)
    writeUint(into, at + 54, 2, this.zacc as int)
  }

  public override info(): MessageInfo {
