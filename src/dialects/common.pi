/// Camera absolute thermal range. This can be streamed when the associated VIDEO_STREAM_STATUS `flag`
/// field bit VIDEO_STREAM_STATUS_FLAGS_THERMAL_RANGE_ENABLED is set, but a GCS may choose to only
/// request it for the current active stream. Use MAV_CMD_SET_MESSAGE_INTERVAL to define message
/// interval (param3 indicates the stream id of the current camera, or 0 for all streams, param4
/// indicates the target camera_device_id for autopilot-attached cameras or 0 for MAVLink cameras).
export class CameraThermalRange extends MavLinkData {
  public static readonly MSG_ID: int = 277
  public static readonly MSG_NAME: string = "CAMERA_THERMAL_RANGE"
  public static readonly PAYLOAD_LENGTH: int = 30
  public static readonly MAGIC_NUMBER: int = 62
  public static readonly INFO: MessageInfo = new MessageInfo(277, "CAMERA_THERMAL_RANGE", 30, 30, 62, [
    new MavLinkPacketField("time_boot_ms", "timeBootMs", 0, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("max", "max", 4, false, 4, "float", "degC"),
    new MavLinkPacketField("max_point_x", "maxPointX", 8, false, 4, "float", ""),
    new MavLinkPacketField("max_point_y", "maxPointY", 12, false, 4, "float", ""),
    new MavLinkPacketField("min", "min", 16, false, 4, "float", "degC"),
    new MavLinkPacketField("min_point_x", "minPointX", 20, false, 4, "float", ""),
    new MavLinkPacketField("min_point_y", "minPointY", 24, false, 4, "float", ""),
    new MavLinkPacketField("stream_id", "streamId", 28, false, 1, "uint8_t", ""),
    new MavLinkPacketField("camera_device_id", "cameraDeviceId", 29, false, 1, "uint8_t", ""),
  ], (p) => CameraThermalRange.decode(p))

  /// Timestamp (time since system boot).
  /// Units: ms.
  public timeBootMs: u32 = 0

  /// Video Stream ID (1 for first, 2 for second, etc.)
  public streamId: u8 = 0

  /// Camera id of a non-MAVLink camera attached to an autopilot (1-6). 0 if the component is a MAVLink
  /// camera (with its own component id).
  public cameraDeviceId: u8 = 0

  /// Temperature max.
  /// Units: degC.
  public max: f32 = 0.0

  /// Temperature max point x value (normalized 0..1, 0 is left, 1 is right), NAN if unknown.
  public maxPointX: f32 = 0.0

  /// Temperature max point y value (normalized 0..1, 0 is top, 1 is bottom), NAN if unknown.
  public maxPointY: f32 = 0.0

  /// Temperature min.
  /// Units: degC.
  public min: f32 = 0.0

  /// Temperature min point x value (normalized 0..1, 0 is left, 1 is right), NAN if unknown.
  public minPointX: f32 = 0.0

  /// Temperature min point y value (normalized 0..1, 0 is top, 1 is bottom), NAN if unknown.
  public minPointY: f32 = 0.0

  /// A CAMERA_THERMAL_RANGE from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): CameraThermalRange {
    const m = new CameraThermalRange()
    m.timeBootMs = readU32(payload, 0)
    m.max = readF32(payload, 4)
    m.maxPointX = readF32(payload, 8)
    m.maxPointY = readF32(payload, 12)
    m.min = readF32(payload, 16)
    m.minPointX = readF32(payload, 20)
    m.minPointY = readF32(payload, 24)
    m.streamId = readU8(payload, 28)
    m.cameraDeviceId = readU8(payload, 29)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.timeBootMs as int)
    writeF32(into, at + 4, this.max)
    writeF32(into, at + 8, this.maxPointX)
    writeF32(into, at + 12, this.maxPointY)
    writeF32(into, at + 16, this.min)
    writeF32(into, at + 20, this.minPointX)
    writeF32(into, at + 24, this.minPointY)
    writeUint(into, at + 28, 1, this.streamId as int)
    writeUint(into, at + 29, 1, this.cameraDeviceId as int)
  }

  public override info(): MessageInfo {
    CameraThermalRange.INFO
  }
}

/// Information about a high level gimbal manager. This message should be requested by a ground station
/// using MAV_CMD_REQUEST_MESSAGE.
export class GimbalManagerInformation extends MavLinkData {
  public static readonly MSG_ID: int = 280
  public static readonly MSG_NAME: string = "GIMBAL_MANAGER_INFORMATION"
  public static readonly PAYLOAD_LENGTH: int = 33
  public static readonly MAGIC_NUMBER: int = 70
  public static readonly INFO: MessageInfo = new MessageInfo(280, "GIMBAL_MANAGER_INFORMATION", 33, 33, 70, [
    new MavLinkPacketField("time_boot_ms", "timeBootMs", 0, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("cap_flags", "capFlags", 4, false, 4, "uint32_t", ""),
    new MavLinkPacketField("roll_min", "rollMin", 8, false, 4, "float", "rad"),
    new MavLinkPacketField("roll_max", "rollMax", 12, false, 4, "float", "rad"),
    new MavLinkPacketField("pitch_min", "pitchMin", 16, false, 4, "float", "rad"),
    new MavLinkPacketField("pitch_max", "pitchMax", 20, false, 4, "float", "rad"),
    new MavLinkPacketField("yaw_min", "yawMin", 24, false, 4, "float", "rad"),
    new MavLinkPacketField("yaw_max", "yawMax", 28, false, 4, "float", "rad"),
    new MavLinkPacketField("gimbal_device_id", "gimbalDeviceId", 32, false, 1, "uint8_t", ""),
  ], (p) => GimbalManagerInformation.decode(p))

  /// Timestamp (time since system boot).
  /// Units: ms.
  public timeBootMs: u32 = 0

  /// Bitmap of gimbal capability flags.
  /// Values: `GimbalManagerCapFlags`.
  public capFlags: u32 = 0

  /// Gimbal device ID that this gimbal manager is responsible for. Component ID of gimbal device (or 1-6
  /// for non-MAVLink gimbal).
  public gimbalDeviceId: u8 = 0

  /// Minimum hardware roll angle (positive: rolling to the right, negative: rolling to the left)
  /// Units: rad.
  public rollMin: f32 = 0.0

  /// Maximum hardware roll angle (positive: rolling to the right, negative: rolling to the left)
  /// Units: rad.
  public rollMax: f32 = 0.0

  /// Minimum pitch angle (positive: up, negative: down)
  /// Units: rad.
  public pitchMin: f32 = 0.0

  /// Maximum pitch angle (positive: up, negative: down)
  /// Units: rad.
  public pitchMax: f32 = 0.0

  /// Minimum yaw angle (positive: to the right, negative: to the left)
  /// Units: rad.
  public yawMin: f32 = 0.0

  /// Maximum yaw angle (positive: to the right, negative: to the left)
  /// Units: rad.
  public yawMax: f32 = 0.0

  /// A GIMBAL_MANAGER_INFORMATION from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): GimbalManagerInformation {
    const m = new GimbalManagerInformation()
    m.timeBootMs = readU32(payload, 0)
    m.capFlags = readU32(payload, 4)
    m.rollMin = readF32(payload, 8)
    m.rollMax = readF32(payload, 12)
    m.pitchMin = readF32(payload, 16)
    m.pitchMax = readF32(payload, 20)
    m.yawMin = readF32(payload, 24)
    m.yawMax = readF32(payload, 28)
    m.gimbalDeviceId = readU8(payload, 32)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.timeBootMs as int)
    writeUint(into, at + 4, 4, this.capFlags as int)
    writeF32(into, at + 8, this.rollMin)
    writeF32(into, at + 12, this.rollMax)
    writeF32(into, at + 16, this.pitchMin)
    writeF32(into, at + 20, this.pitchMax)
    writeF32(into, at + 24, this.yawMin)
    writeF32(into, at + 28, this.yawMax)
    writeUint(into, at + 32, 1, this.gimbalDeviceId as int)
  }

  public override info(): MessageInfo {
    GimbalManagerInformation.INFO
  }
}

/// Current status about a high level gimbal manager. This message should be broadcast at a low regular
/// rate (e.g. 5Hz).
export class GimbalManagerStatus extends MavLinkData {
  public static readonly MSG_ID: int = 281
  public static readonly MSG_NAME: string = "GIMBAL_MANAGER_STATUS"
  public static readonly PAYLOAD_LENGTH: int = 13
  public static readonly MAGIC_NUMBER: int = 48
  public static readonly INFO: MessageInfo = new MessageInfo(281, "GIMBAL_MANAGER_STATUS", 13, 13, 48, [
    new MavLinkPacketField("time_boot_ms", "timeBootMs", 0, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("flags", "flags", 4, false, 4, "uint32_t", ""),
    new MavLinkPacketField("gimbal_device_id", "gimbalDeviceId", 8, false, 1, "uint8_t", ""),
    new MavLinkPacketField("primary_control_sysid", "primaryControlSysid", 9, false, 1, "uint8_t", ""),
    new MavLinkPacketField("primary_control_compid", "primaryControlCompid", 10, false, 1, "uint8_t", ""),
    new MavLinkPacketField("secondary_control_sysid", "secondaryControlSysid", 11, false, 1, "uint8_t", ""),
    new MavLinkPacketField("secondary_control_compid", "secondaryControlCompid", 12, false, 1, "uint8_t", ""),
  ], (p) => GimbalManagerStatus.decode(p))

  /// Timestamp (time since system boot).
  /// Units: ms.
  public timeBootMs: u32 = 0

  /// High level gimbal manager flags currently applied.
  /// Values: `GimbalManagerFlags`.
  public flags: u32 = 0

  /// Gimbal device ID that this gimbal manager is responsible for. Component ID of gimbal device (or 1-6
  /// for non-MAVLink gimbal).
  public gimbalDeviceId: u8 = 0

  /// System ID of MAVLink component with primary control, 0 for none.
  public primaryControlSysid: u8 = 0

  /// Component ID of MAVLink component with primary control, 0 for none.
  public primaryControlCompid: u8 = 0

  /// System ID of MAVLink component with secondary control, 0 for none.
  public secondaryControlSysid: u8 = 0

  /// Component ID of MAVLink component with secondary control, 0 for none.
  public secondaryControlCompid: u8 = 0

  /// A GIMBAL_MANAGER_STATUS from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): GimbalManagerStatus {
    const m = new GimbalManagerStatus()
    m.timeBootMs = readU32(payload, 0)
    m.flags = readU32(payload, 4)
    m.gimbalDeviceId = readU8(payload, 8)
    m.primaryControlSysid = readU8(payload, 9)
    m.primaryControlCompid = readU8(payload, 10)
    m.secondaryControlSysid = readU8(payload, 11)
    m.secondaryControlCompid = readU8(payload, 12)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.timeBootMs as int)
    writeUint(into, at + 4, 4, this.flags as int)
    writeUint(into, at + 8, 1, this.gimbalDeviceId as int)
    writeUint(into, at + 9, 1, this.primaryControlSysid as int)
    writeUint(into, at + 10, 1, this.primaryControlCompid as int)
    writeUint(into, at + 11, 1, this.secondaryControlSysid as int)
    writeUint(into, at + 12, 1, this.secondaryControlCompid as int)
  }

  public override info(): MessageInfo {
    GimbalManagerStatus.INFO
  }
}

/// High level message to control a gimbal's attitude. This message is to be sent to the gimbal manager
/// (e.g. from a ground station). Angles and rates can be set to NaN according to use case.
export class GimbalManagerSetAttitude extends MavLinkData {
  public static readonly MSG_ID: int = 282
  public static readonly MSG_NAME: string = "GIMBAL_MANAGER_SET_ATTITUDE"
  public static readonly PAYLOAD_LENGTH: int = 35
  public static readonly MAGIC_NUMBER: int = 123
  public static readonly INFO: MessageInfo = new MessageInfo(282, "GIMBAL_MANAGER_SET_ATTITUDE", 35, 35, 123, [
    new MavLinkPacketField("flags", "flags", 0, false, 4, "uint32_t", ""),
    new MavLinkPacketField("q", "q", 4, false, 4, "float[]", "", 4),
    new MavLinkPacketField("angular_velocity_x", "angularVelocityX", 20, false, 4, "float", "rad/s"),
    new MavLinkPacketField("angular_velocity_y", "angularVelocityY", 24, false, 4, "float", "rad/s"),
    new MavLinkPacketField("angular_velocity_z", "angularVelocityZ", 28, false, 4, "float", "rad/s"),
    new MavLinkPacketField("target_system", "targetSystem", 32, false, 1, "uint8_t", ""),
    new MavLinkPacketField("target_component", "targetComponent", 33, false, 1, "uint8_t", ""),
    new MavLinkPacketField("gimbal_device_id", "gimbalDeviceId", 34, false, 1, "uint8_t", ""),
  ], (p) => GimbalManagerSetAttitude.decode(p))

  /// System ID
  public targetSystem: u8 = 0

  /// Component ID
  public targetComponent: u8 = 0

  /// High level gimbal manager flags to use.
  /// Values: `GimbalManagerFlags`.
  public flags: u32 = 0

  /// Component ID of gimbal device to address (or 1-6 for non-MAVLink gimbal), 0 for all gimbal device
  /// components. Send command multiple times for more than one gimbal (but not all gimbals).
  public gimbalDeviceId: u8 = 0

  /// Quaternion components, w, x, y, z (1 0 0 0 is the null-rotation, the frame is depends on whether the
  /// flag GIMBAL_MANAGER_FLAGS_YAW_LOCK is set)
  public q: f32[] = []

  /// X component of angular velocity, positive is rolling to the right, NaN to be ignored.
  /// Units: rad/s.
  public angularVelocityX: f32 = 0.0

  /// Y component of angular velocity, positive is pitching up, NaN to be ignored.
  /// Units: rad/s.
  public angularVelocityY: f32 = 0.0

  /// Z component of angular velocity, positive is yawing to the right, NaN to be ignored.
  /// Units: rad/s.
  public angularVelocityZ: f32 = 0.0

  /// A GIMBAL_MANAGER_SET_ATTITUDE from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): GimbalManagerSetAttitude {
    const m = new GimbalManagerSetAttitude()
    m.flags = readU32(payload, 0)
    for (let i = 0; i < 4; i++) {
      m.q.push(readF32(payload, 4 + i * 4))
    }
    m.angularVelocityX = readF32(payload, 20)
    m.angularVelocityY = readF32(payload, 24)
    m.angularVelocityZ = readF32(payload, 28)
    m.targetSystem = readU8(payload, 32)
    m.targetComponent = readU8(payload, 33)
    m.gimbalDeviceId = readU8(payload, 34)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.flags as int)
    for (let i = 0; i < 4 && i < this.q.length; i++) {
      writeF32(into, at + 4 + i * 4, this.q[i])
    }
    writeF32(into, at + 20, this.angularVelocityX)
    writeF32(into, at + 24, this.angularVelocityY)
    writeF32(into, at + 28, this.angularVelocityZ)
    writeUint(into, at + 32, 1, this.targetSystem as int)
    writeUint(into, at + 33, 1, this.targetComponent as int)
    writeUint(into, at + 34, 1, this.gimbalDeviceId as int)
  }

  public override info(): MessageInfo {
    GimbalManagerSetAttitude.INFO
  }
}

/// Information about a low level gimbal. This message should be requested by the gimbal manager or a
/// ground station using MAV_CMD_REQUEST_MESSAGE. The maximum angles and rates are the limits by
/// hardware. However, the limits by software used are likely different/smaller and dependent on
/// mode/settings/etc..
export class GimbalDeviceInformation extends MavLinkData {
