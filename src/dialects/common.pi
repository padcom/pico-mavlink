    new MavLinkPacketField("pressure_alt", "pressureAlt", 52, false, 4, "float", ""),
    new MavLinkPacketField("temperature", "temperature", 56, false, 4, "float", "degC"),
    new MavLinkPacketField("fields_updated", "fieldsUpdated", 60, false, 2, "uint16_t", ""),
    new MavLinkPacketField("id", "id", 62, true, 1, "uint8_t", ""),
  ], (p) => HighresImu.decode(p))

  /// Timestamp (UNIX Epoch time or time since system boot). The receiving end can infer timestamp format
  /// (since 1.1.1970 or since system boot) by checking for the magnitude of the number.
  /// Units: us.
  public timeUsec: u64 = 0

  /// X acceleration
  /// Units: m/s/s.
  public xacc: f32 = 0.0

  /// Y acceleration
  /// Units: m/s/s.
  public yacc: f32 = 0.0

  /// Z acceleration
  /// Units: m/s/s.
  public zacc: f32 = 0.0

  /// Angular speed around X axis
  /// Units: rad/s.
  public xgyro: f32 = 0.0

  /// Angular speed around Y axis
  /// Units: rad/s.
  public ygyro: f32 = 0.0

  /// Angular speed around Z axis
  /// Units: rad/s.
  public zgyro: f32 = 0.0

  /// X Magnetic field
  /// Units: gauss.
  public xmag: f32 = 0.0

  /// Y Magnetic field
  /// Units: gauss.
  public ymag: f32 = 0.0

  /// Z Magnetic field
  /// Units: gauss.
  public zmag: f32 = 0.0

  /// Absolute pressure
  /// Units: hPa.
  public absPressure: f32 = 0.0

  /// Differential pressure
  /// Units: hPa.
  public diffPressure: f32 = 0.0

  /// Altitude calculated from pressure
  public pressureAlt: f32 = 0.0

  /// Temperature
  /// Units: degC.
  public temperature: f32 = 0.0

  /// Bitmap for fields that have updated since last message
  /// Values: `HighresImuUpdatedFlags`.
  public fieldsUpdated: u16 = 0

  /// Id. Ids are numbered from 0 and map to IMUs numbered from 1 (e.g. IMU1 will have a message with
  /// id=0)
  public id: u8 = 0

  /// A HIGHRES_IMU from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): HighresImu {
    const m = new HighresImu()
    m.timeUsec = readU64(payload, 0)
    m.xacc = readF32(payload, 8)
    m.yacc = readF32(payload, 12)
    m.zacc = readF32(payload, 16)
    m.xgyro = readF32(payload, 20)
    m.ygyro = readF32(payload, 24)
    m.zgyro = readF32(payload, 28)
    m.xmag = readF32(payload, 32)
    m.ymag = readF32(payload, 36)
    m.zmag = readF32(payload, 40)
    m.absPressure = readF32(payload, 44)
    m.diffPressure = readF32(payload, 48)
    m.pressureAlt = readF32(payload, 52)
    m.temperature = readF32(payload, 56)
    m.fieldsUpdated = readU16(payload, 60)
    m.id = readU8(payload, 62)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    writeF32(into, at + 8, this.xacc)
    writeF32(into, at + 12, this.yacc)
    writeF32(into, at + 16, this.zacc)
    writeF32(into, at + 20, this.xgyro)
    writeF32(into, at + 24, this.ygyro)
    writeF32(into, at + 28, this.zgyro)
    writeF32(into, at + 32, this.xmag)
    writeF32(into, at + 36, this.ymag)
    writeF32(into, at + 40, this.zmag)
    writeF32(into, at + 44, this.absPressure)
    writeF32(into, at + 48, this.diffPressure)
    writeF32(into, at + 52, this.pressureAlt)
    writeF32(into, at + 56, this.temperature)
    writeUint(into, at + 60, 2, this.fieldsUpdated as int)
    writeUint(into, at + 62, 1, this.id as int)
  }

  public override info(): MessageInfo {
    HighresImu.INFO
  }
}

/// Optical flow from an angular rate flow sensor (e.g. PX4FLOW or mouse sensor)
export class OpticalFlowRad extends MavLinkData {
  public static readonly MSG_ID: int = 106
  public static readonly MSG_NAME: string = "OPTICAL_FLOW_RAD"
  public static readonly PAYLOAD_LENGTH: int = 44
  public static readonly MAGIC_NUMBER: int = 138
  public static readonly INFO: MessageInfo = new MessageInfo(106, "OPTICAL_FLOW_RAD", 44, 44, 138, [
    new MavLinkPacketField("time_usec", "timeUsec", 0, false, 8, "uint64_t", "us"),
    new MavLinkPacketField("integration_time_us", "integrationTimeUs", 8, false, 4, "uint32_t", "us"),
    new MavLinkPacketField("integrated_x", "integratedX", 12, false, 4, "float", "rad"),
    new MavLinkPacketField("integrated_y", "integratedY", 16, false, 4, "float", "rad"),
    new MavLinkPacketField("integrated_xgyro", "integratedXgyro", 20, false, 4, "float", "rad"),
    new MavLinkPacketField("integrated_ygyro", "integratedYgyro", 24, false, 4, "float", "rad"),
    new MavLinkPacketField("integrated_zgyro", "integratedZgyro", 28, false, 4, "float", "rad"),
    new MavLinkPacketField("time_delta_distance_us", "timeDeltaDistanceUs", 32, false, 4, "uint32_t", "us"),
    new MavLinkPacketField("distance", "distance", 36, false, 4, "float", "m"),
    new MavLinkPacketField("temperature", "temperature", 40, false, 2, "int16_t", "cdegC"),
    new MavLinkPacketField("sensor_id", "sensorId", 42, false, 1, "uint8_t", ""),
    new MavLinkPacketField("quality", "quality", 43, false, 1, "uint8_t", ""),
  ], (p) => OpticalFlowRad.decode(p))

  /// Timestamp (UNIX Epoch time or time since system boot). The receiving end can infer timestamp format
  /// (since 1.1.1970 or since system boot) by checking for the magnitude of the number.
  /// Units: us.
  public timeUsec: u64 = 0

  /// Sensor ID
  public sensorId: u8 = 0

  /// Integration time. Divide integrated_x and integrated_y by the integration time to obtain average
  /// flow. The integration time also indicates the.
  /// Units: us.
  public integrationTimeUs: u32 = 0

  /// Flow around X axis (Sensor RH rotation about the X axis induces a positive flow. Sensor linear
  /// motion along the positive Y axis induces a negative flow.)
  /// Units: rad.
  public integratedX: f32 = 0.0

  /// Flow around Y axis (Sensor RH rotation about the Y axis induces a positive flow. Sensor linear
  /// motion along the positive X axis induces a positive flow.)
  /// Units: rad.
  public integratedY: f32 = 0.0

  /// RH rotation around X axis
  /// Units: rad.
  public integratedXgyro: f32 = 0.0

  /// RH rotation around Y axis
  /// Units: rad.
  public integratedYgyro: f32 = 0.0

  /// RH rotation around Z axis
  /// Units: rad.
  public integratedZgyro: f32 = 0.0

  /// Temperature
  /// Units: cdegC.
  public temperature: i16 = 0

  /// Optical flow quality / confidence. 0: no valid flow, 255: maximum quality
  public quality: u8 = 0

  /// Time since the distance was sampled.
  /// Units: us.
  public timeDeltaDistanceUs: u32 = 0

  /// Distance to the center of the flow field. Positive value (including zero): distance known. Negative
  /// value: Unknown distance.
  /// Units: m.
  public distance: f32 = 0.0

  /// A OPTICAL_FLOW_RAD from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): OpticalFlowRad {
    const m = new OpticalFlowRad()
    m.timeUsec = readU64(payload, 0)
    m.integrationTimeUs = readU32(payload, 8)
    m.integratedX = readF32(payload, 12)
    m.integratedY = readF32(payload, 16)
    m.integratedXgyro = readF32(payload, 20)
    m.integratedYgyro = readF32(payload, 24)
    m.integratedZgyro = readF32(payload, 28)
    m.timeDeltaDistanceUs = readU32(payload, 32)
    m.distance = readF32(payload, 36)
    m.temperature = readI16(payload, 40)
    m.sensorId = readU8(payload, 42)
    m.quality = readU8(payload, 43)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    writeUint(into, at + 8, 4, this.integrationTimeUs as int)
    writeF32(into, at + 12, this.integratedX)
    writeF32(into, at + 16, this.integratedY)
    writeF32(into, at + 20, this.integratedXgyro)
    writeF32(into, at + 24, this.integratedYgyro)
    writeF32(into, at + 28, this.integratedZgyro)
    writeUint(into, at + 32, 4, this.timeDeltaDistanceUs as int)
    writeF32(into, at + 36, this.distance)
    writeUint(into, at + 40, 2, this.temperature as int)
    writeUint(into, at + 42, 1, this.sensorId as int)
    writeUint(into, at + 43, 1, this.quality as int)
  }

  public override info(): MessageInfo {
    OpticalFlowRad.INFO
  }
}

