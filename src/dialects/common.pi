    m.progress = readU8(payload, 3)
    m.resultParam2 = readI32(payload, 4)
    m.targetSystem = readU8(payload, 8)
    m.targetComponent = readU8(payload, 9)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 2, this.command as int)
    writeUint(into, at + 2, 1, this.result as int)
    writeUint(into, at + 3, 1, this.progress as int)
    writeUint(into, at + 4, 4, this.resultParam2 as int)
    writeUint(into, at + 8, 1, this.targetSystem as int)
    writeUint(into, at + 9, 1, this.targetComponent as int)
  }

  public override info(): MessageInfo {
    CommandAck.INFO
  }
}

