    m.roll = readF32(payload, 8)
    m.pitch = readF32(payload, 12)
    m.yaw = readF32(payload, 16)
    m.rollspeed = readF32(payload, 20)
    m.pitchspeed = readF32(payload, 24)
    m.yawspeed = readF32(payload, 28)
    m.lat = readI32(payload, 32)
    m.lon = readI32(payload, 36)
    m.alt = readI32(payload, 40)
    m.vx = readI16(payload, 44)
    m.vy = readI16(payload, 46)
    m.vz = readI16(payload, 48)
    m.xacc = readI16(payload, 50)
    m.yacc = readI16(payload, 52)
    m.zacc = readI16(payload, 54)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.timeUsec)
    writeF32(into, at + 8, this.roll)
    writeF32(into, at + 12, this.pitch)
    writeF32(into, at + 16, this.yaw)
    writeF32(into, at + 20, this.rollspeed)
    writeF32(into, at + 24, this.pitchspeed)
    writeF32(into, at + 28, this.yawspeed)
    writeUint(into, at + 32, 4, this.lat as int)
    writeUint(into, at + 36, 4, this.lon as int)
