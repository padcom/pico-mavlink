  }
}

/// Result from a MAVLink command (MAV_CMD)
export class MavResult {
  /// Command is valid (is supported and has valid parameters), and was executed.
  public static readonly ACCEPTED: int = 0

  /// Command is valid, but cannot be executed at this time. This is used to indicate a problem that
  /// should be fixed just by waiting (e.g. a state machine is busy, can't arm because have not got GPS
  /// lock, etc.). Retrying later should work.
  public static readonly TEMPORARILY_REJECTED: int = 1

  /// Command is invalid; it is supported but one or more parameter values are invalid (i.e. parameter
  /// reserved, value allowed by spec but not supported by flight stack, and so on). Retrying the same
  /// command and parameters will not work.
  public static readonly DENIED: int = 2

  /// Command is not supported (unknown).
  public static readonly UNSUPPORTED: int = 3

  /// Command is valid, but execution has failed. This is used to indicate any non-temporary or unexpected
  /// problem, i.e. any problem that must be fixed before the command can succeed/be retried. For example,
  /// attempting to write a file when out of memory, attempting to arm when sensors are not calibrated,
  /// etc.
  public static readonly FAILED: int = 4

  /// Command is valid and is being executed. This will be followed by further progress updates, i.e. the
  /// component may send further COMMAND_ACK messages with result MAV_RESULT_IN_PROGRESS (at a rate
  /// decided by the implementation), and must terminate by sending a COMMAND_ACK message with final
  /// result of the operation. The COMMAND_ACK.progress field can be used to indicate the progress of the
  /// operation.
  public static readonly IN_PROGRESS: int = 5

  /// Command has been cancelled (as a result of receiving a COMMAND_CANCEL message).
  public static readonly CANCELLED: int = 6

  /// Command is only accepted when sent as a COMMAND_LONG.
  public static readonly COMMAND_LONG_ONLY: int = 7

  /// Command is only accepted when sent as a COMMAND_INT.
  public static readonly COMMAND_INT_ONLY: int = 8

  /// Command is invalid because a frame is required and the specified frame is not supported.
  public static readonly COMMAND_UNSUPPORTED_MAV_FRAME: int = 9

  /// Command has been rejected because source system is not in control of the target system/component.
  public static readonly NOT_IN_CONTROL: int = 10

  /// The name of `value` (`ACCEPTED` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "ACCEPTED",
      1 => "TEMPORARILY_REJECTED",
      2 => "DENIED",
      3 => "UNSUPPORTED",
      4 => "FAILED",
      5 => "IN_PROGRESS",
      6 => "CANCELLED",
      7 => "COMMAND_LONG_ONLY",
      8 => "COMMAND_INT_ONLY",
      9 => "COMMAND_UNSUPPORTED_MAV_FRAME",
      10 => "NOT_IN_CONTROL",
      _ => null,
    }
  }
}

/// Result of mission operation (in a MISSION_ACK message).
export class MavMissionResult {
  /// mission accepted OK
  public static readonly ACCEPTED: int = 0

  /// Generic error / not accepting mission commands at all right now.
  public static readonly ERROR: int = 1

  /// Coordinate frame is not supported.
  public static readonly UNSUPPORTED_FRAME: int = 2

  /// Command is not supported.
  public static readonly UNSUPPORTED: int = 3

  /// Mission items exceed storage space.
  public static readonly NO_SPACE: int = 4

  /// One of the parameters has an invalid value.
  public static readonly INVALID: int = 5

  /// param1 has an invalid value.
  public static readonly INVALID_PARAM1: int = 6

  /// param2 has an invalid value.
  public static readonly INVALID_PARAM2: int = 7

  /// param3 has an invalid value.
  public static readonly INVALID_PARAM3: int = 8

  /// param4 has an invalid value.
  public static readonly INVALID_PARAM4: int = 9

  /// x / param5 has an invalid value.
  public static readonly INVALID_PARAM5_X: int = 10

  /// y / param6 has an invalid value.
  public static readonly INVALID_PARAM6_Y: int = 11

  /// z / param7 has an invalid value.
  public static readonly INVALID_PARAM7: int = 12

  /// Mission item received out of sequence
  public static readonly INVALID_SEQUENCE: int = 13

  /// Not accepting any mission commands from this communication partner.
  public static readonly DENIED: int = 14

  /// Current mission operation cancelled (e.g. mission upload, mission download).
  public static readonly OPERATION_CANCELLED: int = 15

  /// The name of `value` (`ACCEPTED` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "ACCEPTED",
      1 => "ERROR",
      2 => "UNSUPPORTED_FRAME",
      3 => "UNSUPPORTED",
      4 => "NO_SPACE",
      5 => "INVALID",
      6 => "INVALID_PARAM1",
      7 => "INVALID_PARAM2",
      8 => "INVALID_PARAM3",
      9 => "INVALID_PARAM4",
      10 => "INVALID_PARAM5_X",
      11 => "INVALID_PARAM6_Y",
      12 => "INVALID_PARAM7",
      13 => "INVALID_SEQUENCE",
      14 => "DENIED",
      15 => "OPERATION_CANCELLED",
      _ => null,
    }
  }
}

/// Indicates the severity level, generally used for status messages to indicate their relative urgency.
/// Based on RFC-5424 using expanded definitions at:
/// http://www.kiwisyslog.com/kb/info:-syslog-message-levels/.
export class MavSeverity {
  /// System is unusable. This is a "panic" condition.
  public static readonly EMERGENCY: int = 0

  /// Action should be taken immediately. Indicates error in non-critical systems.
  public static readonly ALERT: int = 1

  /// Action must be taken immediately. Indicates failure in a primary system.
  public static readonly CRITICAL: int = 2

  /// Indicates an error in secondary/redundant systems.
  public static readonly ERROR: int = 3

  /// Indicates about a possible future error if this is not resolved within a given timeframe. Example
  /// would be a low battery warning.
  public static readonly WARNING: int = 4

  /// An unusual event has occurred, though not an error condition. This should be investigated for the
  /// root cause.
  public static readonly NOTICE: int = 5

  /// Normal operational messages. Useful for logging. No action is required for these messages.
  public static readonly INFO: int = 6

  /// Useful non-operational messages that can assist in debugging. These should not occur during normal
  /// operation.
  public static readonly DEBUG: int = 7

  /// The name of `value` (`EMERGENCY` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "EMERGENCY",
      1 => "ALERT",
      2 => "CRITICAL",
      3 => "ERROR",
      4 => "WARNING",
      5 => "NOTICE",
      6 => "INFO",
      7 => "DEBUG",
      _ => null,
    }
  }
}

/// Power supply status flags (bitmask)
export class MavPowerStatus {
  /// main brick power supply valid
