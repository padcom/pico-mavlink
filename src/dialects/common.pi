  /// peripheral supply is in over-current state
  public static readonly PERIPH_OVERCURRENT: int = 8

  /// hi-power peripheral supply is in over-current state
  public static readonly PERIPH_HIPOWER_OVERCURRENT: int = 16

  /// Power status has changed since boot
  public static readonly CHANGED: int = 32

  /// The name of `value` (`BRICK_VALID` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      1 => "BRICK_VALID",
      2 => "SERVO_VALID",
      4 => "USB_CONNECTED",
      8 => "PERIPH_OVERCURRENT",
      16 => "PERIPH_HIPOWER_OVERCURRENT",
      32 => "CHANGED",
      _ => null,
    }
  }
}

