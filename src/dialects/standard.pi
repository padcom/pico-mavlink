/// Enum used to indicate true or false (also: success or failure, enabled or disabled, active or
/// inactive).
export class MavBool {
  /// False.
  public static readonly FALSE: int = 0

  /// True.
  public static readonly TRUE: int = 1

  /// The name of `value` (`FALSE` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "FALSE",
      1 => "TRUE",
      _ => null,
    }
  }
}

/// Bitmask of (optional) autopilot capabilities (64 bit). If a bit is set, the autopilot supports this
/// capability.
export class MavProtocolCapability {
  /// Autopilot supports the MISSION_ITEM float message type. Note that MISSION_ITEM is deprecated, and
  /// autopilots should use MISSION_ITEM_INT instead.
  public static readonly MISSION_FLOAT: int = 1

  /// Autopilot supports the new param float message type.
  public static readonly PARAM_FLOAT: int = 2

  /// Autopilot supports MISSION_ITEM_INT scaled integer message type. Note that this flag must always be
  /// set if missions are supported, because missions must always use MISSION_ITEM_INT (rather than
  /// MISSION_ITEM, which is deprecated).
  public static readonly MISSION_INT: int = 4

  /// Autopilot supports COMMAND_INT scaled integer message type.
  public static readonly COMMAND_INT: int = 8

  /// Parameter protocol uses byte-wise encoding of parameter values into param_value (float) fields:
  /// https://mavlink.io/en/services/parameter.html#parameter-encoding. Note that either this flag or
  /// MAV_PROTOCOL_CAPABILITY_PARAM_ENCODE_C_CAST should be set if the parameter protocol is supported.
  public static readonly PARAM_ENCODE_BYTEWISE: int = 16

  /// Autopilot supports the File Transfer Protocol v1: https://mavlink.io/en/services/ftp.html.
  public static readonly FTP: int = 32

  /// Autopilot supports commanding attitude offboard.
  public static readonly SET_ATTITUDE_TARGET: int = 64

  /// Autopilot supports commanding position and velocity targets in local NED frame.
  public static readonly SET_POSITION_TARGET_LOCAL_NED: int = 128

  /// Autopilot supports commanding position and velocity targets in global scaled integers.
  public static readonly SET_POSITION_TARGET_GLOBAL_INT: int = 256

  /// Autopilot supports terrain protocol / data handling.
  public static readonly TERRAIN: int = 512

  /// Reserved for future use.
  public static readonly RESERVED3: int = 1024

  /// Autopilot supports the MAV_CMD_DO_FLIGHTTERMINATION command (flight termination).
  public static readonly FLIGHT_TERMINATION: int = 2048

  /// Autopilot supports onboard compass calibration.
  public static readonly COMPASS_CALIBRATION: int = 4096

  /// Autopilot supports MAVLink version 2.
  public static readonly MAVLINK2: int = 8192

  /// Autopilot supports mission fence protocol.
  public static readonly MISSION_FENCE: int = 16384

  /// Autopilot supports mission rally point protocol.
  public static readonly MISSION_RALLY: int = 32768

  /// Reserved for future use.
  public static readonly RESERVED2: int = 65536

  /// Parameter protocol uses C-cast of parameter values to set the param_value (float) fields:
  /// https://mavlink.io/en/services/parameter.html#parameter-encoding. Note that either this flag or
  /// MAV_PROTOCOL_CAPABILITY_PARAM_ENCODE_BYTEWISE should be set if the parameter protocol is supported.
  public static readonly PARAM_ENCODE_C_CAST: int = 131072

  /// This component implements/is a gimbal manager. This means the GIMBAL_MANAGER_INFORMATION, and other
  /// messages can be requested.
  public static readonly COMPONENT_IMPLEMENTS_GIMBAL_MANAGER: int = 262144

  /// Component supports locking control to a particular GCS independent of its system (via
  /// MAV_CMD_REQUEST_OPERATOR_CONTROL).
  public static readonly COMPONENT_ACCEPTS_GCS_CONTROL: int = 524288

  /// Autopilot has a connected gripper. MAVLink Grippers would set MAV_TYPE_GRIPPER instead.
  public static readonly GRIPPER: int = 1048576

  /// The name of `value` (`MISSION_FLOAT` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      1 => "MISSION_FLOAT",
      2 => "PARAM_FLOAT",
      4 => "MISSION_INT",
      8 => "COMMAND_INT",
      16 => "PARAM_ENCODE_BYTEWISE",
      32 => "FTP",
      64 => "SET_ATTITUDE_TARGET",
      128 => "SET_POSITION_TARGET_LOCAL_NED",
      256 => "SET_POSITION_TARGET_GLOBAL_INT",
      512 => "TERRAIN",
      1024 => "RESERVED3",
      2048 => "FLIGHT_TERMINATION",
      4096 => "COMPASS_CALIBRATION",
      8192 => "MAVLINK2",
      16384 => "MISSION_FENCE",
      32768 => "MISSION_RALLY",
      65536 => "RESERVED2",
      131072 => "PARAM_ENCODE_C_CAST",
      262144 => "COMPONENT_IMPLEMENTS_GIMBAL_MANAGER",
      524288 => "COMPONENT_ACCEPTS_GCS_CONTROL",
      1048576 => "GRIPPER",
      _ => null,
    }
  }
}

/// These values define the type of firmware release. These values indicate the first version or release
/// of this type. For example the first alpha release would be 64, the second would be 65.
export class FirmwareVersionType {
  /// development release
  public static readonly DEV: int = 0

  /// alpha release
  public static readonly ALPHA: int = 64

  /// beta release
  public static readonly BETA: int = 128

  /// release candidate
  public static readonly RC: int = 192

  /// official stable release
  public static readonly OFFICIAL: int = 255

  /// The name of `value` (`DEV` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "DEV",
      64 => "ALPHA",
      128 => "BETA",
      192 => "RC",
      255 => "OFFICIAL",
      _ => null,
    }
  }
}

/// The filtered global position (e.g. fused GPS and accelerometers). The position is in GPS-frame
/// (right-handed, Z-up). It is designed as scaled integer message since the resolution of float is not
/// sufficient.
export class GlobalPositionInt extends MavLinkData {
  public static readonly MSG_ID: int = 33
  public static readonly MSG_NAME: string = "GLOBAL_POSITION_INT"
  public static readonly PAYLOAD_LENGTH: int = 28
  public static readonly MAGIC_NUMBER: int = 104
  public static readonly INFO: MessageInfo = new MessageInfo(33, "GLOBAL_POSITION_INT", 28, 28, 104, [
    new MavLinkPacketField("time_boot_ms", "timeBootMs", 0, false, 4, "uint32_t", "ms"),
    new MavLinkPacketField("lat", "lat", 4, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("lon", "lon", 8, false, 4, "int32_t", "degE7"),
    new MavLinkPacketField("alt", "alt", 12, false, 4, "int32_t", "mm"),
    new MavLinkPacketField("relative_alt", "relativeAlt", 16, false, 4, "int32_t", "mm"),
    new MavLinkPacketField("vx", "vx", 20, false, 2, "int16_t", "cm/s"),
    new MavLinkPacketField("vy", "vy", 22, false, 2, "int16_t", "cm/s"),
    new MavLinkPacketField("vz", "vz", 24, false, 2, "int16_t", "cm/s"),
    new MavLinkPacketField("hdg", "hdg", 26, false, 2, "uint16_t", "cdeg"),
  ], (p) => GlobalPositionInt.decode(p))

  /// Timestamp (time since system boot).
  /// Units: ms.
  public timeBootMs: u32 = 0

  /// Latitude, expressed
  /// Units: degE7.
  public lat: i32 = 0

  /// Longitude, expressed
  /// Units: degE7.
  public lon: i32 = 0

  /// Altitude (MSL). Note that virtually all GPS modules provide both WGS84 and MSL.
  /// Units: mm.
  public alt: i32 = 0

  /// Altitude above home
  /// Units: mm.
  public relativeAlt: i32 = 0

  /// Ground X Speed (Latitude, positive north)
  /// Units: cm/s.
  public vx: i16 = 0

  /// Ground Y Speed (Longitude, positive east)
  /// Units: cm/s.
  public vy: i16 = 0

  /// Ground Z Speed (Altitude, positive down)
  /// Units: cm/s.
  public vz: i16 = 0

  /// Vehicle heading (yaw angle), 0.0..359.99 degrees. If unknown, set to: UINT16_MAX
  /// Units: cdeg.
  public hdg: u16 = 0

  /// A GLOBAL_POSITION_INT from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): GlobalPositionInt {
    const m = new GlobalPositionInt()
    m.timeBootMs = readU32(payload, 0)
    m.lat = readI32(payload, 4)
    m.lon = readI32(payload, 8)
    m.alt = readI32(payload, 12)
    m.relativeAlt = readI32(payload, 16)
    m.vx = readI16(payload, 20)
    m.vy = readI16(payload, 22)
    m.vz = readI16(payload, 24)
    m.hdg = readU16(payload, 26)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.timeBootMs as int)
    writeUint(into, at + 4, 4, this.lat as int)
    writeUint(into, at + 8, 4, this.lon as int)
    writeUint(into, at + 12, 4, this.alt as int)
    writeUint(into, at + 16, 4, this.relativeAlt as int)
    writeUint(into, at + 20, 2, this.vx as int)
    writeUint(into, at + 22, 2, this.vy as int)
    writeUint(into, at + 24, 2, this.vz as int)
    writeUint(into, at + 26, 2, this.hdg as int)
  }

  public override info(): MessageInfo {
    GlobalPositionInt.INFO
  }
}

/// Version and capability of autopilot software. This should be emitted in response to a request with
/// MAV_CMD_REQUEST_MESSAGE.
export class AutopilotVersion extends MavLinkData {
  public static readonly MSG_ID: int = 148
  public static readonly MSG_NAME: string = "AUTOPILOT_VERSION"
  public static readonly PAYLOAD_LENGTH: int = 78
  public static readonly MAGIC_NUMBER: int = 178
  public static readonly INFO: MessageInfo = new MessageInfo(148, "AUTOPILOT_VERSION", 78, 60, 178, [
    new MavLinkPacketField("capabilities", "capabilities", 0, false, 8, "uint64_t", ""),
    new MavLinkPacketField("uid", "uid", 8, false, 8, "uint64_t", ""),
    new MavLinkPacketField("flight_sw_version", "flightSwVersion", 16, false, 4, "uint32_t", ""),
    new MavLinkPacketField("middleware_sw_version", "middlewareSwVersion", 20, false, 4, "uint32_t", ""),
    new MavLinkPacketField("os_sw_version", "osSwVersion", 24, false, 4, "uint32_t", ""),
    new MavLinkPacketField("board_version", "boardVersion", 28, false, 4, "uint32_t", ""),
    new MavLinkPacketField("vendor_id", "vendorId", 32, false, 2, "uint16_t", ""),
    new MavLinkPacketField("product_id", "productId", 34, false, 2, "uint16_t", ""),
    new MavLinkPacketField("flight_custom_version", "flightCustomVersion", 36, false, 1, "uint8_t[]", "", 8),
    new MavLinkPacketField("middleware_custom_version", "middlewareCustomVersion", 44, false, 1, "uint8_t[]", "", 8),
    new MavLinkPacketField("os_custom_version", "osCustomVersion", 52, false, 1, "uint8_t[]", "", 8),
    new MavLinkPacketField("uid2", "uid2", 60, true, 1, "uint8_t[]", "", 18),
  ], (p) => AutopilotVersion.decode(p))

  /// Bitmap of capabilities
  /// Values: `MavProtocolCapability`.
  public capabilities: u64 = 0

  /// Firmware version number. The field must be encoded as 4 bytes, where each byte (shown from MSB to
  /// LSB) is part of a semantic version: (major) (minor) (patch) (FIRMWARE_VERSION_TYPE).
  public flightSwVersion: u32 = 0

  /// Middleware version number
  public middlewareSwVersion: u32 = 0

  /// Operating system version number
  public osSwVersion: u32 = 0

  /// HW / board version (last 8 bits should be silicon ID, if any). The first 16 bits of this field
  /// specify a board type from an enumeration stored at
  /// https://github.com/PX4/PX4-Bootloader/blob/master/board_types.txt and with extensive additions at
  /// https://github.com/ArduPilot/ardupilot/blob/master/Tools/AP_Bootloader/board_types.txt
  public boardVersion: u32 = 0

  /// Custom version field, commonly the first 8 bytes of the git hash. This is not an unique identifier,
  /// but should allow to identify the commit using the main version number even for very large code
  /// bases.
  public flightCustomVersion: u8[] = []

  /// Custom version field, commonly the first 8 bytes of the git hash. This is not an unique identifier,
  /// but should allow to identify the commit using the main version number even for very large code
  /// bases.
  public middlewareCustomVersion: u8[] = []

  /// Custom version field, commonly the first 8 bytes of the git hash. This is not an unique identifier,
  /// but should allow to identify the commit using the main version number even for very large code
  /// bases.
  public osCustomVersion: u8[] = []

  /// ID of the board vendor
  public vendorId: u16 = 0

  /// ID of the product
  public productId: u16 = 0

  /// UID if provided by hardware (see uid2)
  public uid: u64 = 0

  /// UID if provided by hardware (supersedes the uid field. If this is non-zero, use this field,
  /// otherwise use uid)
  public uid2: u8[] = []

  /// A AUTOPILOT_VERSION from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): AutopilotVersion {
    const m = new AutopilotVersion()
    m.capabilities = readU64(payload, 0)
    m.uid = readU64(payload, 8)
    m.flightSwVersion = readU32(payload, 16)
    m.middlewareSwVersion = readU32(payload, 20)
    m.osSwVersion = readU32(payload, 24)
    m.boardVersion = readU32(payload, 28)
    m.vendorId = readU16(payload, 32)
    m.productId = readU16(payload, 34)
    for (let i = 0; i < 8; i++) {
      m.flightCustomVersion.push(readU8(payload, 36 + i * 1))
    }
    for (let i = 0; i < 8; i++) {
      m.middlewareCustomVersion.push(readU8(payload, 44 + i * 1))
    }
    for (let i = 0; i < 8; i++) {
      m.osCustomVersion.push(readU8(payload, 52 + i * 1))
    }
    for (let i = 0; i < 18; i++) {
      m.uid2.push(readU8(payload, 60 + i * 1))
    }
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeU64(into, at + 0, this.capabilities)
    writeU64(into, at + 8, this.uid)
    writeUint(into, at + 16, 4, this.flightSwVersion as int)
    writeUint(into, at + 20, 4, this.middlewareSwVersion as int)
    writeUint(into, at + 24, 4, this.osSwVersion as int)
    writeUint(into, at + 28, 4, this.boardVersion as int)
    writeUint(into, at + 32, 2, this.vendorId as int)
    writeUint(into, at + 34, 2, this.productId as int)
    for (let i = 0; i < 8 && i < this.flightCustomVersion.length; i++) {
      writeUint(into, at + 36 + i * 1, 1, this.flightCustomVersion[i] as int)
    }
    for (let i = 0; i < 8 && i < this.middlewareCustomVersion.length; i++) {
      writeUint(into, at + 44 + i * 1, 1, this.middlewareCustomVersion[i] as int)
    }
    for (let i = 0; i < 8 && i < this.osCustomVersion.length; i++) {
      writeUint(into, at + 52 + i * 1, 1, this.osCustomVersion[i] as int)
    }
    for (let i = 0; i < 18 && i < this.uid2.length; i++) {
      writeUint(into, at + 60 + i * 1, 1, this.uid2[i] as int)
    }
  }

  public override info(): MessageInfo {
    AutopilotVersion.INFO
  }
}

