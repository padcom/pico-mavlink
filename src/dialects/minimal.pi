/// MAVLINK component type reported in HEARTBEAT message. Flight controllers must report the type of the
/// vehicle on which they are mounted (e.g. MAV_TYPE_OCTOROTOR). All other components must report a
/// value appropriate for their type (e.g. a camera must use MAV_TYPE_CAMERA).
export class MavType {
  /// Generic micro air vehicle
  public static readonly GENERIC: int = 0

  /// Fixed wing aircraft.
  public static readonly FIXED_WING: int = 1

  /// Quadrotor
  public static readonly QUADROTOR: int = 2

  /// Coaxial helicopter
  public static readonly COAXIAL: int = 3

  /// Normal helicopter with tail rotor.
  public static readonly HELICOPTER: int = 4

  /// Ground installation
  public static readonly ANTENNA_TRACKER: int = 5

  /// Operator control unit / ground control station
  public static readonly GCS: int = 6

  /// Airship, controlled
  public static readonly AIRSHIP: int = 7

  /// Free balloon, uncontrolled
  public static readonly FREE_BALLOON: int = 8

  /// Rocket
  public static readonly ROCKET: int = 9

  /// Ground rover
  public static readonly GROUND_ROVER: int = 10

  /// Surface vessel, boat, ship
  public static readonly SURFACE_BOAT: int = 11

  /// Submarine
  public static readonly SUBMARINE: int = 12

  /// Hexarotor
  public static readonly HEXAROTOR: int = 13

  /// Octorotor
  public static readonly OCTOROTOR: int = 14

  /// Tricopter
  public static readonly TRICOPTER: int = 15

  /// Flapping wing
  public static readonly FLAPPING_WING: int = 16

  /// Kite
  public static readonly KITE: int = 17

  /// Onboard companion controller
  public static readonly ONBOARD_CONTROLLER: int = 18

  /// Two-rotor Tailsitter VTOL that additionally uses control surfaces in vertical operation. Note, value
  /// previously named MAV_TYPE_VTOL_DUOROTOR.
  public static readonly VTOL_TAILSITTER_DUOROTOR: int = 19

  /// Quad-rotor Tailsitter VTOL using a V-shaped quad config in vertical operation. Note: value
  /// previously named MAV_TYPE_VTOL_QUADROTOR.
  public static readonly VTOL_TAILSITTER_QUADROTOR: int = 20

  /// Tiltrotor VTOL. Fuselage and wings stay (nominally) horizontal in all flight phases. It able to tilt
  /// (some) rotors to provide thrust in cruise flight.
  public static readonly VTOL_TILTROTOR: int = 21

  /// VTOL with separate fixed rotors for hover and cruise flight. Fuselage and wings stay (nominally)
  /// horizontal in all flight phases.
  public static readonly VTOL_FIXEDROTOR: int = 22

  /// Tailsitter VTOL. Fuselage and wings orientation changes depending on flight phase: vertical for
  /// hover, horizontal for cruise. Use more specific VTOL MAV_TYPE_VTOL_TAILSITTER_DUOROTOR or
  /// MAV_TYPE_VTOL_TAILSITTER_QUADROTOR if appropriate.
  public static readonly VTOL_TAILSITTER: int = 23

  /// Tiltwing VTOL. Fuselage stays horizontal in all flight phases. The whole wing, along with any
  /// attached engine, can tilt between vertical and horizontal mode.
  public static readonly VTOL_TILTWING: int = 24

  /// VTOL reserved 5
  public static readonly VTOL_RESERVED5: int = 25

  /// Gimbal
  public static readonly GIMBAL: int = 26

  /// ADSB system
  public static readonly ADSB: int = 27

  /// Steerable, nonrigid airfoil
  public static readonly PARAFOIL: int = 28

  /// Dodecarotor
  public static readonly DODECAROTOR: int = 29

  /// Camera
  public static readonly CAMERA: int = 30

  /// Charging station
  public static readonly CHARGING_STATION: int = 31

  /// FLARM collision avoidance system
  public static readonly FLARM: int = 32

  /// Servo
  public static readonly SERVO: int = 33

  /// Open Drone ID. See https://mavlink.io/en/services/opendroneid.html.
  public static readonly ODID: int = 34

  /// Decarotor
  public static readonly DECAROTOR: int = 35

  /// Battery
  public static readonly BATTERY: int = 36

  /// Parachute
  public static readonly PARACHUTE: int = 37

  /// Log
  public static readonly LOG: int = 38

  /// OSD
  public static readonly OSD: int = 39

  /// IMU
  public static readonly IMU: int = 40

  /// GPS
  public static readonly GPS: int = 41

  /// Winch
  public static readonly WINCH: int = 42

  /// Generic multirotor that does not fit into a specific type or whose type is unknown
  public static readonly GENERIC_MULTIROTOR: int = 43

  /// Illuminator. An illuminator is a light source that is used for lighting up dark areas external to
