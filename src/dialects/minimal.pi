  /// OpenPilot, http://openpilot.org
  public static readonly OPENPILOT: int = 4

  /// Generic autopilot only supporting simple waypoints
  public static readonly GENERIC_WAYPOINTS_ONLY: int = 5

  /// Generic autopilot supporting waypoints and other simple navigation commands
  public static readonly GENERIC_WAYPOINTS_AND_SIMPLE_NAVIGATION_ONLY: int = 6

  /// Generic autopilot supporting the full mission command set
  public static readonly GENERIC_MISSION_FULL: int = 7

  /// No valid autopilot, e.g. a GCS or other MAVLink component
  public static readonly INVALID: int = 8

  /// PPZ UAV - http://nongnu.org/paparazzi
  public static readonly PPZ: int = 9

  /// UAV Dev Board
  public static readonly UDB: int = 10

  /// FlexiPilot
  public static readonly FP: int = 11

  /// PX4 Autopilot - http://px4.io/
  public static readonly PX4: int = 12

  /// SMACCMPilot - http://smaccmpilot.org
  public static readonly SMACCMPILOT: int = 13

  /// AutoQuad -- http://autoquad.org
  public static readonly AUTOQUAD: int = 14

  /// Armazila -- http://armazila.com
  public static readonly ARMAZILA: int = 15

  /// Aerob -- http://aerob.ru
  public static readonly AEROB: int = 16

  /// ASLUAV autopilot -- http://www.asl.ethz.ch
  public static readonly ASLUAV: int = 17

  /// SmartAP Autopilot - http://sky-drones.com
  public static readonly SMARTAP: int = 18

  /// AirRails - http://uaventure.com
  public static readonly AIRRAILS: int = 19

  /// Fusion Reflex - https://fusion.engineering
  public static readonly REFLEX: int = 20

  /// The name of `value` (`GENERIC` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "GENERIC",
      1 => "RESERVED",
