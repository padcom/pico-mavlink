/// These flags encode the MAV mode, see MAV_MODE enum for useful combinations.
export class MavModeFlag {
  /// 0b10000000 MAV safety set to armed. Motors are enabled / running / can start. Ready to fly.
  /// Additional note: this flag is to be ignore when sent in the command MAV_CMD_DO_SET_MODE and
  /// MAV_CMD_COMPONENT_ARM_DISARM shall be used instead. The flag can still be used to report the armed
  /// state.
  public static readonly SAFETY_ARMED: int = 128

  /// 0b01000000 remote control input is enabled.
  public static readonly MANUAL_INPUT_ENABLED: int = 64

  /// 0b00100000 hardware in the loop simulation. All motors / actuators are blocked, but internal
  /// software is full operational.
  public static readonly HIL_ENABLED: int = 32

  /// 0b00010000 system stabilizes electronically its attitude (and optionally position). It needs however
  /// further control inputs to move around.
  public static readonly STABILIZE_ENABLED: int = 16

  /// 0b00001000 guided mode enabled, system flies waypoints / mission items.
  public static readonly GUIDED_ENABLED: int = 8

  /// 0b00000100 autonomous mode enabled, system finds its own goal positions. Guided flag can be set or
  /// not, depends on the actual implementation.
  public static readonly AUTO_ENABLED: int = 4

  /// 0b00000010 system has a test mode enabled. This flag is intended for temporary system tests and
  /// should not be used for stable implementations.
  public static readonly TEST_ENABLED: int = 2

  /// 0b00000001 system-specific custom mode is enabled. When using this flag to enable a custom mode all
  /// other flags should be ignored.
  public static readonly CUSTOM_MODE_ENABLED: int = 1

  /// The name of `value` (`SAFETY_ARMED` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      128 => "SAFETY_ARMED",
      64 => "MANUAL_INPUT_ENABLED",
      32 => "HIL_ENABLED",
      16 => "STABILIZE_ENABLED",
      8 => "GUIDED_ENABLED",
      4 => "AUTO_ENABLED",
      2 => "TEST_ENABLED",
      1 => "CUSTOM_MODE_ENABLED",
      _ => null,
    }
  }
}

/// These values encode the bit positions of the decode position. These values can be used to read the
/// value of a flag bit by combining the base_mode variable with AND with the flag position value. The
/// result will be either 0 or 1, depending on if the flag is set or not.
export class MavModeFlagDecodePosition {
  /// First bit: 10000000
  public static readonly SAFETY: int = 128

  /// Second bit: 01000000
  public static readonly MANUAL: int = 64

  /// Third bit: 00100000
  public static readonly HIL: int = 32

  /// Fourth bit: 00010000
  public static readonly STABILIZE: int = 16

  /// Fifth bit: 00001000
  public static readonly GUIDED: int = 8

  /// Sixth bit: 00000100
  public static readonly AUTO: int = 4

  /// Seventh bit: 00000010
  public static readonly TEST: int = 2

  /// Eighth bit: 00000001
  public static readonly CUSTOM_MODE: int = 1

  /// The name of `value` (`SAFETY` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      128 => "SAFETY",
      64 => "MANUAL",
      32 => "HIL",
      16 => "STABILIZE",
      8 => "GUIDED",
      4 => "AUTO",
      2 => "TEST",
      1 => "CUSTOM_MODE",
      _ => null,
    }
  }
}

/// MAV_STATE
export class MavState {
  /// Uninitialized system, state is unknown.
  public static readonly UNINIT: int = 0

  /// System is booting up.
  public static readonly BOOT: int = 1

  /// System is calibrating and not flight-ready.
  public static readonly CALIBRATING: int = 2

  /// System is grounded and on standby. It can be launched any time.
  public static readonly STANDBY: int = 3

  /// System is active and might be already airborne. Motors are engaged.
  public static readonly ACTIVE: int = 4

  /// System is in a non-normal flight mode (failsafe). It can however still navigate.
  public static readonly CRITICAL: int = 5

  /// System is in a non-normal flight mode (failsafe). It lost control over parts or over the whole
  /// airframe. It is in mayday and going down.
  public static readonly EMERGENCY: int = 6

  /// System just initialized its power-down sequence, will shut down now.
  public static readonly POWEROFF: int = 7

  /// System is terminating itself (failsafe or commanded).
  public static readonly FLIGHT_TERMINATION: int = 8

  /// The name of `value` (`UNINIT` …), or null for a value this dialect doesn't define.
  public static nameOf(value: int): string? {
    match (value) {
      0 => "UNINIT",
      1 => "BOOT",
      2 => "CALIBRATING",
      3 => "STANDBY",
      4 => "ACTIVE",
      5 => "CRITICAL",
      6 => "EMERGENCY",
      7 => "POWEROFF",
      8 => "FLIGHT_TERMINATION",
      _ => null,
    }
  }
}

/// Legacy component ID values for particular types of hardware/software that might make up a MAVLink
/// system (autopilot, cameras, servos, avoidance systems etc.). Components are not required or expected
/// to use IDs with names that correspond to their type or function, but may choose to do so. Using an
/// ID that matches the type may slightly reduce the chances of component id clashes, as, for historical
/// reasons, it is less likely to be used by some other type of component. System integration will still
/// need to ensure that all components have unique IDs. Component IDs are used for addressing messages
/// to a particular component within a system. A component can use any unique ID between 1 and 255
