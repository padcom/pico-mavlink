/// The heartbeat message shows that a system or component is present and responding. The type and
/// autopilot fields (along with the message component id), allow the receiving system to treat further
/// messages from this system appropriately (e.g. by laying out the user interface based on the
/// autopilot). This microservice is documented at https://mavlink.io/en/services/heartbeat.html
export class Heartbeat extends MavLinkData {
  public static readonly MSG_ID: int = 0
  public static readonly MSG_NAME: string = "HEARTBEAT"
  public static readonly PAYLOAD_LENGTH: int = 9
  public static readonly MAGIC_NUMBER: int = 50
  public static readonly INFO: MessageInfo = new MessageInfo(0, "HEARTBEAT", 9, 9, 50, [
    new MavLinkPacketField("custom_mode", "customMode", 0, false, 4, "uint32_t", ""),
    new MavLinkPacketField("type", "type", 4, false, 1, "uint8_t", ""),
    new MavLinkPacketField("autopilot", "autopilot", 5, false, 1, "uint8_t", ""),
    new MavLinkPacketField("base_mode", "baseMode", 6, false, 1, "uint8_t", ""),
    new MavLinkPacketField("system_status", "systemStatus", 7, false, 1, "uint8_t", ""),
    new MavLinkPacketField("mavlink_version", "mavlinkVersion", 8, false, 1, "uint8_t_mavlink_version", ""),
  ], (p) => Heartbeat.decode(p))

  /// Vehicle or component type. For a flight controller component the vehicle type (quadrotor,
  /// helicopter, etc.). For other components the component type (e.g. camera, gimbal, etc.). This should
  /// be used in preference to component id for identifying the component type.
  /// Values: `MavType`.
  public type: u8 = 0

  /// Autopilot type / class. Use MAV_AUTOPILOT_INVALID for components that are not flight controllers.
  /// Values: `MavAutopilot`.
  public autopilot: u8 = 0

  /// System mode bitmap.
  /// Values: `MavModeFlag`.
  public baseMode: u8 = 0

  /// A bitfield for use for autopilot-specific flags
  public customMode: u32 = 0

  /// System status flag.
  /// Values: `MavState`.
  public systemStatus: u8 = 0

  /// MAVLink version, not writable by user, gets added by protocol because of magic data type:
  /// uint8_t_mavlink_version
  public mavlinkVersion: u8 = 0

  /// A HEARTBEAT from `payload` (zeros past its end).
  public static decode(payload: Uint8Array): Heartbeat {
    const m = new Heartbeat()
    m.customMode = readU32(payload, 0)
    m.type = readU8(payload, 4)
    m.autopilot = readU8(payload, 5)
    m.baseMode = readU8(payload, 6)
    m.systemStatus = readU8(payload, 7)
    m.mavlinkVersion = readU8(payload, 8)
    m
  }

  public override encode(into: Uint8Array, at: int): void {
    writeUint(into, at + 0, 4, this.customMode as int)
    writeUint(into, at + 4, 1, this.type as int)
    writeUint(into, at + 5, 1, this.autopilot as int)
    writeUint(into, at + 6, 1, this.baseMode as int)
    writeUint(into, at + 7, 1, this.systemStatus as int)
    writeUint(into, at + 8, 1, this.mavlinkVersion as int)
  }

  public override info(): MessageInfo {
    Heartbeat.INFO
  }
}

/// The minimal dialect's own messages by id (merge its includes with `Registry`).
export const REGISTRY: Map<int, MessageInfo> = new Map<int, MessageInfo>()
REGISTRY.set(Heartbeat.MSG_ID, Heartbeat.INFO)
