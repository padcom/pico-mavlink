import { describe, it, expect } from "std/test"
import { hex } from "std/encoding"
import { MavLinkConnection } from "./connection"
import { MemoryStream } from "./stream"
import { MavLinkPacketParser, MavLinkPacketSignature, MavLinkProtocolV2 } from "./protocol"
import { SigningKey, SigningOptions, SigningPolicy, UnsignedPolicy, carriesKey, signingTimestamp } from "./signing"
import { MavLinkError } from "./protocol"
import { SetupSigning } from "./dialects/common"
import { Heartbeat } from "./dialects/minimal"
import { RadioStatus } from "./dialects/common"

const KEY = MavLinkPacketSignature.key("secret")
const SECRET = SigningKey.fromPassphrase("secret")
/// The clock of the packets below: their timestamps are 2023's.
const THEN: SigningOptions = { clock: () => 1_700_000_000_000 }
const SIGNER = new MavLinkProtocolV2(1, 1, MavLinkProtocolV2.IFLAG_SIGNED)

function signed(ts: int, key: Uint8Array = KEY, link: int = 1): Uint8Array {
  SIGNER.sign(SIGNER.serialize(new Heartbeat(), 0), link, key, ts)
}

function verdict(policy: SigningPolicy, frame: Uint8Array): string {
  const r = policy.check(new MavLinkPacketParser().parse(frame))
  if (r == null) "ok" else match (r!) {
    Unsigned { } => "unsigned",
    BadSignature { } => "bad signature",
    Replay { } => "replay",
  }
}

function checksSignaturesAndReplays(): void {
  const p = new SigningPolicy(SECRET, UnsignedPolicy.Reject, THEN)
  expect(verdict(p, signed(1_700_000_000_000))).toBe("ok")
  expect(verdict(p, signed(1_700_000_000_001))).toBe("ok")
  // The same timestamp again, or an older one: a replay.
  expect(verdict(p, signed(1_700_000_000_001))).toBe("replay")
  expect(verdict(p, signed(1_600_000_000_000))).toBe("replay")
  // Another link has its own timeline (within the window: a minute behind this end's timestamp).
  expect(verdict(p, signed(1_699_999_970_000, KEY, 2))).toBe("ok")
  // A new stream more than a minute behind is a replay too.
  expect(verdict(p, signed(1_699_999_900_000, KEY, 3))).toBe("replay")
  expect(verdict(p, signed(1_700_000_000_005, MavLinkPacketSignature.key("wrong")))).toBe("bad signature")
  // A tampered payload breaks the signature.
  const t = signed(1_700_000_000_009)
  t.set(10, t[10] ^ 1)
  expect(verdict(p, t)).toBe("bad signature")
  expect(`${p.rejectedReplay} ${p.rejectedSignature}`).toBe("3 2")
}

function unsignedPolicies(): void {
  const plain = new MavLinkProtocolV2(1, 1).serialize(new Heartbeat(), 0)
  const radio = new MavLinkProtocolV2(1, 1).serialize(new RadioStatus(), 0)
  expect(verdict(new SigningPolicy(SECRET), plain)).toBe("unsigned")
  expect(verdict(new SigningPolicy(SECRET, UnsignedPolicy.Accept), plain)).toBe("ok")
  const listed = new SigningPolicy(SECRET, UnsignedPolicy.AcceptListed([RadioStatus.MSG_ID]))
  expect(`${verdict(listed, radio)} ${verdict(listed, plain)}`).toBe("ok unsigned")
}

async function connectionDropsUntrusted(): Promise<void> throws Error {
  const ends = MemoryStream.pair()
  const policy = new SigningPolicy(SECRET, UnsignedPolicy.Reject, THEN)
  const gcs = new MavLinkConnection(ends[0], { signing: policy })
  const vehicle = new MavLinkConnection(ends[1])
  await vehicle.send(new Heartbeat())
  await vehicle.sendSigned(new Heartbeat(), KEY, 1, 1_700_000_000_000)
  await vehicle.sendSigned(new Heartbeat(), MavLinkPacketSignature.key("wrong"), 1, 1_700_000_000_001)
  vehicle.close()
  let n = 0
  for await (const _ of gcs.messages()) {
    n += 1
  }
  expect(`${n} kept, ${policy.rejectedUnsigned} unsigned, ${policy.rejectedSignature} forged`).toBe("1 kept, 1 unsigned, 1 forged")
}

function keysAreRedacted(): void {
  const key = SigningKey.fromPassphrase("hunter2")
  const bytes = key.reveal()
  expect(bytes.length).toBe(32)
  const policy = new SigningPolicy(key)
  const m = new SetupSigning()
  for (let i = 0; i < 32; i++) {
    m.secretKey.push(bytes[i] as u8)
  }
  // Every way a key, a policy or a SETUP_SIGNING is shown: none has the key's bytes in any form.
  const shown = [`${key}`, `${key:?}`, key.toString(), `${policy}`, `${policy:?}`, `${m}`, `${m:?}`, `${[key]:?}`]
  for (const s of shown) {
    expect(leaks(s, bytes)).toBe(false)
  }
  expect(`${key}`).toBe("SigningKey(redacted)")
  // The check would see the key: as a list of numbers, or as hex.
  const numbers: int[] = []
  for (let i = 0; i < bytes.length; i++) {
    numbers.push(bytes[i])
  }
  expect(leaks(`${numbers:?}`, bytes)).toBe(true)
  expect(leaks(hex.encode(bytes).toUpperCase(), bytes)).toBe(true)
  expect(`${m}`.indexOf("secretKey = redacted") >= 0).toBe(true)
  // A wrong length is an error that says the length, not the bytes.
  const short = bytes.slice(0, 31)
  let message = ""
  try {
    new SigningKey(short)
  } catch (e: MavLinkError) {
    message = `${e.code}: ${e.message}`
  }
  expect(message).toBe("INVALID_KEY: a signing key is 32 bytes, not 31")
  expect(leaks(message, short)).toBe(false)
}

/// Whether `text` holds `key` as hex, as a list of numbers, or as its bytes in a row.
function leaks(text: string, key: Uint8Array): bool {
  const parts: string[] = []
  for (let i = 0; i < key.length; i++) {
    parts.push(`${key[i]}`)
  }
  const lower = text.toLowerCase()
  return lower.indexOf(hex.encode(key)) >= 0 || lower.indexOf(hex.encode(key.slice(0, 8))) >= 0 || text.indexOf(parts.slice(0, 8).join(", ")) >= 0
    || text.indexOf(parts.slice(0, 8).join(",")) >= 0
}

function keysAndTimestamps(): void {
  expect(SigningKey.fromPassphrase("a").equals(SigningKey.fromPassphrase("a"))).toBe(true)
  expect(SigningKey.fromPassphrase("a").equals(SigningKey.fromPassphrase("b"))).toBe(false)
  expect(SigningKey.none().isNone).toBe(true)
  expect(SigningKey.random().isNone).toBe(false)
  expect(SigningKey.random().equals(SigningKey.random())).toBe(false)
  // The same bytes as the node-mavlink-style key from a passphrase.
  expect(hex.encode(SigningKey.fromPassphrase("secret").reveal())).toBe(hex.encode(KEY))
  // 10 µs units since 2015-01-01; never twice the same, never backwards, even when the clock stands still or steps back.
  let now = 1_420_070_400_001
  const p = new SigningPolicy(SECRET, UnsignedPolicy.Reject, { clock: () => now })
  expect(signingTimestamp(now)).toBe(100)
  expect(p.nextTimestamp()).toBe(101)
  expect(p.nextTimestamp()).toBe(102)
  now = 1_420_070_400_000
  expect(p.nextTimestamp()).toBe(103)
  now = 1_420_070_400_010
  expect(p.nextTimestamp()).toBe(1000)
}

function signsWhatItSends(): void {
  const p = new SigningPolicy(SECRET, UnsignedPolicy.Reject, { linkId: 7, clock: () => 1_700_000_000_000 })
  const frame = p.sign(SIGNER.serialize(new Heartbeat(), 0))
  const packet = new MavLinkPacketParser().parse(frame)
  expect(packet.signature!.linkId).toBe(7)
  expect(packet.signature!.timestamp).toBe(signingTimestamp(1_700_000_000_000) + 1)
  expect(packet.signature!.matches(KEY)).toBe(true)
  expect(carriesKey(frame)).toBe(false)
  expect(carriesKey(new MavLinkProtocolV2().serialize(new SetupSigning(), 0))).toBe(true)
}

async function connectionSignsAndSwitches(): Promise<void> throws Error {
  const ends = MemoryStream.pair()
  const gcs = new MavLinkConnection(ends[0], { signing: new SigningPolicy(SECRET) })
  const vehicle = new MavLinkConnection(ends[1], { signing: new SigningPolicy(SECRET) })
  await gcs.send(new Heartbeat())
  gcs.useSigning(null)
  await gcs.send(new Heartbeat())
  // A policy that only checks sends unsigned.
  gcs.useSigning(new SigningPolicy(SECRET, UnsignedPolicy.Reject, { signOutgoing: false }))
  await gcs.send(new Heartbeat())
  gcs.close()
  const got: string[] = []
  vehicle.useSigning(null)
  for await (const r of vehicle.messages()) {
    got.push(if (r.packet.signature == null) "unsigned" else "signed")
  }
  expect(got.join(" ")).toBe("signed unsigned unsigned")
}

describe("signing policy", () => {
  it("never shows a key: its string and debug forms, a policy's, a SETUP_SIGNING's, an error's", keysAreRedacted)
  it("makes keys and monotonic timestamps", keysAndTimestamps)
  it("signs with its key, link id and next timestamp", signsWhatItSends)
  it("makes a connection sign what it sends, and switches on a running one", connectionSignsAndSwitches)
  it("checks signatures and rejects replays per system, component and link", checksSignaturesAndReplays)
  it("accepts, lists or rejects unsigned packets", unsignedPolicies)
  it("makes a connection drop what it doesn't trust", connectionDropsUntrusted)
})
