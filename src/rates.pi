// Telemetry rates: the rate of each message a vehicle sends, asked for in one place and held.
//
// MAV_CMD_SET_MESSAGE_INTERVAL sets the interval of one message (https://mavlink.io/en/services/command.html).
// Where the vehicle does not honour it, REQUEST_DATA_STREAM asks for the stream the message belongs to
// instead. A stream is a group of messages with one rate, so the rate asked for a stream is the highest of
// the messages held in it, and the others in the group come at that rate too.
//
// A vehicle that reboots forgets what it was asked. The manager notices a reboot (the vehicle's
// time_boot_ms goes back) or a reconnect (it was silent, then speaks again), and asks again for everything
// it holds. It works on any `MavLinkConnection`, so over a `MavLinkRouter` too, one manager per vehicle.
//
// Requests go one at a time. A COMMAND_ACK says which command it answers but not which request, so two
// SET_MESSAGE_INTERVAL commands in flight at once would take each other's acknowledgement.
import { delay } from "std/timers"
import { MavLinkConnection, Received } from "./connection"
import { MavLinkError } from "./protocol"
import { CommandCall, Target } from "./operations"
import { readU32 } from "./bytes"
import { CommandLong, MavCmd, MavResult, RequestDataStream, SystemTime } from "./dialects/common"

export struct RatesOptions {
  /// How long a vehicle may say nothing before its next message counts as a reconnect (default 5000 ms).
  silenceMs?: int
  /// How long to wait after noticing a reboot before asking again, for the vehicle to be ready (default 500 ms).
  settleMs?: int
  /// How long to wait for the acknowledgement of one request (default 500 ms).
  timeoutMs?: int
  /// How many times to ask again when no acknowledgement comes (default 2).
  retries?: int
  /// How far behind its own clock a vehicle's time_boot_ms may be before that is taken as a reboot (default 250 ms).
  toleranceMs?: int
  /// How often, while the manager holds a rate, to ask the vehicle for SYSTEM_TIME (default 2000 ms; 0 never). A
  /// vehicle that restarts without its link going down goes on sending heartbeats, which say nothing of how long it
  /// has been up, and the messages that do (ATTITUDE, say) are the ones it forgot to send; SYSTEM_TIME asked for once
  /// is not forgotten, and its time_boot_ms gives the restart away.
  watchMs?: int
}

/// How one rate was asked for.
export struct RateResult {
  messageId: int
  /// `interval` (SET_MESSAGE_INTERVAL was acknowledged as accepted), `stream` (REQUEST_DATA_STREAM, which is not
  /// acknowledged: it is sent, not confirmed) or `none` (neither works for this message, or the request itself
  /// failed, as when asking again after a reboot and the connection is broken).
  method: string
  /// Whether the request was accepted or sent.
  ok: bool
  /// The MAV_RESULT of SET_MESSAGE_INTERVAL, or -1 when no acknowledgement came.
  result: int
}

/// A rate that is held.
export struct HeldRate {
  messageId: int
  /// Microseconds between messages; -1 for off.
  intervalUs: int
  /// How it was last asked for, as in `RateResult`.
  method: string
}

/// The stream each message is in, as ArduPilot documents its SRn_ parameters (message id, MAV_DATA_STREAM).
/// Other messages have no stream to fall back to.
const STREAM_OF: int[][] = [
  [1, 2], // SYS_STATUS: EXTENDED_STATUS
  [24, 2], // GPS_RAW_INT
  [42, 2], // MISSION_CURRENT
  [62, 2], // NAV_CONTROLLER_OUTPUT
  [125, 2], // POWER_STATUS
  [27, 1], // RAW_IMU: RAW_SENSORS
  [29, 1], // SCALED_PRESSURE
  [116, 1], // SCALED_IMU2
  [36, 3], // SERVO_OUTPUT_RAW: RC_CHANNELS
  [65, 3], // RC_CHANNELS
  [32, 6], // LOCAL_POSITION_NED: POSITION
  [33, 6], // GLOBAL_POSITION_INT
  [30, 10], // ATTITUDE: EXTRA1
  [74, 11], // VFR_HUD: EXTRA2
  [2, 12], // SYSTEM_TIME: EXTRA3
  [241, 12], // VIBRATION
]

function streamOf(messageId: int): int {
  for (const pair of STREAM_OF) {
    if (pair[0] == messageId) {
      return pair[1]
    }
  }
  -1
}

/// How many times in a row the rates are asked for again after a reboot, when the connection fails or the
/// vehicle reboots again meanwhile.
const MAX_PASSES: int = 3

export class TelemetryRates {
  readonly conn: MavLinkConnection
  readonly target: Target
  readonly silenceMs: int
  readonly settleMs: int
  readonly timeoutMs: int
  readonly retries: int
  readonly toleranceMs: int
  readonly watchMs: int
  /// message id -> interval in microseconds (-1: off), in the order they were asked for.
  readonly wanted: Map<int, int> = new Map<int, int>()
  readonly methods: Map<int, string> = new Map<int, string>()
  /// message id -> where time_boot_ms is in its payload, or -1 if it has none.
  readonly bootField: Map<int, int> = new Map<int, int>()
  readonly handlers: ((results: RateResult[]) => void)[] = []
  readonly listener: int
  lastSeen: int = 0
  /// The time_boot_ms of the last message that had one, per component (each has its own clock when the target is
  /// the whole system), and when (ms since 1970) that arrived.
  lastBoot: Map<int, int> = new Map<int, int>()
  lastBootAt: Map<int, int> = new Map<int, int>()
  /// One request at a time: whoever holds the turn is on the vehicle, the others wait.
  busy: bool = false
  waiters: ((value: bool) => void)[] = []
  /// Asking again after a reboot: waiting for the vehicle to settle, or going through the rates.
  scheduled: bool = false
  running: bool = false
  timer: int = -1
  /// The timer that asks for SYSTEM_TIME while something is held, or -1.
  watcher: int = -1
  /// A reboot or silence was noticed while the rates were being asked again: go through them once more after.
  again: bool = false
  /// A request failed with an error (not a refusal) in the pass that is running.
  hadError: bool = false
  reboots: int = 0
  stopped: bool = false

  constructor(conn: MavLinkConnection, target: Target, options: RatesOptions = {}) {
    this.conn = conn
    this.target = target
    this.silenceMs = options.silenceMs ?? 5000
    this.settleMs = options.settleMs ?? 500
    this.timeoutMs = options.timeoutMs ?? 500
    this.retries = options.retries ?? 2
    this.toleranceMs = options.toleranceMs ?? 250
    this.watchMs = options.watchMs ?? 2000
    this.listener = conn.on((r: Received) => this.seen(r))
  }

  /// Asks for `messageId` at `hz` messages a second (0.001 to 1000), and holds the rate.
  public async set(messageId: int, hz: f64): Promise<RateResult> throws Error {
    if (!(hz >= 0.001 && hz <= 1000.0)) {
      throw new MavLinkError("INVALID_RATE", `a rate is 0.001 to 1000 Hz, not ${hz}`)
    }
    const intervalUs = Math.round(1_000_000.0 / hz) as int
    wanted.set(messageId, if (intervalUs < 1) 1 else intervalUs)
    startWatching()
    await request(messageId, null)
  }

  /// Switches `messageId` off, and holds that.
  public async off(messageId: int): Promise<RateResult> throws Error {
    wanted.set(messageId, -1)
    startWatching()
    await request(messageId, null)
  }

  /// Gives `messageId` back to the vehicle's own rate, and stops holding anything for it. Only
  /// SET_MESSAGE_INTERVAL can do that; a vehicle that has only streams keeps the rate it was last given.
  public async reset(messageId: int): Promise<RateResult> throws Error {
    wanted.delete(messageId)
    methods.delete(messageId)
    if (wanted.size == 0) {
      stopWatching()
    }
    const r = await request(messageId, 0)
    methods.delete(messageId)
    r
  }

  /// What is held, in the order it was asked for.
  public held(): HeldRate[] {
    const out: HeldRate[] = []
    for (const [id, interval] of wanted) {
      out.push({ messageId: id, intervalUs: interval, method: methods.get(id) ?? "none" })
    }
    out
  }

  /// How many reboots or reconnects were noticed.
  public rebootCount(): int {
    reboots
  }

  /// Calls `handler` with the results each time the rates were asked for again after a reboot or reconnect.
  public onReapplied(handler: (results: RateResult[]) => void): void {
    handlers.push(handler)
  }

  /// Asks for everything held again, one after the other (after a reconnect that the manager could not see,
  /// say, such as a new connection). A rate that fails is in its result, and the others are still asked for.
  /// Nothing is asked once the manager has been stopped.
  public async reapply(): Promise<RateResult[]> throws Error {
    const results: RateResult[] = []
    const ids: int[] = []
    for (const [id, _] of wanted) {
      ids.push(id)
    }
    for (const id of ids) {
      if (stopped) {
        break
      }
      if (!wanted.has(id)) {
        continue
      }
      try {
        results.push(await request(id, null))
      } catch (e: Error) {
        hadError = true
        const failed: RateResult = { messageId: id, method: "none", ok: false, result: -1 }
        results.push(failed)
      }
    }
    results
  }

  /// Stops watching the connection, and cancels asking again after a reboot, scheduled or begun (the request
  /// that is on the vehicle at that moment finishes). What was asked for stays asked for, on the vehicle.
  public stop(): void {
    stopped = true
    conn.off(listener)
    stopWatching()
    if (scheduled) {
      clearTimeout(timer)
      scheduled = false
    }
  }

  /// While something is held, asks for SYSTEM_TIME every `watchMs`, so a restart that leaves the link up is seen.
  startWatching(): void {
    if (watchMs > 0 && watcher < 0 && !stopped) {
      watcher = setInterval(() => {
        this.poll()
      }, watchMs)
    }
  }

  stopWatching(): void {
    if (watcher >= 0) {
      clearInterval(watcher)
      watcher = -1
    }
  }

  /// MAV_CMD_REQUEST_MESSAGE for SYSTEM_TIME, sent without waiting for the answer: the SYSTEM_TIME that comes back
  /// goes through `seen` like any message, and its time_boot_ms is compared with the vehicle's clock.
  async poll(): Promise<void> {
    if (stopped || wanted.size == 0) {
      return
    }
    const c = new CommandLong()
    c.targetSystem = target.system as u8
    c.targetComponent = target.component as u8
    c.command = MavCmd.REQUEST_MESSAGE as u16
    c._param1 = SystemTime.MSG_ID as f32
    try {
      await conn.send(c)
    } catch (e: Error) {
      // The link is down; the silence will be noticed when it comes back.
    }
  }

  /// Takes the turn to talk to the vehicle, waiting behind whoever has it.
  async acquire(): Promise<void> throws Error {
    if (!busy) {
      busy = true
      return
    }
    await new Promise<bool, Error>((resolve: (value: bool) => void, _reject: (error: Error) => void) => {
      waiters.push(resolve)
    })
  }

  /// Hands the turn to the one that has waited longest, or frees it.
  release(): void {
    if (waiters.length == 0) {
      busy = false
      return
    }
    const next = waiters[0]
    waiters = waiters.slice(1)
    next(true)
  }

  /// One request, after those before it. `explicit` is the interval to ask for (0 to give the message back); null
  /// asks for what is held for it now, which is the latest, however long the request waited for its turn.
  async request(messageId: int, explicit: int?): Promise<RateResult> throws Error {
    await acquire()
    let out: RateResult? = null
    try {
      out = await requestNow(messageId, explicit)
    } catch (e: Error) {
      release()
      throw e
    }
    release()
    out!
  }

  /// SET_MESSAGE_INTERVAL; or, if the vehicle does not accept it (or does not answer), REQUEST_DATA_STREAM.
  async requestNow(messageId: int, explicit: int?): Promise<RateResult> throws Error {
    const held = explicit ?? wanted.get(messageId)
    if (held == null) {
      // Nothing is held for it any more (it was reset while this waited).
      const nothing: RateResult = { messageId: messageId, method: "none", ok: false, result: -1 }
      return nothing
    }
    const intervalUs = held!
    let result = -1
    try {
      const calls = new CommandCall(conn, target, { timeoutMs: timeoutMs, retries: retries })
      result = await calls.setMessageInterval(messageId, intervalUs)
    } catch (e: MavLinkError) {
      // No acknowledgement. An unsupported command is often just not answered, so try the streams.
      result = -1
    }
    if (result == MavResult.ACCEPTED) {
      remember(messageId, "interval")
      const accepted: RateResult = { messageId: messageId, method: "interval", ok: true, result: result }
      return accepted
    }
    const stream = streamOf(messageId)
    if (stream < 0 || intervalUs == 0) {
      remember(messageId, "none")
      const none: RateResult = { messageId: messageId, method: "none", ok: false, result: result }
      return none
    }
    await requestStream(stream)
    remember(messageId, "stream")
    const sent: RateResult = { messageId: messageId, method: "stream", ok: true, result: result }
    sent
  }

  /// How `messageId` was last asked for, kept only while a rate is held for it.
  remember(messageId: int, method: string): void {
    if (wanted.has(messageId)) {
      methods.set(messageId, method)
    }
  }

  /// REQUEST_DATA_STREAM for `stream`, at the highest rate any message held in it needs (off if they are all off).
  async requestStream(stream: int): Promise<void> throws Error {
    let hz = 0
    for (const [id, interval] of wanted) {
      if (streamOf(id) == stream && interval > 0) {
        const needed = Math.ceil(1_000_000.0 / (interval as f64)) as int
        if (needed > hz) {
          hz = needed
        }
      }
    }
    const m = new RequestDataStream()
    m.targetSystem = target.system as u8
    m.targetComponent = target.component as u8
    m.reqStreamId = stream as u8
    m.reqMessageRate = (if (hz > 65535) 65535 else hz) as u16
    m.startStop = (if (hz > 0) 1 else 0) as u8
    await conn.send(m)
  }

  /// Whether a message is from the vehicle this manager looks after.
  fromTarget(r: Received): bool {
    r.packet.header.sysid == target.system && (target.component == 0 || r.packet.header.compid == target.component)
  }

  /// The vehicle's time since boot in a message that has it, or -1.
  bootTimeOf(r: Received): int {
    const msgid = r.packet.header.msgid
    let at = bootField.get(msgid)
    if (at == null) {
      let found = -1
      const info = conn.registry.get(msgid)
      if (info != null) {
        for (const f of info!.fields) {
          if (f.source == "time_boot_ms") {
            found = f.offset
          }
        }
      }
      bootField.set(msgid, found)
      at = found
    }
    if (at! < 0) {
      return -1
    }
    readU32(r.packet.payload, at!) as int
  }

  seen(r: Received): void {
    if (stopped || !fromTarget(r)) {
      return
    }
    const now = Date.now() as int
    const component = r.packet.header.compid
    const quiet = lastSeen > 0 && now - lastSeen >= silenceMs
    lastSeen = now
    if (quiet) {
      // The clock before a silence says nothing about the one after it: start comparing afresh. Otherwise the
      // vehicle's first message with a boot time, if it comes after one without, would count the same return again.
      lastBoot = new Map<int, int>()
      lastBootAt = new Map<int, int>()
    }
    const boot = bootTimeOf(r)
    let rebooted = false
    if (boot >= 0) {
      // Where this component's clock should be by now if it had not rebooted. Each component has a clock of its
      // own, so one is only compared with itself.
      const before = lastBoot.get(component)
      const beforeAt = lastBootAt.get(component)
      if (before != null && beforeAt != null && boot + toleranceMs < before! + (now - beforeAt!)) {
        rebooted = true
      }
      lastBoot.set(component, boot)
      lastBootAt.set(component, now)
    }
    if (quiet || rebooted) {
      reboots += 1
      if (wanted.size > 0) {
        reapplyLater()
      }
    }
  }

  /// Asks again once the vehicle has had `settleMs` to get ready. If that is already waiting, it will cover this
  /// too; if the rates are being asked for right now, they are gone through once more when that is done.
  reapplyLater(): void {
    if (stopped || scheduled) {
      return
    }
    if (running) {
      again = true
      return
    }
    scheduled = true
    timer = setTimeout(() => {
      this.runReapply()
    }, settleMs)
  }

  async runReapply(): Promise<void> {
    scheduled = false
    if (stopped) {
      return
    }
    running = true
    let passes = 0
    while (true) {
      again = false
      hadError = false
      let results: RateResult[] = []
      try {
        results = await reapply()
      } catch (e: Error) {
        hadError = true
      }
      if (stopped) {
        break
      }
      for (const h of handlers) {
        h(results)
      }
      passes += 1
      // Once more if the vehicle restarted again meanwhile, or a request failed (the connection may be coming
      // back); a few times at most, then the next reboot or reconnect tries again.
      if (!(again || hadError) || passes >= MAX_PASSES) {
        break
      }
      try {
        await delay(settleMs)
      } catch (e: Error) {
        break
      }
      if (stopped) {
        break
      }
    }
    running = false
  }
}
