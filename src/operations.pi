// Operations: small classes over a MavLinkConnection, each doing one job of a ground station
// (PROJECT_DESCRIPTION §9.1: heartbeats, vehicle discovery, parameter list/read/write). They
// listen through `conn.on`/`waitFor`, so `conn.run()` must be running.
import { delay } from "std/timers"
import { MavLinkConnection, Received } from "./connection"
import { MavLinkError } from "./protocol"
import { ParamEncoding, TypedParamValue, decodeParam, encodeParam, sameParam } from "./params"
import { Heartbeat, MavAutopilot, MavState, MavType } from "./dialects/minimal"
import { CommandAck, CommandLong, MavCmd, MavResult, ParamRequestList, ParamRequestRead, ParamSet, ParamValue } from "./dialects/common"
import { AutopilotVersion } from "./dialects/standard"

/// Which system and component an operation talks to (component 0: any component of the system).
export struct Target {
  system: int
  component: int
}

function from(r: Received, t: Target): bool {
  r.packet.header.sysid == t.system && (t.component == 0 || r.packet.header.compid == t.component)
}

/// Sends HEARTBEAT every `intervalMs` (1 s by default) as a ground station, so autopilots know
/// someone is listening.
export class HeartbeatSender {
  readonly conn: MavLinkConnection
  readonly intervalMs: int
  public type: int = MavType.GCS
  public autopilot: int = MavAutopilot.INVALID
  timer: int = -1

  constructor(conn: MavLinkConnection, intervalMs: int = 1000) {
    this.conn = conn
    this.intervalMs = intervalMs
  }

  /// One HEARTBEAT now, then every interval.
  public start(): void {
    beat()
    timer = setInterval(() => beat(), intervalMs)
  }

  public stop(): void {
    clearInterval(timer)
    timer = -1
  }

  beat(): void {
    const h = new Heartbeat()
    h.type = type as u8
    h.autopilot = autopilot as u8
    h.systemStatus = MavState.ACTIVE as u8
    h.mavlinkVersion = 3
    conn.send(h)
  }
}

/// A system and component seen sending heartbeats.
export class Vehicle {
  public readonly sysid: int
  public readonly compid: int
  public type: int = 0
  public autopilot: int = 0
  /// When its last heartbeat arrived (ms since 1970).
  public lastSeen: int = 0

  constructor(sysid: int, compid: int) {
    this.sysid = sysid
    this.compid = compid
  }
}

/// Keeps track of who sends heartbeats.
export class VehicleDiscovery {
  readonly found: Map<int, Vehicle> = new Map<int, Vehicle>()
  readonly listener: int
  readonly conn: MavLinkConnection

  constructor(conn: MavLinkConnection) {
    this.conn = conn
    this.listener = conn.on((r: Received) => this.seen(r))
  }

  seen(r: Received): void {
    const m = r.message
    if (m instanceof Heartbeat) {
      const key = r.packet.header.sysid * 256 + r.packet.header.compid
      let v = found.get(key)
      if (v == null) {
        v = new Vehicle(r.packet.header.sysid, r.packet.header.compid)
        found.set(key, v!)
      }
      const vehicle = v!
      vehicle.type = m.type as int
      vehicle.autopilot = m.autopilot as int
      vehicle.lastSeen = Date.now() as int
    }
  }

  /// Everyone seen so far (ground stations included), in order of system then component id.
  public vehicles(): Vehicle[] {
    const keys: int[] = []
    for (const [k, _] of found) {
      keys.push(k)
    }
    keys.sort((a: int, b: int) => a - b)
    keys.map((k: int) => found.get(k)!)
  }

  public stop(): void {
    conn.off(listener)
  }
}

/// A parameter as the autopilot reported it.
export struct Param {
  id: string
  /// Its place in the list (65535 when the autopilot doesn't say).
  index: int
  value: TypedParamValue
}

export struct ParamListResult {
  /// By index; the ones still missing aren't there.
  params: Param[]
  /// How many the autopilot says it has.
  count: int
  /// Indexes that never arrived, even after asking for each again.
  missing: int[]
  /// Whether every parameter arrived.
  complete: bool
}

export struct ParamOptions {
  /// How long a quiet link means the autopilot has sent all it will (default 1000 ms).
  quietMs?: int
  /// How long to wait for one reply (default 1000 ms).
  timeoutMs?: int
  /// How many times to ask again (default 3).
  retries?: int
  /// Cancels the operation: it fails with an `ABORTED` MavLinkError (a disconnect, a closed window).
  signal?: AbortSignal
}

function checkAborted(signal: AbortSignal?, what: string): void throws MavLinkError {
  if (signal != null && signal!.aborted) {
    throw new MavLinkError("ABORTED", `${what}: cancelled`)
  }
}

function paramOf(m: ParamValue, encoding: ParamEncoding): Param {
  const p: Param = { id: m.paramId, index: m.paramIndex as int, value: decodeParam(m.paramValue, m.paramType as int, encoding) }
  p
}

/// Downloads the whole parameter list: PARAM_REQUEST_LIST, then PARAM_REQUEST_READ by index for
/// whatever didn't arrive, a few rounds. A list that stays incomplete says so (`complete`,
/// `missing`) rather than pretending.
// In the async `run` methods, `target` is written `this.target`: a bare `target` there is taken
// for the build constant until pico-lang #104 is fixed.
export class ParamList {
  readonly conn: MavLinkConnection
  readonly target: Target
  readonly encoding: ParamEncoding
  readonly quietMs: int
  readonly retries: int
  readonly signal: AbortSignal?
  readonly received: Map<int, Param> = new Map<int, Param>()
  count: int = -1
  lastArrival: int = 0

  constructor(conn: MavLinkConnection, target: Target, encoding: ParamEncoding, options: ParamOptions = {}) {
    this.conn = conn
    this.target = target
    this.encoding = encoding
    this.quietMs = options.quietMs ?? 1000
    this.retries = options.retries ?? 3
    this.signal = options.signal
  }

  public async run(): Promise<ParamListResult> throws Error {
    const listener = conn.on((r: Received) => this.arrived(r))
    const request = new ParamRequestList()
    request.targetSystem = this.target.system as u8
    request.targetComponent = this.target.component as u8
    lastArrival = Date.now() as int
    await conn.send(request)
    await quiet()
    let round = 0
    while (round < retries && missing().length > 0) {
      checkAborted(signal, "the parameter list")
      for (const i of missing()) {
        const read = new ParamRequestRead()
        read.targetSystem = this.target.system as u8
        read.targetComponent = this.target.component as u8
        read.paramIndex = i as i16
        await conn.send(read)
      }
      lastArrival = Date.now() as int
      await quiet()
      round += 1
    }
    conn.off(listener)
    const params: Param[] = []
    for (let i = 0; i < (if (count < 0) 0 else count); i++) {
      const p = received.get(i)
      if (p != null) {
        params.push(p!)
      }
    }
    const gone = missing()
    const result: ParamListResult = { params, count: if (count < 0) 0 else count, missing: gone, complete: count >= 0 && gone.length == 0 }
    result
  }

  arrived(r: Received): void {
    const m = r.message
    if (m instanceof ParamValue) {
      if (from(r, target)) {
        count = m.paramCount as int
        const i = m.paramIndex as int
        if (i < count) {
          received.set(i, paramOf(m, encoding))
        }
        lastArrival = Date.now() as int
      }
    }
  }

  /// Indexes not received yet (all of them while the count is unknown: none).
  missing(): int[] {
    const out: int[] = []
    for (let i = 0; i < count; i++) {
      if (!received.has(i)) {
        out.push(i)
      }
    }
    out
  }

  /// Until nothing arrived for `quietMs`, or everything has.
  async quiet(): Promise<void> throws Error {
    while ((Date.now() as int) - lastArrival < quietMs && (count < 0 || missing().length > 0)) {
      checkAborted(signal, "the parameter list")
      await delay(if (quietMs / 10 > 5) quietMs / 10 else 5)
    }
    checkAborted(signal, "the parameter list")
  }
}

/// Reads one parameter by name, asking again on a timeout.
export class ParamRead {
  readonly conn: MavLinkConnection
  readonly target: Target
  readonly encoding: ParamEncoding
  readonly timeoutMs: int
  readonly retries: int
  readonly signal: AbortSignal?

  constructor(conn: MavLinkConnection, target: Target, encoding: ParamEncoding, options: ParamOptions = {}) {
    this.conn = conn
    this.target = target
    this.encoding = encoding
    this.timeoutMs = options.timeoutMs ?? 1000
    this.retries = options.retries ?? 3
    this.signal = options.signal
  }

  /// The parameter `id`; a `TIMEOUT` MavLinkError when no reply comes.
  public async run(id: string): Promise<Param> throws Error {
    for (let attempt = 0; attempt <= retries; attempt++) {
      checkAborted(signal, `reading ${id}`)
      const reply = conn.waitFor((r: Received) => isValueOf(r, this.target, id), timeoutMs, signal)
      const read = new ParamRequestRead()
      read.targetSystem = this.target.system as u8
      read.targetComponent = this.target.component as u8
      read.paramId = id
      read.paramIndex = -1
      await conn.send(read)
      const r = await reply
      if (r != null) {
        const m = r!.message
        if (m instanceof ParamValue) {
          return paramOf(m, encoding)
        }
      }
    }
    checkAborted(signal, `reading ${id}`)
    throw new MavLinkError("TIMEOUT", `no PARAM_VALUE for ${id} from ${this.target.system}/${this.target.component} after ${retries + 1} tries`)
  }
}

function isValueOf(r: Received, target: Target, id: string): bool {
  const m = r.message
  if (m instanceof ParamValue) {
    return from(r, target) && m.paramId == id
  }
  false
}

/// What a PARAM_SET came back as.
export struct ParamSetResult {
  /// The value the autopilot reports after the set.
  param: Param
  /// Whether that's the value asked for (an autopilot may refuse or round it).
  verified: bool
}

/// Writes one parameter and reads the value back from the autopilot's PARAM_VALUE reply. Only a
/// reply for this parameter counts, and a value the autopilot changed is reported as unverified,
/// never as success.
export class ParamWrite {
  readonly conn: MavLinkConnection
  readonly target: Target
  readonly encoding: ParamEncoding
  readonly timeoutMs: int
  readonly retries: int
  readonly signal: AbortSignal?

  constructor(conn: MavLinkConnection, target: Target, encoding: ParamEncoding, options: ParamOptions = {}) {
    this.conn = conn
    this.target = target
    this.encoding = encoding
    this.timeoutMs = options.timeoutMs ?? 1000
    this.retries = options.retries ?? 3
    this.signal = options.signal
  }

  /// Sets `id` to `value`; a ParamError when the value can't travel, a `TIMEOUT` MavLinkError when
  /// no reply comes.
  public async run(id: string, value: TypedParamValue): Promise<ParamSetResult> throws Error {
    const request = new ParamSet()
    request.targetSystem = this.target.system as u8
    request.targetComponent = this.target.component as u8
    request.paramId = id
    request.paramValue = encodeParam(value, encoding)
    request.paramType = paramTypeOf(value) as u8
    for (let attempt = 0; attempt <= retries; attempt++) {
      checkAborted(signal, `writing ${id}`)
      const reply = conn.waitFor((r: Received) => isValueOf(r, this.target, id), timeoutMs, signal)
      await conn.send(request)
      const r = await reply
      if (r != null) {
        const m = r!.message
        if (m instanceof ParamValue) {
          const p = paramOf(m, encoding)
          return { param: p, verified: sameParam(p.value, value) }
        }
      }
    }
    checkAborted(signal, `writing ${id}`)
    throw new MavLinkError("TIMEOUT", `no PARAM_VALUE for ${id} after PARAM_SET (${retries + 1} tries)`)
  }
}

function paramTypeOf(v: TypedParamValue): int {
  match (v) {
    Int { type } => type,
    Real { type } => type,
  }
}

/// Asks the autopilot for AUTOPILOT_VERSION (its capabilities say how it encodes parameters, see
/// `encodingOf`). MAV_CMD_REQUEST_MESSAGE first; after half the tries the older
/// MAV_CMD_REQUEST_AUTOPILOT_CAPABILITIES, for autopilots that predate it.
export class AutopilotVersionRead {
  readonly conn: MavLinkConnection
  readonly target: Target
  readonly timeoutMs: int
  readonly retries: int
  readonly signal: AbortSignal?

  constructor(conn: MavLinkConnection, target: Target, options: ParamOptions = {}) {
    this.conn = conn
    this.target = target
    this.timeoutMs = options.timeoutMs ?? 1000
    this.retries = options.retries ?? 3
    this.signal = options.signal
  }

  /// The autopilot's AUTOPILOT_VERSION, or null when it never answers.
  public async run(): Promise<AutopilotVersion?> throws Error {
    for (let attempt = 0; attempt <= retries; attempt++) {
      checkAborted(signal, "AUTOPILOT_VERSION")
      const reply = conn.waitFor((r: Received) => isVersionFrom(r, this.target), timeoutMs, signal)
      const c = new CommandLong()
      c.targetSystem = this.target.system as u8
      c.targetComponent = this.target.component as u8
      c.confirmation = attempt as u8
      if (attempt <= retries / 2) {
        c.command = MavCmd.REQUEST_MESSAGE as u16
        c._param1 = AutopilotVersion.MSG_ID as f32
      } else {
        c.command = MavCmd.REQUEST_AUTOPILOT_CAPABILITIES as u16
        c._param1 = 1.0 as f32
      }
      await conn.send(c)
      const r = await reply
      if (r != null) {
        const m = r!.message
        if (m instanceof AutopilotVersion) {
          return m
        }
      }
    }
    checkAborted(signal, "AUTOPILOT_VERSION")
    null
  }
}

function isVersionFrom(r: Received, target: Target): bool {
  const m = r.message
  (m instanceof AutopilotVersion) && from(r, target)
}

/// Sends a COMMAND_LONG and waits for its COMMAND_ACK, asking again (with the confirmation number
/// raised, as the protocol says) when no ack comes. IN_PROGRESS acks are waited past.
export class CommandCall {
  readonly conn: MavLinkConnection
  readonly target: Target
  readonly timeoutMs: int
  readonly retries: int
  readonly signal: AbortSignal?

  constructor(conn: MavLinkConnection, target: Target, options: ParamOptions = {}) {
    this.conn = conn
    this.target = target
    this.timeoutMs = options.timeoutMs ?? 1000
    this.retries = options.retries ?? 3
    this.signal = options.signal
  }

  /// MAV_RESULT of `command` with up to seven parameters; a `TIMEOUT` MavLinkError when nothing
  /// acks it.
  public async run(command: int, params: f64[] = []): Promise<int> throws Error {
    const name = MavCmd.nameOf(command) ?? `${command}`
    for (let attempt = 0; attempt <= retries; attempt++) {
      checkAborted(signal, name)
      const reply = conn.waitFor((r: Received) => isAckOf(r, this.target, command), timeoutMs, signal)
      const c = new CommandLong()
      c.targetSystem = this.target.system as u8
      c.targetComponent = this.target.component as u8
      c.command = command as u16
      c.confirmation = attempt as u8
      const p = (i: int) => (if (i < params.length) params[i] else 0.0) as f32
      c._param1 = p(0)
      c._param2 = p(1)
      c._param3 = p(2)
      c._param4 = p(3)
      c._param5 = p(4)
      c._param6 = p(5)
      c._param7 = p(6)
      await conn.send(c)
      const r = await reply
      if (r != null) {
        const m = r!.message
        if (m instanceof CommandAck) {
          if (m.result as int != MavResult.IN_PROGRESS) {
            return m.result as int
          }
        }
      }
    }
    checkAborted(signal, name)
    throw new MavLinkError("TIMEOUT", `no COMMAND_ACK for ${name} after ${retries + 1} tries`)
  }

  /// Asks for `messageId` every `intervalUs` microseconds (MAV_CMD_SET_MESSAGE_INTERVAL; -1 stops
  /// it, 0 is the autopilot's default); MAV_RESULT.
  public async setMessageInterval(messageId: int, intervalUs: int): Promise<int> throws Error {
    await run(MavCmd.SET_MESSAGE_INTERVAL, [messageId as f64, intervalUs as f64])
  }
}

function isAckOf(r: Received, target: Target, command: int): bool {
  const m = r.message
  if (m instanceof CommandAck) {
    return from(r, target) && m.command as int == command
  }
  false
}
