// Byte streams: what MAVLink travels over. A serial port, a TCP connection, a UDP peer, a file or
// a test double: the library sees only `ByteStream`. They are the standard library's (pico 0.10.0),
// re-exported so existing imports keep working.
import { PipeEnd } from "std/streams"

export { ByteStream } from "std/streams"
export { TcpStream, UdpStream } from "std/net"
export { FileStream } from "std/fs"

/// One end of an in-memory pipe pair: what one end writes, the other reads (`std/streams`'
/// `PipeEnd`, with node-mavlink's name).
export class MemoryStream extends PipeEnd {
  constructor() {
    super()
  }

  /// Two connected ends (`bytePipe()`).
  public static pair(): MemoryStream[] {
    const a = new MemoryStream()
    const b = new MemoryStream()
    a.peer = b
    b.peer = a
    return [a, b]
  }
}
