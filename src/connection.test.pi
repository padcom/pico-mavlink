import { describe, it, expect } from "std/test"
import { bind } from "std/net"
import { delay } from "std/timers"
import { MavLinkConnection, packets } from "./connection"
import { ByteStream, FileStream, MemoryStream, UdpStream } from "./stream"
import { MavLinkPacketSignature, MavLinkProtocolV1, MavLinkProtocolV2 } from "./protocol"
import { Heartbeat, MavType } from "./dialects/minimal"
import { ParamValue } from "./dialects/common"

async function talksOverAPipe(): Promise<void> throws Error {
  const ends = MemoryStream.pair()
  const gcs = new MavLinkConnection(ends[0])
  const vehicle = new MavLinkConnection(ends[1], { protocol: new MavLinkProtocolV1(1, 1) })
  const h = new Heartbeat()
  h.type = MavType.QUADROTOR as u8
  await vehicle.send(h)
  const p = new ParamValue()
  p.paramId = "ARMING_CHECK"
  p.paramValue = 1.0 as f32
  await vehicle.send(p)
  await gcs.send(new Heartbeat())
  vehicle.close()
  const got: string[] = []
  for await (const r of gcs.messages()) {
    const m = r.message
    if (m instanceof Heartbeat) {
      got.push(`HEARTBEAT type ${m.type} via ${r.packet.protocol.name()} from ${r.packet.header.sysid}`)
    } else if (m instanceof ParamValue) {
      got.push(`PARAM_VALUE ${m.paramId}=${m.paramValue} seq ${r.packet.header.seq}`)
    }
  }
  expect(got.join("; ")).toBe("HEARTBEAT type 2 via MAV_V1 from 1; PARAM_VALUE ARMING_CHECK=1 seq 1")
}

async function signedOverAPipe(): Promise<void> throws Error {
  const ends = MemoryStream.pair()
  const key = MavLinkPacketSignature.key("secret")
  await new MavLinkConnection(ends[1]).sendSigned(new Heartbeat(), key, 3, 1_700_000_000_000)
  ends[1].close()
  let verdict = "none"
  for await (const p of packets(ends[0])) {
    const s = p.signature
    verdict = if (s == null) "unsigned" else `link ${s!.linkId} ${s!.matches(key)}`
  }
  expect(verdict).toBe("link 3 true")
}

async function readsACapture(): Promise<void> throws Error {
  const conn = new MavLinkConnection(new FileStream("../../node-mavlink/examples/mavlink-v2-3412-packets.bin", 1000))
  let decoded = 0
  let unknown = 0
  for await (const r of conn.messages()) {
    if (r.message == null) {
      unknown += 1
    } else {
      decoded += 1
    }
  }
  // The splitter skips the 14 frames of messages the registry doesn't know.
  expect(`${decoded}/${unknown}`).toBe("3398/0")
}

async function overUdp(): Promise<void> throws Error {
  const a = await bind(0)
  const b = await bind(0)
  // b learns its peer from a's first datagram.
  const sender = new MavLinkConnection(new UdpStream(a, b.addr.port))
  const receiver = new MavLinkConnection(new UdpStream(b))
  const h = new Heartbeat()
  h.type = MavType.FIXED_WING as u8
  await sender.send(h)
  let got = "nothing"
  for await (const r of receiver.messages()) {
    const m = r.message
    if (m instanceof Heartbeat) {
      got = `type ${m.type}`
      break
    }
  }
  sender.close()
  receiver.close()
  expect(got).toBe("type 1")
}

async function dropsUnknownIncompatibilityFlags(): Promise<void> throws Error {
  const ends = MemoryStream.pair()
  const gcs = new MavLinkConnection(ends[0])
  // A frame with incompatibility flag 0x02 (undefined), then a normal one.
  const odd = new MavLinkConnection(ends[1], { protocol: new MavLinkProtocolV2(1, 1, 0x02) })
  await odd.send(new Heartbeat())
  await new MavLinkConnection(ends[1]).send(new Heartbeat())
  ends[1].close()
  let n = 0
  for await (const _ of gcs.messages()) {
    n += 1
  }
  expect(n).toBe(1)
}

/// A stream that counts its closes.
class CountingStream implements ByteStream {
  readonly inner: ByteStream
  public closes: int = 0

  constructor(inner: ByteStream) {
    this.inner = inner
  }

  public read(): Promise<Uint8Array?, Error> {
    return inner.read()
  }

  public async write(bytes: Uint8Array): Promise<void> throws Error {
    await inner.write(bytes)
  }

  public close(): void {
    closes += 1
    inner.close()
  }
}

/// A close hook that notes its name after a moment (the closing waits for it, or not).
async function mark(ran: string[], name: string, ms: int): Promise<void> {
  try {
    await delay(ms)
  } catch (e: Error) {
    return
  }
  ran.push(name)
}

async function everyCloseHookRunsOnceAndTheStreamCloses(): Promise<void> throws Error {
  const stream = new CountingStream(MemoryStream.pair()[0])
  const conn = new MavLinkConnection(stream)
  const ran: string[] = []
  conn.onClose(() => mark(ran, "first", 0))
  conn.onClose(() => mark(ran, "second", 0))
  // close() starts the hooks and closes at once, and does not wait for them
  conn.close()
  expect(stream.closes).toBe(1)
  await delay(20)
  conn.close()
  await delay(20)
  expect(ran.join(",")).toBe("first,second")
  expect(stream.closes).toBe(2)
}

async function shutdownWaitsForTheHooksThenCloses(): Promise<void> throws Error {
  const stream = new CountingStream(MemoryStream.pair()[0])
  const conn = new MavLinkConnection(stream)
  const ran: string[] = []
  conn.onClose(() => mark(ran, "slow", 50))
  conn.onClose(() => mark(ran, "last", 0))
  await conn.shutdown()
  // both ran, in order, each waited for, and the stream closed after them
  expect(ran.join(",")).toBe("slow,last")
  expect(stream.closes).toBe(1)
}

async function aCloseHookCanBeTakenOff(): Promise<void> throws Error {
  const stream = new CountingStream(MemoryStream.pair()[0])
  const conn = new MavLinkConnection(stream)
  const ran: string[] = []
  const off = conn.onClose(() => mark(ran, "taken off", 0))
  conn.onClose(() => mark(ran, "kept", 0))
  off()
  conn.close()
  await delay(20)
  expect(ran.join(",")).toBe("kept")
  expect(stream.closes).toBe(1)
}

describe("connections", () => {
  it("run every close hook once, then close the stream", everyCloseHookRunsOnceAndTheStreamCloses)
  it("shut down: wait for every close hook, in order, then close", shutdownWaitsForTheHooksThenCloses)
  it("do not run a close hook that was taken off", aCloseHookCanBeTakenOff)
  it("drop packets with incompatibility flags they don't understand", dropsUnknownIncompatibilityFlags)
  it("send and receive over an in-memory pipe, v1 and v2 mixed", talksOverAPipe)
  it("sign, and the receiver verifies", signedOverAPipe)
  it("decode a whole capture through the default registry", readsACapture)
  it("work over UDP", overUdp)
})
