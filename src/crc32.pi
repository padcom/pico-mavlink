// The CRC-32 that ArduPilot gives for a file (MAVLink FTP CalcFileCRC32): the usual polynomial
// (0x04C11DB7, reflected) but with no inversion at the start and none at the end, as ArduPilot's
// `crc_crc32` computes it, on std/checksum. It is a running value: the CRC of a file is the CRC of
// its first part carried on over the rest, so a download that goes on from what an earlier try
// fetched continues from the CRC of what it holds.
import { Crc, CrcSpec } from "std/checksum"

/// ArduPilot's CRC-32: no inversions.
export const ARDUPILOT_CRC32: CrcSpec = { width: 32, poly: 0x04C11DB7, init: 0, reflected: true, xorOut: 0 }

/// A running CRC-32.
export class Crc32 {
  running: Crc

  /// `initial` is the CRC of the bytes before the ones `update` gets.
  constructor(initial: int = 0) {
    this.running = new Crc(ARDUPILOT_CRC32, initial & 0xFFFFFFFF)
  }

  /// Takes more bytes into the CRC.
  public update(b: Uint8Array): void {
    running.update(b)
  }

  /// The CRC of the bytes given so far (32 bits).
  public get crc(): int {
    return running.value
  }
}

/// The CRC of `b` in one go.
export function crc32Of(b: Uint8Array): int {
  const c = new Crc32()
  c.update(b)
  return c.crc
}
