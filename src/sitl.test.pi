// The parameters by MAVLink FTP against ArduPilot's own SITL (ArduCopter), over TCP: the real file, the real timing.
//
// Linux, and only where a SITL binary is there: `SITL_BINARY` (the path of the `arducopter` executable, built from ArduPilot's
// source; drone-configurator's .github/sitl-build.sh builds one) or `arducopter` on the PATH. Without one the tests are skipped,
// with a line saying so.
// SITL is started in a directory of its own with a wiped EEPROM, as instance 3 (TCP 5790, so as not to meet a SITL on 5760), and
// stopped when the test ends.
import { describe, it, expect } from "std/test"
import { delay } from "std/timers"
import { connect } from "std/net"
import { env, Child, Command } from "std/process"
import { exists, mkdir, remove } from "std/fs"
import { MavLinkConnection } from "./connection"
import { TcpStream } from "./stream"
import { AutopilotVersionRead, ParamList, ParamRead, ParamWrite, Target, VehicleDiscovery } from "./operations"
import { ParamDownload, ParamDownloadOptions, hasFtpBit } from "./paramftp"
import { ParamEncoding, TypedParamValue, encodingOf, showParam } from "./params"
import { MavParamType } from "./dialects/common"

const INSTANCE = 3
const PORT = 5760 + 10 * INSTANCE

/// A running SITL and the connection to it.
class Sitl {
  public readonly child: Child
  public readonly dir: string
  public readonly conn: MavLinkConnection
  public readonly target: Target
  public readonly encoding: ParamEncoding
  public readonly capabilities: u64

  constructor(child: Child, dir: string, conn: MavLinkConnection, target: Target, encoding: ParamEncoding, capabilities: u64) {
    this.child = child
    this.dir = dir
    this.conn = conn
    this.target = target
    this.encoding = encoding
    this.capabilities = capabilities
  }

  public async stop(): Promise<void> {
    conn.close()
    child.kill("SIGKILL")
    try {
      await remove(dir, true)
    } catch (e: Error) {
    }
  }
}

/// The SITL executable: `SITL_BINARY`, else `arducopter` on the PATH; null when there is none.
async function findBinary(): Promise<string?> throws Error {
  const given = env.get("SITL_BINARY")
  if (given != null && given! != "") {
    return given
  }
  for (const dir of (env.get("PATH") ?? "").split(":")) {
    if (dir != "" && await exists(`${dir}/arducopter`)) {
      return `${dir}/arducopter`
    }
  }
  null
}

/// Starts SITL and waits for its first heartbeat; null, with a line printed, when there is no SITL binary to start.
async function startSitl(): Promise<Sitl?> throws Error {
  const binary = await findBinary()
  if (binary == null) {
    println("SITL tests skipped: no SITL_BINARY, and no arducopter on the PATH")
    return null
  }
  const dir = `/tmp/pico-mavlink-sitl-${Date.now()}`
  await mkdir(dir, true)
  const args = ["-w", "--model", "quad", "--speedup", "1", "-I", `${INSTANCE}`, "--sim-address=127.0.0.1"]
  const child = new Command(binary!, args, dir, null, false, "null", "null", "null").spawn()
  let stream: TcpStream? = null
  for (let i = 0; i < 120 && stream == null; i++) {
    try {
      stream = new TcpStream(await connect(PORT))
    } catch (e: Error) {
      await delay(500)
    }
  }
  if (stream == null) {
    child.kill("SIGKILL")
    throw new Error(`SITL did not listen on ${PORT} within 60 s`)
  }
  const conn = new MavLinkConnection(stream!)
  conn.run()
  const discovery = new VehicleDiscovery(conn)
  let target: Target? = null
  for (let i = 0; i < 240 && target == null; i++) {
    for (const v of discovery.vehicles()) {
      if (v.autopilot != 8 && target == null && v.type != 6) {
        target = { system: v.sysid, component: v.compid }
      }
    }
    await delay(250)
  }
  if (target == null) {
    child.kill("SIGKILL")
    throw new Error("SITL sent no heartbeat within 60 s")
  }
  const version = await new AutopilotVersionRead(conn, target!, { timeoutMs: 1000, retries: 3 }).run()
  if (version == null) {
    child.kill("SIGKILL")
    throw new Error("SITL did not answer AUTOPILOT_VERSION")
  }
  new Sitl(child, dir, conn, target!, encodingOf(version!.capabilities) ?? ParamEncoding.CCast, version!.capabilities)
}

/// Whether an FTP value and a list value are the same parameter value: an integer above 2^24 does not travel exactly in a float,
/// so the list can only hold it rounded to one (the file has it exactly); a real is compared as the float it is.
function agree(file: TypedParamValue, list: TypedParamValue): bool {
  match (file) {
    Int { value: a } => match (list) {
      Int { value: b } => if (a <= 16777216 && a >= -16777216) a == b else (a as f32) == (b as f32),
      Real { } => false,
    },
    Real { } => match (list) {
      Real { } => showParam(file) == showParam(list),
      Int { } => false,
    },
  }
}

/// Parameters the vehicle keeps up to date itself while it runs (the barometer's ground reference, its flight statistics): two
/// downloads a moment apart can differ in them, whichever way they come.
function movesByItself(id: string): bool {
  id.indexOf("GND_PRESS") >= 0 || id.indexOf("GND_TEMP") >= 0 || id.startsWith("STAT_")
}

async function ftpGivesTheListFastAndTheSame(): Promise<void> throws Error {
  const sitl = await startSitl()
  if (sitl == null) {
    return
  }
  const s = sitl!
  try {
    expect(hasFtpBit(s.capabilities)).toBe(true)
    const withCaps: ParamDownloadOptions = { method: "ftp", capabilities: (s.capabilities & (0xFFFFFFFF as u64)) as int, timeoutMs: 1000, retries: 3 }
    const started = Date.now() as int
    const ftp = await new ParamDownload(s.conn, s.target, s.encoding, withCaps).run()
    const ftpMs = (Date.now() as int) - started
    const listStarted = Date.now() as int
    const list = await new ParamList(s.conn, s.target, s.encoding, { quietMs: 1500 }).run()
    const listMs = (Date.now() as int) - listStarted
    println(`ArduCopter SITL: ${ftp.count} parameters by file transfer in ${ftpMs} ms, ${list.count} by list in ${listMs} ms`)
    expect(`${ftp.source} ${ftp.complete}`).toBe("ftp true")
    // The issue's number: a full Copter list in under 2 s.
    expect(ftpMs < 2000).toBe(true)
    expect(list.complete).toBe(true)
    expect(ftp.count).toBe(list.count)
    const byName = new Map<string, TypedParamValue>()
    for (const p of list.params) {
      byName.set(p.id, p.value)
    }
    let different = 0
    for (const p of ftp.params) {
      const l = byName.get(p.id)
      if (l == null) {
        different += 1
        println(`  ${p.id}: not in the list`)
      } else if (!movesByItself(p.id) && !agree(p.value, l!)) {
        different += 1
        println(`  ${p.id}: file ${showParam(p.value)}, list ${showParam(l!)}`)
      }
    }
    expect(different).toBe(0)
    // The parameters come in the order of the vehicle's own table, indexes as the list gives them.
    expect(ftp.params.length).toBe(list.params.length)
  } finally {
    await s.stop()
  }
}

async function disabledFtpFallsBackToTheList(): Promise<void> throws Error {
  const sitl = await startSitl()
  if (sitl == null) {
    return
  }
  const s = sitl!
  try {
    // BRD_OPTIONS bit 1 (value 2) is DISABLE_FTP: the vehicle still says it has the capability, and refuses the file.
    const current = await new ParamRead(s.conn, s.target, s.encoding, { timeoutMs: 1000, retries: 3 }).run("BRD_OPTIONS")
    let bits = 0
    match (current.value) {
      Int { value } => { bits = value },
      Real { value } => { bits = value as int },
    }
    const set = await new ParamWrite(s.conn, s.target, s.encoding, { timeoutMs: 1000, retries: 3 }).run("BRD_OPTIONS", TypedParamValue.Int(bits | 2, MavParamType.INT16))
    expect(set.verified).toBe(true)
    await delay(500)
    const caps = (s.capabilities & (0xFFFFFFFF as u64)) as int
    const auto: ParamDownloadOptions = { method: "auto", capabilities: caps, timeoutMs: 1000, retries: 3 }
    const got = await new ParamDownload(s.conn, s.target, s.encoding, auto).run()
    println(`ArduCopter SITL with FTP disabled: ${got.source}, fallback ${got.fallback ?? "none"}, ${got.count} parameters in ${got.elapsedMs} ms`)
    expect(got.source).toBe("list")
    expect(got.complete).toBe(true)
    expect(got.fallback != null).toBe(true)
  } finally {
    await s.stop()
  }
}

describe("ArduCopter SITL", () => {
  it("gives the whole parameter list by file transfer in under 2 s, the same as the list", ftpGivesTheListFastAndTheSame)
  it("falls back to the list when FTP is disabled by BRD_OPTIONS", disabledFtpFallsBackToTheList)
})
